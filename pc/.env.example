# 复制为本项目 .env；Nuxt 原生 dev/build/generate 加载，也可显式 --dotenv /绝对路径。
# 开发监听地址、端口；维护者按资源登记填写。
NUXT_HOST=127.0.0.1
NUXT_PORT=3000
# 开发代理 PHP 上游源；不影响浏览器同域 API 路径。
NUXT_DEV_PROXY_ORIGIN=http://127.0.0.1:20180
# 开发 API 上游；留空时为上述源的 /api 路径。
NUXT_DEV_PROXY_TARGET=
# hybrid：登记公开页 SSR；spa：生成完整静态客户端。
NUXT_PC_RENDER_MODE=hybrid
# SSR 服务访问 PHP 的受信上游及原始协议；生产按同域反向代理部署填写。
NUXT_UPSTREAM_ORIGIN=http://127.0.0.1:20180
NUXT_FORWARDED_PROTO=http
# SSR 允许的入口 Host，逗号分隔；按实际部署域名填写。
NUXT_TRUSTED_HOSTS=
# 浏览器 API 前缀；开发代理和生产同域路径均留空。
NUXT_PUBLIC_API_BASE=
