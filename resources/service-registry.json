  "definitions": {
    "maturity": {
      "formed": "已有唯一或基本唯一服务入口，主要调用方已经采用",
      "formed_with_leaks": "已有服务入口，但仍有调用方越过服务直接访问表、模型或底层原语",
      "partial": "已有可复用实现，但应用服务、公开合同或唯一装配尚未收口",
      "primitive_only": "只有底层原语，多个业务仍自行编排"
    },
    "availability": {
      "always_on": "应用基础设施，业务 Module 可以依赖但 Tenant 不单独停用",
      "enableable_plugin": "按 Plugin 安装和 TenantModule 开通控制的新操作能力",
      "hybrid": "底层安全与装配始终存在，面向 Tenant 的业务能力可启停"
    }
  },
  "architecture_rules": [
    "Controller、Command、Worker 和跨 Module 业务代码优先调用应用服务或 Module 公开合同，不直接查写其他服务拥有的表",
    "应用服务编排事务、Repository、Model 和外部 Provider；Model 只维护自身局部不变量或纯字段转换，不反向调用会访问数据库、网络或启动事务的应用服务",
    "跨 Module 同步协作只依赖 Contracts 接口和 DTO；当前没有已验证的通用 Outbox/Event Bus，不以领域事件替代可靠同步合同",
    "通用服务优先收口；可启停业务服务在其通用依赖冻结后再推进",
    "一个服务只有一个日常写入 owner；同一业务事实不保留双写、兼容镜像或备用 Runtime",
    "服务登记不意味着独立进程、独立仓库或微服务部署"
  ],
