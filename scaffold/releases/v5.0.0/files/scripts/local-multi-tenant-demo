#!/bin/sh

set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
state_dir="$repo_dir/.local"
orchestration_env="$state_dir/mt-demo-stack.env"
backend_env="$repo_dir/server/.env.mt-demo"
lease_id=local-multi-tenant-demo-mtlocal01
lease_owner=codex-root
php_pid="$state_dir/mt-demo-php.pid"
php_log="$state_dir/mt-demo-php.log"
admin_pid="$state_dir/mt-demo-admin.pid"
admin_log="$state_dir/mt-demo-admin.log"
platform_pid="$state_dir/mt-demo-platform.pid"
platform_log="$state_dir/mt-demo-platform.log"
registry="$repo_dir/scripts/project-resource-registry"
lease_registry="$repo_dir/scripts/project-resource-lease"

die() {
    printf 'local-multi-tenant-demo: %s\n' "$*" >&2
    exit 1
}

set_env() {
    target=$1
    name=$2
    value=$3
    temporary=$(mktemp "$(dirname "$target")/environment.XXXXXX")
    awk -F= -v name="$name" '$1 != name { print }' "$target" > "$temporary"
    printf '%s=%s\n' "$name" "$value" >> "$temporary"
    chmod 600 "$temporary"
    mv "$temporary" "$target"
}

clear_env() {
    target=$1
    name=$2
    temporary=$(mktemp "$(dirname "$target")/environment.XXXXXX")
    awk -F= -v name="$name" '$1 != name { print }' "$target" > "$temporary"
    chmod 600 "$temporary"
    mv "$temporary" "$target"
}

ensure_env_value() {
    target=$1
    name=$2
    value=$3
    grep -q "^${name}=." "$target" || set_env "$target" "$name" "$value"
}

prepare_env() {
    umask 077
    mkdir -p "$state_dir"
    [ -f "$orchestration_env" ] || : > "$orchestration_env"
    [ -f "$backend_env" ] || : > "$backend_env"
    chmod 600 "$orchestration_env" "$backend_env"
    "$repo_dir/scripts/project-development-database.sh" sync-credentials --backend-env "$backend_env" >/dev/null
    "$registry" database-env \
        --deployment-target local-multi-tenant-demo \
        --consumer host \
        --resource-id peanut-admin-mysql84-local-multi-tenant-demo |
        while IFS='=' read -r name value; do set_env "$backend_env" "$name" "$value"; done
    "$registry" local-stack-env --deployment-target local-multi-tenant-demo |
        while IFS='=' read -r name value; do set_env "$orchestration_env" "$name" "$value"; done
    set_env "$orchestration_env" PHP_PORT 20178
    set_env "$orchestration_env" VITE_PORT 20179
    set_env "$orchestration_env" PLATFORM_PORT 20176
    set_env "$orchestration_env" VITE_ALLOWED_HOSTS platform.peanut-admin.test,admin.peanut-admin.test,tenant-a.peanut-admin.test,tenant-b.peanut-admin.test
    set_env "$orchestration_env" VITE_DEPLOYMENT_MODE multi-tenant
    set_env "$orchestration_env" VITE_OPEN_BROWSER false
    set_env "$backend_env" APP_ENV development
    set_env "$backend_env" APP_DEBUG true
    set_env "$backend_env" DB_PREFIX pa_
    set_env "$backend_env" PEANUT_DEMO_MODE enabled
    set_env "$backend_env" PEANUT_DEPLOYMENT_TARGET local-multi-tenant-demo
    set_env "$backend_env" DEPLOYMENT_MODE multi-tenant
    set_env "$backend_env" PLATFORM_HOSTS platform.peanut-admin.test
    set_env "$backend_env" TENANT_ADMIN_HOSTS admin.peanut-admin.test
    set_env "$backend_env" OWNER_INVITATION_DELIVERY_MODE manual
    clear_env "$backend_env" ADMIN_INITIAL_EMAIL
    clear_env "$backend_env" ADMIN_INITIAL_PASSWORD
    clear_env "$backend_env" PLATFORM_INITIAL_EMAIL
    clear_env "$backend_env" PLATFORM_INITIAL_PASSWORD
    set_env "$backend_env" PEANUT_DEMO_ADMIN_EMAIL owner@local.test
    set_env "$backend_env" PEANUT_DEMO_PLATFORM_EMAIL platform@local.test
    set_env "$backend_env" PEANUT_DEMO_TENANT_A_EMAIL tenant-a@local.test
    set_env "$backend_env" PEANUT_DEMO_TENANT_B_EMAIL tenant-b@local.test
    set_env "$backend_env" PEANUT_DEMO_SHARED_PASSWORD 'peanut1234'
    set_env "$backend_env" PEANUT_DEMO_TENANT_A_HOST tenant-a.peanut-admin.test
    set_env "$backend_env" PEANUT_DEMO_TENANT_B_HOST tenant-b.peanut-admin.test
    set_env "$backend_env" PEANUT_DEMO_DOCS_URL http://docs.peanut-admin.test
    ensure_env_value "$backend_env" JWT_SECRET "$(openssl rand -hex 32)"
    ensure_env_value "$backend_env" TENANT_IDENTIFIER_HMAC_KEY "$(openssl rand -hex 32)"
    ensure_env_value "$backend_env" PLATFORM_IDENTIFIER_HMAC_KEY "$(openssl rand -hex 32)"
    printf 'Prepared private demo environments: %s and %s\n' "$orchestration_env" "$backend_env"
}

assert_lease() {
    details=$($lease_registry show --lease "$lease_id") || die "active lease is required: $lease_id"
    actual_owner=$(printf '%s\n' "$details" | awk -F '\t' '$1 == "owner" { print $2; exit }')
    candidate=$(printf '%s\n' "$details" | awk -F '\t' '$1 == "candidate" { print $2; exit }')
    current=$(git -C "$repo_dir" rev-parse HEAD)
    [ "$actual_owner" = "$lease_owner" ] || die "lease belongs to $actual_owner, expected $lease_owner"
    [ "$candidate" = "$current" ] || die "lease candidate $candidate does not match current HEAD $current"
    for value in peanut_admin_development_mtlocal01 20176 20178 20179; do
        printf '%s\n' "$details" | grep -Fq "$value" || die "lease does not own required resource: $value"
    done
}

load_env() {
    [ -f "$orchestration_env" ] || die "run prepare first: $orchestration_env"
    set -a
    # shellcheck disable=SC1090 -- private generated orchestration environment.
    . "$orchestration_env"
    set +a
}

pid_running() {
    pid_file=$1
    [ -f "$pid_file" ] || return 1
    pid=$(cat "$pid_file" 2>/dev/null || true)
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null
}

stop_pid() {
    pid_file=$1
    expected=$2
    [ -f "$pid_file" ] || return 0
    pid=$(cat "$pid_file" 2>/dev/null || true)
    case "$pid" in ''|*[!0-9]*) rm -f "$pid_file"; return 0 ;; esac
    if ! kill -0 "$pid" 2>/dev/null; then
        rm -f "$pid_file"
        return 0
    fi
    command_line=$(ps -p "$pid" -o command= 2>/dev/null || true)
    case "$command_line" in *"$expected"*) ;; *) die "refusing to stop unowned pid $pid" ;; esac
    kill "$pid" 2>/dev/null || true
    wait_count=0
    while kill -0 "$pid" 2>/dev/null && [ "$wait_count" -lt 20 ]; do
        wait_count=$((wait_count + 1))
        sleep 1
    done
    kill -KILL "$pid" 2>/dev/null || true
    rm -f "$pid_file"
}

wait_http() {
    url=$1
    log=$2
    count=0
    while [ "$count" -lt 30 ]; do
        if curl --fail --silent --show-error --max-time 2 "$url" >/dev/null 2>&1; then
            return 0
        fi
        count=$((count + 1))
        sleep 1
    done
    [ -f "$log" ] && tail -n 30 "$log" >&2 || true
    die "service did not become healthy: $url"
}

start_clients() {
    if [ ! -x "$repo_dir/web/node_modules/.bin/vite" ]; then
        (cd "$repo_dir/web" && corepack pnpm install --frozen-lockfile)
    fi
    if [ ! -x "$repo_dir/platform/node_modules/.bin/vite" ]; then
        (cd "$repo_dir/platform" && npm ci --legacy-peer-deps)
    fi

    if ! pid_running "$admin_pid"; then
        : > "$admin_log"
        (
            trap '' HUP
            cd "$repo_dir/web"
            exec env -i PATH="$PATH" HOME="$HOME" PEANUT_CLIENT_ENV_FILE="$orchestration_env" \
                node node_modules/vite/bin/vite.js --config ./config/vite.config.dev.ts \
                --host 127.0.0.1 --port 20179
        ) >> "$admin_log" 2>&1 &
        printf '%s\n' "$!" > "$admin_pid"
    fi
    if ! pid_running "$platform_pid"; then
        : > "$platform_log"
        (
            trap '' HUP
            cd "$repo_dir/platform"
            exec env -i PATH="$PATH" HOME="$HOME" PEANUT_CLIENT_ENV_FILE="$orchestration_env" \
                node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 20176
        ) >> "$platform_log" 2>&1 &
        printf '%s\n' "$!" > "$platform_pid"
    fi
}

show_urls() {
    printf '%s\n' \
        'Tenant Admin: http://admin.peanut-admin.test:20179/admin/' \
        'Tenant Alpha: http://tenant-a.peanut-admin.test:20179/admin/' \
        'Tenant Beta:  http://tenant-b.peanut-admin.test:20179/admin/' \
        'Platform:     http://platform.peanut-admin.test:20176/platform/' \
        'API:          http://127.0.0.1:20178/'
}

show_credentials() {
    printf '%s\n' \
        'Tenant owner: owner@local.test / peanut1234' \
        'Platform:     platform@local.test / peanut1234'
}

case "${1:-}" in
    prepare)
        prepare_env
        ;;
    up)
        assert_lease
        [ -f "$orchestration_env" ] && [ -f "$backend_env" ] || prepare_env
        installation_env=$(mktemp "$state_dir/installation.XXXXXX.env")
        trap 'rm -f "$installation_env"' EXIT HUP INT TERM
        chmod 600 "$installation_env"
        printf '%s\n' \
            'ADMIN_INITIAL_EMAIL=owner@local.test' \
            'ADMIN_INITIAL_PASSWORD=peanut1234' \
            'PLATFORM_INITIAL_EMAIL=platform@local.test' \
            'PLATFORM_INITIAL_PASSWORD=peanut1234' > "$installation_env"
        PEANUT_SERVER_ENV_FILE="$backend_env" PEANUT_INSTALLATION_ENV_FILE="$installation_env" \
            php "$repo_dir/server/database/install.php" --skip-if-installed
        rm -f "$installation_env"
        trap - EXIT HUP INT TERM
        PEANUT_SERVER_ENV_FILE="$backend_env" \
            php "$repo_dir/server/database/seed-multi-tenant-demo.php" --apply
        PEANUT_SERVER_ENV_FILE="$backend_env" php "$repo_dir/server/database/environment-guard.php" --current
        "$repo_dir/scripts/local-php-runtime" start --env-file "$orchestration_env" --backend-env "$backend_env" \
            --pid-file "$php_pid" --log-file "$php_log"
        start_clients
        wait_http http://127.0.0.1:20179/admin/ "$admin_log"
        wait_http http://127.0.0.1:20176/platform/ "$platform_log"
        show_urls
        show_credentials
        ;;
    down)
        stop_pid "$platform_pid" '--port 20176'
        stop_pid "$admin_pid" '--port 20179'
        "$repo_dir/scripts/local-php-runtime" stop --env-file "$orchestration_env" --backend-env "$backend_env" \
            --pid-file "$php_pid" --log-file "$php_log"
        ;;
    status)
        assert_lease
        pid_running "$php_pid" || die 'PHP is not running'
        pid_running "$admin_pid" || die 'Admin is not running'
        pid_running "$platform_pid" || die 'Platform is not running'
        wait_http http://127.0.0.1:20179/admin/ "$admin_log"
        wait_http http://127.0.0.1:20176/platform/ "$platform_log"
        show_urls
        ;;
    credentials)
        show_credentials
        ;;
    urls)
        show_urls
        ;;
    *)
        printf 'Usage: %s {prepare|up|down|status|credentials|urls}\n' "$0" >&2
        exit 2
        ;;
esac
