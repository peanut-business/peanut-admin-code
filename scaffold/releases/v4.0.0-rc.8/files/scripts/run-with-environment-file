#!/usr/bin/env python3
"""Execute one command with a validated private env file and a clean parent."""

from __future__ import annotations

import argparse
import os
import re
import stat
import sys
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--env-file", required=True)
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument(
        "--as-selector",
        choices=("PEANUT_SERVER_ENV_FILE", "PEANUT_CLIENT_ENV_FILE"),
        help="pass only the validated file path through the named loader selector",
    )
    mode.add_argument(
        "--clean-only",
        action="store_true",
        help="validate the file but pass no project configuration to the child",
    )
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if not args.command or args.command[0] != "--" or len(args.command) < 2:
        parser.error("a command is required after --")
    path = Path(args.env_file)
    if not path.is_absolute() or not path.is_file() or path.is_symlink():
        parser.error("--env-file must be an absolute regular file")
    metadata = path.stat()
    if stat.S_IMODE(metadata.st_mode) != 0o600 or metadata.st_nlink != 1:
        parser.error("--env-file must have mode 0600 and one hard link")
    values: dict[str, str] = {}
    for number, line in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        if not line or line.startswith("#"):
            continue
        name, separator, value = line.partition("=")
        if not separator or not re.fullmatch(r"[A-Z][A-Z0-9_]*", name) or name in values:
            parser.error(f"invalid environment file line {number}")
        values[name] = value
    environment = {
        key: value
        for key in ("PATH", "HOME", "TMPDIR", "SSH_AUTH_SOCK", "SystemRoot", "COMSPEC", "PATHEXT")
        if (value := os.environ.get(key))
    }
    if args.as_selector:
        environment[args.as_selector] = str(path)
    elif not args.clean_only:
        environment.update(values)
    os.execvpe(args.command[1], args.command[1:], environment)
    return 127


if __name__ == "__main__":
    raise SystemExit(main())
