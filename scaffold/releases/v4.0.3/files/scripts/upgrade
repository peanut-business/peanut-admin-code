#!/usr/bin/env php
<?php

declare(strict_types=1);

use app\common\infrastructure\scaffold\EditionUpgradePackage;
use app\common\infrastructure\scaffold\ScaffoldUpgradeRunner;
use app\common\validation\scaffold\ScaffoldPathGuard;

$nativeEntry = str_ends_with(__FILE__, '/server/docker/scripts/upgrade');
$toolRoot = $nativeEntry ? dirname(__DIR__, 3) : dirname(__DIR__);
$runtimeRoot = $nativeEntry ? dirname(__DIR__) : $toolRoot;
$serverScope = in_array('--scope=server', $argv, true);
// 可信入口使用其自身已安装的Composer/Core；不能从尚未校验完整性的目标包加载依赖。
$installedAutoload = $toolRoot . '/server/vendor/autoload.php';
if (!is_file($installedAutoload)) {
    fwrite(STDERR, json_encode(['status' => 'error', 'error' => 'PRODUCT_UPGRADE_DEPENDENCIES_MISSING'], JSON_THROW_ON_ERROR) . "\n");
    exit(1);
}
require_once $installedAutoload;
foreach ($serverScope ? [['/scripts/scaffold-runtime/ScaffoldPathGuard.php']] : [
    ['/scripts/scaffold-runtime/ScaffoldPathGuard.php'],
    ['/scripts/scaffold-runtime/ScaffoldManifest.php'],
    ['/scripts/scaffold-runtime/ScaffoldUpgradeLedger.php'],
    ['/scripts/scaffold-runtime/Semver.php'],
    ['/scripts/scaffold-runtime/ReleaseDependencyIdentity.php'],
    ['/server/app/platform/exception/plugin/PluginLifecycleException.php', '/scripts/upgrade-runtime/PluginLifecycleException.php'],
    ['/server/app/platform/value/plugin/PluginDescriptor.php', '/scripts/upgrade-runtime/PluginDescriptor.php'],
    ['/server/app/platform/infrastructure/plugin/PluginLockResolver.php', '/scripts/upgrade-runtime/PluginLockResolver.php'],
    ['/server/app/platform/exception/plugin/PluginArtifactToolException.php', '/scripts/upgrade-runtime/PluginArtifactToolException.php'],
    ['/server/app/platform/exception/plugin/PluginPackageException.php', '/scripts/upgrade-runtime/PluginPackageException.php'],
    ['/server/app/platform/value/plugin/ModuleFrontendLayout.php', '/scripts/upgrade-runtime/ModuleFrontendLayout.php'],
    ['/server/app/platform/infrastructure/plugin/PluginArtifactWriter.php', '/scripts/upgrade-runtime/PluginArtifactWriter.php'],
    ['/server/app/platform/validation/module/ModulePublicSurfacePolicy.php', '/scripts/upgrade-runtime/ModulePublicSurfacePolicy.php'],
    ['/server/app/platform/validation/module/OpisManifestSchemaValidator.php', '/scripts/upgrade-runtime/OpisManifestSchemaValidator.php'],
    ['/server/app/platform/validation/module/StrictVersionConstraintMatcher.php', '/scripts/upgrade-runtime/StrictVersionConstraintMatcher.php'],
    ['/server/app/platform/validation/plugin/ModulePackagePreflight.php', '/scripts/upgrade-runtime/ModulePackagePreflight.php'],
    ['/scripts/scaffold-runtime/ScaffoldUpgradeRunner.php'],
    ['/scripts/scaffold-runtime/EditionUpgradePackage.php'],
] as $candidates) {
    foreach ($candidates as $candidate) {
        if (is_file($runtimeRoot . $candidate)) {
            require_once $runtimeRoot . $candidate;
            continue 2;
        }
    }
    throw new RuntimeException('PRODUCT_UPGRADE_RUNTIME_MISSING');
}

function productUpgradeToolPath(string $relative): string
{
    global $toolRoot, $runtimeRoot;
    return (str_starts_with($relative, 'server/') ? $toolRoot : $runtimeRoot) . '/' . $relative;
}

function productUpgradeUsage(): never
{
    fwrite(STDERR, "Set PEANUT_SERVER_ENV_FILE to the absolute mode-0600 instance backend environment.\nUsage:\n"
        . "  php scripts/upgrade plan --scope=source --instance-root=<development-app> --package=<verified-full-upstream-package>\n"
        . "  php scripts/upgrade apply|verify|recover --scope=source --instance-root=<development-app> --package=<full-upstream-package> --plan=<absolute-scaffold-plan>\n"
        . "  php scripts/upgrade plan --scope=server --instance-root=<mounted-app> --package=<workspace> --archive=<app-server-release> --expected-sha256=<trusted-sha256>\n"
        . "  php scripts/upgrade apply|verify|recover --scope=server --instance-root=<mounted-app> --package=<workspace> --plan=<absolute-product-plan>\n"
        . "  server apply alone accepts --stop-before=health|activate; source scope changes source only.\n");
    exit(64);
}

/** @param array<string,mixed> $value */
function productUpgradeCanonicalJson(array $value): string
{
    $normalize = static function (mixed $item) use (&$normalize): mixed {
        if (!is_array($item)) {
            return $item;
        }
        if (!array_is_list($item)) {
            ksort($item, SORT_STRING);
        }
        foreach ($item as $key => $child) {
            $item[$key] = $normalize($child);
        }
        return $item;
    };
    return json_encode($normalize($value), JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
}

/** @param array<string,mixed> $value */
function productUpgradeWriteJson(string $path, array $value): void
{
    $directory = dirname($path);
    if ((!is_dir($directory) && !mkdir($directory, 0770, true)) || is_link($directory)) {
        throw new RuntimeException('PRODUCT_UPGRADE_PLAN_DIRECTORY_INVALID');
    }
    $temporary = $path . '.tmp-' . bin2hex(random_bytes(6));
    $json = json_encode($value, JSON_THROW_ON_ERROR | JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n";
    if (is_link($path) || (file_exists($path) && (!is_file($path) || (lstat($path)['nlink'] ?? 0) !== 1))) {
        throw new RuntimeException('PRODUCT_UPGRADE_RECORD_UNSAFE');
    }
    $stream = fopen($temporary, 'x');
    if ($stream === false || !chmod($temporary, 0600)
        || fwrite($stream, $json) !== strlen($json) || !fflush($stream) || !fsync($stream)) {
        if (is_resource($stream)) { fclose($stream); }
        @unlink($temporary);
        throw new RuntimeException('PRODUCT_UPGRADE_PLAN_WRITE_FAILED');
    }
    fclose($stream);
    if (!rename($temporary, $path)) { @unlink($temporary); throw new RuntimeException('PRODUCT_UPGRADE_PLAN_WRITE_FAILED'); }
    $handle = fopen($directory, 'r');
    if ($handle === false || !fsync($handle)) { throw new RuntimeException('PRODUCT_UPGRADE_DIRECTORY_SYNC_FAILED'); }
    fclose($handle);
}

/** @return array<string,mixed> */
function productUpgradeReadPlan(string $instanceRoot, string $path): array
{
    $root = ScaffoldPathGuard::projectRoot($instanceRoot);
    $resolved = realpath($path);
    $plansRoot = $root . '/.peanut/upgrades/product-plans/';
    if (!is_string($resolved) || $resolved !== $path || !str_starts_with($resolved, $plansRoot)
        || !is_file($resolved) || is_link($resolved)) {
        throw new RuntimeException('PRODUCT_UPGRADE_PLAN_INVALID');
    }
    try {
        $plan = json_decode((string) file_get_contents($resolved), true, 256, JSON_THROW_ON_ERROR);
    } catch (JsonException $exception) {
        throw new RuntimeException('PRODUCT_UPGRADE_PLAN_INVALID', 0, $exception);
    }
    if (!is_array($plan)
        || ($plan['schema_version'] ?? null) !== 2
        || ($plan['protocol'] ?? null) !== 'peanut.product-upgrade-plan.v2'
        || ($plan['instance_root'] ?? null) !== $root
        || !is_string($plan['plan_sha256'] ?? null)) {
        throw new RuntimeException('PRODUCT_UPGRADE_PLAN_INVALID');
    }
    $digest = $plan['plan_sha256'];
    unset($plan['plan_sha256']);
    if (!hash_equals($digest, 'sha256:' . hash('sha256', productUpgradeCanonicalJson($plan)))) {
        throw new RuntimeException('PRODUCT_UPGRADE_PLAN_INVALID');
    }
    return $plan + ['plan_sha256' => $digest, 'absolute_path' => $resolved];
}

/** @return resource */
function productUpgradeAcquireLock(string $instanceRoot)
{
    $directory = $instanceRoot . '/.peanut/upgrades';
    if ((!is_dir($directory) && !mkdir($directory, 0770, true)) || is_link($directory)) {
        throw new RuntimeException('PRODUCT_UPGRADE_STATE_DIRECTORY_INVALID');
    }
    $handle = fopen($directory . '/product.lock', 'c+');
    $lockStat = lstat($directory . '/product.lock');
    if ($handle === false || is_link($directory . '/product.lock') || !is_array($lockStat)
        || ($lockStat['nlink'] ?? 0) !== 1 || !chmod($directory . '/product.lock', 0600)
        || !flock($handle, LOCK_EX | LOCK_NB)) {
        if (is_resource($handle)) {
            fclose($handle);
        }
        throw new RuntimeException('PRODUCT_UPGRADE_ALREADY_RUNNING');
    }
    return $handle;
}

/** @param resource $handle */
function productUpgradeReleaseLock($handle): void
{
    flock($handle, LOCK_UN);
    fclose($handle);
}

/** @param array<string,mixed> $state */
function productUpgradeWriteState(string $path, array $state): array
{
    unset($state['state_sha256'], $state['absolute_path']);
    $state['updated_at'] = gmdate(DATE_ATOM);
    $state['state_sha256'] = 'sha256:' . hash('sha256', productUpgradeCanonicalJson($state));
    productUpgradeWriteJson($path, $state);
    return $state + ['absolute_path' => $path];
}

/** @return array<string,mixed> */
function productUpgradeReadState(array $plan): array
{
    $path = $plan['state_path'] ?? null;
    $expectedPath = $plan['instance_root'] . '/.peanut/upgrades/product-state/' . $plan['candidate'] . '.json';
    if (!is_string($path) || $path !== $expectedPath || !is_file($path) || is_link($path)) {
        throw new RuntimeException('PRODUCT_UPGRADE_STATE_MISSING');
    }
    try {
        $state = json_decode((string) file_get_contents($path), true, 256, JSON_THROW_ON_ERROR);
    } catch (JsonException $exception) {
        throw new RuntimeException('PRODUCT_UPGRADE_STATE_INVALID', 0, $exception);
    }
    $digest = is_array($state) ? ($state['state_sha256'] ?? null) : null;
    if (!is_array($state)
        || ($state['schema_version'] ?? null) !== 1
        || ($state['protocol'] ?? null) !== 'peanut.product-upgrade-state.v1'
        || ($state['candidate'] ?? null) !== ($plan['candidate'] ?? null)
        || ($state['plan_sha256'] ?? null) !== ($plan['plan_sha256'] ?? null)
        || ($state['package'] ?? null) !== ($plan['package'] ?? null)
        || !in_array($state['phase'] ?? null, [
            'planned', 'blocked', 'prepared', 'migration_preflight_complete', 'backed_up', 'quiesced',
            'managed_files_applied', 'migrations_started', 'migrations_applied', 'switched',
            'reloaded_safe', 'migration_verified', 'healthy', 'activating', 'completed', 'recovering', 'recovered',
        ], true)
        || !in_array($state['phase_in_progress'] ?? null, [
            null, 'prepare', 'migration-preflight', 'backup', 'quiesce', 'managed_files', 'migrate',
            'switch', 'reload-safe', 'migration-verify', 'health', 'activate', 'recover', 'resume-old', 'recovery-verify',
        ], true)
        || !is_bool($state['database_recovery_required'] ?? null)
        || !is_bool($state['migration_completed'] ?? null)
        || !is_bool($state['activation_started'] ?? null)
        || !is_array($state['evidence'] ?? null)
        || !is_string($digest)) {
        throw new RuntimeException('PRODUCT_UPGRADE_STATE_INVALID');
    }
    unset($state['state_sha256']);
    if (!hash_equals($digest, 'sha256:' . hash('sha256', productUpgradeCanonicalJson($state)))) {
        throw new RuntimeException('PRODUCT_UPGRADE_STATE_INVALID');
    }
    return $state + ['state_sha256' => $digest, 'absolute_path' => $path];
}

/** @param array<string,mixed> $plan @param array<string,mixed> $state @return array<string,mixed> */
function productUpgradeHostPhase(string $packageRoot, string $phase, array $plan, array $state): array
{
    productUpgradeVerifyRuntime($plan);
    if (!in_array($phase, [
        'prepare', 'migration-preflight', 'backup', 'quiesce', 'migrate', 'switch',
        'reload-safe', 'migration-verify', 'health', 'activate', 'recover', 'resume-old', 'recovery-verify',
    ], true)) {
        throw new RuntimeException('PRODUCT_UPGRADE_HOST_PHASE_INVALID');
    }
    $driver = $plan['workspace'] . '/trusted/scripts/product-upgrade-host';
    if (!is_file($driver) || is_link($driver) || !is_executable($driver)) {
        throw new RuntimeException('PRODUCT_UPGRADE_HOST_DRIVER_INVALID');
    }
    $command = [
        $driver,
        $phase,
        '--instance-root=' . $plan['instance_root'],
        '--package=' . $packageRoot,
        '--plan=' . $plan['absolute_path'],
        '--state=' . $state['absolute_path'],
    ];
    $logDirectory = $plan['instance_root'] . '/.peanut/upgrades/host-logs';
    if ((!is_dir($logDirectory) && !mkdir($logDirectory, 0700, true)) || is_link($logDirectory)) {
        throw new RuntimeException('PRODUCT_UPGRADE_HOST_LOG_INVALID');
    }
    $logPath = $logDirectory . '/' . $plan['candidate'] . '-' . $phase . '.log';
    if (file_exists($logPath) || is_link($logPath)) {
        $logStat = lstat($logPath);
        if (!is_file($logPath) || is_link($logPath) || !is_array($logStat)
            || ($logStat['nlink'] ?? 0) !== 1 || (($logStat['mode'] ?? 0) & 0777) !== 0600) {
            throw new RuntimeException('PRODUCT_UPGRADE_HOST_LOG_INVALID');
        }
        $log = fopen($logPath, 'ab');
    } else {
        $log = fopen($logPath, 'xb');
    }
    if ($log === false || !chmod($logPath, 0600)) {
        if (is_resource($log)) {
            fclose($log);
        }
        throw new RuntimeException('PRODUCT_UPGRADE_HOST_LOG_INVALID');
    }
    $pipes = [];
    $process = proc_open($command, [0 => ['file', '/dev/null', 'r'], 1 => ['pipe', 'w'], 2 => $log], $pipes, $packageRoot);
    if (!is_resource($process)) {
        fclose($log);
        throw new RuntimeException('PRODUCT_UPGRADE_HOST_DRIVER_FAILED');
    }
    $stdout = stream_get_contents($pipes[1]);
    fclose($pipes[1]);
    $exitCode = proc_close($process);
    fclose($log);
    if ($exitCode !== 0 || !is_string($stdout)) {
        throw new RuntimeException('PRODUCT_UPGRADE_HOST_PHASE_FAILED:' . $phase . ':exit-' . $exitCode);
    }
    try {
        $evidence = json_decode(trim($stdout), true, 128, JSON_THROW_ON_ERROR);
    } catch (JsonException $exception) {
        throw new RuntimeException('PRODUCT_UPGRADE_HOST_EVIDENCE_INVALID:' . $phase, 0, $exception);
    }
    if (!is_array($evidence)
        || ($evidence['protocol'] ?? null) !== 'peanut.product-upgrade-host-evidence.v1'
        || ($evidence['status'] ?? null) !== 'completed'
        || ($evidence['phase'] ?? null) !== $phase
        || ($evidence['candidate'] ?? null) !== $plan['candidate']
        || ($evidence['plan_sha256'] ?? null) !== $plan['plan_sha256']
        || ($evidence['package_manifest_sha256'] ?? null) !== $plan['package']['manifest_sha256']
        || !is_array($evidence['payload'] ?? null)
        || $evidence['payload'] === []) {
        throw new RuntimeException('PRODUCT_UPGRADE_HOST_EVIDENCE_INVALID:' . $phase);
    }
    return [
        'sha256' => 'sha256:' . hash('sha256', productUpgradeCanonicalJson($evidence)),
        'payload' => $evidence,
    ];
}

/** @return list<string> */
function productUpgradeRuntimeFiles(): array
{
    $files = ['scripts/product-upgrade-host'];
    foreach (['update-plan.php', 'update-database.php', 'update-preparation.py', 'update-recovery.py',
        'prepare-vendor.sh', 'prepare-vendor.php', 'vendor-state.py'] as $name) {
        $files[] = 'server/docker/scripts/' . $name;
    }
    return $files;
}

/** Verify frozen bytes from the installed coordinator before executing any adapter. */
function productUpgradeVerifyRuntime(array $plan): void
{
    $root = $plan['workspace'] . '/trusted';
    if (!is_dir($root) || is_link($root)) {
        throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_TOOL_INVALID');
    }
    $manifest = $root . '/manifest.json';
    if (!is_file($manifest) || is_link($manifest)
        || hash_file('sha256', $manifest) !== $plan['runtime_sha256']) {
        throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_MANIFEST_CHANGED');
    }
    $rows = json_decode((string) file_get_contents($manifest), true, 32, JSON_THROW_ON_ERROR);
    $expected = productUpgradeRuntimeFiles();
    sort($expected, SORT_STRING);
    $keys = is_array($rows) ? array_keys($rows) : [];
    sort($keys, SORT_STRING);
    if ($keys !== $expected) {
        throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_INVENTORY_INVALID');
    }
    $actual = [];
    foreach (new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS), RecursiveIteratorIterator::SELF_FIRST) as $file) {
        if ($file->isLink() || (!$file->isDir() && !$file->isFile())) {
            throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_TOOL_INVALID');
        }
        if ($file->isFile()) {
            $actual[] = substr($file->getPathname(), strlen($root) + 1);
        }
    }
    $expected[] = 'manifest.json';
    sort($expected, SORT_STRING);
    sort($actual, SORT_STRING);
    if ($actual !== $expected) {
        throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_INVENTORY_INVALID');
    }
    foreach ($rows as $relative => $digest) {
        $path = $root . '/' . $relative;
        $stat = lstat($path);
        if (!is_string($digest) || !is_array($stat) || ($stat['nlink'] ?? 0) !== 1
            || !in_array(($stat['mode'] ?? 0) & 0777, [0600, 0700], true)
            || hash_file('sha256', $path) !== $digest) {
            throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_TOOL_CHANGED');
        }
    }
}

/** Freeze installed phase adapters before managed files can change them. */
function productUpgradeFreezeRuntime(string $workspace): string
{
    $rows = [];
    foreach (productUpgradeRuntimeFiles() as $relative) {
        $source = productUpgradeToolPath($relative);
        $target = $workspace . '/trusted/' . $relative;
        if (!is_file($source) || is_link($source)) { throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_TOOL_MISSING'); }
        $digest = hash_file('sha256', $source);
        if (file_exists($target) || is_link($target)) {
            if (!is_file($target) || is_link($target) || hash_file('sha256', $target) !== $digest) {
                throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_TOOL_COLLISION');
            }
        } else {
            if (!is_dir(dirname($target)) && !mkdir(dirname($target), 0700, true)) {
                throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_TOOL_WRITE_FAILED');
            }
            if (!copy($source, $target) || !chmod($target, is_executable($source) ? 0700 : 0600)) {
                throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_TOOL_WRITE_FAILED');
            }
        }
        $rows[$relative] = $digest;
    }
    productUpgradeWriteJson($workspace . '/trusted/manifest.json', $rows);
    return hash_file('sha256', $workspace . '/trusted/manifest.json');
}

function productUpgradeServerPackage(string $instanceRoot, string $workspace, ?string $archive, ?string $expected): array
{
    if (!is_file($workspace . '/plan.json')) {
        require_once productUpgradeToolPath('server/docker/scripts/update-plan.php');
        if ($archive === null || $expected === null) { throw new RuntimeException('PRODUCT_UPGRADE_SERVER_ARCHIVE_REQUIRED'); }
        $input = PeanutServerUpdatePlan::build($instanceRoot . '/server', $archive, $expected, $workspace);
    } else {
        $input = json_decode((string) file_get_contents($workspace . '/plan.json'), true, 256, JSON_THROW_ON_ERROR);
        if (($input['protocol'] ?? null) !== 'peanut.server-release-inputs.v1') {
            throw new RuntimeException('PRODUCT_UPGRADE_SERVER_INPUT_PROTOCOL_INVALID');
        }
        if ($archive !== null && (hash_file('sha256', $archive) !== $expected || $input['target']['archive_sha256'] !== $expected)) {
            throw new RuntimeException('PRODUCT_UPGRADE_SERVER_ARCHIVE_REBIND_FAILED');
        }
    }
    $target = $workspace . '/prepared/server/.peanut/release-identity.json';
    if (!is_file($target) || is_link($target) || hash_file('sha256', $target) !== $input['target']['identity_sha256']) {
        throw new RuntimeException('PRODUCT_UPGRADE_SERVER_INVENTORY_REBIND_FAILED');
    }
    $identity = json_decode((string) file_get_contents($target), true, 256, JSON_THROW_ON_ERROR);
    foreach ($identity['files'] as $file) {
        $path = $workspace . '/prepared/' . $file['path'];
        if (!is_file($path) || is_link($path) || hash_file('sha256', $path) !== $file['sha256']
            || (fileperms($path) & 0777) !== $file['mode']) {
            throw new RuntimeException('PRODUCT_UPGRADE_SERVER_FILE_REBIND_FAILED');
        }
    }
    return ['input' => $input, 'identity' => $identity];
}

function productUpgradeCode(string $operation, array $plan): mixed
{
    productUpgradeVerifyRuntime($plan);
    if (!class_exists('PeanutServerUpdatePlan', false)) {
        require_once $plan['workspace'] . '/trusted/server/docker/scripts/update-plan.php';
    }
    return PeanutServerUpdatePlan::productPhase($plan['instance_root'] . '/server', $plan['workspace'], match ($operation) {
        'apply' => 'files-apply', 'verify' => 'files-verify', 'recover' => 'files-recover', 'verifyRecovery' => 'files-verify-recovery',
    });
}

/** @param array<string,mixed> $state @param array<string,mixed> $evidence @return array<string,mixed> */
function productUpgradeCompleteHostPhase(array $state, string $statePath, string $phase, string $completed, array $evidence): array
{
    $state['phase'] = $completed;
    $state['phase_in_progress'] = null;
    $state['evidence'][$phase] = $evidence;
    return productUpgradeWriteState($statePath, $state);
}

/** @param array<string,mixed> $plan @param array<string,mixed> $state @return array<string,mixed> */
function productUpgradeEnsureHostPhase(
    string $packageRoot,
    array $plan,
    array $state,
    string $phase,
    string $completed,
): array {
    if (isset($state['evidence'][$phase])) {
        return $state;
    }
    $state['phase_in_progress'] = $phase;
    $state = productUpgradeWriteState((string) $state['absolute_path'], $state);
    $evidence = productUpgradeHostPhase($packageRoot, $phase, $plan, $state);
    return productUpgradeCompleteHostPhase($state, (string) $state['absolute_path'], $phase, $completed, $evidence);
}

/** @param array<string,mixed> $plan @param array<string,mixed> $state @return array<string,mixed> */
function productUpgradeRefreshHostPhase(string $packageRoot, array $plan, array $state, string $phase): array
{
    $state['phase_in_progress'] = $phase;
    $state = productUpgradeWriteState((string) $state['absolute_path'], $state);
    $evidence = productUpgradeHostPhase($packageRoot, $phase, $plan, $state);
    $state['phase_in_progress'] = null;
    $state['evidence'][$phase] = $evidence;
    return productUpgradeWriteState((string) $state['absolute_path'], $state);
}

$command = $argv[1] ?? null;
if (!in_array($command, ['plan', 'apply', 'verify', 'recover'], true)) {
    productUpgradeUsage();
}
$options = [];
foreach (array_slice($argv, 2) as $argument) {
    if (preg_match('/^--(instance-root|package|plan|stop-before|scope|archive|expected-sha256)=(.+)$/D', $argument, $matches) !== 1
        || isset($options[$matches[1]])) {
        productUpgradeUsage();
    }
    $options[$matches[1]] = $matches[2];
}
$required = ['instance-root', 'package'];
if (!isset($options['scope'])) { productUpgradeUsage(); }
if (isset($options['scope'])) {
    if (!in_array($options['scope'], ['source', 'server'], true)) { productUpgradeUsage(); }
    $required[] = 'scope';
    if ($command === 'plan' && $options['scope'] === 'server') { $required[] = 'archive'; $required[] = 'expected-sha256'; }
}
if ($command !== 'plan') {
    $required[] = 'plan';
}
if (isset($options['stop-before'])) {
    if ($command !== 'apply' || ($options['scope'] ?? 'source') !== 'server' || !in_array($options['stop-before'], ['health', 'activate'], true)) {
        productUpgradeUsage();
    }
    $required[] = 'stop-before';
}
$actual = array_keys($options);
sort($actual, SORT_STRING);
$expected = $required;
sort($expected, SORT_STRING);
if ($actual !== $expected) {
    productUpgradeUsage();
}

$lock = null;
try {
    $instanceRoot = ScaffoldPathGuard::projectRoot($options['instance-root']);
    $lock = productUpgradeAcquireLock($instanceRoot);
    $packageRoot = realpath($options['package']);
    if (!is_string($packageRoot)) {
        throw new RuntimeException('PRODUCT_UPGRADE_PACKAGE_NOT_FOUND');
    }
    if ($options['scope'] === 'source' && $nativeEntry) { throw new RuntimeException('PRODUCT_UPGRADE_SOURCE_REQUIRES_FULL_APPLICATION_TOOLS'); }

    if (($options['scope'] ?? 'source') === 'source') {
        $runner = new ScaffoldUpgradeRunner();
        $packageService = new EditionUpgradePackage();
        if ($command === 'plan') {
            $prepared = $packageService->prepare($instanceRoot, $packageRoot);
            $result = $runner->preflight($instanceRoot, $prepared['from_manifest'], $prepared['to_manifest']);
            $result['plan_path'] = $instanceRoot . '/' . $result['plan_path'];
        } else {
            $prepared = $packageService->reauthenticate($instanceRoot, $packageRoot);
            $sourcePlan = json_decode((string) file_get_contents($options['plan']), true, 256, JSON_THROW_ON_ERROR);
            if (($sourcePlan['protocol'] ?? null) !== 'peanut.scaffold-upgrade-plan.v2'
                || ($sourcePlan['manifest_paths']['to'] ?? null) !== $prepared['to_manifest']) {
                throw new RuntimeException('PRODUCT_UPGRADE_SOURCE_PACKAGE_REBIND_FAILED');
            }
            $result = $runner->{$command}($instanceRoot, $options['plan']);
        }
        $result['scope'] = 'source';
        $result['source_only'] = true;
        productUpgradeReleaseLock($lock);
        $lock = null;
        fwrite(STDOUT, json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n");
        exit(($result['status'] ?? null) === 'blocked' ? 2 : 0);
    }

    if ($command === 'plan') {
        // The installed coordinator and its installed runtime control package validation. No
        // executable from the target package is invoked until package validation succeeds.
        $scope = 'server';
        $serverPackage = productUpgradeServerPackage($instanceRoot, $packageRoot, $options['archive'], $options['expected-sha256']);
        $input = $serverPackage['input'];
        $identity = $serverPackage['identity'];
        if (($identity['application']['kind'] ?? null) !== 'application'
            || preg_match('/^[a-f0-9]{40}$/D', (string) ($identity['application']['commit'] ?? '')) !== 1
            || preg_match('/^[a-f0-9]{40}$/D', (string) ($identity['application']['tree'] ?? '')) !== 1) {
            throw new RuntimeException('PRODUCT_UPGRADE_REQUIRES_APPLICATION_RELEASE');
        }
        $scaffold = ['candidate' => $input['update_id'], 'status' => 'ready'];
        $packageIdentity = ['root' => $packageRoot, 'inventory_sha256' => 'sha256:' . $identity['files_sha256'],
            'manifest_sha256' => 'sha256:' . $input['target']['identity_sha256'],
            'target_version' => $identity['application']['version'], 'archive_sha256' => $input['target']['archive_sha256'],
            'source_commit' => $identity['application']['commit'], 'source_tree' => $identity['application']['tree']];
        $edition = ['name' => $identity['application']['edition']];
        $migrationFiles = array_values(array_map(static fn(array $row): array => ['path' => $row['path'], 'sha256' => $row['sha256']],
            array_filter($identity['files'], static fn(array $row): bool => preg_match('#^server/database/migrations/[0-9]{8}-[a-z0-9][a-z0-9_-]*\.sql$#D', $row['path']) === 1)));
        $workspace = $packageRoot;
        $existingPath = $instanceRoot . '/.peanut/upgrades/product-plans/' . $scaffold['candidate'] . '.json';
        if (is_file($existingPath) && !is_link($existingPath)) {
            $existing = productUpgradeReadPlan($instanceRoot, $existingPath);
            if (($existing['package'] ?? null) !== $packageIdentity
                || ($existing['scope'] ?? null) !== 'server'
                || ($existing['inputs_sha256'] ?? null) !== hash_file('sha256', $workspace . '/plan.json')
                || ($existing['migration']['target_version'] ?? null) !== $packageIdentity['target_version']
                || ($existing['migration']['files'] ?? null) !== $migrationFiles) {
                throw new RuntimeException('PRODUCT_UPGRADE_PLAN_COLLISION');
            }
            $binding = ['plan_path' => $existingPath, 'plan_sha256' => $existing['plan_sha256']];
            $bindingPath = $workspace . '/product-binding.json';
            if (!file_exists($bindingPath) && !is_link($bindingPath)) {
                productUpgradeWriteJson($bindingPath, $binding);
            } elseif (is_link($bindingPath) || json_decode((string) file_get_contents($bindingPath), true, 256, JSON_THROW_ON_ERROR) !== $binding) {
                throw new RuntimeException('PRODUCT_UPGRADE_PLAN_COLLISION');
            }
            if (!file_exists($existing['state_path']) && !is_link($existing['state_path'])) {
                foreach (['prepared.json', 'backup.json', 'journal.json', 'migration.json', 'preparation.json'] as $artifact) {
                    if (file_exists($workspace . '/' . $artifact) || is_link($workspace . '/' . $artifact)) {
                        throw new RuntimeException('PRODUCT_UPGRADE_STATE_LOST_REQUIRES_INSPECTION');
                    }
                }
                productUpgradeWriteState($existing['state_path'], [
                    'schema_version' => 1, 'protocol' => 'peanut.product-upgrade-state.v1',
                    'candidate' => $existing['candidate'], 'plan_sha256' => $existing['plan_sha256'], 'package' => $existing['package'],
                    'phase' => 'planned', 'phase_in_progress' => null, 'database_recovery_required' => false,
                    'migration_completed' => false, 'activation_started' => false, 'evidence' => [], 'created_at' => $existing['created_at'],
                ]);
            }
            productUpgradeReadState($existing);
            unset($existing['absolute_path']);
            $result = $existing + ['plan_path' => $existingPath, 'idempotent' => true];
        } else {
            $statePath = $instanceRoot . '/.peanut/upgrades/product-state/' . $scaffold['candidate'] . '.json';
            if (!is_dir($workspace) && !mkdir($workspace, 0700, true)) { throw new RuntimeException('PRODUCT_UPGRADE_WORKSPACE_INVALID'); }
            if (is_link($workspace) || realpath($workspace) !== $workspace) { throw new RuntimeException('PRODUCT_UPGRADE_WORKSPACE_INVALID'); }
            $runtimeDigest = productUpgradeFreezeRuntime($workspace);
            $plan = [
                'schema_version' => 2,
                'protocol' => 'peanut.product-upgrade-plan.v2',
                'candidate' => $scaffold['candidate'],
                'status' => $scaffold['status'],
                'instance_root' => $instanceRoot,
                'scope' => $scope,
                'workspace' => $workspace,
                'runtime_sha256' => $runtimeDigest,
                'inputs_sha256' => hash_file('sha256', $workspace . '/plan.json'),
                'package' => $packageIdentity,
                'edition' => $edition,
                'state_path' => $statePath,
                'migration' => [
                    'target_version' => $packageIdentity['target_version'],
                    'files' => $migrationFiles,
                    'execution' => 'bound-prepared-target-container',
                    'module_reconcile' => 'release-locked-before-switch',
                    'recovery' => 'paired-database-public-private-storage-backup',
                ],
                'phase_contract' => [
                    'prepare_target', 'migration_preflight', 'backup_and_hold_writers', 'verify_quiescence',
                    'apply_managed_files', 'application_and_module_migrations', 'switch_target',
                    'reload_safe_without_public_writers', 'migration_verify', 'runtime_and_business_health',
                    'activate_public_writers', 'complete',
                ],
                'created_at' => gmdate(DATE_ATOM),
            ];
            $plan['plan_sha256'] = 'sha256:' . hash('sha256', productUpgradeCanonicalJson($plan));
            $path = $instanceRoot . '/.peanut/upgrades/product-plans/' . $plan['candidate'] . '.json';
            productUpgradeWriteJson($path, $plan);
            productUpgradeWriteJson($workspace . '/product-binding.json', ['plan_path' => $path, 'plan_sha256' => $plan['plan_sha256']]);
            productUpgradeWriteState($statePath, [
                'schema_version' => 1,
                'protocol' => 'peanut.product-upgrade-state.v1',
                'candidate' => $plan['candidate'],
                'plan_sha256' => $plan['plan_sha256'],
                'package' => $plan['package'],
                'phase' => $plan['status'] === 'ready' ? 'planned' : 'blocked',
                'phase_in_progress' => null,
                'database_recovery_required' => false,
                'migration_completed' => false,
                'activation_started' => false,
                'evidence' => [],
                'created_at' => gmdate(DATE_ATOM),
            ]);
            $result = $plan + ['plan_path' => $path, 'authenticated' => true];
        }
    } else {
        $plan = productUpgradeReadPlan($instanceRoot, $options['plan']);
        if (($plan['package']['root'] ?? null) !== $packageRoot
            || !is_array($plan['migration']['files'] ?? null)) {
            throw new RuntimeException('PRODUCT_UPGRADE_PLAN_REBIND_FAILED');
        }
        $state = productUpgradeReadState($plan);
        if (($plan['scope'] ?? null) !== 'server') { throw new RuntimeException('PRODUCT_UPGRADE_SCOPE_REBIND_FAILED'); }
        if ($command === 'apply') {
            if ($plan['status'] !== 'ready' || $state['phase'] === 'blocked') {
                throw new RuntimeException('PRODUCT_UPGRADE_PLAN_BLOCKED');
            }
            if ($state['phase'] === 'recovered') {
                throw new RuntimeException('PRODUCT_UPGRADE_RECOVERED_PLAN_FINAL');
            }
            // 已进入恢复方向的计划只能完成恢复；不能复用旧阶段回执重新切换/开放写入。
            if ($state['phase'] === 'recovering' || array_key_exists('recovery_context', $state)) {
                throw new RuntimeException('PRODUCT_UPGRADE_RECOVERY_IN_PROGRESS');
            }
            $stopBefore = $options['stop-before'] ?? null;
            if ($stopBefore !== null && ($state['activation_started']
                || $state['phase_in_progress'] === 'activate' || isset($state['evidence']['activate'])
                || in_array($state['phase'], ['activating', 'completed'], true)
                || ($stopBefore === 'health' && ($state['phase_in_progress'] === 'health'
                    || isset($state['evidence']['health']) || $state['phase'] === 'healthy')))) {
                throw new RuntimeException('PRODUCT_UPGRADE_STOP_BOUNDARY_PASSED:' . $stopBefore);
            }
            productUpgradeServerPackage($instanceRoot, $packageRoot, null, null);
            if ($state['phase'] === 'completed') {
                // 重复apply也必须验证原完成结果，不能仅凭Host健康回执忽略源码/定制漂移。
                productUpgradeCode('verify', $plan);
                $state = productUpgradeRefreshHostPhase($packageRoot, $plan, $state, 'migration-verify');
                $state = productUpgradeRefreshHostPhase($packageRoot, $plan, $state, 'health');
                $result = [
                    'status' => 'completed', 'candidate' => $plan['candidate'], 'phase' => 'completed',
                    'plan_sha256' => $plan['plan_sha256'], 'idempotent' => true,
                    'state_sha256' => $state['state_sha256'],
                    'health_evidence_sha256' => $state['evidence']['health']['sha256'],
                    'activation_evidence_sha256' => $state['evidence']['activate']['sha256'],
                ];
            } else {
                $state = productUpgradeEnsureHostPhase($packageRoot, $plan, $state, 'prepare', 'prepared');
                $state = productUpgradeEnsureHostPhase($packageRoot, $plan, $state, 'migration-preflight', 'migration_preflight_complete');
                $state = productUpgradeEnsureHostPhase($packageRoot, $plan, $state, 'backup', 'backed_up');
                $state = productUpgradeEnsureHostPhase($packageRoot, $plan, $state, 'quiesce', 'quiesced');

                if (!isset($state['evidence']['managed_files'])) {
                    $state['phase_in_progress'] = 'managed_files';
                    $state = productUpgradeWriteState((string) $state['absolute_path'], $state);
                    $code = productUpgradeCode('apply', $plan);
                    $codeEvidence = [
                        'protocol' => 'peanut.product-upgrade-internal-evidence.v1', 'phase' => 'managed_files',
                        'candidate' => $plan['candidate'], 'payload' => $code,
                    ];
                    $state = productUpgradeCompleteHostPhase($state, (string) $state['absolute_path'], 'managed_files', 'managed_files_applied', [
                        'sha256' => 'sha256:' . hash('sha256', productUpgradeCanonicalJson($codeEvidence)),
                        'payload' => $codeEvidence,
                    ]);
                }

                if (!isset($state['evidence']['migrate'])) {
                    // This flag is persisted before both application SQL and Module reconciliation.
                    // Once true, recovery always restores the exact paired backup.
                    $state['phase'] = 'migrations_started';
                    $state['phase_in_progress'] = 'migrate';
                    $state['database_recovery_required'] = true;
                    $state = productUpgradeWriteState((string) $state['absolute_path'], $state);
                    $migrationEvidence = productUpgradeHostPhase($packageRoot, 'migrate', $plan, $state);
                    $state['migration_completed'] = true;
                    $state = productUpgradeCompleteHostPhase($state, (string) $state['absolute_path'], 'migrate', 'migrations_applied', $migrationEvidence);
                }

                $state = productUpgradeEnsureHostPhase($packageRoot, $plan, $state, 'switch', 'switched');
                $state = productUpgradeEnsureHostPhase($packageRoot, $plan, $state, 'reload-safe', 'reloaded_safe');
                $state = productUpgradeEnsureHostPhase($packageRoot, $plan, $state, 'migration-verify', 'migration_verified');
                if ($stopBefore !== 'health') {
                    $state = productUpgradeEnsureHostPhase($packageRoot, $plan, $state, 'health', 'healthy');
                    $code = productUpgradeCode('verify', $plan);
                }

                if ($stopBefore !== null) {
                    if ($state['phase'] !== ($stopBefore === 'health' ? 'migration_verified' : 'healthy')
                        || $state['phase_in_progress'] !== null || !$state['database_recovery_required']
                        || !$state['migration_completed'] || $state['activation_started']) {
                        throw new RuntimeException('PRODUCT_UPGRADE_STOP_STATE_INVALID:' . $stopBefore);
                    }
                    $result = [
                        'status' => 'paused', 'stop_before' => $stopBefore, 'candidate' => $plan['candidate'],
                        'phase' => $state['phase'], 'plan_sha256' => $plan['plan_sha256'],
                        'state_sha256' => $state['state_sha256'],
                        'database_recovery_required' => $state['database_recovery_required'],
                        'activation_started' => $state['activation_started'],
                        'host_evidence' => array_map(static fn(array $entry): string => $entry['sha256'], $state['evidence']),
                    ];
                    if ($stopBefore === 'activate') {
                        $result['code'] = $code;
                        $result['health_evidence_sha256'] = $state['evidence']['health']['sha256'];
                    }
                } else {
                    if (!isset($state['evidence']['activate'])) {
                        // Opening traffic is the irreversible recovery boundary. Persist it before
                        // the driver can start any public writer. Thereafter only forward repair is safe.
                        $state['phase'] = 'activating';
                        $state['phase_in_progress'] = 'activate';
                        $state['activation_started'] = true;
                        $state = productUpgradeWriteState((string) $state['absolute_path'], $state);
                        $activation = productUpgradeHostPhase($packageRoot, 'activate', $plan, $state);
                        $state = productUpgradeCompleteHostPhase($state, (string) $state['absolute_path'], 'activate', 'completed', $activation);
                    }
                    $state['completed_at'] ??= gmdate(DATE_ATOM);
                    $state = productUpgradeWriteState((string) $state['absolute_path'], $state);
                    $result = [
                        'status' => 'completed', 'candidate' => $plan['candidate'], 'phase' => 'completed',
                        'plan_sha256' => $plan['plan_sha256'], 'idempotent' => false, 'code' => $code,
                        'state_sha256' => $state['state_sha256'],
                        'host_evidence' => array_map(static fn(array $entry): string => $entry['sha256'], $state['evidence']),
                        'health_evidence_sha256' => $state['evidence']['health']['sha256'],
                        'activation_evidence_sha256' => $state['evidence']['activate']['sha256'],
                    ];
                }
            }
        } elseif ($command === 'verify') {
            productUpgradeServerPackage($instanceRoot, $packageRoot, null, null);
            if ($state['phase'] !== 'completed') {
                throw new RuntimeException('PRODUCT_UPGRADE_NOT_COMPLETED:' . $state['phase']);
            }
            $code = productUpgradeCode('verify', $plan);
            $state = productUpgradeRefreshHostPhase($packageRoot, $plan, $state, 'migration-verify');
            $state = productUpgradeRefreshHostPhase($packageRoot, $plan, $state, 'health');
            $state['verified_at'] = gmdate(DATE_ATOM);
            $state = productUpgradeWriteState((string) $state['absolute_path'], $state);
            $result = [
                'status' => 'verified', 'candidate' => $plan['candidate'], 'code' => $code,
                'health_evidence_sha256' => $state['evidence']['health']['sha256'],
                'migration_evidence_sha256' => $state['evidence']['migration-verify']['sha256'],
                'state_sha256' => $state['state_sha256'],
            ];
        } else {
            productUpgradeServerPackage($instanceRoot, $packageRoot, null, null);
            if ($state['phase'] === 'completed') {
                throw new RuntimeException('PRODUCT_UPGRADE_COMPLETED_RECOVERY_REQUIRES_NEW_CHANGE_PLAN');
            }
            if ($state['activation_started']) {
                throw new RuntimeException('PRODUCT_UPGRADE_ACTIVATION_STARTED_FORWARD_REPAIR_REQUIRED');
            }
            if ($state['phase'] === 'recovered') {
                $context = $state['recovery_context'] ?? null;
                if (!is_array($context) || !is_bool($context['managed_files_started'] ?? null)
                    || !isset($state['evidence']['recover'], $state['evidence']['resume-old'])) {
                    throw new RuntimeException('PRODUCT_UPGRADE_RECOVERY_STATE_INVALID');
                }
                $code = $context['managed_files_started']
                    ? productUpgradeCode('verifyRecovery', $plan)
                    : null;
                $state = productUpgradeRefreshHostPhase($packageRoot, $plan, $state, 'recovery-verify');
                $result = [
                    'status' => 'recovered', 'candidate' => $plan['candidate'],
                    'code' => $code,
                    'database_recovery_required' => $state['database_recovery_required'],
                    'recovery_evidence_sha256' => $state['evidence']['recover']['sha256'],
                    'resume_evidence_sha256' => $state['evidence']['resume-old']['sha256'],
                    'state_sha256' => $state['state_sha256'], 'idempotent' => true,
                ];
            } else {
                $context = $state['recovery_context'] ?? null;
                if (!is_array($context)) {
                    $managedFilesStarted = isset($state['evidence']['managed_files'])
                        || $state['phase_in_progress'] === 'managed_files'
                        || in_array($state['phase'], [
                            'managed_files_applied', 'migrations_started', 'migrations_applied', 'switched',
                            'reloaded_safe', 'migration_verified', 'healthy',
                        ], true);
                    $context = [
                        'managed_files_started' => $managedFilesStarted,
                        'original_phase' => $state['phase'],
                        'original_phase_in_progress' => $state['phase_in_progress'],
                    ];
                    $state['recovery_context'] = $context;
                    $state['phase'] = 'recovering';
                    $state['phase_in_progress'] = 'recover';
                    $state = productUpgradeWriteState((string) $state['absolute_path'], $state);
                }
                if (!isset($state['evidence']['recover'])) {
                    $recovery = productUpgradeHostPhase($packageRoot, 'recover', $plan, $state);
                    $state = productUpgradeCompleteHostPhase($state, (string) $state['absolute_path'], 'recover', 'recovering', $recovery);
                }
                $code = $context['managed_files_started']
                    ? productUpgradeCode('recover', $plan)
                    : null;
                if (!isset($state['evidence']['resume-old'])) {
                    $state = productUpgradeEnsureHostPhase($packageRoot, $plan, $state, 'resume-old', 'recovered');
                }
                $state['recovered_at'] ??= gmdate(DATE_ATOM);
                $state = productUpgradeWriteState((string) $state['absolute_path'], $state);
                $result = [
                    'status' => 'recovered', 'candidate' => $plan['candidate'], 'code' => $code,
                    'database_recovery_required' => $state['database_recovery_required'],
                    'recovery_evidence_sha256' => $state['evidence']['recover']['sha256'],
                    'resume_evidence_sha256' => $state['evidence']['resume-old']['sha256'],
                    'state_sha256' => $state['state_sha256'], 'idempotent' => false,
                ];
            }
        }
    }

    productUpgradeReleaseLock($lock);
    $lock = null;
    fwrite(STDOUT, json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n");
    exit(($result['status'] ?? null) === 'blocked' ? 2 : 0);
} catch (Throwable $exception) {
    if (is_resource($lock)) {
        productUpgradeReleaseLock($lock);
    }
    fwrite(STDERR, json_encode([
        'status' => 'error', 'error' => $exception->getMessage(),
    ], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n");
    exit(1);
}
