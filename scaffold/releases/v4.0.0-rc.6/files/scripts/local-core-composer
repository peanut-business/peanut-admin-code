#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
SERVER_DIR="$ROOT_DIR/server"
LOCAL_COMPOSER_DIR="$ROOT_DIR/.local/composer-core"
LOCAL_COMPOSER="$LOCAL_COMPOSER_DIR/composer.json"
LOCAL_LOCK="$LOCAL_COMPOSER_DIR/composer.lock"
CORE_DIR=""
BACKEND_ENV=""
COMPOSER_BIN="$ROOT_DIR/scripts/project-composer"
ACTION="${1:-install}"
[ $# -gt 0 ] && shift

die() {
    printf 'local-core-composer: %s\n' "$*" >&2
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --core-dir) [[ $# -ge 2 ]] || die '--core-dir requires a value'; CORE_DIR="$2"; shift 2 ;;
        --backend-env) [[ $# -ge 2 ]] || die '--backend-env requires a value'; BACKEND_ENV="$2"; shift 2 ;;
        *) die "unsupported argument: $1" ;;
    esac
done
[[ "$CORE_DIR" == /* ]] || die '--core-dir must be an absolute path'
if [[ "$ACTION" != manifest ]]; then
    [[ "$BACKEND_ENV" == /* && -f "$BACKEND_ENV" && ! -L "$BACKEND_ENV" ]] \
        || die '--backend-env must be an absolute regular file'
    # PHP is already required. lstat avoids incompatible BSD/GNU stat output
    # while preserving the exact regular-file, mode and hard-link checks.
    php -r '$s = lstat($argv[1]); exit(is_array($s) && ($s["mode"] & 0170000) === 0100000 && ($s["mode"] & 0777) === 0600 && $s["nlink"] === 1 ? 0 : 1);' "$BACKEND_ENV" \
        || die '--backend-env must have mode 0600 and one hard link'
fi
command -v "$COMPOSER_BIN" >/dev/null 2>&1 || die "Composer is unavailable: $COMPOSER_BIN"
CORE_DIR="$(CDPATH= cd -- "$CORE_DIR" && pwd)"
if [[ -f "$CORE_DIR/composer.json" ]]; then
    CORE_PACKAGE_DIR="$CORE_DIR"
elif [[ -f "$CORE_DIR/packages/php/composer.json" ]]; then
    CORE_PACKAGE_DIR="$CORE_DIR/packages/php"
else
    die "core checkout not found: expected $CORE_DIR/composer.json or $CORE_DIR/packages/php/composer.json"
fi
if [[ "$ACTION" != services && "$ACTION" != services-check ]]; then
    mkdir -p "$LOCAL_COMPOSER_DIR"
fi

required_version="$(php -r '$manifest = json_decode(file_get_contents($argv[1]), true, 512, JSON_THROW_ON_ERROR); echo $manifest["require"]["peanut-admin/core"] ?? "";' "$SERVER_DIR/composer.json")"
[[ -n "$required_version" ]] || die 'server/composer.json does not pin peanut-admin/core'
core_name="$(php -r '$manifest = json_decode(file_get_contents($argv[1]), true, 512, JSON_THROW_ON_ERROR); echo $manifest["name"] ?? "";' "$CORE_PACKAGE_DIR/composer.json")"
[[ "$core_name" == peanut-admin/core ]] || die 'selected checkout is not peanut-admin/core'
# The development path package uses its actual Git branch identity. Do not
# disguise an unpublished checkout as the production lock version or an alias.
core_branch="$(git -C "$CORE_PACKAGE_DIR" symbolic-ref --quiet --short HEAD)" \
    || die 'local development requires a named Core branch; use the locked package for detached candidates'
core_requirement="dev-$core_branch"

# Service-only actions must not reinstall dependencies or rewrite local manifests.
if [[ "$ACTION" != services && "$ACTION" != services-check ]]; then
php -r '
$source = json_decode(file_get_contents($argv[1]), true, 512, JSON_THROW_ON_ERROR);
$source["require"]["peanut-admin/core"] = $argv[6];
$source["repositories"] = array_merge([
    [
        "type" => "path",
        "url" => $argv[2],
        "options" => ["symlink" => true],
    ],
], $source["repositories"] ?? []);
// The ignored manifest lives outside server/. Root every source/test path at
// the selected application, including module-owned public namespaces.
$serverRoot = dirname($argv[5]);
foreach (["autoload", "autoload-dev"] as $section) {
    foreach (["psr-4", "psr-0"] as $kind) {
        foreach ($source[$section][$kind] ?? [] as $namespace => $paths) {
            $absolute = array_map(
                static fn(string $path): string => $serverRoot . "/" . ltrim($path, "/"),
                (array)$paths,
            );
            $source[$section][$kind][$namespace] = is_array($paths) ? $absolute : $absolute[0];
        }
    }
    foreach (["classmap", "files", "exclude-from-classmap"] as $kind) {
        if (isset($source[$section][$kind])) {
            $source[$section][$kind] = array_map(
                static fn(string $path): string => $serverRoot . "/" . ltrim($path, "/"),
                $source[$section][$kind],
            );
        }
    }
}
$source["config"]["vendor-dir"] = $argv[3];
file_put_contents(
    $argv[4],
    json_encode($source, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . PHP_EOL
);
' "$SERVER_DIR/composer.json" "$CORE_PACKAGE_DIR" "$SERVER_DIR/vendor" "$LOCAL_COMPOSER" "$SERVER_DIR/app" "$core_requirement"
fi

run_composer() {
    local tool_environment
    tool_environment="$(mktemp "$LOCAL_COMPOSER_DIR/tool-environment.XXXXXX")"
    chmod 600 "$tool_environment"
    printf 'COMPOSER=%s\nPEANUT_SERVER_ENV_FILE=%s\n' "$LOCAL_COMPOSER" "$BACKEND_ENV" > "$tool_environment"
    local status=0
    "$ROOT_DIR/scripts/run-with-environment-file" --env-file "$tool_environment" -- \
        "$COMPOSER_BIN" --working-dir="$SERVER_DIR" \
        --no-interaction \
        "$@" || status=$?
    rm -f "$tool_environment"
    return "$status"
}

# --no-scripts deliberately excludes vendor:publish and unrelated package hooks.
# It does not replace ThinkPHP's installed-package service registration. In
# particular, think-multi-app is loaded through vendor/services.php at HttpRun.
service_registry_preflight() {
    [[ -f "$SERVER_DIR/vendor/autoload.php" && -f "$SERVER_DIR/think" ]] \
        || die 'service discovery requires the installed application autoloader and think entry'
    local file
    for file in "$SERVER_DIR/vendor/services.php" "$SERVER_DIR/vendor/composer/installed.json"; do
        [[ ! -L "$file" && ( ! -e "$file" || -f "$file" ) ]] \
            || die 'service discovery requires regular generated metadata paths'
    done
    [[ -f "$SERVER_DIR/vendor/composer/installed.json" ]] \
        || die 'installed Composer package metadata is missing'
}

check_application_services() {
    php -r '
try {
    $stage = "installed-metadata";
    $root = $argv[1];
    $installed = json_decode(file_get_contents($root . "/vendor/composer/installed.json"), true, 512, JSON_THROW_ON_ERROR);
    $packages = $installed["packages"] ?? $installed;
    if (!is_array($packages) || !array_is_list($packages)) {
        throw new RuntimeException("invalid installed package metadata");
    }
    $expected = [];
    foreach ($packages as $package) {
        if (!is_array($package)) throw new RuntimeException("invalid package entry");
        if (empty($package["extra"]["think"]["services"])) continue;
        foreach ((array)$package["extra"]["think"]["services"] as $service) {
            if (!is_string($service) || $service === "") throw new RuntimeException("invalid service declaration");
            $expected[] = $service;
        }
    }
    $stage = "multi-app-declaration";
    if (!in_array("think\\app\\Service", $expected, true)) {
        throw new RuntimeException("multi-app service is not declared by installed packages");
    }
    $stage = "missing-registry";
    if (!is_file($root . "/vendor/services.php")) throw new RuntimeException("missing service registry");
    $stage = "registry-mismatch";
    $actual = require $root . "/vendor/services.php";
    if ($actual !== $expected) throw new RuntimeException("service registry differs from installed packages");
    $stage = "service-autoload";
    require_once $root . "/vendor/autoload.php";
    foreach ($actual as $service) {
        if (!class_exists($service)) throw new RuntimeException("registered service class unavailable");
    }
    echo "local application services ready: " . count($actual) . " (multi-app included)\n";
} catch (Throwable $exception) {
    // Do not print arbitrary exception details or environment values.
    fwrite(STDERR, "LOCAL_APPLICATION_SERVICE_REGISTRY_NOT_READY:" . $stage . "\n");
    exit(1);
}
' "$SERVER_DIR"
}

refresh_application_services() {
    # Run the framework's own command from the real application, not from the
    # ignored Composer projection. Do not run vendor:publish or migrations.
    (
        cd -- "$SERVER_DIR"
        PEANUT_SERVER_ENV_FILE="$BACKEND_ENV" php think service:discover
    ) || die 'ThinkPHP service discovery failed'
    check_application_services || die 'ThinkPHP service discovery did not produce a usable registry'
}

LOCK_BACKUP=""
preserve_application_lock() {
    [[ -f "$SERVER_DIR/composer.lock" ]] || return 0
    LOCK_BACKUP="$(mktemp "${TMPDIR:-/tmp}/peanut-admin-composer-lock.XXXXXX")"
    cp "$SERVER_DIR/composer.lock" "$LOCK_BACKUP"
}

restore_application_lock() {
    if [[ -n "$LOCK_BACKUP" && -f "$LOCK_BACKUP" ]]; then
        cp "$LOCK_BACKUP" "$SERVER_DIR/composer.lock"
        rm -f "$LOCK_BACKUP"
    fi
}

case "$ACTION" in
    install)
        # The committed lock remains the source of truth for every non-Core
        # dependency. Re-seed the ignored local lock so application dependency
        # updates cannot leave the path-repository workflow stale.
        preserve_application_lock
        trap restore_application_lock EXIT
        cp "$SERVER_DIR/composer.lock" "$LOCAL_LOCK"
        run_composer update peanut-admin/core --no-scripts --no-progress --prefer-dist
        ;;
    update|refresh)
        preserve_application_lock
        trap restore_application_lock EXIT
        cp "$SERVER_DIR/composer.lock" "$LOCAL_LOCK"
        run_composer update peanut-admin/core --no-scripts --no-progress --prefer-dist
        ;;
    autoload)
        run_composer dump-autoload --no-scripts
        ;;
    services|services-check)
        # Reconcile/check existing vendor metadata without a Composer operation.
        ;;
    manifest)
        printf '%s\n' "$LOCAL_COMPOSER"
        exit 0
        ;;
    *)
        die "usage: $0 {install|update|refresh|autoload|services|services-check|manifest} --core-dir /absolute/path [--backend-env /absolute/server/.env.name]"
        ;;
esac

installed_core="$SERVER_DIR/vendor/peanut-admin/core"
[[ -L "$installed_core" ]] || die "Composer did not install a symlinked local core package: $installed_core"
resolved_core="$(realpath "$installed_core")"
[[ "$resolved_core" == "$CORE_PACKAGE_DIR" ]] || die "core symlink resolves to $resolved_core, expected $CORE_PACKAGE_DIR"

service_registry_preflight
if [[ "$ACTION" == services-check ]]; then
    check_application_services
    exit 0
fi
refresh_application_services

printf 'local core active: %s -> %s\n' "$installed_core" "$resolved_core"
