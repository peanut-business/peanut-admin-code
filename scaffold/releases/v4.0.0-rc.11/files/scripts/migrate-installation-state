#!/usr/bin/env php
<?php

declare(strict_types=1);

// Run in maintenance with both the old runtime volume and new installation
// volume mounted. Never rewrite an installation identity or infer completion.
if (PHP_SAPI !== 'cli' || count($argv) !== 2 || !str_starts_with($argv[1], '--server-root=/')) {
    fwrite(STDERR, "Usage: php scripts/migrate-installation-state --server-root=/absolute/instance/server\n");
    exit(64);
}

try {
    $server = substr($argv[1], strlen('--server-root='));
    if (realpath($server) !== $server || !is_dir($server) || is_link($server)) {
        throw new RuntimeException('Server root must be a canonical ordinary directory.');
    }
    $legacy = $server . '/runtime/installation';
    $archived = $server . '/runtime/installation.migrated';
    $target = $server . '/private/installation';
    if (!is_dir($target) || is_link($target)) {
        throw new RuntimeException('Private installation volume is unavailable.');
    }
    if ((is_dir($legacy) && is_dir($archived)) || is_link($legacy) || is_link($archived)) {
        throw new RuntimeException('Legacy installation source and archive conflict.');
    }
    $source = is_dir($legacy) ? $legacy : $archived;
    if (!is_dir($source)) {
        throw new RuntimeException('No legacy installation identity or migration archive was found.');
    }
    if (!function_exists('posix_geteuid')) {
        throw new RuntimeException('POSIX identity check is required for installation state migration.');
    }
    $effectiveUid = posix_geteuid();
    $targetOwner = fileowner($target);
    $sourceOwner = fileowner($source);
    if ($targetOwner === false || $sourceOwner === false
        || $effectiveUid !== $targetOwner || $effectiveUid !== $sourceOwner
        || !is_writable($target) || !is_writable($source)
        || !is_writable(dirname($source))) {
        throw new RuntimeException('Run migration as the application UID that owns both installation state directories.');
    }

    $inspect = static function (string $directory): array {
        $files = [];
        foreach (new DirectoryIterator($directory) as $item) {
            if ($item->isDot()) {
                continue;
            }
            $name = $item->getFilename();
            if (!in_array($name, ['executing.json', 'installed.json', 'baseline.json', 'execution.lock', 'migration.json'], true)
                || $item->isLink() || !$item->isFile()) {
                throw new RuntimeException('Unexpected installation state entry.');
            }
            $stat = lstat($item->getPathname());
            if ($stat === false || $stat['nlink'] !== 1) {
                throw new RuntimeException('Installation state entry must have one hard link.');
            }
            if ($name === 'execution.lock' || $name === 'migration.json') {
                continue;
            }
            $digest = hash_file('sha256', $item->getPathname());
            if (!is_string($digest)) {
                throw new RuntimeException('Installation state digest is unavailable.');
            }
            $files[$name] = ['sha256' => $digest, 'bytes' => $stat['size']];
        }
        ksort($files);
        return $files;
    };
    $acquire = static function (string $path) {
        if (is_link($path) || (file_exists($path) && !is_file($path))) {
            throw new RuntimeException('Installation execution lock is unsafe.');
        }
        $lock = fopen($path, 'c+');
        if ($lock === false || !flock($lock, LOCK_EX | LOCK_NB)) {
            if (is_resource($lock)) {
                fclose($lock);
            }
            throw new RuntimeException('Installation execution is active.');
        }
        $held = fstat($lock);
        $visible = lstat($path);
        if ($held === false || $visible === false || $held['dev'] !== $visible['dev']
            || $held['ino'] !== $visible['ino'] || $visible['nlink'] !== 1) {
            flock($lock, LOCK_UN);
            fclose($lock);
            throw new RuntimeException('Installation execution lock changed.');
        }
        return $lock;
    };
    $writeRecord = static function (array $record) use ($target): void {
        $temporary = $target . '/.migration-record-' . bin2hex(random_bytes(8));
        $bytes = json_encode($record, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES) . "\n";
        if (file_put_contents($temporary, $bytes, LOCK_EX) !== strlen($bytes)
            || !chmod($temporary, 0600) || !rename($temporary, $target . '/migration.json')) {
            @unlink($temporary);
            throw new RuntimeException('Cannot publish installation migration record.');
        }
    };
    $clearInterruptedTemporaryFiles = static function () use ($target): void {
        foreach (new DirectoryIterator($target) as $item) {
            if ($item->isDot() || preg_match('/^\.migration-(?:copy|record)-[a-f0-9]{16}$/D', $item->getFilename()) !== 1) {
                continue;
            }
            $stat = lstat($item->getPathname());
            if ($item->isLink() || !$item->isFile() || $stat === false || $stat['nlink'] !== 1
                || !unlink($item->getPathname())) {
                throw new RuntimeException('Interrupted migration temporary file requires inspection.');
            }
        }
    };

    $oldLock = $acquire($source . '/execution.lock');
    try {
        $newLock = $acquire($target . '/execution.lock');
        try {
            $clearInterruptedTemporaryFiles();
            $files = $inspect($source);
            if ($files === []) {
                throw new RuntimeException('Legacy installation has no identity markers.');
            }
            $published = $inspect($target);
            foreach ($published as $name => $identity) {
                if (!isset($files[$name]) || $files[$name] !== $identity) {
                    throw new RuntimeException('Target installation identity differs from legacy state.');
                }
            }
            $recordPath = $target . '/migration.json';
            if (file_exists($recordPath) || is_link($recordPath)) {
                if (!is_file($recordPath) || is_link($recordPath)) {
                    throw new RuntimeException('Installation migration record is unsafe.');
                }
                $record = json_decode((string) file_get_contents($recordPath), true, 512, JSON_THROW_ON_ERROR);
                if (!is_array($record)
                    || ($record['protocol'] ?? null) !== 'peanut.installation-state-migration.v1'
                    || ($record['source'] ?? null) !== $legacy
                    || ($record['target'] ?? null) !== $target
                    || ($record['files'] ?? null) !== $files
                    || !in_array($record['phase'] ?? null, ['pending', 'complete'], true)) {
                    throw new RuntimeException('Migration record differs from the legacy state.');
                }
            } else {
                if ($published !== [] || $source !== $legacy) {
                    throw new RuntimeException('Unrecorded target identity or archived source cannot be adopted.');
                }
                $record = [
                    'schema_version' => 1,
                    'protocol' => 'peanut.installation-state-migration.v1',
                    'source' => $legacy,
                    'target' => $target,
                    'files' => $files,
                    'phase' => 'pending',
                    'recorded_at' => gmdate(DATE_ATOM),
                ];
                $writeRecord($record);
            }
            if ($record['phase'] === 'complete') {
                if ($source !== $archived || $published !== $files) {
                    throw new RuntimeException('Completed migration record has an incomplete identity or archive.');
                }
                echo json_encode(['status' => 'already_migrated', 'files' => $files], JSON_THROW_ON_ERROR), PHP_EOL;
                exit(0);
            }
            foreach ($files as $name => $identity) {
                if (isset($published[$name])) {
                    continue;
                }
                $temporary = $target . '/.migration-copy-' . bin2hex(random_bytes(8));
                if (!copy($source . '/' . $name, $temporary)
                    || !chmod($temporary, 0600)
                    || hash_file('sha256', $temporary) !== $identity['sha256']
                    || filesize($temporary) !== $identity['bytes']
                    || !rename($temporary, $target . '/' . $name)) {
                    @unlink($temporary);
                    throw new RuntimeException('Cannot publish verified installation identity.');
                }
            }
            if ($inspect($target) !== $files) {
                throw new RuntimeException('Published installation identity did not verify.');
            }
            if ($source === $legacy && !rename($legacy, $archived)) {
                throw new RuntimeException('Cannot archive legacy installation state.');
            }
            $record['phase'] = 'complete';
            $record['completed_at'] = gmdate(DATE_ATOM);
            $writeRecord($record);
            echo json_encode(['status' => 'migrated', 'files' => $files], JSON_THROW_ON_ERROR), PHP_EOL;
        } finally {
            flock($newLock, LOCK_UN);
            fclose($newLock);
        }
    } finally {
        flock($oldLock, LOCK_UN);
        fclose($oldLock);
    }
} catch (Throwable $exception) {
    fwrite(STDERR, 'Installation state migration stopped: ' . $exception->getMessage() . PHP_EOL);
    exit(1);
}
