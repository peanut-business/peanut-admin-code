# Docker/service orchestration listener overrides. Native client dev ports belong
# to web/platform/pc/uniapp's own .env (see each .env.example).
# Copy only selected values into your private Docker env file and pass it with
# docker compose --env-file <file>. Native development does not read this file.
# These are registered defaults, not mandatory ports; each clone/worktree may
# choose free alternatives without changing tracked source.
PHP_PORT=20180
VITE_DEPLOYMENT_MODE=multi-tenant
VITE_PORT=20181
PLATFORM_PORT=20177
MOBILE_PORT=20182
REDIS_PORT=20184
PC_PORT=20185
DOCS_PORT=20186
DEV_HTTP_PORT=20187
# Optional Docker bind-mount watcher override; Compose defaults to polling.
# CHOKIDAR_USEPOLLING=true
