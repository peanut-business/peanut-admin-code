# Optional source frontend containers. Copy to a private file of your choice.
# From the APP root:
# docker compose --env-file /path/to/local-stack.env -f deploy/docker-compose.dev.yml config --quiet
# Native development reads the individual client environments instead.
# Required registered host PHP port; Docker must be able to reach this listener.
PHP_PORT=20180
# Required Web Edition; use the actual backend's standalone or multi-tenant.
VITE_DEPLOYMENT_MODE=multi-tenant
# Required loopback host ports for the selected Compose services; choose free registered ports.
# Admin Web, Platform, UniApp H5, optional legacy Redis, PC, Docs, and Nginx gateway, respectively.
VITE_PORT=20181
PLATFORM_PORT=20177
MOBILE_PORT=20182
REDIS_PORT=20184
PC_PORT=20185
DOCS_PORT=20186
DEV_HTTP_PORT=20187
# Optional bind-mount watcher override. Compose defaults to polling.
# CHOKIDAR_USEPOLLING=true
