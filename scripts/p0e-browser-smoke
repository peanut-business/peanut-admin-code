#!/usr/bin/env bash
set -euo pipefail

die() { printf 'p0e-browser-smoke: %s\n' "$*" >&2; exit 1; }

MODE=""
PROFILE="baseline"
TENANT_ADMIN_URL=""
TENANT_BETA_URL=""
PLATFORM_URL=""
DOCS_URL=""
OUTPUT_DIR=""
SESSION=""
ENV_FILE=""
IDENTITY_FILE=""
QUALIFICATION_PLAN=""
PLAYWRIGHT_CLI=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --mode) MODE="${2:-}"; shift 2 ;;
    --profile) PROFILE="${2:-}"; shift 2 ;;
    --tenant-admin-url) TENANT_ADMIN_URL="${2:-}"; shift 2 ;;
    --tenant-beta-url) TENANT_BETA_URL="${2:-}"; shift 2 ;;
    --platform-url) PLATFORM_URL="${2:-}"; shift 2 ;;
    --docs-url) DOCS_URL="${2:-}"; shift 2 ;;
    --output-dir) OUTPUT_DIR="${2:-}"; shift 2 ;;
    --session) SESSION="${2:-}"; shift 2 ;;
    --env-file) ENV_FILE="${2:-}"; shift 2 ;;
    --identity-file) IDENTITY_FILE="${2:-}"; shift 2 ;;
    --qualification-plan) QUALIFICATION_PLAN="${2:-}"; shift 2 ;;
    --playwright-cli) PLAYWRIGHT_CLI="${2:-}"; shift 2 ;;
    *) die "unknown option: $1" ;;
  esac
done

[[ "$MODE" == standalone || "$MODE" == multi-tenant ]] || die '--mode must be standalone or multi-tenant'
[[ "$PROFILE" == baseline || "$PROFILE" == release ]] || die '--profile must be baseline or release'
local_url() {
  node - "$1" <<'NODE'
const value = process.argv[2];
let parsed;
try { parsed = new URL(value); } catch { process.exit(1); }
const local = parsed.hostname === '127.0.0.1'
  || parsed.hostname === '::1'
  || parsed.hostname === 'localhost'
  || parsed.hostname.endsWith('.localhost');
if (!local || !['http:', 'https:'].includes(parsed.protocol) || !parsed.port
  || parsed.username || parsed.password || parsed.pathname !== '/' || parsed.search || parsed.hash) process.exit(1);
NODE
}
local_url "${TENANT_ADMIN_URL%/}/" || die '--tenant-admin-url must be an explicit registered loopback/.localhost origin with a port'
local_url "${PLATFORM_URL%/}/" || die '--platform-url must be an explicit registered loopback/.localhost origin with a port'
if [[ "$PROFILE" == baseline ]]; then
  local_url "${DOCS_URL%/}/" || die '--docs-url must be an explicit registered loopback/.localhost origin with a port'
elif [[ -n "$DOCS_URL" ]]; then
  local_url "${DOCS_URL%/}/" || die '--docs-url must be an explicit registered loopback/.localhost origin with a port when supplied'
fi
[[ "$OUTPUT_DIR" == /* && -d "$OUTPUT_DIR" ]] || die '--output-dir must be an existing absolute directory'
[[ "$SESSION" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || die '--session is invalid'
[[ -x "$PLAYWRIGHT_CLI" ]] || die '--playwright-cli must name an executable Playwright CLI wrapper'
[[ "$ENV_FILE" == /* && -f "$ENV_FILE" && ! -L "$ENV_FILE" ]] || die '--env-file must name an absolute regular file'
[[ "$(stat -f '%Lp' "$ENV_FILE" 2>/dev/null || stat -c '%a' "$ENV_FILE")" == 600 ]] || die '--env-file must have mode 0600'
required_values=(P0E_ADMIN_INITIAL_EMAIL P0E_ADMIN_INITIAL_PASSWORD P0E_PLATFORM_INITIAL_EMAIL P0E_PLATFORM_INITIAL_PASSWORD)
if [[ "$PROFILE" == baseline ]]; then
  required_values+=(P0E_TENANT_RESTRICTED_EMAIL P0E_TENANT_RESTRICTED_PASSWORD)
  if [[ "$MODE" == multi-tenant ]]; then
    required_values+=(P0E_TENANT_BETA_EMAIL P0E_TENANT_BETA_PASSWORD)
    local_url "${TENANT_BETA_URL%/}/" || die '--tenant-beta-url must name the registered Beta origin'
  fi
  [[ "$QUALIFICATION_PLAN" == /* && -f "$QUALIFICATION_PLAN" && ! -L "$QUALIFICATION_PLAN" ]] || die 'baseline business writes require the native qualification plan'
  python3 - "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)" "$QUALIFICATION_PLAN" "$MODE" "$TENANT_ADMIN_URL" "$TENANT_BETA_URL" "$PLATFORM_URL" "$DOCS_URL" "$SESSION" "$ENV_FILE" "$OUTPUT_DIR" <<'PY' || die 'baseline qualification plan or active resource lease is invalid'
import argparse, json, os, runpy, sys
from pathlib import Path
tool_root, path, mode, alpha, beta, platform, docs, session, environment, output = sys.argv[1:]
root = Path(tool_root)
value = json.loads(Path(path).read_text())
os.environ['PEANUT_RESOURCE_REGISTRY'] = value['registry_path']
native = runpy.run_path(str(root / 'scripts/p0e-runtime-qualification'))
args = argparse.Namespace(candidate=value['candidate'], run_id=value['run_id'], lease=value['lease'],
    owner=value['owner'], thread=value['thread'], parent_lease=value['parent_lease'],
    output_dir=value['paths']['output-dir'], cache_dir=value['paths']['cache-dir'],
    http_port=value['ports']['http'], docs_port=value['ports']['docs'], minimum_release=False,
    through_group=None, groups=','.join(value['groups']))
if not args.owner or not args.thread or value['worktree'] != str(root):
    raise ValueError('qualification owner/thread/worktree mismatch')
actual = native['plan'](args, require_clean=True)
for key in ['gate','candidate','candidate_tree','registry_sha256','database_resource_scope','databases',
            'browser_hosts','paths','ports','lease_resources','worktree','resource_id']:
    if value[key] != actual[key]: raise ValueError('qualification plan mismatch: ' + key)
native['verify_lease'](args, actual)
http = value['ports']['http']
expected = [f"http://{value['browser_hosts'][key]}:{http}" for key in ['tenant_admin','tenant_beta','platform']]
if [alpha.rstrip('/'), beta.rstrip('/'), platform.rstrip('/')] != expected:
    raise ValueError('browser origin mismatch')
if docs.rstrip('/') != f"http://127.0.0.1:{value['ports']['docs']}" or session != 'p0e-' + args.run_id:
    raise ValueError('docs/session mismatch')
if str(Path(path).resolve()) != str(root / 'output' / session / 'plan.json'):
    raise ValueError('plan location mismatch')
if str(Path(environment).resolve()) != str(Path(value['paths']['cache-dir']) / 'runtime-credentials.env'):
    raise ValueError('credentials location mismatch')
if Path(output).resolve() != Path(value['paths']['output-dir']) / 'browser' / mode:
    raise ValueError('browser output mismatch')
if mode + '-browser' not in value['groups']:
    raise ValueError('browser group not selected')
PY
fi
if [[ "$PROFILE" == release ]]; then
  if [[ "$MODE" == multi-tenant ]]; then
    local_url "${TENANT_BETA_URL%/}/" || die '--tenant-beta-url must be an explicit registered loopback/.localhost origin with a port'
  fi
  [[ "$IDENTITY_FILE" == /* && -f "$IDENTITY_FILE" && ! -L "$IDENTITY_FILE" ]] || die '--identity-file must name an absolute regular file for the release profile'
  [[ "$(stat -f '%Lp' "$IDENTITY_FILE" 2>/dev/null || stat -c '%a' "$IDENTITY_FILE")" == 600 ]] || die '--identity-file must have mode 0600'
  required_values=(
    P0E_TENANT_ALPHA_EMAIL P0E_TENANT_ALPHA_PASSWORD
    P0E_TENANT_RESTRICTED_EMAIL P0E_TENANT_RESTRICTED_PASSWORD
  )
  if [[ "$MODE" == multi-tenant ]]; then
    required_values+=(
      P0E_TENANT_BETA_EMAIL P0E_TENANT_BETA_PASSWORD
      P0E_PLATFORM_INITIAL_EMAIL P0E_PLATFORM_INITIAL_PASSWORD
    )
  fi
fi
for name in "${required_values[@]}"; do
  grep -q "^${name}=." "$ENV_FILE" || die "missing file value: $name"
done
if [[ "$PROFILE" == release ]]; then
  node - "$IDENTITY_FILE" "$MODE" "$TENANT_ADMIN_URL" "$TENANT_BETA_URL" "$PLATFORM_URL" <<'NODE' || die 'release identity file is invalid or does not match the registered origins'
const fs = require('node:fs');
const [path, mode, alphaUrl, betaUrl, platformUrl] = process.argv.slice(2);
const value = JSON.parse(fs.readFileSync(path, 'utf8'));
const own = (subject, key) => Object.prototype.hasOwnProperty.call(subject, key);
const array = (subject, key) => Array.isArray(subject?.[key]) && subject[key].length > 0;
const same = (left, right) => left.replace(/\/$/u, '') === right.replace(/\/$/u, '');
const localOrigin = (input) => {
  let url;
  try { url = new URL(input); } catch { return false; }
  return ['http:', 'https:'].includes(url.protocol) && url.port !== ''
    && !url.username && !url.password && url.pathname === '/' && !url.search && !url.hash
    && (url.hostname === '127.0.0.1' || url.hostname === '::1' || url.hostname === 'localhost' || url.hostname.endsWith('.localhost'));
};
const secretKey = (input) => Object.entries(input || {}).some(([key, child]) =>
  /password|secret|token|credential/i.test(key)
  || (child && typeof child === 'object' && secretKey(child)));
if (value.schema_version !== 1 || secretKey(value)) throw new Error('identity must contain no credentials');
if (!same(value.tenants?.alpha?.admin_url || '', alphaUrl)
  || !same(value.platform_url || '', platformUrl)) throw new Error('origin mismatch');
if (mode === 'multi-tenant' && !same(value.tenants?.beta?.admin_url || '', betaUrl)) throw new Error('Beta origin mismatch');
const tenantNames = mode === 'multi-tenant' ? ['alpha', 'beta', 'restricted'] : ['alpha', 'restricted'];
for (const name of tenantNames) {
  const tenant = value.tenants?.[name];
  if (!tenant || !localOrigin(`${String(tenant.admin_url || '').replace(/\/$/u, '')}/`)
    || !array(tenant.menu, 'required') || !array(tenant.menu, 'forbidden')
    || !tenant.menu.required.every((item) => typeof item === 'string' && item !== '')
    || !tenant.menu.forbidden.every((item) => typeof item === 'string' && item !== '')) throw new Error(`invalid ${name} menu contract`);
}
if (!same(value.tenants.restricted.admin_url, alphaUrl)
  && !(mode === 'multi-tenant' && same(value.tenants.restricted.admin_url, betaUrl))) {
  throw new Error('restricted account must use the registered Alpha or Beta origin');
}
const packageIdentity = value.package_identity;
if (!packageIdentity || !/^[a-f0-9]{40}$/u.test(packageIdentity.commit || '')
  || !/^[a-f0-9]{40}$/u.test(packageIdentity.tree || '')
  || !(packageIdentity.release_key === null || /^v[0-9]+\.[0-9]+\.[0-9]+$/u.test(packageIdentity.release_key || ''))) {
  throw new Error('invalid package identity');
}
if (mode === 'standalone'
  && (!/^(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\+[0-9A-Za-z.-]+)?$/u.test(packageIdentity.application_version || '')
    || !/^[a-f0-9]{64}$/u.test(value.host_runtime_receipt_sha256 || '')
    || !Array.isArray(value.standalone_platform_unavailable_statuses)
    || value.standalone_platform_unavailable_statuses.length === 0
    || !value.standalone_platform_unavailable_statuses.every((status) => Number.isInteger(status) && status >= 400 && status <= 599))) {
  throw new Error('standalone identity must bind an application version, host receipt digest, and unavailable Platform statuses');
}
for (const key of ['rbac_denials', 'scope_allowed', 'scope_denials']) {
  if (!array(value.probes, key)) throw new Error(`missing ${key}`);
  for (const probe of value.probes[key]) {
    if (!probe || typeof probe.name !== 'string' || probe.name === '' || probe.actor !== 'restricted'
      || !(mode === 'multi-tenant' ? ['alpha', 'beta'] : ['alpha']).includes(probe.base)
      || !/^(GET|POST|PUT|PATCH|DELETE)$/u.test(probe.method || '')
      || typeof probe.path !== 'string' || !probe.path.startsWith('/adminapi/')) throw new Error(`invalid ${key} probe`);
    const statuses = probe.expect?.statuses;
    const codes = probe.expect?.codes;
    if ((!Array.isArray(statuses) || statuses.length === 0) && (!Array.isArray(codes) || codes.length === 0)) {
      throw new Error(`${key} probe has no expected status/code`);
    }
    if (key === 'scope_allowed' && (!Array.isArray(probe.expect?.contains) || probe.expect.contains.length === 0
      || !Array.isArray(probe.expect?.absent) || probe.expect.absent.length === 0)) {
      throw new Error('scope_allowed must prove both visible and excluded data');
    }
  }
}
if (!value.ssr || !/^\/[A-Za-z0-9._~!$&'()*+,;=:@%\/-]*$/u.test(value.ssr.path || '')
  || !array(value.ssr.alpha, 'required') || !array(value.ssr.alpha, 'forbidden')
  || (mode === 'multi-tenant' && (!array(value.ssr.beta, 'required') || !array(value.ssr.beta, 'forbidden')))) {
  throw new Error('invalid SSR contract');
}
if (!own(value, 'package_identity')) throw new Error('missing package identity');
NODE
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
FIXTURE="$ROOT/server/tests/fixtures/p0e-runtime-qualification/browser-smoke.js"
[[ -f "$FIXTURE" ]] || die "missing fixture: $FIXTURE"
LOG="$OUTPUT_DIR/$MODE-playwright.log"
OPENED=0
RUNTIME_FIXTURE=""
RUN_CODE_LOG=""
cli() {
  env -i PATH="$PATH" HOME="$HOME" PLAYWRIGHT_CLI_SESSION="$SESSION" "$PLAYWRIGHT_CLI" "$@"
}
cleanup() {
  if [[ "$OPENED" == 1 ]]; then
    cli close >>"$LOG" 2>&1 || true
  fi
  if [[ -n "$RUNTIME_FIXTURE" && -e "$RUNTIME_FIXTURE" ]]; then
    rm -f "$RUNTIME_FIXTURE"
  fi
  if [[ -n "$RUN_CODE_LOG" && -e "$RUN_CODE_LOG" ]]; then
    rm -f "$RUN_CODE_LOG"
  fi
}
trap cleanup EXIT INT TERM

cd "$OUTPUT_DIR"
cli open "$TENANT_ADMIN_URL/admin/login" >"$LOG" 2>&1
OPENED=1
cli resize 1440 1000 >>"$LOG" 2>&1
cli snapshot >"$OUTPUT_DIR/$MODE-initial-snapshot.txt" 2>>"$LOG"
browser_environment="$(node - "$ENV_FILE" "$MODE" "$PROFILE" "$TENANT_ADMIN_URL" "$TENANT_BETA_URL" "$PLATFORM_URL" "$DOCS_URL" "$OUTPUT_DIR" "$IDENTITY_FILE" "$SESSION" <<'NODE'
const fs = require('node:fs');
const [path, mode, profile, tenantAdminUrl, tenantBetaUrl, platformUrl, docsUrl, outputDir, identityPath, session] = process.argv.slice(2);
const values = Object.fromEntries(fs.readFileSync(path, 'utf8').trim().split(/\r?\n/u).map((line) => line.split(/=(.*)/s, 2)));
process.stdout.write(JSON.stringify({
  P0E_BROWSER_MODE: mode,
  P0E_BROWSER_PROFILE: profile,
  P0E_BROWSER_TENANT_ADMIN_URL: tenantAdminUrl,
  P0E_BROWSER_TENANT_BETA_URL: tenantBetaUrl,
  P0E_BROWSER_PLATFORM_URL: platformUrl,
  P0E_BROWSER_DOCS_URL: docsUrl,
  P0E_BROWSER_OUTPUT_DIR: outputDir,
  P0E_BROWSER_RUN_ID: session.startsWith('p0e-') ? session.slice(4) : '',
  P0E_BROWSER_IDENTITY_JSON: identityPath ? fs.readFileSync(identityPath, 'utf8') : '',
  P0E_ADMIN_INITIAL_EMAIL: values.P0E_ADMIN_INITIAL_EMAIL || '',
  P0E_ADMIN_INITIAL_PASSWORD: values.P0E_ADMIN_INITIAL_PASSWORD || '',
  P0E_TENANT_ALPHA_EMAIL: values.P0E_TENANT_ALPHA_EMAIL || '',
  P0E_TENANT_ALPHA_PASSWORD: values.P0E_TENANT_ALPHA_PASSWORD || '',
  P0E_TENANT_BETA_EMAIL: values.P0E_TENANT_BETA_EMAIL || '',
  P0E_TENANT_BETA_PASSWORD: values.P0E_TENANT_BETA_PASSWORD || '',
  P0E_TENANT_RESTRICTED_EMAIL: values.P0E_TENANT_RESTRICTED_EMAIL || '',
  P0E_TENANT_RESTRICTED_PASSWORD: values.P0E_TENANT_RESTRICTED_PASSWORD || '',
  P0E_PLATFORM_INITIAL_EMAIL: values.P0E_PLATFORM_INITIAL_EMAIL || '',
  P0E_PLATFORM_INITIAL_PASSWORD: values.P0E_PLATFORM_INITIAL_PASSWORD || '',
}));
NODE
)"
RUNTIME_FIXTURE="$(mktemp "${TMPDIR:-/tmp}/p0e-browser-fixture.XXXXXX")"
chmod 600 "$RUNTIME_FIXTURE"
{
  printf '%s\n' 'async (page) => {'
  printf 'const process = { env: %s };\n' "$browser_environment"
  cat "$FIXTURE"
  printf '%s\n' '}'
} >"$RUNTIME_FIXTURE"
RUN_CODE_LOG="$(mktemp "${TMPDIR:-/tmp}/p0e-browser-log.XXXXXX")"
chmod 600 "$RUN_CODE_LOG"
if cli run-code --filename "$RUNTIME_FIXTURE" >"$RUN_CODE_LOG" 2>&1; then
  RUN_CODE_STATUS=0
else
  RUN_CODE_STATUS=$?
fi
# The CLI may print evaluated source containing the injected private credentials.
# Persist only the sanitized transcript, including on an actual browser failure.
python3 - "$ENV_FILE" "$RUN_CODE_LOG" "$LOG" <<'PY'
from pathlib import Path
import sys
environment, source, target = map(Path, sys.argv[1:])
text = source.read_text()
for line in environment.read_text().splitlines():
    name, separator, value = line.partition('=')
    if separator and value and name.endswith('_PASSWORD'):
        text = text.replace(value, '[redacted]')
with target.open('a') as stream:
    stream.write(text)
PY
[[ "$RUN_CODE_STATUS" == 0 ]] || die "browser fixture failed (exit $RUN_CODE_STATUS); sanitized transcript: $LOG"
grep -q '"status":"passed"' "$LOG" || die 'browser fixture did not emit its successful completion record'
if [[ "$PROFILE" == baseline ]]; then
  python3 - "$LOG" "$MODE" "$QUALIFICATION_PLAN" "$OUTPUT_DIR" <<'PY' || die 'baseline business completion receipt is missing or incomplete'
import hashlib, json, re, sys
from pathlib import Path
log, mode, plan_path, output = sys.argv[1:]
decoder = json.JSONDecoder()
records = []
text = Path(log).read_text()
for match in re.finditer(r'\{"schema_version":', text):
    try:
        value, _ = decoder.raw_decode(text[match.start():])
    except ValueError:
        continue
    if value.get('mode') == mode and value.get('profile') == 'baseline' and value.get('status') == 'passed':
        records.append(value)
if len(records) != 1: raise ValueError('expected one actual browser completion')
value = records[0]
result = value['results']
if (len(result.get('navigation', [])) != 3 or not result.get('permissions', {}).get('stable_menu_key_assignment')
    or len(result['permissions'].get('denied', [])) != 5 or not result.get('website', {}).get('original_restored')
    or not result.get('lifecycle', {}).get('cleaned') or not result.get('file', {}).get('download_exact')
    or not all(key in result for key in ['pc', 'h5', 'docs'])
    or (mode == 'multi-tenant' and not result.get('tenant_boundary', {}).get('cross_host_rejected'))):
    raise ValueError('incomplete actual business scope')
plan_bytes = Path(plan_path).read_bytes()
plan = json.loads(plan_bytes)
value.update(candidate=plan['candidate'], candidate_tree=plan['candidate_tree'],
             qualification_plan_sha256=hashlib.sha256(plan_bytes).hexdigest())
Path(output, 'business-summary.json').write_text(json.dumps(value, indent=2) + '\n')
PY
fi
cli snapshot >"$OUTPUT_DIR/$MODE-final-snapshot.txt" 2>>"$LOG"
cli close >>"$LOG" 2>&1
OPENED=0
printf 'browser_mode=%s\nbrowser_profile=%s\nstatus=passed\nlog=%s\n' "$MODE" "$PROFILE" "$LOG"
