#!/usr/bin/env php
<?php
declare(strict_types=1);

use app\common\infrastructure\scaffold\EditionUpgradePackage;
use app\common\infrastructure\scaffold\ScaffoldPathGuard;
use app\common\infrastructure\scaffold\ScaffoldUpgradeRunner;
use app\common\services\upgrade\ApplicationMigrationRunner;

$toolRoot = dirname(__DIR__);
foreach ([
    ['/scripts/scaffold-runtime/ScaffoldPathGuard.php'],
    ['/scripts/scaffold-runtime/ScaffoldManifest.php'],
    ['/scripts/scaffold-runtime/ScaffoldUpgradeLedger.php'],
    ['/server/app/platform/exception/plugin/PluginLifecycleException.php', '/scripts/upgrade-runtime/PluginLifecycleException.php'],
    ['/server/app/platform/value/plugin/PluginDescriptor.php', '/scripts/upgrade-runtime/PluginDescriptor.php'],
    ['/server/app/platform/infrastructure/plugin/PluginLockResolver.php', '/scripts/upgrade-runtime/PluginLockResolver.php'],
    ['/scripts/scaffold-runtime/ScaffoldUpgradeRunner.php'],
    ['/scripts/scaffold-runtime/EditionUpgradePackage.php'],
    ['/server/app/common/services/upgrade/ApplicationMigrationRunner.php', '/scripts/upgrade-runtime/ApplicationMigrationRunner.php'],
] as $candidates) {
    foreach ($candidates as $candidate) {
        if (is_file($toolRoot . $candidate)) {
            require_once $toolRoot . $candidate;
            continue 2;
        }
    }
    throw new RuntimeException('PRODUCT_UPGRADE_RUNTIME_MISSING');
}

function productUpgradeUsage(): never
{
    fwrite(STDERR, "Usage:\n"
        . "  php scripts/upgrade plan --instance-root=<absolute-path> --package=<absolute-extracted-package> --signature-key-id=<id> --env-file=<0600-file>\n"
        . "  php scripts/upgrade apply|verify|recover --instance-root=<absolute-path> --package=<absolute-extracted-package> --signature-key-id=<id> --env-file=<0600-file> --plan=<absolute-product-plan>\n");
    exit(64);
}

/** @return array<string,string> */
function productUpgradeTrustedKeys(string $path): array
{
    if (getenv('PEANUT_UPGRADE_TRUSTED_KEYS_JSON') !== false
        || !str_starts_with($path, '/') || !is_file($path) || is_link($path)) {
        throw new RuntimeException('PRODUCT_UPGRADE_ENV_FILE_INVALID');
    }
    $stat = lstat($path);
    if (!is_array($stat) || ($stat['nlink'] ?? 0) !== 1 || (($stat['mode'] ?? 0) & 0777) !== 0600) {
        throw new RuntimeException('PRODUCT_UPGRADE_ENV_FILE_PERMISSIONS_INVALID');
    }
    $values = parse_ini_file($path, false, INI_SCANNER_RAW);
    if (!is_array($values) || array_keys($values) !== ['PEANUT_UPGRADE_TRUSTED_KEYS_JSON']) {
        throw new RuntimeException('PRODUCT_UPGRADE_ENV_FILE_SCHEMA_INVALID');
    }
    try {
        $keys = json_decode((string)$values['PEANUT_UPGRADE_TRUSTED_KEYS_JSON'], true, 32, JSON_THROW_ON_ERROR);
    } catch (JsonException $exception) {
        throw new RuntimeException('PRODUCT_UPGRADE_ENV_FILE_SCHEMA_INVALID', 0, $exception);
    }
    if (!is_array($keys) || array_is_list($keys) || $keys === []) {
        throw new RuntimeException('PRODUCT_UPGRADE_ENV_FILE_SCHEMA_INVALID');
    }
    foreach ($keys as $keyId => $encoded) {
        $decoded = is_string($encoded) ? base64_decode($encoded, true) : false;
        if (!is_string($keyId) || preg_match('/^[A-Za-z0-9._-]{1,96}$/D', $keyId) !== 1
            || !is_string($decoded) || strlen($decoded) !== SODIUM_CRYPTO_SIGN_PUBLICKEYBYTES) {
            throw new RuntimeException('PRODUCT_UPGRADE_ENV_FILE_SCHEMA_INVALID');
        }
    }
    return $keys;
}

/** @param array<string,mixed> $value */
function productUpgradeCanonicalJson(array $value): string
{
    $normalize = static function (mixed $item) use (&$normalize): mixed {
        if (!is_array($item)) return $item;
        if (!array_is_list($item)) ksort($item, SORT_STRING);
        foreach ($item as $key => $child) $item[$key] = $normalize($child);
        return $item;
    };
    return json_encode($normalize($value), JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
}

/** @param array<string,mixed> $value */
function productUpgradeWriteJson(string $path, array $value): void
{
    $directory = dirname($path);
    if ((!is_dir($directory) && !mkdir($directory, 0770, true)) || is_link($directory)) {
        throw new RuntimeException('PRODUCT_UPGRADE_PLAN_DIRECTORY_INVALID');
    }
    $temporary = $path . '.tmp-' . bin2hex(random_bytes(6));
    $json = json_encode($value, JSON_THROW_ON_ERROR | JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n";
    if (file_put_contents($temporary, $json, LOCK_EX) === false
        || !chmod($temporary, 0600) || !rename($temporary, $path)) {
        @unlink($temporary);
        throw new RuntimeException('PRODUCT_UPGRADE_PLAN_WRITE_FAILED');
    }
}

/** @return array<string,mixed> */
function productUpgradeReadPlan(string $instanceRoot, string $path): array
{
    $root = ScaffoldPathGuard::projectRoot($instanceRoot);
    $resolved = realpath($path);
    $plansRoot = $root . '/.peanut/upgrades/product-plans/';
    if (!is_string($resolved) || !str_starts_with($resolved, $plansRoot)
        || !is_file($resolved) || is_link($resolved)) {
        throw new RuntimeException('PRODUCT_UPGRADE_PLAN_INVALID');
    }
    try {
        $plan = json_decode((string)file_get_contents($resolved), true, 256, JSON_THROW_ON_ERROR);
    } catch (JsonException $exception) {
        throw new RuntimeException('PRODUCT_UPGRADE_PLAN_INVALID', 0, $exception);
    }
    if (!is_array($plan)
        || ($plan['schema_version'] ?? null) !== 1
        || ($plan['protocol'] ?? null) !== 'peanut.product-upgrade-plan.v1'
        || ($plan['instance_root'] ?? null) !== $root
        || !is_string($plan['plan_sha256'] ?? null)) {
        throw new RuntimeException('PRODUCT_UPGRADE_PLAN_INVALID');
    }
    $digest = $plan['plan_sha256'];
    unset($plan['plan_sha256']);
    if (!hash_equals($digest, 'sha256:' . hash('sha256', productUpgradeCanonicalJson($plan)))) {
        throw new RuntimeException('PRODUCT_UPGRADE_PLAN_INVALID');
    }
    return $plan + ['plan_sha256' => $digest, 'absolute_path' => $resolved];
}

/** @param array<string,mixed> $package @return list<string> */
function productUpgradeMigrationFiles(string $packageRoot, array $package): array
{
    $files = [];
    foreach (($package['migration_chain']['files'] ?? null) as $entry) {
        $relative = is_array($entry) ? ($entry['path'] ?? null) : null;
        $digest = is_array($entry) ? ($entry['sha256'] ?? null) : null;
        if (!is_string($relative) || !is_string($digest)
            || preg_match('#^server/database/migrations/[0-9]{8}-[a-z0-9][a-z0-9_-]*\.sql$#D', $relative) !== 1) {
            throw new RuntimeException('PRODUCT_UPGRADE_MIGRATION_CHAIN_INVALID');
        }
        $path = $packageRoot . '/target/files/' . $relative;
        if (!is_file($path) || is_link($path)
            || !hash_equals($digest, (string)hash_file('sha256', $path))) {
            throw new RuntimeException('PRODUCT_UPGRADE_MIGRATION_CHAIN_INVALID');
        }
        $files[] = $path;
    }
    return $files;
}

function productUpgradeDatabaseRunner(string $instanceRoot): ApplicationMigrationRunner
{
    $guard = $instanceRoot . '/server/database/environment-guard.php';
    if (!is_file($guard) || is_link($guard)) {
        throw new RuntimeException('PRODUCT_UPGRADE_DATABASE_GUARD_MISSING');
    }
    require_once $guard;
    $config = guardedDatabaseConfig();
    return new ApplicationMigrationRunner([
        'host' => (string)$config['host'],
        'port' => (string)$config['port'],
        'database' => (string)$config['database'],
        'user' => (string)$config['user'],
        'password' => (string)$config['password'],
    ]);
}

/** @return array<string,mixed> */
function productUpgradePackageIdentity(array $prepared, string $root): array
{
    return [
        'root' => $root,
        'inventory_sha256' => $prepared['package']['inventory_sha256'],
        'manifest_sha256' => $prepared['package']['manifest_sha256'],
        'target_version' => $prepared['package']['target']['version'],
        'source_commit' => $prepared['package']['build_source']['commit'],
        'source_tree' => $prepared['package']['build_source']['tree'],
    ];
}

$command = $argv[1] ?? null;
if (!in_array($command, ['plan', 'apply', 'verify', 'recover'], true)) productUpgradeUsage();
$options = [];
foreach (array_slice($argv, 2) as $argument) {
    if (preg_match('/^--(instance-root|package|signature-key-id|env-file|plan)=(.+)$/D', $argument, $matches) !== 1
        || isset($options[$matches[1]])) productUpgradeUsage();
    $options[$matches[1]] = $matches[2];
}
$required = ['instance-root', 'package', 'signature-key-id', 'env-file'];
if ($command !== 'plan') $required[] = 'plan';
$actual = array_keys($options); sort($actual, SORT_STRING);
$expected = $required; sort($expected, SORT_STRING);
if ($actual !== $expected) productUpgradeUsage();

try {
    $instanceRoot = ScaffoldPathGuard::projectRoot($options['instance-root']);
    $packageRoot = realpath($options['package']);
    if (!is_string($packageRoot)) throw new RuntimeException('PRODUCT_UPGRADE_PACKAGE_NOT_FOUND');
    $trustedKeys = productUpgradeTrustedKeys($options['env-file']);
    $runner = new ScaffoldUpgradeRunner();

    if ($command === 'plan') {
        $prepared = (new EditionUpgradePackage())->prepare(
            $instanceRoot,
            $packageRoot,
            $options['signature-key-id'],
            $trustedKeys,
        );
        $scaffold = $runner->preflight($instanceRoot, $prepared['from_manifest'], $prepared['to_manifest']);
        $migration = productUpgradeDatabaseRunner($instanceRoot)->run(
            productUpgradeMigrationFiles($packageRoot, $prepared['package']),
            (string)$prepared['package']['target']['version'],
            (string)$prepared['package']['target']['version'],
            true,
        );
        $plan = [
            'schema_version' => 1,
            'protocol' => 'peanut.product-upgrade-plan.v1',
            'candidate' => $scaffold['candidate'],
            'status' => $scaffold['status'],
            'instance_root' => $instanceRoot,
            'package' => productUpgradePackageIdentity($prepared, $packageRoot),
            'signature_key_id' => $options['signature-key-id'],
            'scaffold_plan' => $instanceRoot . '/' . $scaffold['plan_path'],
            'migration' => [
                'target_version' => $migration['target_version'],
                'pending' => $migration['pending'],
                'recovery' => 'database-backup-required-after-first-migration-starts',
            ],
            'external_prerequisites' => [
                'prepared_target_dependencies_and_frontends',
                'verified_database_and_files_backup',
                'active_write_gate_and_drained_workers',
            ],
            'completion_evidence' => [
                'scaffold_verify', 'migration_ledger', 'service_reload', 'runtime_health', 'business_verification',
            ],
            'created_at' => gmdate(DATE_ATOM),
        ];
        $plan['plan_sha256'] = 'sha256:' . hash('sha256', productUpgradeCanonicalJson($plan));
        $path = $instanceRoot . '/.peanut/upgrades/product-plans/' . $plan['candidate'] . '.json';
        productUpgradeWriteJson($path, $plan);
        $result = $plan + ['plan_path' => $path];
    } else {
        $plan = productUpgradeReadPlan($instanceRoot, $options['plan']);
        if (($plan['signature_key_id'] ?? null) !== $options['signature-key-id']
            || ($plan['package']['root'] ?? null) !== $packageRoot) {
            throw new RuntimeException('PRODUCT_UPGRADE_PLAN_REBIND_FAILED');
        }
        $migrationIds = $plan['migration']['pending'] ?? null;
        if (!is_array($migrationIds) || !array_is_list($migrationIds)) {
            throw new RuntimeException('PRODUCT_UPGRADE_PLAN_INVALID');
        }
        $database = productUpgradeDatabaseRunner($instanceRoot);
        if ($command === 'apply') {
            $prepared = (new EditionUpgradePackage())->prepare(
                $instanceRoot,
                $packageRoot,
                $options['signature-key-id'],
                $trustedKeys,
            );
            if (productUpgradePackageIdentity($prepared, $packageRoot) !== $plan['package']) {
                throw new RuntimeException('PRODUCT_UPGRADE_PACKAGE_REBIND_FAILED');
            }
            $files = productUpgradeMigrationFiles($packageRoot, $prepared['package']);
            $preflight = $database->run(
                $files,
                (string)$plan['migration']['target_version'],
                (string)$plan['migration']['target_version'],
                true,
            );
            if ($preflight['pending'] !== $migrationIds) {
                throw new RuntimeException('PRODUCT_UPGRADE_MIGRATION_PLAN_DRIFT');
            }
            $code = $runner->apply($instanceRoot, (string)$plan['scaffold_plan']);
            try {
                $migration = $database->run(
                    $files,
                    (string)$plan['migration']['target_version'],
                    (string)$plan['migration']['target_version'],
                );
            } catch (Throwable $exception) {
                throw new RuntimeException(
                    'PRODUCT_UPGRADE_DATABASE_RECOVERY_REQUIRED: code remains on target; inspect migration ledger and restore the verified database backup before any code recovery',
                    0,
                    $exception,
                );
            }
            $result = [
                'status' => 'applied', 'candidate' => $plan['candidate'],
                'code' => $code, 'migration' => $migration,
                'next' => 'reload target services, run scripts/upgrade verify, then perform runtime and business verification',
            ];
        } elseif ($command === 'verify') {
            $code = $runner->verify($instanceRoot, (string)$plan['scaffold_plan']);
            $statuses = $database->statuses($migrationIds);
            foreach ($migrationIds as $id) {
                if (($statuses[$id] ?? null) !== 'applied') {
                    throw new RuntimeException('PRODUCT_UPGRADE_MIGRATION_NOT_APPLIED: ' . $id);
                }
            }
            $result = [
                'status' => 'verified', 'candidate' => $plan['candidate'],
                'code' => $code, 'migration_statuses' => $statuses,
                'remaining_external_evidence' => ['service_reload', 'runtime_health', 'business_verification'],
            ];
        } else {
            $statuses = $database->statuses($migrationIds);
            if ($statuses !== []) {
                throw new RuntimeException(
                    'PRODUCT_UPGRADE_DATABASE_RESTORE_REQUIRED: managed-file recovery is unsafe after a target migration started',
                );
            }
            $code = $runner->recover($instanceRoot, (string)$plan['scaffold_plan']);
            $result = [
                'status' => 'recovered', 'candidate' => $plan['candidate'], 'code' => $code,
                'database' => 'unchanged',
            ];
        }
    }

    fwrite(STDOUT, json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n");
    exit(($result['status'] ?? null) === 'blocked' ? 2 : 0);
} catch (Throwable $exception) {
    fwrite(STDERR, json_encode([
        'status' => 'error', 'error' => $exception->getMessage(),
    ], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n");
    exit(1);
}
