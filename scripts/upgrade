#!/usr/bin/env php
<?php

declare(strict_types=1);

use app\common\infrastructure\scaffold\EditionUpgradePackage;
use app\common\infrastructure\scaffold\ScaffoldUpgradeRunner;
use app\common\validation\scaffold\ScaffoldPathGuard;

$nativeEntry = str_ends_with(__FILE__, '/server/docker/scripts/upgrade');
$toolRoot = $nativeEntry ? dirname(__DIR__, 3) : dirname(__DIR__);
$runtimeRoot = $nativeEntry ? dirname(__DIR__) : $toolRoot;
$serverScope = in_array('--scope=server', $argv, true);
$frozenSource = null;
$cancelAdmission = null;
$cancelRunner = null;
$appliedAdmission = null;
$successorArguments = array_values(array_filter(array_slice($argv, 2), static fn(string $argument): bool => str_starts_with($argument, '--partial-source-successor')));
if ($successorArguments !== [] && ($nativeEntry || $serverScope || count($successorArguments) !== 1
    || !in_array($argv[1] ?? null, ['plan', 'runtime-prepare'], true))) {
    throw new RuntimeException('SOURCE_SUCCESSOR_ARGUMENTS_INVALID');
}
$appliedArguments = array_values(array_filter(array_slice($argv, 2), static fn(string $argument): bool => str_starts_with($argument, '--resume-applied-source')));
$cancelArguments = array_values(array_filter(array_slice($argv, 2), static fn(string $argument): bool => str_starts_with($argument, '--cancel-unmodified-preparing')));
if ($cancelArguments !== []) {
    if ($successorArguments !== []) { throw new RuntimeException('SOURCE_SUCCESSOR_ARGUMENTS_INVALID'); }
    $cancelOptions = [];
    foreach (array_slice($argv, 2) as $argument) {
        if (preg_match('/^--(scope|instance-root|workspace|transition|cancel-unmodified-preparing)=(.+)$/D', $argument, $match) !== 1
            || isset($cancelOptions[$match[1]])) { throw new RuntimeException('SOURCE_RUNTIME_CANCEL_ARGUMENTS_INVALID'); }
        $cancelOptions[$match[1]] = $match[2];
    }
    if ($nativeEntry || $serverScope || ($argv[1] ?? null) !== 'runtime-recover' || count($cancelOptions) !== 5
        || ($cancelOptions['scope'] ?? null) !== 'source'
        || ($cancelOptions['transition'] ?? null) !== ($cancelOptions['workspace'] ?? '') . '/source-runtime.json') {
        throw new RuntimeException('SOURCE_RUNTIME_CANCEL_ARGUMENTS_INVALID');
    }
}
if ($appliedArguments !== []) {
    if ($successorArguments !== []) { throw new RuntimeException('SOURCE_SUCCESSOR_ARGUMENTS_INVALID'); }
    $appliedOptions = [];
    foreach (array_slice($argv, 2) as $argument) {
        if (preg_match('/^--(scope|instance-root|package|plan|workspace|transition|resume-applied-source)=(.+)$/D', $argument, $match) !== 1
            || isset($appliedOptions[$match[1]])) { throw new RuntimeException('SOURCE_TOOL_RESUME_ARGUMENTS_INVALID'); }
        $appliedOptions[$match[1]] = $match[2];
    }
    $expected = ($argv[1] ?? null) === 'verify'
        ? ['instance-root', 'package', 'plan', 'scope', 'resume-applied-source']
        : ['instance-root', 'workspace', 'transition', 'scope', 'resume-applied-source'];
    $actual = array_keys($appliedOptions); sort($expected); sort($actual);
    if ($nativeEntry || $serverScope || $cancelArguments !== [] || $actual !== $expected
        || !in_array($argv[1] ?? null, ['verify', 'runtime-transition', 'runtime-open'], true)
        || ($appliedOptions['scope'] ?? null) !== 'source'
        || (isset($appliedOptions['transition']) && $appliedOptions['transition'] !== $appliedOptions['workspace'] . '/source-runtime.json')) {
        throw new RuntimeException('SOURCE_TOOL_RESUME_ARGUMENTS_INVALID');
    }
}
if (!$nativeEntry && !$serverScope) {
    $early = [];
    foreach (array_slice($argv, 2) as $argument) {
        if (preg_match('/^--(instance-root|workspace|transition)=(.+)$/D', $argument, $match)) { $early[$match[1]] = $match[2]; }
    }
    $checkpoint = $early['transition'] ?? (isset($early['workspace']) ? $early['workspace'] . '/source-runtime.json' : null);
    if ($checkpoint === null && isset($early['instance-root']) && realpath($early['instance-root']) === $early['instance-root']) {
        $pointer = $early['instance-root'] . '/server/runtime/upgrade/source-transition.json';
        if (is_file($pointer) && !is_link($pointer)) {
            $pending = json_decode((string) file_get_contents($pointer), true);
            if (!in_array($pending['phase'] ?? null, ['opened', 'recovered'], true)) { $checkpoint = $pending['checkpoint'] ?? null; }
        }
    }
    if (basename($toolRoot) === 'trusted' && is_file(dirname($toolRoot) . '/source-runtime.json')) {
        $checkpoint = dirname($toolRoot) . '/source-runtime.json';
    }
    // A new source plan is authenticated against its real predecessor under the native locks below.
    // It must run the new source's code rather than silently reenter the historical tools.
    if ($successorArguments !== [] && ($argv[1] ?? null) === 'plan') { $checkpoint = null; }
    if ($checkpoint !== null && is_file($checkpoint)) {
        try {
            if (realpath($checkpoint) !== $checkpoint || (fileperms($checkpoint) & 0777) !== 0600
                || !is_file($checkpoint) || lstat($checkpoint)['nlink'] !== 1
                || (fileperms(dirname($checkpoint)) & 0077) !== 0) { throw new RuntimeException('SOURCE_RUNTIME_BOOTSTRAP_UNSAFE'); }
            $context = json_decode((string) file_get_contents($checkpoint), true, 512, JSON_THROW_ON_ERROR);
            $stateSha = $context['state_sha256'] ?? null; unset($context['state_sha256']);
            $binding = $context['binding'];
            if (($context['protocol'] ?? null) !== 'peanut.source-runtime-transition.v1'
                || $stateSha !== hash('sha256', productUpgradeCanonicalJson($context))
                || $binding['workspace'] !== dirname($checkpoint)
                || ($early['instance-root'] ?? null) !== $binding['instance_root']
                || !in_array(fileowner($checkpoint), [0, fileowner($binding['instance_root'] . '/server')], true)) {
                throw new RuntimeException('SOURCE_RUNTIME_BOOTSTRAP_INVALID');
            }
            $fixedRoot = $binding['workspace'] . '/trusted';
            $pointerPath = $binding['instance_root'] . '/server/runtime/upgrade/source-transition.json';
            if (is_file($pointerPath)) {
                $active = json_decode((string) file_get_contents($pointerPath), true, 512, JSON_THROW_ON_ERROR);
                $preparingSuccessor = isset($binding['source_successor']) && in_array($context['phase'], ['tools-prepared', 'preparing', 'prepared'], true)
                    && ($context['intents'] ?? null) === [] && !isset($context['source_proof']) && !isset($context['published_head_sha256'])
                    && ($active['checkpoint'] ?? null) === $binding['source_successor']['predecessor']['checkpoint']['path']
                    && hash_file('sha256', $pointerPath) === $binding['source_successor']['predecessor']['pending_sha256'];
                if (($active['transition_id'] ?? null) !== $context['transition_id'] && !$preparingSuccessor) {
                    throw new RuntimeException('SOURCE_RUNTIME_BOOTSTRAP_TRANSACTION_SUPERSEDED');
                }
            }
            foreach ($binding['tools'] as $relative => $sha) {
                $fixed = $fixedRoot . '/' . $relative;
                if (realpath($fixed) !== $fixed || !is_file($fixed) || lstat($fixed)['nlink'] !== 1
                    || hash_file('sha256', $fixed) !== $sha || (fileperms($fixed) & 0777) !== $binding['tool_modes'][$relative]) { throw new RuntimeException('SOURCE_RUNTIME_FIXED_TOOL_CHANGED'); }
            }
            if ($toolRoot !== $fixedRoot && $cancelArguments === [] && $appliedArguments === []) {
                $process = proc_open([PHP_BINARY, $fixedRoot . '/scripts/upgrade', ...array_slice($argv, 1)],
                    [0 => STDIN, 1 => STDOUT, 2 => STDERR], $pipes);
                if (!is_resource($process)) { throw new RuntimeException('SOURCE_RUNTIME_FIXED_ENTRY_UNAVAILABLE'); }
                $code = proc_close($process); exit($code < 0 ? 1 : $code);
            }
            $toolServer = $binding['workspace'] . '/tools/prepared/server';
            if (($binding['tool_autoload'] ?? null) !== $toolServer . '/vendor/autoload.php'
                || ($binding['tool_vendor_root'] ?? null) !== $toolServer . '/vendor'
                || ($binding['tool_source_root'] ?? null) !== dirname($toolServer)
                || hash_file('sha256', $binding['workspace'] . '/tool-inputs.json') !== $binding['tool_inputs_sha256']) {
                throw new RuntimeException('SOURCE_RUNTIME_INDEPENDENT_TOOL_BINDING_INVALID');
            }
            $process = proc_open(['python3', $fixedRoot . '/scripts/product-upgrade-host', 'source-tools-check',
                '--instance-root=' . $binding['instance_root'], '--workspace=' . $binding['workspace'],
                '--receipt-sha256=' . $binding['tool_bundle_sha256']],
                [0 => ['file', '/dev/null', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);
            if (!is_resource($process)) { throw new RuntimeException('SOURCE_RUNTIME_TOOL_PROOF_UNAVAILABLE'); }
            stream_get_contents($pipes[1]); $diagnostic = stream_get_contents($pipes[2]);
            fclose($pipes[1]); fclose($pipes[2]);
            if (proc_close($process) !== 0) { throw new RuntimeException('SOURCE_RUNTIME_TOOL_PROOF_FAILED:' . hash('sha256', $diagnostic)); }
            foreach ($binding['tool_dependencies'] as $file => $proof) {
                if (realpath($file) !== $file || !is_file($file) || lstat($file)['nlink'] !== 1
                    || hash_file('sha256', $file) !== $proof['sha256'] || (fileperms($file) & 0777) !== $proof['mode']) {
                    throw new RuntimeException('SOURCE_RUNTIME_TOOL_DEPENDENCY_CHANGED');
                }
            }
            if ($cancelArguments !== []) {
                $cancelAdmission = productUpgradeSourceToolAdmission($cancelOptions['cancel-unmodified-preparing'], $checkpoint, $context, $toolRoot);
                $cancelRunner = $toolRoot . '/scripts/scaffold-runtime/ScaffoldUpgradeRunner.php';
                // Only the admitted entry and Runner differ. Every other loader/helper stays frozen.
                $toolRoot = $fixedRoot;
                $runtimeRoot = $fixedRoot;
            }
            if ($appliedArguments !== []) {
                $appliedAdmission = productUpgradeSourceToolAdmission($appliedOptions['resume-applied-source'], $checkpoint, $context, $toolRoot,
                    'peanut.applied-source-tool-admission.v1');
                if (($appliedAdmission['command'] ?? null) !== $argv[1]) { throw new RuntimeException('SOURCE_TOOL_RESUME_COMMAND_CHANGED'); }
                $cancelRunner = $toolRoot . '/scripts/scaffold-runtime/ScaffoldUpgradeRunner.php';
                $toolRoot = $fixedRoot; $runtimeRoot = $fixedRoot;
            }
            $frozenSource = $context;
        } catch (Throwable $error) {
            fwrite(STDERR, $error->getMessage() . "\n"); exit(1);
        }
    }
}
if ($cancelArguments !== [] && $cancelAdmission === null) { throw new RuntimeException('SOURCE_RUNTIME_CANCEL_CHECKPOINT_REQUIRED'); }
if ($appliedArguments !== [] && $appliedAdmission === null) { throw new RuntimeException('SOURCE_TOOL_RESUME_CHECKPOINT_REQUIRED'); }
// 可信入口使用其自身已安装的Composer/Core；不能从尚未校验完整性的目标包加载依赖。
$installedAutoload = $frozenSource['binding']['tool_autoload'] ?? $toolRoot . '/server/vendor/autoload.php';
if (!is_file($installedAutoload)) {
    fwrite(STDERR, json_encode(['status' => 'error', 'error' => 'PRODUCT_UPGRADE_DEPENDENCIES_MISSING'], JSON_THROW_ON_ERROR) . "\n");
    exit(1);
}
if ($frozenSource === null) { require_once $installedAutoload; }
else {
    // Configure Composer's public loader from the pinned installed metadata; APP autoload files use frozen bytes.
    $vendor = dirname($installedAutoload);
    $bundle = json_decode((string) file_get_contents($frozenSource['binding']['workspace'] . '/tools/bundle.json'), true, 512, JSON_THROW_ON_ERROR);
    $checked = static function (string $path) use ($frozenSource, $toolRoot, $vendor, $bundle): string {
        if (str_starts_with($path, $vendor . '/')) {
            $proof = $bundle['tree']['files']['server/vendor/' . substr($path, strlen($vendor) + 1)] ?? null;
        } elseif (str_starts_with($path, $toolRoot . '/')) {
            $relative = substr($path, strlen($toolRoot) + 1);
            $proof = isset($frozenSource['binding']['tools'][$relative])
                ? [$frozenSource['binding']['tools'][$relative], $frozenSource['binding']['tool_modes'][$relative]] : null;
        } else { $proof = null; }
        if ($proof === null || realpath($path) !== $path || !is_file($path) || lstat($path)['nlink'] !== 1
            || hash_file('sha256', $path) !== $proof[0] || (fileperms($path) & 0777) !== $proof[1]) {
            throw new RuntimeException('SOURCE_RUNTIME_AUTOLOAD_OUTSIDE_FROZEN_CLOSURE');
        }
        return $path;
    };
    require_once $checked($vendor . '/composer/ClassLoader.php');
    if (is_file($vendor . '/composer/platform_check.php')) { require $checked($vendor . '/composer/platform_check.php'); }
    $map = static function (string $path) use ($frozenSource, $toolRoot): string {
        $parts = [];
        foreach (explode('/', $path) as $part) {
            if ($part === '' || $part === '.') { continue; }
            if ($part === '..') { array_pop($parts); } else { $parts[] = $part; }
        }
        $path = '/' . implode('/', $parts);
        $original = $frozenSource['binding']['tool_root'];
        $bundleSource = $frozenSource['binding']['tool_source_root'];
        $bundleVendor = $frozenSource['binding']['tool_vendor_root'];
        if ($path === $bundleVendor || str_starts_with($path, $bundleVendor . '/')) { return $path; }
        if ($path === $original . '/server/vendor' || str_starts_with($path, $original . '/server/vendor/')) {
            throw new RuntimeException('SOURCE_RUNTIME_LIVE_VENDOR_AUTOLOAD_REJECTED');
        }
        foreach ([$bundleSource, $original] as $source) {
            if (!str_starts_with($path, $source . '/')) { continue; }
            $relative = substr($path, strlen($source) + 1);
            foreach ($frozenSource['binding']['tools'] as $fixed => $_) {
                if ($fixed === $relative || str_starts_with($fixed, rtrim($relative, '/') . '/')) { return $toolRoot . '/' . $relative; }
            }
        }
        throw new RuntimeException('SOURCE_RUNTIME_UNBOUND_AUTOLOAD_PATH');
    };
    $loader = new \Composer\Autoload\ClassLoader($vendor);
    foreach (require $checked($vendor . '/composer/autoload_namespaces.php') as $prefix => $paths) { $loader->set($prefix, array_map($map, $paths)); }
    foreach (require $checked($vendor . '/composer/autoload_psr4.php') as $prefix => $paths) { $loader->setPsr4($prefix, array_map($map, $paths)); }
    $classes = require $checked($vendor . '/composer/autoload_classmap.php');
    foreach ($classes as &$classFile) { $classFile = $map($classFile); } unset($classFile);
    $loader->addClassMap($classes);
    spl_autoload_register(static function (string $class) use ($loader, $checked): void {
        $path = $loader->findFile($class);
        if ($path !== false) { require_once $checked($path); }
    }, true, true);
    if (is_file($vendor . '/composer/autoload_files.php')) {
        foreach (require $checked($vendor . '/composer/autoload_files.php') as $file) { require_once $checked($map($file)); }
    }
    foreach ($frozenSource['binding']['php_files'] as $relative) {
        if ($cancelRunner !== null && $relative === 'scripts/scaffold-runtime/ScaffoldUpgradeRunner.php') { continue; }
        if ($relative !== 'scripts/upgrade') { require_once $checked($toolRoot . '/' . $relative); }
    }
}
foreach ($serverScope ? [['/scripts/scaffold-runtime/ScaffoldPathGuard.php']] : [
    ['/scripts/scaffold-runtime/ScaffoldPathGuard.php'],
    ['/scripts/scaffold-runtime/ScaffoldManifest.php'],
    ['/scripts/scaffold-runtime/ScaffoldUpgradeLedger.php'],
    ['/scripts/scaffold-runtime/Semver.php'],
    ['/scripts/scaffold-runtime/ReleaseDependencyIdentity.php'],
    ['/server/app/platform/exception/plugin/PluginLifecycleException.php', '/scripts/upgrade-runtime/PluginLifecycleException.php'],
    ['/server/app/platform/value/plugin/PluginDescriptor.php', '/scripts/upgrade-runtime/PluginDescriptor.php'],
    ['/server/app/platform/infrastructure/plugin/PluginLockResolver.php', '/scripts/upgrade-runtime/PluginLockResolver.php'],
    ['/server/app/platform/exception/plugin/PluginArtifactToolException.php', '/scripts/upgrade-runtime/PluginArtifactToolException.php'],
    ['/server/app/platform/exception/plugin/PluginPackageException.php', '/scripts/upgrade-runtime/PluginPackageException.php'],
    ['/server/app/platform/value/plugin/ModuleFrontendLayout.php', '/scripts/upgrade-runtime/ModuleFrontendLayout.php'],
    ['/server/app/platform/infrastructure/plugin/PluginArtifactWriter.php', '/scripts/upgrade-runtime/PluginArtifactWriter.php'],
    ['/server/app/platform/validation/module/ModulePublicSurfacePolicy.php', '/scripts/upgrade-runtime/ModulePublicSurfacePolicy.php'],
    ['/server/app/platform/validation/module/OpisManifestSchemaValidator.php', '/scripts/upgrade-runtime/OpisManifestSchemaValidator.php'],
    ['/server/app/platform/validation/module/StrictVersionConstraintMatcher.php', '/scripts/upgrade-runtime/StrictVersionConstraintMatcher.php'],
    ['/server/app/platform/validation/plugin/ModulePackagePreflight.php', '/scripts/upgrade-runtime/ModulePackagePreflight.php'],
    ['/scripts/scaffold-runtime/ScaffoldUpgradeRunner.php'],
    ['/scripts/scaffold-runtime/EditionUpgradePackage.php'],
] as $candidates) {
    if ($cancelRunner !== null && $candidates === ['/scripts/scaffold-runtime/ScaffoldUpgradeRunner.php']) {
        if (class_exists(ScaffoldUpgradeRunner::class, false)) { throw new RuntimeException('SOURCE_RUNTIME_CANCEL_RUNNER_ALREADY_LOADED'); }
        require_once $checked($toolRoot . '/scripts/scaffold-runtime/ReleaseDependencyIdentity.php');
        require_once $checked($toolRoot . '/server/docker/scripts/update-plan.php');
        $pin = ($cancelAdmission ?? $appliedAdmission)['corrected_source']['files']['scripts/scaffold-runtime/ScaffoldUpgradeRunner.php'];
        if (realpath($cancelRunner) !== $cancelRunner || !is_file($cancelRunner) || lstat($cancelRunner)['nlink'] !== 1
            || hash_file('sha256', $cancelRunner) !== $pin['sha256'] || (fileperms($cancelRunner) & 0777) !== $pin['mode']) {
            throw new RuntimeException('SOURCE_RUNTIME_CANCEL_CORRECTION_CHANGED');
        }
        require_once $cancelRunner;
        continue;
    }
    foreach ($candidates as $candidate) {
        if (is_file($runtimeRoot . $candidate)) {
            require_once $runtimeRoot . $candidate;
            continue 2;
        }
    }
    throw new RuntimeException('PRODUCT_UPGRADE_RUNTIME_MISSING');
}

/** Protected operator approval plus reviewed source pins; a checksum is not an authorization service. */
function productUpgradeSourceToolAdmission(string $path, string $checkpoint, array $context, string $source,
    string $protocol = 'peanut.source-preparing-cancel-admission.v1'): array
{
    $binding = $context['binding']; $root = $binding['instance_root']; $workspace = $binding['workspace'];
    $stat = @lstat($path); $owner = fileowner($root . '/server');
    if (realpath($path) !== $path || dirname($path) !== $workspace . '/recovery' || !is_file($path) || is_link($path)
        || in_array(basename($path), ['vendor-preflight.json', 'cancel-checkpoint-before.json', 'cancel-pending-before.json',
            'cancel-audit.json', 'cancel-intent.json', 'cancel-completed.json'], true)
        || !is_array($stat) || $stat['nlink'] !== 1 || ($stat['mode'] & 07777) !== 0600 || $stat['size'] > 65536
        || !in_array($stat['uid'], [0, $owner], true) || !function_exists('posix_geteuid') || !in_array(posix_geteuid(), [0, $owner], true)) {
        throw new RuntimeException('SOURCE_RUNTIME_CANCEL_ADMISSION_UNSAFE');
    }
    $bytes = (string) file_get_contents($path);
    clearstatcache(true, $path);
    $stable = array_flip(['dev', 'ino', 'mode', 'nlink', 'uid', 'gid', 'size', 'mtime', 'ctime']);
    if (array_intersect_key(lstat($path), $stable) !== array_intersect_key($stat, $stable)) { throw new RuntimeException('SOURCE_RUNTIME_CANCEL_ADMISSION_CHANGED'); }
    $admission = json_decode($bytes, true, 64, JSON_THROW_ON_ERROR);
    if (!in_array($protocol, ['peanut.source-preparing-cancel-admission.v1', 'peanut.applied-source-tool-admission.v1'], true)
        || !is_array($admission) || ($admission['protocol'] ?? null) !== $protocol
        || ($admission['maximum_uses'] ?? null) !== 1 || ($admission['instance_root'] ?? null) !== $root
        || ($admission['workspace'] ?? null) !== $workspace || !is_int($admission['expected_generation'] ?? null) || $admission['expected_generation'] < 0
        || !array_key_exists('expected_head', $admission)
        || ($protocol === 'peanut.source-preparing-cancel-admission.v1' && ($admission['expected_head'] !== null || $admission['expected_generation'] !== 0))
        || preg_match('/\A[A-Za-z0-9][A-Za-z0-9_-]{0,63}\z/D', (string) ($admission['action_id'] ?? '')) !== 1
        || ($admission['source_kind'] ?? null) !== 'raw-internal-preinstall-scaffold') {
        throw new RuntimeException('SOURCE_RUNTIME_CANCEL_ADMISSION_INVALID');
    }
    if ($protocol === 'peanut.applied-source-tool-admission.v1') {
        $deploymentPath = $root . '/server/private/installation/deployment.json';
        $head = null; $generation = 0;
        if (file_exists($deploymentPath) || is_link($deploymentPath)) {
            if (realpath($deploymentPath) !== $deploymentPath || !is_file($deploymentPath) || lstat($deploymentPath)['nlink'] !== 1
                || (fileperms($deploymentPath) & 0777) !== 0644 || !in_array(fileowner($deploymentPath), [0, $owner], true)) {
                throw new RuntimeException('SOURCE_TOOL_RESUME_HEAD_UNSAFE');
            }
            $head = hash_file('sha256', $deploymentPath);
            $deployment = json_decode((string) file_get_contents($deploymentPath), true, 512, JSON_THROW_ON_ERROR);
            $generation = $deployment['source_generation'] ?? null;
        }
        if ($admission['expected_head'] !== $head || $admission['expected_generation'] !== $generation) { throw new RuntimeException('SOURCE_TOOL_RESUME_HEAD_CHANGED'); }
        $origin = $binding;
        if (isset($context['partial_origin_deployment'])) { $origin['deployment'] = $context['partial_origin_deployment']; }
        if (($admission['origin_binding_sha256'] ?? null) !== hash('sha256', productUpgradeCanonicalJson($origin))) { throw new RuntimeException('SOURCE_TOOL_RESUME_ORIGIN_CHANGED'); }
    }
    $references = ['checkpoint_sha256' => $checkpoint, 'pending_sha256' => $root . '/server/runtime/upgrade/source-transition.json',
        'ledger_sha256' => $root . '/.peanut/upgrades/ledger.ndjson', 'plan_file_sha256' => $binding['plan_path'],
        'tool_inputs_sha256' => $workspace . '/tool-inputs.json', 'tool_bundle_sha256' => $workspace . '/tools/bundle.json'];
    foreach ($references as $key => $file) {
        if (realpath($file) !== $file || !is_file($file) || is_link($file) || lstat($file)['nlink'] !== 1
            || ($admission[$key] ?? null) !== hash_file('sha256', $file)) { throw new RuntimeException('SOURCE_RUNTIME_CANCEL_INPUT_CHANGED'); }
    }
    foreach (['binding_sha256' => $binding, 'tools_sha256' => $binding['tools'], 'tool_modes_sha256' => $binding['tool_modes'],
        'dependencies_sha256' => $binding['tool_dependencies']] as $key => $value) {
        if (($admission[$key] ?? null) !== hash('sha256', productUpgradeCanonicalJson($value))) { throw new RuntimeException('SOURCE_RUNTIME_CANCEL_BINDING_CHANGED'); }
    }
    $plan = json_decode((string) file_get_contents($binding['plan_path']), true, 512, JSON_THROW_ON_ERROR);
    if (($admission['candidate'] ?? null) !== $binding['candidate']
        || ($admission['plan_identity_sha256'] ?? null) !== hash('sha256', productUpgradeCanonicalJson($plan['identity']))) {
        throw new RuntimeException('SOURCE_RUNTIME_CANCEL_PLAN_CHANGED');
    }
    $authority = $admission['authority'] ?? [];
    $authorityPath = $authority['path'] ?? '';
    if (!is_string($authorityPath) || realpath($authorityPath) !== $authorityPath || !is_file($authorityPath)
        || is_link($authorityPath) || lstat($authorityPath)['nlink'] !== 1 || (fileperms($authorityPath) & 0022) !== 0
        || !in_array(fileowner($authorityPath), [0, $owner], true)
        || ($authority['sha256'] ?? null) !== hash_file('sha256', $authorityPath)) { throw new RuntimeException('SOURCE_RUNTIME_CANCEL_AUTHORITY_REQUIRED'); }
    $provenance = $admission['corrected_source'] ?? [];
    $correctionFiles = ['scripts/upgrade', 'scripts/scaffold-runtime/ScaffoldUpgradeRunner.php'];
    if (in_array($admission['repair'] ?? null, ['source-verified-projection', 'head-published-admission'], true)) {
        if ($protocol !== 'peanut.applied-source-tool-admission.v1'
            || !in_array($admission['command'] ?? null, ['runtime-transition', 'runtime-open'], true)) {
            throw new RuntimeException('SOURCE_TOOL_PROJECTION_COMMAND_INVALID');
        }
        $correctionFiles[] = 'scripts/package-release-files.py';
        if (isset($admission['prepared_identity_sha256'])) {
            if (preg_match('/\A[a-f0-9]{64}\z/D', (string) $admission['prepared_identity_sha256']) !== 1) {
                throw new RuntimeException('SOURCE_TOOL_PREPARED_IDENTITY_INVALID');
            }
            $correctionFiles[] = 'scripts/product-upgrade-host';
        }
        if (($admission['repair'] ?? null) === 'head-published-admission'
            && (!isset($admission['prepared_identity_sha256'])
                || ($admission['native_php_binary']['path'] ?? null) !== PHP_BINARY
                || realpath(PHP_BINARY) !== PHP_BINARY
                || ($admission['native_php_binary']['sha256'] ?? null) !== hash_file('sha256', PHP_BINARY))) {
            throw new RuntimeException('SOURCE_TOOL_NATIVE_PHP_IDENTITY_CHANGED');
        }
    } elseif (isset($admission['repair'])) { throw new RuntimeException('SOURCE_TOOL_REPAIR_INVALID'); }
    if (($provenance['root'] ?? null) !== $source || realpath($source) !== $source
        || realpath(__FILE__) !== $source . '/scripts/upgrade'
        || array_keys($provenance['files'] ?? []) !== $correctionFiles) {
        throw new RuntimeException('SOURCE_RUNTIME_CANCEL_CORRECTION_INVALID');
    }
    foreach ($provenance['files'] as $relative => $pin) {
        $file = $source . '/' . $relative;
        if (realpath($file) !== $file || !is_file($file) || is_link($file) || lstat($file)['nlink'] !== 1
            || ($pin['old_sha256'] ?? null) !== ($binding['tools'][$relative] ?? null)
            || ($pin['sha256'] ?? null) !== hash_file('sha256', $file) || ($pin['mode'] ?? null) !== (fileperms($file) & 0777)
            || (fileperms($file) & 0022) !== 0 || !in_array(fileowner($file), [0, $owner], true)) {
            throw new RuntimeException('SOURCE_RUNTIME_CANCEL_CORRECTION_CHANGED');
        }
    }
    foreach (['commit' => 'HEAD', 'tree' => 'HEAD^{tree}'] as $key => $ref) {
        if (preg_match('/\A[a-f0-9]{40}\z/D', (string) ($provenance[$key] ?? '')) !== 1) { throw new RuntimeException('SOURCE_RUNTIME_CANCEL_SOURCE_REQUIRED'); }
        $process = proc_open(['git', '-C', $source, 'rev-parse', $ref], [0 => ['file', '/dev/null', 'r'], 1 => ['pipe', 'w'], 2 => ['file', '/dev/null', 'w']], $pipes);
        if (!is_resource($process)) { throw new RuntimeException('SOURCE_RUNTIME_CANCEL_SOURCE_UNAVAILABLE'); }
        $actual = trim((string) stream_get_contents($pipes[1])); fclose($pipes[1]);
        if (proc_close($process) !== 0 || $actual !== $provenance[$key]) { throw new RuntimeException('SOURCE_RUNTIME_CANCEL_SOURCE_CHANGED'); }
    }
    foreach ($provenance['files'] as $relative => $pin) {
        $process = proc_open(['git', '-C', $source, 'show', $provenance['commit'] . ':' . $relative],
            [0 => ['file', '/dev/null', 'r'], 1 => ['pipe', 'w'], 2 => ['file', '/dev/null', 'w']], $pipes);
        if (!is_resource($process)) { throw new RuntimeException('SOURCE_RUNTIME_CANCEL_SOURCE_UNAVAILABLE'); }
        $bytes = (string) stream_get_contents($pipes[1]); fclose($pipes[1]);
        if (proc_close($process) !== 0 || hash('sha256', $bytes) !== $pin['sha256']) { throw new RuntimeException('SOURCE_RUNTIME_CANCEL_SOURCE_CHANGED'); }
    }
    $process = proc_open(['git', '-C', $source, 'rev-parse', '--path-format=absolute', '--git-common-dir'],
        [0 => ['file', '/dev/null', 'r'], 1 => ['pipe', 'w'], 2 => ['file', '/dev/null', 'w']], $pipes);
    if (!is_resource($process)) { throw new RuntimeException('SOURCE_RUNTIME_CANCEL_SOURCE_UNAVAILABLE'); }
    $common = trim((string) stream_get_contents($pipes[1])); fclose($pipes[1]);
    $lease = $admission['lease']['lease'] ?? '';
    if (proc_close($process) !== 0 || realpath($common) !== $common
        || preg_match('/\A[A-Za-z0-9][A-Za-z0-9._-]{0,63}\z/D', (string) $lease) !== 1
        || ($admission['lease_proof'] ?? null) !== $common . '/peanut-admin-resource-leases/leases/' . $lease) {
        throw new RuntimeException('SOURCE_RUNTIME_CANCEL_NATIVE_LEASE_REQUIRED');
    }
    return $admission;
}

function productUpgradeToolPath(string $relative): string
{
    global $toolRoot, $runtimeRoot;
    return (str_starts_with($relative, 'server/') ? $toolRoot : $runtimeRoot) . '/' . $relative;
}

function productUpgradeUsage(): never
{
    fwrite(STDERR, "Set PEANUT_SERVER_ENV_FILE to the absolute mode-0600 instance backend environment.\nUsage:\n"
        . "  php scripts/upgrade plan --scope=source --instance-root=<development-app> --package=<verified-full-upstream-package>\n"
        . "  php scripts/upgrade apply|verify|recover --scope=source --instance-root=<development-app> --package=<full-upstream-package> --plan=<absolute-scaffold-plan>\n"
        . "  php scripts/upgrade plan --scope=server --instance-root=<mounted-app> --package=<workspace> --archive=<app-server-release> --expected-sha256=<trusted-sha256> [--backup-tool=<protected-registered-root-client>]\n"
        . "  php scripts/upgrade apply|verify|recover --scope=server --instance-root=<mounted-app> --package=<workspace> --plan=<absolute-product-plan>\n"
        . "  runtime-prepare --scope=source --instance-root=APP --workspace=W --package=PKG --plan=SOURCE_PLAN --expect-head=SHA|none --expect-generation=N\n"
        . "  runtime-transition|runtime-open|runtime-recover --scope=source --instance-root=APP --workspace=W --transition=W/source-runtime.json\n"
        . "  runtime-recover --scope=source --instance-root=APP --workspace=W --transition=W/source-runtime.json --cancel-unmodified-preparing=W/recovery/ADMISSION.json\n"
        . "  verify --scope=source --instance-root=APP --package=PKG --plan=SOURCE_PLAN --resume-applied-source=W/recovery/ADMISSION.json\n"
        . "  runtime-transition|runtime-open --scope=source --instance-root=APP --workspace=W --transition=W/source-runtime.json --resume-applied-source=W/recovery/ADMISSION.json\n"
        . "  runtime-refreeze --scope=source --instance-root=APP --workspace=W --expect-head=SHA|none --expect-generation=N\n"
        . "  plan --scope=source --instance-root=APP --package=FIXED_RAW_TARGET --partial-source-successor=PREVIOUS_W/source-runtime.json\n"
        . "  runtime-prepare --scope=source --instance-root=APP --workspace=NEW_W --package=FIXED_RAW_TARGET --plan=NEW_PLAN --expect-head=SHA --expect-generation=N --partial-source-successor=PREVIOUS_W/source-runtime.json\n"
        . "  server apply alone accepts --stop-before=health|activate; source scope changes source only.\n");
    exit(64);
}

/** @param array<string,mixed> $value */
function productUpgradeCanonicalJson(array $value): string
{
    $normalize = static function (mixed $item) use (&$normalize): mixed {
        if (!is_array($item)) {
            return $item;
        }
        if (!array_is_list($item)) {
            ksort($item, SORT_STRING);
        }
        foreach ($item as $key => $child) {
            $item[$key] = $normalize($child);
        }
        return $item;
    };
    return json_encode($normalize($value), JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE);
}

/** @param array<string,mixed> $value */
function productUpgradeWriteJson(string $path, array $value): void
{
    $directory = dirname($path);
    if ((!is_dir($directory) && !mkdir($directory, 0770, true)) || is_link($directory)) {
        throw new RuntimeException('PRODUCT_UPGRADE_PLAN_DIRECTORY_INVALID');
    }
    $temporary = $path . '.tmp-' . bin2hex(random_bytes(6));
    $json = json_encode($value, JSON_THROW_ON_ERROR | JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n";
    if (is_link($path) || (file_exists($path) && (!is_file($path) || (lstat($path)['nlink'] ?? 0) !== 1))) {
        throw new RuntimeException('PRODUCT_UPGRADE_RECORD_UNSAFE');
    }
    $stream = fopen($temporary, 'x');
    if ($stream === false || !chmod($temporary, 0600)
        || fwrite($stream, $json) !== strlen($json) || !fflush($stream) || !fsync($stream)) {
        if (is_resource($stream)) { fclose($stream); }
        @unlink($temporary);
        throw new RuntimeException('PRODUCT_UPGRADE_PLAN_WRITE_FAILED');
    }
    fclose($stream);
    if (!rename($temporary, $path)) { @unlink($temporary); throw new RuntimeException('PRODUCT_UPGRADE_PLAN_WRITE_FAILED'); }
    $handle = fopen($directory, 'r');
    if ($handle === false || !fsync($handle)) { throw new RuntimeException('PRODUCT_UPGRADE_DIRECTORY_SYNC_FAILED'); }
    fclose($handle);
}

/** The reviewed privileged transport belongs only to an ordinary registered server plan. */
function productUpgradeBackupTool(string $instanceRoot, ?string $path): ?array
{
    $server = $instanceRoot . '/server';
    $environment = parse_ini_file($server . '/.env', false, INI_SCANNER_RAW);
    if (!is_array($environment)) { throw new RuntimeException('PRODUCT_UPGRADE_DATABASE_PROVIDER_UNKNOWN'); }
    $source = $environment['PEANUT_DATABASE_SOURCE'] ?? 'bundled';
    if ($source === 'bundled' || $source === '') {
        if ($path !== null) { throw new RuntimeException('PRODUCT_UPGRADE_BUNDLED_BACKUP_TOOL_FORBIDDEN'); }
        return null;
    }
    if ($source !== 'registered' || $path === null || realpath($path) !== $path) {
        throw new RuntimeException('PRODUCT_UPGRADE_REGISTERED_BACKUP_TOOL_REQUIRED');
    }
    $stat = @lstat($path); $owner = fileowner($server);
    if (!is_array($stat) || !is_file($path) || is_link($path) || $stat['nlink'] !== 1
        || ($stat['mode'] & 0777) !== 0600 || !in_array($stat['uid'], [0, $owner], true)
        || $stat['size'] > 65536 || !function_exists('posix_geteuid') || !in_array(posix_geteuid(), [0, $owner], true)) {
        throw new RuntimeException('PRODUCT_UPGRADE_BACKUP_TOOL_UNSAFE');
    }
    $bytes = file_get_contents($path);
    $tool = json_decode((string) $bytes, true, 64, JSON_THROW_ON_ERROR);
    $contract = $tool['source_schema_backup'] ?? null;
    if (!is_array($tool) || ($tool['transport'] ?? null) !== 'ssh-docker-exec' || !is_array($contract)
        || ($contract['whole_schema'] ?? null) !== true
        || ($contract['database_resource_id'] ?? null) !== ($environment['PEANUT_DATABASE_RESOURCE_ID'] ?? null)
        || ($contract['database'] ?? null) !== ($environment['DB_NAME'] ?? null)) {
        throw new RuntimeException('PRODUCT_UPGRADE_BACKUP_TOOL_SCOPE_CHANGED');
    }
    return ['path' => $path, 'sha256' => hash('sha256', (string) $bytes), 'owner_uid' => $stat['uid'], 'mode' => 0600];
}

/** @return array<string,mixed> */
function productUpgradeReadPlan(string $instanceRoot, string $path): array
{
    $root = ScaffoldPathGuard::projectRoot($instanceRoot);
    $resolved = realpath($path);
    $plansRoot = $root . '/.peanut/upgrades/product-plans/';
    if (!is_string($resolved) || $resolved !== $path || !str_starts_with($resolved, $plansRoot)
        || !is_file($resolved) || is_link($resolved)) {
        throw new RuntimeException('PRODUCT_UPGRADE_PLAN_INVALID');
    }
    try {
        $plan = json_decode((string) file_get_contents($resolved), true, 256, JSON_THROW_ON_ERROR);
    } catch (JsonException $exception) {
        throw new RuntimeException('PRODUCT_UPGRADE_PLAN_INVALID', 0, $exception);
    }
    if (!is_array($plan)
        || ($plan['schema_version'] ?? null) !== 2
        || ($plan['protocol'] ?? null) !== 'peanut.product-upgrade-plan.v2'
        || ($plan['instance_root'] ?? null) !== $root
        || !is_string($plan['plan_sha256'] ?? null)) {
        throw new RuntimeException('PRODUCT_UPGRADE_PLAN_INVALID');
    }
    $digest = $plan['plan_sha256'];
    unset($plan['plan_sha256']);
    if (!hash_equals($digest, 'sha256:' . hash('sha256', productUpgradeCanonicalJson($plan)))) {
        throw new RuntimeException('PRODUCT_UPGRADE_PLAN_INVALID');
    }
    $tool = productUpgradeBackupTool($root, $plan['backup_tool']['path'] ?? null);
    if (($plan['backup_tool'] ?? null) !== $tool) { throw new RuntimeException('PRODUCT_UPGRADE_BACKUP_TOOL_CHANGED'); }
    return $plan + ['plan_sha256' => $digest, 'absolute_path' => $resolved];
}

/** @return resource */
function productUpgradeAcquireLock(string $instanceRoot)
{
    $directory = $instanceRoot . '/.peanut/upgrades';
    if ((!is_dir($directory) && !mkdir($directory, 0770, true)) || is_link($directory)) {
        throw new RuntimeException('PRODUCT_UPGRADE_STATE_DIRECTORY_INVALID');
    }
    $handle = fopen($directory . '/product.lock', 'c+');
    $lockStat = lstat($directory . '/product.lock');
    if ($handle === false || is_link($directory . '/product.lock') || !is_array($lockStat)
        || ($lockStat['nlink'] ?? 0) !== 1 || !chmod($directory . '/product.lock', 0600)
        || !flock($handle, LOCK_EX | LOCK_NB)) {
        if (is_resource($handle)) {
            fclose($handle);
        }
        throw new RuntimeException('PRODUCT_UPGRADE_ALREADY_RUNNING');
    }
    return $handle;
}

/** @param resource $handle */
function productUpgradeReleaseLock($handle): void
{
    flock($handle, LOCK_UN);
    fclose($handle);
}

/** @param array<string,mixed> $state */
function productUpgradeWriteState(string $path, array $state): array
{
    unset($state['state_sha256'], $state['absolute_path']);
    $state['updated_at'] = gmdate(DATE_ATOM);
    $state['state_sha256'] = 'sha256:' . hash('sha256', productUpgradeCanonicalJson($state));
    productUpgradeWriteJson($path, $state);
    return $state + ['absolute_path' => $path];
}

/** Only named, target-bound application SQL may defer module execution admission. */
function productUpgradeApplicationPrerequisites(array $plan, mixed $rows): array
{
    if (!is_array($rows) || !array_is_list($rows) || $rows === []) {
        throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_INVALID');
    }
    $files = [];
    foreach ($plan['migration']['files'] ?? [] as $file) {
        $path = $file['path'] ?? null;
        if (!is_string($path) || preg_match('#^server/database/migrations/([0-9]{8}-[a-z0-9][a-z0-9_-]*)\.sql$#D', $path, $match) !== 1
            || !is_string($file['sha256'] ?? null) || preg_match('/^[a-f0-9]{64}$/D', $file['sha256']) !== 1
            || isset($files[$match[1]])) {
            throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_INVALID');
        }
        $files[$match[1]] = $file['sha256'];
    }
    $bound = [];
    foreach ($rows as $row) {
        $id = is_array($row) ? ($row['migration_id'] ?? null) : null;
        if (!is_array($row) || count($row) !== 3 || !is_string($id) || isset($bound[$id])
            || ($row['reason'] ?? null) !== 'module_migration_provenance_schema'
            || !isset($files[$id]) || ($row['sha256'] ?? null) !== $files[$id]) {
            throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_INVALID');
        }
        $bound[$id] = ['migration_id' => $id, 'sha256' => $files[$id], 'reason' => 'module_migration_provenance_schema'];
    }
    ksort($bound, SORT_STRING);
    return array_values($bound);
}

/** Both fresh and reused phase evidence must prove a complete plan, never inferred execution admission. */
function productUpgradeAssertModulePreflight(array $plan, array $evidence): void
{
    $modules = $evidence['payload']['database']['modules'] ?? null;
    $application = $evidence['payload']['database']['application'] ?? null;
    if (($plan['migration']['module_preflight_protocol'] ?? null) !== 'peanut.upgrade-module-preflight.v1'
        || ($evidence['phase'] ?? null) !== 'migration-preflight'
        || ($evidence['status'] ?? null) !== 'completed'
        || ($evidence['candidate'] ?? null) !== $plan['candidate']
        || ($evidence['plan_sha256'] ?? null) !== $plan['plan_sha256']
        || ($evidence['package_manifest_sha256'] ?? null) !== $plan['package']['manifest_sha256']
        || !is_array($application) || !is_array($modules)
        || ($modules['schema_version'] ?? null) !== 1
        || ($modules['protocol'] ?? null) !== 'peanut.upgrade-module-preflight.v1'
        || ($modules['candidate'] ?? null) !== $plan['candidate']
        || ($modules['product_plan_sha256'] ?? null) !== $plan['plan_sha256']
        || ($modules['native_inputs_sha256'] ?? null) !== $plan['inputs_sha256']
        || 'sha256:' . ($modules['target_identity_sha256'] ?? '') !== $plan['package']['manifest_sha256']) {
        throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_REQUIRED');
    }
    $digest = $modules['report_sha256'] ?? null;
    unset($modules['report_sha256']);
    $native = $modules['plan'] ?? null;
    if (!is_string($digest) || !hash_equals($digest, hash('sha256', productUpgradeCanonicalJson($modules)))
        || !is_array($native) || ($native['schema_version'] ?? null) !== 1
        || ($native['protocol'] ?? null) !== 'peanut.plugin-reconcile-plan.v1'
        || ($native['scope'] ?? null) !== 'release-locked' || ($native['readonly'] ?? null) !== true
        || ($native['complete'] ?? null) !== true
        || !is_array($native['packages'] ?? null) || !array_is_list($native['packages'])) {
        throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_INVALID');
    }
    $nativeDigest = $native['report_sha256'] ?? null;
    unset($native['report_sha256']);
    if (!is_string($nativeDigest) || !hash_equals($nativeDigest, hash('sha256', productUpgradeCanonicalJson($native)))) {
        throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_INVALID');
    }
    $deferred = ($modules['may_apply'] ?? null) === false;
    $prerequisites = [];
    if ($deferred) {
        $prerequisites = productUpgradeApplicationPrerequisites($plan, $modules['application_prerequisites'] ?? null);
        if (($modules['planning_complete'] ?? null) !== true || ($modules['execution_admitted'] ?? null) !== false
            || ($native['may_apply'] ?? null) !== false || ($native['status'] ?? null) !== 'planned'
            || ($native['planning_complete'] ?? null) !== true || ($native['execution_admitted'] ?? null) !== false
            || productUpgradeApplicationPrerequisites($plan, $native['application_prerequisites'] ?? null) !== $prerequisites) {
            throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_INVALID');
        }
    } elseif (($modules['may_apply'] ?? null) !== true || ($native['may_apply'] ?? null) !== true
        || ($native['status'] ?? null) !== 'ready') {
        throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_INVALID');
    }
    $packagePrerequisites = [];
    foreach ($native['packages'] as $item) {
        if (!is_array($item) || !in_array($item['action'] ?? null,
            ['planned_install', 'planned_upgrade', 'planned_unchanged', 'preserve_disabled'], true)) {
            throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_INVALID');
        }
        if (($item['may_apply'] ?? null) === true) {
            if ($deferred) {
                if (!is_array($item['modules'] ?? null) || !array_is_list($item['modules'])
                    || ($item['application_prerequisites'] ?? []) !== []) {
                    throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_INVALID');
                }
                foreach ($item['modules'] as $module) {
                    if (!is_array($module) || ($module['may_apply'] ?? null) !== true
                        || ($module['application_prerequisites'] ?? []) !== []) {
                        throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_INVALID');
                    }
                }
            }
            continue;
        }
        if (!$deferred || ($item['may_apply'] ?? null) !== false || ($item['planning_complete'] ?? null) !== true
            || ($item['execution_admitted'] ?? null) !== false) {
            throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_INVALID');
        }
        $itemPrerequisites = productUpgradeApplicationPrerequisites($plan, $item['application_prerequisites'] ?? null);
        if (!is_array($item['modules'] ?? null) || !array_is_list($item['modules'])) {
            throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_INVALID');
        }
        $modulePrerequisites = [];
        foreach ($item['modules'] as $module) {
            if (!is_array($module)) { throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_INVALID'); }
            if (($module['may_apply'] ?? null) === true) {
                if (($module['application_prerequisites'] ?? []) !== []) {
                    throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_INVALID');
                }
                continue;
            }
            if (($module['may_apply'] ?? null) !== false || ($module['planning_complete'] ?? null) !== true
                || ($module['execution_admitted'] ?? null) !== false) {
                throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_INVALID');
            }
            foreach (productUpgradeApplicationPrerequisites($plan, $module['application_prerequisites'] ?? null) as $row) {
                $modulePrerequisites[$row['migration_id']] = $row;
            }
        }
        ksort($modulePrerequisites, SORT_STRING);
        if (array_values($modulePrerequisites) !== $itemPrerequisites) {
            throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_INVALID');
        }
        foreach ($itemPrerequisites as $row) {
            $packagePrerequisites[$row['migration_id']] = $row;
        }
    }
    ksort($packagePrerequisites, SORT_STRING);
    if ($deferred && array_values($packagePrerequisites) !== $prerequisites) {
        throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_INVALID');
    }
    $selected = array_column($native['packages'], 'key');
    $ordered = $selected;
    sort($ordered, SORT_STRING);
    if (($native['selected_package_keys'] ?? null) !== $selected || $selected !== $ordered
        || count(array_unique($selected)) !== count($selected)
        || ($native['action'] ?? null) !== ($selected === [] ? 'planned_noop' : 'planned_reconcile')) {
        throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_INVALID');
    }
}

/** Application-only evidence cannot complete a full server-release database phase. */
function productUpgradeAssertDatabaseCompletion(string $phase, array $evidence): void
{
    $database = $evidence['payload']['database'] ?? null;
    if (!is_array($database) || ($database['status'] ?? null) !== 'completed'
        || ($database['scope'] ?? null) !== 'server-release'
        || ($database['plugins'] ?? null) !== 'reconciled'
        || ($database['product_database'] ?? null) !== ($phase === 'migrate' ? 'migrated' : 'verified')) {
        throw new RuntimeException('PRODUCT_UPGRADE_DATABASE_COMPLETION_REQUIRED');
    }
}

/** @return array<string,mixed> */
function productUpgradeReadState(array $plan): array
{
    $path = $plan['state_path'] ?? null;
    $expectedPath = $plan['instance_root'] . '/.peanut/upgrades/product-state/' . $plan['candidate'] . '.json';
    if (!is_string($path) || $path !== $expectedPath || !is_file($path) || is_link($path)) {
        throw new RuntimeException('PRODUCT_UPGRADE_STATE_MISSING');
    }
    try {
        $state = json_decode((string) file_get_contents($path), true, 256, JSON_THROW_ON_ERROR);
    } catch (JsonException $exception) {
        throw new RuntimeException('PRODUCT_UPGRADE_STATE_INVALID', 0, $exception);
    }
    $digest = is_array($state) ? ($state['state_sha256'] ?? null) : null;
    if (!is_array($state)
        || ($state['schema_version'] ?? null) !== 1
        || ($state['protocol'] ?? null) !== 'peanut.product-upgrade-state.v1'
        || ($state['candidate'] ?? null) !== ($plan['candidate'] ?? null)
        || ($state['plan_sha256'] ?? null) !== ($plan['plan_sha256'] ?? null)
        || ($state['package'] ?? null) !== ($plan['package'] ?? null)
        || !in_array($state['phase'] ?? null, [
            'planned', 'blocked', 'prepared', 'migration_preflight_complete', 'backed_up', 'quiesced',
            'managed_files_applied', 'migrations_started', 'migrations_applied', 'switched',
            'reloaded_safe', 'migration_verified', 'healthy', 'activating', 'completed', 'recovering', 'recovered',
        ], true)
        || !in_array($state['phase_in_progress'] ?? null, [
            null, 'prepare', 'migration-preflight', 'backup', 'quiesce', 'managed_files', 'migrate',
            'switch', 'reload-safe', 'migration-verify', 'health', 'activate', 'recover', 'resume-old', 'recovery-verify',
        ], true)
        || !is_bool($state['database_recovery_required'] ?? null)
        || !is_bool($state['migration_completed'] ?? null)
        || !is_bool($state['activation_started'] ?? null)
        || !is_array($state['evidence'] ?? null)
        || !is_string($digest)) {
        throw new RuntimeException('PRODUCT_UPGRADE_STATE_INVALID');
    }
    unset($state['state_sha256']);
    if (!hash_equals($digest, 'sha256:' . hash('sha256', productUpgradeCanonicalJson($state)))) {
        throw new RuntimeException('PRODUCT_UPGRADE_STATE_INVALID');
    }
    foreach (['migrate', 'migration-verify'] as $phase) {
        if (isset($state['evidence'][$phase])) {
            $stored = $state['evidence'][$phase];
            if (!is_array($stored['payload'] ?? null) || ($stored['sha256'] ?? null)
                !== 'sha256:' . hash('sha256', productUpgradeCanonicalJson($stored['payload']))) {
                throw new RuntimeException('PRODUCT_UPGRADE_DATABASE_COMPLETION_REQUIRED');
            }
            productUpgradeAssertDatabaseCompletion($phase, $stored['payload']);
        }
    }
    return $state + ['state_sha256' => $digest, 'absolute_path' => $path];
}

/** @param array<string,mixed> $plan @param array<string,mixed> $state @return array<string,mixed> */
function productUpgradeHostPhase(string $packageRoot, string $phase, array $plan, array $state): array
{
    productUpgradeVerifyRuntime($plan);
    if (!in_array($phase, [
        'prepare', 'migration-preflight', 'backup', 'quiesce', 'migrate', 'switch',
        'reload-safe', 'migration-verify', 'health', 'activate', 'recover', 'resume-old', 'recovery-verify',
    ], true)) {
        throw new RuntimeException('PRODUCT_UPGRADE_HOST_PHASE_INVALID');
    }
    $driver = $plan['workspace'] . '/trusted/scripts/product-upgrade-host';
    if (!is_file($driver) || is_link($driver) || !is_executable($driver)) {
        throw new RuntimeException('PRODUCT_UPGRADE_HOST_DRIVER_INVALID');
    }
    $command = [
        $driver,
        $phase,
        '--instance-root=' . $plan['instance_root'],
        '--package=' . $packageRoot,
        '--plan=' . $plan['absolute_path'],
        '--state=' . $state['absolute_path'],
    ];
    $logDirectory = $plan['instance_root'] . '/.peanut/upgrades/host-logs';
    if ((!is_dir($logDirectory) && !mkdir($logDirectory, 0700, true)) || is_link($logDirectory)) {
        throw new RuntimeException('PRODUCT_UPGRADE_HOST_LOG_INVALID');
    }
    $logPath = $logDirectory . '/' . $plan['candidate'] . '-' . $phase . '.log';
    if (file_exists($logPath) || is_link($logPath)) {
        $logStat = lstat($logPath);
        if (!is_file($logPath) || is_link($logPath) || !is_array($logStat)
            || ($logStat['nlink'] ?? 0) !== 1 || (($logStat['mode'] ?? 0) & 0777) !== 0600) {
            throw new RuntimeException('PRODUCT_UPGRADE_HOST_LOG_INVALID');
        }
        $log = fopen($logPath, 'ab');
    } else {
        $log = fopen($logPath, 'xb');
    }
    if ($log === false || !chmod($logPath, 0600)) {
        if (is_resource($log)) {
            fclose($log);
        }
        throw new RuntimeException('PRODUCT_UPGRADE_HOST_LOG_INVALID');
    }
    $pipes = [];
    $process = proc_open($command, [0 => ['file', '/dev/null', 'r'], 1 => ['pipe', 'w'], 2 => $log], $pipes, $packageRoot);
    if (!is_resource($process)) {
        fclose($log);
        throw new RuntimeException('PRODUCT_UPGRADE_HOST_DRIVER_FAILED');
    }
    $stdout = stream_get_contents($pipes[1]);
    fclose($pipes[1]);
    $exitCode = proc_close($process);
    fclose($log);
    if ($exitCode !== 0 || !is_string($stdout)) {
        throw new RuntimeException('PRODUCT_UPGRADE_HOST_PHASE_FAILED:' . $phase . ':exit-' . $exitCode);
    }
    try {
        $evidence = json_decode(trim($stdout), true, 128, JSON_THROW_ON_ERROR);
    } catch (JsonException $exception) {
        throw new RuntimeException('PRODUCT_UPGRADE_HOST_EVIDENCE_INVALID:' . $phase, 0, $exception);
    }
    if (!is_array($evidence)
        || ($evidence['protocol'] ?? null) !== 'peanut.product-upgrade-host-evidence.v1'
        || ($evidence['status'] ?? null) !== 'completed'
        || ($evidence['phase'] ?? null) !== $phase
        || ($evidence['candidate'] ?? null) !== $plan['candidate']
        || ($evidence['plan_sha256'] ?? null) !== $plan['plan_sha256']
        || ($evidence['package_manifest_sha256'] ?? null) !== $plan['package']['manifest_sha256']
        || !is_array($evidence['payload'] ?? null)
        || $evidence['payload'] === []) {
        throw new RuntimeException('PRODUCT_UPGRADE_HOST_EVIDENCE_INVALID:' . $phase);
    }
    if ($phase === 'migration-preflight') {
        productUpgradeAssertModulePreflight($plan, $evidence);
    } elseif (in_array($phase, ['migrate', 'migration-verify'], true)) {
        productUpgradeAssertDatabaseCompletion($phase, $evidence);
    }
    return [
        'sha256' => 'sha256:' . hash('sha256', productUpgradeCanonicalJson($evidence)),
        'payload' => $evidence,
    ];
}

/** @return list<string> */
function productUpgradeRuntimeFiles(): array
{
    $files = ['scripts/product-upgrade-host'];
    foreach (['update-plan.php', 'update-database.php', 'update-preparation.py', 'update-recovery.py',
        'prepare-vendor.sh', 'prepare-vendor.php', 'vendor-state.py', 'configure-collaboration.py'] as $name) {
        $files[] = 'server/docker/scripts/' . $name;
    }
    return $files;
}

/** Verify frozen bytes from the installed coordinator before executing any adapter. */
function productUpgradeVerifyRuntime(array $plan): void
{
    $root = $plan['workspace'] . '/trusted';
    if (!is_dir($root) || is_link($root)) {
        throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_TOOL_INVALID');
    }
    $manifest = $root . '/manifest.json';
    if (!is_file($manifest) || is_link($manifest)
        || hash_file('sha256', $manifest) !== $plan['runtime_sha256']) {
        throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_MANIFEST_CHANGED');
    }
    $rows = json_decode((string) file_get_contents($manifest), true, 32, JSON_THROW_ON_ERROR);
    $expected = productUpgradeRuntimeFiles();
    sort($expected, SORT_STRING);
    $keys = is_array($rows) ? array_keys($rows) : [];
    sort($keys, SORT_STRING);
    if ($keys !== $expected) {
        throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_INVENTORY_INVALID');
    }
    $actual = [];
    foreach (new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS), RecursiveIteratorIterator::SELF_FIRST) as $file) {
        if ($file->isLink() || (!$file->isDir() && !$file->isFile())) {
            throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_TOOL_INVALID');
        }
        if ($file->isFile()) {
            $actual[] = substr($file->getPathname(), strlen($root) + 1);
        }
    }
    $expected[] = 'manifest.json';
    sort($expected, SORT_STRING);
    sort($actual, SORT_STRING);
    if ($actual !== $expected) {
        throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_INVENTORY_INVALID');
    }
    foreach ($rows as $relative => $digest) {
        $path = $root . '/' . $relative;
        $stat = lstat($path);
        if (!is_string($digest) || !is_array($stat) || ($stat['nlink'] ?? 0) !== 1
            || !in_array(($stat['mode'] ?? 0) & 0777, [0600, 0700], true)
            || hash_file('sha256', $path) !== $digest) {
            throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_TOOL_CHANGED');
        }
    }
}

/** Freeze installed phase adapters before managed files can change them. */
function productUpgradeFreezeRuntime(string $workspace): string
{
    $rows = [];
    foreach (productUpgradeRuntimeFiles() as $relative) {
        $source = productUpgradeToolPath($relative);
        $target = $workspace . '/trusted/' . $relative;
        if (!is_file($source) || is_link($source)) { throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_TOOL_MISSING'); }
        $digest = hash_file('sha256', $source);
        if (file_exists($target) || is_link($target)) {
            if (!is_file($target) || is_link($target) || hash_file('sha256', $target) !== $digest) {
                throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_TOOL_COLLISION');
            }
        } else {
            if (!is_dir(dirname($target)) && !mkdir(dirname($target), 0700, true)) {
                throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_TOOL_WRITE_FAILED');
            }
            if (!copy($source, $target) || !chmod($target, is_executable($source) ? 0700 : 0600)) {
                throw new RuntimeException('PRODUCT_UPGRADE_TRUSTED_TOOL_WRITE_FAILED');
            }
        }
        $rows[$relative] = $digest;
    }
    productUpgradeWriteJson($workspace . '/trusted/manifest.json', $rows);
    return hash_file('sha256', $workspace . '/trusted/manifest.json');
}

function productUpgradeServerPackage(string $instanceRoot, string $workspace, ?string $archive, ?string $expected): array
{
    if (!is_file($workspace . '/plan.json')) {
        require_once productUpgradeToolPath('server/docker/scripts/update-plan.php');
        if ($archive === null || $expected === null) { throw new RuntimeException('PRODUCT_UPGRADE_SERVER_ARCHIVE_REQUIRED'); }
        $input = PeanutServerUpdatePlan::build($instanceRoot . '/server', $archive, $expected, $workspace);
    } else {
        $input = json_decode((string) file_get_contents($workspace . '/plan.json'), true, 256, JSON_THROW_ON_ERROR);
        if (($input['protocol'] ?? null) !== 'peanut.server-release-inputs.v1') {
            throw new RuntimeException('PRODUCT_UPGRADE_SERVER_INPUT_PROTOCOL_INVALID');
        }
        if ($archive !== null && (hash_file('sha256', $archive) !== $expected || $input['target']['archive_sha256'] !== $expected)) {
            throw new RuntimeException('PRODUCT_UPGRADE_SERVER_ARCHIVE_REBIND_FAILED');
        }
    }
    $target = $workspace . '/prepared/server/.peanut/release-identity.json';
    if (!is_file($target) || is_link($target) || hash_file('sha256', $target) !== $input['target']['identity_sha256']) {
        throw new RuntimeException('PRODUCT_UPGRADE_SERVER_INVENTORY_REBIND_FAILED');
    }
    $identity = json_decode((string) file_get_contents($target), true, 256, JSON_THROW_ON_ERROR);
    foreach ($identity['files'] as $file) {
        $path = $workspace . '/prepared/' . $file['path'];
        if (!is_file($path) || is_link($path) || hash_file('sha256', $path) !== $file['sha256']
            || (fileperms($path) & 0777) !== $file['mode']) {
            throw new RuntimeException('PRODUCT_UPGRADE_SERVER_FILE_REBIND_FAILED');
        }
    }
    return ['input' => $input, 'identity' => $identity];
}

function productUpgradeCode(string $operation, array $plan): mixed
{
    productUpgradeVerifyRuntime($plan);
    if (!class_exists('PeanutServerUpdatePlan', false)) {
        require_once $plan['workspace'] . '/trusted/server/docker/scripts/update-plan.php';
    }
    return PeanutServerUpdatePlan::productPhase($plan['instance_root'] . '/server', $plan['workspace'], match ($operation) {
        'apply' => 'files-apply', 'verify' => 'files-verify', 'recover' => 'files-recover', 'verifyRecovery' => 'files-verify-recovery',
    });
}

/** @param array<string,mixed> $state @param array<string,mixed> $evidence @return array<string,mixed> */
function productUpgradeCompleteHostPhase(array $state, string $statePath, string $phase, string $completed, array $evidence): array
{
    $state['phase'] = $completed;
    $state['phase_in_progress'] = null;
    $state['evidence'][$phase] = $evidence;
    return productUpgradeWriteState($statePath, $state);
}

/** @param array<string,mixed> $plan @param array<string,mixed> $state @return array<string,mixed> */
function productUpgradeEnsureHostPhase(
    string $packageRoot,
    array $plan,
    array $state,
    string $phase,
    string $completed,
): array {
    if (isset($state['evidence'][$phase])) {
        if ($phase === 'migration-preflight') {
            $stored = $state['evidence'][$phase];
            if (!is_array($stored['payload'] ?? null) || ($stored['sha256'] ?? null)
                !== 'sha256:' . hash('sha256', productUpgradeCanonicalJson($stored['payload']))) {
                throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_INVALID');
            }
            productUpgradeAssertModulePreflight($plan, $stored['payload']);
        }
        return $state;
    }
    $state['phase_in_progress'] = $phase;
    $state = productUpgradeWriteState((string) $state['absolute_path'], $state);
    $evidence = productUpgradeHostPhase($packageRoot, $phase, $plan, $state);
    return productUpgradeCompleteHostPhase($state, (string) $state['absolute_path'], $phase, $completed, $evidence);
}

/** @param array<string,mixed> $plan @param array<string,mixed> $state @return array<string,mixed> */
function productUpgradeRefreshHostPhase(string $packageRoot, array $plan, array $state, string $phase): array
{
    $state['phase_in_progress'] = $phase;
    $state = productUpgradeWriteState((string) $state['absolute_path'], $state);
    $evidence = productUpgradeHostPhase($packageRoot, $phase, $plan, $state);
    $state['phase_in_progress'] = null;
    $state['evidence'][$phase] = $evidence;
    return productUpgradeWriteState((string) $state['absolute_path'], $state);
}

$command = $argv[1] ?? null;
if (!in_array($command, ['plan', 'apply', 'verify', 'recover', 'runtime-prepare', 'runtime-transition', 'runtime-open', 'runtime-recover', 'runtime-refreeze'], true)) {
    productUpgradeUsage();
}
$options = [];
foreach (array_slice($argv, 2) as $argument) {
    if (preg_match('/^--(instance-root|package|plan|stop-before|scope|archive|expected-sha256|workspace|transition|expect-head|expect-generation|backup-tool|cancel-unmodified-preparing|resume-applied-source|partial-source-successor|baseline-mode-manifest)=(.+)$/D', $argument, $matches) !== 1
        || isset($options[$matches[1]])) {
        productUpgradeUsage();
    }
    $options[$matches[1]] = $matches[2];
}
$runtimeCommand = str_starts_with($command, 'runtime-');
if ($runtimeCommand) {
    $required = ['instance-root', 'workspace', 'scope'];
    if ($cancelAdmission !== null) { $required[] = 'cancel-unmodified-preparing'; }
    if ($appliedAdmission !== null) { $required[] = 'resume-applied-source'; }
    if ($successorArguments !== []) { $required[] = 'partial-source-successor'; }
    $required = array_merge($required, match ($command) {
        'runtime-prepare' => ['package', 'plan', 'expect-head', 'expect-generation'],
        'runtime-refreeze' => ['expect-head', 'expect-generation'],
        default => ['transition'],
    });
    $actual = array_keys($options); sort($actual); sort($required);
    if ($actual !== $required || ($options['scope'] ?? null) !== 'source' || $nativeEntry
        || (isset($options['expect-head']) && $options['expect-head'] !== 'none' && preg_match('/^[a-f0-9]{64}$/D', $options['expect-head']) !== 1)
        || (isset($options['expect-generation']) && preg_match('/^(0|[1-9][0-9]*)$/D', $options['expect-generation']) !== 1)
        || (isset($options['transition']) && $options['transition'] !== $options['workspace'] . '/source-runtime.json')) {
        productUpgradeUsage();
    }
    try {
        $root = ScaffoldPathGuard::projectRoot($options['instance-root']);
        $result = (new ScaffoldUpgradeRunner())->runtimeCommand($command, $root, $options, $toolRoot, $cancelAdmission,
            $appliedAdmission === null ? null : ['path' => $options['resume-applied-source'], 'document' => $appliedAdmission]);
        if (($result['status'] ?? null) === 'tools-prepared' && in_array($command, ['runtime-prepare', 'runtime-refreeze'], true)) {
            // No APP pending/write boundary exists yet. Reenter only after all parent locks were released.
            $process = proc_open([PHP_BINARY, $options['workspace'] . '/trusted/scripts/upgrade', ...array_slice($argv, 1)],
                [0 => STDIN, 1 => STDOUT, 2 => STDERR], $pipes);
            if (!is_resource($process)) { throw new RuntimeException('SOURCE_RUNTIME_TOOL_REENTRY_UNAVAILABLE'); }
            $code = proc_close($process); exit($code < 0 ? 1 : $code);
        }
        fwrite(STDOUT, json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
        exit(0);
    } catch (Throwable $error) {
        fwrite(STDERR, json_encode(['status' => 'error', 'error' => $error->getMessage()], JSON_THROW_ON_ERROR) . "\n");
        exit(1);
    }
}
$required = ['instance-root', 'package'];
if ($appliedAdmission !== null) { $required[] = 'resume-applied-source'; }
if (!isset($options['scope'])) { productUpgradeUsage(); }
if (isset($options['scope'])) {
    if (!in_array($options['scope'], ['source', 'server'], true)) { productUpgradeUsage(); }
    $required[] = 'scope';
    if ($command === 'plan' && $options['scope'] === 'server') { $required[] = 'archive'; $required[] = 'expected-sha256'; }
}
if ($command !== 'plan') {
    $required[] = 'plan';
}
if (isset($options['backup-tool'])) {
    if ($command !== 'plan' || ($options['scope'] ?? null) !== 'server') { productUpgradeUsage(); }
    $required[] = 'backup-tool';
}
if ($successorArguments !== []) {
    if ($command !== 'plan' || ($options['scope'] ?? null) !== 'source') { productUpgradeUsage(); }
    $required[] = 'partial-source-successor';
}
if (isset($options['baseline-mode-manifest'])) {
    if ($command !== 'plan' || $options['scope'] !== 'source' || $successorArguments !== []) { productUpgradeUsage(); }
    $required[] = 'baseline-mode-manifest';
}
if (isset($options['stop-before'])) {
    if ($command !== 'apply' || ($options['scope'] ?? 'source') !== 'server' || !in_array($options['stop-before'], ['health', 'activate'], true)) {
        productUpgradeUsage();
    }
    $required[] = 'stop-before';
}
$actual = array_keys($options);
sort($actual, SORT_STRING);
$expected = $required;
sort($expected, SORT_STRING);
if ($actual !== $expected) {
    productUpgradeUsage();
}

$lock = null;
try {
    $instanceRoot = ScaffoldPathGuard::projectRoot($options['instance-root']);
    $lock = $options['scope'] === 'server' ? productUpgradeAcquireLock($instanceRoot) : null;
    $packageRoot = realpath($options['package']);
    if (!is_string($packageRoot)) {
        throw new RuntimeException('PRODUCT_UPGRADE_PACKAGE_NOT_FOUND');
    }
    if ($options['scope'] === 'source' && $nativeEntry) { throw new RuntimeException('PRODUCT_UPGRADE_SOURCE_REQUIRES_FULL_APPLICATION_TOOLS'); }

    if (($options['scope'] ?? 'source') === 'source') {
        $result = ScaffoldUpgradeRunner::sourceProductLock($instanceRoot, function () use ($instanceRoot, $packageRoot, $command, $options, $frozenSource, $appliedAdmission): array {
        $runner = new ScaffoldUpgradeRunner();
        $packageService = new EditionUpgradePackage();
        if ($command === 'plan') {
            $prepared = isset($options['partial-source-successor'])
                ? $packageService->preparePartialSourceSuccessor($instanceRoot, $packageRoot, $options['partial-source-successor'])
                : $packageService->prepare($instanceRoot, $packageRoot, $options['baseline-mode-manifest'] ?? null);
            $result = $runner->preflight($instanceRoot, $prepared['from_manifest'], $prepared['to_manifest']);
            $result['plan_path'] = $instanceRoot . '/' . $result['plan_path'];
        } else {
            $successorInput = ($frozenSource['binding']['source_input_kind'] ?? null) === 'raw-partial-source-successor-scaffold';
            $rawInput = $successorInput || ($frozenSource['binding']['source_input_kind'] ?? null) === 'raw-internal-preinstall-scaffold';
            if (!$rawInput) { $prepared = $packageService->reauthenticate($instanceRoot, $packageRoot); }
            $sourcePlan = json_decode((string) file_get_contents($options['plan']), true, 256, JSON_THROW_ON_ERROR);
            if ($rawInput) {
                // Only the original verified frozen bootstrap can select this input type.
                // Runner still authenticates the complete raw artifacts, actual owner/DB/private
                // frontier, old preimages, phase and source events before applying or verifying.
                $binding = $frozenSource['binding'];
                $internal = $binding['internal_preinstall'] ?? [];
                $digest = hash('sha256', productUpgradeCanonicalJson([$sourcePlan['identity'] ?? null, $sourcePlan['actions'] ?? null]));
                if (!in_array($command, ['apply', 'verify'], true) || !is_array($sourcePlan)
                    || ($sourcePlan['protocol'] ?? null) !== 'peanut.scaffold-upgrade-plan.v2' || ($sourcePlan['status'] ?? null) !== 'ready'
                    || ($sourcePlan['candidate'] ?? null) !== 'scaffold-' . substr($digest, 0, 24)
                    || ($sourcePlan['candidate'] ?? null) !== ($binding['candidate'] ?? null)
                    || ($sourcePlan['plan_sha256'] ?? null) !== 'sha256:' . $digest
                    || ($sourcePlan['plan_sha256'] ?? null) !== ($binding['plan_sha256'] ?? null)
                    || (!$successorInput && (($sourcePlan['identity']['kind'] ?? null) !== 'internal-candidate-preinstall-correction'
                        || ($internal['protocol'] ?? null) !== 'peanut.internal-preinstall-source.v1'
                        || ($internal['server_root'] ?? null) !== $instanceRoot . '/server'
                        || ($binding['old_identity']['kind'] ?? null) !== 'internal-candidate'
                        || productUpgradeCanonicalJson($sourcePlan['identity']['internal_preinstall'] ?? []) !== productUpgradeCanonicalJson($internal)))
                    || ($successorInput && (($sourcePlan['identity']['kind'] ?? null) !== 'development-partial-source-correction'
                        || ($binding['source_successor']['protocol'] ?? null) !== 'peanut.partial-source-successor.v1'
                        || ($binding['source_successor']['server_root'] ?? null) !== $instanceRoot . '/server'
                        || productUpgradeCanonicalJson($sourcePlan['identity']['source_successor'] ?? []) !== productUpgradeCanonicalJson($binding['source_successor'])))
                    || ($binding['instance_root'] ?? null) !== $instanceRoot
                    || realpath($options['plan']) !== $options['plan'] || $options['plan'] !== ($binding['plan_path'] ?? null)
                    || $packageRoot !== ($binding['package_root'] ?? null)
                    || ($sourcePlan['manifest_paths']['to'] ?? null) !== $packageRoot . '/scaffold-manifest.json'
                    || ($frozenSource['activation_started'] ?? null) !== false || isset($frozenSource['installation_completion'])) {
                    throw new RuntimeException('SOURCE_RUNTIME_RAW_PUBLIC_INPUT_REBIND_FAILED');
                }
            } elseif (($sourcePlan['protocol'] ?? null) !== 'peanut.scaffold-upgrade-plan.v2'
                || ($sourcePlan['manifest_paths']['to'] ?? null) !== $prepared['to_manifest']) {
                throw new RuntimeException('PRODUCT_UPGRADE_SOURCE_PACKAGE_REBIND_FAILED');
            }
            if ($appliedAdmission !== null) {
                // The raw plan has been authenticated above; Runner rechecks it under its own locks.
                // Release this completed working copy before nested checkpoint/preimage proofs.
                unset($sourcePlan, $binding, $internal, $digest);
                $result = $runner->verify($instanceRoot, $options['plan'],
                    ['path' => $options['resume-applied-source'], 'document' => $appliedAdmission]);
            } else { $result = $runner->{$command}($instanceRoot, $options['plan']); }
        }
        return $result;
        });
        $result['scope'] = 'source';
        $result['source_only'] = true;
        if ($lock !== null) { productUpgradeReleaseLock($lock); }
        $lock = null;
        fwrite(STDOUT, json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n");
        exit(($result['status'] ?? null) === 'blocked' ? 2 : 0);
    }

    if ($command === 'plan') {
        // The installed coordinator and its installed runtime control package validation. No
        // executable from the target package is invoked until package validation succeeds.
        $scope = 'server';
        $backupTool = productUpgradeBackupTool($instanceRoot, $options['backup-tool'] ?? null);
        $serverPackage = productUpgradeServerPackage($instanceRoot, $packageRoot, $options['archive'], $options['expected-sha256']);
        $input = $serverPackage['input'];
        $identity = $serverPackage['identity'];
        if (($identity['application']['kind'] ?? null) !== 'application'
            || preg_match('/^[a-f0-9]{40}$/D', (string) ($identity['application']['commit'] ?? '')) !== 1
            || preg_match('/^[a-f0-9]{40}$/D', (string) ($identity['application']['tree'] ?? '')) !== 1) {
            throw new RuntimeException('PRODUCT_UPGRADE_REQUIRES_APPLICATION_RELEASE');
        }
        $scaffold = ['candidate' => $input['update_id'], 'status' => 'ready'];
        $packageIdentity = ['root' => $packageRoot, 'inventory_sha256' => 'sha256:' . $identity['files_sha256'],
            'manifest_sha256' => 'sha256:' . $input['target']['identity_sha256'],
            'target_version' => $identity['application']['version'], 'archive_sha256' => $input['target']['archive_sha256'],
            'source_commit' => $identity['application']['commit'], 'source_tree' => $identity['application']['tree']];
        $edition = ['name' => $identity['application']['edition']];
        $migrationFiles = array_values(array_map(static fn(array $row): array => ['path' => $row['path'], 'sha256' => $row['sha256']],
            array_filter($identity['files'], static fn(array $row): bool => preg_match('#^server/database/migrations/[0-9]{8}-[a-z0-9][a-z0-9_-]*\.sql$#D', $row['path']) === 1)));
        $workspace = $packageRoot;
        $existingPath = $instanceRoot . '/.peanut/upgrades/product-plans/' . $scaffold['candidate'] . '.json';
        if (is_file($existingPath) && !is_link($existingPath)) {
            $existing = productUpgradeReadPlan($instanceRoot, $existingPath);
            if (($existing['migration']['module_preflight_protocol'] ?? null) !== 'peanut.upgrade-module-preflight.v1') {
                throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_CAPABILITY_REQUIRED');
            }
            if (($existing['backup_tool'] ?? null) !== $backupTool
                || ($existing['package'] ?? null) !== $packageIdentity
                || ($existing['scope'] ?? null) !== 'server'
                || ($existing['inputs_sha256'] ?? null) !== hash_file('sha256', $workspace . '/plan.json')
                || ($existing['migration']['target_version'] ?? null) !== $packageIdentity['target_version']
                || ($existing['migration']['files'] ?? null) !== $migrationFiles) {
                throw new RuntimeException('PRODUCT_UPGRADE_PLAN_COLLISION');
            }
            $binding = ['plan_path' => $existingPath, 'plan_sha256' => $existing['plan_sha256']];
            $bindingPath = $workspace . '/product-binding.json';
            if (!file_exists($bindingPath) && !is_link($bindingPath)) {
                productUpgradeWriteJson($bindingPath, $binding);
            } elseif (is_link($bindingPath) || json_decode((string) file_get_contents($bindingPath), true, 256, JSON_THROW_ON_ERROR) !== $binding) {
                throw new RuntimeException('PRODUCT_UPGRADE_PLAN_COLLISION');
            }
            if (!file_exists($existing['state_path']) && !is_link($existing['state_path'])) {
                foreach (['prepared.json', 'backup.json', 'journal.json', 'migration.json', 'preparation.json'] as $artifact) {
                    if (file_exists($workspace . '/' . $artifact) || is_link($workspace . '/' . $artifact)) {
                        throw new RuntimeException('PRODUCT_UPGRADE_STATE_LOST_REQUIRES_INSPECTION');
                    }
                }
                productUpgradeWriteState($existing['state_path'], [
                    'schema_version' => 1, 'protocol' => 'peanut.product-upgrade-state.v1',
                    'candidate' => $existing['candidate'], 'plan_sha256' => $existing['plan_sha256'], 'package' => $existing['package'],
                    'phase' => 'planned', 'phase_in_progress' => null, 'database_recovery_required' => false,
                    'migration_completed' => false, 'activation_started' => false, 'evidence' => [], 'created_at' => $existing['created_at'],
                ]);
            }
            productUpgradeReadState($existing);
            unset($existing['absolute_path']);
            $result = $existing + ['plan_path' => $existingPath, 'idempotent' => true];
        } else {
            $statePath = $instanceRoot . '/.peanut/upgrades/product-state/' . $scaffold['candidate'] . '.json';
            if (!is_dir($workspace) && !mkdir($workspace, 0700, true)) { throw new RuntimeException('PRODUCT_UPGRADE_WORKSPACE_INVALID'); }
            if (is_link($workspace) || realpath($workspace) !== $workspace) { throw new RuntimeException('PRODUCT_UPGRADE_WORKSPACE_INVALID'); }
            $runtimeDigest = productUpgradeFreezeRuntime($workspace);
            $plan = [
                'schema_version' => 2,
                'protocol' => 'peanut.product-upgrade-plan.v2',
                'candidate' => $scaffold['candidate'],
                'status' => $scaffold['status'],
                'instance_root' => $instanceRoot,
                'scope' => $scope,
                'backup_tool' => $backupTool,
                'workspace' => $workspace,
                'runtime_sha256' => $runtimeDigest,
                'inputs_sha256' => hash_file('sha256', $workspace . '/plan.json'),
                'package' => $packageIdentity,
                'edition' => $edition,
                'state_path' => $statePath,
                'migration' => [
                    'target_version' => $packageIdentity['target_version'],
                    'files' => $migrationFiles,
                    'execution' => 'bound-prepared-target-container',
                    'module_reconcile' => 'release-locked-before-switch',
                    'module_preflight_protocol' => 'peanut.upgrade-module-preflight.v1',
                    'recovery' => 'paired-database-public-private-storage-backup',
                ],
                'phase_contract' => [
                    'prepare_target', 'migration_preflight', 'backup_and_hold_writers', 'verify_quiescence',
                    'apply_managed_files', 'application_and_module_migrations', 'switch_target',
                    'reload_safe_without_public_writers', 'migration_verify', 'runtime_and_business_health',
                    'activate_public_writers', 'complete',
                ],
                'created_at' => gmdate(DATE_ATOM),
            ];
            $plan['plan_sha256'] = 'sha256:' . hash('sha256', productUpgradeCanonicalJson($plan));
            $path = $instanceRoot . '/.peanut/upgrades/product-plans/' . $plan['candidate'] . '.json';
            productUpgradeWriteJson($path, $plan);
            productUpgradeWriteJson($workspace . '/product-binding.json', ['plan_path' => $path, 'plan_sha256' => $plan['plan_sha256']]);
            productUpgradeWriteState($statePath, [
                'schema_version' => 1,
                'protocol' => 'peanut.product-upgrade-state.v1',
                'candidate' => $plan['candidate'],
                'plan_sha256' => $plan['plan_sha256'],
                'package' => $plan['package'],
                'phase' => $plan['status'] === 'ready' ? 'planned' : 'blocked',
                'phase_in_progress' => null,
                'database_recovery_required' => false,
                'migration_completed' => false,
                'activation_started' => false,
                'evidence' => [],
                'created_at' => gmdate(DATE_ATOM),
            ]);
            $result = $plan + ['plan_path' => $path, 'authenticated' => true];
        }
    } else {
        $plan = productUpgradeReadPlan($instanceRoot, $options['plan']);
        if (($plan['package']['root'] ?? null) !== $packageRoot
            || !is_array($plan['migration']['files'] ?? null)) {
            throw new RuntimeException('PRODUCT_UPGRADE_PLAN_REBIND_FAILED');
        }
        $state = productUpgradeReadState($plan);
        if (($plan['scope'] ?? null) !== 'server') { throw new RuntimeException('PRODUCT_UPGRADE_SCOPE_REBIND_FAILED'); }
        if ($command !== 'recover') {
            if (($plan['migration']['module_preflight_protocol'] ?? null) !== 'peanut.upgrade-module-preflight.v1') {
                throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_CAPABILITY_REQUIRED');
            }
            if (isset($state['evidence']['migration-preflight'])) {
                productUpgradeAssertModulePreflight($plan, $state['evidence']['migration-preflight']['payload'] ?? []);
            } elseif ($command === 'verify') {
                throw new RuntimeException('PRODUCT_UPGRADE_MODULE_PREFLIGHT_REQUIRED');
            }
        }
        if ($command === 'apply') {
            if ($plan['status'] !== 'ready' || $state['phase'] === 'blocked') {
                throw new RuntimeException('PRODUCT_UPGRADE_PLAN_BLOCKED');
            }
            if ($state['phase'] === 'recovered') {
                throw new RuntimeException('PRODUCT_UPGRADE_RECOVERED_PLAN_FINAL');
            }
            // 已进入恢复方向的计划只能完成恢复；不能复用旧阶段回执重新切换/开放写入。
            if ($state['phase'] === 'recovering' || array_key_exists('recovery_context', $state)) {
                throw new RuntimeException('PRODUCT_UPGRADE_RECOVERY_IN_PROGRESS');
            }
            $stopBefore = $options['stop-before'] ?? null;
            if ($stopBefore !== null && ($state['activation_started']
                || $state['phase_in_progress'] === 'activate' || isset($state['evidence']['activate'])
                || in_array($state['phase'], ['activating', 'completed'], true)
                || ($stopBefore === 'health' && ($state['phase_in_progress'] === 'health'
                    || isset($state['evidence']['health']) || $state['phase'] === 'healthy')))) {
                throw new RuntimeException('PRODUCT_UPGRADE_STOP_BOUNDARY_PASSED:' . $stopBefore);
            }
            productUpgradeServerPackage($instanceRoot, $packageRoot, null, null);
            if ($state['phase'] === 'completed') {
                // 重复apply也必须验证原完成结果，不能仅凭Host健康回执忽略源码/定制漂移。
                productUpgradeCode('verify', $plan);
                $state = productUpgradeRefreshHostPhase($packageRoot, $plan, $state, 'migration-verify');
                $state = productUpgradeRefreshHostPhase($packageRoot, $plan, $state, 'health');
                $result = [
                    'status' => 'completed', 'candidate' => $plan['candidate'], 'phase' => 'completed',
                    'plan_sha256' => $plan['plan_sha256'], 'idempotent' => true,
                    'state_sha256' => $state['state_sha256'],
                    'health_evidence_sha256' => $state['evidence']['health']['sha256'],
                    'activation_evidence_sha256' => $state['evidence']['activate']['sha256'],
                ];
            } else {
                $state = productUpgradeEnsureHostPhase($packageRoot, $plan, $state, 'prepare', 'prepared');
                $state = productUpgradeEnsureHostPhase($packageRoot, $plan, $state, 'migration-preflight', 'migration_preflight_complete');
                $state = productUpgradeEnsureHostPhase($packageRoot, $plan, $state, 'backup', 'backed_up');
                $state = productUpgradeEnsureHostPhase($packageRoot, $plan, $state, 'quiesce', 'quiesced');

                if (!isset($state['evidence']['managed_files'])) {
                    $state['phase_in_progress'] = 'managed_files';
                    $state = productUpgradeWriteState((string) $state['absolute_path'], $state);
                    $code = productUpgradeCode('apply', $plan);
                    $codeEvidence = [
                        'protocol' => 'peanut.product-upgrade-internal-evidence.v1', 'phase' => 'managed_files',
                        'candidate' => $plan['candidate'], 'payload' => $code,
                    ];
                    $state = productUpgradeCompleteHostPhase($state, (string) $state['absolute_path'], 'managed_files', 'managed_files_applied', [
                        'sha256' => 'sha256:' . hash('sha256', productUpgradeCanonicalJson($codeEvidence)),
                        'payload' => $codeEvidence,
                    ]);
                }

                if (!isset($state['evidence']['migrate'])) {
                    // This flag is persisted before both application SQL and Module reconciliation.
                    // Once true, recovery always restores the exact paired backup.
                    $state['phase'] = 'migrations_started';
                    $state['phase_in_progress'] = 'migrate';
                    $state['database_recovery_required'] = true;
                    $state = productUpgradeWriteState((string) $state['absolute_path'], $state);
                    $migrationEvidence = productUpgradeHostPhase($packageRoot, 'migrate', $plan, $state);
                    $state['migration_completed'] = true;
                    $state = productUpgradeCompleteHostPhase($state, (string) $state['absolute_path'], 'migrate', 'migrations_applied', $migrationEvidence);
                }

                $state = productUpgradeEnsureHostPhase($packageRoot, $plan, $state, 'switch', 'switched');
                $state = productUpgradeEnsureHostPhase($packageRoot, $plan, $state, 'reload-safe', 'reloaded_safe');
                $state = productUpgradeEnsureHostPhase($packageRoot, $plan, $state, 'migration-verify', 'migration_verified');
                if ($stopBefore !== 'health') {
                    $state = productUpgradeEnsureHostPhase($packageRoot, $plan, $state, 'health', 'healthy');
                    $code = productUpgradeCode('verify', $plan);
                }

                if ($stopBefore !== null) {
                    if ($state['phase'] !== ($stopBefore === 'health' ? 'migration_verified' : 'healthy')
                        || $state['phase_in_progress'] !== null || !$state['database_recovery_required']
                        || !$state['migration_completed'] || $state['activation_started']) {
                        throw new RuntimeException('PRODUCT_UPGRADE_STOP_STATE_INVALID:' . $stopBefore);
                    }
                    $result = [
                        'status' => 'paused', 'stop_before' => $stopBefore, 'candidate' => $plan['candidate'],
                        'phase' => $state['phase'], 'plan_sha256' => $plan['plan_sha256'],
                        'state_sha256' => $state['state_sha256'],
                        'database_recovery_required' => $state['database_recovery_required'],
                        'activation_started' => $state['activation_started'],
                        'host_evidence' => array_map(static fn(array $entry): string => $entry['sha256'], $state['evidence']),
                    ];
                    if ($stopBefore === 'activate') {
                        $result['code'] = $code;
                        $result['health_evidence_sha256'] = $state['evidence']['health']['sha256'];
                    }
                } else {
                    if (!isset($state['evidence']['activate'])) {
                        // Opening traffic is the irreversible recovery boundary. Persist it before
                        // the driver can start any public writer. Thereafter only forward repair is safe.
                        $state['phase'] = 'activating';
                        $state['phase_in_progress'] = 'activate';
                        $state['activation_started'] = true;
                        $state = productUpgradeWriteState((string) $state['absolute_path'], $state);
                        $activation = productUpgradeHostPhase($packageRoot, 'activate', $plan, $state);
                        $state = productUpgradeCompleteHostPhase($state, (string) $state['absolute_path'], 'activate', 'completed', $activation);
                    }
                    $state['completed_at'] ??= gmdate(DATE_ATOM);
                    $state = productUpgradeWriteState((string) $state['absolute_path'], $state);
                    $result = [
                        'status' => 'completed', 'candidate' => $plan['candidate'], 'phase' => 'completed',
                        'plan_sha256' => $plan['plan_sha256'], 'idempotent' => false, 'code' => $code,
                        'state_sha256' => $state['state_sha256'],
                        'host_evidence' => array_map(static fn(array $entry): string => $entry['sha256'], $state['evidence']),
                        'health_evidence_sha256' => $state['evidence']['health']['sha256'],
                        'activation_evidence_sha256' => $state['evidence']['activate']['sha256'],
                    ];
                }
            }
        } elseif ($command === 'verify') {
            productUpgradeServerPackage($instanceRoot, $packageRoot, null, null);
            if ($state['phase'] !== 'completed') {
                throw new RuntimeException('PRODUCT_UPGRADE_NOT_COMPLETED:' . $state['phase']);
            }
            $code = productUpgradeCode('verify', $plan);
            $state = productUpgradeRefreshHostPhase($packageRoot, $plan, $state, 'migration-verify');
            $state = productUpgradeRefreshHostPhase($packageRoot, $plan, $state, 'health');
            $state['verified_at'] = gmdate(DATE_ATOM);
            $state = productUpgradeWriteState((string) $state['absolute_path'], $state);
            $result = [
                'status' => 'verified', 'candidate' => $plan['candidate'], 'code' => $code,
                'health_evidence_sha256' => $state['evidence']['health']['sha256'],
                'migration_evidence_sha256' => $state['evidence']['migration-verify']['sha256'],
                'state_sha256' => $state['state_sha256'],
            ];
        } else {
            productUpgradeServerPackage($instanceRoot, $packageRoot, null, null);
            if ($state['phase'] === 'completed') {
                throw new RuntimeException('PRODUCT_UPGRADE_COMPLETED_RECOVERY_REQUIRES_NEW_CHANGE_PLAN');
            }
            if ($state['activation_started']) {
                throw new RuntimeException('PRODUCT_UPGRADE_ACTIVATION_STARTED_FORWARD_REPAIR_REQUIRED');
            }
            if ($state['phase'] === 'recovered') {
                $context = $state['recovery_context'] ?? null;
                if (!is_array($context) || !is_bool($context['managed_files_started'] ?? null)
                    || !isset($state['evidence']['recover'], $state['evidence']['resume-old'])) {
                    throw new RuntimeException('PRODUCT_UPGRADE_RECOVERY_STATE_INVALID');
                }
                $code = $context['managed_files_started']
                    ? productUpgradeCode('verifyRecovery', $plan)
                    : null;
                $state = productUpgradeRefreshHostPhase($packageRoot, $plan, $state, 'recovery-verify');
                $result = [
                    'status' => 'recovered', 'candidate' => $plan['candidate'],
                    'code' => $code,
                    'database_recovery_required' => $state['database_recovery_required'],
                    'recovery_evidence_sha256' => $state['evidence']['recover']['sha256'],
                    'resume_evidence_sha256' => $state['evidence']['resume-old']['sha256'],
                    'state_sha256' => $state['state_sha256'], 'idempotent' => true,
                ];
            } else {
                $context = $state['recovery_context'] ?? null;
                if (!is_array($context)) {
                    $managedFilesStarted = isset($state['evidence']['managed_files'])
                        || $state['phase_in_progress'] === 'managed_files'
                        || in_array($state['phase'], [
                            'managed_files_applied', 'migrations_started', 'migrations_applied', 'switched',
                            'reloaded_safe', 'migration_verified', 'healthy',
                        ], true);
                    $context = [
                        'managed_files_started' => $managedFilesStarted,
                        'original_phase' => $state['phase'],
                        'original_phase_in_progress' => $state['phase_in_progress'],
                    ];
                    $state['recovery_context'] = $context;
                    $state['phase'] = 'recovering';
                    $state['phase_in_progress'] = 'recover';
                    $state = productUpgradeWriteState((string) $state['absolute_path'], $state);
                }
                if (!isset($state['evidence']['recover'])) {
                    $recovery = productUpgradeHostPhase($packageRoot, 'recover', $plan, $state);
                    $state = productUpgradeCompleteHostPhase($state, (string) $state['absolute_path'], 'recover', 'recovering', $recovery);
                }
                $code = $context['managed_files_started']
                    ? productUpgradeCode('recover', $plan)
                    : null;
                if (!isset($state['evidence']['resume-old'])) {
                    $state = productUpgradeEnsureHostPhase($packageRoot, $plan, $state, 'resume-old', 'recovered');
                }
                $state['recovered_at'] ??= gmdate(DATE_ATOM);
                $state = productUpgradeWriteState((string) $state['absolute_path'], $state);
                $result = [
                    'status' => 'recovered', 'candidate' => $plan['candidate'], 'code' => $code,
                    'database_recovery_required' => $state['database_recovery_required'],
                    'recovery_evidence_sha256' => $state['evidence']['recover']['sha256'],
                    'resume_evidence_sha256' => $state['evidence']['resume-old']['sha256'],
                    'state_sha256' => $state['state_sha256'], 'idempotent' => false,
                ];
            }
        }
    }

    productUpgradeReleaseLock($lock);
    $lock = null;
    fwrite(STDOUT, json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n");
    exit(($result['status'] ?? null) === 'blocked' ? 2 : 0);
} catch (Throwable $exception) {
    if (is_resource($lock)) {
        productUpgradeReleaseLock($lock);
    }
    fwrite(STDERR, json_encode([
        'status' => 'error', 'error' => $exception->getMessage(),
    ], JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n");
    exit(1);
}
