#!/usr/bin/env python3
"""Reject ambient Peanut Admin configuration sources in active production code."""

from __future__ import annotations

import re
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
SKIP_PARTS = {"node_modules", "vendor", "tests", "fixtures"}
SKIP_PREFIXES = ("scaffold/releases/", "docs/maintenance/", "docs/product-status/audits/")
SOURCE_SUFFIXES = {".php", ".py", ".sh", ".ts", ".js", ".mjs", ".yml", ".yaml"}


def active_sources() -> list[Path]:
    roots = ["scripts", "server", "web/config", "platform", "pc", "uniapp", "deploy", ".github/workflows"]
    files: list[Path] = []
    for root in roots:
        for path in (ROOT / root).rglob("*"):
            relative = path.relative_to(ROOT).as_posix()
            script_without_suffix = relative.startswith("scripts/") and path.suffix == ""
            if not path.is_file() or (path.suffix not in SOURCE_SUFFIXES and not script_without_suffix):
                continue
            if any(part in SKIP_PARTS for part in path.relative_to(ROOT).parts) or relative.startswith(SKIP_PREFIXES):
                continue
            files.append(path)
    return sorted(set(files))


def backend_contract(errors: list[str]) -> None:
    loader = (ROOT / "server/bootstrap/environment.php").read_text(encoding="utf-8")
    block = loader.split("function peanutBackendEnvironmentKeys", 1)[1].split("];", 1)[0]
    loader_keys = set(re.findall(r"'([A-Z][A-Z0-9_]*)'", block))
    example_keys = {
        match.group(1)
        for line in (ROOT / "server/.env.example").read_text(encoding="utf-8").splitlines()
        if (match := re.match(r"^([A-Z][A-Z0-9_]*)=", line))
    }
    if loader_keys != example_keys:
        errors.append(
            "server/.env.example and peanutBackendEnvironmentKeys differ: "
            f"loader_only={sorted(loader_keys - example_keys)} example_only={sorted(example_keys - loader_keys)}"
        )
    transient = {"ADMIN_INITIAL_EMAIL", "ADMIN_INITIAL_PASSWORD", "PLATFORM_INITIAL_EMAIL", "PLATFORM_INITIAL_PASSWORD", "PEANUT_DEMO_TENANT_ID"}
    persisted = transient & example_keys
    if persisted:
        errors.append(f"transient installation keys are persisted in server/.env.example: {sorted(persisted)}")


def scan_sources(errors: list[str]) -> None:
    approved_runtime_consumers = {
        "server/database/environment-guard.php",
        "server/database/install.php",
        "server/database/seed-demo-data.php",
        "server/database/seed-multi-tenant-demo.php",
        "server/app/common/value/runtime/RuntimeNamespace.php",
        "server/app/common/services/installation/InstallationPreflightHost.php",
    }
    approved_projectors = {
        "scripts/client-environment.ts",
        "scripts/run-with-environment-file",
        "scripts/p0e-runtime-qualification",
        "scripts/consumer-module-reference-chain",
        "scripts/local-environment-probe",
        "scripts/generate-all-modules-packaging-evidence",
        "scripts/scaffold-upgrade",
        "scripts/run-php-test",
        "server/bootstrap/environment.php",
        "pc/nuxt.config.ts",
    }
    ambient = re.compile(r"process\.env(?:\.|\[)|os\.environ\.(?:copy|update|get)|\bgetenv\s*\(|\bputenv\s*\(")
    shell_fallback = re.compile(r"\$\{(?:PEANUT_|VITE_|NUXT_|DB_|ADMIN_|PLATFORM_|JWT_|COMPOSER_BINARY)[A-Z0-9_]*(?::-|-)" )
    for path in active_sources():
        relative = path.relative_to(ROOT).as_posix()
        if relative == "scripts/check-environment-sources":
            continue
        text = path.read_text(encoding="utf-8", errors="replace")
        if ambient.search(text) and relative not in approved_runtime_consumers | approved_projectors:
            errors.append(f"ambient configuration API outside an approved loader/consumer: {relative}")
        fallbacks = [match.group(0) for match in shell_fallback.finditer(text)]
        forbidden_fallbacks = [
            value for value in fallbacks
            if not value.startswith((
                "${PEANUT_SERVER_ENV_FILE",
                "${PEANUT_DEPLOYMENT_RECEIPT_BASE64",
                "${DB_ROOT_PASS",
            ))
        ]
        if forbidden_fallbacks:
            errors.append(f"ambient project fallback is forbidden: {relative}: {sorted(set(forbidden_fallbacks))}")
        if re.search(r"(?:^|\s)-(?:e|env)\s+(?:ADMIN_INITIAL_|PLATFORM_INITIAL_|PEANUT_DEMO_TENANT_ID)", text, re.MULTILINE):
            errors.append(f"transient identity is injected with a container environment option: {relative}")
        if "os.environ.copy()" in text or "os.environ.update(" in text:
            errors.append(f"whole parent environment inheritance is forbidden: {relative}")


def frontend_contract(errors: list[str]) -> None:
    required = [
        "web/.env.example", "web/.env.development", "web/.env.production",
        "web/.env.standalone", "web/.env.multi-tenant", "platform/.env.example",
        "platform/.env.production", "pc/.env.example", "pc/.env.production",
        "uniapp/.env.example", "uniapp/.env.production",
    ]
    for relative in required:
        if not (ROOT / relative).is_file():
            errors.append(f"managed client environment template is missing: {relative}")


def main() -> int:
    errors: list[str] = []
    backend_contract(errors)
    frontend_contract(errors)
    scan_sources(errors)
    if errors:
        for error in errors:
            print(f"environment-source-check: {error}", file=sys.stderr)
        return 1
    print("environment-source-check: active configuration sources are closed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
