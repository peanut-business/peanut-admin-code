#!/usr/bin/env python3
"""Print the no-resource CR03 legacy-Edition upgrade plan."""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import shlex
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
FIXTURE = ROOT / "server/tests/fixtures/consumer-upgrade-qualification/matrix.json"
REGISTRY = ROOT / "resources/project-resources.json"
VERSIONS = ROOT / "release-versions.json"
RESOURCE_ID = "peanut-admin-consumer-upgrade-mysql84-gate"
ADMIN_TOOL_ID = "peanut-admin-consumer-upgrade-mysql84-remote-admin-cli"
HTTP_RESOURCE_ID = "peanut-admin-local-production-preview-gateway"
LOCAL_STORAGE_RESOURCE_ID = "peanut-admin-consumer-upgrade-local-storage"
SEMVER = re.compile(r"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$")
CORE_WEB_PACKAGES = [
    "@peanut-admin/client", "@peanut-admin/vue", "@peanut-admin/ui-vue",
    "@peanut-admin/nuxt", "@peanut-admin/uniapp", "@peanut-admin/testing",
]
ENV_RUNNER = ROOT / "scripts/run-with-environment-file"

class PlanError(RuntimeError):
    pass

def read_json(path: Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise PlanError(f"cannot read {path.relative_to(ROOT)}: {error}") from error
    if not isinstance(value, dict):
        raise PlanError(f"{path.relative_to(ROOT)} must have an object root")
    return value

def git(*arguments: str) -> str:
    result = subprocess.run(["git", *arguments], cwd=ROOT, text=True, capture_output=True, check=False)
    if result.returncode:
        raise PlanError((result.stderr or result.stdout).strip())
    return result.stdout.strip()

def safe_path(value: str, label: str, expected: Path) -> Path:
    path = Path(value)
    if not path.is_absolute() or path != expected or path.exists() or path.is_symlink():
        raise PlanError(f"{label} must be the absent fixed CR03 path: {expected}")
    try:
        if path.parent.resolve(strict=True) != expected.parent.resolve(strict=True):
            raise PlanError(f"{label} parent escapes its fixed CR03 root")
    except OSError as error:
        raise PlanError(f"{label} parent is unavailable: {error}") from error
    return path

def unique_resource(items: object, resource_id: str, label: str) -> dict:
    matches = [item for item in items if isinstance(item, dict) and item.get("stable_resource_id") == resource_id] if isinstance(items, list) else []
    if len(matches) != 1:
        raise PlanError(f"registry must contain exactly one {label} {resource_id}")
    return matches[0]


def current_version_contract(versions: dict, target_version: object) -> bool:
    if (
        versions.get("schema_version") != 3
        or versions.get("protocol") != "peanut.release-versions.v3"
        or versions.get("instance_version") is not None
        or not isinstance(target_version, str)
        or SEMVER.fullmatch(target_version) is None
        or versions.get("source_product_version") != target_version
        or versions.get("scaffold_template") != target_version
    ):
        return False
    php = versions.get("core_php")
    web = versions.get("core_web")
    if (
        not isinstance(php, dict)
        or list(php) != ["package", "constraint", "resolved_version", "source_type", "source_url", "source_reference"]
        or php.get("package") != "peanut-admin/core"
        or re.fullmatch(r"dev-[A-Za-z0-9._-]+", str(php.get("constraint", ""))) is None
        or not str(php.get("resolved_version", "")).startswith("dev-")
        or php.get("source_type") != "git"
        or not str(php.get("source_url", "")).startswith("https://")
        or re.fullmatch(r"[0-9a-f]{40}", str(php.get("source_reference", ""))) is None
        or php.get("constraint") != php.get("resolved_version")
        or not isinstance(web, dict)
        or list(web) != ["source_type", "source_url", "source_reference", "packages"]
        or web.get("source_type") != "git"
        or not str(web.get("source_url", "")).startswith("https://")
        or re.fullmatch(r"[0-9a-f]{40}", str(web.get("source_reference", ""))) is None
    ):
        return False
    packages = web.get("packages")
    if not isinstance(packages, dict) or list(packages) != CORE_WEB_PACKAGES:
        return False
    for identity in packages.values():
        if not isinstance(identity, dict) or list(identity) != ["version", "archive", "sha256"]:
            return False
        archive = identity.get("archive")
        digest = identity.get("sha256")
        if (
            not isinstance(identity.get("version"), str)
            or SEMVER.fullmatch(identity["version"]) is None
            or not isinstance(archive, str)
            or re.fullmatch(r"packages/core-web/peanut-admin-[a-z-]+-[0-9A-Za-z.+-]+\.tgz", archive) is None
            or not isinstance(digest, str)
            or re.fullmatch(r"[0-9a-f]{64}", digest) is None
        ):
            return False
        path = ROOT / archive
        if not path.is_file() or path.is_symlink() or hashlib.sha256(path.read_bytes()).hexdigest() != digest:
            return False
    return True


def remote_container_command(script: str, *, receives_stdin: bool = False) -> list[str]:
    docker = ["/usr/local/bin/docker", "exec"]
    if receives_stdin:
        docker.append("-i")
    docker.extend(["peanut-admin-mysql84-development", "/bin/sh", "-lc", script])
    remote = shlex.join(docker)
    if shlex.split(remote) != docker:
        raise PlanError("remote database command quote round-trip is invalid")
    return ["/usr/bin/ssh", "-o", "BatchMode=yes", "mac-14", remote]

def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("plan", nargs="?", choices=["plan"])
    parser.add_argument("--candidate", required=True)
    parser.add_argument("--run-id", required=True)
    parser.add_argument("--lease", required=True)
    parser.add_argument("--output-dir", required=True)
    parser.add_argument("--cache-dir", required=True)
    args = parser.parse_args()
    if not re.fullmatch(r"[a-z0-9]{1,11}", args.run_id):
        raise PlanError("run_id must match ^[a-z0-9]{1,11}$")
    if args.lease != f"consumer-upgrade-{args.run_id}":
        raise PlanError("lease must equal consumer-upgrade-<exact run_id>")
    if not re.fullmatch(r"[0-9a-f]{40}", args.candidate):
        raise PlanError("candidate must be an exact lowercase 40-hex commit")
    candidate = git("rev-parse", f"{args.candidate}^{{commit}}")
    if candidate != args.candidate or git("rev-parse", "HEAD") != candidate:
        raise PlanError("candidate must be the checked-out exact HEAD")
    if git("status", "--porcelain=v1", "--untracked-files=all"):
        raise PlanError("candidate worktree must be clean")
    fixture, registry, versions = read_json(FIXTURE), read_json(REGISTRY), read_json(VERSIONS)
    target_version = versions.get("scaffold_template")
    historical_v2 = (
        versions.get("schema_version") == 2
        and versions.get("protocol") == "peanut.release-versions.v2"
        and versions.get("instance_version") is None
        and isinstance(target_version, str)
        and re.fullmatch(r"(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)", target_version)
        and all(versions.get(field) == target_version for field in ("source_product_version", "core_php", "core_web"))
    )
    if not historical_v2 and not current_version_contract(versions, target_version):
        raise PlanError("candidate release version contract is invalid")
    databases = registry.get("resources", {}).get("databases", [])
    resource = unique_resource(databases, RESOURCE_ID, "database")
    admin_tool = unique_resource(registry.get("resources", {}).get("tooling", []), ADMIN_TOOL_ID, "tool")
    http_resource = unique_resource(registry.get("resources", {}).get("local_listeners", []), HTTP_RESOURCE_ID, "listener")
    object_storage = registry.get("resources", {}).get("object_storage", {})
    local_storage = unique_resource(object_storage.get("resources", []) if isinstance(object_storage, dict) else [], LOCAL_STORAGE_RESOURCE_ID, "object storage")
    expected = {"database": "peanut_admin_development_cr03_<run_id>_<scenario>", "namespace": "peanut_admin_development_cr03_<run_id>_", "allowed_scenarios": ["standalone_upgrade", "multi_tenant_upgrade"], "fallback": "none", "lifecycle": "ephemeral", "qualification_gate": "consumer-upgrade-qualification", "deployment_target": "local-development", "application_runtime": False}
    if resource.get("stable_resource_id") != RESOURCE_ID or any(resource.get(key) != value for key, value in expected.items()):
        raise PlanError("consumer-upgrade resource contract is invalid")
    if resource.get("administrative_tooling_resource_id") != ADMIN_TOOL_ID or resource.get("http_listener_resource_id") != HTTP_RESOURCE_ID or resource.get("local_object_storage_resource_id") != LOCAL_STORAGE_RESOURCE_ID:
        raise PlanError("consumer-upgrade outer resource bindings are invalid")
    if admin_tool.get("mysql_command") != "/usr/bin/mysql" or admin_tool.get("mysqldump_command") != "/usr/bin/mysqldump" or admin_tool.get("database_name_pattern") != r"^peanut_admin_development_cr03_[a-z0-9]{1,11}_(standalone_upgrade|multi_tenant_upgrade)$" or "generic database runners are forbidden" not in str(admin_tool.get("fallback")):
        raise PlanError("consumer-upgrade exact administrative tooling is invalid")
    if http_resource.get("host") != "127.0.0.1" or http_resource.get("port") != 20190 or http_resource.get("fallback") != "none":
        raise PlanError("consumer-upgrade HTTP 20190 resource is invalid")
    if local_storage.get("namespace") != "<instance-root>/server/private/storage with object prefix cr03/<run_id>/<scenario>/" or local_storage.get("fallback") != "none; another worktree, persistent storage root or cloud provider is forbidden":
        raise PlanError("consumer-upgrade Local storage resource is invalid")
    scenarios = fixture.get("scenarios")
    target = fixture.get("target_release", {})
    if fixture.get("schema_version") != 1 or fixture.get("gate") != "consumer-upgrade-qualification" or fixture.get("database_resource", {}).get("stable_resource_id") != RESOURCE_ID or not isinstance(scenarios, dict) or list(scenarios) != resource["allowed_scenarios"]:
        raise PlanError("consumer-upgrade fixture does not match the registered resource")
    outer = fixture.get("outer_resources", {})
    if outer != {"administrative_tooling_resource_id": ADMIN_TOOL_ID, "http_listener_resource_id": HTTP_RESOURCE_ID, "http_port": 20190, "local_object_storage_resource_id": LOCAL_STORAGE_RESOURCE_ID, "local_object_prefix_template": "cr03/<run_id>/<scenario>/", "execution_order": "serial-by-scenario"}:
        raise PlanError("consumer-upgrade fixture outer resource plan is invalid")
    source_version = fixture.get("source_release", {}).get("version")
    if source_version != "3.0.14" or target.get("version") != target_version or target.get("minimum_source_version") != source_version or target.get("signing_resource_id") != "peanut-admin-edition-upgrade-release-signing-key" or target.get("signature_key_id") != "peanut-admin-release-2026-01":
        raise PlanError("formal source, target, or signing contract is invalid")
    for edition in ("standalone", "multi_tenant"):
        asset = fixture["source_release"].get("editions", {}).get(edition, {})
        if not isinstance(asset.get("installer"), str) or not re.fullmatch(r"[0-9a-f]{64}", str(asset.get("installer_sha256"))) or not re.fullmatch(r"[0-9a-f]{64}", str(asset.get("manifest_sha256"))):
            raise PlanError(f"{edition} formal source asset contract is invalid")
    output = safe_path(args.output_dir, "output-dir", ROOT / "output" / f"cr03-upgrade-{args.run_id}")
    cache = safe_path(args.cache_dir, "cache-dir", Path.home() / ".cache/peanut-admin" / f"cr03-upgrade-{args.run_id}")
    names = {scenario: resource["database"].replace("<run_id>", args.run_id).replace("<scenario>", scenario) for scenario in scenarios}
    if any(len(name) > resource.get("database_name_max_length", 0) for name in names.values()):
        raise PlanError("generated database name exceeds the registered maximum")
    for scenario, data in scenarios.items():
        expected_edition = "multi-tenant" if scenario == "multi_tenant_upgrade" else "standalone"
        if data.get("edition") != expected_edition or not data.get("inputs") or not data.get("assertions"):
            raise PlanError(f"{scenario} edition, input, or assertion contract is invalid")
    instance_roots = {scenario: cache / "instances" / scenario for scenario in scenarios}
    backup_roots = {scenario: cache / "backups" / scenario for scenario in scenarios}
    object_prefixes = {scenario: f"cr03/{args.run_id}/{scenario}/" for scenario in scenarios}
    trusted_keys_environment = cache / "trusted-upgrade-keys.env"
    outer_guard_environment_files = {
        scenario: ROOT / "server" / f".env.cr03-{args.run_id}-{scenario.replace('_', '-')}"
        for scenario in scenarios
    }
    if any(path.exists() or path.is_symlink() for path in [*instance_roots.values(), *backup_roots.values(), *outer_guard_environment_files.values()]):
        raise PlanError("instance, backup, or environment path already exists for this run_id")
    tree = git("rev-parse", f"{candidate}^{{tree}}")
    proof_dir = Path(git("rev-parse", "--git-common-dir"))
    if not proof_dir.is_absolute():
        proof_dir = ROOT / proof_dir
    proof_dir = proof_dir.resolve() / "peanut-admin-resource-leases" / "leases" / args.lease
    resources = [
        {"type": "resource-id", "value": RESOURCE_ID}, {"type": "environment", "value": "development"},
        {"type": "deployment-target", "value": "local-development"}, {"type": "consumer", "value": "host"},
        {"type": "endpoint", "value": "192.168.192.2:20183"}, {"type": "run-id", "value": args.run_id},
        {"type": "candidate-tree", "value": tree}, *({"type": "mysql-db", "value": name} for name in names.values()),
        *({"type": "instance-root", "value": str(path)} for path in instance_roots.values()),
        *({"type": "backup-root", "value": str(path)} for path in backup_roots.values()),
        {"type": "tooling-resource-id", "value": ADMIN_TOOL_ID},
        {"type": "listener-resource-id", "value": HTTP_RESOURCE_ID},
        {"type": "object-storage-resource-id", "value": LOCAL_STORAGE_RESOURCE_ID},
        *({"type": "object-prefix", "value": value} for value in object_prefixes.values()),
        {"type": "environment-file", "value": str(trusted_keys_environment)},
        *({"type": "environment-file", "value": str(path)} for path in outer_guard_environment_files.values()),
        *(
            {"type": "environment-file", "value": str(instance / "server" / name)}
            for instance in instance_roots.values()
            for name in (".env.consumer-upgrade", ".env.local-production-preview", ".env.installation")
        ),
        {"type": "port", "value": "20190"}, {"type": "http-port", "value": "20190"},
        {"type": "cache-dir", "value": str(cache)}, {"type": "output-dir", "value": str(output)},
        {"type": "lease-proof-dir", "value": str(proof_dir)},
    ]
    operation_plans = {}
    for scenario, data in scenarios.items():
        database = names[scenario]
        instance = instance_roots[scenario]
        backup = backup_roots[scenario]
        package = f"<exact-signed-{target_version}-{data['edition']}-package>"
        upgrader = f"{package}/scripts/upgrade"
        adoption_tool = f"{package}/scripts/scaffold-upgrade"
        adoption_plan = instance / ".peanut/upgrades/plans/<adoption-plan_path-from-stdout>"
        upgrade_plan = instance / ".peanut/upgrades/product-plans/<product-plan_path-from-stdout>"
        instance_environment_values = {
            "APP_ENV": "development", "PEANUT_DEPLOYMENT_TARGET": "local-development",
            "PEANUT_DATABASE_RESOURCE_ID": f"peanut-admin-cr03-{args.run_id}-{scenario}-mysql84",
            "PEANUT_DATABASE_CONSUMER": "host", "PEANUT_DATABASE_ENDPOINT_ID": f"peanut-admin-cr03-{args.run_id}-{scenario}-mysql84-host",
            "DB_HOST": "192.168.192.2", "DB_PORT": "20183", "DB_NAME": database,
            "DEPLOYMENT_MODE": data["edition"],
        }
        outer_guard_environment_values = {
            "APP_ENV": "development", "PEANUT_DEPLOYMENT_TARGET": "local-development",
            "PEANUT_DATABASE_RESOURCE_ID": RESOURCE_ID, "PEANUT_DATABASE_CONSUMER": "host",
            "PEANUT_DATABASE_ENDPOINT_ID": "peanut-admin-consumer-upgrade-mysql84-gate-host-direct",
            "DB_HOST": "192.168.192.2", "DB_PORT": "20183", "DB_NAME": database,
            "DEPLOYMENT_MODE": data["edition"], "PEANUT_RESOURCE_LEASE_PROOF": str(proof_dir),
        }
        host_environment_file = instance / "server/.env.consumer-upgrade"
        container_environment_file = instance / "server/.env.local-production-preview"
        installation_environment_file = instance / "server/.env.installation"
        outer_guard_environment_file = outer_guard_environment_files[scenario]
        instance_database_resource = {
            "stable_resource_id": instance_environment_values["PEANUT_DATABASE_RESOURCE_ID"],
            "purpose": f"CR03 {scenario} generated instance database",
            "environments": ["development", "local-production-preview"], "owner": "active CR03 consumer-upgrade lease owner",
            "service_type": "mysql", "version": "8.4.10", "database": database, "schema": "pa_ table prefix", "namespace": database,
            "upstream_endpoint": {"endpoint_id": instance_environment_values["PEANUT_DATABASE_ENDPOINT_ID"], "host": "192.168.192.2", "port": 20183, "consumers": ["host"], "network_scope": "private direct-link LAN"},
            "container_endpoint": {"endpoint_id": f"peanut-admin-cr03-{args.run_id}-{scenario}-mysql84-container", "host": "192.168.192.2", "port": 20183, "consumers": ["container"], "network_scope": "Docker Desktop direct route to private direct-link LAN"},
            "credential_ref": "mac-14:/Users/xing/.config/peanut-admin/development-db.env", "data_source": f"lease-owned synthetic formal-v{source_version} Edition instance",
            "freshness_requirement": "exact database is absent before installation and remains bound to this scenario until cleanup", "health_check": "credential-backed ping, SELECT DATABASE(), then instance environment-guard.php --current",
            "fallback": "none", "lifecycle": "single fixed-candidate CR03 scenario", "cleanup_responsibility": "active CR03 lease owner drops only this exact database after evidence capture", "backup_responsibility": f"exact dump under {backup}",
        }
        operation_plans[scenario] = {
            "serial_http_order": list(scenarios).index(scenario) + 1,
            "instance_root": str(instance), "database": database, "local_object_prefix": object_prefixes[scenario],
            "instance_database_resource": instance_database_resource,
            "outer_source_guard": {
                "cwd": str(ROOT),
                "environment_file": {
                    "path": str(outer_guard_environment_file),
                    "mode": "0600",
                    "non_secret_values": outer_guard_environment_values,
                    "required_secret_keys": ["DB_USER", "DB_PASS"],
                },
                "credential_ref": resource["credential_ref"],
                "argv": [str(ENV_RUNNER), "--env-file", str(outer_guard_environment_file), "--as-selector", "PEANUT_SERVER_ENV_FILE", "--", "/opt/homebrew/bin/php", "-r", f"require {json.dumps(str(ROOT / 'server/database/environment-guard.php'))}; guardedDatabaseConfig();"],
                "must_run": "immediately before every database create/dump/restore/drop command; failure stops the scenario",
            },
            "host_install_environment_file": {
                "path": str(host_environment_file),
                "mode": "0600",
                "non_secret_values": instance_environment_values,
                "required_secret_keys": ["DB_USER", "DB_PASS", "JWT_SECRET", "TENANT_IDENTIFIER_HMAC_KEY", "PLATFORM_IDENTIFIER_HMAC_KEY"],
            },
            "container_runtime_environment_file": {
                "path": str(container_environment_file),
                "mode": "0600",
                "non_secret_values": {**instance_environment_values, "APP_ENV": "production", "PEANUT_DEPLOYMENT_TARGET": "local-production-preview", "PEANUT_DATABASE_CONSUMER": "container", "PEANUT_DATABASE_ENDPOINT_ID": instance_database_resource["container_endpoint"]["endpoint_id"]},
                "required_secret_keys": ["DB_USER", "DB_PASS", "JWT_SECRET", "TENANT_IDENTIFIER_HMAC_KEY", "PLATFORM_IDENTIFIER_HMAC_KEY"],
            },
            "trusted_upgrade_keys_environment_file": {
                "path": str(trusted_keys_environment),
                "mode": "0600",
                "allowed_keys": ["PEANUT_UPGRADE_TRUSTED_KEYS_JSON"],
                "credential_ref": "UPGRADE_TRUSTED_KEYS.json from the exact candidate release",
            },
            "installation_environment_file": {
                "path": str(installation_environment_file),
                "mode": "0600",
                "allowed_keys": ["ADMIN_INITIAL_EMAIL", "ADMIN_INITIAL_PASSWORD", "PLATFORM_INITIAL_EMAIL", "PLATFORM_INITIAL_PASSWORD"],
                "lifecycle": "single source-instance installation; remove on success or failure",
            },
            "database_commands": {
                "create": remote_container_command(f"MYSQL_PWD=\"$MYSQL_ROOT_PASSWORD\" exec /usr/bin/mysql -uroot -e 'CREATE DATABASE `{database}` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci'"),
                "dump": {"command": remote_container_command(f"MYSQL_PWD=\"$MYSQL_ROOT_PASSWORD\" exec /usr/bin/mysqldump --single-transaction --quick --routines --events --triggers --hex-blob --set-gtid-purged=OFF -uroot {database}"), "stdout_file": str(backup / "database.sql")},
                "restore": {"command": remote_container_command(f"MYSQL_PWD=\"$MYSQL_ROOT_PASSWORD\" exec /usr/bin/mysql -uroot {database}", receives_stdin=True), "stdin_file": str(backup / "database.sql")},
                "drop_after_evidence": remote_container_command(f"MYSQL_PWD=\"$MYSQL_ROOT_PASSWORD\" exec /usr/bin/mysql -uroot -e 'DROP DATABASE `{database}`'"),
            },
            "dependency_commands": [
                [str(ENV_RUNNER), "--env-file", str(host_environment_file), "--clean-only", "--", "/usr/local/bin/composer", "install", f"--working-dir={instance / 'server'}", "--no-interaction", "--no-dev", "--optimize-autoloader"],
                [str(ENV_RUNNER), "--env-file", str(host_environment_file), "--clean-only", "--", "/Users/xing/.nvm/versions/node/v24.13.0/bin/npm", "ci", "--prefix", str(instance / "platform")],
                [str(ENV_RUNNER), "--env-file", str(host_environment_file), "--clean-only", "--", "/Users/xing/.nvm/versions/node/v24.13.0/bin/npm", "ci", "--prefix", str(instance / "pc")],
                [str(ENV_RUNNER), "--env-file", str(host_environment_file), "--clean-only", "--", "/Users/xing/.nvm/versions/node/v24.13.0/bin/npm", "ci", "--prefix", str(instance / "uniapp")],
                [str(ENV_RUNNER), "--env-file", str(host_environment_file), "--clean-only", "--", "/Users/xing/.nvm/versions/node/v24.13.0/bin/corepack", "pnpm", "--dir", str(instance / "web"), "install", "--frozen-lockfile"],
                [str(ENV_RUNNER), "--env-file", str(host_environment_file), "--clean-only", "--", "/Users/xing/.nvm/versions/node/v24.13.0/bin/corepack", "pnpm", "--dir", str(instance / "docs-site"), "install", "--frozen-lockfile"],
            ],
            "upgrade_commands": [
                ["/opt/homebrew/bin/php", adoption_tool, "adoption-plan", f"--project-root={instance}", f"--package={package}", "--signature-key-id=peanut-admin-release-2026-01", f"--env-file={trusted_keys_environment}"],
                ["/opt/homebrew/bin/php", adoption_tool, "adoption-apply", f"--project-root={instance}", f"--plan={adoption_plan}", "--confirm-plan-sha256=<adoption-plan_sha256-from-stdout>", "--confirm-paths=<exact-ordered-paths-from-stdout>", f"--env-file={trusted_keys_environment}"],
                ["/opt/homebrew/bin/php", adoption_tool, "adoption-recover", f"--project-root={instance}", f"--plan={adoption_plan}"],
                [str(ENV_RUNNER), "--env-file", str(host_environment_file), "--as-selector", "PEANUT_SERVER_ENV_FILE", "--", "/opt/homebrew/bin/php", upgrader, "plan", f"--instance-root={instance}", f"--package={package}", "--signature-key-id=peanut-admin-release-2026-01", f"--env-file={trusted_keys_environment}"],
                [str(ENV_RUNNER), "--env-file", str(host_environment_file), "--as-selector", "PEANUT_SERVER_ENV_FILE", "--", "/opt/homebrew/bin/php", upgrader, "apply", f"--instance-root={instance}", f"--package={package}", "--signature-key-id=peanut-admin-release-2026-01", f"--env-file={trusted_keys_environment}", f"--plan={upgrade_plan}"],
                [str(ENV_RUNNER), "--env-file", str(host_environment_file), "--as-selector", "PEANUT_SERVER_ENV_FILE", "--", "/opt/homebrew/bin/php", upgrader, "apply", f"--instance-root={instance}", f"--package={package}", "--signature-key-id=peanut-admin-release-2026-01", f"--env-file={trusted_keys_environment}", f"--plan={upgrade_plan}"],
                [str(ENV_RUNNER), "--env-file", str(host_environment_file), "--as-selector", "PEANUT_SERVER_ENV_FILE", "--", "/opt/homebrew/bin/php", upgrader, "verify", f"--instance-root={instance}", f"--package={package}", "--signature-key-id=peanut-admin-release-2026-01", f"--env-file={trusted_keys_environment}", f"--plan={upgrade_plan}"],
            ],
            "repeat_apply_expectation": {"status": "completed", "idempotent": True, "no_new_migration_or_business_operation": True},
            "migration_commands": "integrated into scripts/upgrade plan/apply/verify; install.php has no upgrade mode",
            "recovery_pair": {"instance_archive": str(backup / "instance.tar"), "database_dump": str(backup / "database.sql"), "formal_recovery_command": [str(ENV_RUNNER), "--env-file", str(host_environment_file), "--as-selector", "PEANUT_SERVER_ENV_FILE", "--", "/opt/homebrew/bin/php", upgrader, "recover", f"--instance-root={instance}", f"--package={package}", "--signature-key-id=peanut-admin-release-2026-01", f"--env-file={trusted_keys_environment}", "--plan=<separate-interrupted-upgrade-plan>"], "order": ["use a separate interrupted upgrade attempt bound to its durable state", "invoke formal recovery once", "require exact host-driver recovery evidence; after migration start it must restore the state-bound database/files pair", "read back business, Tenant, RBAC, Module and customization identities"]},
            "http_command": {"cwd": str(instance), "environment_file": str(container_environment_file), "source_identity": {"commit": candidate, "tree": tree}, "argv": [str(ENV_RUNNER), "--env-file", str(container_environment_file), "--clean-only", "--", "/usr/bin/env", f"PEANUT_SOURCE_COMMIT={candidate}", f"PEANUT_SOURCE_TREE={tree}", "/usr/local/bin/docker", "compose", "--project-name", f"peanut-cr03-{args.run_id}-{scenario}", "--env-file", ".env", "--env-file", "server/.env.local-production-preview", "-f", "deploy/docker-compose.prod.yml", "up", "-d", "--build"]},
        }
    claimed_resources = [
        *resources,
        {"type": "gate", "value": fixture["gate"]},
        {"type": "worktree", "value": str(ROOT)},
    ]
    claim = ["scripts/project-resource-lease", "claim", "--lease", args.lease, "--owner", "<owner>", "--thread", "<thread>", "--candidate", candidate, "--candidate-repository", str(ROOT), "--gate", fixture["gate"], "--ttl", "<seconds>"] + [part for item in resources for part in ("--resource", f"{item['type']}={item['value']}")]
    print(json.dumps({"schema_version": 1, "gate": fixture["gate"], "status": "structural-plan-valid-not-claimable-until-main-freeze", "candidate": candidate, "candidate_tree": tree, "worktree": str(ROOT), "run_id": args.run_id, "lease": args.lease, "resource_id": RESOURCE_ID, "databases": names, "paths": {"output-dir": str(output), "cache-dir": str(cache), "lease-proof-dir": str(proof_dir), "instance-roots": {key: str(value) for key, value in instance_roots.items()}, "backup-roots": {key: str(value) for key, value in backup_roots.items()}}, "scenarios": scenarios, "operation_plans": operation_plans, "lease_metadata": {"lease": args.lease, "owner": "<owner>", "thread": "<thread>", "candidate": candidate, "candidate_repository": str(ROOT), "gate": fixture["gate"], "worktree": str(ROOT)}, "lease_resources": claimed_resources, "claim_command": claim, "dynamic_preconditions": ["root has frozen an exact origin/main candidate/tree", "official source installers/manifests and external trusted key match the fixture", "formal signing key public derivation matches UPGRADE_TRUSTED_KEYS.json", "replace each generated instance's unallocated resources/project-resources.json with only its emitted fixed instance resource before install; its app-owned environment guard remains instance-local through signed upgrade", "lease claim is active and each exact database/root/Local prefix is absent", "remote MySQL allocation and exact mysql/mysqldump tools are healthy", "HTTP 20190 is unbound and scenarios run serially"], "stop": "Plan mode performs no claim, package download, signing, database connection, instance write, HTTP start, Local object write, or cleanup."}, ensure_ascii=False, indent=2))
    return 0

if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except PlanError as error:
