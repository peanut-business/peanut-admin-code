#!/usr/bin/env python3
"""Read-only Peanut Admin local development environment probe."""

from __future__ import annotations

import argparse
import http.client
import json
import os
import re
import socket
import subprocess
import sys
import time
import urllib.parse
from pathlib import Path
from typing import Any


REPO = Path(__file__).resolve().parent.parent
REGISTRY_PATH = REPO / "resources/project-resources.json"
DAILY_DEVELOPMENT_DATABASE_ID = "peanut-admin-mysql84-development"


def registered_expectations() -> tuple[dict[str, Any], dict[str, int], dict[str, str]]:
    registry = json.loads(REGISTRY_PATH.read_text(encoding="utf-8"))
    databases = [
        item
        for item in registry["resources"]["databases"]
        if item.get("stable_resource_id") == DAILY_DEVELOPMENT_DATABASE_ID
    ]
    if len(databases) != 1:
        raise ValueError(
            "resource registry must contain exactly one daily development database: "
            + DAILY_DEVELOPMENT_DATABASE_ID
        )
    database = databases[0]
    endpoint = database["upstream_endpoint"]
    expected_database = {
        "resource_id": database["stable_resource_id"],
        "endpoint_id": endpoint["endpoint_id"],
        "consumer": "host",
        "host": endpoint["host"],
        "port": int(endpoint["port"]),
        "database": database["database"],
    }
    port_names = {
        "DEV_HTTP_PORT": "development_gateway",
        "PHP_PORT": "development_php",
        "VITE_PORT": "development_admin",
        "PC_PORT": "development_pc",
        "MOBILE_PORT": "development_mobile",
        "DOCS_PORT": "development_docs",
        "HTTP_PORT": "production_preview_gateway",
    }
    selected_listeners = {
        item.get("port_env"): item
        for item in registry["resources"]["local_listeners"]
        if item.get("port_env") in port_names
    }
    missing_listeners = sorted(set(port_names) - set(selected_listeners))
    if missing_listeners:
        raise ValueError(
            "resource registry is missing probe listeners: "
            + ", ".join(missing_listeners)
        )
    expected_ports = {
        port_names[port_env]: int(selected_listeners[port_env]["port"])
        for port_env in port_names
    }
    port_env_names = {value: key for key, value in port_names.items()}
    return expected_database, expected_ports, port_env_names


EXPECTED_DATABASE, EXPECTED_PORTS, PORT_ENV_NAMES = registered_expectations()
SAFE_ENV_NAMES = set(PORT_ENV_NAMES.values()) | {
    "PEANUT_DATABASE_RESOURCE_ID",
    "PEANUT_DATABASE_ENDPOINT_ID",
    "PEANUT_DATABASE_CONSUMER",
    "DB_HOST",
    "DB_PORT",
    "DB_NAME",
    "DEPLOYMENT_MODE",
}
SAFE_BACKEND_NAMES = SAFE_ENV_NAMES - set(PORT_ENV_NAMES.values())


class Probe:
    def __init__(self, mode: str, orchestration_env: Path, backend_env: Path) -> None:
        self.mode = mode
        self.orchestration_env = orchestration_env
        self.backend_env = backend_env
        self.checks: list[dict[str, Any]] = []
        self._orchestration = self._read_environment(orchestration_env)
        self._backend = self._read_environment(backend_env)
        self._effective_ports = self._load_effective_ports(orchestration_env)
        self._secrets = [
            value
            for name, value in (self._orchestration | self._backend).items()
            if value
            and re.search(r"PASS|PASSWORD|SECRET|TOKEN|KEY|CREDENTIAL", name, re.I)
        ]

    @staticmethod
    def _read_environment(path: Path) -> dict[str, str]:
        values: dict[str, str] = {}
        if not path.is_file():
            return values
        for raw_line in path.read_text(encoding="utf-8").splitlines():
            line = raw_line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            name, value = line.split("=", 1)
            name = name.strip()
            if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
                values[name] = value.strip().strip("'\"")
        return values

    @staticmethod
    def _load_effective_ports(path: Path) -> dict[str, int] | None:
        result = subprocess.run(
            [str(REPO / "scripts/project-resource-registry"), "local-stack-ports", "--env-file", str(path)],
            capture_output=True, text=True, check=False,
        )
        if result.returncode != 0:
            return None
        return {
            name: int(value)
            for name, value in (line.split("=", 1) for line in result.stdout.splitlines())
        }

    def _redact(self, value: str, limit: int = 500) -> str:
        result = value
        for secret in sorted(self._secrets, key=len, reverse=True):
            if len(secret) >= 4:
                result = result.replace(secret, "[REDACTED]")
        return result[:limit]

    def add(
        self,
        check_id: str,
        ok: bool,
        summary: str,
        details: dict[str, Any] | None = None,
    ) -> None:
        item: dict[str, Any] = {
            "id": check_id,
            "status": "pass" if ok else "fail",
            "summary": summary,
        }
        if details:
            item["details"] = details
        self.checks.append(item)

    def skip(self, check_id: str, summary: str) -> None:
        self.checks.append({"id": check_id, "status": "skipped", "summary": summary})

    @staticmethod
    def text(relative: str) -> str:
        return (REPO / relative).read_text(encoding="utf-8")

    @staticmethod
    def size_bytes(value: str) -> int:
        match = re.fullmatch(r"\s*(\d+)\s*([kKmMgG]?)\s*", value)
        if not match:
            raise ValueError(f"unsupported size: {value}")
        scale = {"": 1, "k": 1024, "m": 1024**2, "g": 1024**3}
        return int(match.group(1)) * scale[match.group(2).lower()]

    @staticmethod
    def directive(text: str, name: str) -> str:
        match = re.search(rf"(?m)^\s*{re.escape(name)}\s*=\s*([^;#\s]+)", text)
        if not match:
            raise ValueError(f"missing {name}")
        return match.group(1)

    def run_command(
        self,
        command: list[str],
        timeout: int = 20,
        output_limit: int = 500,
    ) -> tuple[bool, str]:
        try:
            completed = subprocess.run(
                command,
                cwd=REPO,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                timeout=timeout,
                check=False,
                env={
                    key: value
                    for key in ("PATH", "HOME", "TMPDIR", "DOCKER_HOST", "SystemRoot", "COMSPEC", "PATHEXT")
                    if (value := os.environ.get(key))
                },
            )
        except (OSError, subprocess.TimeoutExpired) as exception:
            return False, self._redact(str(exception))
        output = (
            completed.stdout.strip()
            if completed.returncode == 0
            else completed.stderr.strip()
        )
        return completed.returncode == 0, self._redact(output, output_limit)

    def static_checks(self) -> None:
        local_stack = self.text("scripts/local-stack.sh")
        dev_compose = self.text("deploy/docker-compose.dev.yml")
        prod_compose = self.text("deploy/docker-compose.prod.yml")
        dev_nginx = self.text("deploy/nginx/development.conf")
        prod_nginx = self.text("deploy/nginx/peanut-admin.conf")
        dockerfile = self.text("deploy/docker/production.Dockerfile")

        host_runtime = self.text("scripts/local-php-runtime")
        local_stack_ok = "project-resource-registry" in local_stack
        runtime_ok = (
            "/opt/homebrew/bin/php" in host_runtime
            and "scripts/project-composer" in host_runtime
            and "expected_composer_version=2.10.2" in host_runtime
            and "php-runtime.pid" in host_runtime
            and "php-runtime.log" in host_runtime
        )
        target_ok = (
            re.search(
                r"database-env\s+--deployment-target\s+local-development\s+--consumer\s+host",
                local_stack,
            ) is not None
            and "set_env_value \"$temporary\" PEANUT_DEPLOYMENT_TARGET local-production-preview" in local_stack
            and "host.docker.internal" in dev_compose
            and "NO_PROXY:" in dev_compose
            and re.search(r"(?m)^\s{2}php:\s*$", dev_compose) is None
        )
        self.add(
            "config.database_registry",
            local_stack_ok and runtime_ok and target_ok,
            "daily development uses registered host PHP and the single registered database",
            {
                **EXPECTED_DATABASE,
                "environments": ["local-development", "local-production-preview"],
            },
        )

        port_fragments = {
            "development_gateway": "${DEV_HTTP_PORT:?set the registered development gateway port}:80",
            "development_php": "host.docker.internal:${PHP_PORT:?set the registered host PHP port}",
            "development_admin": "${VITE_PORT:?set the registered admin port}:5173",
            "development_pc": "${PC_PORT:?set the registered PC port}:3100",
            "development_mobile": "${MOBILE_PORT:?set the registered mobile port}:5174",
            "development_docs": "${DOCS_PORT:?set the registered docs port}:4173",
            "production_preview_gateway": "${HTTP_PORT:-18092}:80",
        }
        port_sources = {
            "development_gateway": dev_compose,
            "development_php": dev_compose,
            "development_admin": dev_compose,
            "development_pc": dev_compose,
            "development_mobile": dev_compose,
            "development_docs": dev_compose,
            "production_preview_gateway": prod_compose,
        }
        ports_ok = all(fragment in port_sources[name] for name, fragment in port_fragments.items())
        ports_ok = ports_ok and "local-stack-ports" in local_stack
        self.add(
            "config.fixed_ports",
            ports_ok,
            "local stack declares env-backed listeners with registered defaults",
            {"registered_default_ports": EXPECTED_PORTS},
        )

        enum = self.text("server/app/common/enum/FileEnum.php")
        limit_patterns = {
            "image": r"self::IMAGE\s*=>\s*(\d+)\s*\*\s*1024\s*\*\s*1024",
            "video": r"self::VIDEO\s*=>\s*(\d+)\s*\*\s*1024\s*\*\s*1024",
            "file": r"self::FILE\s*=>\s*(\d+)\s*\*\s*1024\s*\*\s*1024",
        }
        business_limits: dict[str, int] = {}
        for name, pattern in limit_patterns.items():
            match = re.search(pattern, enum)
            if match:
                business_limits[name] = int(match.group(1))
        expected_limits = {"image": 10, "file": 50, "video": 200}
        self.add(
            "config.business_upload_limits",
            business_limits == expected_limits,
            "application upload limits are image 10 MiB, file 50 MiB, video 200 MiB",
            {"limits_mib": business_limits},
        )

        try:
            ini = self.text("deploy/docker/php-upload.ini")
            php_limits = {
                "upload_max_filesize": self.size_bytes(self.directive(ini, "upload_max_filesize")),
                "post_max_size": self.size_bytes(self.directive(ini, "post_max_size")),
                "max_file_uploads": int(self.directive(ini, "max_file_uploads")),
            }
            php_source_ok = (
                "-d upload_max_filesize=200M" in host_runtime
                and "-d post_max_size=210M" in host_runtime
                and "-d max_file_uploads=20" in host_runtime
                and "COPY deploy/docker/php-upload.ini "
                "/usr/local/etc/php/conf.d/peanut-upload.ini" in dockerfile
            )
        except (OSError, ValueError) as exception:
            php_limits = {}
            php_source_ok = False
            php_error = str(exception)
        else:
            php_error = ""
        self.add(
            "config.php_upload_limits",
            php_source_ok and bool(php_limits),
            (
                "host development and production-preview PHP load the required upload limits"
                if php_source_ok
                else f"PHP upload configuration invalid: {php_error}"
            ),
            {
                "upload_max_filesize_bytes": php_limits.get("upload_max_filesize"),
                "post_max_size_bytes": php_limits.get("post_max_size"),
                "max_file_uploads": php_limits.get("max_file_uploads"),
            },
        )

        nginx_limits: dict[str, int] = {}
        try:
            nginx_limits = {
                "development": self.size_bytes(self._nginx_limit(dev_nginx)),
                "local_production_preview": self.size_bytes(self._nginx_limit(prod_nginx)),
            }
        except ValueError as exception:
            nginx_error = str(exception)
        else:
            nginx_error = ""
        self.add(
            "config.nginx_upload_limits",
            len(nginx_limits) == 2,
            (
                "development and production-preview Nginx declare request-body limits"
                if nginx_limits
                else f"Nginx upload configuration invalid: {nginx_error}"
            ),
            {"client_max_body_size_bytes": nginx_limits},
        )

        maximum_business = max(business_limits.values(), default=0) * 1024**2
        upload_max = php_limits.get("upload_max_filesize", 0)
        post_max = php_limits.get("post_max_size", 0)
        relation_ok = (
            maximum_business == 200 * 1024**2
            and upload_max >= maximum_business
            and post_max > upload_max
            and all(limit >= post_max for limit in nginx_limits.values())
            and php_limits.get("max_file_uploads", 0) > 0
        )
        self.add(
            "config.upload_transport_relation",
            relation_ok,
            "Nginx >= PHP post > PHP upload >= largest business limit",
            {
                "largest_business_limit_bytes": maximum_business,
                "php_upload_max_bytes": upload_max,
                "php_post_max_bytes": post_max,
                "nginx_limits_bytes": nginx_limits,
            },
        )

        storage_ok = (
            re.search(r"location\s+\^~\s+/storage/", dev_nginx) is not None
            and re.search(r"location\s+\^~\s+/storage/", prod_nginx) is not None
            and "try_files $uri =404;" in prod_nginx
        )
        self.add(
            "config.storage_routes",
            storage_ok,
            "/storage is explicitly routed in development and production preview",
        )

        safe_environment = {
            name: self._backend[name]
            for name in sorted(SAFE_ENV_NAMES)
            if name in self._backend
        }
        safe_environment.update({
            name: self._orchestration[name]
            for name in sorted(PORT_ENV_NAMES.values())
            if name in self._orchestration
        })
        forbidden_orchestration = sorted(
            name for name in self._orchestration
            if name in SAFE_BACKEND_NAMES or re.match(
                r"^(?:PHP_(?:ENV_NAME|APP_|DB_|JWT_|DEPLOYMENT_MODE|PUBLIC_DEFAULT|PLATFORM_|TENANT_|ADMIN_|OWNER_|PEANUT_)|APP_|DB_|JWT_|DEPLOYMENT_MODE$|PUBLIC_DEFAULT_TENANT_FALLBACK$|PLATFORM_(?:HOSTS|IDENTIFIER_HMAC_KEY|INITIAL_EMAIL|INITIAL_PASSWORD)$|TENANT_|ADMIN_|OWNER_INVITATION_|PEANUT_(?:DEPLOYMENT_TARGET|DATABASE_|RESOURCE_LEASE_PROOF|STORAGE_|DEMO_|MODULE_))",
                name,
            )
        )
        if self.orchestration_env.is_file() and self.backend_env.is_file():
            env_ok = (
                forbidden_orchestration == []
                and safe_environment.get("PEANUT_DATABASE_RESOURCE_ID") == EXPECTED_DATABASE["resource_id"]
                and safe_environment.get("PEANUT_DATABASE_ENDPOINT_ID") == EXPECTED_DATABASE["endpoint_id"]
                and safe_environment.get("PEANUT_DATABASE_CONSUMER") == EXPECTED_DATABASE["consumer"]
                and safe_environment.get("DB_HOST") == EXPECTED_DATABASE["host"]
                and safe_environment.get("DB_PORT") == str(EXPECTED_DATABASE["port"])
                and safe_environment.get("DB_NAME") == EXPECTED_DATABASE["database"]
                and safe_environment.get("DEPLOYMENT_MODE") == "standalone"
                and self._effective_ports is not None
            )
            self.add(
                "config.local_environment",
                env_ok,
                "split local environments select the registered database and valid local listener ports",
                {
                    "orchestration_path": str(self.orchestration_env),
                    "backend_path": str(self.backend_env),
                    "forbidden_orchestration_keys": forbidden_orchestration,
                    "safe_values": safe_environment,
                },
            )
        elif self.mode == "full":
            self.add(
                "config.local_environment",
                False,
                "local orchestration or backend environment file is missing",
                {
                    "orchestration_path": str(self.orchestration_env),
                    "backend_path": str(self.backend_env),
                },
            )
        else:
            self.skip(
                "config.local_environment",
                "local environment file is absent; repository defaults were checked",
            )

    @staticmethod
    def _nginx_limit(text: str) -> str:
        match = re.search(r"(?m)^\s*client_max_body_size\s+([^;\s]+)\s*;", text)
        if not match:
            raise ValueError("missing client_max_body_size")
        return match.group(1)

    def resolved_ports(self) -> dict[str, int]:
        if self._effective_ports is None:
            return {name: -1 for name in EXPECTED_PORTS}
        return {
            name: self._effective_ports[env_name]
            for name, env_name in PORT_ENV_NAMES.items()
        }

    @staticmethod
    def socket_open(port: int) -> bool:
        if port < 1:
            return False
        try:
            with socket.create_connection(("127.0.0.1", port), timeout=1.5):
                return True
        except OSError:
            return False

    @staticmethod
    def http_status(url: str, attempts: int = 1) -> int | None:
        parsed = urllib.parse.urlsplit(url)
        if parsed.scheme != "http" or parsed.hostname is None:
            return None
        path = parsed.path or "/"
        if parsed.query:
            path += f"?{parsed.query}"
        status: int | None = None
        for attempt in range(attempts):
            connection = http.client.HTTPConnection(
                parsed.hostname,
                parsed.port or 80,
                timeout=4,
            )
            try:
                connection.request(
                    "GET",
                    path,
                    headers={
                        "Accept": "*/*",
                        "User-Agent": "peanut-admin-local-probe/1",
                    },
                )
                response = connection.getresponse()
                response.read(1)
                status = response.status
            except (http.client.HTTPException, TimeoutError, OSError):
                status = None
            finally:
                connection.close()
            if status is not None and 200 <= status < 400:
                return status
            if attempt + 1 < attempts:
                time.sleep(1)
        return status

    def compose_command(self, compose_file: str, *arguments: str) -> list[str]:
        command = [
            "docker",
            "compose",
            "--env-file",
            str(self.orchestration_env),
            "-f",
            str(REPO / compose_file),
            *arguments,
        ]
        if compose_file == "deploy/docker-compose.prod.yml":
            command[4:4] = ["--env-file", str(self.backend_env)]
            command = ["env", f"PEANUT_SERVER_ENV_FILE={self.backend_env}", *command]
        return command

    def runtime_checks(self) -> None:
        ports = self.resolved_ports()
        listeners = {name: self.socket_open(port) for name, port in ports.items()}
        self.add(
            "runtime.fixed_port_listeners",
            all(listeners.values()),
            "all registered local ports accept TCP connections",
            {
                "listeners": {
                    name: {"port": ports[name], "listening": value}
                    for name, value in listeners.items()
                }
            },
        )

        dev_port = ports["development_gateway"]
        prod_port = ports["production_preview_gateway"]
        docs_port = ports["development_docs"]
        entries = {
            "development_admin": self.http_status(f"http://127.0.0.1:{dev_port}/admin/", attempts=5),
            "development_pc": self.http_status(f"http://127.0.0.1:{dev_port}/pc/", attempts=5),
            "development_mobile": self.http_status(f"http://127.0.0.1:{dev_port}/mobile/", attempts=5),
            "development_docs": self.http_status(f"http://127.0.0.1:{docs_port}/", attempts=5),
            "production_preview_health": self.http_status(f"http://127.0.0.1:{prod_port}/healthz", attempts=5),
            "production_preview_admin": self.http_status(f"http://127.0.0.1:{prod_port}/admin/", attempts=5),
        }
        entries_ok = all(status is not None and 200 <= status < 400 for status in entries.values())
        self.add(
            "runtime.http_entries",
            entries_ok,
            "development and production-preview HTTP entries are reachable",
            {"statuses": entries},
        )

        storage_statuses = {
            "development": self.http_status(f"http://127.0.0.1:{dev_port}/storage/.peanut-probe-not-found"),
            "local_production_preview": self.http_status(
                f"http://127.0.0.1:{prod_port}/storage/.peanut-probe-not-found"
            ),
        }
        self.add(
            "runtime.storage_routes",
            all(status == 404 for status in storage_statuses.values()),
            "/storage reaches its explicit route and returns 404 for a missing probe object",
            {"statuses": storage_statuses},
        )

        php_code = (
            'echo json_encode(['
            '"upload_max_filesize"=>ini_get("upload_max_filesize"),'
            '"post_max_size"=>ini_get("post_max_size"),'
            '"max_file_uploads"=>(int)ini_get("max_file_uploads")]);'
        )
        runtime_php: dict[str, dict[str, Any]] = {}
        php_errors: dict[str, str] = {}
        runtime_commands = {
            "development": [
                "/opt/homebrew/bin/php",
                "-d", "upload_max_filesize=200M",
                "-d", "post_max_size=210M",
                "-d", "max_file_uploads=20",
                "-r", php_code,
            ],
            "local_production_preview": self.compose_command(
                "deploy/docker-compose.prod.yml", "exec", "-T", "php", "php", "-r", php_code
            ),
        }
        for name, command in runtime_commands.items():
            ok, output = self.run_command(
                command
            )
            if ok:
                try:
                    runtime_php[name] = json.loads(output)
                except json.JSONDecodeError:
                    php_errors[name] = "PHP returned invalid JSON"
            else:
                php_errors[name] = output or "PHP service is unavailable"
        expected_php = {
            "upload_max_filesize": "200M",
            "post_max_size": "210M",
            "max_file_uploads": 20,
        }
        php_ok = len(runtime_php) == 2 and all(
            values == expected_php for values in runtime_php.values()
        )
        self.add(
            "runtime.php_upload_limits",
            php_ok,
            "host development and production-preview PHP apply upload/post/count limits",
            {"values": runtime_php, "errors": php_errors} if php_errors else {"values": runtime_php},
        )

        baseline_ok, baseline_output = self.run_command(
            [str(REPO / "scripts/local-stack.sh"), "database-host-status"],
            timeout=30,
            output_limit=20_000,
        )
        baseline_details: dict[str, Any] = {}
        if baseline_ok:
            try:
                baseline_details = json.loads(baseline_output)
            except json.JSONDecodeError:
                baseline_ok = False
                baseline_details = {"error": "database baseline guard returned invalid JSON"}
        else:
            baseline_details = {"error": baseline_output or "database baseline guard failed"}
        allowed_baseline_fields = {
            key: baseline_details[key]
            for key in (
                "environment",
                "deployment_target",
                "resource_id",
                "host",
                "port",
                "database",
                "status",
                "baseline_table_count",
                "installed_table_count",
                "application_migration_count",
                "module_migration_count",
            )
            if key in baseline_details
        }
        if "error" in baseline_details:
            allowed_baseline_fields["error"] = baseline_details["error"]
        baseline_ok = baseline_ok and baseline_details.get("status") == "current"
        self.add(
            "runtime.database_baseline",
            baseline_ok,
            "registered development database matches the v3.0 fresh baseline",
            allowed_baseline_fields,
        )

    def report(self) -> dict[str, Any]:
        failed = sum(check["status"] == "fail" for check in self.checks)
        passed = sum(check["status"] == "pass" for check in self.checks)
        skipped = sum(check["status"] == "skipped" for check in self.checks)
        return {
            "probe": "peanut-admin-local-environment",
            "mode": self.mode,
            "status": "fail" if failed else "pass",
            "resource": {
                "id": EXPECTED_DATABASE["resource_id"],
                "environment": "development/local-production-preview",
                "address": f"{EXPECTED_DATABASE['host']}:{EXPECTED_DATABASE['port']}/{EXPECTED_DATABASE['database']}",
                "endpoint_id": EXPECTED_DATABASE["endpoint_id"],
            },
            "summary": {"passed": passed, "failed": failed, "skipped": skipped},
            "checks": self.checks,
        }


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--config-only",
        action="store_true",
        help="check repository configuration without contacting listeners, containers, or the database",
    )
    parser.add_argument(
        "--env-file",
        type=Path,
        default=REPO / ".local/stack.env",
        help="local stack env file (default: .local/stack.env)",
    )
    parser.add_argument(
        "--backend-env",
        type=Path,
        default=REPO / "server/.env",
        help="backend env file (default: server/.env)",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    mode = "config-only" if args.config_only else "full"
    probe = Probe(mode, args.env_file.resolve(), args.backend_env.resolve())
    try:
        probe.static_checks()
        if args.config_only:
            for check_id in (
                "runtime.fixed_port_listeners",
                "runtime.http_entries",
                "runtime.storage_routes",
                "runtime.php_upload_limits",
                "runtime.database_baseline",
            ):
                probe.skip(check_id, "not run in config-only mode")
        else:
            probe.runtime_checks()
    except Exception as exception:  # Keep the report machine-readable on unexpected input errors.
        probe.add("probe.internal", False, f"probe failed: {probe._redact(str(exception))}")

    report = probe.report()
    json.dump(report, sys.stdout, ensure_ascii=False, indent=2)
    sys.stdout.write("\n")
    counts = report["summary"]
    print(
        f"local environment probe: {report['status'].upper()} "
        f"({counts['passed']} passed, {counts['failed']} failed, {counts['skipped']} skipped)",
        file=sys.stderr,
    )
    for check in report["checks"]:
        if check["status"] == "fail":
            print(f"  FAIL {check['id']}: {check['summary']}", file=sys.stderr)
    return 1 if report["status"] == "fail" else 0


if __name__ == "__main__":
    raise SystemExit(main())
