#!/usr/bin/env bash
set -Eeuo pipefail
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
ROOT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)"
REGISTRY="${PEANUT_RESOURCE_REGISTRY:-$ROOT_DIR/resources/project-resources.json}"
die() { printf 'deploy-release: %s\n' "$1" >&2; exit 1; }
usage() {
  cat <<'USAGE'
Usage: scripts/deploy-release vAPP_VERSION --target production|production-candidate
  --deployment-resource ID --expected-commit APP_COMMIT --expected-tree APP_TREE
  (--install|--update) --server-package /absolute/server.tar.gz
  --expected-sha256 TRUSTED_ARCHIVE_SHA256 [--apply|--dry-run]

Consume the independent APP's own server Release. Installation refuses any
existing root; updates call the installed native plan/apply/verify entry.
Fixed PHP/Nginx/MySQL runtime images are reused without application builds.
No fresh, source-checkout overlay, host/port guessing or deployment removal.
USAGE
}
tag= target= resource= commit= tree= archive= digest= mode= action=dry-run
while (($#)); do
  case "$1" in
    v*) [[ -z "$tag" ]] || die 'duplicate release'; tag="$1"; shift ;;
    --target|--deployment-resource|--expected-commit|--expected-tree|--server-package|--expected-sha256)
      (($# >= 2)) || die 'missing option value'
      case "$1" in
        --target) target="$2" ;; --deployment-resource) resource="$2" ;;
        --expected-commit) commit="$2" ;; --expected-tree) tree="$2" ;;
        --server-package) archive="$2" ;; --expected-sha256) digest="$2" ;;
      esac
      shift 2 ;;
    --install|--update) [[ -z "$mode" ]] || die 'choose one action'; mode="${1#--}"; shift ;;
    --apply|--dry-run) action="${1#--}"; shift ;;
    --help|-h) usage; exit 0 ;;
    *) usage >&2; die "unknown option: $1" ;;
  esac
done
[[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([-+][A-Za-z0-9.-]+)?$ \
  && "$target" =~ ^production(-candidate)?$ && "$resource" =~ ^[a-z0-9][a-z0-9-]{2,127}$ \
  && "$commit" =~ ^[a-f0-9]{40}$ && "$tree" =~ ^[a-f0-9]{40}$ \
  && "$digest" =~ ^[a-f0-9]{64}$ && -n "$mode" ]] || { usage >&2; die 'incomplete APP deployment identity'; }
[[ "$REGISTRY" == /* && -f "$REGISTRY" && ! -L "$REGISTRY" ]] || die 'absolute ordinary registry is required'
[[ "$archive" == /* && -f "$archive" && ! -L "$archive" ]] || die 'absolute ordinary server archive is required'
for name in python3 jq ssh scp; do command -v "$name" >/dev/null || die "$name is required"; done
python3 "$SCRIPT_DIR/package-release-files.py" verify --archive="$archive" --expected-sha256="$digest" >/dev/null
umask 077
workspace="$(mktemp -d "${TMPDIR:-/tmp}/peanut-deploy.XXXXXXXX")"
trap 'rm -rf -- "$workspace"' EXIT
python3 - "$REGISTRY" "$resource" "$target" "$tag" "$commit" "$tree" "$archive" "$mode" "$digest" "$workspace/plan.json" <<'PY'
import hashlib,json,pathlib,re,sys,tarfile
registry,rid,target,tag,commit,tree,archive,mode,digest,output=sys.argv[1:]
data=json.loads(pathlib.Path(registry).read_text())
def fail(message): raise SystemExit("deploy-release: "+message)
def objects(value):
    if isinstance(value,dict):
        yield value
        for child in value.values(): yield from objects(child)
    elif isinstance(value,list):
        for child in value: yield from objects(child)
rows=list(objects(data))
def resource(key):
    found=[row for row in rows if row.get("stable_resource_id")==key]
    if len(found)!=1: fail("missing/ambiguous resource: "+str(key))
    return found[0]
d=resource(rid); a=resource(d.get("application_resource_id")); h=resource(d.get("http_resource_id"))
b=resource(d.get("database_resource_id")); m=resource(b.get("runtime_resource_id"))
for row in (d,a,h,b,m):
    if row.get("fallback")!="none" or target not in row.get("environments",[row.get("environment")]):
        fail("resource environment/fallback differs from target")
root=d.get("deployment_root",""); host=d.get("ssh_alias",""); project=d.get("compose_project","")
if not re.fullmatch(r"/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*",root): fail("invalid registered root")
if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}",host) or d.get("host")!=host: fail("invalid SSH identity")
if not re.fullmatch(r"[a-z0-9][a-z0-9_-]{0,62}",project): fail("invalid Compose identity")
if d.get("compose_file")!="server/docker/compose.yaml" or d.get("pc_render_mode")!="spa": fail("mounted Compose/SPA registration required")
port=h.get("port"); bind=h.get("bind")
if bind!="127.0.0.1" or type(port)!=int or not 1024<=port<=65535: fail("invalid HTTP endpoint")
endpoint=b.get("container_endpoint",{})
if b.get("service_type")!="mysql" or b.get("application_runtime") is not True or endpoint.get("host")!="mysql" or endpoint.get("port")!=3306:
    fail("invalid registered MySQL endpoint")
if not re.fullmatch(r"[A-Za-z0-9_]{1,64}",str(b.get("database",""))): fail("invalid database name")
for row in (a,b,m):
    if row.get("host")!=host or row.get("compose_project")!=project or row.get("compose_file")!=d["compose_file"]: fail("runtime tuple differs")
if a.get("database_resource_id")!=b["stable_resource_id"] or a.get("http_resource_id")!=h["stable_resource_id"] \
        or h.get("ssh_alias")!=host or m.get("database_resource_id")!=b["stable_resource_id"]: fail("resource relationship differs")
if a.get("published_endpoint",{}).get("bind")!=bind or a.get("published_endpoint",{}).get("port")!=port: fail("HTTP projection differs")
deployment_kind=d.get("deployment_kind","application")
if deployment_kind not in ("application","temporary-multi-tenant-source"): fail("unknown deployment kind")
upgrade_php=d.get("upgrade_php","")
if mode=="update" and not re.fullmatch(r"/(?:[A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*",upgrade_php):
    fail("registered absolute PHP maintenance entry required")
images=d.get("runtime_images",{})
pattern=r"(?:sha256:[a-f0-9]{64}|[A-Za-z0-9][A-Za-z0-9._:/-]{0,160}@sha256:[a-f0-9]{64})"
if set(images)!={"php","nginx","mysql"} or any(not re.fullmatch(pattern,str(v)) for v in images.values()): fail("immutable runtime image set required")
if b.get("image")!=images["mysql"] or m.get("image")!=images["mysql"]: fail("MySQL image differs")
if b.get("namespace")!=root+"/server/docker/mysql" or m.get("namespace")!=b["namespace"]: fail("MySQL directory differs")
env=d.get("required_non_secret_environment",{})
if env.get("HTTP_PORT")!=port or env.get("PEANUT_DATABASE_RESOURCE_ID")!=b["stable_resource_id"] or env.get("DB_NAME")!=b["database"]:
    fail("registered application configuration differs")
owned={r["stable_resource_id"] for r in (d,a,h,b,m)}
for other in rows:
    if other.get("stable_resource_id") in owned or (other.get("host")!=host and other.get("ssh_alias")!=host): continue
    path=other.get("deployment_root")
    if path and (path==root or path.startswith(root+"/") or root.startswith(path+"/")): fail("root overlaps another resource")
    if other.get("compose_project")==project or (other.get("bind")==bind and other.get("port")==port): fail("project/listener overlaps another resource")
with tarfile.open(archive,"r:gz") as package:
    found=[row for row in package.getmembers() if row.name.endswith("/server/.peanut/release-identity.json")]
    if len(found)!=1: fail("ambiguous archive identity")
    identity=json.load(package.extractfile(found[0])); app=identity.get("application",{})
    if deployment_kind=="temporary-multi-tenant-source":
        import datetime
        try: expiry=datetime.datetime.strptime(d.get("expires_at",""),"%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
        except ValueError: fail("temporary source expiry must be UTC")
        if mode!="install" or app.get("kind")!="generated-template" or app.get("commit") is not None or app.get("tree") is not None \
                or app.get("edition")!="multi-tenant" or env.get("DEPLOYMENT_MODE")!="multi-tenant" \
                or identity.get("upstream",{}).get("commit")!=commit or identity.get("upstream",{}).get("tree")!=tree \
                or d.get("source_commit")!=commit or d.get("source_tree")!=tree \
                or expiry<=datetime.datetime.now(datetime.timezone.utc) or not isinstance(d.get("replace_owner"),str) or not d["replace_owner"].strip():
            fail("temporary source installation identity/ownership differs")
    elif app.get("kind")!="application" or app.get("version")!=tag[1:] or app.get("commit")!=commit or app.get("tree")!=tree:
        fail("archive is not the selected independent APP Release")
    if app.get("package_identity")!=d.get("application_package_identity") or app.get("slug")!=d.get("application_slug") \
            or app.get("edition")!=env.get("DEPLOYMENT_MODE"): fail("APP identity/Edition differs from target")
    prefix=found[0].name[:-len("server/.peanut/release-identity.json")]
    projection=json.load(package.extractfile(package.getmember(prefix+"server/resources/project-resources.json")))
    if projection.get("project_id")!=app.get("slug") or projection.get("authority",{}).get("role")!="application": fail("resource projection owner differs")
    projected=[row for row in objects(projection) if row.get("stable_resource_id")==b["stable_resource_id"]]
    if len(projected)!=1 or projected[0].get("database")!=b["database"] or projected[0].get("container_endpoint")!=endpoint:
        fail("archive database projection differs")
plan={"protocol":"peanut.mounted-deployment-plan.v1","resource_id":rid,"target":target,"mode":mode,
      "root":root,"host":host,"project":project,"bind":bind,"port":port,"images":images,"application":app,
      "database_resource_id":b["stable_resource_id"],"database_name":b["database"],"archive_sha256":digest,
      "registry_sha256":hashlib.sha256(pathlib.Path(registry).read_bytes()).hexdigest(),
      "deployment_kind":deployment_kind,"source_commit":commit,"source_tree":tree,"upgrade_php":upgrade_php}
pathlib.Path(output).write_text(json.dumps(plan,sort_keys=True)+"\n")
PY
jq '{resource_id,target,mode,root,host,project,port,application,images,archive_sha256}' "$workspace/plan.json"
[[ "$action" == apply ]] || exit 0
host="$(jq -r .host "$workspace/plan.json")"
remote="$(ssh -o BatchMode=yes "$host" 'umask 077; mktemp -d /tmp/peanut-deploy.XXXXXXXX')"
[[ "$remote" =~ ^/tmp/peanut-deploy\.[A-Za-z0-9]{8}$ ]] || die 'invalid remote transfer workspace'
scp -q "$archive" "$host:$remote/server.tar.gz"
scp -q "$workspace/plan.json" "$host:$remote/plan.json"
scp -q "$SCRIPT_DIR/package-release-files.py" "$host:$remote/verifier.py"
plan_sha="$(python3 -c 'import hashlib,sys;print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest())' "$workspace/plan.json")"
verifier_sha="$(python3 -c 'import hashlib,sys;print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest())' "$SCRIPT_DIR/package-release-files.py")"
# SSH supplies the authenticated host boundary. Hex digests also bind the exact
# caller-approved plan and installed verifier bytes before remote execution.
ssh -o BatchMode=yes -o ServerAliveInterval=15 "$host" sudo -n bash -s -- "$remote" "$plan_sha" "$verifier_sha" <<'REMOTE'
set -Eeuo pipefail
transfer="$1"; plan_sha="$2"; verifier_sha="$3"
fail() { printf 'deploy-release remote: %s; transfer/upgrade evidence retained at %s\n' "$1" "$transfer" >&2; exit 1; }
[[ "$transfer" =~ ^/tmp/peanut-deploy\.[A-Za-z0-9]{8}$ && -d "$transfer" && ! -L "$transfer" ]] || exit 64
[[ "$(sha256sum "$transfer/plan.json" | cut -d' ' -f1)" == "$plan_sha" \
  && "$(sha256sum "$transfer/verifier.py" | cut -d' ' -f1)" == "$verifier_sha" ]] || fail 'transport identity changed'
plan="$transfer/plan.json"
root="$(jq -er .root "$plan")"; mode="$(jq -er .mode "$plan")"; digest="$(jq -er .archive_sha256 "$plan")"
python3 "$transfer/verifier.py" verify --archive="$transfer/server.tar.gz" --expected-sha256="$digest" >/dev/null
parent="$(dirname "$root")"
[[ -d "$parent" && ! -L "$parent" && "$(realpath -e "$parent")" == "$parent" ]] || fail 'registered parent is not canonical'
lock="$parent/.peanut-deploy-$(jq -r .resource_id "$plan").lock"
mkdir -m 0700 "$lock" || fail 'deployment owner lock is held'
trap 'rmdir -- "$lock"' EXIT
if [[ "$mode" == install ]]; then
  [[ ! -e "$root" && ! -L "$root" ]] || fail 'installation refuses an existing root; preserve its contents'
  stage="$parent/.peanut-stage-$digest"
  mkdir -m 0700 "$stage" || fail 'previous staging exists; explicit owner review required'
  # The trusted verifier has already rejected links, traversals, duplicates and
  # forbidden instance paths. Extract only the authenticated server subtree.
  python3 - "$transfer/server.tar.gz" "$stage" <<'PY'
import pathlib,sys,tarfile
archive,destination=sys.argv[1:]
with tarfile.open(archive,"r:gz") as package:
    for member in package.getmembers():
        parts=pathlib.PurePosixPath(member.name).parts
        if len(parts)<2: continue
        relative=pathlib.Path(*parts[1:])
        if relative.parts[0]!="server": raise SystemExit("non-server release path")
        target=pathlib.Path(destination)/relative
        if member.isdir(): target.mkdir(parents=True,exist_ok=True); continue
        if not member.isfile(): raise SystemExit("non-regular release member")
        target.parent.mkdir(parents=True,exist_ok=True)
        with target.open("xb") as output: output.write(package.extractfile(member).read())
        target.chmod(member.mode)
    # The transport/staging umask is private; program directories still need
    # traversal by the registered PHP/Nginx users. Runtime permissions are set
    # separately by the native first-start entry.
    for directory in pathlib.Path(destination).rglob("*"):
        if directory.is_dir(): directory.chmod(0o755)
PY
  # Atomic publication never overlays a customer directory.
  [[ ! -e "$root" && ! -L "$root" ]] || fail 'root appeared during staging'
  mv -T -- "$stage" "$root"
  chmod 0755 "$root"
  python3 "$root/server/docker/scripts/configure-runtime.py" --docker-root="$root/server/docker" \
    --project="$(jq -r .project "$plan")" --http-bind="$(jq -r .bind "$plan")" \
    --http-port="$(jq -r .port "$plan")" --php-image="$(jq -r .images.php "$plan")" >/dev/null
  # Public templates must name the exact registered Nginx/MySQL images.
else
  [[ -d "$root" && ! -L "$root" && "$(realpath -e "$root")" == "$root" ]] || fail 'installed root is not canonical'
fi
python3 - "$root" "$plan" <<'PY'
import json,pathlib,sys
root=pathlib.Path(sys.argv[1]); plan=json.load(open(sys.argv[2]))
path=root/"server/docker/.env"
if path.is_symlink() or not path.is_file() or path.stat().st_nlink!=1 or path.stat().st_mode&0o777!=0o600:
    raise SystemExit("private Docker settings are unsafe")
values={}
for line in path.read_text().splitlines():
    if not line or line.startswith("#"): continue
    key,sep,value=line.partition("=")
    if not sep or key in values: raise SystemExit("invalid/duplicate Docker setting")
    values[key]=value
for key,value in {"COMPOSE_PROJECT_NAME":plan["project"],"HTTP_BIND":plan["bind"],"HTTP_PORT":str(plan["port"]),
                  "PHP_IMAGE":plan["images"]["php"],"NGINX_IMAGE":plan["images"]["nginx"],"MYSQL_IMAGE":plan["images"]["mysql"]}.items():
    if values.get(key)!=value: raise SystemExit("Docker setting differs from registered target: "+key)
identity=root/"server/.peanut/release-identity.json"
if plan["mode"]=="update":
    installed=root/"server/private/installation/installed.json"
    if installed.is_symlink() or not installed.is_file(): raise SystemExit("update requires installed identity")
    current=json.loads(identity.read_text())["application"]
    for key in ("package_identity","slug","edition"):
        if current.get(key)!=plan["application"].get(key): raise SystemExit("installed APP differs from target")
PY
cd "$root"
if [[ "$mode" == install ]]; then
  sh server/docker/scripts/start.sh
  printf 'deployment_started=guided-installation; installation completion requires the native installer\n'
else
  native="$root/server/docker/scripts/update.sh"
  [[ -f "$native" && ! -L "$native" ]] || fail 'installed native update entry is unavailable'
  export PEANUT_UPGRADE_PHP="$(jq -er .upgrade_php "$plan")"
  [[ -x "$PEANUT_UPGRADE_PHP" && -f "$PEANUT_UPGRADE_PHP" ]] || fail 'registered PHP maintenance entry is unavailable'
  update_root="$root/server/private/updates"
  [[ ! -L "$root/server/private" && ! -L "$update_root" ]] || fail 'update workspace parent is linked'
  mkdir -p -m 0700 "$update_root"
  update="$update_root/$digest"
  [[ ! -L "$update" ]] || fail 'update workspace is linked'
  mkdir -p -m 0700 "$update"
  [[ "$(realpath -e "$update")" == "$update" ]] || fail 'update workspace is not canonical'
  stable_archive="$update_root/$digest.server.tar.gz"
  [[ ! -L "$stable_archive" ]] || fail 'stable archive path is linked'
  if [[ -e "$stable_archive" ]]; then
    [[ -f "$stable_archive" && "$(stat -c '%h' "$stable_archive")" == 1 \
      && "$(sha256sum "$stable_archive" | cut -d' ' -f1)" == "$digest" ]] \
      || fail 'saved archive differs from the trusted release'
  else
    install -m 0600 "$transfer/server.tar.gz" "$stable_archive"
  fi
  if [[ ! -e "$update/product-binding.json" ]]; then
    sh "$native" plan --archive="$stable_archive" --expected-sha256="$digest" --workspace="$update"
  fi
  sh "$native" apply --workspace="$update"
  sh "$native" verify --workspace="$update"
fi
# Persist APP/source identity independently from the fixed runtime image set.
install -m 0600 "$plan" "$root/server/private/mounted-deployment-receipt.json"
printf 'deployment_resource=%s application_commit=%s images_reused=true\n' \
  "$(jq -r .resource_id "$plan")" "$(jq -r .source_commit "$plan")"
REMOTE
