  for key in PEANUT_DEMO_MODE PEANUT_DEMO_TENANT_A_EMAIL PEANUT_DEMO_TENANT_B_EMAIL \
    PEANUT_DEMO_SHARED_PASSWORD PEANUT_DEMO_TENANT_A_HOST PEANUT_DEMO_TENANT_B_HOST PEANUT_DEMO_DOCS_URL; do
    set_env_key server/.env "$key" "${!key:-}"
  done
  set_env_key server/.env PEANUT_DEMO_ADMIN_EMAIL "$(printf '%s' "$ADMIN_INITIAL_EMAIL" | tr '[:upper:]' '[:lower:]')"
  set_env_key server/.env PEANUT_DEMO_PLATFORM_EMAIL "$(printf '%s' "$PLATFORM_INITIAL_EMAIL" | tr '[:upper:]' '[:lower:]')"
elif [[ "$DEMO_MODE_SET" == 1 ]]; then
  set_env_key server/.env PEANUT_DEMO_MODE "$DEMO_MODE"
  for key in PEANUT_DEMO_TENANT_A_EMAIL PEANUT_DEMO_TENANT_B_EMAIL \
    PEANUT_DEMO_SHARED_PASSWORD PEANUT_DEMO_TENANT_A_HOST PEANUT_DEMO_TENANT_B_HOST PEANUT_DEMO_DOCS_URL; do
    [[ -n "${!key:-}" ]] && set_env_key server/.env "$key" "${!key}"
  done
fi
actual_commit="$expected_commit"

compose=(sudo -n env -i "PATH=$PATH" "HOME=$HOME" "PEANUT_SERVER_ENV_FILE=$root/server/.env" "PEANUT_DEPLOYMENT_RECEIPT_FILE=$root/DEPLOYMENT_RECEIPT.json" "PHP_IMAGE=$php_image" "NGINX_IMAGE=$nginx_image" "PC_IMAGE=$pc_image" docker compose --env-file .env --env-file server/.env -p "$project" -f compose.yaml --profile bundled-db)
"${compose[@]}" config >/dev/null || fail 'updated Compose configuration is invalid'
verify_running_image_bindings() {
  local php_running nginx_running pc_running
  php_running="$(sudo -n docker inspect --format '{{.Image}}' "${project}-php-1")"
  nginx_running="$(sudo -n docker inspect --format '{{.Image}}' "${project}-nginx-1")"
  pc_running="$(sudo -n docker inspect --format '{{.Image}}' "${project}-pc-1")"
  jq -e --arg php "$php_running" --arg nginx "$nginx_running" --arg pc "$pc_running" \
    '.images.php == $php and .images.nginx == $nginx and .images.pc == $pc' \
    "$root/DEPLOYMENT_RECEIPT.json" >/dev/null \
    || fail 'running container image IDs differ from the deployment receipt'
  printf 'runtime_image_receipt_binding=valid\n'
}
# Initial identities are mounted into the one automatic installation client
# from a permission-0600 file. They are never written to server/.env or retained
# by the long-running PHP/cron containers.
installation_env="$(mktemp /tmp/peanut-admin-installation.XXXXXX.env)"
chmod 600 "$installation_env"
{
  printf 'ADMIN_INITIAL_EMAIL=%s\n' "$ADMIN_INITIAL_EMAIL"
  printf 'ADMIN_INITIAL_PASSWORD=%s\n' "$ADMIN_INITIAL_PASSWORD"
  if [[ "$deployment_mode" == multi-tenant ]]; then
    printf 'PLATFORM_INITIAL_EMAIL=%s\n' "$PLATFORM_INITIAL_EMAIL"
    printf 'PLATFORM_INITIAL_PASSWORD=%s\n' "$PLATFORM_INITIAL_PASSWORD"
  fi
} > "$installation_env"
unset ADMIN_INITIAL_EMAIL ADMIN_INITIAL_PASSWORD PLATFORM_INITIAL_EMAIL PLATFORM_INITIAL_PASSWORD
"${compose[@]}" up -d --wait mysql
"${compose[@]}" run -T --rm --no-deps --entrypoint php \
  --volume "$installation_env:/run/peanut/installation.env:ro" \
  --env PEANUT_INSTALLATION_ENV_FILE=/run/peanut/installation.env \
  php server/database/install.php </dev/null
rm -f "$installation_env"
installation_env=""
"${compose[@]}" run -T --rm --no-deps --entrypoint php php server/database/install.php --migrate --target-version="$migration_target_version" </dev/null
"${compose[@]}" run -T --rm --no-deps --entrypoint php php server/database/environment-guard.php --current </dev/null
"${compose[@]}" run -T --rm --no-deps --entrypoint php php server/think plugin:reconcile --release-locked </dev/null
demo_mode_enabled=0
if sudo -n grep -Fqx 'PEANUT_DEMO_MODE=enabled' server/.env; then
  demo_mode_enabled=1
fi
if [[ "$deployment_mode" == multi-tenant && "$demo_mode_enabled" == 1 && -n "$expected_overlay_sha" ]]; then
  demo_result="$("${compose[@]}" run -T --rm --no-deps --entrypoint php php server/database/seed-multi-tenant-demo.php --apply </dev/null)"
  printf '%s\n' "$demo_result"
  tenant_a_id="$(printf '%s' "$demo_result" | jq -r '.tenant_a_id // empty')"
  tenant_b_id="$(printf '%s' "$demo_result" | jq -r '.tenant_b_id // empty')"
  [[ "$tenant_a_id" =~ ^[1-9][0-9]*$ && "$tenant_b_id" =~ ^[1-9][0-9]*$ ]] || fail 'demo Tenant seed returned invalid identifiers'
  "${compose[@]}" run -T --rm --no-deps --entrypoint php php server/think tenant-module:apply-profile demo </dev/null
  for tenant_id in "$tenant_a_id" "$tenant_b_id"; do
    seed_env="$(mktemp /tmp/peanut-admin-demo-seed.XXXXXX.env)"
    chmod 600 "$seed_env"
    printf 'PEANUT_DEMO_TENANT_ID=%s\n' "$tenant_id" > "$seed_env"
    "${compose[@]}" run -T --rm --no-deps --entrypoint php \
      --volume "$seed_env:/run/peanut/demo-seed.env:ro" \
      --env PEANUT_INSTALLATION_ENV_FILE=/run/peanut/demo-seed.env \
      php server/database/seed-demo-data.php --apply </dev/null
    rm -f "$seed_env"
    seed_env=""
  done
elif [[ -n "$expected_overlay_sha" ]]; then
  fail 'demo overlay requires persistent PEANUT_DEMO_MODE=enabled in server/.env'
fi
"${compose[@]}" up -d --wait
"${compose[@]}" ps

curl --fail --silent --show-error --retry 12 --retry-delay 2 "http://127.0.0.1:${port}/healthz" >/dev/null
verify_running_image_bindings
runtime_receipt="$(sudo -n docker exec "${project}-php-1" cat /var/www/peanut-admin/DEPLOYMENT_RECEIPT.json)" \
  || fail 'running PHP container deployment receipt is unavailable after deployment'
[[ "$(cat "$root/DEPLOYMENT_RECEIPT.json")" == "$runtime_receipt" ]] \
  || fail 'host and running PHP deployment receipts differ'
if [[ "$deployment_kind" == candidate ]]; then
  jq -e --arg commit "$expected_commit" --arg tree "$expected_tree" \
    --arg archive "$expected_archive_sha" --arg product "$candidate_product_version" \
    --arg schema "$scaffold_migration_version" \
    '.schema_version == 2
     and .protocol == "peanut.deployment-candidate-receipt.v1"
     and .product.version == $product
     and .source.commit == $commit
     and .source.tree == $tree
     and .source.archive_sha256 == $archive
     and .schema.migration_target == $schema
     and (.images.php | type == "string" and test("^sha256:[0-9a-f]{64}$"))
     and (.images.nginx | type == "string" and test("^sha256:[0-9a-f]{64}$"))
     and (.images.pc | type == "string" and test("^sha256:[0-9a-f]{64}$"))' \
    "$root/DEPLOYMENT_RECEIPT.json" >/dev/null \
    || fail 'candidate host/runtime receipt identity is incomplete'
  printf 'deployed_candidate_commit=%s\ncandidate_tree=%s\nproduct_version=%s\nschema_version=%s\n' \
    "$expected_commit" "$expected_tree" "$candidate_product_version" "$scaffold_migration_version"
else
  runtime_version="$(curl --fail --silent --show-error "http://127.0.0.1:${port}/legal/RELEASE_METADATA.json" | jq -r 'if .schema_version == 2 and .protocol == "peanut.release-metadata.v2" then (.instance_version // .source_product_version // empty) else .version // empty end')"
  [[ "$runtime_version" == "${tag#v}" ]] || fail "runtime metadata is $runtime_version, expected ${tag#v}"
  printf 'deployed_tag=%s\ncommit=%s\nruntime_version=%s\ntarget=%s\n' "$tag" "$actual_commit" "$runtime_version" "$target"
fi
if [[ -n "$expected_overlay_sha" ]]; then
  printf 'demo_overlay_sha256=%s\ndemo_overlay_commit=%s\nmigration_target_version=%s\n' \
    "$expected_overlay_sha" "$(jq -r '.overlay_commit' DEMO_PATCH_METADATA.json)" "$migration_target_version"
fi
target_stopped=0
sudo -n rm -f -- "$upgrade_trust" "$deployment_receipt_file"
