#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
REGISTRY="$ROOT_DIR/resources/project-resources.json"

TAG=""
CANDIDATE_COMMIT=""
DEPLOYMENT_KIND="formal"
TARGET=""
FRESH=0
INSTALL=0
UPDATE=0
APPLY=0
DRY_RUN=0
SSH_ALIAS="oracle3"
OVERLAY=""
EDITION_PACKAGE=""
EDITION_MANIFEST=""
EDITION_MANIFEST_SHA256=""
CONFIRM_DESTROY=""
EXPECTED_COMMIT=""
EXPECTED_TREE=""
PAIRED_BACKUP_ID=""
PAIRED_BACKUP_MANIFEST_SHA256=""
ENV_FILE=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
PLATFORM_EMAIL=""
PLATFORM_PASSWORD=""
DEMO_MODE="disabled"
DEMO_MODE_SET=0
DEMO_TENANT_A_EMAIL=""
DEMO_TENANT_B_EMAIL=""
DEMO_SHARED_PASSWORD=""
DEMO_TENANT_A_HOST=""
DEMO_TENANT_B_HOST=""
DEMO_DOCS_URL=""

usage() {
  cat <<'EOF'
Usage: scripts/deploy-release <vX.Y.Z> --target <production|production-candidate> \
  (--install | --update | --fresh) [--apply | --dry-run] [--ssh-alias <alias>] \
  [--expected-commit <sha1> --expected-tree <sha1>] \
  [--env-file <permission-0600-file>] \
  [--edition-package <installer.tar.gz> --edition-manifest <manifest.json>] \
  [--overlay <demo-patch.tar>] \
  [--confirm-destroy <target>] [--paired-backup <id> \
  --paired-backup-manifest-sha256 <sha256>]

Usage: scripts/deploy-release --candidate-commit=<full-sha1> \
  --expected-tree=<full-tree-sha1> --target <production|production-candidate> \
  (--install | --update | --fresh) [--apply | --dry-run] [--ssh-alias <alias>] \
  [--env-file <permission-0600-file>] \
  [--confirm-destroy <target>] [--paired-backup <id> \
  --paired-backup-manifest-sha256 <sha256>]

The script deploys either an immutable release tag or a clean, committed
development candidate to one registered Peanut Admin instance. These paths are
mutually exclusive. It never guesses a host, path, port, database or fallback target.
Before image construction it writes a non-secret DEPLOYMENT_RECEIPT.json into
the staged source so runtime status and backup evidence use the deployed
tag/commit/tree instead of the pre-qualification embedded metadata.

  --install  first installation; never removes an existing database or volume
  --update   routine application update; preserves database and upload volumes
  --fresh    destructive reinstall; explicit confirmation and paired backup are required
  --dry-run  validate the release and print the exact remote plan only
  --apply    execute the plan over the registered SSH alias
  --overlay  apply a checked demo-only source overlay before building
  --edition-package
             deploy the selected Edition installer instead of the source archive
  --edition-manifest
             external manifest shipped beside --edition-package
  --confirm-destroy
             required for --fresh; value must exactly equal the target
  --expected-commit, --expected-tree
             pin a caller-bound release commit and tree; both are required together
  --candidate-commit
             deploy this exact committed development source; requires --expected-tree
             and is mutually exclusive with a formal tag
  --paired-backup, --paired-backup-manifest-sha256
             identify the exact paired DB/files backup required by --fresh; no
             directory ordering or newest-backup inference is used

Routine updates preserve the database and apply append-only application
migrations from server/database/migrations. Fresh installation uses the
canonical v3.0 baseline; Plugin Module migrations retain their independent
lifecycle.
EOF
}

fail() {
  printf 'deploy-release: %s\n' "$1" >&2
  exit 1
}

validate_env_value() {
  local name="$1" value="$2"
  [[ -z "$value" || "$value" =~ ^[A-Za-z0-9@._:/!+=,-]+$ ]] \
    || fail "$name contains characters that cannot be written safely to the deployment .env"
}

normalize_email() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]'
}

validate_email() {
  local name="$1" value="$2" local_part domain label
  local labels=()
  [[ ${#value} -le 254 && "$value" == *@* && "$value" != *@*@* ]] \
    || fail "$name must be a valid email address"
  local_part="${value%@*}"
  domain="${value#*@}"
  [[ ${#local_part} -le 64
    && "$local_part" =~ ^[A-Za-z0-9.!+_-]+$
    && "$local_part" != .* && "$local_part" != *.
    && "$local_part" != *..* ]] || fail "$name must be a valid email address"
  [[ "$domain" != .* && "$domain" != *. && "$domain" != *..* ]] \
    || fail "$name must be a valid email address"
  IFS='.' read -r -a labels <<<"$domain"
  [[ ${#labels[@]} -ge 2 ]] || fail "$name must be a valid email address"
  for label in "${labels[@]}"; do
    [[ ${#label} -le 63 && "$label" =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?$ ]] \
      || fail "$name must be a valid email address"
  done
}

validate_password() {
  local name="$1" value="$2"
  if [[ "$DEMO_MODE" == enabled && "$value" == peanut1234 ]]; then
    return 0
  fi
  [[ ${#value} -ge 12 ]] \
    || fail "$name must be at least 12 characters"
}

validate_host() {
  local name="$1" value="$2" label
  local labels=()
  [[ ${#value} -le 253
    && "$value" == "$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')"
    && "$value" != .* && "$value" != *. && "$value" != *..* ]] \
    || fail "$name must be a normalized lowercase Host"
  IFS='.' read -r -a labels <<<"$value"
  [[ ${#labels[@]} -ge 2 ]] || fail "$name must be a valid DNS Host"
  for label in "${labels[@]}"; do
    [[ ${#label} -le 63 && "$label" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?$ ]] \
      || fail "$name must be a valid DNS Host"
  done
}

validate_http_url() {
  local name="$1" value="$2" authority host port
  case "$value" in
    http://*) authority="${value#http://}" ;;
    https://*) authority="${value#https://}" ;;
    *) fail "$name must be an HTTP(S) URL" ;;
  esac
  authority="${authority%%/*}"
  [[ -n "$authority" && "$authority" != *@* ]] || fail "$name must be an HTTP(S) URL"
  host="${authority%%:*}"
  validate_host "$name Host" "$host"
  if [[ "$authority" == *:* ]]; then
    port="${authority##*:}"
    [[ "$port" =~ ^[0-9]{1,5}$ && 10#$port -ge 1 && 10#$port -le 65535 ]] \
      || fail "$name contains an invalid port"
  fi
}

if [[ $# -eq 0 ]]; then
  usage >&2
  exit 64
fi
if [[ "$1" == --help || "$1" == -h ]]; then
  usage
  exit 0
fi
case "$1" in
  --candidate-commit=*)
    CANDIDATE_COMMIT="${1#--candidate-commit=}"
    DEPLOYMENT_KIND="candidate"
    shift
    ;;
  --candidate-commit)
    [[ $# -ge 2 ]] || fail '--candidate-commit requires a value'
    CANDIDATE_COMMIT="$2"
    DEPLOYMENT_KIND="candidate"
    shift 2
    ;;
  *)
    TAG="$1"
    shift
    ;;
esac
while [[ $# -gt 0 ]]; do
  case "$1" in
    --target)
      [[ $# -ge 2 ]] || fail '--target requires a value'
      TARGET="$2"; shift 2 ;;
    --target=*)
      TARGET="${1#--target=}"; shift ;;
    --install) INSTALL=1; shift ;;
    --update) UPDATE=1; shift ;;
    --fresh) FRESH=1; shift ;;
    --upgrade|--from)
      fail 'use --update for a routine application update; --upgrade is deprecated' ;;
    --apply) APPLY=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    --ssh-alias)
      [[ $# -ge 2 ]] || fail '--ssh-alias requires a value'
      SSH_ALIAS="$2"; shift 2 ;;
    --admin-password)
      fail 'use --env-file for installation identities' ;;
    --env-file)
      [[ $# -ge 2 ]] || fail '--env-file requires a value'
      ENV_FILE="$2"; shift 2 ;;
    --env-file=*)
      ENV_FILE="${1#--env-file=}"; shift ;;
    --overlay)
      [[ $# -ge 2 ]] || fail '--overlay requires a value'
      OVERLAY="$2"; shift 2 ;;
    --edition-package)
      [[ $# -ge 2 ]] || fail '--edition-package requires a value'
      EDITION_PACKAGE="$2"; shift 2 ;;
    --edition-manifest)
      [[ $# -ge 2 ]] || fail '--edition-manifest requires a value'
      EDITION_MANIFEST="$2"; shift 2 ;;
    --confirm-destroy)
      [[ $# -ge 2 ]] || fail '--confirm-destroy requires a value'
      CONFIRM_DESTROY="$2"; shift 2 ;;
    --confirm-destroy=*)
      CONFIRM_DESTROY="${1#--confirm-destroy=}"; shift ;;
    --paired-backup)
      [[ $# -ge 2 ]] || fail '--paired-backup requires a value'
      PAIRED_BACKUP_ID="$2"; shift 2 ;;
    --paired-backup=*)
      PAIRED_BACKUP_ID="${1#--paired-backup=}"; shift ;;
    --paired-backup-manifest-sha256)
      [[ $# -ge 2 ]] || fail '--paired-backup-manifest-sha256 requires a value'
      PAIRED_BACKUP_MANIFEST_SHA256="$2"; shift 2 ;;
    --paired-backup-manifest-sha256=*)
      PAIRED_BACKUP_MANIFEST_SHA256="${1#--paired-backup-manifest-sha256=}"; shift ;;
    --expected-commit)
      [[ $# -ge 2 ]] || fail '--expected-commit requires a value'
      EXPECTED_COMMIT="$2"; shift 2 ;;
    --expected-commit=*)
      EXPECTED_COMMIT="${1#--expected-commit=}"; shift ;;
    --expected-tree)
      [[ $# -ge 2 ]] || fail '--expected-tree requires a value'
      EXPECTED_TREE="$2"; shift 2 ;;
    --expected-tree=*)
      EXPECTED_TREE="${1#--expected-tree=}"; shift ;;
    --help|-h) usage; exit 0 ;;
    *) usage >&2; exit 64 ;;
  esac
done

for ambient_name in \
  PEANUT_GENERATED_ADMIN_EMAIL PEANUT_GENERATED_ADMIN_PASSWORD \
  PEANUT_GENERATED_PLATFORM_EMAIL PEANUT_GENERATED_PLATFORM_PASSWORD \
  PEANUT_DEMO_MODE PEANUT_DEMO_TENANT_A_EMAIL PEANUT_DEMO_TENANT_B_EMAIL \
  PEANUT_DEMO_SHARED_PASSWORD PEANUT_DEMO_TENANT_A_HOST \
  PEANUT_DEMO_TENANT_B_HOST PEANUT_DEMO_DOCS_URL; do
  if printenv "$ambient_name" >/dev/null 2>&1; then
    fail "ambient deployment configuration is forbidden: $ambient_name"
  fi
done

if [[ -n "$ENV_FILE" ]]; then
  [[ "$ENV_FILE" == /* && -f "$ENV_FILE" && ! -L "$ENV_FILE" ]] || fail '--env-file must be an absolute regular file'
  env_mode="$(stat -f '%Lp' "$ENV_FILE" 2>/dev/null || stat -c '%a' "$ENV_FILE" 2>/dev/null || true)"
  [[ "$env_mode" == 600 ]] || fail '--env-file must have mode 0600'
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    [[ "$line" == *=* ]] || fail '--env-file contains a malformed line'
    name="${line%%=*}"
    value="${line#*=}"
    case "$name" in
      PEANUT_GENERATED_ADMIN_EMAIL) ADMIN_EMAIL="$value" ;;
      PEANUT_GENERATED_ADMIN_PASSWORD) ADMIN_PASSWORD="$value" ;;
      PEANUT_GENERATED_PLATFORM_EMAIL) PLATFORM_EMAIL="$value" ;;
      PEANUT_GENERATED_PLATFORM_PASSWORD) PLATFORM_PASSWORD="$value" ;;
      PEANUT_DEMO_MODE) DEMO_MODE="$value"; DEMO_MODE_SET=1 ;;
      PEANUT_DEMO_TENANT_A_EMAIL) DEMO_TENANT_A_EMAIL="$value" ;;
      PEANUT_DEMO_TENANT_B_EMAIL) DEMO_TENANT_B_EMAIL="$value" ;;
      PEANUT_DEMO_SHARED_PASSWORD) DEMO_SHARED_PASSWORD="$value" ;;
      PEANUT_DEMO_TENANT_A_HOST) DEMO_TENANT_A_HOST="$value" ;;
      PEANUT_DEMO_TENANT_B_HOST) DEMO_TENANT_B_HOST="$value" ;;
      PEANUT_DEMO_DOCS_URL) DEMO_DOCS_URL="$value" ;;
      *) fail "--env-file contains unsupported key: $name" ;;
    esac
  done < "$ENV_FILE"
fi

if [[ "$DEPLOYMENT_KIND" == formal ]]; then
  [[ "$TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail 'tag must be an immutable vX.Y.Z release tag'
  [[ -z "$CANDIDATE_COMMIT" ]] || fail 'formal tag deployment cannot carry --candidate-commit'
else
  [[ -z "$TAG" ]] || fail 'candidate deployment cannot carry a formal release tag'
  [[ "$CANDIDATE_COMMIT" =~ ^[a-f0-9]{40}$ ]] || fail 'candidate commit must be a full lowercase SHA-1'
fi
[[ -z "$EXPECTED_COMMIT" || "$EXPECTED_COMMIT" =~ ^[a-f0-9]{40}$ ]] || fail 'expected commit must be a full lowercase SHA-1'
[[ -z "$EXPECTED_TREE" || "$EXPECTED_TREE" =~ ^[a-f0-9]{40}$ ]] || fail 'expected tree must be a full lowercase SHA-1'
if [[ "$DEPLOYMENT_KIND" == formal ]]; then
  [[ -z "$EXPECTED_COMMIT" && -z "$EXPECTED_TREE" || -n "$EXPECTED_COMMIT" && -n "$EXPECTED_TREE" ]] \
    || fail '--expected-commit and --expected-tree must be provided together'
fi
if [[ "$DEPLOYMENT_KIND" == candidate ]]; then
  [[ -n "$EXPECTED_TREE" ]] || fail 'candidate deployment requires --expected-tree'
  [[ -z "$EXPECTED_COMMIT" || "$EXPECTED_COMMIT" == "$CANDIDATE_COMMIT" ]] \
    || fail '--expected-commit must equal --candidate-commit'
  [[ -z "$EDITION_PACKAGE" && -z "$EDITION_MANIFEST" && -z "$OVERLAY" ]] \
    || fail 'candidate deployment accepts only the exact source archive; Edition and overlay inputs are formal-release-only'
fi
[[ "$TARGET" == production || "$TARGET" == production-candidate ]] || fail 'target must be production or production-candidate'
[[ $((INSTALL + UPDATE + FRESH)) -eq 1 ]] || fail 'choose exactly one of --install, --update or --fresh'
[[ $((APPLY + DRY_RUN)) -eq 1 ]] || fail 'choose exactly one of --apply or --dry-run'
if [[ "$UPDATE" != 1 && -z "$ENV_FILE" ]]; then
  fail '--install and --fresh require --env-file for initial identities'
fi
if [[ "$FRESH" == 1 && "$CONFIRM_DESTROY" != "$TARGET" ]]; then
  fail "--fresh requires --confirm-destroy $TARGET"
fi
if [[ "$FRESH" != 1 && -n "$CONFIRM_DESTROY" ]]; then
  fail '--confirm-destroy is only valid with --fresh'
fi
if [[ "$FRESH" == 1 ]]; then
  [[ "$PAIRED_BACKUP_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] \
    || fail '--fresh requires a safe exact --paired-backup identifier'
  [[ "$PAIRED_BACKUP_MANIFEST_SHA256" =~ ^[a-f0-9]{64}$ ]] \
    || fail '--fresh requires the exact paired backup manifest SHA-256'
elif [[ -n "$PAIRED_BACKUP_ID" || -n "$PAIRED_BACKUP_MANIFEST_SHA256" ]]; then
  fail '--paired-backup and --paired-backup-manifest-sha256 are only valid with --fresh'
fi
if [[ -n "$OVERLAY" ]]; then
  [[ "$TARGET" == production-candidate ]] || fail '--overlay is allowed only for production-candidate'
  [[ -f "$OVERLAY" ]] || fail "overlay file is unavailable: $OVERLAY"
  [[ "$DEMO_MODE" == enabled ]] || fail 'overlay deployment requires PEANUT_DEMO_MODE=enabled'
  for value in "$DEMO_TENANT_A_EMAIL" "$DEMO_TENANT_B_EMAIL" "$DEMO_SHARED_PASSWORD" \
    "$DEMO_TENANT_A_HOST" "$DEMO_TENANT_B_HOST" "$DEMO_DOCS_URL"; do
    [[ -n "$value" ]] || fail 'overlay deployment is missing a required PEANUT_DEMO_* value'
  done
fi
if [[ -n "$EDITION_PACKAGE" || -n "$EDITION_MANIFEST" ]]; then
  [[ -n "$EDITION_PACKAGE" && -n "$EDITION_MANIFEST" ]] \
    || fail '--edition-package and --edition-manifest must be provided together'
  [[ -f "$EDITION_PACKAGE" && ! -L "$EDITION_PACKAGE" ]] \
    || fail "Edition installer is unavailable: $EDITION_PACKAGE"
  [[ -f "$EDITION_MANIFEST" && ! -L "$EDITION_MANIFEST" ]] \
    || fail "Edition installer manifest is unavailable: $EDITION_MANIFEST"
fi
if [[ -z "$OVERLAY" && "$DEMO_MODE" == enabled && "$UPDATE" != 1 ]]; then
  fail 'PEANUT_DEMO_MODE=enabled requires --overlay for a fresh deployment'
fi
if [[ -n "$OVERLAY" ]]; then
  [[ "$DEMO_SHARED_PASSWORD" == peanut1234 ]] \
    || fail 'demo deployments must use the fixed demo password peanut1234'
  ADMIN_PASSWORD="$DEMO_SHARED_PASSWORD"
  PLATFORM_PASSWORD="$DEMO_SHARED_PASSWORD"
fi
[[ -f "$REGISTRY" ]] || fail "missing resource registry: $REGISTRY"
command -v git >/dev/null || fail 'git is required'
command -v jq >/dev/null || fail 'jq is required'
command -v shasum >/dev/null || fail 'shasum is required'
if [[ -n "$EDITION_MANIFEST" ]]; then
  EDITION_MANIFEST_SHA256="$(shasum -a 256 "$EDITION_MANIFEST" | awk '{print $1}')"
fi
[[ -x "$ROOT_DIR/scripts/check-release-consistency" ]] || fail 'missing release consistency gate'

cd "$ROOT_DIR"
git diff --quiet || fail 'source checkout has unstaged changes'
git diff --cached --quiet || fail 'source checkout has staged changes'
[[ -z "$(git ls-files --others --exclude-standard)" ]] || fail 'source checkout has untracked files'

target_json() {
  jq -e --arg id "$1" '.. | objects | select(.stable_resource_id == $id)' "$REGISTRY"
}

deployment_id="peanut-admin-${TARGET}-deployment"
database_id="$(target_json "$deployment_id" | jq -r '.database_resource_id')"
compose_project="$(target_json "$deployment_id" | jq -r '.compose_project')"
remote_root="$(target_json "$deployment_id" | jq -r '.deployment_root')"
origin_port="$(target_json "$deployment_id" | jq -r '.runtime_resource_ids[0] as $x | .. | objects | select(.stable_resource_id == $x) | .published_endpoint.port')"
deployment_mode="$(target_json "$deployment_id" | jq -r '.required_non_secret_environment.DEPLOYMENT_MODE // "multi-tenant"')"
application_resource_id="$(target_json "$deployment_id" | jq -r '.runtime_resource_ids[0]')"
if [[ "$TARGET" == production && "$DEPLOYMENT_KIND" == formal ]]; then
  "$ROOT_DIR/scripts/check-release-consistency" --tag "$TAG" --remote origin \
    || fail "production release identity is not closed for $TAG"
fi

if [[ "$TARGET" == production ]]; then
  deployment_mode="standalone"
  origin_port="$(target_json peanut-admin-production-application-containers | jq -r '.published_endpoint.port')"
else
  deployment_mode="multi-tenant"
  origin_port="$(target_json peanut-admin-production-candidate-application-containers | jq -r '.published_endpoint.port')"
fi
[[ "$database_id" != null && "$compose_project" != null && "$remote_root" != null && "$origin_port" != null ]] || fail "incomplete registry entry for $deployment_id"
if [[ -n "$OVERLAY" ]]; then
  domains_json="$(target_json peanut-admin-production-candidate-domains)"
  jq -e --arg host "$DEMO_TENANT_A_HOST" \
    '.tenant_entry_bindings[$host] == "tenant-a/admin-web"' <<<"$domains_json" >/dev/null \
    || fail 'Tenant A demo Host does not match the registered binding plan'
  jq -e --arg host "$DEMO_TENANT_B_HOST" \
    '.tenant_entry_bindings[$host] == "tenant-b/admin-web"' <<<"$domains_json" >/dev/null \
    || fail 'Tenant B demo Host does not match the registered binding plan'
fi

if [[ "$DEPLOYMENT_KIND" == formal ]]; then
  if ! git rev-parse --verify --quiet "$TAG^{tag}" >/dev/null; then
    git fetch --quiet origin "refs/tags/$TAG:refs/tags/$TAG" || fail "cannot fetch $TAG from origin"
  fi
  [[ "$(git cat-file -t "$TAG" 2>/dev/null || true)" == tag ]] || fail "$TAG is not an annotated tag"
  tag_commit="$(git rev-parse "$TAG^{commit}")"
  remote_commit="$(git ls-remote --tags origin "refs/tags/$TAG^{}" | awk 'NR == 1 { print $1 }')"
  [[ -n "$remote_commit" && "$remote_commit" == "$tag_commit" ]] || fail "$TAG local and remote commit identities differ"
  [[ -z "$EXPECTED_COMMIT" || "$tag_commit" == "$EXPECTED_COMMIT" ]] \
    || fail "$TAG commit differs from the caller-bound expected commit"
  # All release reads and the source archive use this resolved immutable commit, never the tag name again.
  release_ref="$tag_commit"
  tag_tree="$(git rev-parse "$release_ref^{tree}")"
  [[ -z "$EXPECTED_TREE" || "$tag_tree" == "$EXPECTED_TREE" ]] \
    || fail "$TAG tree differs from the caller-bound expected tree"
  version="${TAG#v}"
  metadata_version="$(git show "$release_ref:RELEASE_METADATA.json" | jq -r 'if .schema_version == 2 and .protocol == "peanut.release-metadata.v2" then (.instance_version // .source_product_version // empty) else .version // empty end')"
  metadata_source_version="$(git show "$release_ref:RELEASE_METADATA.json" | jq -r 'if .schema_version == 2 and .protocol == "peanut.release-metadata.v2" then .source_product_version // empty else empty end')"
  metadata_tag="$(git show "$release_ref:RELEASE_METADATA.json" | jq -r '.expected_tag // empty')"
  [[ "$metadata_version" == "$version" && "$metadata_tag" == "$TAG" ]] || fail "RELEASE_METADATA.json does not match $TAG"
  contract_source_version="$(git show "$release_ref:release-versions.json" | jq -r 'if .schema_version == 2 and .protocol == "peanut.release-versions.v2" then .source_product_version // empty elif .schema_version == 1 and .protocol == "peanut.release-versions.v1" then .product_release // empty else empty end')"
  contract_release_version="$(git show "$release_ref:release-versions.json" | jq -r 'if .schema_version == 2 and .protocol == "peanut.release-versions.v2" then (.instance_version // .source_product_version // empty) elif .schema_version == 1 and .protocol == "peanut.release-versions.v1" then .product_release // empty else empty end')"
  contract_schema_version="$(git show "$release_ref:release-versions.json" | jq -r '.schema_version // empty')"
  scaffold_migration_version="$(git show "$release_ref:release-versions.json" | jq -r '.scaffold_template // empty')"
  [[ "$contract_release_version" == "$version" ]] || fail "release-versions.json release sequence does not match $TAG"
  if [[ -n "$metadata_source_version" ]]; then
    [[ "$metadata_source_version" == "$contract_source_version" ]] \
      || fail 'RELEASE_METADATA.json source product version differs from release-versions.json'
  fi
  if [[ "$contract_schema_version" == 2 ]]; then
    [[ -n "$metadata_source_version" ]] \
      || fail 'v2 release-versions.json requires v2 RELEASE_METADATA.json'
  fi
  [[ "$scaffold_migration_version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] \
    || fail 'release-versions.json scaffold_template is invalid'
else
  tag_commit="$CANDIDATE_COMMIT"
  release_ref="$CANDIDATE_COMMIT"
  [[ "$(git cat-file -t "$release_ref" 2>/dev/null || true)" == commit ]] \
    || fail 'candidate commit is not available as a committed object'
  tag_tree="$(git rev-parse "$release_ref^{tree}")"
  [[ "$tag_tree" == "$EXPECTED_TREE" ]] || fail 'candidate commit tree differs from --expected-tree'
  version="$(git show "$release_ref:release-versions.json" | jq -r '.source_product_version // empty')"
  metadata_source_version="$(git show "$release_ref:RELEASE_METADATA.json" | jq -r 'if .schema_version == 2 and .protocol == "peanut.release-metadata.v2" then .source_product_version // empty else empty end')"
  [[ -n "$version" && "$version" != "$metadata_source_version" ]] \
    || fail 'candidate product identity must remain distinct from published release metadata'
  [[ "$version" == *-* ]] || fail 'candidate product identity must be a development/prerelease version'
  scaffold_migration_version="$metadata_source_version"
  [[ "$scaffold_migration_version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] \
    || fail 'candidate schema source must be a stable X.Y.Z published baseline'
  metadata_version="$metadata_source_version"
  printf 'candidate_product_version=%s\ncandidate_schema_version=%s\n' "$version" "$scaffold_migration_version"
fi
archive_kind=source
if [[ -n "$EDITION_PACKAGE" ]]; then
  archive_kind=edition
  edition_protocol="$(jq -r '.protocol // empty' "$EDITION_MANIFEST")"
  edition_name="$(jq -r '.edition.name // .edition // empty' "$EDITION_MANIFEST")"
  edition_version="$(jq -r '.product.version // empty' "$EDITION_MANIFEST")"
  edition_commit="$(jq -r '.source.commit // empty' "$EDITION_MANIFEST")"
  edition_tree="$(jq -r '.source.tree // empty' "$EDITION_MANIFEST")"
  edition_filename="$(jq -r '.archive.filename // empty' "$EDITION_MANIFEST")"
  edition_root="$(jq -r '.archive.root // empty' "$EDITION_MANIFEST")"
  edition_sha256="$(jq -r '.archive.sha256 // empty' "$EDITION_MANIFEST")"
  edition_bytes="$(jq -r '.archive.bytes // empty' "$EDITION_MANIFEST")"
  actual_edition_sha256="$(shasum -a 256 "$EDITION_PACKAGE" | awk '{print $1}')"
  actual_edition_bytes="$(wc -c < "$EDITION_PACKAGE" | tr -d ' ')"
  [[ "$edition_protocol" == peanut.edition-installer.v1
    && "$edition_name" == "$deployment_mode"
    && "$edition_version" == "$version"
    && "$edition_commit" == "$tag_commit"
    && "$edition_tree" == "$tag_tree"
    && "$edition_filename" == "$(basename "$EDITION_PACKAGE")"
    && "$edition_root" == "peanut-admin-${version}-${deployment_mode}"
    && "$edition_sha256" == "$actual_edition_sha256"
    && "$edition_bytes" == "$actual_edition_bytes" ]] \
    || fail 'Edition installer and release tag identities differ'
  tar -tzf "$EDITION_PACKAGE" | awk -v root="$edition_root/" '
    index($0, root) != 1 || $0 ~ /(^|\/)\.\.($|\/)/ { bad = 1 }
    $0 == root "compose.yaml" { compose = 1 }
    END { exit (!bad && compose) ? 0 : 1 }
  ' || fail 'Edition installer archive layout is unsafe or incomplete'
fi

if [[ "$UPDATE" != 1 && ( -z "$ADMIN_EMAIL" || -z "$ADMIN_PASSWORD" ) ]]; then
  fail 'installation env file requires PEANUT_GENERATED_ADMIN_EMAIL and PEANUT_GENERATED_ADMIN_PASSWORD'
fi
if [[ "$UPDATE" != 1 ]]; then
  validate_env_value PEANUT_GENERATED_ADMIN_EMAIL "$ADMIN_EMAIL"
  validate_env_value PEANUT_GENERATED_ADMIN_PASSWORD "$ADMIN_PASSWORD"
  validate_email PEANUT_GENERATED_ADMIN_EMAIL "$ADMIN_EMAIL"
  validate_password PEANUT_GENERATED_ADMIN_PASSWORD "$ADMIN_PASSWORD"
fi
if [[ "$UPDATE" != 1 && "$deployment_mode" == multi-tenant ]]; then
  [[ -n "$PLATFORM_EMAIL" && -n "$PLATFORM_PASSWORD" ]] \
    || fail 'fresh multi-tenant deployment requires PEANUT_GENERATED_PLATFORM_EMAIL and PEANUT_GENERATED_PLATFORM_PASSWORD'
  validate_env_value PEANUT_GENERATED_PLATFORM_EMAIL "$PLATFORM_EMAIL"
  validate_env_value PEANUT_GENERATED_PLATFORM_PASSWORD "$PLATFORM_PASSWORD"
  validate_email PEANUT_GENERATED_PLATFORM_EMAIL "$PLATFORM_EMAIL"
  validate_password PEANUT_GENERATED_PLATFORM_PASSWORD "$PLATFORM_PASSWORD"
  [[ "$(normalize_email "$ADMIN_EMAIL")" != "$(normalize_email "$PLATFORM_EMAIL")" ]] \
    || fail 'fresh multi-tenant deployment requires distinct Admin and Platform emails'
fi
if [[ -n "$OVERLAY" && "$UPDATE" == 1 ]]; then
  fail '--overlay is only valid for --install or --fresh'
fi
if [[ -n "$OVERLAY" ]]; then
  validate_env_value PEANUT_DEMO_TENANT_A_EMAIL "$DEMO_TENANT_A_EMAIL"
  validate_env_value PEANUT_DEMO_TENANT_B_EMAIL "$DEMO_TENANT_B_EMAIL"
  validate_env_value PEANUT_DEMO_SHARED_PASSWORD "$DEMO_SHARED_PASSWORD"
  validate_env_value PEANUT_DEMO_TENANT_A_HOST "$DEMO_TENANT_A_HOST"
  validate_env_value PEANUT_DEMO_TENANT_B_HOST "$DEMO_TENANT_B_HOST"
  validate_env_value PEANUT_DEMO_DOCS_URL "$DEMO_DOCS_URL"
  validate_email PEANUT_DEMO_TENANT_A_EMAIL "$DEMO_TENANT_A_EMAIL"
  validate_email PEANUT_DEMO_TENANT_B_EMAIL "$DEMO_TENANT_B_EMAIL"
  validate_password PEANUT_DEMO_SHARED_PASSWORD "$DEMO_SHARED_PASSWORD"
  validate_host PEANUT_DEMO_TENANT_A_HOST "$DEMO_TENANT_A_HOST"
  validate_host PEANUT_DEMO_TENANT_B_HOST "$DEMO_TENANT_B_HOST"
  validate_http_url PEANUT_DEMO_DOCS_URL "$DEMO_DOCS_URL"
  [[ "$DEMO_TENANT_A_HOST" != "$DEMO_TENANT_B_HOST" ]] \
    || fail 'fresh demo deployment requires distinct Tenant A and Tenant B Hosts'
  demo_emails=(
    "$(normalize_email "$ADMIN_EMAIL")"
    "$(normalize_email "$PLATFORM_EMAIL")"
    "$(normalize_email "$DEMO_TENANT_A_EMAIL")"
    "$(normalize_email "$DEMO_TENANT_B_EMAIL")"
  )
  [[ "$(printf '%s\n' "${demo_emails[@]}" | sort -u | wc -l | tr -d ' ')" == 4 ]] \
    || fail 'fresh demo deployment requires distinct default Admin, Platform, Tenant A and Tenant B emails'
fi

overlay_sha256=""
if [[ -n "$OVERLAY" ]]; then
  command -v shasum >/dev/null || fail 'shasum is required for an overlay deployment'
  overlay_sha256="$(shasum -a 256 "$OVERLAY" | awk '{print $1}')"
  [[ "$overlay_sha256" =~ ^[0-9a-f]{64}$ ]] || fail 'cannot calculate overlay SHA-256'
fi

mode=install
[[ "$UPDATE" == 1 ]] && mode=update
[[ "$FRESH" == 1 ]] && mode=fresh
printf 'release=%s\ncommit=%s\nscaffold_migration_version=%s\ntarget=%s\nmode=%s\nssh=%s\nremote_root=%s\ncompose_project=%s\norigin_port=%s\ndatabase_resource=%s\ndeployment_mode=%s\n' \
  "${TAG:-candidate:$tag_commit}" "$tag_commit" "$scaffold_migration_version" "$TARGET" "$mode" "$SSH_ALIAS" "$remote_root" "$compose_project" "$origin_port" "$database_id" "$deployment_mode"
printf 'deployment_artifact=%s\n' "$archive_kind"
[[ -z "$overlay_sha256" ]] || printf 'overlay_sha256=%s\n' "$overlay_sha256"
if [[ "$DEPLOYMENT_KIND" == candidate ]]; then
  printf 'deployment_identity=candidate\nproduct_version=%s\nschema_source=%s\n' "$version" "$scaffold_migration_version"
fi

if [[ "$DRY_RUN" == 1 ]]; then
  case "$mode" in
    install) printf 'plan=validate candidate, build PHP/NGINX/PC images, install the stable schema baseline into an empty target, start the stack, health smoke\n' ;;
    update) printf 'plan=validate running target, build PHP/NGINX/PC images while it remains available, replace only changed application containers with up -d, health smoke\n' ;;
    fresh) printf 'plan=validate the exact paired DB/files backup, build PHP/NGINX/PC images and empty-database preflight, then stop target, remove only registered volumes, install baseline, health smoke\n'; printf 'warning=--fresh is destructive and requires --confirm-destroy=%s plus a verified exact paired backup\n' "$TARGET" ;;
  esac
  exit 0
fi

[[ "$APPLY" == 1 ]] || fail 'pass --apply to execute the deployment'
command -v ssh >/dev/null || fail 'ssh is required for --apply'
command -v scp >/dev/null || fail 'scp is required for --apply'
SSH_KEEPALIVE_OPTS=(-o ServerAliveInterval=15 -o ServerAliveCountMax=120)

archive_file="$(mktemp -t peanut-admin-release.XXXXXX.tar)"
archive_sha256=""
remote_archive="/tmp/peanut-admin-${version}-$$.tar"
secrets_file="$(mktemp -t peanut-admin-deploy-secrets.XXXXXX.env)"
remote_secrets="/tmp/peanut-admin-deploy-secrets-$$.env"
remote_overlay=""
trap 'rm -f "$archive_file" "$secrets_file"' EXIT
if [[ "$archive_kind" == edition ]]; then
  cp "$EDITION_PACKAGE" "$archive_file"
else
  git archive --format=tar "$release_ref" -o "$archive_file"
fi
archive_sha256="$(shasum -a 256 "$archive_file" | awk '{print $1}')"
[[ "$archive_sha256" =~ ^[0-9a-f]{64}$ ]] || fail 'cannot calculate release archive SHA-256'
encode_remote_arg() {
  [[ -n "$1" ]] && printf '%s' "$1" || printf '__PEANUT_EMPTY__'
}
umask 077
{
  printf 'ADMIN_INITIAL_EMAIL=%q\n' "$ADMIN_EMAIL"
  printf 'ADMIN_INITIAL_PASSWORD=%q\n' "$ADMIN_PASSWORD"
  if [[ "$deployment_mode" == multi-tenant ]]; then
    printf 'PLATFORM_INITIAL_EMAIL=%q\n' "$PLATFORM_EMAIL"
    printf 'PLATFORM_INITIAL_PASSWORD=%q\n' "$PLATFORM_PASSWORD"
  fi
  printf 'PEANUT_DEMO_MODE=%q\n' "$DEMO_MODE"
  printf 'DEMO_MODE_SET=%q\n' "$DEMO_MODE_SET"
  printf 'PEANUT_DEMO_TENANT_A_EMAIL=%q\n' "$DEMO_TENANT_A_EMAIL"
  printf 'PEANUT_DEMO_TENANT_B_EMAIL=%q\n' "$DEMO_TENANT_B_EMAIL"
  printf 'PEANUT_DEMO_SHARED_PASSWORD=%q\n' "$DEMO_SHARED_PASSWORD"
  printf 'PEANUT_DEMO_TENANT_A_HOST=%q\n' "$DEMO_TENANT_A_HOST"
  printf 'PEANUT_DEMO_TENANT_B_HOST=%q\n' "$DEMO_TENANT_B_HOST"
  printf 'PEANUT_DEMO_DOCS_URL=%q\n' "$DEMO_DOCS_URL"
} >"$secrets_file"
scp "${SSH_KEEPALIVE_OPTS[@]}" -q "$archive_file" "$SSH_ALIAS:$remote_archive" || fail 'cannot transfer immutable release archive'
scp "${SSH_KEEPALIVE_OPTS[@]}" -q "$secrets_file" "$SSH_ALIAS:$remote_secrets" || fail 'cannot transfer deployment credential payload'
if [[ -n "$OVERLAY" ]]; then
  remote_overlay="/tmp/peanut-admin-demo-overlay-$$.tar"
  scp "${SSH_KEEPALIVE_OPTS[@]}" -q "$OVERLAY" "$SSH_ALIAS:$remote_overlay" || fail 'cannot transfer demo overlay'
fi

# The registered deployment roots are root-owned (0700) on oracle3.  Execute the
# remote control script through the registered non-interactive sudo boundary so
# its preflight, Compose and filesystem operations all observe the same target.
ssh -o BatchMode=yes "${SSH_KEEPALIVE_OPTS[@]}" "$SSH_ALIAS" sudo -n bash -s -- \
  "$DEPLOYMENT_KIND" "$TAG" "$tag_commit" "$tag_tree" "$TARGET" "$mode" "$remote_root" "$compose_project" "$origin_port" "$database_id" "$application_resource_id" "$deployment_mode" "$remote_archive" "$remote_secrets" "$(encode_remote_arg "$remote_overlay")" "$(encode_remote_arg "$overlay_sha256")" "$archive_sha256" "$archive_kind" "$scaffold_migration_version" "$(encode_remote_arg "$EDITION_MANIFEST_SHA256")" "$(encode_remote_arg "$PAIRED_BACKUP_ID")" "$(encode_remote_arg "$PAIRED_BACKUP_MANIFEST_SHA256")" "$version" <<'REMOTE_SCRIPT'
set -Eeuo pipefail

decode_remote_arg() {
  [[ "$1" == __PEANUT_EMPTY__ ]] && printf '' || printf '%s' "$1"
}

deployment_kind="$1"
tag="$2"
expected_commit="$3"
expected_tree="$4"
target="$5"
mode="$6"
root="$7"
project="$8"
port="$9"
database_resource="${10}"
application_resource="${11}"
deployment_mode="${12}"
archive="${13}"
secrets="${14}"
overlay="$(decode_remote_arg "${15:-__PEANUT_EMPTY__}")"
expected_overlay_sha="$(decode_remote_arg "${16:-__PEANUT_EMPTY__}")"
expected_archive_sha="${17:-}"
archive_kind="${18:-}"
scaffold_migration_version="${19:-}"
edition_manifest_sha="$(decode_remote_arg "${20:-__PEANUT_EMPTY__}")"
paired_backup_id="$(decode_remote_arg "${21:-__PEANUT_EMPTY__}")"
paired_backup_manifest_sha="$(decode_remote_arg "${22:-__PEANUT_EMPTY__}")"
candidate_product_version="${23:-}"
version="${candidate_product_version:-${tag#v}}"
migration_target_version="$scaffold_migration_version"
overlay_commit=""
overlay_metadata_sha=""

fail() { printf 'remote deploy: %s\n' "$1" >&2; exit 1; }
version_greater_than() {
  local left="$1" right="$2"
  local left_major left_minor left_patch right_major right_minor right_patch
  IFS=. read -r left_major left_minor left_patch <<<"$left"
  IFS=. read -r right_major right_minor right_patch <<<"$right"
  (( 10#$left_major > 10#$right_major )) && return 0
  (( 10#$left_major < 10#$right_major )) && return 1
  (( 10#$left_minor > 10#$right_minor )) && return 0
  (( 10#$left_minor < 10#$right_minor )) && return 1
  (( 10#$left_patch > 10#$right_patch ))
}
[[ "$target" == production || "$target" == production-candidate ]] || fail 'unregistered deployment target'
[[ "$mode" == install || "$mode" == update || "$mode" == fresh ]] || fail 'unregistered deployment mode'
[[ "$archive_kind" == source || "$archive_kind" == edition ]] || fail 'unregistered deployment artifact kind'
if [[ "$target:$root:$project:$port:$database_resource:$deployment_mode:$application_resource" == \
      production:/www/docker/peanut-admin:peanut-admin:18092:peanut-admin-production-bundled-mysql84:standalone:peanut-admin-production-application-containers ]]; then
  :
elif [[ "$target:$root:$project:$port:$database_resource:$deployment_mode:$application_resource" == \
      production-candidate:/www/docker/peanut-admin-candidate:peanut-admin-candidate:18093:peanut-admin-production-candidate-mysql84:multi-tenant:peanut-admin-production-candidate-application-containers ]]; then
  [[ "$mode" == fresh ]] || fail 'production-candidate is registered as fresh-only'
else
  fail 'deployment target selectors do not form a registered tuple'
fi
if [[ "$deployment_kind" == formal ]]; then
  [[ "$tag" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail 'formal remote identity is invalid'
else
  [[ -z "$tag" && "$candidate_product_version" == *-* ]] || fail 'candidate remote identity is invalid'
fi
[[ "$expected_commit" =~ ^[0-9a-f]{40}$ && "$expected_tree" =~ ^[0-9a-f]{40}$ ]] \
  || fail 'release commit/tree identity is invalid'
if [[ "$archive_kind" == edition ]]; then
  [[ "$edition_manifest_sha" =~ ^[0-9a-f]{64}$ ]] || fail 'Edition manifest identity is invalid'
else
  [[ -z "$edition_manifest_sha" ]] || fail 'source deployment cannot carry an Edition manifest identity'
fi
[[ "$scaffold_migration_version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] \
  || fail 'unregistered scaffold migration version'
if [[ "$mode" == fresh ]]; then
  [[ "$paired_backup_id" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$ ]] \
    || fail 'fresh remote identity is missing an exact paired backup id'
  [[ "$paired_backup_manifest_sha" =~ ^[0-9a-f]{64}$ ]] \
    || fail 'fresh remote identity is missing an exact paired backup manifest digest'
fi
[[ -d "$root" && -f "$root/compose.yaml" && -f "$root/.env" && -f "$root/server/.env" ]] \
  || fail "deployment files or split environments are missing under $root"
[[ -f "$secrets" ]] || fail 'deployment credential payload is missing'
chmod 600 "$secrets"
set -a
# shellcheck disable=SC1090
source "$secrets"
set +a
rm -f "$secrets"

cd "$root"
sudo -n grep -Fqx "HTTP_PORT=$port" .env || fail '.env origin port mismatch'
if sudo -n grep -Eq '^(APP_|DB_|JWT_|DEPLOYMENT_MODE=|PUBLIC_DEFAULT_TENANT_FALLBACK=|PLATFORM_|TENANT_|ADMIN_|OWNER_INVITATION_|PEANUT_(DEPLOYMENT_TARGET|DATABASE_|STORAGE_|DEMO_|MODULE_))' .env; then
  fail 'root .env contains backend configuration'
fi
sudo -n grep -Fqx "PEANUT_DEPLOYMENT_TARGET=$target" server/.env || fail 'server/.env deployment target mismatch'
sudo -n grep -Fqx "PEANUT_DATABASE_RESOURCE_ID=$database_resource" server/.env || fail 'server/.env database resource mismatch'
sudo -n grep -Fqx "DEPLOYMENT_MODE=$deployment_mode" server/.env || fail 'server/.env deployment mode mismatch'

read_env_value() {
  local file="$1" key="$2"
  sudo -n awk -v key="$key" 'index($0, key "=") == 1 { print substr($0, length(key) + 2); exit }' "$file"
}
public_scheme="$(read_env_value .env PEANUT_PUBLIC_SCHEME)"
trusted_hosts="$(read_env_value .env PEANUT_TRUSTED_HOSTS)"
[[ "$public_scheme" == http || "$public_scheme" == https ]] \
  || fail 'PEANUT_PUBLIC_SCHEME must be an explicit http or https value in root .env'
[[ -n "$trusted_hosts" && "$trusted_hosts" != *'*'* ]] \
  || fail 'PEANUT_TRUSTED_HOSTS must be explicit non-wildcard host names in root .env'
IFS=',' read -r -a trusted_host_list <<<"$trusted_hosts"
[[ ${#trusted_host_list[@]} -gt 0 ]] || fail 'PEANUT_TRUSTED_HOSTS is empty'
for trusted_host in "${trusted_host_list[@]}"; do
  trusted_host="${trusted_host## }"; trusted_host="${trusted_host%% }"
  [[ "$trusted_host" =~ ^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$ ]] \
    || fail 'PEANUT_TRUSTED_HOSTS contains a non-DNS or wildcard host'
done

current_compose=(sudo -n env -i "PATH=$PATH" "HOME=$HOME" "PEANUT_SERVER_ENV_FILE=$root/server/.env" "PEANUT_DEPLOYMENT_RECEIPT_FILE=$root/DEPLOYMENT_RECEIPT.json" docker compose --env-file .env --env-file server/.env -p "$project" -f compose.yaml --profile bundled-db)
"${current_compose[@]}" config >/dev/null || fail 'Compose configuration is invalid'
if [[ "$mode" == update ]]; then
  [[ -f DEPLOYMENT_RECEIPT.json && ! -L DEPLOYMENT_RECEIPT.json ]] \
    || fail 'routine update requires a deployment receipt from the running release'
  jq -e --arg target "$target" '
    .schema_version == 1
    and .protocol == "peanut.deployment-receipt.v1"
    and .target == $target
    and (.release.tag | type == "string" and test("^v[0-9]+\\.[0-9]+\\.[0-9]+$"))
    and (.release.commit | type == "string" and test("^[a-f0-9]{40}$"))
    and (.release.tree | type == "string" and test("^[a-f0-9]{40}$"))
  ' DEPLOYMENT_RECEIPT.json >/dev/null || fail 'running deployment receipt is invalid'
  running_receipt="$(sudo -n docker exec "${project}-php-1" cat /var/www/peanut-admin/DEPLOYMENT_RECEIPT.json)" \
    || fail 'running PHP container deployment receipt is unavailable'
  [[ "$(cat DEPLOYMENT_RECEIPT.json)" == "$running_receipt" ]] \
    || fail 'deployment root and running PHP container identities differ'
  current_tag="$(jq -r '.release.tag' DEPLOYMENT_RECEIPT.json)"
  current_version="${current_tag#v}"
  current_scaffold_version="$(jq -r '.scaffold_template // empty' release-versions.json)"
  [[ "$current_scaffold_version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] \
    || fail 'routine update requires a valid current scaffold identity'
  if version_greater_than "$current_scaffold_version" "$scaffold_migration_version"; then
    fail "scaffold downgrade ${current_scaffold_version} -> ${scaffold_migration_version} is forbidden"
  fi
  current_scaffold_major="${current_scaffold_version%%.*}"
  target_scaffold_major="${scaffold_migration_version%%.*}"
  [[ "$current_scaffold_major" == "$target_scaffold_major" ]] \
    || fail "scaffold major change ${current_scaffold_version} -> ${scaffold_migration_version} requires --fresh"
  [[ "$(printf '%s\n%s\n' "$current_version" "$version" | sort -V | tail -n 1)" == "$version" && "$current_version" != "$version" ]] || fail "target release ${tag} must be newer than current ${current_tag}"
  running_services="$("${current_compose[@]}" ps --status running --services | sort | tr '\n' ' ')"
  [[ "$running_services" == *php* && "$running_services" == *nginx* && "$running_services" == *cron* ]] \
    || fail 'routine update requires the existing application services to be running'
elif [[ "$mode" == install ]]; then
  if sudo -n docker volume inspect "${project}_mysql-data" "${project}_php-storage" >/dev/null 2>&1; then
    fail 'first installation requires absent database and upload volumes; use --update or an explicitly backed-up --fresh'
  fi
fi

[[ -f "$archive" && "$expected_archive_sha" =~ ^[0-9a-f]{64}$ ]] \
  || fail 'immutable release archive identity is incomplete'
actual_archive_sha="$(sha256sum "$archive" | awk '{print $1}')"
[[ "$actual_archive_sha" == "$expected_archive_sha" ]] || fail 'immutable release archive SHA-256 mismatch'

staging="$(mktemp -d /tmp/peanut-admin-release.XXXXXX)"
if [[ "$archive_kind" == edition ]]; then
  sudo -n tar --no-same-owner -xzf "$archive" --strip-components=1 -C "$staging" \
    || fail 'cannot unpack immutable Edition installer'
else
  sudo -n tar --no-same-owner -xf "$archive" -C "$staging" \
    || fail 'cannot unpack immutable source release archive'
fi
if [[ -n "$overlay" ]]; then
  [[ -f "$overlay" && "$expected_overlay_sha" =~ ^[0-9a-f]{64}$ ]] || fail 'demo overlay identity is incomplete'
  actual_overlay_sha="$(sha256sum "$overlay" | awk '{print $1}')"
  [[ "$actual_overlay_sha" == "$expected_overlay_sha" ]] || fail 'demo overlay SHA-256 mismatch'
  sudo -n tar --no-same-owner -xf "$overlay" -C "$staging" || fail 'cannot unpack demo overlay'
  overlay_metadata="$staging/DEMO_PATCH_METADATA.json"
  jq -e --arg tag "$tag" --arg commit "$expected_commit" '
    .schema_version == 1
    and .kind == "peanut-admin-demo-site-overlay"
    and .base_tag == $tag
    and .base_commit == $commit
    and (.overlay_commit | type == "string" and test("^[0-9a-f]{40}$"))
    and (.migration_target_version | type == "string")
    and (.files | type == "array")
  ' "$overlay_metadata" >/dev/null || fail 'demo overlay metadata identity is invalid'
  overlay_base_tag="$(jq -r '.base_tag // empty' "$overlay_metadata")"
  [[ "$overlay_base_tag" == "$tag" ]] || fail 'demo overlay targets another base release'
  overlay_commit="$(jq -r '.overlay_commit // empty' "$overlay_metadata")"
  overlay_metadata_sha="$(sha256sum "$overlay_metadata" | awk '{print $1}')"
  migration_target_version="$(jq -r '.migration_target_version // empty' "$overlay_metadata")"
  [[ "$migration_target_version" =~ ^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$ ]] \
    || fail 'demo overlay migration target version is invalid'
  if version_greater_than "$scaffold_migration_version" "$migration_target_version"; then
    fail 'demo overlay migration target version predates its base scaffold'
  fi
  computed_migration_target="$scaffold_migration_version"
  while IFS= read -r migration_path; do
    [[ "$migration_path" =~ ^server/database/migrations/[0-9]{8}-[a-z0-9][a-z0-9_-]*\.sql$ ]] \
      || fail 'demo overlay contains an invalid migration path'
    [[ -f "$staging/$migration_path" ]] || fail 'demo overlay migration file is unavailable'
    markers="$(sed -nE 's/^[[:space:]]*--[[:space:]]*peanut-release:[[:space:]]*((0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*))[[:space:]]*$/\1/p' "$staging/$migration_path")"
    [[ "$(printf '%s\n' "$markers" | sed '/^$/d' | wc -l | tr -d ' ')" == 1 ]] \
      || fail 'demo overlay migration must contain exactly one peanut-release marker'
    marker="$(printf '%s\n' "$markers" | sed '/^$/d')"
    if version_greater_than "$marker" "$computed_migration_target"; then
      computed_migration_target="$marker"
    fi
  done < <(jq -r '.files[].path | select(startswith("server/database/migrations/"))' "$overlay_metadata")
  [[ "$migration_target_version" == "$computed_migration_target" ]] \
    || fail 'demo overlay migration target version does not match its migration files'
fi

receipt_overlay='null'
if [[ -n "$expected_overlay_sha" ]]; then
  receipt_overlay="$(jq -n \
    --arg commit "$overlay_commit" \
    --arg archive_sha256 "$expected_overlay_sha" \
    --arg metadata_sha256 "$overlay_metadata_sha" \
    '{commit:$commit,archive_sha256:$archive_sha256,metadata_sha256:$metadata_sha256}')"
fi
receipt_tmp="$staging/DEPLOYMENT_RECEIPT.json.tmp"
if [[ "$deployment_kind" == candidate ]]; then
  jq -n \
    --arg target "$target" \
    --arg product_version "$candidate_product_version" \
    --arg schema_version "$scaffold_migration_version" \
    --arg commit "$expected_commit" \
    --arg tree "$expected_tree" \
    --arg archive_sha256 "$expected_archive_sha" \
    --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{
      schema_version:2,
      protocol:"peanut.deployment-candidate-receipt.v1",
      target:$target,
      product:{version:$product_version,identity:"development-candidate"},
      schema:{migration_target:$schema_version,source:"published-release-metadata"},
      source:{commit:$commit,tree:$tree,archive_sha256:$archive_sha256},
      images:null,
      generated_at:$generated_at
    }' >"$receipt_tmp"
else
  jq -n \
    --arg target "$target" \
    --arg edition "$deployment_mode" \
    --arg tag "$tag" \
    --arg commit "$expected_commit" \
    --arg tree "$expected_tree" \
    --arg kind "$archive_kind" \
    --arg archive_sha256 "$expected_archive_sha" \
    --arg manifest_sha256 "$edition_manifest_sha" \
    --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson overlay "$receipt_overlay" \
    '{
      schema_version:1,
      protocol:"peanut.deployment-receipt.v1",
      target:$target,
      edition:$edition,
      release:{tag:$tag,commit:$commit,tree:$tree},
      artifact:{
        kind:$kind,
        archive_sha256:$archive_sha256,
        manifest_sha256:(if $manifest_sha256=="" then null else $manifest_sha256 end)
      },
      overlay:$overlay,
      generated_at:$generated_at
    }' >"$receipt_tmp"
fi
chmod 0644 "$receipt_tmp"
mv -f -- "$receipt_tmp" "$staging/DEPLOYMENT_RECEIPT.json"
deployment_receipt_base64="$(base64 <"$staging/DEPLOYMENT_RECEIPT.json" | tr -d '\r\n')"
[[ -n "$deployment_receipt_base64" ]] || fail 'deployment receipt could not be encoded'

[[ -f "$staging/compose.yaml" && -f "$staging/deploy/docker-compose.prod.yml" ]] \
  || fail 'candidate Compose files are missing'
if [[ "$deployment_kind" == candidate ]]; then
  image_suffix="candidate-${expected_commit:0:12}-${expected_archive_sha:0:12}"
else
  image_suffix="${tag#v}"
fi
if [[ -n "$expected_overlay_sha" ]]; then
  image_suffix="${image_suffix}-demo-${expected_overlay_sha:0:12}"
fi
php_image="peanut-admin-php:${image_suffix}"
nginx_image="peanut-admin-nginx:${image_suffix}"
pc_image="peanut-admin-pc:${image_suffix}"
candidate_receipt_file="$root/DEPLOYMENT_RECEIPT.json"
[[ "$deployment_kind" != candidate ]] || candidate_receipt_file="$staging/DEPLOYMENT_RECEIPT.json"
candidate_compose=(
  sudo -n env -i "PATH=$PATH" "HOME=$HOME" "PHP_IMAGE=$php_image" "NGINX_IMAGE=$nginx_image" "PC_IMAGE=$pc_image"
  "PEANUT_SERVER_ENV_FILE=$root/server/.env" "PEANUT_DEPLOYMENT_RECEIPT_FILE=$candidate_receipt_file"
  "PEANUT_DEPLOYMENT_RECEIPT_BASE64=$deployment_receipt_base64"
  docker compose --env-file "$root/.env" --env-file "$root/server/.env" -p "$project"
  -f "$staging/compose.yaml" --profile bundled-db
)
"${candidate_compose[@]}" config >/dev/null || fail 'candidate Compose configuration is invalid'
printf 'candidate: building images while the current stack remains available\n'
"${candidate_compose[@]}" build
sudo -n docker image inspect "$php_image" "$nginx_image" "$pc_image" >/dev/null \
  || fail 'candidate PHP/NGINX/PC image identity is unavailable after build'
php_image_id="$(sudo -n docker image inspect --format '{{.Id}}' "$php_image")"
nginx_image_id="$(sudo -n docker image inspect --format '{{.Id}}' "$nginx_image")"
pc_image_id="$(sudo -n docker image inspect --format '{{.Id}}' "$pc_image")"
[[ "$php_image_id" =~ ^sha256:[0-9a-f]{64}$ && "$nginx_image_id" =~ ^sha256:[0-9a-f]{64}$ \
  && "$pc_image_id" =~ ^sha256:[0-9a-f]{64}$ ]] || fail 'candidate image IDs are not immutable Docker IDs'
if [[ "$deployment_kind" == candidate ]]; then
  jq --arg php "$php_image_id" --arg nginx "$nginx_image_id" --arg pc "$pc_image_id" \
    '.images={php:$php,nginx:$nginx,pc:$pc}' "$staging/DEPLOYMENT_RECEIPT.json" >"$staging/DEPLOYMENT_RECEIPT.json.tmp" \
    || fail 'candidate deployment receipt could not bind image IDs'
  chmod 0644 "$staging/DEPLOYMENT_RECEIPT.json.tmp"
  mv -f -- "$staging/DEPLOYMENT_RECEIPT.json.tmp" "$staging/DEPLOYMENT_RECEIPT.json"
fi
candidate_image_receipt="$(sudo -n docker run --rm --entrypoint cat "$php_image" /var/www/peanut-admin/DEPLOYMENT_RECEIPT.json)" \
  || fail 'candidate PHP image does not contain the deployment receipt'
if [[ "$deployment_kind" == formal ]]; then
  [[ "$(cat "$staging/DEPLOYMENT_RECEIPT.json")" == "$candidate_image_receipt" ]] \
    || fail 'formal PHP image deployment receipt differs from staging'
else
  [[ "$(printf '%s' "$candidate_image_receipt" | jq -r '.protocol // empty')" == peanut.deployment-candidate-receipt.v1 ]] \
    || fail 'candidate PHP image does not contain the candidate receipt protocol'
fi
candidate_install_preflight="$("${candidate_compose[@]}" run -T --rm --no-deps --entrypoint php php server/database/install.php --preflight </dev/null)" \
  || fail 'candidate installation preflight failed before target replacement'
jq -e '.status == "ready" and .code == "INSTALL_PREFLIGHT_READY"' <<<"$candidate_install_preflight" >/dev/null \
  || fail 'candidate installation preflight is not ready before target replacement'
"${candidate_compose[@]}" run -T --rm --no-deps --entrypoint php php server/think plugin:lock --check </dev/null \
  || fail 'candidate Plugin lock is not canonical before target replacement'
printf 'candidate_deployment_receipt=valid\ncandidate_installation_preflight=ready\ncandidate_plugin_lock=valid\n'

if [[ "$mode" == update ]]; then
  "${candidate_compose[@]}" run -T --rm --no-deps \
    --volume "$root:/run/peanut-current-release:ro" \
    --entrypoint php php server/think plugin:release-composition \
    --current-root=/run/peanut-current-release </dev/null \
    || fail 'candidate Plugin composition would remove, downgrade, or replace an installed package unsafely'
  printf 'candidate_plugin_composition=ready\n'
fi

preflight_project=""
preflight_compose=()
cleanup_empty_database_preflight() {
  if [[ -n "$preflight_project" ]]; then
    "${preflight_compose[@]}" down --volumes --remove-orphans >/dev/null 2>&1 || true
  fi
}
trap cleanup_empty_database_preflight EXIT
preflight_project="${project}-candidate-preflight-$$"
preflight_compose=(
  sudo -n env -i "PATH=$PATH" "HOME=$HOME" "PHP_IMAGE=$php_image" "NGINX_IMAGE=$nginx_image" "PC_IMAGE=$pc_image"
  "PEANUT_SERVER_ENV_FILE=$root/server/.env" "PEANUT_DEPLOYMENT_RECEIPT_FILE=$candidate_receipt_file"
  "PEANUT_DEPLOYMENT_RECEIPT_BASE64=$deployment_receipt_base64"
  docker compose --env-file "$root/.env" --env-file "$root/server/.env" -p "$preflight_project"
  -f "$staging/compose.yaml" --profile bundled-db
)
"${preflight_compose[@]}" up -d --wait mysql >/dev/null \
  || fail 'isolated empty MySQL preflight could not start'
empty_table_count="$("${preflight_compose[@]}" exec -T mysql sh -c \
  'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" mysql -NBe "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE()"' 2>/dev/null)" \
  || fail 'isolated empty MySQL preflight query failed'
[[ "$empty_table_count" == 0 ]] || fail 'isolated preflight database is not empty'
printf 'candidate_empty_database_preflight=ready\n'
"${preflight_compose[@]}" down --volumes --remove-orphans >/dev/null
preflight_project=""
trap - EXIT

verify_paired_backup() {
  local backup_dir="$root/backups/$paired_backup_id" backup_manifest_sha
  [[ -d "$root/backups" ]] || fail 'registered paired backup directory is missing'
  [[ -d "$backup_dir" && ! -L "$backup_dir" ]] || fail 'the exact paired backup directory is unavailable'
  [[ -f "$backup_dir/database.sql.gz" && -f "$backup_dir/php-storage.tar.gz" \
    && -f "$backup_dir/manifest.json" && -f "$backup_dir/SHA256SUMS" ]] \
    || fail 'the exact paired backup set is not a complete DB/files pair'
  sudo -n bash -c 'cd "$1" && sha256sum -c SHA256SUMS >/dev/null && gzip -t database.sql.gz && tar -tzf php-storage.tar.gz >/dev/null' \
    bash "$backup_dir" \
    || fail 'the exact paired backup failed checksum or archive verification'
  backup_manifest_sha="$(sudo -n sha256sum "$backup_dir/manifest.json" | awk '{print $1}')"
  [[ "$backup_manifest_sha" == "$paired_backup_manifest_sha" ]] \
    || fail 'the exact paired backup manifest SHA-256 differs from the caller binding'
  sudo -n jq -e --arg db "$database_resource" --arg app "$application_resource" --arg backup "$paired_backup_id" \
    '.database_resource_id == $db and .application_resource_id == $app and (.backup_id == $backup or .id == $backup)' \
    "$backup_dir/manifest.json" >/dev/null \
    || fail 'paired backup manifest does not match the registered target resources or exact backup id'
  printf 'verified_paired_backup=%s\nverified_paired_backup_manifest_sha256=%s\n' "$paired_backup_id" "$backup_manifest_sha"
}

target_stopped=0
deployment_failure_diagnostic() {
  local status=$?
  if (( status != 0 )); then
    printf 'remote deploy: failed after validation; retaining diagnostic state under %s and backup %s\n' \
      "$root" "${paired_backup_id:-none}" >&2
    if (( target_stopped == 1 )); then
      "${current_compose[@]}" ps >&2 || true
    fi
  fi
  exit "$status"
}
trap deployment_failure_diagnostic EXIT
if [[ "$mode" == fresh ]]; then
  verify_paired_backup
  printf 'fresh target: candidate and paired backup are ready; stopping stack and removing only registered Compose volumes\n'
  registered_volumes=(
    "${project}_mysql-data" "${project}_php-runtime" "${project}_php-storage" "${project}_php-private-storage"
  )
  while IFS= read -r declared_volume; do
    [[ -z "$declared_volume" ]] && continue
    case " ${registered_volumes[*]} " in
      *" $declared_volume "*) ;;
      *) fail "Compose declares an unregistered volume: $declared_volume" ;;
    esac
  done < <("${current_compose[@]}" config --volumes)
  target_stopped=1
  "${current_compose[@]}" down --remove-orphans
  for registered_volume in "${registered_volumes[@]}"; do
    if sudo -n docker volume inspect "$registered_volume" >/dev/null 2>&1; then
      sudo -n docker volume rm "$registered_volume" >/dev/null \
        || fail "registered volume could not be removed: $registered_volume"
    fi
  done
elif [[ "$mode" == update ]]; then
  printf 'update target: candidate is ready; preserving database and upload volumes\n'
else
  printf 'install target: candidate is ready; no existing volumes will be removed\n'
fi

backend_environment_copy="$(mktemp /tmp/peanut-admin-backend-env.XXXXXX)"
installation_env=""
seed_env=""
cleanup_backend_environment_copy() {
  if [[ -n "${backend_environment_copy:-}" ]]; then
    sudo -n rm -f -- "$backend_environment_copy"
  fi
  [[ -z "${installation_env:-}" ]] || rm -f -- "$installation_env"
  [[ -z "${seed_env:-}" ]] || rm -f -- "$seed_env"
}
trap cleanup_backend_environment_copy EXIT
sudo -n cp "$root/server/.env" "$backend_environment_copy"
sudo -n chmod 600 "$backend_environment_copy"
# Preserve root-owned environments, backups, and any unknown diagnostic files.
# Only the versioned application entries are replaced; this is intentionally
# explicit so a failed fresh deployment cannot erase secrets or backup pairs.
managed_entries=(
  LICENSE NOTICE THIRD_PARTY_NOTICES.md CHANGELOG.md RELEASE_METADATA.json RELEASE_SBOM.spdx.json
  release-versions.json plugins.lock resources packages plugins scaffold scripts deploy
  server web platform pc uniapp compose.yaml
)
for managed_entry in "${managed_entries[@]}"; do
  if [[ -e "$root/$managed_entry" || -L "$root/$managed_entry" ]]; then
    sudo -n rm -rf -- "$root/$managed_entry"
  fi
done
sudo -n cp -a "$staging"/. "$root"/
sudo -n install -m 600 "$backend_environment_copy" "$root/server/.env"
sudo -n rm -f "$backend_environment_copy"
backend_environment_copy=""
sudo -n rm -rf "$staging"
sudo -n rm -f "$archive"
[[ -z "$overlay" ]] || sudo -n rm -f "$overlay"
set_env_key() {
  local target_file="$1" key="$2" value="$3"
  sudo -n bash -c '
    set -Eeuo pipefail
    target_file="$1"
    key="$2"
    value="$3"
    temporary="$(mktemp "${target_file}.deploy.XXXXXX")"
    trap "rm -f -- \"$temporary\"" EXIT
    awk -v key="$key" -v value="$value" '\''
      BEGIN { replaced = 0 }
      $0 ~ "^" key "=" { if (!replaced) print key "=" value; replaced = 1; next }
      { print }
      END { if (!replaced) print key "=" value }
    '\'' "$target_file" >"$temporary"
    chmod 600 "$temporary"
    mv -f -- "$temporary" "$target_file"
    trap - EXIT
  ' -- "$target_file" "$key" "$value"
}
remove_env_keys() {
  local target_file="$1"
  shift
  sudo -n bash -c '
    set -Eeuo pipefail
    target_file="$1"
    shift
    temporary="$(mktemp "${target_file}.deploy.XXXXXX")"
    trap "rm -f -- \"$temporary\"" EXIT
    awk -v blocked="$(printf "%s|" "$@")" '\''
      BEGIN { split(blocked, keys, "|"); for (i in keys) if (keys[i] != "") deny[keys[i]] = 1 }
      { key = $0; sub(/=.*/, "", key); if (!(key in deny)) print }
    '\'' "$target_file" >"$temporary"
    chmod 600 "$temporary"
    mv -f -- "$temporary" "$target_file"
    trap - EXIT
  ' -- "$target_file" "$@"
}
set_env_key .env PHP_IMAGE "$php_image"
set_env_key .env NGINX_IMAGE "$nginx_image"
set_env_key .env PC_IMAGE "$pc_image"
remove_env_keys server/.env \
  ADMIN_INITIAL_EMAIL ADMIN_INITIAL_PASSWORD PLATFORM_INITIAL_EMAIL PLATFORM_INITIAL_PASSWORD
if [[ "$mode" != update ]]; then
  for key in PEANUT_DEMO_MODE PEANUT_DEMO_TENANT_A_EMAIL PEANUT_DEMO_TENANT_B_EMAIL \
    PEANUT_DEMO_SHARED_PASSWORD PEANUT_DEMO_TENANT_A_HOST PEANUT_DEMO_TENANT_B_HOST PEANUT_DEMO_DOCS_URL; do
    set_env_key server/.env "$key" "${!key:-}"
  done
  set_env_key server/.env PEANUT_DEMO_ADMIN_EMAIL "$(printf '%s' "$ADMIN_INITIAL_EMAIL" | tr '[:upper:]' '[:lower:]')"
  set_env_key server/.env PEANUT_DEMO_PLATFORM_EMAIL "$(printf '%s' "$PLATFORM_INITIAL_EMAIL" | tr '[:upper:]' '[:lower:]')"
elif [[ "$DEMO_MODE_SET" == 1 ]]; then
  set_env_key server/.env PEANUT_DEMO_MODE "$DEMO_MODE"
  for key in PEANUT_DEMO_TENANT_A_EMAIL PEANUT_DEMO_TENANT_B_EMAIL \
    PEANUT_DEMO_SHARED_PASSWORD PEANUT_DEMO_TENANT_A_HOST PEANUT_DEMO_TENANT_B_HOST PEANUT_DEMO_DOCS_URL; do
    [[ -n "${!key:-}" ]] && set_env_key server/.env "$key" "${!key}"
  done
fi
actual_commit="$expected_commit"

compose=(sudo -n env -i "PATH=$PATH" "HOME=$HOME" "PEANUT_SERVER_ENV_FILE=$root/server/.env" "PEANUT_DEPLOYMENT_RECEIPT_FILE=$root/DEPLOYMENT_RECEIPT.json" "PHP_IMAGE=$php_image" "NGINX_IMAGE=$nginx_image" "PC_IMAGE=$pc_image" docker compose --env-file .env --env-file server/.env -p "$project" -f compose.yaml --profile bundled-db)
"${compose[@]}" config >/dev/null || fail 'updated Compose configuration is invalid'
if [[ "$mode" == update ]]; then
  # Runtime code is copied to the deployment root only; persistent volumes are
  # never written by this script. MySQL is deliberately excluded from recreate.
  "${compose[@]}" up -d --wait mysql
  migration_result="$("${compose[@]}" run -T --rm --no-deps --entrypoint php php server/database/install.php --migrate --target-version="$scaffold_migration_version" </dev/null)" || fail "database migration failed: $migration_result"
  printf '%s\n' "$migration_result"
  "${compose[@]}" run -T --rm --no-deps --entrypoint php php server/think plugin:reconcile --release-locked </dev/null
  demo_mode_enabled=0
  if sudo -n grep -Fqx 'PEANUT_DEMO_MODE=enabled' server/.env; then
    demo_mode_enabled=1
  fi
  if [[ "$deployment_mode" == standalone ]]; then
    "${compose[@]}" run -T --rm --no-deps --entrypoint php php server/think tenant-module:apply-profile standalone </dev/null
  elif [[ "$deployment_mode" == multi-tenant && "$demo_mode_enabled" == 1 ]]; then
    "${compose[@]}" run -T --rm --no-deps --entrypoint php php server/think tenant-module:apply-profile demo </dev/null
  fi
  "${compose[@]}" up -d --wait --no-deps php nginx cron
  "${compose[@]}" ps
  curl --fail --silent --show-error --retry 12 --retry-delay 2 "http://127.0.0.1:${port}/healthz" >/dev/null
  runtime_receipt="$(sudo -n docker exec "${project}-php-1" cat /var/www/peanut-admin/DEPLOYMENT_RECEIPT.json)" \
    || fail 'updated PHP container deployment receipt is unavailable'
  [[ "$(cat "$root/DEPLOYMENT_RECEIPT.json")" == "$runtime_receipt" ]] \
    || fail 'updated host and running PHP deployment receipts differ'
  if [[ "$deployment_kind" == candidate ]]; then
    jq -e --arg commit "$expected_commit" --arg tree "$expected_tree" \
      '.schema_version == 2
       and .protocol == "peanut.deployment-candidate-receipt.v1"
       and .source.commit == $commit and .source.tree == $tree' \
      "$root/DEPLOYMENT_RECEIPT.json" >/dev/null \
      || fail 'updated candidate receipt identity is invalid'
    printf 'updated_candidate_commit=%s\ncandidate_tree=%s\nproduct_version=%s\ntarget=%s\n' \
      "$expected_commit" "$expected_tree" "$candidate_product_version" "$target"
  else
    runtime_version="$(curl --fail --silent --show-error "http://127.0.0.1:${port}/legal/RELEASE_METADATA.json" | jq -r 'if .schema_version == 2 and .protocol == "peanut.release-metadata.v2" then (.instance_version // .source_product_version // empty) else .version // empty end')"
    [[ "$runtime_version" == "${tag#v}" ]] || fail "runtime metadata is $runtime_version, expected ${tag#v}"
    printf 'updated_tag=%s\ncommit=%s\nruntime_version=%s\ntarget=%s\n' "$tag" "$expected_commit" "$runtime_version" "$target"
  fi
  exit 0
fi
# Initial identities are mounted into the one automatic installation client
# from a permission-0600 file. They are never written to server/.env or retained
# by the long-running PHP/cron containers.
installation_env="$(mktemp /tmp/peanut-admin-installation.XXXXXX.env)"
chmod 600 "$installation_env"
{
  printf 'ADMIN_INITIAL_EMAIL=%s\n' "$ADMIN_INITIAL_EMAIL"
  printf 'ADMIN_INITIAL_PASSWORD=%s\n' "$ADMIN_INITIAL_PASSWORD"
  if [[ "$deployment_mode" == multi-tenant ]]; then
    printf 'PLATFORM_INITIAL_EMAIL=%s\n' "$PLATFORM_INITIAL_EMAIL"
    printf 'PLATFORM_INITIAL_PASSWORD=%s\n' "$PLATFORM_INITIAL_PASSWORD"
  fi
} > "$installation_env"
unset ADMIN_INITIAL_EMAIL ADMIN_INITIAL_PASSWORD PLATFORM_INITIAL_EMAIL PLATFORM_INITIAL_PASSWORD
"${compose[@]}" up -d --wait mysql
