  [[ "$has_backend_env" == 1 ]] || fail 'formal deployment requires the existing split backend environment'
  backend_environment_copy="$(mktemp /tmp/peanut-admin-backend-env.XXXXXX)"
fi
installation_env=""
seed_env=""
