#!/usr/bin/env bash
set -Eeuo pipefail
core_dev_main() {
set -Eeuo pipefail

ROOT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
ACTION="${1:-status}"
[[ $# -eq 0 ]] || shift
PHP_CORE_DIR=""
WEB_CORE_DIR=""
BACKEND_ENV=""
CLIENT="all"

die() { printf 'core-dev: %s\n' "$*" >&2; exit 1; }
usage() {
  cat <<'USAGE'
Usage: scripts/core-dev {select|install|status|link|link-status|php-status|php-path|web-path|reset|unlink}
  [--path /absolute/application-checkout]
  --php-core-dir /absolute/peanut-admin-core-php
  --web-core-dir /absolute/peanut-admin-core-web
  [--backend-env /absolute/server/.env.development]
  [--client web,platform|pc|uniapp|all]

select persists this choice in the application's ignored .local/core-dev.json.
Missing source paths reuse the saved choice, then host.json core.php/core.web,
then adjacent ../peanut-admin-core-php and ../peanut-admin-core-web on select.
Following commands reuse that choice; command-line paths override it for that call.
Development always uses both explicitly selected local Core checkouts.
install/link activate source links; status/link-status verify those links.
reset/unlink removes .local/core-dev.json and restores fixed packages.
Local Web exports use dist/, compiled by the existing TypeScript toolchain.
First select the checkouts and run install/link to prepare source dependencies.
Use the prepared Core tool scope for the existing Web Core watch (see development docs).
--client limits Web install/link/status/reset to the listed clients; default: all.
Start clients separately with native npm run dev / npm run dev:h5 commands;
they consume the prepared links and do not start Core watchers or read this choice.
Do not re-link or rebuild for each edit.
An APP without a saved choice uses its normal fixed packages. Candidate delivery
uses fixed Core packages and native locks, independently of these source links.
USAGE
}
while [[ $# -gt 0 ]]; do
  case "$1" in
    --path) [[ $# -ge 2 && "$2" == /* ]] || die '--path requires an absolute checkout'; ROOT_DIR="$2"; shift 2 ;;
    --php-core-dir) [[ $# -ge 2 ]] || die 'missing PHP Core path'; PHP_CORE_DIR="$2"; shift 2 ;;
    --web-core-dir) [[ $# -ge 2 ]] || die 'missing Web Core path'; WEB_CORE_DIR="$2"; shift 2 ;;
    --backend-env) [[ $# -ge 2 ]] || die 'missing environment path'; BACKEND_ENV="$2"; shift 2 ;;
    --client) [[ $# -ge 2 ]] || die 'missing client selection'; CLIENT="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done
[[ "$CLIENT" == all || "$CLIENT" =~ ^(web|platform|pc|uniapp)(,(web|platform|pc|uniapp))*$ ]] || die 'unsupported client selection'
ROOT_DIR="$(CDPATH= cd -- "$ROOT_DIR" && pwd -P)"
[[ -f "$ROOT_DIR/server/composer.json" && -x "$ROOT_DIR/scripts/local-core-composer" ]] || die 'application checkout is invalid'
if [[ "$ACTION" == reset || "$ACTION" == unlink ]]; then
  rm -rf "$ROOT_DIR/.local/core-dev.json" "$ROOT_DIR/.local/composer-core" "$ROOT_DIR/.local/core-links"
  needs_composer_restore=0
  if [[ -L "$ROOT_DIR/server/vendor/peanut-admin/core" ]]; then
    rm -f "$ROOT_DIR/server/vendor/peanut-admin/core"
    needs_composer_restore=1
  elif [[ -f "$ROOT_DIR/server/vendor/autoload.php" && -f "$ROOT_DIR/server/composer.lock" ]]; then
    if ! node - "$ROOT_DIR/server/composer.lock" "$ROOT_DIR/server/vendor/composer/installed.json" <<'NODE'
const fs = require('node:fs');
const [lockFile, installedFile] = process.argv.slice(2);
if (!fs.existsSync(installedFile)) process.exit(1);
const lock = JSON.parse(fs.readFileSync(lockFile, 'utf8'));
const installed = JSON.parse(fs.readFileSync(installedFile, 'utf8'));
const lockPkg = (lock.packages || []).find((p) => p.name === 'peanut-admin/core');
const instPkgs = Array.isArray(installed) ? installed : (installed.packages || []);
const instPkg = instPkgs.find((p) => p.name === 'peanut-admin/core');
if (!lockPkg || !instPkg || lockPkg.version !== instPkg.version) process.exit(1);
NODE
    then
      needs_composer_restore=1
    fi
  fi
  if [[ "$needs_composer_restore" == 1 ]]; then
    (cd "$ROOT_DIR/server" && composer install --no-scripts --no-interaction && php think service:discover)
  fi
  selected_reset_clients=()
  if [[ "$CLIENT" == all ]]; then
    selected_reset_clients=(web platform pc uniapp)
  else
    IFS=',' read -r -a selected_reset_clients <<< "$CLIENT"
  fi
  for reset_client in "${selected_reset_clients[@]}"; do
    has_link=0
    for pkg_name in client vue ui-vue nuxt uniapp testing; do
      pkg_dir="$ROOT_DIR/$reset_client/node_modules/@peanut-admin/$pkg_name"
      [[ -e "$pkg_dir" || -L "$pkg_dir" ]] || continue
      if [[ -L "$pkg_dir" ]]; then
        target="$(realpath "$pkg_dir" 2>/dev/null || true)"
        case "$target" in
          "$ROOT_DIR/$reset_client/node_modules/"*) ;;
          *) has_link=1 ;;
        esac
      fi
      if [[ "$has_link" == 0 && -f "$pkg_dir/package.json" && -f "$ROOT_DIR/$reset_client/package.json" ]]; then
        if ! node - "$ROOT_DIR/$reset_client/package.json" "$pkg_dir/package.json" "@peanut-admin/$pkg_name" <<'NODE'
const fs = require('node:fs');
const [manifestFile, installedFile, fullName] = process.argv.slice(2);
const manifest = JSON.parse(fs.readFileSync(manifestFile, 'utf8'));
const expected = manifest.dependencies?.[fullName] ?? manifest.devDependencies?.[fullName];
if (expected && !/^(workspace:|file:|link:|[~^])/.test(expected)) {
  const installed = JSON.parse(fs.readFileSync(installedFile, 'utf8'));
  if (installed.version !== expected) process.exit(1);
}
NODE
        then
          has_link=1
        fi
      fi
    done
    if [[ "$has_link" == 1 ]]; then
      if [[ "$reset_client" == web ]]; then
        (cd "$ROOT_DIR/web" && pnpm install --frozen-lockfile --ignore-scripts)
      else
        (cd "$ROOT_DIR/$reset_client" && npm ci --ignore-scripts)
      fi
    fi
  done
  printf 'core-dev: reset to fixed packages completed\n'
  exit 0
fi
selection_file="$ROOT_DIR/.local/core-dev.json"
if [[ -e "$selection_file" || -L "$selection_file" ]]; then
  selection="$(node - "$selection_file" "$ROOT_DIR" <<'NODE'
const fs = require('node:fs');
const [file, root] = process.argv.slice(2);
const stat = fs.lstatSync(file);
if (!stat.isFile() || stat.isSymbolicLink() || stat.nlink !== 1) throw new Error('Local Core selection must be a regular file');
const data = JSON.parse(fs.readFileSync(file, 'utf8'));
if (data.schema_version !== 1 || data.application_root !== root) throw new Error('Local Core selection belongs to another checkout');
for (const key of ['php_core_dir', 'web_core_dir', 'backend_env']) {
  if (typeof data[key] !== 'string' || !data[key].startsWith('/') || /[\x00-\x1f\x7f]/.test(data[key])) throw new Error(`Invalid Core selection: ${key}`);
  console.log(data[key]);
}
NODE
)" || die 'saved local Core selection is invalid; no fixed-package fallback'
  [[ -n "$PHP_CORE_DIR" ]] || PHP_CORE_DIR="$(printf '%s\n' "$selection" | sed -n '1p')"
  [[ -n "$WEB_CORE_DIR" ]] || WEB_CORE_DIR="$(printf '%s\n' "$selection" | sed -n '2p')"
  [[ -n "$BACKEND_ENV" ]] || BACKEND_ENV="$(printf '%s\n' "$selection" | sed -n '3p')"
fi
if [[ ( -z "$PHP_CORE_DIR" || -z "$WEB_CORE_DIR" ) && -f "$ROOT_DIR/.local/toolchain/host.json" ]]; then
  configured="$(node - "$ROOT_DIR/.local/toolchain/host.json" <<'NODE'
const fs = require('node:fs');
const host = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
for (const key of ['php', 'web']) {
  const value = host.core?.[key] ?? '';
  if (typeof value !== 'string' || (value && !value.startsWith('/')) || /[\x00-\x1f\x7f]/.test(value)) throw new Error(`Invalid configured Core path: ${key}`);
  console.log(value);
}
NODE
)" || die 'configured Core paths are invalid; supply explicit source paths'
  [[ -n "$PHP_CORE_DIR" ]] || PHP_CORE_DIR="$(printf '%s\n' "$configured" | sed -n '1p')"
  [[ -n "$WEB_CORE_DIR" ]] || WEB_CORE_DIR="$(printf '%s\n' "$configured" | sed -n '2p')"
fi
[[ -n "$PHP_CORE_DIR" || ! -f "$ROOT_DIR/../peanut-admin-core-php/composer.json" ]] || PHP_CORE_DIR="$(CDPATH= cd -- "$ROOT_DIR/../peanut-admin-core-php" && pwd -P)"
[[ -n "$WEB_CORE_DIR" || ! -f "$ROOT_DIR/../peanut-admin-core-web/pnpm-workspace.yaml" ]] || WEB_CORE_DIR="$(CDPATH= cd -- "$ROOT_DIR/../peanut-admin-core-web" && pwd -P)"
[[ -n "$BACKEND_ENV" || ! -f "$ROOT_DIR/server/.env" || -L "$ROOT_DIR/server/.env" ]] || BACKEND_ENV="$ROOT_DIR/server/.env"
[[ "$PHP_CORE_DIR" == /* && "$WEB_CORE_DIR" == /* ]] || die 'both absolute Core checkout paths are required'
PHP_CORE_DIR="$(CDPATH= cd -- "$PHP_CORE_DIR" && pwd -P)"
WEB_CORE_DIR="$(CDPATH= cd -- "$WEB_CORE_DIR" && pwd -P)"
[[ -f "$PHP_CORE_DIR/composer.json" ]] || die 'PHP Core composer.json is missing'
[[ -f "$WEB_CORE_DIR/pnpm-workspace.yaml" ]] || die 'Web Core workspace is missing'
node -e 'if(require(process.argv[1]).name!=="peanut-admin/core"||require(process.argv[2]).name!=="@peanut-admin/web-workspace")process.exit(1)' \
  "$PHP_CORE_DIR/composer.json" "$WEB_CORE_DIR/package.json" || die 'selected Core package identity is invalid'

write_selection_file() {
  local target_env="$1"
  [[ ! -L "$ROOT_DIR/.local" && ! -L "$selection_file" ]] || die 'local Core selection may not use linked configuration paths'
  mkdir -p "$ROOT_DIR/.local"
  node - "$selection_file" "$ROOT_DIR" "$PHP_CORE_DIR" "$WEB_CORE_DIR" "$target_env" <<'NODE'
const fs = require('node:fs');
const [file, application_root, php_core_dir, web_core_dir, backend_env] = process.argv.slice(2);
for (const value of [application_root, php_core_dir, web_core_dir, backend_env]) {
  if (/[\x00-\x1f\x7f]/.test(value)) throw new Error('Control characters are not allowed in selection paths');
}
fs.writeFileSync(file, JSON.stringify({ schema_version: 1, application_root, php_core_dir, web_core_dir, backend_env }, null, 2) + '\n', { mode: 0o600 });
fs.chmodSync(file, 0o600);
NODE
}

case "$ACTION" in
  select)
    [[ "$BACKEND_ENV" == /* && -f "$BACKEND_ENV" && ! -L "$BACKEND_ENV" ]] || die 'select requires an absolute regular --backend-env'
    write_selection_file "$BACKEND_ENV"
    printf 'core-dev: selected local PHP/Web source in %s; install/link is a separate dependency write\n' "$selection_file"
    exit 0
    ;;
  php-path) printf '%s\n' "$PHP_CORE_DIR"; exit 0 ;;
  web-path) printf '%s\n' "$WEB_CORE_DIR"; exit 0 ;;
  install|link)
    [[ "$BACKEND_ENV" == /* ]] || die 'install requires --backend-env'
    "$ROOT_DIR/scripts/local-core-composer" install --core-dir "$PHP_CORE_DIR" --backend-env "$BACKEND_ENV"
    "$ROOT_DIR/scripts/local-core-web" link --core-dir "$WEB_CORE_DIR" --client "$CLIENT"
    canonical_backend_env="$(CDPATH= cd -- "$(dirname -- "$BACKEND_ENV")" 2>/dev/null && pwd -P)/$(basename -- "$BACKEND_ENV")"
    if [[ "$canonical_backend_env" == "$ROOT_DIR/server/"* && -f "$canonical_backend_env" && ! -L "$canonical_backend_env" \
          && ! -L "$ROOT_DIR/.local" && ! -L "$selection_file" ]]; then
      write_selection_file "$canonical_backend_env"
    fi
    ;;
  status|link-status|php-status)
    php_link="$ROOT_DIR/server/vendor/peanut-admin/core"
    [[ -L "$php_link" && "$(realpath "$php_link")" == "$PHP_CORE_DIR" ]] \
      || die 'installed PHP Core does not link to the selected checkout'
    [[ "$ACTION" == php-status ]] || "$ROOT_DIR/scripts/local-core-web" link-status --core-dir "$WEB_CORE_DIR" --client "$CLIENT"
    ;;
  *) usage >&2; die "unsupported action: $ACTION" ;;
esac
printf 'core-dev: %s completed for explicit PHP and Web Core checkouts\n' "$ACTION"

}
core_dev_main "$@"
