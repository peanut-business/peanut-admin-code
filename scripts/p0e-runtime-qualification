class GateError(RuntimeError):
    pass


class NotRun(GateError):
    pass


def fail(message: str) -> None:
    raise GateError(message)

def operating_system_environment() -> dict[str, str]:
    # Keep the host's existing network routing for package downloads. Application
    # runtime configuration still comes only from the explicit group environment.
    return {
        key: value
        for key in ("PATH", "HOME", "TMPDIR", "SSH_AUTH_SOCK", "PEANUT_RESOURCE_REGISTRY", "SystemRoot", "COMSPEC", "PATHEXT",
                    "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY",
                    "http_proxy", "https_proxy", "all_proxy", "no_proxy")
        if (value := os.environ.get(key))
    }

def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exception:
        fail(f"cannot read JSON {path}: {exception}")
    if not isinstance(value, dict):
        fail(f"JSON root must be an object: {path}")
    return value

def command(
    arguments: list[str],
    *,
    cwd: Path | None = None,
    env: dict[str, str] | None = None,
    log: Path | None = None,
    capture: bool = False,
    check: bool = True,
    input_text: str | None = None,
) -> subprocess.CompletedProcess[str]:
    merged = operating_system_environment()
    cwd = ROOT if cwd is None else cwd
    if env:
        merged.update(env)
    if log is not None:
        log.parent.mkdir(parents=True, exist_ok=True)
        with log.open("a", encoding="utf-8") as stream:
            result = subprocess.run(
                arguments,
                cwd=cwd,
                env=merged,
                text=True,
                input=input_text,
                stdout=stream,
                stderr=subprocess.STDOUT,
                check=False,
            )
    else:
        result = subprocess.run(
            arguments,
            cwd=cwd,
            env=merged,
            text=True,
            input=input_text,
            capture_output=capture,
            check=False,
        )
    if check and result.returncode != 0:
        detail = ""
        if capture:
            detail = (result.stderr or result.stdout or "").strip()
        suffix = f": {detail}" if detail else ""
        fail(f"command failed ({result.returncode}): {arguments[0]}{suffix}")
    return result

def git(*arguments: str) -> str:
    return command(["git", "-C", str(ROOT), *arguments], capture=True).stdout.strip()

def configure_source(args: argparse.Namespace) -> dict[str, Any] | None:
    """Bind corrected qualification tools without changing product or plan identity."""
    global ROOT, FIXTURE_PATH, P0E_REGISTRY_PATH, LEASE_TOOL, REGISTRY_TOOL
    global INSPECTOR, BROWSER_RUNNER, BROWSER_TOOLING, CONSUMER_MODULE_CHAIN
    global DEVELOPMENT_DATABASE_SYNC, LOCAL_BACKEND_ENV, TOOL_BINDING
    values = [getattr(args, name, None) for name in
              ("source_root", "qualification_tool_commit", "qualification_tool_files_sha256")]
    if not any(values):
        return None
    if not all(values):
        fail("source-root, qualification-tool-commit and qualification-tool-files-sha256 are required together")
    source = Path(values[0])
    if not source.is_absolute() or source.is_symlink() or not source.is_dir() or any(p.is_symlink() for p in source.parents):
        fail("qualification source root is unsafe")
    source = source.resolve()
    def checkout(root: Path, commit: str) -> str:
        if not re.fullmatch(r"[0-9a-f]{40}", commit):
            fail("qualification identity requires exact commit hashes")
        if command(["git", "-C", str(root), "rev-parse", "--show-toplevel"], capture=True).stdout.strip() != str(root):
            fail("qualification root must be the checkout root")
        if command(["git", "-C", str(root), "rev-parse", "HEAD"], capture=True).stdout.strip() != commit:
            fail("qualification checkout HEAD differs from its explicit commit")
        if command(["git", "-C", str(root), "status", "--porcelain=v1", "--untracked-files=all"], capture=True).stdout.strip():
            fail("qualification checkout must be clean")
        return command(["git", "-C", str(root), "rev-parse", "HEAD^{tree}"], capture=True).stdout.strip()
    tree = checkout(source, args.candidate)
    tool_tree = checkout(TOOL_ROOT, values[1])
    command(["git", "-C", str(TOOL_ROOT), "merge-base", "--is-ancestor", args.candidate, values[1]], capture=True)
    changed = command(["git", "-C", str(TOOL_ROOT), "diff", "--name-only", args.candidate, values[1]], capture=True).stdout.splitlines()
    if not changed or set(changed) - set(TOOL_FILES) - {"docs/development/p0e-tool-identity.md"}:
        fail("qualification tool revision changes product inputs")
    files = {}
    for relative in TOOL_FILES:
        path = TOOL_ROOT / relative
        if path.is_symlink() or not path.is_file():
            fail("qualification tool file is unsafe")
        files[relative] = sha256(path)
    digest = hashlib.sha256("".join(f"{name}\0{files[name]}\n" for name in sorted(files)).encode()).hexdigest()
    if digest != values[2]:
        fail("qualification tool file inventory digest differs")
    ROOT = source
    FIXTURE_PATH = ROOT / "server/tests/fixtures/p0e-runtime-qualification/matrix.json"
    P0E_REGISTRY_PATH = ROOT / "resources/p0e-runtime-qualification.json"
    LEASE_TOOL = ROOT / "scripts/project-resource-lease"
    REGISTRY_TOOL = ROOT / "scripts/project-resource-registry"
    INSPECTOR = ROOT / "server/tests/fixtures/mt05/inspect.php"
    BROWSER_RUNNER = TOOL_ROOT / "scripts/p0e-browser-smoke"
    BROWSER_TOOLING = ROOT / "scripts/p0e-browser-tooling"
    CONSUMER_MODULE_CHAIN = TOOL_ROOT / "scripts/consumer-module-reference-chain"
    DEVELOPMENT_DATABASE_SYNC = ROOT / "scripts/project-development-database.sh"
    LOCAL_BACKEND_ENV = ROOT / "server/.env"
    TOOL_BINDING = {"source_root": str(ROOT), "candidate": args.candidate, "candidate_tree": tree,
                    "tool_root": str(TOOL_ROOT), "tool_commit": values[1], "tool_tree": tool_tree,
                    "tool_files": files, "tool_files_sha256": digest}
    return TOOL_BINDING

def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()

def validate_candidate(candidate: str, require_clean: bool, allowed_output: Path | None = None) -> tuple[str, str]:
    if not re.fullmatch(r"[0-9a-f]{40}", candidate):
        fail("candidate must be an exact lowercase 40-hex commit")
    resolved = git("rev-parse", f"{candidate}^{{commit}}")
    head = git("rev-parse", "HEAD")
    if resolved != candidate or head != candidate:
        fail(f"worktree HEAD {head} is not fixed candidate {candidate}")
    tree = git("rev-parse", f"{candidate}^{{tree}}")
    if require_clean:
        status_arguments = ["status", "--porcelain=v1", "--untracked-files=all"]
        if allowed_output is not None:
            try:
                relative_output = allowed_output.relative_to(ROOT)
            except ValueError:
                fail("allowed runtime output must be within the candidate worktree")
            status_arguments.extend(["--", ".", f":(exclude){relative_output.as_posix()}/**"])
        if git(*status_arguments):
            fail("fixed candidate worktree is not clean")
    return head, tree

def documentation_contract(project_root: Path, *, generated: bool) -> dict[str, Any]:
    if (project_root / "docs").is_symlink() or not (project_root / "docs").is_dir():
        fail("released public documentation directory is unavailable")
    documents: dict[str, str] = {}
    manifest = read_json(project_root / ".peanut/application-manifest.json") if generated else None
    released = {item.get("path"): item.get("sha256") for item in manifest["files"]} if manifest else {}
    for relative in (*("docs/" + item for item in PUBLIC_DOCUMENTS), "server/generated/openapi.json", "server/generated/api-catalog.json"):
        path = project_root / relative
        if path.is_symlink() or not path.is_file() or not path.resolve().is_relative_to(project_root.resolve()) or not path.stat().st_size:
            fail(f"public documentation input is unavailable: {relative}")
        digest = sha256(path)
        if generated and released.get(relative) != digest:
            fail(f"public documentation differs from the released application manifest: {relative}")
        documents[relative] = digest
    api = read_json(project_root / "server/generated/openapi.json")
    catalog = read_json(project_root / "server/generated/api-catalog.json")
    version = read_json(project_root / "release-versions.json")["source_product_version"]
    if (api.get("openapi") != "3.0.3" or api.get("info", {}).get("version") != version
        or not api.get("paths") or catalog.get("schema_version") != 1
        or catalog.get("openapi_version") != "3.0.3" or not catalog.get("endpoints")):
        fail("public API documentation structure/version does not match the released source")
    return {"delivery": "versioned-markdown-and-openapi", "files": documents, "api_version": version,
            "browser_documents": {item: documents["docs/" + item] for item in PUBLIC_DOCUMENTS}}

def parse_lease(raw: str) -> tuple[dict[str, str], set[tuple[str, str]]]:
    metadata: dict[str, str] = {}
    resources: set[tuple[str, str]] = set()
    in_resources = False
    for line in raw.splitlines():
        if line == "resources":
            in_resources = True
            continue
        fields = line.split("\t", 1)
        if len(fields) != 2:
            fail("lease output is malformed")
        if in_resources:
            resources.add((fields[0], fields[1]))
        else:
            metadata[fields[0]] = fields[1]
    return metadata, resources

def expected_resources(plan_data: dict[str, Any]) -> set[tuple[str, str]]:
    return {(item["type"], item["value"]) for item in plan_data["lease_resources"]} | {
        ("gate", plan_data["gate"]),
        ("worktree", plan_data["worktree"]),
    }

def verify_lease(args: argparse.Namespace, plan_data: dict[str, Any]) -> None:
    raw = command([str(LEASE_TOOL), "show", "--lease", args.lease, "--verify-locks"], capture=True).stdout
    metadata, resources = parse_lease(raw)
    now = int(time.time())
    expected_metadata = {
        "lease": args.lease,
        "owner": args.owner,
        "thread": args.thread,
        "candidate": args.candidate,
        "candidate_repository": plan_data["worktree"],
        "parent_lease": args.parent_lease or "",
        "gate": plan_data["gate"],
        "worktree": plan_data["worktree"],
        "status": "ACTIVE",
    }
    for key, value in expected_metadata.items():
        if metadata.get(key) != value:
            fail(f"lease {key} mismatch")
    if not metadata.get("expires_at", "").isdigit() or int(metadata["expires_at"]) <= now:
        fail("lease is expired")
    if resources != expected_resources(plan_data):
        missing = sorted(expected_resources(plan_data) - resources)
        extra = sorted(resources - expected_resources(plan_data))
        fail(f"lease resource set mismatch; missing={missing}, extra={extra}")
    # Native --verify-locks knows which fields are identity metadata and which
    # have real locks. Requiring locks for advisory resource-id/database fields
    # manufactured a second, incompatible lease contract here.
    for admission in plan_data.get("runtime_admissions", []):
        verify_runtime_admission(admission, args.owner, args.thread)


def database_registration(runtime: dict[str, Any]) -> dict[str, Any]:
    matches = [r for r in read_json(REGISTRY_PATH)["resources"]["databases"]
               if r.get("stable_resource_id") == runtime["resource_id"]]
    if len(matches) != 1:
        fail("database registration is missing or ambiguous")
    return matches[0]


def database_resources(runtime: dict[str, Any]) -> list[tuple[str, str]]:
    registered = database_registration(runtime)
    endpoint = registered["upstream_endpoint"]
    policy = registered.get("lease_policy", {})
    if (policy.get("mode") != "schema" or registered.get("database") != runtime["database"]
            or endpoint.get("endpoint_id") != runtime["endpoint_id"] or not registered.get("lease_gate")
            or re.search("qualification|performance|recovery", registered["lease_gate"])):
        fail("runtime requires its registered ordinary schema gate; service/performance qualification remains exclusive")
    schema = f"{endpoint['host']}:{endpoint['port']}/{runtime['database']}"
    resources = [("resource-id", runtime["resource_id"]), ("database-resource", runtime["resource_id"]),
                 ("endpoint", runtime["endpoint_id"]), ("database", runtime["database"]),
                 ("mysql-db", runtime["database"]), ("mysql-schema", schema),
                 ("registry-sha256", sha256(REGISTRY_PATH)), ("consumer", "host"), ("environment", "development")]
    resources.append(("registry-tool-sha256", sha256(REGISTRY_TOOL)))
    if registered.get("resource_scope"):
        resources.append(("resource-scope", registered["resource_scope"]))
    elif registered.get("container_name"):
        resources.append(("container", registered["container_name"]))
    else:
        resources.append(("resource-scope", registered["namespace"]))
    if policy.get("shared_access") is not None:
        resources.append(("mysql-access", json.dumps({"schema": schema, "operation": "exclusive",
            "complete": True, "tables": []}, separators=(",", ":"))))
    # On a registered non-shared schema the native absence of mysql-access means
    # exclusive; never fabricate a shared_access contract for permanent APPs.
    return resources


def runtime_admission(runtime: dict[str, Any], root: str, candidate: str) -> dict[str, Any]:
    lease = runtime.get("lease")
    if not isinstance(lease, str) or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", lease):
        fail("runtime owner must supply the real per-checkout lease identity")
    common = command(["git", "-C", root, "rev-parse", "--path-format=absolute", "--git-common-dir"], capture=True).stdout.strip()
    return {"lease": lease, "root": root, "candidate": candidate,
            "gate": database_registration(runtime)["lease_gate"], "resource_id": runtime["resource_id"],
            "proof_dir": str(Path(common) / "peanut-admin-resource-leases/leases" / lease),
            "resources": [{"type": k, "value": v} for k, v in database_resources(runtime)]}


def verify_runtime_admission(admission: dict[str, Any], owner: str, thread: str) -> None:
    root = canonical(admission["root"], directory=True)
    raw = command([str(root / "scripts/project-resource-lease"), "show", "--lease", admission["lease"],
                   "--verify-locks"], cwd=root, capture=True).stdout
    metadata, resources = parse_lease(raw)
    required = {"owner": owner, "thread": thread, "worktree": str(root), "candidate_repository": str(root),
                "candidate": admission["candidate"], "gate": admission["gate"], "parent_lease": "", "status": "ACTIVE"}
    if (any(metadata.get(k) != v for k, v in required.items())
            or int(metadata.get("expires_at", "0")) <= int(time.time())
            or command(["git", "-C", str(root), "rev-parse", "HEAD"], capture=True).stdout.strip() != admission["candidate"]):
        fail("runtime proof owner/thread/source/gate differs; no inherited or borrowed authority")
    expected = {(r["type"], r["value"]) for r in admission["resources"]}
    if not expected <= resources:
        fail("runtime proof does not cover the registered exact exclusive database operation")
    for kind in ("database", "mysql-db", "mysql-schema", "mysql-access", "endpoint"):
        if {v for k, v in resources if k == kind} != {v for k, v in expected if k == kind}:
            fail("runtime proof contains another schema, endpoint or access operation")


def runtime_environment(runtime: dict[str, Any], admission: dict[str, Any], *, php: str = "php") -> dict[str, str]:
    path = file_reference(runtime["environment"])
    root = canonical(admission["root"], directory=True)
    if path.parent != root / "server" or (path.name != ".env" and not path.name.startswith(".env.")):
        fail("runtime environment must be server/.env or a named sibling")
    name = "" if path.name == ".env" else path.name.removeprefix(".env.")
    environment = {
        "PHP_ENV_NAME": name,
        "PEANUT_RESOURCE_REGISTRY": str(REGISTRY_PATH) if root == ROOT else "",
        "PEANUT_DEPLOYMENT_TARGET": "local-development",
        "PEANUT_DATABASE_RESOURCE_ID": runtime["resource_id"],
        "PEANUT_DATABASE_CONSUMER": "host",
        "PEANUT_DATABASE_ENDPOINT_ID": runtime["endpoint_id"],
        "PEANUT_RESOURCE_LEASE_PROOF": admission["proof_dir"],
        "P0E_HOST_LEASE_PROOF": admission["proof_dir"],
    }
    result = command([php, "-r",
        "try { require $argv[1] . '/vendor/autoload.php'; "
        "$app = new think\\App($argv[1]); $app->loadEnv((string) env('env_name', '')); "
        "foreach (['P0E_HOST_LEASE_PROOF','PEANUT_RESOURCE_LEASE_PROOF'] as $key) {"
        "if (getenv($key) !== $argv[2]) { fwrite(STDERR, 'RUNTIME_ENVIRONMENT_PROOF_MISMATCH:'.$key); exit(2); }}"
        "} catch (Throwable $e) { fwrite(STDERR, 'RUNTIME_ENVIRONMENT_LOAD_FAILED'); exit(2); }",
        str(root / "server"), admission["proof_dir"]],
        cwd=root, env=environment, capture=True, check=False)
    if result.returncode != 0:
        fail("runtime protected application configuration must load natively and maintenance process proofs must match "
             + admission["proof_dir"])
    return environment


EDITIONS = ("standalone", "multi-tenant")
APP_RESOURCES = {"standalone": "peanut-app-st-development-mysql84", "multi-tenant": "peanut-app-mt-development-mysql84"}


def canonical(value: str, *, directory: bool = False) -> Path:
    path = Path(value)
    if not path.is_absolute() or path.resolve() != path or path.is_symlink():
        fail("input must be an absolute canonical path")
    invalid = not path.is_dir() if directory else not path.is_file() or path.stat().st_nlink != 1
    if invalid:
        fail("input type or file identity is invalid")
    return path


def file_reference(record: dict[str, Any]) -> Path:
    if not isinstance(record, dict) or not re.fullmatch(r"[a-f0-9]{64}", record.get("sha256", "")):
        fail("a fixed native file reference and SHA-256 are required")
    path = canonical(record.get("path", ""))
    if sha256(path) != record["sha256"]:
        fail("fixed native file changed")
    return path


def checkout_identity(root: Path, commit: str, tree: str, *, clean: bool = True) -> None:
    if not re.fullmatch(r"[a-f0-9]{40}", commit) or not re.fullmatch(r"[a-f0-9]{40}", tree):
        fail("exact source commit/tree required")
    for arguments, expected in ((["rev-parse", "--show-toplevel"], str(root)),
                                (["rev-parse", "HEAD"], commit), (["rev-parse", "HEAD^{tree}"], tree)):
        if command(["git", "-C", str(root), *arguments], capture=True).stdout.strip() != expected:
            fail("fixed checkout identity differs")
    if clean and command(["git", "-C", str(root), "status", "--porcelain=v1", "--untracked-files=all"], capture=True).stdout.strip():
        fail("fixed checkout must be clean")


def template_inputs(root: Path, candidate: str, tree: str, *, verify: bool = False) -> dict[str, Any]:
    version = read_json(ROOT / "release-versions.json")["scaffold_template"]
    result = command(["node", str(ROOT / "scripts/release-template-artifacts.mjs"), "check" if verify else "read",
        str(root), version, candidate, tree, sha256(ROOT / "scaffold/application-template-inventory.json"),
        *([str(ROOT)] if verify else [])], capture=True)
    value = json.loads(result.stdout)
    if value.get("protocol") != "peanut.template-release-inputs.v1":
        fail("native template input identity is unavailable")
    return value


def app_binding(app: dict[str, Any]) -> dict[str, Any]:
    return {key: app[key] for key in ("root", "head", "manifest_sha256", "baseline_sha256", "resource_id", "endpoint_id", "database", "adopted_source")}


def baseline_identity(root: Path, manifest: dict[str, Any]) -> str:
    records = []
    for item in manifest.get("files", []):
        if item.get("classification") not in ("managed", "generated-managed"):
            continue
        name = item.get("baseline_path", "")
        if not name.startswith(".peanut/scaffold-baseline/") or ".." in Path(name).parts:
            fail("APP native baseline path is invalid")
        path = file_reference({"path": str(root / name), "sha256": item.get("baseline_sha256")})
        records.append([name, sha256(path), item.get("baseline_mode")])
    if not records:
        fail("APP native baseline is missing")
    return hashlib.sha256(json.dumps(sorted(records), ensure_ascii=False, separators=(",", ":")).encode()).hexdigest()


def runtime_registration(app: dict[str, Any], *, compose: bool = True) -> dict[str, Any]:
    """Bind deployment coordinates before even interpolating an operator's Compose file."""
    if not compose:
        runtime = app.get("runtime", {})
        resources = [r for values in read_json(REGISTRY_PATH)["resources"].values() if isinstance(values, list)
                     for r in values if isinstance(r, dict)]
        manifest = read_json(Path(app["root"]) / ".peanut/application-manifest.json")["application"]
        routes = []
        for field in ("health_url", "tenant_admin_url", "tenant_beta_url", "platform_url", "docs_url"):
            if not runtime.get(field):
                raise NotRun("browser route is not registered for this APP: " + field)
            url = urlsplit(runtime[field])
            if (url.scheme not in ("http", "https") or not url.port or url.username or url.password
                    or url.query or url.fragment or not url.hostname
                    or not (url.hostname in ("localhost", "127.0.0.1") or url.hostname.endswith(".localhost"))):
                fail("runtime HTTP/browser URL must use its registered loopback listener")
            matches = []
            for resource in resources:
                for access in resource.get("access_urls", []):
                    registered_url = urlsplit(access)
                    prefix = registered_url.path or "/"
                    if ((url.scheme, url.netloc) == (registered_url.scheme, registered_url.netloc)
                            and (url.path == prefix.rstrip("/") or url.path.startswith(prefix if prefix.endswith("/") else prefix + "/"))
                            and url.port == resource.get("port")):
                        matches.append(resource)
                        break
            if len(matches) != 1:
                raise NotRun("browser URL has no unique registered PSM route: " + field)
            registered = matches[0]
            manager = registered.get("service_manager", {})
            if (registered.get("environment") != "development"
                    or registered.get("allocation_status") != "INSTALLED_DEVELOPMENT_RUNTIME_REGISTERED"
                    or not all(manager.get(k) for k in ("project_id", "environment_id", "service_id"))):
                raise NotRun("browser requires an admitted existing development PSM route: " + field)
            identity = registered.get("application_identity", {})
            if (identity.get("observed_HEAD") != app["head"] or identity.get("manifest_sha256") != app["manifest_sha256"]
                    or any(identity.get(k) != manifest.get(k) for k in ("slug", "edition"))
                    or registered.get("application_root", app["root"]) != app["root"]):
                fail("PSM route application identity differs")
            backend_id = registered.get("backend_resource_id")
            backends = [r for r in resources if r.get("database_resource_id") == app["resource_id"]
                        and r.get("application_root") == app["root"]
                        and r.get("service_manager", {}).get("project_id") == manager["project_id"]
                        and r.get("service_manager", {}).get("environment_id") == manager["environment_id"]
                        and (not backend_id or r.get("stable_resource_id") == backend_id)]
            if len(backends) != 1:
                fail("PSM route has no unique APP backend/database association")
            backend = backends[0]
            if (backend.get("application_identity") != identity or backend.get("environment") != "development"
                    or backend.get("allocation_status") != "INSTALLED_DEVELOPMENT_RUNTIME_REGISTERED"):
                fail("PSM backend application/environment identity differs")
            routes.extend((registered, backend))
        return {"routes": {r["stable_resource_id"]: r for r in routes}}
    runtime = app.get("runtime", {})
    matches = [r for values in read_json(REGISTRY_PATH)["resources"].values() if isinstance(values, list)
               for r in values if isinstance(r, dict) and r.get("stable_resource_id") == runtime.get("resource_id")]
    if len(matches) != 1:
        raise NotRun("fixed APP runtime resource is missing or ambiguous")
    registered = matches[0]
    if registered.get("status") == "planned" or registered.get("application_root") != app["root"]:
        raise NotRun("fixed APP runtime is planned or belongs to another application")
    fields = ("root", "port", "health_url", "tenant_admin_url", "tenant_beta_url", "platform_url", "docs_url")
    if compose:
        if not runtime.get("compose_environment") or not runtime.get("compose_project"):
            raise NotRun("production-compose requires a registered Compose target; development HTTP does not prove Compose")
        fields += ("compose_environment", "compose_project")
    for field in fields:
        if not runtime.get(field) or runtime.get(field) != registered.get(field):
            fail(f"fixed APP runtime registration missing or different: {field}")
    canonical(runtime["root"], directory=True)
    binding = {key: app[key] for key in ("resource_id", "endpoint_id", "database")}
    if registered.get("database_binding") != binding:
        fail("runtime database association is not registered")
    for field in ("health_url", "tenant_admin_url", "tenant_beta_url", "platform_url", "docs_url"):
        url = urlsplit(runtime[field])
        if (url.scheme not in ("http", "https") or not url.port or url.username or url.password
                or not url.hostname or not (url.hostname in ("localhost", "127.0.0.1") or url.hostname.endswith(".localhost"))):
            fail("runtime HTTP/browser URL must use its registered loopback listener")
    if not compose:
        return registered
    file_reference(runtime["compose_environment"])
    if (not re.fullmatch(r"[a-f0-9]{64}", registered.get("compose_config_sha256", ""))
            or not isinstance(registered.get("persistent_mounts"), list) or not registered["persistent_mounts"]
            or not registered.get("owner")):
        fail("runtime resolved configuration, persistent mounts or owner missing from registry")
    return registered


def candidate_inputs(value: dict[str, Any], candidate: str, tree: str) -> dict[str, Any]:
    """Common immutable Code/CLI/template inputs, with no APP or DB access."""
    if value.get("source") != {"commit": candidate, "tree": tree}:
        fail("candidate inputs must bind this exact Code source")
    cli = value.get("cli", {})
    cli_root = canonical(cli.get("root", ""), directory=True)
    checkout_identity(cli_root, cli.get("commit", ""), cli.get("tree", ""))
    if command(["git", "-C", str(cli_root), "remote", "get-url", "origin"], capture=True).stdout.strip() not in (
        "git@github.com:peanut-business/peanut-cli.git", "https://github.com/peanut-business/peanut-cli.git"):
        fail("independent CLI source repository differs")
    if read_json(cli_root / "package.json").get("name") != "@peanut/cli":
        fail("independent CLI package identity differs")
    entry = canonical(str(cli_root / "bin/peanut.js"))
    cli = {**cli, "entry_sha256": sha256(entry)}
    templates_root = canonical(value.get("template_build_root", ""), directory=True)
    templates = template_inputs(templates_root, candidate, tree)
    return {"cli": cli, "template_artifacts": templates, "template_build_root": str(templates_root),
            "cli_creation": value.get("cli_creation")}


def cli_created_applications(inputs: dict[str, Any], candidate: str, tree: str, cache: Path) -> dict[str, Any]:
    """Reuse the original native candidate-stage creation assertions, without writes."""
    reference = inputs.get("cli_creation")
    if not reference:
        raise NotRun("CLI create: original candidate/CLI/archive/Edition and no-implicit-install evidence unavailable; "
                     "an upgraded APP cannot prove creation and no temporary APP will be created")
    receipt = read_json(file_reference(reference))
    producer = receipt.get("producer", {})
    original = command(["git", "show", candidate + ":scripts/p0e-runtime-qualification"], capture=True).stdout
    # The pre-existing native candidate producer checked the created manifests,
    # archive/Edition identity and all no-implicit-install paths in one invocation.
    # Consume that complete result; never accept a hand-written assertion envelope
    # or the current manifest of an application upgraded since its creation.
    if (receipt.get("protocol") != "peanut.p0e-candidate-stage.v1"
            or receipt.get("status") != "candidate-passed" or receipt.get("scope") != "candidate"
            or receipt.get("candidate") != candidate or receipt.get("candidate_tree") != tree
            or receipt.get("cli") != inputs["cli"]
            or receipt.get("template_artifacts") != inputs["template_artifacts"]
            or producer.get("path") != "scripts/p0e-runtime-qualification"
            or producer.get("sha256") != hashlib.sha256(original.encode()).hexdigest()
            or producer.get("verifier_sha256") != sha256(ROOT / "scripts/release-template-artifacts.mjs")
            or receipt.get("native_check", {}).get("rc") != 0):
        fail("original native CLI creation evidence does not bind this candidate/CLI/templates/producer")
    components = receipt.get("groups", {}).get("generated-application", {}).get("components", {})
    created = receipt.get("cli_created_applications", {})
    if (components.get("native_template_contract") != "passed"
            or components.get("cli_create_and_app_identity") != "passed" or set(created) != set(EDITIONS)):
        raise NotRun("CLI create: original native creation assertions are incomplete")
    for edition in EDITIONS:
        result = created[edition]
        if (not re.fullmatch(r"[a-f0-9]{64}", result.get("manifest_sha256", ""))
                or result.get("cli_result", {}).get("status") != "created"
                or not result.get("documentation")):
            fail("original native CLI creation result is incomplete for " + edition)
    return created



MODULE_QUALIFICATION_KEYS = ("peanut.member", "peanut.file", "peanut.task", "peanut.import-export", "peanut.notification")


def module_qualification_inputs(value: dict[str, Any], candidate: str, tree: str, *, executing: bool = False) -> dict[str, Any]:
    config = value.get("module_qualification")
    if not isinstance(config, dict) or config.get("protocol") != "peanut.module-qualification-input.v1":
        fail("module-lifecycle requires explicit isolated Module qualification inputs")
    if config.get("source") != {"commit": candidate, "tree": tree}:
        fail("Module qualification inputs must bind the fixed Code candidate")
    source = config.get("reviewed_module_source", {})
    source_root = canonical(source.get("root", ""), directory=True)
    checkout_identity(source_root, source.get("commit", ""), source.get("tree", ""))
    source_lock = file_reference({"path": str(source_root / "modules.lock"), "sha256": source.get("modules_lock_sha256")})
    locked = {entry["key"]: entry for entry in read_json(source_lock).get("modules", [])}
    if not set(MODULE_QUALIFICATION_KEYS) <= set(locked):
        fail("reviewed Module source lacks the actual Member/File/Task/ImportExport/Notification declarations")
    source_resource = database_registration(source)
    roots = {ROOT, source_root}
    schemas = {(source_resource.get("server_uuid"), source_resource.get("database"))}
    for key in ("lifecycle_application", "failure_recovery_application", "installed_application"):
        app = config.get(key, {})
        root = canonical(app.get("root", ""), directory=True)
        if any(root == protected or root in protected.parents or protected in root.parents for protected in roots):
            fail("Module qualification APPs must be separate from Code, reviewed Module source and each other")
        roots.add(root)
        checkout_identity(root, app.get("head", ""), app.get("tree", ""),
                          clean=not (executing and key in ("lifecycle_application", "failure_recovery_application")))
        registered = database_registration(app)
        description = str(registered.get("purpose", "")).lower() + " " + str(registered.get("data_source", "")).lower()
        if "qualification" not in description or "synthetic" not in description:
            fail("Module qualification requires an explicitly registered synthetic qualification APP/database")
        if (registered.get("application_runtime") is not False or registered.get("lifecycle") != "ephemeral"
                or "module_lifecycle" not in registered.get("allowed_scenarios", [])):
            fail("Module qualification requires the existing ephemeral non-runtime registry contract and its explicit allowed case")
        schema = (registered.get("server_uuid"), registered.get("database"))
        if schema in schemas:
            fail("Module qualification must never write the reviewed source or another APP database")
        schemas.add(schema)
        identity = app.get("database_identity", {})
        if (identity.get("database") != registered.get("database")
                or identity.get("server_uuid") != registered.get("server_uuid")):
            fail("Module qualification native MySQL identity differs from the registry")
        app_manifest = read_json(file_reference({"path": str(root / ".peanut/application-manifest.json"), "sha256": app.get("manifest_sha256")}))
        if app_manifest.get("application", {}).get("edition") != "multi-tenant":
            fail("Module qualification APPs must retain their real multi-tenant application identity")
        environment = file_reference(app.get("environment", {}))
        if environment.stat().st_mode & 0o777 != 0o600:
            fail("isolated Module APP environment must remain private")
        runtime_admission(app, str(root), app["head"])
        if key == "installed_application":
            installed_lock = file_reference({"path": str(root / "modules.lock"), "sha256": app.get("modules_lock_sha256")})
            installed = {entry["key"]: entry for entry in read_json(installed_lock).get("modules", [])}
            for module in MODULE_QUALIFICATION_KEYS:
                if (module not in installed or installed[module].get("source") != locked[module].get("source")
                        or installed[module].get("manifest_sha256") != locked[module].get("manifest_sha256")):
                    fail("isolated APP Module declaration differs from the reviewed Module source: " + module)
    tokens = file_reference(config.get("identity_context", {}))
    if tokens.stat().st_mode & 0o777 != 0o600:
        fail("native Module identity context must remain private")
    if any(not isinstance(config.get(key), int) or config[key] < 1 for key in ("other_tenant_id", "alpha_role_id")):
        fail("Module qualification requires actual existing Tenant/Role selectors")
    return config


def verify_module_context(args: argparse.Namespace) -> dict[str, Any]:
    plan_path = file_reference({"path": args.plan, "sha256": args.plan_sha256})
    proof = read_json(plan_path)
    if "module-lifecycle" not in proof.get("groups", []):
        fail("the fixed plan does not admit Module lifecycle qualification")
    binding = proof.get("qualification_tool_binding")
    if binding is not None:
        configure_source(argparse.Namespace(candidate=proof["candidate"], source_root=proof["worktree"],
            qualification_tool_commit=binding["tool_commit"], qualification_tool_files_sha256=binding["tool_files_sha256"]))
    elif canonical(proof["worktree"], directory=True) != TOOL_ROOT:
        fail("Module qualifier must use the fixed source checkout or its explicitly bound tool checkout")
    validate_candidate(proof["candidate"], require_clean=True)
    inputs = proof["lifecycle_inputs"]
    module_qualification_inputs(inputs, proof["candidate"], proof["candidate_tree"], executing=True)
    file_reference({"path": inputs["input_path"], "sha256": inputs["input_sha256"]})
    verify_lease(argparse.Namespace(**{key: proof[key] for key in
        ("candidate", "run_id", "lease", "owner", "thread", "parent_lease")}), proof)
    return {"status": "verified", "candidate": proof["candidate"], "plan_sha256": args.plan_sha256}


def lifecycle_inputs(args: argparse.Namespace, tree: str) -> dict[str, Any]:
    input_path = file_reference({"path": args.lifecycle_input, "sha256": args.lifecycle_input_sha256})
    value = read_json(input_path)
    if value.get("protocol") != "peanut.p0e-lifecycle-inputs.v1" or value.get("source") != {"commit": args.candidate, "tree": tree}:
        fail("lifecycle inputs must bind this exact Code candidate")
    if not os.environ.get("PEANUT_RESOURCE_REGISTRY"):
        fail("explicit maintainer resource registry is required")
    registry = read_json(canonical(str(REGISTRY_PATH)))
    if registry.get("authority", {}).get("role") != "maintainer":
        fail("maintainer registry authority required")
    command([str(REGISTRY_TOOL), "p0e-maintainer-source", "--sha256", sha256(REGISTRY_PATH)], capture=True)
    resources = registry.get("resources", {}).get("databases", [])
    prepared = candidate_inputs(value, args.candidate, tree)
    cli, templates = prepared["cli"], prepared["template_artifacts"]
    apps = value.get("applications", {})
    if set(apps) != set(EDITIONS):
        fail("exactly the two registered permanent APPs are required")
    for edition in EDITIONS:
        app = apps[edition]
        root = canonical(app.get("root", ""), directory=True)
        matches = [r for r in resources if r.get("stable_resource_id") == APP_RESOURCES[edition]]
        if len(matches) != 1:
            fail("permanent APP resource is missing or ambiguous")
        resource = matches[0]
        endpoint = resource.get("upstream_endpoint", {})
        if (app.get("resource_id") != APP_RESOURCES[edition] or resource.get("application_identity", {}).get("root") != str(root)
                or app.get("database") != resource.get("database") or app.get("endpoint_id") != endpoint.get("endpoint_id")
                or edition not in resource.get("deployment_modes", [])):
            fail("permanent APP root/resource/database/Edition differs from the registry")
        head = command(["git", "-C", str(root), "rev-parse", "HEAD"], capture=True).stdout.strip()
        if head != app.get("head"):
            fail("permanent APP Git head changed")
        manifest_path = file_reference({"path": str(root / ".peanut/application-manifest.json"), "sha256": app.get("manifest_sha256")})
        manifest = read_json(manifest_path)
        if (manifest.get("application", {}).get("edition") != edition or manifest.get("edition", {}).get("name") != edition
                or manifest.get("template", {}).get("source_commit") != args.candidate
                or manifest.get("template", {}).get("source_tree") != tree
                or manifest.get("template", {}).get("version") != templates["version"]
                or manifest.get("template", {}).get("inventory_sha256") != templates["source"]["inventory_sha256"]
                or app.get("adopted_source") != templates["source"]):
            fail("permanent APP has not adopted this fixed template source")
        if baseline_identity(root, manifest) != app.get("baseline_sha256"):
            fail("APP native baseline files/digests differ")
        own_registry = read_json(root / "resources/project-resources.json")
        own = [r for r in own_registry.get("resources", {}).get("databases", []) if r.get("stable_resource_id") == app["resource_id"]]
        if len(own) != 1 or own[0].get("database") != app["database"] or own[0].get("upstream_endpoint") != endpoint:
            fail("APP-owned runtime registry differs from its actual registered resource")
        env = file_reference(app.get("environment", {}))
        if env.stat().st_mode & 0o777 != 0o600:
            fail("APP runtime environment must remain private")
        # Pin the existing installation and upgrade/recovery evidence; never reinstall to manufacture it.
        for name in ("first_install", "upgrade_retention", "recovery"):
            if app.get(name):
                file_reference(app[name])
    if value.get("installed_lifecycle"):
        fail("retired installed-lifecycle producer inputs must be replaced by isolated module_qualification inputs")
    if value.get("module_qualification") is not None:
        module_qualification_inputs(value, args.candidate, tree)
    file_reference(value.get("consumer_identity_seed", {}))
    return {**value, "cli": cli, "template_artifacts": templates,
            "input_path": str(input_path), "input_sha256": args.lifecycle_input_sha256,
            "registry_sha256": sha256(REGISTRY_PATH)}


def plan(args: argparse.Namespace, require_clean: bool) -> dict[str, Any]:
    _, tree = validate_candidate(args.candidate, require_clean=require_clean)
    inputs = lifecycle_inputs(args, tree)
    groups = read_json(FIXTURE_PATH).get("groups", [])
    if len(groups) != 8 or len(set(groups)) != 8:
        fail("the eight native qualification groups must remain intact")
    selected = groups
    scope = "full"
    if args.minimum_release:
        fail("minimum-release is not full qualification; use the candidate preflight stage or an explicit group selection")
    if args.groups and args.through_group:
        fail("groups and through-group are mutually exclusive")
    if args.groups:
        requested = args.groups.split(",")
        if len(requested) != len(set(requested)) or set(requested) - set(groups) or not requested:
            fail("invalid group selection")
        selected = [g for g in groups if g in requested]
        scope = "selected-groups"
    elif args.through_group:
        if args.through_group not in groups:
            fail("unknown terminal group")
        selected = groups[:groups.index(args.through_group) + 1]
        scope = "through-group"
    output = Path(args.output_dir)
    cache = Path(args.cache_dir)
    for path in (output, cache):
        if (not path.is_absolute() or path == ROOT or ROOT in path.parents or path.resolve() != path
                or not path.parent.is_dir() or args.run_id not in path.name):
            fail("qualification output/cache must be canonical run-specific leaves outside source")
        protected = [ROOT, Path(inputs["cli"]["root"]), Path(inputs["template_build_root"]),
                     *(Path(app["root"]) for app in inputs["applications"].values())]
        if inputs.get("module_qualification"):
            qualification = inputs["module_qualification"]
            protected.extend(Path(qualification[key]["root"]) for key in
                             ("reviewed_module_source", "lifecycle_application", "failure_recovery_application", "installed_application"))
        for root in protected:
            if path == root or root in path.parents or path in root.parents:
                fail("temporary paths must not overlap fixed sources, templates or permanent APPs")
    if output == cache or output in cache.parents or cache in output.parents:
        fail("output and cache must be separate")
    common = Path(git("rev-parse", "--git-common-dir"))
    common = (ROOT / common).resolve() if not common.is_absolute() else common.resolve()
    lease_dir = common / "peanut-admin-resource-leases/leases" / args.lease
    resources = [("registry-sha256", inputs["registry_sha256"]), ("run-id", args.run_id),
                 ("candidate-tree", tree), ("output-dir", str(output)), ("cache-dir", str(cache))]
    if args.parent_lease:
        fail("fixed lifecycle qualification does not inherit runtime leases")
    admissions = []
    gate = "p0e-runtime-qualification"
    qualification_apps = []
    if "module-lifecycle" in selected:
        qualification = module_qualification_inputs(inputs, args.candidate, tree)
        qualification_apps = [qualification[key] for key in ("lifecycle_application", "failure_recovery_application", "installed_application")]
        for app in qualification_apps:
            admissions.append(runtime_admission(app, app["root"], app["head"]))
    for app in inputs["applications"].values():
        admissions.append(runtime_admission(app, app["root"], app["head"]))
    for admission in admissions:
        runtime = next(app for app in [*inputs["applications"].values(), *qualification_apps]
                       if app["root"] == admission["root"])
        runtime_environment(runtime, admission)
    # Production Compose is admitted by its own group. A browser selection binds
    # only the existing HTTP route and never requires or starts Compose.
    for edition, app in inputs["applications"].items():
        runtime = app.get("runtime", {})
        if ("production-compose" in selected and runtime.get("compose_environment")
                and runtime.get("compose_project")):
            try:
                runtime_registration(app)
            except NotRun:
                pass  # Missing/planned Compose affects its own group only.
            else:
                resources.extend((("resource-id", runtime["resource_id"]),
                                  ("port", str(runtime["port"])),
                                  ("compose-project", runtime["compose_project"])))
        if edition + "-browser" not in selected:
            continue
        runtime = app.get("runtime", {})
        try:
            registered = runtime_registration(app, compose=False)
        except NotRun:
            # Missing browser routes affect that group, not unrelated native groups.
            continue
        for resource_id, route in registered["routes"].items():
            resources.extend((("resource-id", resource_id), ("port", str(route["port"])) ))
    return {"schema_version": 1, "gate": gate, "candidate": args.candidate, "candidate_tree": tree,
        "worktree": str(ROOT), "run_id": args.run_id, "lease": args.lease, "owner": getattr(args, "owner", None),
        "thread": getattr(args, "thread", None), "parent_lease": args.parent_lease,
        "registry_path": str(REGISTRY_PATH), "registry_sha256": inputs["registry_sha256"],
        "paths": {"output-dir": str(output), "cache-dir": str(cache)}, "lease_proof_dir": str(lease_dir),
        "groups": selected, "full_gate_groups": groups, "selection_scope": scope, "through_group": args.through_group,
        "lifecycle_inputs": inputs, "template_artifacts": inputs["template_artifacts"], "runtime_admissions": admissions,
        "qualification_tool_binding": TOOL_BINDING,
        "lease_resources": [{"type": k, "value": v} for k, v in sorted(set(resources))]}


def claim(args: argparse.Namespace, value: dict[str, Any]) -> None:
    for path in value["paths"].values():
        if Path(path).exists():
            fail("new qualification outputs must be absent")
    arguments = [str(LEASE_TOOL), "claim", "--lease", args.lease, "--owner", args.owner, "--thread", args.thread,
        "--candidate", args.candidate, "--candidate-repository", str(ROOT), "--gate", value["gate"], "--ttl", str(args.ttl)]
    if args.parent_lease:
        arguments.extend(["--parent-lease", args.parent_lease])
    for item in value["lease_resources"]:
        arguments.extend(["--resource", item["type"] + "=" + item["value"]])
    command(arguments)


def transport(args: argparse.Namespace) -> dict[str, Any]:
    """Seal completed native qualification and its original template bytes for CI."""
    summary_path = canonical(args.summary)
    summary = read_json(summary_path)
    qualification = summary_path.parent
    plan_data = read_json(canonical(str(qualification / "plan.json")))
    binding = plan_data.get("qualification_tool_binding")
    if binding:
        configure_source(argparse.Namespace(source_root=binding["source_root"], candidate=summary["candidate"],
            qualification_tool_commit=binding["tool_commit"], qualification_tool_files_sha256=binding["tool_files_sha256"]))
        if TOOL_BINDING != binding:
            fail("transport qualification tools differ from the native executed plan")
    checkpoint = read_json(canonical(str(qualification / "checkpoint.json")))
    groups = read_json(FIXTURE_PATH)["groups"]
    if (len(groups) != 8 or summary.get("status") != "passed" or summary.get("scope") != "full"
            or summary.get("planned_groups") != groups or summary.get("full_gate_groups") != groups
            or plan_data.get("groups") != groups or checkpoint.get("groups") != summary.get("groups")
            or summary.get("cleanup", {}).get("lease_released") is not True):
        fail("transport requires the native completed eight-group closeout; partial/failed inputs are not publishable")
    for value in (plan_data, checkpoint):
        for key in ("candidate", "candidate_tree", "run_id", "lifecycle_inputs", "template_artifacts"):
            if value.get(key) != summary.get(key):
                fail("native qualification plan/checkpoint/summary inputs differ")
    _, tree = validate_candidate(summary["candidate"], require_clean=True)
    if tree != summary["candidate_tree"]:
        fail("transport source tree differs from the qualified candidate")
    template_root = canonical(summary["lifecycle_inputs"]["template_build_root"], directory=True)
    if template_inputs(template_root, summary["candidate"], tree, verify=True) != summary["template_artifacts"]:
        fail("original qualified template bytes changed")
    files = {"qualification/summary.json": summary_path,
             "qualification/plan.json": qualification / "plan.json",
             "qualification/checkpoint.json": qualification / "checkpoint.json",
             "qualification/main-integration.json": canonical(args.main_integration)}
    for group in groups:
        state = summary["groups"].get(group, {})
        receipt = file_reference(state.get("receipt", {}))
        result = read_json(receipt)
        if (state.get("status") != "passed" or receipt != qualification / "groups" / (group + ".json")
                or result.get("status") != "passed" or result.get("candidate") != summary["candidate"]
                or result.get("candidate_tree") != tree
                or result.get("lifecycle_input_sha256") != summary["lifecycle_inputs"]["input_sha256"]):
            fail("native group receipt is absent, incomplete or belongs to another execution")
        files["qualification/groups/" + group + ".json"] = receipt
    integration = read_json(files["qualification/main-integration.json"])
    if integration.get("source_commit") != summary["candidate"] or integration.get("ready_for_stable") is not True:
        fail("native main integration receipt does not bind this qualified source")
    directories = []
    for path in sorted(template_root.rglob("*")):
        canonical(str(path), directory=path.is_dir())
        if path.is_file():
            files["scaffold-templates/" + path.relative_to(template_root).as_posix()] = path
        else:
            directories.append(path)
    output = Path(args.output)
    if (not output.is_absolute() or output.exists() or output.is_symlink() or output.suffix != ".tgz"
            or output.parent.resolve() != output.parent or not output.parent.is_dir()
            or any(root == output.parent or root in output.parents for root in (ROOT, qualification, template_root))):
        fail("transport output must be an absent canonical .tgz outside source and qualified inputs")
    before = {name: sha256(path) for name, path in files.items()}
    try:
        with output.open("xb") as stream:
            os.fchmod(stream.fileno(), 0o600)
            with tarfile.open(fileobj=stream, mode="w:gz") as archive:
                for path in directories:
                    archive.add(path, arcname="scaffold-templates/" + path.relative_to(template_root).as_posix(), recursive=False)
                for name, path in sorted(files.items()):
                    archive.add(path, arcname=name, recursive=False)
        if any(sha256(path) != before[name] for name, path in files.items()):
            fail("qualified inputs changed during transport capture")
    except Exception:
        # Preserve a failed capture for diagnosis; it is never reported publishable.
        raise
    return {"status": "sealed", "candidate": summary["candidate"], "candidate_tree": tree,
            "path": str(output), "sha256": sha256(output), "bytes": output.stat().st_size,
            "main_integration_sha256": before["qualification/main-integration.json"],
            "ci_ingress": "not_run: requires an admitted Actions artifact upload; sealing never publishes or uploads"}


def generated_state(root: Path) -> dict[str, Any]:
    """Snapshot existing native generated outputs and their current declared inputs."""
    edition = read_json(root / ".peanut/application-manifest.json")["application"]["edition"]
    canonical(str(root / "server/public/admin/index.html"))
    if edition == "multi-tenant":
        canonical(str(root / "server/public/platform/index.html"))
    catalog = read_json(root / "server/generated/api-catalog.json")
    inputs = catalog.get("inputs", [])
    if catalog.get("schema_version") != 1 or not isinstance(inputs, list) or not inputs:
        raise NotRun("final API catalog has no native input inventory")
    for item in inputs:
        relative = Path(item.get("path", ""))
        if not relative.parts or relative.is_absolute() or ".." in relative.parts:
            fail("native API input path is unsafe")
        file_reference({"path": str(root / relative), "sha256": item.get("sha256")})
    paths = {root / "server/generated/api-catalog.json", root / "server/generated/openapi.json",
             root / "web/src/generated/openapi.d.ts"}
    paths.update((root / "web/src/modules").glob("*/generated/openapi.ts"))
    for relative in ("server/public/admin", "server/public/platform"):
        directory = root / relative
        if directory.is_symlink():
            fail("native static output directory is unsafe")
        if directory.is_dir():
            for path in directory.rglob("*"):
                if path.is_symlink():
                    fail("native static output contains a symlink")
                if not path.is_dir():
                    paths.add(path)
    outputs = {}
    for path in sorted(paths):
        canonical(str(path))
        outputs[path.relative_to(root).as_posix()] = {"sha256": sha256(path), "mode": path.stat().st_mode & 0o777}
    producers = {}
    for relative in ("scripts/generate-api-contracts.php", "scripts/deploy-update.sh",
                     "server/app/common/module/Dependencies.php", "web/package.json", "web/vite.config.ts",
                     "platform/package.json", "platform/vite.config.ts", "server/composer.lock", "modules.lock",
                     "web/pnpm-lock.yaml", "platform/package-lock.json", "pc/package-lock.json", "uniapp/package-lock.json"):
        path = root / relative
        if path.exists() or path.is_symlink():
            canonical(str(path))
            producers[relative] = sha256(path)
    return {"api_inputs": inputs, "inputs_and_producers": producers, "outputs": outputs}


def native_evidence(reference: dict[str, Any], app: dict[str, Any], kind: str,
                    final_build: dict[str, Any] | None = None) -> dict[str, Any]:
    """Read the native producer's own state, never an operator-written PASS envelope."""
    if not reference:
        raise NotRun(kind + ": native evidence is unavailable; no operation replayed")
    path = file_reference(reference)
    state = read_json(path)
    root = Path(app["root"])
    server = root / "server"
    if kind == "first_install":
        if path != server / "private/installation/installed.json":
            fail("first-install reference must be the APP's original native installation receipt")
        # Use the native historical-source/migration-chain verifier. It deliberately
        # does not compare the original installation with the current upgrade target.
        facts = json.loads(command(["php", "-r",
            "require $argv[1] . '/vendor/autoload.php';"
            "echo json_encode(\\app\\common\\services\\installation\\InstallationExecutionHost::verifiedInstallationFacts($argv[1]), JSON_THROW_ON_ERROR);",
            str(server)], cwd=root, capture=True).stdout)
        if (facts.get("receipt_sha256") != sha256(path) or facts.get("receipt") != state
                or state.get("deployment_mode") != read_json(root / ".peanut/application-manifest.json")["application"]["edition"]):
            fail("native historical installation facts differ from the pinned APP receipt")
        return {"path": str(path), "sha256": facts["receipt_sha256"], "completed_at": state["completed_at"],
                "historical_source": state["source"], "historical_installation_only": True}
    if kind == "upgrade_retention":
        if (root / ".peanut/upgrades" not in path.parents or state.get("protocol") != "peanut.scaffold-upgrade-plan.v2"
                or state.get("status") != "ready"):
            fail("upgrade reference must be an APP-owned native scaffold plan")
        digest = "sha256:" + hashlib.sha256(json.dumps([state["identity"], state["actions"]],
            sort_keys=True, ensure_ascii=False, separators=(",", ":")).encode()).hexdigest()
        if digest != state.get("plan_sha256") or state.get("candidate") != "scaffold-" + digest[7:31]:
            fail("native scaffold plan identity differs")
        ledger_path = canonical(str(root / ".peanut/upgrades/ledger.ndjson"))
        events = [json.loads(line) for line in ledger_path.read_text().splitlines() if line]
        matching = [event for event in events if event.get("candidate") == state["candidate"]]
        identity_digest = hashlib.sha256(json.dumps(state["identity"], sort_keys=True, ensure_ascii=False,
            separators=(",", ":")).encode()).hexdigest()
        if (not matching or matching[-1].get("status") != "verified"
                or not any(e.get("operation") == "apply" and e.get("status") == "applied" for e in matching)
                or any(e.get("plan_sha256") != digest or e.get("identity_sha256") != identity_digest for e in matching)):
            fail("native scaffold ledger has no matching completed apply/verify")
        # verify is a transaction-stage command, not a completed-state query.
        # Consume its committed afterimage and the same native file-state digest
        # without reopening maintenance or appending another ledger event.
        manifest = read_json(root / ".peanut/application-manifest.json")
        identity = state["identity"]
        target = identity["to"]
        if (manifest["template"].get("source_commit") != target.get("source_commit")
                or manifest["template"].get("source_tree") != target.get("source_tree")
                or manifest["template"].get("version") != target.get("version")
                or manifest.get("generation_source") != identity.get("target_generation_source")
                or manifest["application"].get("version") != identity.get("application_version")
                or manifest.get("edition") != identity.get("edition")
                or ("target_template_package" in identity and manifest.get("template_package") != identity["target_template_package"])
                or ("target_installation_migrations" in identity and manifest.get("installation_migrations") != identity["target_installation_migrations"])):
            fail("committed upgrade target differs from current APP/source identity")
        states = {"managed": {}, "app-owned": {}}
        generated_changes = []
        for item in manifest["files"]:
            classification = item["classification"]
            category = "managed" if classification in ("managed", "generated-managed") else classification
            if category not in states:
                continue
            relative = Path(item["path"])
            if relative.is_absolute() or ".." in relative.parts:
                fail("native APP file-state path is unsafe")
            target_path = root / relative
            if target_path.exists() or target_path.is_symlink():
                canonical(str(target_path))
                actual = {"present": True, "sha256": sha256(target_path), "mode": target_path.stat().st_mode & 0o777}
            else:
                actual = {"present": False, "sha256": None, "mode": None}
            states[category][item["path"]] = actual
            if category == "managed" and (not actual["present"] or actual["sha256"] != item.get("sha256")
                    or actual["mode"] != item.get("mode", 0o644)):
                # API/static producers legitimately replace these outputs after
                # source apply/verify. Preserve the historical verify digest and
                # require separate final producer evidence rather than rewriting it.
                if (item["path"] in ("server/generated/api-catalog.json", "server/generated/openapi.json")
                        or item["path"].startswith("server/public/admin/")
                        or item["path"].startswith("server/public/platform/")
                        or item["path"] == "web/src/generated/openapi.d.ts"
                        or re.fullmatch(r"web/src/modules/[^/]+/generated/openapi\.ts", item["path"])):
                    generated_changes.append(item["path"])
                    states[category][item["path"]] = {"present": True, "sha256": item.get("sha256"),
                                                    "mode": item.get("mode", 0o644)}
                else:
                    fail("native committed managed afterimage changed")
        digests = {k: "sha256:" + hashlib.sha256(json.dumps(v if v else [], sort_keys=True, ensure_ascii=False,
            separators=(",", ":")).encode()).hexdigest() for k, v in states.items()}
        if digests["managed"] != matching[-1].get("post_sha256"):
            fail("native source verify afterimage differs")
        expected_owned = dict(state.get("app_owned_pre_state", {}))
        pre_digest = "sha256:" + hashlib.sha256(json.dumps(expected_owned if expected_owned else [],
            sort_keys=True, ensure_ascii=False, separators=(",", ":")).encode()).hexdigest()
        if pre_digest != identity.get("app_owned_pre_sha256"):
            fail("native plan APP-owned pre-state identity differs")
        original_owned = dict(states["app-owned"])
        by_path = {item["path"]: item for item in manifest["files"]}
        for action in state["actions"]:
            name = action["path"]
            if (name in expected_owned and action.get("reason") == "conflict_replace_confirmed"
                    and action.get("action") in ("replace", "regenerate", "rename")):
                del expected_owned[name]
            if (action.get("action") == "omit" and action.get("reason") in (
                    "upstream_removed_preserve_confirmed", "conflict_upstream_delete_confirmed",
                    "installation_source_retained", "missing_file_preserve_confirmed")
                    and (action["current"]["present"] or action["reason"] in (
                        "upstream_removed_preserve_confirmed", "missing_file_preserve_confirmed"))):
                entry = by_path.get(name, {})
                actual = states["app-owned"].get(name)
                if (entry.get("classification") != "app-owned" or entry.get("owner") != "application"
                        or entry.get("source") != name or actual != action["current"]
                        or entry.get("sha256") != actual.get("sha256") or entry.get("mode") != actual.get("mode")
                        or any(k in entry for k in ("baseline_path", "baseline_sha256", "baseline_mode"))):
                    fail("native retained APP ownership or protected state differs")
                if name not in state.get("app_owned_pre_state", {}):
                    original_owned.pop(name, None)
        if original_owned != expected_owned:
            fail("native upgrade APP-owned preservation differs")
        if generated_changes:
            if not final_build:
                raise NotRun("upgrade-retention: source apply/verify and APP-owned protection checked; "
                             "generated-application final output record unavailable for: " + ", ".join(generated_changes))
            build = final_build.get("editions", {}).get(manifest["application"]["edition"], {}).get("source_build", {})
            if (final_build.get("candidate") != target.get("source_commit")
                    or final_build.get("candidate_tree") != target.get("source_tree")
                    or final_build.get("components", {}).get("source_build") != "passed"
                    or build.get("application") != app_binding(app)
                    or build.get("generated_state") != generated_state(root)):
                fail("final generated outputs or their native inputs differ from the recorded APP build")
            edition = manifest["application"]["edition"]
            commands = build.get("commands", [])
            expected = [(["php", str(ROOT / "scripts/generate-api-contracts.php"), "--application-root=" + str(root)], str(root)),
                        (["pnpm", "run", "build", "--mode", edition, "--outDir", "../server/public/admin", "--emptyOutDir"], str(root / "web"))]
            if edition == "multi-tenant":
                expected.append((["npm", "run", "build", "--", "--outDir", "../server/public/platform", "--emptyOutDir"], str(root / "platform")))
            if (build.get("api_generator_sha256") != sha256(ROOT / "scripts/generate-api-contracts.php")
                    or any(not any(row.get("argv") == argv and Path(row.get("cwd", "")) == Path(cwd)
                                   and row.get("environment") == {"NODE_ENV": "production", "VITE_API_BASE_URL": ""}
                                   and row.get("exit_code") == 0 for row in commands) for argv, cwd in expected)):
                raise NotRun("upgrade-retention: final outputs lack matching native API/admin/platform generation commands")
        return {"path": str(path), "sha256": sha256(path), "ledger_sha256": sha256(ledger_path),
                "completed_at": matching[-1]["recorded_at"], "afterimage_digests": digests}
    # A source rollback never proves database restoration. Consume the existing
    # instance-authenticated server update recovery producer and its full allowlist.
    if kind != "recovery" or path.name != "database-recovery.json":
        fail("recovery reference must be the original native database-recovery.json")
    workspace = path.parent
    native = runpy.run_path(str(TOOL_ROOT / "server/docker/scripts/update-recovery.py"))
    native["check_signature"](server, path)
    native["check_backup_signature"](server, workspace)
    backup = read_json(workspace / "backup.json")
    plan_path = canonical(str(workspace / "plan.json"))
    update = read_json(plan_path)
    if (state.get("status") != "completed" or state.get("backup_sha256") != sha256(workspace / "backup.json")
            or backup.get("protocol") != "peanut.server-update-backup.v1"
            or state.get("update_id") != backup.get("update_id") or state.get("update_id") != update.get("update_id")
            or backup.get("plan_sha256") != sha256(plan_path)
            or backup.get("database_identity") != {k: app[k] for k in ("resource_id", "endpoint_id", "database")}
            or not state.get("mysql_identity") or state["mysql_identity"] != backup.get("mysql_identity")):
        fail("authenticated native database recovery belongs to another plan/APP/database")
    if (set(backup.get("snapshots", {})) != native["SNAPSHOT_SET"]
            or set(backup.get("storage", {})) != set(native["STORAGE_NAMES"])):
        fail("native recovery omits protected configuration, uploads or installation identity")
    native["verify_backup_attachments"](server, workspace, update, sha256(plan_path),
        {k: app[k] for k in ("resource_id", "endpoint_id", "database")})
    for name, digest in backup["snapshots"].items():
        target = server / name
        if digest is None:
            if target.exists() or target.is_symlink():
                fail("previously absent protected installation/configuration appeared")
        elif sha256(canonical(str(target))) != digest:
            fail("protected native installation/configuration identity changed")
    for name, entry in backup["storage"].items():
        target = server / name
        if entry is None:
            if target.exists() or target.is_symlink():
                fail("previously absent protected storage appeared")
        elif native["storage_inventory"](target) != entry["inventory"]:
            fail("protected uploads/storage differs from the native recovery point")
    return {"path": str(path), "sha256": sha256(path), "backup_sha256": state["backup_sha256"],
            "native_producer_sha256": sha256(TOOL_ROOT / "server/docker/scripts/update-recovery.py")}


class Runner:
    def __init__(self, args: argparse.Namespace, value: dict[str, Any]) -> None:
        self.args, self.plan = args, value
        self.output, self.cache = Path(value["paths"]["output-dir"]), Path(value["paths"]["cache-dir"])
        self.checkpoint_path, self.summary_path = self.output / "checkpoint.json", self.output / "summary.json"
        self.inputs = value["lifecycle_inputs"]
        self.apps = self.inputs["applications"]
        self.current_group = "preflight"
        self.checkpoint = {"schema_version": 1, "candidate": args.candidate, "candidate_tree": value["candidate_tree"],
            "run_id": args.run_id, "lease": args.lease, "parent_lease": args.parent_lease,
            "planned_groups": value["groups"], "lifecycle_inputs": self.inputs, "template_artifacts": value["template_artifacts"],
            "groups": {}}
        self.started_compose: list[str] = []

    @staticmethod
    def write_json(path: Path, value: Any) -> None:
        temporary = path.with_name(path.name + ".tmp")
        temporary.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        temporary.replace(path)

    def save_checkpoint(self) -> None:
        self.write_json(self.checkpoint_path, self.checkpoint)

    def group_log(self, group: str) -> Path:
        return self.output / "groups" / (group + ".log")

    def assert_inputs(self) -> None:
        current = lifecycle_inputs(self.args, self.plan["candidate_tree"])
        if current != self.inputs:
            fail("fixed lifecycle inputs changed; qualification cannot continue")

    def environment(self, runtime: dict[str, Any]) -> dict[str, str]:
        admissions = [a for a in self.plan["runtime_admissions"] if a["resource_id"] == runtime["resource_id"]]
        if len(admissions) != 1:
            fail("this runtime operation has no exact native admission")
        admission = admissions[0]
        verify_runtime_admission(admission, self.args.owner, self.args.thread)
        return runtime_environment(runtime, admission)

    def initialize(self) -> None:
        for path in (self.output, self.cache):
            path.mkdir(mode=0o700, exist_ok=False)
        (self.output / "groups").mkdir()
        self.write_json(self.output / "plan.json", self.plan)
        self.save_checkpoint()

    def resume(self) -> None:
        if read_json(self.output / "plan.json") != self.plan:
            fail("resume requires the exact original lifecycle plan")
        old = read_json(self.checkpoint_path)
        for key in ("candidate", "candidate_tree", "run_id", "lease", "parent_lease", "planned_groups", "lifecycle_inputs", "template_artifacts"):
            if old.get(key) != self.checkpoint[key]:
                fail("resume checkpoint identity changed")
        self.checkpoint = old

    def prepare_retry(self, group: str) -> None:
        # Unknown side effects and exhausted budgets retain their original native state.
        # No database reset, APP removal, environment replacement, or implicit command replay.
        fail(f"{group} is incomplete/failed; reconcile its original native operation before another qualification")

    def run_group(self, group: str, operation: Any) -> None:
        self.assert_inputs()
        verify_lease(self.args, self.plan)
        state = self.checkpoint["groups"].get(group, {})
        if state.get("status") == "passed":
            saved = file_reference(state.get("receipt", {}))
            if saved.parent != self.output / "groups":
                fail("completed group receipt is outside this exact run")
            return
        if state:
            self.prepare_retry(group)
        self.current_group = group
        self.checkpoint["groups"][group] = {"status": "running", "started_at": int(time.time())}
        self.save_checkpoint()
        try:
            result = operation()
        except NotRun as exception:
            result = {"status": "not_run", "reason": str(exception)}
        status = result.get("status", "passed")
        if status not in ("passed", "not_run"):
            fail("native group returned an invalid qualification status")
        self.assert_inputs()
        path = self.output / "groups" / (group + ".json")
        self.write_json(path, {"schema_version": 1, "status": "passed", "candidate": self.args.candidate,
            "candidate_tree": self.plan["candidate_tree"], "run_id": self.args.run_id,
            "lifecycle_input_sha256": self.inputs["input_sha256"], **result})
        self.checkpoint["groups"][group].update(status=status, finished_at=int(time.time()),
            receipt={"path": str(path), "sha256": sha256(path)})
        self.save_checkpoint()

    def generated_application(self) -> dict[str, Any]:
        templates = template_inputs(Path(self.inputs["template_build_root"]), self.args.candidate, self.plan["candidate_tree"], verify=True)
        if templates != self.plan["template_artifacts"]:
            fail("native template member/mode/tooling check changed its inputs")
        cli = self.inputs["cli"]
        type_generator = ROOT / "web/node_modules/openapi-typescript/bin/cli.js"
        if not type_generator.is_file():
            raise NotRun("generated-application: native API type generator is unavailable in fixed Code; no Code dependencies installed")
        # Guard all native static destinations before dependency/API/build writes.
        for edition, app in self.apps.items():
            root = Path(app["root"])
            destinations = [root / "server/public", root / "server/public/admin"]
            if edition == "multi-tenant":
                destinations.append(root / "server/public/platform")
            for destination in destinations:
                if (destination.resolve() != destination or destination.is_symlink()
                        or (destination.exists() and not destination.is_dir())):
                    fail("native static destination or its ancestor is not an ordinary directory")
        creation_reason = None
        try:
            result = cli_created_applications(self.inputs, self.args.candidate, self.plan["candidate_tree"], self.cache)
        except NotRun as exception:
            creation_reason = str(exception)
            result = {edition: {} for edition in EDITIONS}
        components = {"native_template_contract": "passed", "cli_create_and_app_identity": "not_run" if creation_reason else "passed",
                      "source_build": "not_run"}
        for edition in EDITIONS:
            # The CLI contract deliberately stops before dependency installation.
            # Source compilation belongs to the already fixed permanent APP, whose
            # adoption/locks are bound by lifecycle_inputs, not to another runtime.
            app = self.apps[edition]
            app_root = Path(app["root"])
            commands = [(["composer", "install", "--no-scripts", "--no-interaction", "--no-progress", "--prefer-dist"], "server"),
                        (["php", "-r", "require 'vendor/autoload.php';"], "server"),
                        (["pnpm", "install", "--frozen-lockfile"], "web"), (["pnpm", "run", "build", "--mode", edition, "--outDir", "../server/public/admin", "--emptyOutDir"], "web")]
            if edition == "multi-tenant":
                commands += [(["npm", "ci"], "platform"), (["npm", "run", "build", "--", "--outDir", "../server/public/platform", "--emptyOutDir"], "platform")]
            commands += [(["npm", "ci"], "pc"), (["npm", "run", "typecheck"], "pc"),
                         (["npm", "run", "generate"], "pc"), (["npm", "ci"], "uniapp"),
                         (["npm", "run", "type-check"], "uniapp"), (["npm", "run", "build:h5"], "uniapp")]
            commands.insert(3, (["php", str(ROOT / "scripts/generate-api-contracts.php"),
                                 "--application-root=" + str(app_root)], "."))
            builds = []
            for index, (argv, directory) in enumerate(commands):
                log = self.output / "groups" / f"{edition}-source-build-{index}.log"
                native_environment = {}
                if (argv[:2] == ["php", str(ROOT / "scripts/generate-api-contracts.php")]
                        or (directory in ("web", "platform") and argv[:3] in (["pnpm", "run", "build"], ["npm", "run", "build"]))):
                    native_environment = {"NODE_ENV": "production", "VITE_API_BASE_URL": ""}
                command(argv, cwd=app_root / directory, env={**self.environment(app), **native_environment}, log=log)
                builds.append({"argv": argv, "cwd": str(app_root / directory), "environment": native_environment,
                               "exit_code": 0, "log_sha256": sha256(log)})
            result[edition]["source_build"] = {"application": app_binding(app), "commands": builds,
                                                "api_generator_sha256": sha256(ROOT / "scripts/generate-api-contracts.php"),
                                                "generated_state": generated_state(app_root)}
        components["source_build"] = "passed"
        return {"status": "not_run" if creation_reason else "passed", "reason": creation_reason,
                "components": components, "template_artifacts": templates, "cli": cli, "editions": result}

    def fresh(self, edition: str) -> dict[str, Any]:
        app = self.apps[edition]
        facts: dict[str, Any] = {"application": app_binding(app), "components": {}}
        history = self.output / "groups" / (edition + "-installation-history.json")
        generated = self.checkpoint["groups"].get("generated-application", {}).get("receipt")
        final_build = read_json(file_reference(generated)) if generated else None
        # Missing historical evidence affects its own component. Persist every
        # available native fact before inspecting another independent component.
        for kind in ("first_install", "upgrade_retention", "recovery"):
            try:
                facts[kind] = native_evidence(app.get(kind, {}), app, kind, final_build)
                facts["components"][kind] = {"status": "passed", "scope": "historical-native-evidence"}
            except NotRun as exception:
                facts["components"][kind] = {"status": "not_run", "reason": str(exception)}
            self.write_json(history, facts)
        if ("first_install" in facts and "upgrade_retention" in facts
                and facts["first_install"]["completed_at"] > facts["upgrade_retention"]["completed_at"]):
            fail("installation, adoption and recovery chronology differs")
        process = command(["php", "server/database/install.php", "--status"], cwd=Path(app["root"]),
                          env=self.environment(app), capture=True)
        status = json.loads(process.stdout)
        if status.get("state") != "installed" or int(status.get("health", {}).get("installed_table_count", 0)) <= 0:
            fail("permanent APP installation is not currently healthy; no reinstallation attempted")
        facts["current_native_installation"] = status
        facts["components"]["current_health"] = {"status": "passed"}
        self.write_json(history, facts)
        cli = self.inputs["cli"]
        root = Path(self.inputs["template_build_root"]) / edition
        checked = json.loads(command(["node", str(Path(cli["root"]) / "bin/peanut.js"), "upgrade", "--check",
            "--path", app["root"], "--archive", str(root / f"peanut-scaffold-{edition}.tgz"),
            "--manifest", str(root / f"peanut-scaffold-{edition}.json")], capture=True).stdout)
        if checked.get("status") != "up_to_date":
            fail("permanent APP source adoption is not current")
        facts["native_cli_adoption"] = checked
        facts["components"]["source_adoption"] = {"status": "passed"}
        facts["components"]["candidate_first_install"] = {"status": "not_run",
            "reason": "historical installation, current health and upgrade do not prove this candidate first-install"}
        self.write_json(history, facts)
        return {"status": "not_run", "reason": "fresh candidate execution evidence unavailable; existing APP not reinstalled",
                **facts, "reinstalled": False, "database_dropped": False}

    def module_lifecycle(self) -> dict[str, Any]:
        config = module_qualification_inputs(self.inputs, self.args.candidate, self.plan["candidate_tree"])
        output = self.output / "groups" / "module-lifecycle"
        if output.exists():
            fail("retain the original Module qualification scene before another attempt")
        output.mkdir(mode=0o700)
        plan_path = self.output / "plan.json"
        plan_digest = sha256(plan_path)
        source = TOOL_ROOT / "server/fixtures/module-lifecycle/run.php"
        config_path = output / "input.json"
        self.write_json(config_path, config)
        config_path.chmod(0o600)
        results = {}
        # Current native source/dependency/migration/retirement and forward-failure
        # scripts run only in the explicitly registered empty synthetic APP.
        for producer, app_key, relative, receipt_name in (
                ("module-lifecycle", "lifecycle_application", "server/tests/Productization/ModuleLifecycleMySqlTest.php", "result.json"),
                ("module-failure-recovery", "failure_recovery_application", "server/tests/Productization/ModuleFailureRecoveryMySqlTest.php", "failure-recovery-result.json")):
            lifecycle_app = config[app_key]
            verify_module_context(argparse.Namespace(plan=str(plan_path), plan_sha256=plan_digest))
            log = output / (producer + ".log")
            command(["php", str(TOOL_ROOT / relative), "--application-root=" + lifecycle_app["root"],
                     "--expected-server-uuid=" + lifecycle_app["database_identity"]["server_uuid"]],
                    cwd=Path(lifecycle_app["root"]), env=self.environment(lifecycle_app), log=log)
            receipt = Path(lifecycle_app["root"]) / ".local/module-lifecycle-mysql" / receipt_name
            value = read_json(receipt)
            if (value.get("status") != "passed" or not isinstance(value.get("assertions"), int) or value["assertions"] < 1
                    or value.get("database_identity") != lifecycle_app["database_identity"]
                    or not re.fullmatch(r"[a-f0-9]{64}", str(value.get("non_case_catalog_sha256", "")))):
                fail("native Module lifecycle script did not produce its own assertion receipt")
            results[producer] = {"status": "passed", "source_sha256": sha256(TOOL_ROOT / relative),
                "receipt": {"path": str(receipt), "sha256": sha256(receipt)}, "log_sha256": sha256(log),
                "application_root": lifecycle_app["root"], "resource_id": lifecycle_app["resource_id"]}
            self.write_json(output / "results.json", results)
        installed_app = config["installed_application"]
        for producer in ("member-upload", "task-import-export"):
            verify_module_context(argparse.Namespace(plan=str(plan_path), plan_sha256=plan_digest))
            process = command(["php", str(source), "--action=" + producer,
                "--input=" + str(config_path), "--input-sha256=" + sha256(config_path),
                "--plan=" + str(plan_path), "--plan-sha256=" + plan_digest],
                cwd=Path(installed_app["root"]), env=self.environment(installed_app), capture=True, check=False)
            log = output / (producer + ".log")
            log.write_text((process.stdout or "") + (process.stderr or ""), encoding="utf-8")
            try:
                value = json.loads(process.stdout)
            except (ValueError, TypeError):
                fail("Module installed assertion returned an unknown outcome; preserve its isolated scene")
            if (process.returncode != 0 or value.get("status") != "passed"
                    or value.get("protocol") != "peanut.module-qualification-result.v1"
                    or value.get("producer") != producer or value.get("source") != self.inputs["source"]
                    or value.get("input_sha256") != sha256(config_path) or value.get("plan_sha256") != plan_digest
                    or value.get("application_root") != installed_app["root"]
                    or value.get("resource_id") != installed_app["resource_id"]
                    or value.get("database_identity") != installed_app["database_identity"]
                    or value.get("native_identity") != "verified-current-session"
                    or value.get("writes_retained") is not True):
                fail("Module installed assertion or native identity binding failed; preserve actual source/database/storage")
            results[producer] = {**value, "source_sha256": sha256(source), "log_sha256": sha256(log)}
            self.write_json(output / "results.json", results)
        verify_module_context(argparse.Namespace(plan=str(plan_path), plan_sha256=plan_digest))
        return {"status": "passed", "protocol": "peanut.module-qualification.v1",
            "scope": "registered-isolated-applications", "reviewed_module_source": config["reviewed_module_source"],
            "source": self.inputs["source"], "producers": results}


    def consumer_module_lifecycle(self) -> dict[str, Any]:
        output = self.cache / "consumer-module-lifecycle"
        binding = [] if TOOL_BINDING is None else ["--source-root", str(ROOT),
            "--qualification-tool-commit", TOOL_BINDING["tool_commit"],
            "--qualification-tool-files-sha256", TOOL_BINDING["tool_files_sha256"]]
        process = command([str(CONSUMER_MODULE_CHAIN), *binding, "--candidate", self.args.candidate,
            "--lease", self.args.lease, "--qualification-plan", str(self.output / "plan.json"),
            "--lifecycle-input", self.args.lifecycle_input, "--lifecycle-input-sha256", self.args.lifecycle_input_sha256,
            "--author-app", self.apps["standalone"]["root"], "--consumer-app", self.apps["multi-tenant"]["root"],
            "--output", str(output), "--identity-seed-file", self.inputs["consumer_identity_seed"]["path"], "--keep"],
            capture=True)
        value = json.loads(process.stdout)
        required = ("check_v1_v2", "canonical_pack_v1_v2", "install_update", "tenant_package_rbac_separation",
                    "disable_reactivate", "retire_purge", "app_owned_preservation")
        if (value.get("status") != "passed" or value.get("candidate") != self.args.candidate
                or value.get("candidate_tree") != self.plan["candidate_tree"]
                or value.get("template_artifacts") != self.plan["template_artifacts"]
                or value.get("lifecycle_input_sha256") != self.inputs["input_sha256"]
                or any(value.get("gates", {}).get(g) != "passed" for g in required)):
            fail("native fixed-APP Module chain did not close all original assertions")
        return value

    def compose(self, edition: str, *arguments: str, capture: bool = False) -> subprocess.CompletedProcess[str]:
        app = self.apps[edition]
        runtime = app["runtime"]
        env_path = file_reference(runtime["compose_environment"])
        root = canonical(runtime["root"], directory=True)
        return command(["docker", "compose", "--env-file", str(env_path), "-f", str(root / "server/docker/compose.yaml"),
            "--project-name", runtime["compose_project"], *arguments], cwd=root, capture=capture)

    def production_compose_at(self, edition: str) -> dict[str, Any]:
        app = self.apps[edition]
        registered = runtime_registration(app)
        runtime = app["runtime"]
        root = canonical(runtime["root"], directory=True)
        app_root = canonical(app["root"], directory=True)
        tree = command(["git", "-C", str(app_root), "rev-parse", app["head"] + "^{tree}"],
                       capture=True).stdout.strip()
        checkout_identity(root, app["head"], tree)
        file_reference({"path": str(root / ".peanut/application-manifest.json"), "sha256": app["manifest_sha256"]})
        server_identity = command(["php", "-r", r"""
            require $argv[1] . '/vendor/autoload.php';
            $identity = \app\common\value\installation\ApplicationSourceIdentity::loadGeneratedApp($argv[1]);
            if ($identity->applicationIdentity()['edition'] !== $argv[2]) { exit(1); }
            echo $identity->identitySha256();
        """, str(root / "server"), edition], cwd=root, capture=True).stdout.strip()
        if not re.fullmatch(r"[a-f0-9]{64}", server_identity):
            fail("native APP source identity is unavailable")
        resolved = json.loads(self.compose(edition, "config", "--format", "json", capture=True).stdout)
        encoded = json.dumps(resolved, sort_keys=True, separators=(",", ":")).encode()
        if hashlib.sha256(encoded).hexdigest() != registered["compose_config_sha256"]:
            fail("resolved Compose configuration differs from the registered configuration")
        services = resolved.get("services", {})
        mounts = [{"service": name, **mount} for name in ("php", "nginx")
                  for mount in services.get(name, {}).get("volumes", []) if mount.get("type") != "tmpfs"]
        if mounts != registered["persistent_mounts"]:
            fail("resolved Compose persistent mounts differ from registry")
        root_files = (".peanut/application-manifest.json", "release-versions.json",
                      "RELEASE_METADATA.json", "modules.lock")
        parent_binds = {("php", str(root / relative), f"{target}/{relative}")
                        for relative in root_files for target in ("/run/peanut-owner", "/var/www/peanut-http")}
        required_binds = [
            ("php", str(root / "server"), "/run/peanut-owner/server", False),
            ("php", str(root / "server"), "/var/www/peanut-http/server", True),
            ("nginx", str(root / "server/public"), "/var/www/peanut-admin/server/public", True),
            *((service, source, target, True) for service, source, target in sorted(parent_binds)),
        ]
        for service, source, destination, readonly in required_binds:
            selected = [m for m in services.get(service, {}).get("volumes", []) if m.get("target") == destination]
            if (len(selected) != 1 or selected[0].get("type") != "bind"
                    or selected[0].get("source") != str(source)
                    or selected[0].get("read_only", False) is not readonly):
                fail("Compose service is not running the verified server/package root")
        for service in ("php", "nginx"):
            for mount in services.get(service, {}).get("volumes", []):
                if mount.get("type") == "bind":
                    source = canonical(mount["source"], directory=Path(mount["source"]).is_dir())
                    if (source != root / "server" and root / "server" not in source.parents
                            and (service, str(source), mount.get("target")) not in parent_binds):
                        fail("Compose bind mount escapes the verified APP source")
        # Binding the hash alone is insufficient: bind the actual backend config
        # mounted into this server to the APP's independently registered DB env.
        if sha256(canonical(str(root / "server/.env"))) != app["environment"]["sha256"]:
            fail("runtime backend environment differs from the registered APP database environment")
        parsed = json.loads(command(["php", "-r", "$v=parse_ini_file($argv[1],false,INI_SCANNER_RAW);"
            "if(!is_array($v)){exit(1);}echo json_encode(array_intersect_key($v,array_flip("
            "['DB_HOST','DB_PORT','DB_NAME'])));",
            str(root / "server/.env")], cwd=root, capture=True).stdout)
        database = database_registration(app)
        endpoint = database["upstream_endpoint"]
        if parsed != {"DB_HOST": endpoint["host"], "DB_PORT": str(endpoint["port"]), "DB_NAME": app["database"]}:
            fail("resolved backend configuration points to another registered database/endpoint")
        ports = services.get("nginx", {}).get("ports", [])
        if (len(ports) != 1 or str(ports[0].get("published")) != str(runtime["port"])
                or str(ports[0].get("target")) != "80" or ports[0].get("host_ip") != "127.0.0.1"):
            fail("resolved Compose listener differs from the registered loopback port")
        for field in ("health_url", "tenant_admin_url", "tenant_beta_url", "platform_url", "docs_url"):
            url = urlsplit(runtime[field])
            if (url.scheme not in ("http", "https") or not url.port
                    or (field != "docs_url" and url.port != runtime["port"]) or url.username or url.password
                    or not url.hostname or not (url.hostname in ("localhost", "127.0.0.1") or url.hostname.endswith(".localhost"))):
                fail("runtime health/browser URL is not bound to its actual listener")
        verify_lease(self.args, self.plan)
        # Never let Compose start an unregistered database via depends_on.
        self.compose(edition, "up", "-d", "--no-deps", "php", "nginx")
        self.started_compose.append(edition)
        url = runtime["health_url"]
        self.wait_http(url)
        return {"application": app_binding(app), "runtime_shape": "git-application",
                "source_tree": tree, "application_source_identity_sha256": server_identity, "health_url": url}

    def production_compose(self) -> dict[str, Any]:
        return {"editions": {edition: self.production_compose_at(edition) for edition in EDITIONS}}

    def browser_at(self, edition: str) -> dict[str, Any]:
        app = self.apps[edition]
        runtime_registration(app, compose=False)
        runtime = app["runtime"]
        self.wait_http(runtime["health_url"])
        output = self.output / "browser" / edition
        output.mkdir(parents=True)
        credential = file_reference(app["browser_credentials"])
        command([str(BROWSER_RUNNER), "--mode", edition, "--profile", "baseline",
            "--lifecycle-input", self.args.lifecycle_input, "--lifecycle-input-sha256", self.args.lifecycle_input_sha256,
            "--qualification-plan", str(self.output / "plan.json"), "--tenant-admin-url", runtime["tenant_admin_url"],
            "--tenant-beta-url", runtime["tenant_beta_url"], "--platform-url", runtime["platform_url"],
            "--docs-url", runtime["docs_url"], "--documentation-root", app["root"], "--output-dir", str(output),
            "--session", f"p0e-{self.args.run_id}-{edition}", "--env-file", str(credential),
            "--playwright-cli", str(file_reference(runtime["browser_cli"]))], log=self.group_log(edition + "-browser"))
        summary = read_json(output / "business-summary.json")
        if summary.get("status") != "passed" or summary.get("candidate") != self.args.candidate or summary.get("candidate_tree") != self.plan["candidate_tree"]:
            fail("fixed APP browser business/permission/isolation assertions did not pass")
        return {"application": app_binding(app), "business_summary_sha256": sha256(output / "business-summary.json")}

    @staticmethod
    def wait_http(url: str, seconds: int = 120) -> None:
        deadline = time.monotonic() + seconds
        while time.monotonic() < deadline:
            try:
                with urllib.request.urlopen(url, timeout=5) as response:
                    if response.status == 200:
                        return
            except (OSError, TimeoutError):
                pass
            time.sleep(1)
        fail("fixed APP health did not become ready")

    def cleanup_success(self) -> None:
        # Only objects actually created by this invocation are removable. Permanent
        # APPs, runtime containers/volumes, all DBs, source/vendor and restore points remain.
        self.assert_inputs()
        # Consumer output contains recovery/evidence; preserve it rather than recursively
        # removing an incomplete native Module operation or author APP source.
        if (self.cache / "consumer-module-lifecycle").exists():
            shutil.move(str(self.cache / "consumer-module-lifecycle"), self.output / "consumer-module-lifecycle")
        if list(self.cache.iterdir()):
            fail("unknown temporary objects remain; no broad cleanup attempted")
        self.cache.rmdir()
        verify_lease(self.args, self.plan)
        command([str(LEASE_TOOL), "release", "--lease", self.args.lease, "--owner", self.args.owner])
        full = self.plan["groups"] == self.plan["full_gate_groups"]
        self.write_json(self.summary_path, {"schema_version": 1, "status": "passed" if full else "partial-passed",
            "scope": "full" if full else self.plan["selection_scope"], "candidate": self.args.candidate,
            "candidate_tree": self.plan["candidate_tree"], "run_id": self.args.run_id,
            "planned_groups": self.plan["groups"], "full_gate_groups": self.plan["full_gate_groups"],
            "groups": self.checkpoint["groups"], "lifecycle_inputs": self.inputs,
            "template_artifacts": self.plan["template_artifacts"],
            "cleanup": {"database_residual_count": 0, "container_residual_count": 0, "volume_residual_count": 0,
                "network_residual_count": 0, "image_residual_count": 0, "listener_residual_count": 0,
                "lease_released": True, "fixed_apps_preserved": True, "databases_preserved": True,
                "external_runtime_leases_retained": [a["lease"] for a in self.plan["runtime_admissions"] if a["lease"] != self.args.lease],
                "runtime_resources_preserved": True, "restore_points_preserved": True, "cache_removed": True},
            "cleanup_scope": "invocation-owned cache only; residual counts exclude registered permanent resources"})

    def run(self) -> None:
        operations = {"generated-application": self.generated_application, "standalone-fresh": lambda: self.fresh("standalone"),
            "multi-tenant-fresh": lambda: self.fresh("multi-tenant"), "module-lifecycle": self.module_lifecycle,
            "consumer-module-lifecycle": self.consumer_module_lifecycle, "production-compose": self.production_compose,
            "standalone-browser": lambda: self.browser_at("standalone"), "multi-tenant-browser": lambda: self.browser_at("multi-tenant")}
        for group in self.plan["groups"]:
            self.run_group(group, operations[group])
        if any(self.checkpoint["groups"].get(g, {}).get("status") != "passed" for g in self.plan["groups"]):
            self.current_group = "closeout"
            raise NotRun("eight-group closure is incomplete; completed components and native records preserved")
        self.cleanup_success()

    def preserve_failure(self, exception: Exception) -> None:
        if self.current_group != "closeout":
            state = self.checkpoint["groups"].setdefault(self.current_group, {})
            state.update(status="not_run" if isinstance(exception, NotRun) else "failed", error=str(exception)[:500], finished_at=int(time.time()))
        self.save_checkpoint()
        self.write_json(self.summary_path, {"schema_version": 1, "status": "failed-preserved",
            "candidate": self.args.candidate, "candidate_tree": self.plan["candidate_tree"], "groups": self.checkpoint["groups"],
            "template_artifacts": self.plan["template_artifacts"], "lifecycle_inputs": self.inputs,
            "not_run": [g for g in self.plan["groups"] if self.checkpoint["groups"].get(g, {}).get("status") in (None, "not_run")],
            "cleanup": {"lease_released": False, "fixed_apps_preserved": True, "databases_preserved": True}})

def qualify_candidate(args: argparse.Namespace) -> dict[str, Any]:
    """Check fixed templates and CLI creation only; never read permanent APPs or DBs."""
    _, tree = validate_candidate(args.candidate, require_clean=True)
    input_path = file_reference({"path": args.candidate_input, "sha256": args.candidate_input_sha256})
    value = read_json(input_path)
    if (value.get("protocol") != "peanut.p0e-candidate-inputs.v1"
            or not {"protocol", "source", "cli", "template_build_root"}.issubset(value)
            or set(value) - {"protocol", "source", "cli", "template_build_root", "cli_creation"}):
        fail("candidate input accepts only fixed Code, CLI and template identities")
    output = Path(args.output_dir)
    if (not output.is_absolute() or output.exists() or output.is_symlink()
            or not output.parent.is_dir() or output.parent.resolve() != output.parent):
        fail("candidate output must be an absent canonical directory")
    inputs = candidate_inputs(value, args.candidate, tree)
    roots = Path(inputs["template_build_root"])
    protected = (ROOT, roots, Path(inputs["cli"]["root"]))
    if (not output.is_absolute() or output.exists() or output.is_symlink()
            or not output.parent.is_dir() or output.parent.resolve() != output.parent
            or any(output == root or root in output.parents or output in root.parents for root in protected)):
        fail("candidate output must be a new canonical leaf outside source, CLI and template inputs")
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", args.run_id):
        fail("candidate run id is invalid")
    version = read_json(ROOT / "release-versions.json")["scaffold_template"]
    groups = read_json(FIXTURE_PATH).get("groups")
    if (not isinstance(groups, list) or len(groups) != 8 or len(set(groups)) != 8
            or "generated-application" not in groups or any(not isinstance(g, str) or not GROUP_RESULT.fullmatch(g) for g in groups)):
        fail("candidate stage requires the unchanged eight-group qualification contract")
    inventory = sha256(ROOT / "scaffold/application-template-inventory.json")
    verifier = ROOT / "scripts/release-template-artifacts.mjs"
    arguments = ["node", str(verifier), "check", str(roots), version, args.candidate, tree, inventory, str(ROOT)]
    output.mkdir(mode=0o700)
    receipt = {"schema_version": 1, "protocol": "peanut.p0e-candidate-stage.v1", "status": "running",
               "scope": "candidate", "candidate": args.candidate, "candidate_tree": tree, "run_id": args.run_id,
               "full_gate_groups": groups, "source_inventory_sha256": inventory,
               "candidate_input": {"path": str(input_path), "sha256": args.candidate_input_sha256},
               "cli": inputs["cli"], "qualification_tool_binding": TOOL_BINDING,
               "producer": {"path": "scripts/p0e-runtime-qualification", "sha256": sha256(Path(__file__)),
                            "verifier_sha256": sha256(verifier)},
               "template_build_root": str(roots), "started_at": int(time.time()),
               "runtime": {"permanent_app_created": False, "dependencies_installed": False, "database_used": False,
                           "service_started": False, "browser_used": False},
               "groups": {group: {"status": "not_run"} for group in groups},
               "publication_qualified": False}
    path = output / "candidate-stage.json"
    path.write_text(json.dumps(receipt, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    try:
        result = command(arguments, capture=True, check=False)
        log = output / "native-template-check.log"
        log.write_text((result.stdout or "") + (result.stderr or ""), encoding="utf-8")
        receipt["native_check"] = {"rc": result.returncode, "log": log.name, "log_sha256": sha256(log)}
        if result.returncode != 0:
            fail("native template check failed; preserve this stage output, do not replay it")
        try:
            checked = json.loads(result.stdout)
        except json.JSONDecodeError:
            fail("native template check did not return its artifact identity")
        if (not isinstance(checked, dict) or checked.get("protocol") != "peanut.template-release-inputs.v1"
                or checked.get("version") != version or checked.get("source") != {
                    "commit": args.candidate, "tree": tree, "inventory_sha256": inventory}
                or checked != inputs["template_artifacts"]):
            fail("native template check returned different candidate inputs")
        created = cli_created_applications(inputs, args.candidate, tree, output)
        file_reference({"path": str(input_path), "sha256": args.candidate_input_sha256})
        validate_candidate(args.candidate, require_clean=True)
        cli = inputs["cli"]
        checkout_identity(Path(cli["root"]), cli["commit"], cli["tree"])
        if (sha256(Path(cli["root"]) / "bin/peanut.js") != cli["entry_sha256"]
                or template_inputs(roots, args.candidate, tree) != inputs["template_artifacts"]):
            fail("candidate source, CLI or template identity changed during creation")
        receipt.update(status="candidate-passed", template_artifacts=checked, cli_created_applications=created)
        receipt["groups"]["generated-application"]["components"] = {
            "native_template_contract": "passed", "cli_create_and_app_identity": "passed", "source_build": "not_run"}
    except NotRun as exception:
        receipt["status"] = "candidate-not-run"
        receipt["reason"] = str(exception)
        receipt["template_artifacts"] = checked
        receipt["groups"]["generated-application"]["components"] = {
            "native_template_contract": "passed", "cli_create_and_app_identity": "not_run", "source_build": "not_run"}
    except Exception:
        receipt["status"] = "failed-preserved"
        raise
    finally:
        receipt["finished_at"] = int(time.time())
        path.write_text(json.dumps(receipt, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    return {"status": receipt["status"], "scope": "candidate", "receipt": str(path),
            "receipt_sha256": sha256(path), "publication_qualified": False}


def add_fixed_arguments(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--source-root")
    parser.add_argument("--qualification-tool-commit")
    parser.add_argument("--qualification-tool-files-sha256")
    parser.add_argument("--candidate", required=True)
    parser.add_argument("--lifecycle-input", required=True, help="Fixed Code/CLI/templates and both permanent APP native inputs; no credentials")
    parser.add_argument("--lifecycle-input-sha256", required=True)
    parser.add_argument("--run-id", required=True)
    parser.add_argument("--lease", required=True)
    parser.add_argument("--owner", required=True)
    parser.add_argument("--thread", required=True)
    parser.add_argument("--parent-lease")
    parser.add_argument("--output-dir", required=True)
    parser.add_argument("--cache-dir", required=True)
    parser.add_argument("--ttl", type=int, default=43200)
    parser.add_argument("--groups")
    parser.add_argument("--through-group")
    parser.add_argument("--minimum-release", action="store_true")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subs = parser.add_subparsers(dest="command", required=True)
    template = subs.add_parser("candidate", help="fixed two-Edition templates and independent CLI creation; no permanent APP/DB")
    for name in ("candidate", "run-id", "candidate-input", "candidate-input-sha256", "output-dir"):
        template.add_argument("--" + name, required=True)
    for name in ("source-root", "qualification-tool-commit", "qualification-tool-files-sha256"):
        template.add_argument("--" + name)
    transfer = subs.add_parser("transport", help="seal original full qualification bytes; no upload or publication")
    for name in ("summary", "main-integration", "output"):
        transfer.add_argument("--" + name, required=True)
    verify_module = subs.add_parser("verify-module-context", help="read-only current source/lease/isolated-APP admission")
    verify_module.add_argument("--plan", required=True)
    verify_module.add_argument("--plan-sha256", required=True)
    for name in ("plan", "claim", "run", "resume"):
        add_fixed_arguments(subs.add_parser(name))
    args = parser.parse_args()
    if args.command == "verify-module-context":
        print(json.dumps(verify_module_context(args), ensure_ascii=False))
        return 0
    if args.command == "candidate":
        configure_source(args)
        result = qualify_candidate(args)
        print(json.dumps(result, ensure_ascii=False))
        return 0 if result["status"] == "candidate-passed" else 1
    if args.command == "transport":
        print(json.dumps(transport(args), ensure_ascii=False))
        return 0
    configure_source(args)
    if (not re.fullmatch(r"[a-z0-9]{1,11}", args.run_id)
            or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", args.lease)):
        fail("run/lease identity is invalid")
    if not 60 <= args.ttl <= 86400:
        fail("invalid lease TTL")
    value = plan(args, require_clean=True)
    if args.command == "plan":
        print(json.dumps(value, ensure_ascii=False, indent=2))
        return 0
    if args.command == "claim":
        claim(args, value)
        verify_lease(args, value)
        print(json.dumps({"status": "claimed", "lease": args.lease, "candidate": args.candidate}))
        return 0
    verify_lease(args, value)
    runner = Runner(args, value)
    if args.command == "run":
        runner.initialize()
    else:
        runner.resume()
    try:
        runner.run()
    except Exception as exception:
        runner.preserve_failure(exception)
        raise
    print(json.dumps({"status": read_json(runner.summary_path)["status"], "summary": str(runner.summary_path)}))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (GateError, KeyError, ValueError, OSError) as exception:
        print(f"p0e-runtime-qualification: {exception}", file=sys.stderr)
        sys.exit(1)
