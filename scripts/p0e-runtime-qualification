#!/usr/bin/env python3
"""Run the lease-bound, fixed-candidate P0-E runtime qualification gate."""

from __future__ import annotations

import argparse
import contextlib
import hashlib
import json
import os
import re
import secrets
import shlex
import shutil
import signal
import socket
import subprocess
import sys
import tarfile
import time
import urllib.request
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parent.parent
FIXTURE_PATH = ROOT / "server/tests/fixtures/p0e-runtime-qualification/matrix.json"
REGISTRY_PATH = ROOT / "resources/project-resources.json"
P0E_REGISTRY_PATH = ROOT / "resources/p0e-runtime-qualification.json"
LEASE_TOOL = ROOT / "scripts/project-resource-lease"
REGISTRY_TOOL = ROOT / "scripts/project-resource-registry"
INSPECTOR = ROOT / "server/tests/fixtures/mt05/inspect.php"
BROWSER_RUNNER = ROOT / "scripts/p0e-browser-smoke"
BROWSER_TOOLING = ROOT / "scripts/p0e-browser-tooling"
CONSUMER_MODULE_CHAIN = ROOT / "scripts/consumer-module-reference-chain"
DEVELOPMENT_DATABASE_SYNC = ROOT / "scripts/project-development-database.sh"
LOCAL_BACKEND_ENV = ROOT / "server/.env"
PERSISTENT_DATABASE = "peanut_admin_development"
RESOURCE_ID = "peanut-admin-p0e-mysql84-gate"
ADMIN_TOOLING_ID = "peanut-admin-mysql84-remote-admin-cli"
BROWSER_TOOLING_ID = "peanut-admin-p0e-playwright-cli"
DATABASE_TUNNEL_ID = "peanut-admin-p0e-mysql84-container-tunnel"
GROUP_RESULT = re.compile(r"^[a-z0-9][a-z0-9.-]{0,63}$")
RUNTIME_VALUES: dict[str, str] = {}


class GateError(RuntimeError):
    pass


def fail(message: str) -> None:
    raise GateError(message)


def operating_system_environment() -> dict[str, str]:
    return {
        key: value
        for key in ("PATH", "HOME", "TMPDIR", "SSH_AUTH_SOCK", "SystemRoot", "COMSPEC", "PATHEXT")
        if (value := os.environ.get(key))
    }


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exception:
        fail(f"cannot read JSON {path}: {exception}")
    if not isinstance(value, dict):
        fail(f"JSON root must be an object: {path}")
    return value


def command(
    arguments: list[str],
    *,
    cwd: Path = ROOT,
    env: dict[str, str] | None = None,
    log: Path | None = None,
    capture: bool = False,
    check: bool = True,
) -> subprocess.CompletedProcess[str]:
    merged = operating_system_environment()
    if env:
        merged.update(env)
    if log is not None:
        log.parent.mkdir(parents=True, exist_ok=True)
        with log.open("a", encoding="utf-8") as stream:
            result = subprocess.run(
                arguments,
                cwd=cwd,
                env=merged,
                text=True,
                stdout=stream,
                stderr=subprocess.STDOUT,
                check=False,
            )
    else:
        result = subprocess.run(
            arguments,
            cwd=cwd,
            env=merged,
            text=True,
            capture_output=capture,
            check=False,
        )
    if check and result.returncode != 0:
        detail = ""
        if capture:
            detail = (result.stderr or result.stdout or "").strip()
        suffix = f": {detail}" if detail else ""
        fail(f"command failed ({result.returncode}): {arguments[0]}{suffix}")
    return result


def git(*arguments: str) -> str:
    return command(["git", "-C", str(ROOT), *arguments], capture=True).stdout.strip()


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def required_environment(name: str) -> str:
    value = RUNTIME_VALUES.get(name, "")
    if not value:
        fail(f"missing required environment: {name}")
    return value


def read_private_environment(path: Path, required: set[str]) -> dict[str, str]:
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError as exception:
        fail(f"cannot read private runtime environment: {exception}")
    values: dict[str, str] = {}
    for line in lines:
        name, separator, value = line.partition("=")
        if separator and name in required and value:
            values[name] = value
    missing = sorted(required - values.keys())
    if missing:
        fail(f"private runtime environment is missing: {', '.join(missing)}")
    return values


def prepare_database_credentials() -> None:
    command(
        [str(DEVELOPMENT_DATABASE_SYNC), "sync-credentials", "--backend-env", str(LOCAL_BACKEND_ENV)],
    )
    values = read_private_environment(LOCAL_BACKEND_ENV, {"DB_USER", "DB_PASS"})
    RUNTIME_VALUES["P0E_DB_USER"] = values["DB_USER"]
    RUNTIME_VALUES["P0E_DB_PASSWORD"] = values["DB_PASS"]


def registered_browser_cli_path(p0e_registry: dict[str, Any] | None = None) -> Path:
    p0e_registry = p0e_registry or read_json(P0E_REGISTRY_PATH)
    tooling = p0e_registry.get("resources", {}).get("tooling", [])
    matches = [item for item in tooling if item.get("stable_resource_id") == BROWSER_TOOLING_ID]
    if len(matches) != 1:
        fail(f"registry must contain exactly one {BROWSER_TOOLING_ID}")
    relative_path = matches[0].get("relative_path")
    if not isinstance(relative_path, str) or not relative_path.startswith(".local/"):
        fail("registered P0-E Playwright CLI path must stay inside the candidate .local directory")
    path = ROOT / relative_path
    if path.parent == ROOT or path.name != "playwright-cli":
        fail("registered P0-E Playwright CLI path is invalid")
    return path


def preflight_browser_tooling() -> None:
    cli = registered_browser_cli_path()
    if not cli.is_file() or not os.access(cli, os.X_OK):
        fail(
            "P0-E Playwright CLI is unavailable before resource claim; "
            f"run {BROWSER_TOOLING} install"
        )
    result = command([str(cli), "--version"], capture=True, check=False)
    output = (result.stdout + result.stderr).strip()
    if result.returncode != 0:
        fail(f"P0-E Playwright CLI failed its preflight: {output[-300:]}")
    registry = read_json(P0E_REGISTRY_PATH)
    browser_tools = [
        item for item in registry.get("resources", {}).get("tooling", [])
        if item.get("stable_resource_id") == BROWSER_TOOLING_ID
    ]
    expected_package = browser_tools[0].get("package") if len(browser_tools) == 1 else None
    expected_version = browser_tools[0].get("version") if len(browser_tools) == 1 else None
    if not isinstance(expected_package, str) or not isinstance(expected_version, str):
        fail("registered P0-E Playwright CLI package identity is invalid")
    try:
        wrapper_source = cli.read_text(encoding="utf-8")
    except OSError as exception:
        fail(f"P0-E Playwright CLI wrapper cannot be read: {exception}")
    if f"--package {expected_package}@{expected_version}" not in wrapper_source or expected_version not in output:
        fail(
            "P0-E Playwright CLI version mismatch: "
            f"expected {expected_package}@{expected_version}, got {output[-300:]}"
        )


def validate_fixture() -> tuple[
    dict[str, Any],
    dict[str, Any],
    dict[str, Any],
    dict[str, Any],
    dict[str, Any],
    dict[str, Any],
]:
    fixture = read_json(FIXTURE_PATH)
    registry = read_json(REGISTRY_PATH)
    p0e_registry = read_json(P0E_REGISTRY_PATH)
    if fixture.get("schema_version") != 1 or fixture.get("gate") != "p0e-runtime-qualification":
        fail("unsupported P0-E fixture")
    db_fixture = fixture.get("database_resource")
    if not isinstance(db_fixture, dict):
        fail("fixture database_resource is invalid")
    databases = registry.get("resources", {}).get("databases", [])
    matches = [item for item in databases if item.get("stable_resource_id") == RESOURCE_ID]
    if len(matches) != 1:
        fail(f"registry must contain exactly one {RESOURCE_ID}")
    registered = matches[0]
    if (
        p0e_registry.get("schema_version") != 1
        or p0e_registry.get("project_id") != "peanut-admin"
        or p0e_registry.get("gate") != "p0e-runtime-qualification"
    ):
        fail("unsupported P0-E resource registry")
    binding = p0e_registry.get("database_administration_binding")
    if not isinstance(binding, dict):
        fail("P0-E database administration binding is invalid")
    expected_binding = {
        "database_resource_id": RESOURCE_ID,
        "runtime_resource_id": registered.get("runtime_resource_id"),
        "administrative_tooling_resource_id": ADMIN_TOOLING_ID,
        "host": "mac-14",
        "port": registered.get("upstream_endpoint", {}).get("port"),
        "database": registered.get("database"),
        "namespace": registered.get("namespace"),
        "version": registered.get("version"),
        "fallback": "none",
    }
    for key, value in expected_binding.items():
        if binding.get(key) != value:
            fail(f"P0-E database administration binding disagrees on {key}")
    tooling = p0e_registry.get("resources", {}).get("tooling", [])
    tool_matches = [item for item in tooling if item.get("stable_resource_id") == ADMIN_TOOLING_ID]
    if len(tool_matches) != 1:
        fail(f"registry must contain exactly one {ADMIN_TOOLING_ID}")
    admin_tool = tool_matches[0]
    expected_tool = {
        "version": registered.get("version"),
        "host": "mac-14",
        "transport": "ssh-docker-exec",
        "ssh_alias": "mac-14",
        "ssh_command": "/usr/bin/ssh",
        "docker_command": "/usr/local/bin/docker",
        "container_name": "peanut-admin-mysql84-development",
        "container_image": "mysql:8.4.10@sha256:8dbcf531a03aade657e181b9cf2f1d1803ce621a1d55610cb44cb531ab7d7db6",
        "mysql_command": "/usr/bin/mysql",
    }
    for key, value in expected_tool.items():
        if admin_tool.get(key) != value:
            fail(f"registered P0-E administrative tooling disagrees on {key}")
    if admin_tool.get("fallback") != "none; host mysql commands are forbidden":
        fail("P0-E administrative tooling must forbid a host MySQL fallback")
    browser_matches = [item for item in tooling if item.get("stable_resource_id") == BROWSER_TOOLING_ID]
    if len(browser_matches) != 1:
        fail(f"registry must contain exactly one {BROWSER_TOOLING_ID}")
    browser_tool = browser_matches[0]
    expected_browser_tool = {
        "package": "@playwright/cli",
        "version": "0.1.18",
        "relative_path": ".local/p0e-browser-cli-0.1.18/playwright-cli",
        "fallback": "none",
    }
    for key, value in expected_browser_tool.items():
        if browser_tool.get(key) != value:
            fail(f"registered P0-E Playwright tooling disagrees on {key}")
    tunnel_matches = [
        item for item in tooling
        if item.get("stable_resource_id") == DATABASE_TUNNEL_ID
    ]
    if len(tunnel_matches) != 1:
        fail(f"registry must contain exactly one {DATABASE_TUNNEL_ID}")
    tunnel = tunnel_matches[0]
    upstream = registered.get("upstream_endpoint", {})
    container = registered.get("container_endpoint", {})
    expected_tunnel = {
        "transport": "ssh-local-forward",
        "ssh_alias": admin_tool.get("ssh_alias"),
        "ssh_command": admin_tool.get("ssh_command"),
        "local_host": "127.0.0.1",
        "local_port": 20189,
        "container_host": container.get("host"),
        "container_port": container.get("port"),
        "upstream_host": upstream.get("host"),
        "upstream_port": upstream.get("port"),
        "fallback": "none",
    }
    for key, value in expected_tunnel.items():
        if tunnel.get(key) != value:
            fail(f"registered P0-E database tunnel disagrees on {key}")
    if (
        container.get("endpoint_id") != "peanut-admin-p0e-mysql84-gate-docker-via-host-tunnel"
        or container.get("host") != "host.docker.internal"
        or container.get("port") != tunnel.get("local_port")
    ):
        fail("P0-E container database endpoint is not bound to the registered tunnel")
    browser_hosts = p0e_registry.get("browser_host_binding")
    expected_browser_hosts = {
        "stable_resource_id": "peanut-admin-p0e-browser-hosts",
        "platform_host": "platform.p0e.localhost",
        "tenant_admin_host": "admin.p0e.localhost",
        "port": 20190,
        "fallback": "none",
    }
    if not isinstance(browser_hosts, dict) or any(
        browser_hosts.get(key) != value for key, value in expected_browser_hosts.items()
    ):
        fail("P0-E browser Host binding is invalid")
    expected = {
        "stable_resource_id": registered.get("stable_resource_id"),
        "environment": (registered.get("environments") or [None])[0],
        "host": registered.get("upstream_endpoint", {}).get("host"),
        "port": registered.get("upstream_endpoint", {}).get("port"),
        "database_template": registered.get("database"),
    }
    for key, value in expected.items():
        if db_fixture.get(key) != value:
            fail(f"fixture and resource registry disagree on {key}")
    if registered.get("application_runtime") is not False or registered.get("fallback") != "none":
        fail("P0-E registry must remain non-default and fail closed")
    scenarios = fixture.get("scenarios")
    if not isinstance(scenarios, dict) or set(scenarios) != set(registered.get("allowed_scenarios", [])):
        fail("fixture scenarios must exactly match the registered scenario set")
    groups = fixture.get("groups")
    if not isinstance(groups, list) or len(groups) != len(set(groups)) or any(
        not isinstance(item, str) or not GROUP_RESULT.fullmatch(item) for item in groups
    ):
        fail("fixture groups are invalid")
    target = fixture.get("target_release")
    if not isinstance(target, dict):
        fail("target scaffold release fixture is missing")
    target_manifest_path = ROOT / "scaffold/releases" / f"v{target.get('version')}" / "scaffold-manifest.json"
    target_manifest = read_json(target_manifest_path)
    target_release = target_manifest.get("release", {})
    target_source_inventory = command(
        [
            "git", "-C", str(ROOT), "show",
            f"{target.get('source_commit')}:scaffold/application-template-inventory.json",
        ],
        capture=True,
    ).stdout
    target_expected = {
        "source_commit": target.get("source_commit"),
        "source_tree": target.get("source_tree"),
        "inventory_sha256": target.get("inventory_sha256"),
        "managed_tree_sha256": target.get("managed_tree_sha256"),
    }
    if (
        target_manifest.get("schema_version") != 3
        or target_release.get("version") != target.get("version")
        or any(target_release.get(key) != value for key, value in target_expected.items())
        or len(target_manifest.get("files", [])) != target.get("file_count")
        or sha256(target_manifest_path) != target.get("manifest_sha256")
        or hashlib.sha256(target_source_inventory.encode("utf-8")).hexdigest() != target.get("inventory_sha256")
        or target_manifest.get("application", {}).get("version") != target.get("default_application_version")
        or target.get("application_manifest_schema") != 2
        or target.get("default_uniapp_version_code") != "10"
    ):
        fail("target scaffold release identity changed")
    return fixture, registry, registered, admin_tool, browser_hosts, tunnel


def validate_candidate(candidate: str, require_clean: bool, allowed_output: Path | None = None) -> tuple[str, str]:
    if not re.fullmatch(r"[0-9a-f]{40}", candidate):
        fail("candidate must be an exact lowercase 40-hex commit")
    resolved = git("rev-parse", f"{candidate}^{{commit}}")
    head = git("rev-parse", "HEAD")
    if resolved != candidate or head != candidate:
        fail(f"worktree HEAD {head} is not fixed candidate {candidate}")
    tree = git("rev-parse", f"{candidate}^{{tree}}")
    if require_clean:
        status_arguments = ["status", "--porcelain=v1", "--untracked-files=all"]
        if allowed_output is not None:
            try:
                relative_output = allowed_output.relative_to(ROOT)
            except ValueError:
                fail("allowed runtime output must be within the candidate worktree")
            status_arguments.extend(["--", ".", f":(exclude){relative_output.as_posix()}/**"])
        if git(*status_arguments):
            fail("fixed candidate worktree is not clean")
    return head, tree


def absolute_path(value: str, label: str, run_id: str) -> Path:
    path = Path(value)
    if not path.is_absolute():
        fail(f"{label} must be absolute")
    normalized = Path(os.path.realpath(path.parent)) / path.name
    if run_id not in normalized.name:
        fail(f"{label} basename must contain exact run_id")
    if normalized in (Path("/"), Path.home(), ROOT):
        fail(f"unsafe {label}")
    return normalized


def database_names(fixture: dict[str, Any], run_id: str) -> dict[str, str]:
    if not re.fullmatch(r"[a-z0-9]{1,11}", run_id):
        fail("run_id must match ^[a-z0-9]{1,11}$")
    template = fixture["database_resource"]["database_template"]
    names = {
        scenario: template.replace("<run_id>", run_id).replace("<scenario>", scenario)
        for scenario in fixture["scenarios"]
    }
    for name in names.values():
        if name == PERSISTENT_DATABASE or not re.fullmatch(r"[a-z0-9_]{1,64}", name):
            fail(f"unsafe generated database name: {name}")
    return names


def plan(args: argparse.Namespace, require_clean: bool) -> dict[str, Any]:
    preflight_browser_tooling()
    fixture, registry, registered, admin_tool, browser_hosts, database_tunnel = validate_fixture()
    names = database_names(fixture, args.run_id)
    paths = {
        "output-dir": str(absolute_path(args.output_dir, "output-dir", args.run_id)),
        "cache-dir": str(absolute_path(args.cache_dir, "cache-dir", args.run_id)),
    }
    expected_paths = {
        "output-dir": str(ROOT / "output" / f"p0e-{args.run_id}"),
        "cache-dir": str(Path.home() / ".cache/peanut-admin" / f"p0e-{args.run_id}"),
    }
    if paths != expected_paths:
        fail(f"output/cache paths must equal the fixed lease proof contract: {expected_paths}")
    _, tree = validate_candidate(
        args.candidate,
        require_clean=require_clean,
        allowed_output=Path(paths["output-dir"]),
    )
    ports = [args.http_port, args.docs_port]
    if len(set(ports)) != 2 or any(port < 1024 or port > 65535 for port in ports):
        fail("http/docs ports must be distinct explicit non-privileged ports")
    registered_ports = {
        item.get("port_env"): item.get("port")
        for item in registry.get("resources", {}).get("local_listeners", [])
    }
    if args.http_port != registered_ports.get("HTTP_PORT") or args.docs_port != registered_ports.get("DOCS_PORT"):
        fail("http/docs ports must equal the registered local-production/docs listener ports")
    compose_project = f"peanut-p0e-{args.run_id}"
    common_dir_raw = git("rev-parse", "--git-common-dir")
    common_dir = Path(common_dir_raw)
    if not common_dir.is_absolute():
        common_dir = ROOT / common_dir
    common_dir = Path(os.path.realpath(common_dir))
    lease_proof_dir = common_dir / "peanut-admin-resource-leases/leases" / args.lease
    resources: list[tuple[str, str]] = [
        ("resource-id", RESOURCE_ID),
        ("environment", "development"),
        ("deployment-target", "local-production-preview"),
        ("consumer", "host"),
        ("consumer", "container"),
        (
            "endpoint",
            f"{registered['upstream_endpoint']['host']}:"
            f"{registered['upstream_endpoint']['port']}",
        ),
        (
            "endpoint",
            f"{registered['container_endpoint']['host']}:"
            f"{registered['container_endpoint']['port']}",
        ),
        ("run-id", args.run_id),
        ("candidate-tree", tree),
        *(("mysql-db", value) for value in names.values()),
        ("deployment-mode", "standalone"),
        ("deployment-mode", "multi-tenant"),
        (("port", str(args.http_port))),
        (("port", str(args.docs_port))),
        (("port", str(database_tunnel["local_port"]))),
        ("http-port", str(args.http_port)),
        ("docs-port", str(args.docs_port)),
        ("database-tunnel", DATABASE_TUNNEL_ID),
        ("cache-dir", paths["cache-dir"]),
        ("output-dir", paths["output-dir"]),
        ("compose-project", compose_project),
        ("browser-session", f"p0e-{args.run_id}"),
        ("browser-host", browser_hosts["tenant_admin_host"]),
        ("browser-host", browser_hosts["platform_host"]),
        ("lease-proof-dir", str(lease_proof_dir)),
    ]
    return {
        "schema_version": 1,
        "gate": fixture["gate"],
        "candidate": args.candidate,
        "candidate_tree": tree,
        "worktree": str(ROOT),
        "run_id": args.run_id,
        "resource_id": RESOURCE_ID,
        "database_admin_tooling": {
            key: admin_tool[key]
            for key in (
                "stable_resource_id", "version", "host", "transport", "ssh_alias",
                "ssh_command", "docker_command", "container_name", "container_image",
                "mysql_command", "fallback",
            )
        },
        "database_tunnel": {
            key: database_tunnel[key]
            for key in (
                "stable_resource_id", "transport", "ssh_alias", "ssh_command",
                "local_host", "local_port", "container_host", "container_port",
                "upstream_host", "upstream_port", "fallback",
            )
        },
        "environment": "development",
        "endpoint": (
            f"{registered['container_endpoint']['host']}:"
            f"{registered['container_endpoint']['port']}"
        ),
        "host_endpoint": f"{fixture['database_resource']['host']}:{fixture['database_resource']['port']}",
        "databases": names,
        "ports": {"http": args.http_port, "docs": args.docs_port},
        "browser_hosts": {
            "tenant_admin": browser_hosts["tenant_admin_host"],
            "platform": browser_hosts["platform_host"],
        },
        "paths": paths,
        "compose_project": compose_project,
        "lease_proof_dir": str(lease_proof_dir),
        "lease_proof_container_path": "/run/peanut-admin/resource-lease",
        "groups": fixture["groups"],
        "target_release": fixture["target_release"],
        "lease_resources": [{"type": kind, "value": value} for kind, value in resources],
    }


def parse_lease(raw: str) -> tuple[dict[str, str], set[tuple[str, str]]]:
    metadata: dict[str, str] = {}
    resources: set[tuple[str, str]] = set()
    in_resources = False
    for line in raw.splitlines():
        if line == "resources":
            in_resources = True
            continue
        fields = line.split("\t", 1)
        if len(fields) != 2:
            fail("lease output is malformed")
        if in_resources:
            resources.add((fields[0], fields[1]))
        else:
            metadata[fields[0]] = fields[1]
    return metadata, resources


def expected_resources(plan_data: dict[str, Any]) -> set[tuple[str, str]]:
    return {(item["type"], item["value"]) for item in plan_data["lease_resources"]} | {
        ("gate", plan_data["gate"]),
        ("worktree", plan_data["worktree"]),
    }


def claim(args: argparse.Namespace, plan_data: dict[str, Any]) -> None:
    for path in plan_data["paths"].values():
        if Path(path).exists():
            fail(f"claim path already exists: {path}")
    invocation = [
        str(LEASE_TOOL), "claim", "--lease", args.lease, "--owner", args.owner,
        "--thread", args.thread, "--candidate", args.candidate, "--gate", plan_data["gate"],
        "--ttl", str(args.ttl),
    ]
    for item in plan_data["lease_resources"]:
        invocation.extend(["--resource", f"{item['type']}={item['value']}"])
    command(invocation)


def verify_lease(args: argparse.Namespace, plan_data: dict[str, Any]) -> None:
    raw = command([str(LEASE_TOOL), "show", "--lease", args.lease], capture=True).stdout
    metadata, resources = parse_lease(raw)
    now = int(time.time())
    expected_metadata = {
        "lease": args.lease,
        "owner": args.owner,
        "thread": args.thread,
        "candidate": args.candidate,
        "candidate_repository": plan_data["worktree"],
        "gate": plan_data["gate"],
        "worktree": plan_data["worktree"],
        "status": "ACTIVE",
    }
    for key, value in expected_metadata.items():
        if metadata.get(key) != value:
            fail(f"lease {key} mismatch")
    if not metadata.get("expires_at", "").isdigit() or int(metadata["expires_at"]) <= now:
        fail("lease is expired")
    if resources != expected_resources(plan_data):
        missing = sorted(expected_resources(plan_data) - resources)
        extra = sorted(resources - expected_resources(plan_data))
        fail(f"lease resource set mismatch; missing={missing}, extra={extra}")


class Runner:
    def __init__(self, args: argparse.Namespace, plan_data: dict[str, Any], fixture: dict[str, Any]) -> None:
        self.args = args
        self.plan = plan_data
        self.fixture = fixture
        self.output = Path(plan_data["paths"]["output-dir"])
        self.cache = Path(plan_data["paths"]["cache-dir"])
        self.checkpoint_path = self.output / "checkpoint.json"
        self.summary_path = self.output / "summary.json"
        version = fixture["target_release"]["version"]
        self.generated = {
            edition: self.cache / f"peanut-admin-{version}-{edition}"
            for edition in ("standalone", "multi-tenant")
        }
        self.edition_artifacts = self.cache / "edition-artifacts"
        self.compose_env = self.cache / "compose.env"
        self.compose_backend_env: Path | None = None
        self.compose_overlay = self.cache / "compose.lease-proof.yml"
        self.runtime_credentials = self.cache / "runtime-credentials.env"
        self.database_tunnel_process: subprocess.Popen[str] | None = None
        self.docs_process: subprocess.Popen[str] | None = None
        self.docs_root: Path | None = None
        self.active_compose_root = ROOT
        self.created_candidate_vendor = not (ROOT / "server/vendor/autoload.php").exists()
        self.current_group = "preflight"
        self.checkpoint: dict[str, Any] = {
            "schema_version": 1,
            "candidate": args.candidate,
            "candidate_tree": plan_data["candidate_tree"],
            "run_id": args.run_id,
            "lease": args.lease,
            "owned_candidate_vendor": self.created_candidate_vendor,
            "groups": {},
        }

    def prepare_runtime_credentials(self, resume: bool = False) -> None:
        names = {
            "P0E_ADMIN_INITIAL_EMAIL",
            "P0E_ADMIN_INITIAL_PASSWORD",
            "P0E_PLATFORM_INITIAL_EMAIL",
            "P0E_PLATFORM_INITIAL_PASSWORD",
            "P0E_JWT_SECRET",
            "P0E_TENANT_IDENTIFIER_HMAC_KEY",
            "P0E_PLATFORM_IDENTIFIER_HMAC_KEY",
        }
        if resume:
            values = read_private_environment(self.runtime_credentials, names)
        else:
            if self.runtime_credentials.exists():
                fail("P0-E runtime credentials already exist before initialization")
            suffix = secrets.token_hex(6)
            values = {
                "P0E_ADMIN_INITIAL_EMAIL": f"owner-{suffix}@p0e.invalid",
                "P0E_ADMIN_INITIAL_PASSWORD": "P0eOwner" + secrets.token_urlsafe(18) + "9",
                "P0E_PLATFORM_INITIAL_EMAIL": f"platform-{suffix}@p0e.invalid",
                "P0E_PLATFORM_INITIAL_PASSWORD": "P0ePlatform" + secrets.token_urlsafe(18) + "9",
                "P0E_JWT_SECRET": secrets.token_hex(32),
                "P0E_TENANT_IDENTIFIER_HMAC_KEY": secrets.token_hex(32),
                "P0E_PLATFORM_IDENTIFIER_HMAC_KEY": secrets.token_hex(32),
            }
            self.runtime_credentials.write_text(
                "".join(f"{name}={values[name]}\n" for name in sorted(values)),
                encoding="utf-8",
            )
            self.runtime_credentials.chmod(0o600)
        RUNTIME_VALUES.update(values)

    def playwright_cli(self) -> str:
        registered = registered_browser_cli_path()
        if not registered.is_file() or not os.access(registered, os.X_OK):
            fail(f"P0-E Playwright CLI is unavailable; run {BROWSER_TOOLING} install")
        return str(registered)

    def remote_docker(
        self,
        arguments: list[str],
        *,
        input_bytes: bytes | None = None,
        stdin: Any = None,
        stdout: Any = subprocess.PIPE,
        check: bool = True,
    ) -> subprocess.CompletedProcess[bytes]:
        tool = self.plan["database_admin_tooling"]
        remote_command = shlex.join([tool["docker_command"], *arguments])
        result = subprocess.run(
            [
                tool["ssh_command"], "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
                tool["ssh_alias"], remote_command,
            ],
            input=input_bytes,
            stdin=stdin,
            stdout=stdout,
            stderr=subprocess.PIPE,
            env=operating_system_environment(),
            check=False,
        )
        if check and result.returncode != 0:
            detail = result.stderr.decode("utf-8", errors="replace").strip()
            fail(f"registered remote database administration failed ({result.returncode}): {detail}")
        return result

    def preflight_database_admin_tooling(self) -> None:
        tool = self.plan["database_admin_tooling"]
        ssh_command = Path(tool["ssh_command"])
        if not ssh_command.is_file() or not os.access(ssh_command, os.X_OK):
            fail("registered SSH client is unavailable")
        inspect = self.remote_docker([
            "inspect", tool["container_name"], "--format",
            "{{.Config.Image}}|{{.State.Status}}|{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}",
        ]).stdout.decode("utf-8", errors="replace").strip()
        if inspect != f"{tool['container_image']}|running|healthy":
            fail("registered MySQL allocation identity or health is not current")
        probe_script = (
            'test -x "$1" && "$1" --version && printf "user=%s\\n" "$MYSQL_USER"'
        )
        probe = self.remote_docker([
            "exec", tool["container_name"], "/bin/sh", "-ceu", probe_script,
            "p0e-admin-tooling", tool["mysql_command"],
        ]).stdout.decode("utf-8", errors="replace")
        if tool["version"] not in probe:
            fail("registered remote MySQL client version is unavailable")
        expected_user = required_environment("P0E_DB_USER")
        if f"user={expected_user}\n" not in probe:
            fail("P0-E application database identity does not match the registered allocation")

    def start_database_tunnel(self) -> None:
        if self.database_tunnel_process is not None and self.database_tunnel_process.poll() is None:
            return
        tunnel = self.plan["database_tunnel"]
        if tunnel["transport"] != "ssh-local-forward" or tunnel["fallback"] != "none":
            fail("registered P0-E database tunnel transport changed")
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
            probe.settimeout(0.5)
            if probe.connect_ex((tunnel["local_host"], int(tunnel["local_port"]))) == 0:
                fail("lease-bound database tunnel port is already active")
        forward = (
            f"{tunnel['local_host']}:{tunnel['local_port']}:"
            f"{tunnel['upstream_host']}:{tunnel['upstream_port']}"
        )
        self.database_tunnel_process = subprocess.Popen(
            [
                tunnel["ssh_command"], "-o", "BatchMode=yes",
                "-o", "ExitOnForwardFailure=yes",
                "-o", "ServerAliveInterval=15",
                "-o", "ServerAliveCountMax=3",
                "-N", "-L", forward, tunnel["ssh_alias"],
            ],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
            text=True,
            env=operating_system_environment(),
        )
        deadline = time.time() + 10
        while time.time() < deadline:
            if self.database_tunnel_process.poll() is not None:
                detail = (self.database_tunnel_process.stderr.read() or "").strip()
                fail(f"registered P0-E database tunnel failed to start: {detail[-300:]}")
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
                probe.settimeout(0.5)
                if probe.connect_ex((tunnel["local_host"], int(tunnel["local_port"]))) == 0:
                    return
            time.sleep(0.2)
        self.stop_database_tunnel()
        fail("registered P0-E database tunnel did not become reachable")

    def stop_database_tunnel(self) -> None:
        process = self.database_tunnel_process
        if process is None:
            return
        if process.poll() is None:
            process.terminate()
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait(timeout=5)
        self.database_tunnel_process = None

    def remote_mysql(self, sql: str, *, database: str | None = None) -> str:
        tool = self.plan["database_admin_tooling"]
        client_script = (
            'export MYSQL_PWD="$MYSQL_ROOT_PASSWORD"; unset MYSQL_ROOT_PASSWORD; '
            'if [ "$#" -eq 2 ]; then '
            'exec "$1" --protocol=SOCKET --user=root --batch --raw --skip-column-names "$2"; '
            'fi; exec "$1" --protocol=SOCKET --user=root --batch --raw --skip-column-names'
        )
        arguments = [
            "exec", "-i", tool["container_name"], "/bin/sh", "-ceu", client_script,
            "p0e-mysql", tool["mysql_command"],
        ]
        if database is not None:
            arguments.append(database)
        result = self.remote_docker(arguments, input_bytes=(sql + "\n").encode("utf-8"))
        return result.stdout.decode("utf-8", errors="strict")

    def initialize(self) -> None:
        for port in [*self.plan["ports"].values(), self.plan["database_tunnel"]["local_port"]]:
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
                probe.settimeout(0.5)
                if probe.connect_ex(("127.0.0.1", int(port))) == 0:
                    fail(f"lease-bound listener port is already active: {port}")
        for path in (self.output, self.cache):
            path.mkdir(parents=True, exist_ok=False)
            path.chmod(0o700)
        self.prepare_runtime_credentials()
        (self.output / "groups").mkdir()
        self.write_json(self.output / "plan.json", self.plan)
        self.save_checkpoint()

    def resume(self) -> None:
        for path in (self.output, self.cache):
            if not path.is_dir():
                fail(f"resume path is unavailable: {path}")
        checkpoint = read_json(self.checkpoint_path)
        for key, expected in {
            "candidate": self.args.candidate,
            "candidate_tree": self.plan["candidate_tree"],
            "run_id": self.args.run_id,
            "lease": self.args.lease,
        }.items():
            if checkpoint.get(key) != expected:
                fail(f"checkpoint {key} mismatch")
        self.checkpoint = checkpoint
        self.created_candidate_vendor = bool(checkpoint.get("owned_candidate_vendor"))
        self.prepare_runtime_credentials(resume=True)

    @staticmethod
    def write_json(path: Path, value: Any) -> None:
        temporary = path.with_name(path.name + ".tmp")
        temporary.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        temporary.replace(path)

    def save_checkpoint(self) -> None:
        self.write_json(self.checkpoint_path, self.checkpoint)

    def group_log(self, group: str) -> Path:
        return self.output / "groups" / f"{group}.log"

    def run_group(self, group: str, operation: Any) -> None:
        state = self.checkpoint["groups"].get(group, {})
        if state.get("status") == "passed":
            return
        verify_lease(self.args, self.plan)
        command([
            str(LEASE_TOOL), "renew", "--lease", self.args.lease, "--owner", self.args.owner,
            "--ttl", str(self.args.ttl),
        ])
        if state.get("status") in ("failed", "running"):
            self.prepare_retry(group)
        self.current_group = group
        self.checkpoint["groups"][group] = {"status": "running", "started_at": int(time.time())}
        self.save_checkpoint()
        operation()
        self.checkpoint["groups"][group] = {"status": "passed", "finished_at": int(time.time())}
        self.save_checkpoint()

    def prepare_retry(self, group: str) -> None:
        scenarios = {
            "standalone-fresh": ["standalone_fresh"],
            "multi-tenant-fresh": ["multi_tenant_fresh"],
            "plugin-lifecycle": ["plugin_lifecycle"],
            "consumer-module-lifecycle": ["consumer_module_cycle"],
            "production-compose": ["standalone_browser"],
            "multi-tenant-browser": ["multi_tenant_browser"],
        }
        if group == "generated-application":
            for generated in self.generated.values():
                if generated.exists():
                    shutil.rmtree(generated)
            if self.edition_artifacts.exists():
                shutil.rmtree(self.edition_artifacts)
            if self.created_candidate_vendor and (ROOT / "server/vendor").exists():
                shutil.rmtree(ROOT / "server/vendor")
        if group == "consumer-module-lifecycle":
            consumer_output = self.cache / "consumer-module-lifecycle"
            if consumer_output.exists():
                shutil.rmtree(consumer_output)
        if group == "production-compose" and self.compose_env.exists() and self.compose_overlay.exists():
            self.compose("down", "--volumes", "--remove-orphans", check=False, project_root=self.active_compose_root)
        if group == "multi-tenant-browser" and self.compose_env.exists() and self.compose_overlay.exists():
            self.compose("down", "--volumes", "--remove-orphans", check=False, project_root=self.active_compose_root)
        for scenario in scenarios.get(group, []):
            database = self.plan["databases"][scenario]
            if self.database_exists(database):
                self.drop_database(database)

    def backend_values(self, database: str, mode: str, consumer: str = "container") -> dict[str, str]:
        if consumer not in ("host", "container"):
            fail(f"invalid database consumer: {consumer}")
        selector = command([
            str(REGISTRY_TOOL), "database-env", "--deployment-target", "local-development",
            "--consumer", consumer, "--resource-id", RESOURCE_ID, "--database-name", database,
        ], capture=True).stdout
        values: dict[str, str] = {}
        for line in selector.splitlines():
            name, separator, value = line.partition("=")
            if not separator:
                fail("database selector returned malformed output")
            values[name] = value
        if values.get("PEANUT_DATABASE_RESOURCE_ID") != RESOURCE_ID:
            fail("database selector changed the resource identity")
        if values.get("DB_NAME") != database or values.get("DB_NAME") == PERSISTENT_DATABASE:
            fail("database selector returned a forbidden database")
        values.update({
            "APP_ENV": "production",
            "APP_DEBUG": "false",
            "PEANUT_DEPLOYMENT_TARGET": "local-production-preview",
            "DB_USER": required_environment("P0E_DB_USER"),
            "DB_PASS": required_environment("P0E_DB_PASSWORD"),
            "DB_PREFIX": "pa_",
            "DEPLOYMENT_MODE": mode,
            "JWT_SECRET": required_environment("P0E_JWT_SECRET"),
            "TENANT_IDENTIFIER_HMAC_KEY": required_environment("P0E_TENANT_IDENTIFIER_HMAC_KEY"),
            "PLATFORM_IDENTIFIER_HMAC_KEY": required_environment("P0E_PLATFORM_IDENTIFIER_HMAC_KEY"),
        })
        return values

    def backend_env_path(self, project_root: Path) -> Path:
        return project_root / "server" / f".env.p0e-{self.args.run_id}"

    def write_backend_env(
        self,
        project_root: Path,
        database: str,
        mode: str,
        *,
        container_runtime: bool = False,
    ) -> Path:
        path = self.backend_env_path(project_root)
        if path.is_symlink():
            fail(f"P0-E backend environment must not be a symlink: {path}")
        values = self.backend_values(
            database,
            mode,
            consumer="container" if container_runtime else "host",
        )
        if container_runtime:
            values["PEANUT_RESOURCE_LEASE_PROOF"] = self.plan["lease_proof_container_path"]
        else:
            values["P0E_HOST_LEASE_PROOF"] = self.plan["lease_proof_dir"]
        temporary = path.with_suffix(path.suffix + ".tmp")
        temporary.write_text(
            "".join(f"{key}={value}\n" for key, value in sorted(values.items())),
            encoding="utf-8",
        )
        temporary.chmod(0o600)
        temporary.replace(path)
        return path

    @contextlib.contextmanager
    def backend_process_environment(
        self,
        project_root: Path,
        database: str,
        mode: str,
    ) -> Any:
        path = self.write_backend_env(project_root, database, mode)
        installation_path = path.with_name(path.name + ".installation")
        installation_values = {
            "ADMIN_INITIAL_EMAIL": required_environment("P0E_ADMIN_INITIAL_EMAIL"),
            "ADMIN_INITIAL_PASSWORD": required_environment("P0E_ADMIN_INITIAL_PASSWORD"),
        }
        if mode == "multi-tenant":
            installation_values.update({
                "PLATFORM_INITIAL_EMAIL": required_environment("P0E_PLATFORM_INITIAL_EMAIL"),
                "PLATFORM_INITIAL_PASSWORD": required_environment("P0E_PLATFORM_INITIAL_PASSWORD"),
            })
        installation_path.write_text(
            "".join(f"{key}={value}\n" for key, value in sorted(installation_values.items())),
            encoding="utf-8",
        )
        installation_path.chmod(0o600)
        environment = {
            "PEANUT_SERVER_ENV_FILE": str(path),
            "PEANUT_INSTALLATION_ENV_FILE": str(installation_path),
        }
        try:
            yield environment
        finally:
            for owned_path in (path, installation_path):
                with contextlib.suppress(FileNotFoundError):
                    owned_path.unlink()

    def database_exists(self, database: str) -> bool:
        escaped = database.replace("'", "''")
        result = self.remote_mysql(
            f"SELECT COUNT(*) FROM information_schema.SCHEMATA WHERE SCHEMA_NAME='{escaped}'"
        ).strip()
        return result == "1"

    def create_database(self, database: str) -> None:
        if database not in self.plan["databases"].values() or database == PERSISTENT_DATABASE:
            fail(f"refusing to create unowned database: {database}")
        if self.database_exists(database):
            fail(f"lease-owned database must be absent before creation: {database}")
        user = required_environment("P0E_DB_USER")
        if not re.fullmatch(r"[A-Za-z0-9_.-]{1,32}", user):
            fail("P0-E database user is not a safe registered account name")
        escaped_user = user.replace("'", "''")
        self.remote_mysql(
            f"CREATE DATABASE `{database}` CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci; "
            f"GRANT ALL PRIVILEGES ON `{database}`.* TO '{escaped_user}'@'%';"
        )

    def drop_database(self, database: str) -> None:
        if database not in self.plan["databases"].values() or database == PERSISTENT_DATABASE:
            fail(f"refusing to drop unowned database: {database}")
        user = required_environment("P0E_DB_USER")
        if not re.fullmatch(r"[A-Za-z0-9_.-]{1,32}", user):
            fail("P0-E database user is not a safe registered account name")
        escaped_user = user.replace("'", "''")
        grant_count = self.remote_mysql(
            "SELECT COUNT(*) FROM information_schema.SCHEMA_PRIVILEGES "
            f"WHERE TABLE_SCHEMA='{database}' AND "
            f"GRANTEE=CONCAT(CHAR(39),'{escaped_user}',CHAR(39),'@',CHAR(39),'%',CHAR(39))"
        ).strip()
        if grant_count != "0":
            self.remote_mysql(f"REVOKE ALL PRIVILEGES ON `{database}`.* FROM '{escaped_user}'@'%'")
        self.remote_mysql(f"DROP DATABASE IF EXISTS `{database}`")

    @contextlib.contextmanager
    def generated_install_bridge(self, project_root: Path) -> Any:
        if project_root == ROOT:
            yield
            return
        bridged_files = [
            "resources/project-resources.json",
            "server/database/environment-guard.php",
        ]
        originals: list[tuple[Path, bytes, int]] = []
        for relative in bridged_files:
            target = project_root / relative
            source = ROOT / relative
            if not target.is_file() or target.is_symlink() or not source.is_file() or source.is_symlink():
                fail(f"generated application qualification bridge identity changed: {relative}")
            originals.append((target, target.read_bytes(), target.stat().st_mode & 0o777))
        for relative in bridged_files:
            target = project_root / relative
            source = ROOT / relative
            target.write_bytes(source.read_bytes())
            target.chmod(source.stat().st_mode & 0o777)
        try:
            yield
        finally:
            for target, original, mode in originals:
                target.write_bytes(original)
                target.chmod(mode)
        for target, original, mode in originals:
            if target.read_bytes() != original or (target.stat().st_mode & 0o777) != mode:
                fail(f"generated application qualification bridge was not restored: {target.relative_to(project_root)}")

    def install_current(self, database: str, mode: str, log: Path, project_root: Path = ROOT) -> None:
        self.reset_generated_installation_state(project_root)
        with self.generated_install_bridge(project_root):
            with self.backend_process_environment(project_root, database, mode) as env:
                command(["php", "server/database/install.php"], cwd=project_root, env=env, log=log)
        self.assert_up_to_date(database, mode, log, project_root=project_root)

    def reset_generated_installation_state(self, project_root: Path) -> None:
        if project_root == ROOT:
            return
        if project_root not in self.generated.values():
            fail("refusing to reset installation state outside a generated Edition application")
        state_root = project_root / "server/runtime/installation"
        for name in ("executing.json", "installed.json", "execution.lock"):
            state = state_root / name
            if state.is_symlink() or (state.exists() and not state.is_file()):
                fail(f"generated installation state identity changed: {state}")
            with contextlib.suppress(FileNotFoundError):
                state.unlink()

    def assert_up_to_date(self, database: str, mode: str, log: Path, project_root: Path = ROOT) -> None:
        # The container entrypoint keeps the released command contract:
        # ["php", "server/database/environment-guard.php", "--current"]
        # Host-side fresh checks pass the active lease proof explicitly because
        # the fixed /run/peanut-admin/resource-lease path exists only in Compose.
        guard_php = (
            "require 'server/database/environment-guard.php';"
            "$config=guardedDatabaseConfig(getenv('P0E_HOST_LEASE_PROOF'));"
            "$pdo=guardedConnection($config);"
            "$result=['environment'=>$config['environment'],"
            "'deployment_target'=>$config['deployment_target'],"
            "'resource_id'=>$config['resource_id'],"
            "'endpoint_id'=>$config['endpoint_id'],"
            "'consumer'=>$config['consumer'],"
            "'host'=>$config['host'],"
            "'port'=>(int)$config['port'],"
            "'database'=>$config['database'],"
            "'status'=>'current'];"
            "$result+=assertCurrentDatabase($pdo);"
            "echo json_encode($result,JSON_UNESCAPED_UNICODE|JSON_PRETTY_PRINT),PHP_EOL;"
        )
        with self.generated_install_bridge(project_root):
            with self.backend_process_environment(project_root, database, mode) as env:
                result = command(
                    ["php", "-r", guard_php],
                    cwd=project_root,
                    env=env,
                    capture=True,
                )
        with log.open("a", encoding="utf-8") as stream:
            stream.write(result.stdout)
        parsed = json.loads(result.stdout)
        if parsed.get("status") != "current":
            fail(f"fresh schema/current assertion failed for {database}")

    def inspect(self, database: str, mode: str, label: str, project_root: Path = ROOT) -> None:
        inspector_mode = "multitenant-empty" if mode == "multi-tenant" else "standalone-empty"
        inspector = INSPECTOR
        created_directories: list[Path] = []
        copied_inspector = False
        if project_root != ROOT:
            inspector = project_root / "server/tests/fixtures/mt05/inspect.php"
            if inspector.exists():
                if not inspector.is_file() or inspector.is_symlink() or sha256(inspector) != sha256(INSPECTOR):
                    fail(f"application inspector identity changed: {inspector}")
            else:
                parent = inspector.parent
                cursor = parent
                while not cursor.exists():
                    created_directories.append(cursor)
                    cursor = cursor.parent
                parent.mkdir(parents=True)
                shutil.copy2(INSPECTOR, inspector)
                copied_inspector = True
        try:
            with self.backend_process_environment(project_root, database, mode) as env:
                env.update({
                    "MT05_MODE": inspector_mode,
                    "MT05_DEPLOYMENT_MODE": mode,
                    "MT05_CANDIDATE": self.args.candidate,
                    "MT05_RUN_ID": self.args.run_id,
                })
                result = command(["php", str(inspector)], env=env, capture=True)
        finally:
            if copied_inspector:
                with contextlib.suppress(FileNotFoundError):
                    inspector.unlink()
                for directory in created_directories:
                    with contextlib.suppress(OSError):
                        directory.rmdir()
        parsed = json.loads(result.stdout)
        if parsed.get("status") != "passed":
            fail(f"database inspection failed for {label}")
        self.write_json(self.output / "groups" / f"{label}.json", parsed)

    def create_app_environment(self) -> dict[str, str]:
        create_app_excludes = self.cache / "create-app-git-excludes"
        create_app_excludes.write_text(
            f"/{self.output.relative_to(ROOT).as_posix()}/\n",
            encoding="utf-8",
        )
        return {
            "GIT_CONFIG_COUNT": "1",
            "GIT_CONFIG_KEY_0": "core.excludesFile",
            "GIT_CONFIG_VALUE_0": str(create_app_excludes),
        }

    def generated_application(self) -> None:
        log = self.group_log("generated-application")
        composer_env = {"COMPOSER_CACHE_DIR": str(self.cache / "composer")}
        if self.created_candidate_vendor:
            command(
                ["/usr/local/bin/composer", "install", "--no-interaction", "--no-progress", "--prefer-dist"],
                cwd=ROOT / "server",
                env=composer_env,
                log=log,
            )
        target = self.fixture["target_release"]
        self.edition_artifacts.mkdir()
        command([
            "php", "scripts/build-edition-installers",
            f"--version={target['version']}",
            f"--source-commit={self.args.candidate}",
            f"--output={self.edition_artifacts}",
        ], log=log)
        edition_results: dict[str, Any] = {}
        for edition, generated in self.generated.items():
            filename = f"peanut-admin-{target['version']}-{edition}.tar.gz"
            archive = self.edition_artifacts / filename
            artifact_manifest_path = self.edition_artifacts / f"{filename}.manifest.json"
            artifact_manifest = read_json(artifact_manifest_path)
            archive_root = artifact_manifest.get("archive", {}).get("root")
            if (
                artifact_manifest.get("protocol") != "peanut.edition-installer.v1"
                or artifact_manifest.get("product", {}).get("version") != target["version"]
                or artifact_manifest.get("edition", {}).get("name") != edition
                or artifact_manifest.get("source") != {
                    "commit": self.args.candidate,
                    "tree": self.plan["candidate_tree"],
                    "inventory_sha256": target["inventory_sha256"],
                }
                or artifact_manifest.get("archive", {}).get("filename") != filename
                or artifact_manifest.get("archive", {}).get("sha256") != sha256(archive)
                or archive_root != generated.name
            ):
                fail(f"{edition} installer identity does not match the fixed candidate")
            with tarfile.open(archive, "r:gz") as package:
                members = package.getmembers()
                prefix = generated.name + "/"
                if not members or any(
                    (member.name != generated.name and not member.name.startswith(prefix))
                    or Path(member.name).is_absolute()
                    or ".." in Path(member.name).parts
                    or not (member.isdir() or member.isfile())
                    for member in members
                ):
                    fail(f"{edition} installer archive contains an unsafe entry")
                package.extractall(self.cache)
            if not generated.is_dir():
                fail(f"{edition} installer did not extract its declared root")

            build_database = self.plan["databases"][f"{'multi_tenant' if edition == 'multi-tenant' else 'standalone'}_fresh"]
            with self.backend_process_environment(generated, build_database, edition) as backend_env:
                command(
                    ["/usr/local/bin/composer", "install", "--no-interaction", "--no-progress", "--prefer-dist"],
                    cwd=generated / "server",
                    env=composer_env | backend_env,
                    log=log,
                )
            command(["php", "-r", "require 'vendor/autoload.php'; echo 'autoload=ok\\n';"], cwd=generated / "server", log=log)
            command(["pnpm", "install", "--frozen-lockfile", "--store-dir", str(self.cache / "pnpm-store")], cwd=generated / "web", log=log)
            command(["pnpm", "run", "build"], cwd=generated / "web", log=log)
            if edition == "multi-tenant":
                command(["npm", "ci", "--cache", str(self.cache / "npm")], cwd=generated / "platform", log=log)
                command(["npm", "run", "build"], cwd=generated / "platform", log=log)
            command(["npm", "ci", "--cache", str(self.cache / "npm")], cwd=generated / "pc", log=log)
            command(["npm", "run", "typecheck"], cwd=generated / "pc", log=log)
            command(["npm", "run", "generate"], cwd=generated / "pc", log=log)
            command(["npm", "ci", "--cache", str(self.cache / "npm")], cwd=generated / "uniapp", log=log)
            command(["npm", "run", "type-check"], cwd=generated / "uniapp", log=log)
            command(["npm", "run", "build:h5"], cwd=generated / "uniapp", log=log)
            command(["pnpm", "install", "--frozen-lockfile", "--store-dir", str(self.cache / "pnpm-store")], cwd=generated / "docs-site", log=log)
            command(["pnpm", "run", "build"], cwd=generated / "docs-site", log=log)

            manifest_path = generated / ".peanut/application-manifest.json"
            manifest = read_json(manifest_path)
            expected_template = {
                "version": target["version"],
                "inventory_sha256": target["inventory_sha256"],
                "source_commit": self.args.candidate,
                "source_tree": self.plan["candidate_tree"],
            }
            generation = manifest.get("generation_source", {})
            if (
                manifest.get("schema_version") != target["application_manifest_schema"]
                or manifest.get("protocol") != "peanut.application-scaffold.v2"
                or manifest.get("application", {}).get("version") != target["version"]
                or manifest.get("application", {}).get("edition") != edition
                or manifest.get("edition", {}).get("name") != edition
                or manifest.get("template") != expected_template
                or generation.get("commit") != self.args.candidate
                or generation.get("tree") != self.plan["candidate_tree"]
                or generation.get("inventory_sha256") != target["inventory_sha256"]
                or artifact_manifest.get("application", {}).get("manifest_sha256") != sha256(manifest_path)
                or artifact_manifest.get("application", {}).get("managed_tree_sha256") != manifest.get("digests", {}).get("managed_tree_sha256")
            ):
                fail(f"{edition} application identity does not match its installer")
            uniapp_manifest = (generated / "uniapp/src/manifest.json").read_text(encoding="utf-8")
            expected_version = re.escape(target["version"])
            expected_code = re.escape(target["default_uniapp_version_code"])
            if (
                re.search(rf'"versionName"\s*:\s*"{expected_version}"', uniapp_manifest) is None
                or re.search(rf'"versionCode"\s*:\s*"{expected_code}"', uniapp_manifest) is None
            ):
                fail(f"{edition} generated UniApp version identity changed")
            edition_results[edition] = {
                "installer_manifest_sha256": sha256(artifact_manifest_path),
                "archive_sha256": sha256(archive),
                "application_manifest_sha256": sha256(manifest_path),
                "application_version": manifest["application"]["version"],
                "app_owned": self.app_owned_proof(generated),
            }
        self.write_json(self.output / "groups/generated-application.json", {
            "schema_version": 1,
            "status": "passed",
            "candidate": self.args.candidate,
            "candidate_tree": self.plan["candidate_tree"],
            "target_release": target,
            "editions": edition_results,
            "uniapp_version_code": target["default_uniapp_version_code"],
        })

    @staticmethod
    def app_owned_proof(project_root: Path) -> dict[str, Any]:
        manifest = read_json(project_root / ".peanut/application-manifest.json")
        files = manifest.get("files")
        if not isinstance(files, list):
            fail("application manifest files are invalid")
        rows: list[str] = []
        paths: list[str] = []
        for item in files:
            if not isinstance(item, dict) or item.get("classification") != "app-owned":
                continue
            relative = item.get("path")
            if not isinstance(relative, str) or not relative or relative.startswith("/") or ".." in Path(relative).parts:
                fail("application manifest contains an unsafe app-owned path")
            path = project_root / relative
            if not path.is_file() or path.is_symlink():
                fail(f"app-owned file is unavailable: {relative}")
            mode = path.stat().st_mode & 0o777
            paths.append(relative)
            rows.append(f"{relative}\0{sha256(path)}\0{mode:04o}")
        if not rows:
            fail("application manifest contains no app-owned files")
        return {
            "file_count": len(rows),
            "paths_sha256": hashlib.sha256("\n".join(paths).encode("utf-8")).hexdigest(),
            "tree_sha256": hashlib.sha256("\n".join(rows).encode("utf-8")).hexdigest(),
        }

    def fresh(self, scenario: str, group: str, mode: str) -> None:
        database = self.plan["databases"][scenario]
        log = self.group_log(group)
        generated = self.generated[mode]
        self.create_database(database)
        self.install_current(database, mode, log, project_root=generated)
        self.inspect(database, mode, group, project_root=generated)
        self.drop_database(database)

    def seed_multi_tenant_browser_binding(self, database: str, log: Path) -> None:
        """Give the fresh browser fixture a Host-bound default Tenant entry.

        A multi-tenant install intentionally starts without any public Tenant Host
        binding.  The browser qualification uses the registered shared Admin Host,
        so it needs one explicit synthetic binding before exercising anonymous
        config reads and the owner login flow.  This is fixture data only; it is
        not part of the generated application or the released database baseline.
        """
        host = self.plan["browser_hosts"]["tenant_admin"]
        escaped_host = host.replace("'", "''")
        for client in ("admin-web", "member-api"):
            database_sql = (
                "INSERT INTO pa_tenant_entry_binding (tenant_id, host, client_key, status) "
                "SELECT t.id, '" + escaped_host + "', '" + client + "', 'active' "
                "FROM pa_tenant t "
                "WHERE t.code = 'default' "
                "AND NOT EXISTS ("
                "SELECT 1 FROM pa_tenant_entry_binding b "
                "WHERE b.host = '" + escaped_host + "' AND b.client_key = '" + client + "'"
                ");"
            )
            self.remote_mysql(database_sql, database=database)
            count = self.remote_mysql(
                "SELECT COUNT(*) FROM pa_tenant_entry_binding "
                "WHERE host = '" + escaped_host + "' AND client_key = '" + client + "'",
                database=database,
            ).strip()
            if count != "1":
                fail(f"multi-tenant browser fixture did not create its {client} Host binding")
        with log.open("a", encoding="utf-8") as stream:
            stream.write(
                "P0-E browser fixture seeded default Tenant binding "
                f"host={host} clients=admin-web,member-api\n"
            )

    def plugin_lifecycle_at(self, project_root: Path, scenario: str, group: str) -> None:
        database = self.plan["databases"][scenario]
        log = self.group_log(group)
        self.create_database(database)
        self.install_current(database, "multi-tenant", log, project_root=project_root)
        with self.backend_process_environment(project_root, database, "multi-tenant") as env:
            command(
                ["php", "server/fixtures/plugin-module-lifecycle/run.php"],
                cwd=project_root,
                env=env,
                log=log,
            )
        self.inspect(database, "multi-tenant", group, project_root=project_root)
        self.drop_database(database)

    def plugin_lifecycle(self) -> None:
        log = self.group_log("plugin-lifecycle")
        database = self.plan["databases"]["plugin_lifecycle"]
        service_gates = [
            (
                "server/tests/Multitenancy/MemberUploadTenantWiringTest.php",
                {},
            ),
            (
                "server/tests/Multitenancy/TaskImportExportTenantIsolationTest.php",
                {"ASYNC_PRIVATE_ROOT": str(self.cache / "task-import-export-private")},
            ),
        ]
        for test, additions in service_gates:
            self.create_database(database)
            with self.backend_process_environment(ROOT, database, "multi-tenant") as env:
                env.update(additions)
                command(["php", test], cwd=ROOT, env=env, log=log)
            self.drop_database(database)

        generated = self.generated["multi-tenant"]
        lock = generated / "plugins.lock"
        original_lock = lock.read_bytes()
        original_mode = lock.stat().st_mode & 0o777
        source_lock = read_json(ROOT / "plugins.lock")
        expected_official_keys = sorted(
            str(entry.get("key"))
            for entry in source_lock.get("plugins", [])
            if isinstance(entry, dict) and str(entry.get("key", "")).startswith("official.")
        )
        generated_lock = json.loads(original_lock)
        generated_official_keys = sorted(
            str(entry.get("key"))
            for entry in generated_lock.get("plugins", [])
            if isinstance(entry, dict) and str(entry.get("key", "")).startswith("official.")
        ) if isinstance(generated_lock, dict) else []
        if expected_official_keys == [] or generated_official_keys != expected_official_keys:
            fail("generated application Plugin lock does not contain the released official Plugin set")
        command(
            [
                "php", "-r",
                r"require 'server/vendor/autoload.php'; "
                r"$result=(new \app\platform\infrastructure\plugin\PluginArtifactWriter(getcwd().'/server'))->checkLock(); "
                r"echo json_encode($result, JSON_UNESCAPED_SLASHES), PHP_EOL;",
            ],
            cwd=generated,
            log=log,
        )
        fixture_paths = [
            (ROOT / "plugins/fixture.delivery-record", generated / "plugins/fixture.delivery-record"),
            (ROOT / "server/app/modules/fixture/delivery_record", generated / "server/app/modules/fixture/delivery_record"),
            (ROOT / "web/src/modules/fixture-delivery-record", generated / "web/src/modules/fixture-delivery-record"),
        ]
        runner_source = ROOT / "server/fixtures/plugin-module-lifecycle/run.php"
        runner_target = generated / "server/fixtures/plugin-module-lifecycle/run.php"
        if any(target.exists() for _, target in fixture_paths) or runner_target.exists():
            fail("generated application already contains a Plugin qualification fixture")
        before = self.app_owned_proof(generated)
        try:
            for source, target in fixture_paths:
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copytree(source, target, copy_function=shutil.copy2)
            runner_target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(runner_source, runner_target)
            fixture_lock = {
                "schema_version": 1,
                "plugins": [
                    entry
                    for entry in source_lock.get("plugins", [])
                    if isinstance(entry, dict) and entry.get("key") == "fixture.delivery-record"
                ],
            }
            if len(fixture_lock["plugins"]) != 1:
                fail("fixture Plugin lock entry is missing or duplicated")
            lock.write_text(json.dumps(fixture_lock, indent=2) + "\n", encoding="utf-8")
            self.plugin_lifecycle_at(
                generated,
                "plugin_lifecycle",
                "plugin-lifecycle",
            )
        finally:
            lock.write_bytes(original_lock)
            lock.chmod(original_mode)
            for _, target in reversed(fixture_paths):
                if target.exists():
                    shutil.rmtree(target)
            with contextlib.suppress(FileNotFoundError):
                runner_target.unlink()
            with contextlib.suppress(OSError):
                runner_target.parent.rmdir()
        after = self.app_owned_proof(generated)
        if before != after or lock.read_bytes() != original_lock or (lock.stat().st_mode & 0o777) != original_mode:
            fail("generated application Plugin qualification changed released bytes")
        self.write_json(self.output / "groups/plugin-lifecycle.json", {
            "schema_version": 1,
            "status": "passed",
            "application_root": str(generated),
            "database": self.plan["databases"]["plugin_lifecycle"],
            "source_service_gates": [test for test, _ in service_gates],
            "plugin_lock_restored_sha256": sha256(lock),
            "fixture_removed": True,
            "app_owned_before_sha256": before["tree_sha256"],
            "app_owned_after_sha256": after["tree_sha256"],
        })

    def consumer_module_lifecycle(self) -> None:
        group = "consumer-module-lifecycle"
        database = self.plan["databases"]["consumer_module_cycle"]
        output = self.cache / group
        log = self.group_log(group)
        self.create_database(database)
        host, port = self.plan["host_endpoint"].rsplit(":", 1)
        arguments = [
            str(CONSUMER_MODULE_CHAIN),
            "--candidate", self.args.candidate,
            "--lease", self.args.lease,
            "--database", database,
            "--output", str(output),
            "--formal-release-adoption",
        ]
        consumer_environment = self.cache / "consumer-module-environment.env"
        consumer_environment.write_text(
            "".join(f"{name}={value}\n" for name, value in {
                "DB_HOST": host,
                "DB_PORT": port,
                "DB_USER": required_environment("P0E_DB_USER"),
                "DB_PASS": required_environment("P0E_DB_PASSWORD"),
            }.items()),
            encoding="utf-8",
        )
        consumer_environment.chmod(0o600)
        arguments.extend(["--env-file", str(consumer_environment)])
        result = command(
            arguments,
            env=self.create_app_environment(),
            capture=True,
            check=False,
        )
        with contextlib.suppress(FileNotFoundError):
            consumer_environment.unlink()
        with log.open("a", encoding="utf-8") as stream:
            stream.write("$ " + shlex.join(arguments) + "\n")
            stream.write(result.stdout)
            stream.write(result.stderr)
        if result.returncode != 0:
            detail = (result.stderr or result.stdout).strip().splitlines()
            fail("consumer Module lifecycle failed: " + (detail[-1] if detail else "no output"))
        try:
            summary = json.loads(result.stdout.strip())
        except json.JSONDecodeError as exception:
            fail(f"consumer Module lifecycle summary is invalid: {exception}")
        if (
            not isinstance(summary, dict)
            or summary.get("status") != "passed"
            or summary.get("candidate") != self.args.candidate
            or summary.get("candidate_tree") != self.plan["candidate_tree"]
            or summary.get("database") != database
            or summary.get("gates", {}).get("formal_release_adoption") != "passed"
        ):
            fail("consumer Module lifecycle summary identity diverged")
        self.write_json(self.output / "groups/consumer-module-lifecycle.json", summary)

    def write_compose_env(self, project_root: Path, database: str, mode: str) -> None:
        self.compose_backend_env = self.write_backend_env(
            project_root,
            database,
            mode,
            container_runtime=True,
        )
        backend_values = self.backend_values(database, mode)
        backend_values.update({
            "PLATFORM_HOSTS": self.plan["browser_hosts"]["platform"],
            "TENANT_ADMIN_HOSTS": self.plan["browser_hosts"]["tenant_admin"],
            "JWT_SECRET": required_environment("P0E_JWT_SECRET"),
            "TENANT_IDENTIFIER_HMAC_KEY": required_environment("P0E_TENANT_IDENTIFIER_HMAC_KEY"),
            "PLATFORM_IDENTIFIER_HMAC_KEY": required_environment("P0E_PLATFORM_IDENTIFIER_HMAC_KEY"),
            "PEANUT_RESOURCE_LEASE_PROOF": self.plan["lease_proof_container_path"],
        })
        temporary_backend = self.compose_backend_env.with_suffix(self.compose_backend_env.suffix + ".tmp")
        temporary_backend.write_text(
            "".join(f"{key}={value}\n" for key, value in sorted(backend_values.items())),
            encoding="utf-8",
        )
        temporary_backend.chmod(0o600)
        temporary_backend.replace(self.compose_backend_env)
        values = {
            "HTTP_PORT": str(self.plan["ports"]["http"]),
            "PHP_IMAGE": f"peanut-p0e-php:{self.args.run_id}",
            "NGINX_IMAGE": f"peanut-p0e-nginx:{self.args.run_id}",
            "PEANUT_SOURCE_COMMIT": self.args.candidate,
            "PEANUT_SOURCE_TREE": self.plan["candidate_tree"],
            "PEANUT_SERVER_ENV_FILE": str(self.compose_backend_env),
        }
        temporary = self.compose_env.with_suffix(".tmp")
        temporary.write_text("".join(f"{key}={value}\n" for key, value in values.items()), encoding="utf-8")
        temporary.chmod(0o600)
        temporary.replace(self.compose_env)
        proof_dir = Path(self.plan["lease_proof_dir"])
        if not proof_dir.is_dir():
            fail(f"active lease proof directory is unavailable: {proof_dir}")
        overlay = (
            "services:\n"
            "  php:\n"
            "    volumes:\n"
            "      - type: bind\n"
            f"        source: {proof_dir}\n"
            f"        target: {self.plan['lease_proof_container_path']}\n"
            "        read_only: true\n"
            "      - type: bind\n"
            f"        source: {ROOT / 'resources/project-resources.json'}\n"
            "        target: /var/www/peanut-admin/resources/project-resources.json\n"
            "        read_only: true\n"
            "      - type: bind\n"
            f"        source: {ROOT / 'server/database/environment-guard.php'}\n"
            "        target: /var/www/peanut-admin/server/database/environment-guard.php\n"
            "        read_only: true\n"
            "  cron:\n"
            "    volumes:\n"
            "      - type: bind\n"
            f"        source: {proof_dir}\n"
            f"        target: {self.plan['lease_proof_container_path']}\n"
            "        read_only: true\n"
            "      - type: bind\n"
            f"        source: {ROOT / 'resources/project-resources.json'}\n"
            "        target: /var/www/peanut-admin/resources/project-resources.json\n"
            "        read_only: true\n"
            "networks:\n"
            "  default:\n"
            "    ipam:\n"
            "      config:\n"
            "        - subnet: 192.168.224.0/20\n"
        )
        self.compose_overlay.write_text(overlay, encoding="utf-8")
        self.compose_overlay.chmod(0o600)

    def compose_environment(self) -> dict[str, str]:
        try:
            lines = self.compose_env.read_text(encoding="utf-8").splitlines()
        except OSError as exception:
            fail(f"cannot read Compose environment {self.compose_env}: {exception}")
        values: dict[str, str] = {}
        for line_number, line in enumerate(lines, start=1):
            name, separator, value = line.partition("=")
            if not separator or not name or name in values:
                fail(f"invalid Compose environment at line {line_number}")
            values[name] = value
        if not values:
            fail("Compose environment is empty")
        backend = values.get("PEANUT_SERVER_ENV_FILE", "")
        if not backend:
            fail("Compose orchestration environment is missing PEANUT_SERVER_ENV_FILE")
        self.compose_backend_env = Path(backend)
        return values

    def compose(
        self,
        *arguments: str,
        log: Path | None = None,
        check: bool = True,
        project_root: Path = ROOT,
    ) -> subprocess.CompletedProcess[str]:
        environment = self.compose_environment()
        if self.compose_backend_env is None or not self.compose_backend_env.is_file():
            fail("P0-E backend Compose environment is unavailable")
        return command([
            "docker", "compose", "--project-name", self.plan["compose_project"],
            "--env-file", str(self.compose_env), "--env-file", str(self.compose_backend_env),
            "-f", str(project_root / "deploy/docker-compose.prod.yml"),
            "-f", str(self.compose_overlay),
            *arguments,
        ], cwd=project_root, env=environment, log=log, capture=log is None, check=check)

    def wait_http(self, url: str, seconds: int = 120) -> None:
        deadline = time.time() + seconds
        error = "unavailable"
        while time.time() < deadline:
            try:
                with urllib.request.urlopen(url, timeout=5) as response:
                    if response.status == 200:
                        return
                    error = f"HTTP {response.status}"
            except Exception as exception:  # bounded readiness probe
                error = str(exception)
            time.sleep(2)
        fail(f"HTTP readiness failed for {url}: {error}")

    def production_compose_at(self, project_root: Path, scenario: str, group: str) -> None:
        database = self.plan["databases"][scenario]
        log = self.group_log(group)
        self.create_database(database)
        self.install_current(database, "standalone", log, project_root=project_root)
        with self.backend_process_environment(project_root, database, "standalone") as env:
            command(
                ["php", "server/think", "plugin:reconcile", "--official-locked"],
                cwd=project_root,
                env=env,
                log=log,
            )
        self.inspect(database, "standalone", f"{group}-database", project_root=project_root)
        self.start_database_tunnel()
        self.write_compose_env(project_root, database, "standalone")
        self.compose("up", "-d", "--build", "php", "nginx", "cron", log=log, project_root=project_root)
        self.active_compose_root = project_root
        self.wait_http(f"http://127.0.0.1:{self.plan['ports']['http']}/healthz")
        self.write_json(self.output / "groups" / f"{group}.json", {
            "schema_version": 1,
            "compose_project": self.plan["compose_project"],
            "candidate": self.args.candidate,
            "application_root": str(project_root),
            "mode": "standalone",
            "health_url": f"http://127.0.0.1:{self.plan['ports']['http']}/healthz",
            "status": "passed",
        })

    def production_compose(self) -> None:
        self.production_compose_at(self.generated["standalone"], "standalone_browser", "production-compose")

    def start_docs(self, project_root: Path) -> None:
        if self.docs_process is not None and self.docs_process.poll() is None and self.docs_root == project_root:
            return
        self.stop_docs()
        log = (self.output / "groups/docs-preview.log").open("a", encoding="utf-8")
        self.docs_process = subprocess.Popen([
            "pnpm", "exec", "vitepress", "preview", ".", "--host", "127.0.0.1",
            "--port", str(self.plan["ports"]["docs"]),
        ], cwd=project_root / "docs-site", stdout=log, stderr=subprocess.STDOUT, text=True,
            env=operating_system_environment())
        self.docs_root = project_root
        self.wait_http(f"http://127.0.0.1:{self.plan['ports']['docs']}/")

    def browser_at(self, mode: str, project_root: Path, scenario: str, group: str, output_scope: str) -> None:
        database = self.plan["databases"][scenario]
        if mode == "multi-tenant":
            self.start_database_tunnel()
            if self.compose_env.exists() and self.compose_overlay.exists() and self.active_compose_root != project_root:
                self.compose(
                    "down", "--volumes", "--remove-orphans", "--rmi", "local",
                    check=False,
                    project_root=self.active_compose_root,
                )
            if not self.database_exists(database):
                self.create_database(database)
                self.install_current(database, mode, self.group_log(group), project_root=project_root)
                with self.backend_process_environment(project_root, database, mode) as env:
                    command(
                        ["php", "server/think", "plugin:reconcile", "--official-locked"],
                        cwd=project_root,
                        env=env,
                        log=self.group_log(group),
                    )
            self.inspect(database, mode, f"{group}-database", project_root=project_root)
            self.seed_multi_tenant_browser_binding(database, self.group_log(group))
            self.write_compose_env(project_root, database, mode)
            self.compose(
                "up", "-d", "--build", "--force-recreate", "php", "nginx", "cron",
                log=self.group_log(group),
                project_root=project_root,
            )
            self.active_compose_root = project_root
            self.wait_http(f"http://127.0.0.1:{self.plan['ports']['http']}/healthz")
        self.start_docs(project_root)
        browser_output = self.output / "browser" / output_scope
        browser_output.mkdir(parents=True, exist_ok=True)
        command([
            str(BROWSER_RUNNER), "--mode", mode,
            "--tenant-admin-url", f"http://{self.plan['browser_hosts']['tenant_admin']}:{self.plan['ports']['http']}",
            "--platform-url", f"http://{self.plan['browser_hosts']['platform']}:{self.plan['ports']['http']}",
            "--docs-url", f"http://127.0.0.1:{self.plan['ports']['docs']}",
            "--output-dir", str(browser_output),
            "--session", f"p0e-{self.args.run_id}",
            "--env-file", str(self.runtime_credentials),
            "--playwright-cli", self.playwright_cli(),
        ], log=self.group_log(group))

    def browser(self, mode: str) -> None:
        group = f"{mode}-browser"
        scenario = "standalone_browser" if mode == "standalone" else "multi_tenant_browser"
        self.browser_at(mode, self.generated[mode], scenario, group, mode)

    def stop_docs(self) -> None:
        if self.docs_process is None or self.docs_process.poll() is not None:
            return
        self.docs_process.send_signal(signal.SIGTERM)
        try:
            self.docs_process.wait(timeout=15)
        except subprocess.TimeoutExpired:
            self.docs_process.kill()
            self.docs_process.wait(timeout=5)
        self.docs_process = None
        self.docs_root = None

    def cleanup_success(self) -> None:
        self.stop_docs()
        if self.compose_env.exists():
            self.compose(
                "down", "--volumes", "--remove-orphans", "--rmi", "local",
                check=False,
                project_root=self.active_compose_root,
            )
        self.stop_database_tunnel()
        for database in self.plan["databases"].values():
            self.drop_database(database)
        residual = [name for name in self.plan["databases"].values() if self.database_exists(name)]
        if residual:
            fail(f"lease-owned database cleanup incomplete: {residual}")
        project = self.plan["compose_project"]
        docker_residuals = {
            "containers": command(["docker", "ps", "-aq", "--filter", f"label=com.docker.compose.project={project}"], capture=True).stdout.split(),
            "volumes": command(["docker", "volume", "ls", "-q", "--filter", f"label=com.docker.compose.project={project}"], capture=True).stdout.split(),
            "networks": command(["docker", "network", "ls", "-q", "--filter", f"label=com.docker.compose.project={project}"], capture=True).stdout.split(),
        }
        for tag in (f"peanut-p0e-php:{self.args.run_id}", f"peanut-p0e-nginx:{self.args.run_id}"):
            result = command(["docker", "image", "inspect", tag], capture=True, check=False)
            if result.returncode == 0:
                docker_residuals.setdefault("images", []).append(tag)
        if any(docker_residuals.values()):
            fail(f"compose cleanup residuals remain: {docker_residuals}")
        for port in [*self.plan["ports"].values(), self.plan["database_tunnel"]["local_port"]]:
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
                probe.settimeout(0.5)
                if probe.connect_ex(("127.0.0.1", int(port))) == 0:
                    fail(f"listener cleanup residual remains on port {port}")
        with contextlib.suppress(FileNotFoundError):
            self.compose_env.unlink()
        if self.compose_backend_env is not None:
            with contextlib.suppress(FileNotFoundError):
                self.compose_backend_env.unlink()
        shutil.rmtree(self.cache)
        if self.created_candidate_vendor and (ROOT / "server/vendor").exists():
            shutil.rmtree(ROOT / "server/vendor")
        playwright_cli = Path(self.playwright_cli())
        lease_proof_dir = Path(self.plan["lease_proof_dir"])
        if playwright_cli.parent == lease_proof_dir and playwright_cli.name == "playwright-cli":
            if not playwright_cli.is_file() or playwright_cli.is_symlink():
                fail("lease-owned Playwright CLI wrapper identity changed")
            playwright_cli.unlink()
        self.write_json(self.summary_path, {
            "schema_version": 1,
            "status": "passed",
            "candidate": self.args.candidate,
            "candidate_tree": self.plan["candidate_tree"],
            "run_id": self.args.run_id,
            "resource_id": RESOURCE_ID,
            "environment": "development",
            "endpoint": self.plan["endpoint"],
            "groups": self.checkpoint["groups"],
            "fresh_only_2_0": {
                "generated_application": "groups/generated-application.json",
                "standalone_fresh": "groups/standalone-fresh.json",
                "multi_tenant_fresh": "groups/multi-tenant-fresh.json",
                "plugin_lifecycle": "groups/plugin-lifecycle.json",
                "consumer_module_lifecycle": "groups/consumer-module-lifecycle.json",
                "production_compose": "groups/production-compose.json",
                "browser": {
                    "standalone": "browser/standalone",
                    "multi_tenant": "browser/multi-tenant",
                },
            },
            "cleanup": {
                "database_residual_count": 0,
                "compose_removed": True,
                "container_residual_count": 0,
                "volume_residual_count": 0,
                "network_residual_count": 0,
                "image_residual_count": 0,
                "listener_residual_count": 0,
                "docs_listener_stopped": True,
                "cache_removed": True,
                "output_preserved": str(self.output),
            },
        })
        command([str(LEASE_TOOL), "release", "--lease", self.args.lease, "--owner", self.args.owner])
        summary = read_json(self.summary_path)
        summary["cleanup"]["lease_released"] = True
        self.write_json(self.summary_path, summary)

    def run(self) -> None:
        self.run_group("generated-application", self.generated_application)
        self.run_group("standalone-fresh", lambda: self.fresh("standalone_fresh", "standalone-fresh", "standalone"))
        self.run_group("multi-tenant-fresh", lambda: self.fresh("multi_tenant_fresh", "multi-tenant-fresh", "multi-tenant"))
        self.run_group("plugin-lifecycle", self.plugin_lifecycle)
        self.run_group("consumer-module-lifecycle", self.consumer_module_lifecycle)
        self.run_group("production-compose", self.production_compose)
        self.run_group("standalone-browser", lambda: self.browser("standalone"))
        self.run_group("multi-tenant-browser", lambda: self.browser("multi-tenant"))
        required = set(self.fixture["groups"])
        passed = {name for name, value in self.checkpoint["groups"].items() if value.get("status") == "passed"}
        if passed != required:
            fail(f"qualification group closure is incomplete: {sorted(required - passed)}")
        self.current_group = "cleanup"
        self.cleanup_success()

    def preserve_failure(self, exception: Exception) -> None:
        self.stop_docs()
        self.stop_database_tunnel()
        state = self.checkpoint["groups"].setdefault(self.current_group, {})
        state.update({"status": "failed", "failed_at": int(time.time()), "error": str(exception)[:500]})
        self.save_checkpoint()
        self.write_json(self.output / "recovery.json", {
            "schema_version": 1,
            "status": "failed-preserved",
            "candidate": self.args.candidate,
            "candidate_tree": self.plan["candidate_tree"],
            "run_id": self.args.run_id,
            "lease": self.args.lease,
            "failed_group": self.current_group,
            "passed_groups": sorted(name for name, value in self.checkpoint["groups"].items() if value.get("status") == "passed"),
            "resume_command": "scripts/p0e-runtime-qualification resume <same fixed arguments>",
            "databases": self.plan["databases"],
            "cache_dir": str(self.cache),
            "output_dir": str(self.output),
        })
        command([
            str(LEASE_TOOL), "renew", "--lease", self.args.lease, "--owner", self.args.owner,
            "--ttl", str(self.args.ttl),
        ], check=False)


def add_fixed_arguments(parser: argparse.ArgumentParser, with_lease: bool = True) -> None:
    parser.add_argument("--candidate", required=True)
    parser.add_argument("--run-id", required=True)
    parser.add_argument("--output-dir", required=True)
    parser.add_argument("--cache-dir", required=True)
    parser.add_argument("--http-port", required=True, type=int)
    parser.add_argument("--docs-port", required=True, type=int)
    if with_lease:
        parser.add_argument("--lease", required=True)
        parser.add_argument("--owner", required=True)
        parser.add_argument("--thread", required=True)
        parser.add_argument("--ttl", type=int, default=43200)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    plan_parser = subparsers.add_parser("plan", help="validate and print the complete no-resource plan")
    add_fixed_arguments(plan_parser, with_lease=False)
    plan_parser.add_argument("--lease", required=True)
    claim_parser = subparsers.add_parser("claim", help="atomically claim every resource in the fixed plan")
    add_fixed_arguments(claim_parser)
    run_parser = subparsers.add_parser("run", help="run a newly claimed qualification")
    add_fixed_arguments(run_parser)
    resume_parser = subparsers.add_parser("resume", help="resume only incomplete/failed groups")
    add_fixed_arguments(resume_parser)
    args = parser.parse_args()
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", args.lease):
        fail("lease id is invalid")
    if args.lease != f"p0e-runtime-{args.run_id}":
        fail("lease id must equal p0e-runtime-<exact run_id>")
    if hasattr(args, "ttl") and not 60 <= args.ttl <= 86400:
        fail("ttl must be 60-86400 seconds")
    if args.command != "plan" and (not args.owner or not args.thread):
        fail("owner and thread are required")
    plan_data = plan(args, require_clean=args.command != "plan")
    if args.command == "plan":
        print(json.dumps(plan_data, ensure_ascii=False, indent=2))
        return 0
    if args.command == "claim":
        claim(args, plan_data)
        verify_lease(args, plan_data)
        print(json.dumps({"status": "claimed", "lease": args.lease, "candidate": args.candidate}))
        return 0
    verify_lease(args, plan_data)
    prepare_database_credentials()
    fixture, _, _, _, _, _ = validate_fixture()
    runner = Runner(args, plan_data, fixture)
    runner.preflight_database_admin_tooling()
    if args.command == "run":
        runner.initialize()
    else:
        runner.resume()
    try:
        runner.run()
    except Exception as exception:
        runner.preserve_failure(exception)
        raise
    print(json.dumps({"status": "passed", "summary": str(runner.summary_path)}))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except GateError as exception:
        print(f"p0e-runtime-qualification: {exception}", file=sys.stderr)
        sys.exit(1)
