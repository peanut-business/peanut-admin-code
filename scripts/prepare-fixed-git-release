#!/usr/bin/env python3
"""Prepare a typed fixed-Git directory using the selected APP's native packer.

This is a source/build adapter, never an installed-instance update entry.
"""
from __future__ import annotations

import argparse
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parents[1]
ENTRY = 'scripts/package-release.sh'
IDENTITY = 'server/.peanut/release-identity.json'
DESCRIPTOR = 'fixed-git-source.json'
TOOLS = ('git', 'bash', 'python3', 'node', 'npm', 'pnpm', 'php')
INPUTS = ('.peanut/application-manifest.json', 'release-versions.json', ENTRY,
          'scripts/package-release-files.py', 'scripts/release-dependency-locks.mjs',
          'scripts/project-composer', 'server/composer.json', 'server/composer.lock',
          'web/package.json', 'web/pnpm-lock.yaml', 'platform/package.json', 'platform/package-lock.json',
          'pc/package.json', 'pc/package-lock.json', 'uniapp/package.json', 'uniapp/package-lock.json')


def fail(message):
    raise ValueError(message)


def digest(data):
    return hashlib.sha256(data).hexdigest()


def canonical(value, absent=False):
    path = Path(value)
    if not path.is_absolute() or str(path) != value or path.resolve() != path:
        fail('canonical absolute path required')
    if absent:
        if path.exists() or path.is_symlink() or not path.parent.is_dir():
            fail('checkout/output must be absent with an existing real parent')
    elif not path.exists() or path.is_symlink():
        fail('ordinary existing input required')
    return path


def separate(left, right):
    if left == right or left in right.parents or right in left.parents:
        fail('repository, checkout and output must not overlap')


def packer_module():
    # Use the trusted producer's existing canonical program inventory, not a tar bridge.
    spec = importlib.util.spec_from_file_location('fixed_git_package_files', ROOT / 'scripts/package-release-files.py')
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def approved_tools(approval):
    search = approval.get('path')
    if not isinstance(search, str) or not search or any(not Path(p).is_absolute() for p in search.split(os.pathsep)):
        fail('explicit native tool PATH required')
    entries = approval.get('tools')
    if not isinstance(entries, dict) or set(entries) != set(TOOLS):
        fail('exact native tool approval required')
    tools = {}
    for name in TOOLS:
        found = shutil.which(name, path=search)
        row = entries[name]
        if not isinstance(row, dict) or not found:
            fail('approved native tool unavailable: ' + name)
        actual = Path(found).resolve()
        if (str(actual) != row.get('path') or not actual.is_file() or not os.access(actual, os.X_OK)
                or digest(actual.read_bytes()) != row.get('sha256')):
            fail('native tool identity differs: ' + name)
        tools[name] = dict(row)
    return search, tools


def git_environment():
    # No global filters/hooks, credential helpers, URL rewriting or inherited Git overrides.
    return {'PATH': '/usr/bin:/bin', 'LANG': 'C', 'GIT_CONFIG_GLOBAL': os.devnull,
            'GIT_CONFIG_SYSTEM': os.devnull, 'GIT_CONFIG_NOSYSTEM': '1', 'GIT_TERMINAL_PROMPT': '0'}


def git(tool, root, *arguments):
    result = subprocess.run([tool, '-c', 'core.hooksPath=' + os.devnull, '-C', str(root), *arguments],
                            env=git_environment(), capture_output=True, check=True)
    return result.stdout


def source_inventory(tool, checkout, commit, tree, native):
    if (git(tool, checkout, 'rev-parse', 'HEAD').decode().strip() != commit
            or git(tool, checkout, 'rev-parse', 'HEAD^{tree}').decode().strip() != tree
            or git(tool, checkout, 'status', '--porcelain=v1', '--untracked-files=all')):
        fail('source HEAD/tree or clean state differs')
    rows = []
    for raw in git(tool, checkout, 'ls-tree', '-rz', '--full-tree', commit).split(b'\0'):
        if not raw:
            continue
        header, name = raw.split(b'\t', 1)
        mode, kind, blob = header.decode().split()
        relative = name.decode('utf-8')
        native.safe_relative(relative)
        if mode not in ('100644', '100755') or kind != 'blob':
            fail('nonregular tracked source')
        file = native.regular_file(checkout, relative)
        data = file.read_bytes()
        actual_blob = hashlib.sha1(b'blob ' + str(len(data)).encode() + b'\0' + data).hexdigest()
        if actual_blob != blob or stat.S_IMODE(file.stat().st_mode) != int(mode, 8) & 0o777:
            fail('tracked source bytes/mode differ: ' + relative)
        rows.append({'path': relative, 'blob': blob, 'sha256': digest(data), 'mode': int(mode, 8) & 0o777})
    if not rows:
        fail('empty APP Git source')
    return sorted(rows, key=lambda row: row['path'])


def program_binding(stage, manifest, source, native):
    if stage.is_symlink() or not stage.is_dir() or stage.resolve() != stage:
        fail('native directory output must be an ordinary canonical directory')
    if sorted(path.name for path in stage.iterdir()) != ['server']:
        fail('native directory output must contain only server')
    for path in stage.rglob('*'):
        if path.is_symlink() or not (path.is_dir() or path.is_file()):
            fail('nonregular prepared program path')
    identity_path = native.regular_file(stage, IDENTITY)
    identity = json.loads(identity_path.read_bytes())
    if not isinstance(identity, dict) or not isinstance(identity.get('application'), dict):
        fail('prepared program identity must be an object')
    app = identity.get('application', {})
    if (identity.get('schema_version') != 1 or identity.get('protocol') != 'peanut.server-release.v1'
            or app.get('kind') != 'application' or app.get('commit') != source['commit']
            or app.get('tree') != source['tree'] or app.get('manifest_sha256') != source['application_manifest_sha256']
            or any(app.get(key) != manifest['application'].get(key)
                   for key in ('slug', 'package_identity', 'name', 'version', 'edition', 'profile'))):
        fail('prepared program APP/source identity differs')
    declared = identity.get('files')
    native.validate_server_release_rows(declared)
    actual = [row for row in native.release_rows(stage) if row['path'] != IDENTITY]
    if declared != actual or identity.get('files_sha256') != native.rows_sha256(actual):
        fail('prepared program inventory differs')
    for row in actual:
        path = row['path']
        if (native.FORBIDDEN.intersection(Path(path).parts) or path == 'server/.env'
                or any(path.startswith(prefix) for prefix in native.PROTECTED_RUNTIME_PREFIXES)):
            fail('runtime/dependency data in prepared program')
    plugin_hash = next((row['sha256'] for row in actual if row['path'] == 'server/plugins.lock'), None)
    projection = identity.get('plugin_projection')
    if plugin_hash is None or not isinstance(projection, dict) or projection.get('projected_lock_sha256') != plugin_hash:
        fail('prepared plugin projection differs')
    static = {}
    for name in ('admin', 'platform', 'pc', 'mobile'):
        rows = [row for row in actual if row['path'].startswith(f'server/public/{name}/')]
        if not any(row['path'] == f'server/public/{name}/index.html' for row in rows):
            fail('prepared browser entry missing: ' + name)
        static[name] = {'files': len(rows), 'inventory_sha256': native.rows_sha256(rows)}
    return {'identity_path': IDENTITY, 'identity_sha256': digest(identity_path.read_bytes()),
            'files_sha256': identity['files_sha256'], 'files': len(actual), 'static': static}


def prepare(args):
    native = packer_module()
    repository = canonical(args.repository)
    checkout, output = canonical(args.checkout, True), canonical(args.output, True)
    for left, right in ((repository, checkout), (repository, output), (checkout, output)):
        separate(left, right)
    if not all(re.fullmatch(r'[a-f0-9]{40}', value) for value in (args.commit, args.tree)):
        fail('full lowercase commit/tree required; mutable refs are not inputs')
    if not args.allowed_origin or any(c in args.allowed_origin for c in '\n\r\x00'):
        fail('explicit allowed origin required')
    policy_path = canonical(args.build_inputs)
    policy_bytes = policy_path.read_bytes()
    if not re.fullmatch(r'[a-f0-9]{64}', args.expected_build_inputs_sha256) or digest(policy_bytes) != args.expected_build_inputs_sha256:
        fail('reviewed build approval digest differs')
    approval = json.loads(policy_bytes)
    if not isinstance(approval, dict) or approval.get('schema_version') != 1 or approval.get('protocol') != 'peanut.fixed-git-build-approval.v1':
        fail('native build approval protocol required')
    search, tools = approved_tools(approval)
    inputs = approval.get('inputs')
    if (not isinstance(inputs, dict) or set(inputs) != set(INPUTS)
            or not all(isinstance(v, str) and re.fullmatch(r'[a-f0-9]{64}', v) for v in inputs.values())):
        fail('complete reviewed source/build input digests required')
    git_tool = tools['git']['path']
    origins = git(git_tool, repository, 'remote', 'get-url', '--all', 'origin').decode().splitlines()
    if origins != [args.allowed_origin]:
        fail('repository origin differs from explicitly allowed origin')
    if (git(git_tool, repository, 'rev-parse', args.commit + '^{commit}').decode().strip() != args.commit
            or git(git_tool, repository, 'rev-parse', args.commit + '^{tree}').decode().strip() != args.tree):
        fail('reviewed repository commit/tree differs')
    subprocess.run([git_tool, '-c', 'core.hooksPath=' + os.devnull, 'clone', '--no-local', '--no-checkout',
                    '--no-tags', '--', str(repository), str(checkout)], env=git_environment(), check=True)
    git(git_tool, checkout, 'checkout', '--detach', args.commit)
    if git(git_tool, checkout, 'remote', 'get-url', '--all', 'origin').decode().splitlines() != [str(repository)]:
        fail('isolated checkout origin differs from reviewed local locator')
    source_rows = source_inventory(git_tool, checkout, args.commit, args.tree, native)
    by_path = {row['path']: row for row in source_rows}
    if any(by_path.get(path, {}).get('sha256') != expected for path, expected in inputs.items()):
        fail('reviewed source/build inputs differ')
    manifest = native.document(checkout, native.MANIFEST)
    app = manifest.get('application', {})
    if (manifest.get('schema_version') != 2 or manifest.get('protocol') != 'peanut.application-scaffold.v2'
            or app.get('edition') not in ('standalone', 'multi-tenant') or app.get('profile') not in ('minimal', 'standard', 'full')
            or any(not isinstance(app.get(key), str) or not app[key] for key in ('name', 'slug', 'package_identity', 'version'))
            or not native.VERSION.fullmatch(app['version'])):
        fail('independent APP manifest identity required')
    source = {'kind': 'fixed-git', 'repository': args.allowed_origin, 'commit': args.commit, 'tree': args.tree,
              'application_manifest_sha256': inputs[native.MANIFEST], 'tracked_files_sha256': digest(
                  json.dumps(source_rows, ensure_ascii=False, separators=(',', ':')).encode())}
    base = {'schema_version': 1, 'protocol': 'peanut.fixed-git-source.v1', 'source': source,
            'producer': {'entry': 'scripts/prepare-fixed-git-release', 'sha256': digest(Path(__file__).read_bytes()),
                         'inventory_validator_sha256': digest((ROOT / 'scripts/package-release-files.py').read_bytes())},
            'application': app, 'build': {'approval_sha256': args.expected_build_inputs_sha256,
                'entry': ENTRY, 'entry_sha256': inputs[ENTRY], 'inputs': inputs, 'tools': tools}}
    if args.check_only:
        return {'status': 'source-checked-not-built', **base}
    # No caller credentials, configuration, trust stores or inherited build/Git overrides.
    # Reviewed native code is trusted to execute; this adapter is not a process sandbox.
    work = Path(tempfile.mkdtemp(prefix='.fixed-git-build-', dir=output.parent))
    (work / 'home').mkdir(mode=0o700)
    (work / 'tmp').mkdir(mode=0o700)
    stage = work / 'program'
    environment = {'PATH': search, 'HOME': str(work / 'home'), 'TMPDIR': str(work / 'tmp'), 'LANG': 'C', 'TZ': 'UTC',
                   'GIT_CONFIG_GLOBAL': os.devnull, 'GIT_CONFIG_SYSTEM': os.devnull, 'GIT_CONFIG_NOSYSTEM': '1',
                   'GIT_TERMINAL_PROMPT': '0'}
    print('prepare-fixed-git-release: private build staging: ' + str(work), file=sys.stderr)
    subprocess.run([tools['bash']['path'], str(checkout / ENTRY), str(stage),
                    '--application-root=' + str(checkout), '--directory-only', '--server-only'],
                   cwd=checkout, env=environment, check=True)
    if source_inventory(git_tool, checkout, args.commit, args.tree, native) != source_rows:
        fail('source changed during native build')
    if (git(git_tool, repository, 'remote', 'get-url', '--all', 'origin').decode().splitlines() != [args.allowed_origin]
            or git(git_tool, checkout, 'remote', 'get-url', '--all', 'origin').decode().splitlines() != [str(repository)]):
        fail('repository/checkout origin changed during native build')
    if digest(policy_path.read_bytes()) != args.expected_build_inputs_sha256 or approved_tools(approval) != (search, tools):
        fail('build approval/tool identity changed')
    program = program_binding(stage, manifest, source, native)
    descriptor = {**base, 'program_root': '.', 'program': program}
    data = (json.dumps(descriptor, ensure_ascii=False, sort_keys=True, indent=2) + '\n').encode()
    # Exclusive directory reservation prevents replacing even an empty foreign output.
    # The descriptor is the last acceptance marker; partial publication is never accepted.
    output.mkdir(mode=0o755)
    os.rename(stage / 'server', output / 'server')
    fd = os.open(output / DESCRIPTOR, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o444)
    with os.fdopen(fd, 'wb') as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())
        os.fchmod(stream.fileno(), 0o444)
    directory = os.open(output, os.O_RDONLY)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)
    shutil.rmtree(work)  # Own successful empty staging/home only; failed staging is retained.
    return {'status': 'prepared-not-adopted', 'directory': str(output), 'descriptor': str(output / DESCRIPTOR),
            'descriptor_sha256': digest(data), 'source': source, 'program': program}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ('repository', 'allowed-origin', 'commit', 'tree', 'checkout', 'output', 'build-inputs', 'expected-build-inputs-sha256'):
        parser.add_argument('--' + name, required=True)
    parser.add_argument('--check-only', action='store_true', help='validate a new isolated checkout/approval; do not execute the build')
    args = parser.parse_args()
    try:
        print(json.dumps(prepare(args), ensure_ascii=False, sort_keys=True))
    except (ValueError, OSError, subprocess.SubprocessError, KeyError, TypeError) as error:
        print('prepare-fixed-git-release: ' + str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())
