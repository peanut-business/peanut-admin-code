#!/usr/bin/env python3
"""Read validated, non-secret values from the Peanut Admin resource registry."""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path
from typing import Any


REPO = Path(__file__).resolve().parent.parent
REGISTRY_PATH = REPO / "resources/project-resources.json"
SAFE_VALUE = re.compile(r"^[A-Za-z0-9._:/-]+$")


def fail(message: str) -> None:
    raise SystemExit(f"project-resource-registry: {message}")


def load_registry() -> dict[str, Any]:
    try:
        registry = json.loads(REGISTRY_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exception:
        fail(f"cannot read {REGISTRY_PATH}: {exception}")
    if registry.get("schema_version") != 1 or registry.get("project_id") != "peanut-admin":
        fail("unsupported or foreign registry")
    return registry


def database_for_target(registry: dict[str, Any], target: str) -> dict[str, Any]:
    environment = "development" if target == "local-development" else target
    matches = [
        item
        for item in registry["resources"]["databases"]
        if environment in item.get("environments", [])
        and item.get("application_runtime", True)
    ]
    if len(matches) != 1:
        fail(f"expected exactly one database for {target}, found {len(matches)}")
    return matches[0]


def database_by_id(registry: dict[str, Any], resource_id: str) -> dict[str, Any]:
    matches = [
        item
        for item in registry["resources"]["databases"]
        if item.get("stable_resource_id") == resource_id
    ]
    if len(matches) != 1:
        fail(f"expected exactly one database resource {resource_id}, found {len(matches)}")
    return matches[0]


def resource_by_id(
    registry: dict[str, Any],
    category: str,
    resource_id: str,
) -> dict[str, Any]:
    resources = registry.get("resources", {}).get(category, [])
    if not isinstance(resources, list):
        fail(f"resource category {category} is invalid")
    matches = [
        item
        for item in resources
        if isinstance(item, dict) and item.get("stable_resource_id") == resource_id
    ]
    if len(matches) != 1:
        fail(
            f"expected exactly one {category} resource {resource_id}, "
            f"found {len(matches)}"
        )
    return matches[0]


def target_environment(target: str) -> str:
    return "development" if target == "local-development" else target


def templated_database_name(database: dict[str, Any], name: str) -> str:
    template = database.get("database")
    if (
        not isinstance(template, str)
        or template.count("<run_id>") != 1
        or template.count("<scenario>") != 1
    ):
        fail("database template must contain one <run_id> and one <scenario>")
    allowed_scenarios = database.get("allowed_scenarios")
    if (
        not isinstance(allowed_scenarios, list)
        or not allowed_scenarios
        or any(not isinstance(item, str) or not item for item in allowed_scenarios)
    ):
        fail("database template scenarios are missing or invalid")
    matcher = re.escape(template)
    matcher = matcher.replace(re.escape("<run_id>"), r"(?P<run_id>.+?)")
    matcher = matcher.replace(re.escape("<scenario>"), r"(?P<scenario>.+?)")
    match = re.fullmatch(matcher, name)
    if match is None or match.group("scenario") not in allowed_scenarios:
        fail("database name is outside the registered template or scenario set")
    run_id = match.group("run_id")
    run_id_pattern = database.get("run_id_pattern")
    if not isinstance(run_id_pattern, str) or re.fullmatch(run_id_pattern, run_id) is None:
        fail("database run_id does not match the registered policy")
    max_length = database.get("database_name_max_length")
    if not isinstance(max_length, int) or max_length < 1 or len(name) > max_length:
        fail("database name exceeds the registered maximum length")
    return name


def endpoint_for_consumer(database: dict[str, Any], consumer: str) -> dict[str, Any]:
    key = "upstream_endpoint" if consumer == "host" else "container_endpoint"
    endpoint = database.get(key)
    if not isinstance(endpoint, dict) or consumer not in endpoint.get("consumers", []):
        fail(f"database {database['stable_resource_id']} has no {consumer} endpoint")
    return endpoint


def emit(values: dict[str, str | int]) -> None:
    for name, value in values.items():
        rendered = str(value)
        if not re.fullmatch(r"[A-Z][A-Z0-9_]*", name) or not SAFE_VALUE.fullmatch(rendered):
            fail(f"unsafe registry value for {name}")
        print(f"{name}={rendered}")


def local_stack_defaults(registry: dict[str, Any], target: str) -> dict[str, int]:
    values: dict[str, int] = {}
    for item in registry["resources"]["local_listeners"]:
        environment = "local-development" if item["environment"] == "development" else item["environment"]
        if environment == target:
            values[item["port_env"]] = item["port"]
    if target == "local-development":
        for item in registry["resources"].get("optional_services", []):
            if "development" in item.get("environments", []) and item.get("port_env"):
                values[item["port_env"]] = item["port"]
    if not values:
        fail(f"no listener registration for {target}")
    return values


def effective_local_stack_ports(registry: dict[str, Any], env_file: Path) -> dict[str, int]:
    if not env_file.is_absolute() or env_file.is_symlink():
        fail("local stack environment must be an absolute regular path, not a symlink")
    defaults = {
        **local_stack_defaults(registry, "local-development"),
        **local_stack_defaults(registry, "local-production-preview"),
    }
    overrides: dict[str, int] = {}
    if env_file.exists():
        if not env_file.is_file():
            fail("local stack environment is not a regular file")
        try:
            lines = env_file.read_text(encoding="utf-8").splitlines()
        except (OSError, UnicodeError):
            fail("cannot read local stack environment")
        seen: set[str] = set()
        for line in lines:
            name, separator, raw = line.partition("=")
            if not separator or name not in defaults:
                continue
            if name in seen:
                fail(f"duplicate local listener setting: {name}")
            seen.add(name)
            if raw == "":
                continue
            if not re.fullmatch(r"[1-9][0-9]*", raw) or int(raw) > 65535:
                fail(f"invalid local listener port: {name} (expected decimal 1-65535)")
            overrides[name] = int(raw)

    effective = defaults | overrides
    selected_owner: dict[str, str] = {}
    reserved_owner: dict[int, str] = {}
    for item in [
        *registry["resources"]["local_listeners"],
        *registry["resources"].get("optional_services", []),
    ]:
        port = item.get("port")
        owner = item.get("stable_resource_id")
        name = item.get("port_env")
        if isinstance(port, int) and isinstance(owner, str):
            reserved_owner[port] = owner
            if name in defaults and defaults[name] == port:
                selected_owner[name] = owner
    occupied: dict[int, str] = {}
    for name, port in effective.items():
        if port in occupied:
            fail(f"local listener port collision: {name} and {occupied[port]}")
        occupied[port] = name
        owner = reserved_owner.get(port)
        if owner is not None and owner != selected_owner.get(name):
            fail(f"local listener port reserved by another resource: {name}")
    return effective


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    database_parser = subparsers.add_parser("database-env")
    database_parser.add_argument("--deployment-target", required=True)
    database_parser.add_argument("--consumer", choices=("host", "container"), required=True)
    database_parser.add_argument("--resource-id")
    database_parser.add_argument("--database-name")

    stack_parser = subparsers.add_parser("local-stack-env")
    stack_parser.add_argument(
        "--deployment-target",
        choices=("local-development", "local-production-preview", "local-multi-tenant-demo"),
        required=True,
    )

    local_ports_parser = subparsers.add_parser("local-stack-ports")
    local_ports_parser.add_argument("--env-file", type=Path, required=True)

    qualification_parser = subparsers.add_parser("qualification-env")
    qualification_parser.add_argument("--runner-id", required=True)

    subparsers.add_parser("validate")
    args = parser.parse_args()
    registry = load_registry()

    if args.command == "validate":
        for target in ("local-development", "local-production-preview", "local-multi-tenant-demo", "production", "production-candidate", "production-restore-verification"):
            database = database_for_target(registry, target)
            endpoint_for_consumer(database, "container")
        database = database_for_target(registry, "local-development")
        endpoint_for_consumer(database, "host")
        tooling = {
            item.get("stable_resource_id"): item
            for item in registry["resources"].get("tooling", [])
        }
        expected_tooling = {
            "peanut-admin-host-php-development": ("/opt/homebrew/bin/php", "8.3.24", 20180),
            "peanut-admin-host-composer-development": ("scripts/project-composer", "2.10.2"),
        }
        for resource_id, expected in expected_tooling.items():
            command, version, *port = expected
            item = tooling.get(resource_id)
            if not isinstance(item, dict) or item.get("command") != command or item.get("version") != version:
                fail(f"tooling resource {resource_id} does not match the fixed contract")
            if port and item.get("port") != port[0]:
                fail(f"tooling resource {resource_id} does not use registered port {port[0]}")
        expected_ports = {
            "DEV_HTTP_PORT": 20187,
            "PHP_PORT": 20180,
            "VITE_PORT": 20181,
            "PLATFORM_PORT": 20177,
            "MOBILE_PORT": 20182,
            "PC_PORT": 20185,
            "DOCS_PORT": 20186,
            "HTTP_PORT": 20190,
            "P0E_DB_TUNNEL_PORT": 20189,
            "MT_DEMO_PHP_PORT": 20178,
            "MT_DEMO_VITE_PORT": 20179,
            "MT_DEMO_PLATFORM_PORT": 20176,
        }
        listeners = registry["resources"].get("local_listeners", [])
        if not isinstance(listeners, list):
            fail("local listener registry is invalid")
        resource_ids: set[str] = set()
        claimed_ports: set[int] = set()
        for item in listeners:
            resource_id = item.get("stable_resource_id")
            port = item.get("port")
            if (
                not isinstance(resource_id, str)
                or not resource_id
                or resource_id in resource_ids
                or not isinstance(port, int)
                or port < 1
                or port > 65535
                or port in claimed_ports
                or not isinstance(item.get("environment"), str)
                or not item.get("environment")
                or not isinstance(item.get("owner"), str)
                or not item.get("owner")
                or item.get("fallback") != "none"
            ):
                fail(f"local listener registration is invalid: {resource_id}")
            resource_ids.add(resource_id)
            claimed_ports.add(port)
        for port_env, expected_port in expected_ports.items():
            matches = [item for item in listeners if item.get("port_env") == port_env]
            if len(matches) != 1 or matches[0].get("port") != expected_port:
                fail(
                    f"fixed local listener {port_env} does not use registered port "
                    f"{expected_port}"
                )
        redis = [
            item
            for item in registry["resources"].get("optional_services", [])
            if item.get("stable_resource_id") == "peanut-admin-local-redis-experiment"
        ]
        if len(redis) != 1 or redis[0].get("port_env") != "REDIS_PORT" or redis[0].get("port") != 20184:
            fail("optional Redis does not reserve the fixed project port 20184")
        print(f"registry={REGISTRY_PATH}")
        print("status=valid")
        return 0

    values: dict[str, str | int] = {}
    if args.command == "database-env":
        if args.resource_id is None:
            if args.database_name is not None:
                fail("--database-name requires an explicit --resource-id")
            database = database_for_target(registry, args.deployment_target)
            selected_database_name = database["database"]
        else:
            database = database_by_id(registry, args.resource_id)
            environment = target_environment(args.deployment_target)
            if environment not in database.get("environments", []):
                fail(
                    f"database resource {args.resource_id} is not registered for "
                    f"{args.deployment_target}"
                )
            database_template = database.get("database")
            is_templated = (
                isinstance(database_template, str)
                and ("<run_id>" in database_template or "<scenario>" in database_template)
            )
            if is_templated:
                if args.database_name is None:
                    fail("templated database resource requires an exact --database-name")
                selected_database_name = templated_database_name(database, args.database_name)
            else:
                if args.database_name is not None:
                    fail("database name override is allowed only for a templated resource")
                if not isinstance(database_template, str) or database_template == "":
                    fail("database resource has no fixed database name")
                selected_database_name = database_template
        endpoint = endpoint_for_consumer(database, args.consumer)
        values = {
            "PEANUT_DATABASE_RESOURCE_ID": database["stable_resource_id"],
            "PEANUT_DATABASE_ENDPOINT_ID": endpoint["endpoint_id"],
            "PEANUT_DATABASE_CONSUMER": args.consumer,
            "DB_HOST": endpoint["host"],
            "DB_PORT": endpoint["port"],
            "DB_NAME": selected_database_name,
        }
    if args.command == "local-stack-env":
        values = local_stack_defaults(registry, args.deployment_target)
    if args.command == "local-stack-ports":
        values = effective_local_stack_ports(registry, args.env_file)
    if args.command == "qualification-env":
        runner = resource_by_id(registry, "tooling", args.runner_id)
        if (
            "qualification" not in runner.get("environments", [])
            or runner.get("fallback") != "none"
            or not isinstance(runner.get("compose_project"), str)
            or not isinstance(runner.get("candidate_worktree"), str)
            or not isinstance(runner.get("output_root"), str)
        ):
            fail(f"qualification runner {args.runner_id} is invalid")

        listener_ids = runner.get("listener_resource_ids")
        if not isinstance(listener_ids, list) or len(listener_ids) != 6:
            fail(f"qualification runner {args.runner_id} must register six listeners")
        listeners = {
            listener_id: resource_by_id(registry, "local_listeners", listener_id)
            for listener_id in listener_ids
        }
        port_values: dict[str, int] = {}
        for listener_id, listener in listeners.items():
            port = listener.get("port")
            port_env = listener.get("port_env")
            if (
                listener.get("environment") != "qualification"
                or listener.get("namespace") != runner["compose_project"]
                or not isinstance(port, int)
                or not isinstance(port_env, str)
            ):
                fail(f"qualification listener {listener_id} is invalid")
            for name in [port_env, *listener.get("additional_port_envs", [])]:
                if not isinstance(name, str) or name in port_values:
                    fail(f"qualification listener env {name} is invalid or duplicated")
                port_values[name] = port

        required_port_envs = {
            "MYSQL_PORT",
            "DB_PORT",
            "CACHE_PORT",
            "PEANUT_BROWSER_BACKEND_PORT",
            "PEANUT_BROWSER_FRONTEND_PORT",
            "PEANUT_STARTER_BACKEND_PORT",
            "PEANUT_STARTER_FRONTEND_PORT",
        }
        if set(port_values) != required_port_envs:
            fail(f"qualification runner {args.runner_id} has an incomplete port matrix")

        expected_tool_ids = {
            "peanut-admin-core-php83-cli",
            "peanut-admin-core-composer-2.10.2-cli",
            "peanut-admin-core-node24-pnpm11-cli",
            "peanut-admin-core-ripgrep15-cli",
            "peanut-admin-core-docker29-cli",
        }
        tool_ids = runner.get("tool_resource_ids")
        if not isinstance(tool_ids, list) or set(tool_ids) != expected_tool_ids:
            fail(f"qualification runner {args.runner_id} has an incomplete tool matrix")
        tools = {
            tool_id: resource_by_id(registry, "tooling", tool_id)
            for tool_id in tool_ids
        }
        path_parts = [
            str(Path(tools["peanut-admin-core-composer-2.10.2-cli"]["namespace"]).parent),
            tools["peanut-admin-core-node24-pnpm11-cli"]["namespace"],
            str(Path(tools["peanut-admin-core-php83-cli"]["command"]).parent),
            str(Path(tools["peanut-admin-core-ripgrep15-cli"]["namespace"]).parent),
            str(Path(tools["peanut-admin-core-docker29-cli"]["command"]).parent),
            "/usr/bin",
            "/bin",
            "/usr/sbin",
            "/sbin",
        ]
        values = {
            "PEANUT_QUALIFICATION_RUNNER_ID": args.runner_id,
            "PEANUT_QUALIFICATION_WORKTREE": runner["candidate_worktree"],
            "PEANUT_QUALIFICATION_OUTPUT_ROOT": runner["output_root"],
            "COMPOSE_PROJECT_NAME": runner["compose_project"],
            **port_values,
            "PATH": ":".join(dict.fromkeys(path_parts)),
        }
    emit(values)
    return 0


if __name__ == "__main__":
    sys.exit(main())
