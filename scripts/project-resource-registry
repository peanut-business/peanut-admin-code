#!/usr/bin/env python3
"""Read validated, non-secret values from the Peanut Admin resource registry."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import Any


REPO = Path(__file__).resolve().parent.parent
REGISTRY_PATH = Path(os.environ.get("PEANUT_RESOURCE_REGISTRY") or REPO / "resources/project-resources.json")
SAFE_VALUE = re.compile(r"^[A-Za-z0-9._:/-]+$")


def fail(message: str) -> None:
    raise SystemExit(f"project-resource-registry: {message}")


def maintainer_git(root: Path, *arguments: str) -> bytes:
    env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
    env["GIT_OPTIONAL_LOCKS"] = "0"
    result = subprocess.run(["/usr/bin/git", "-C", str(root), *arguments], capture_output=True, check=False, env=env)
    if result.returncode != 0 or result.stderr.strip():
        fail("P0-E maintainer source Git identity is unavailable")
    return result.stdout


def maintainer_project() -> Path:
    """Logical registered Project, independent of the selected physical registry."""
    git = maintainer_git
    common = Path(git(REPO, "rev-parse", "--path-format=absolute", "--git-common-dir").decode().strip()).resolve()
    primary = common.parent
    if (common.name != ".git" or primary.name != "peanut-admin-code"
            or Path(git(primary, "rev-parse", "--show-toplevel").decode().strip()).resolve() != primary):
        fail("P0-E primary checkout mapping is invalid")
    project = primary.parent / "peanut-admin-project"
    if (project.is_symlink() or Path(git(project, "rev-parse", "--show-toplevel").decode().strip()).resolve() != project
            or Path(git(project, "rev-parse", "--path-format=absolute", "--git-common-dir").decode().strip()).resolve() != project / ".git"):
        fail("P0-E Project checkout identity is invalid")
    head = git(project, "rev-parse", "HEAD").strip()
    if (git(project, "branch", "--show-current").strip() != b"dev"
            or git(project, "rev-parse", "refs/heads/dev").strip() != head
            or git(project, "rev-parse", "refs/remotes/origin/dev").strip() != head):
        fail("P0-E Project authority must be the current delivered primary dev")
    return project


def maintainer_source(expected_sha256: str) -> Path:
    """Resolve exact current Project bytes in its primary or registered worktree."""
    git = maintainer_git

    if re.fullmatch(r"[0-9a-f]{64}", expected_sha256) is None:
        fail("P0-E registry SHA-256 is invalid")
    project = maintainer_project()
    primary = project.parent / "peanut-admin-code"
    target = REGISTRY_PATH
    selected = target.parent.parent
    mapping = selected / "repos.yaml"
    head = git(project, "rev-parse", "HEAD").strip()
    if (not target.is_absolute() or target.resolve() != target or target.is_symlink()
            or target != selected / "resources/project-resources.json"
            or mapping.is_symlink() or not mapping.is_file() or not target.is_file()
            or Path(git(selected, "rev-parse", "--show-toplevel").decode().strip()).resolve() != selected
            or Path(git(selected, "rev-parse", "--path-format=absolute", "--git-common-dir").decode().strip()).resolve() != project / ".git"
            or git(selected, "rev-parse", "HEAD").strip() != head):
        fail("P0-E registry must belong to the current registered Project worktree")
    registered = [row[9:] for row in git(project, "worktree", "list", "--porcelain", "-z").split(b"\0") if row.startswith(b"worktree ")]
    if os.fsencode(selected) not in registered:
        fail("P0-E Project worktree is not registered")
    if selected != project and git(selected, "status", "--porcelain=v1", "--untracked-files=all"):
        fail("P0-E selected Project worktree must be clean")
    mapping_bytes = mapping.read_bytes()
    if git(project, "show", "HEAD:repos.yaml") != mapping_bytes:
        fail("P0-E repository mapping is not the tracked HEAD content")
    text = mapping_bytes.decode("utf-8")
    if re.search(r"^schema_version: 3$", text, re.M) is None or re.search(r"^project_id: peanut-admin$", text, re.M) is None:
        fail("P0-E repository mapping schema is invalid")
    for role, root, identity in [("project", project, "peanut-admin-project"), ("application", primary, "peanut-admin-code")]:
        blocks = re.findall(r"^  " + role + r":\n((?:    [^\n]*\n)+)", text, re.M)
        if len(blocks) != 1:
            fail("P0-E repository mapping role is ambiguous")
        ids = re.findall(r"^    repository_id: ([^\s]+)$", blocks[0], re.M)
        remotes = re.findall(r"^    remote: ([^\s]+)$", blocks[0], re.M)
        if ids != [identity] or len(remotes) != 1 or root.name != identity:
            fail("P0-E repository mapping identity is invalid")
        expected_remote = f"https://github.com/peanut-business/{identity}.git"
        actual_remote = git(root, "remote", "get-url", "origin").decode().strip()
        if remotes[0] != expected_remote or actual_remote not in (
            expected_remote, f"git@github.com:peanut-business/{identity}.git",
        ):
            fail("P0-E repository origin disagrees with the tracked mapping")
    contents = target.read_bytes()
    if (git(project, "show", "HEAD:resources/project-resources.json") != contents
            or git(selected, "diff", "--cached", "--name-only", "HEAD", "--", "repos.yaml", "resources/project-resources.json")):
        fail("P0-E registry must be the exact tracked Project HEAD content")
    if hashlib.sha256(contents).hexdigest() != expected_sha256:
        fail("P0-E registry changed from its fixed SHA-256")
    if maintainer_project() != project or git(project, "rev-parse", "HEAD").strip() != head:
        fail("P0-E Project authority changed during source resolution")
    return target.resolve()


def load_registry() -> dict[str, Any]:
    if not REGISTRY_PATH.is_absolute() or REGISTRY_PATH.is_symlink():
        fail("PEANUT_RESOURCE_REGISTRY must be an absolute, non-symlink file")
    try:
        registry = json.loads(REGISTRY_PATH.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exception:
        fail(f"cannot read {REGISTRY_PATH}: {exception}")
    if registry.get("schema_version") != 1 or not isinstance(registry.get("project_id"), str) or not registry["project_id"]:
        fail("unsupported or foreign registry")
    if not isinstance(registry.get("resources"), dict) or not isinstance(registry.get("authority"), dict):
        fail("resource registry structure is invalid")
    role = registry.get("authority", {}).get("role")
    if role not in {"application", "maintainer"}:
        fail("resource registry must declare application or maintainer role")
    if role == "maintainer" and not os.environ.get("PEANUT_RESOURCE_REGISTRY"):
        fail("maintainer registry requires an explicit PEANUT_RESOURCE_REGISTRY path")
    if role == "application" and not any(
        (isinstance(group, list) and group)
        or (isinstance(group, dict) and group.get("resources"))
        for group in registry.get("resources", {}).values()
    ):
        fail("application registry is unallocated; register this application's resources before use")
    return registry


def validate_application_registry(registry: dict[str, Any]) -> None:
    resources = registry.get("resources")
    if not isinstance(resources, dict):
        fail("application resource groups are invalid")
    seen: set[str] = set()
    for category in ("tooling", "databases", "local_listeners", "containers", "optional_services", "external_services", "backups"):
        group = resources.get(category)
        if not isinstance(group, list):
            fail(f"application resource group {category} is invalid")
        for item in group:
            resource_id = item.get("stable_resource_id") if isinstance(item, dict) else None
            if not isinstance(resource_id, str) or not resource_id or resource_id in seen:
                fail(f"application resource ID is missing or duplicated: {resource_id}")
            seen.add(resource_id)
    ports: set[int] = set()
    for item in resources["local_listeners"]:
        port = item.get("port")
        if not isinstance(port, int) or port < 1 or port > 65535 or port in ports:
            fail("application listener port is invalid or duplicated")
        ports.add(port)


def database_for_target(registry: dict[str, Any], target: str) -> dict[str, Any]:
    environment = "development" if target == "local-development" else target
    matches = [
        item
        for item in registry["resources"]["databases"]
        if environment in item.get("environments", [])
        and item.get("application_runtime", True)
    ]
    if len(matches) != 1:
        fail(f"expected exactly one database for {target}, found {len(matches)}")
    return matches[0]


def database_by_id(registry: dict[str, Any], resource_id: str) -> dict[str, Any]:
    matches = [
        item
        for item in registry["resources"]["databases"]
        if item.get("stable_resource_id") == resource_id
    ]
    if len(matches) != 1:
        fail(f"expected exactly one database resource {resource_id}, found {len(matches)}")
    return matches[0]


def resource_by_id(
    registry: dict[str, Any],
    category: str,
    resource_id: str,
) -> dict[str, Any]:
    resources = registry.get("resources", {}).get(category, [])
    if not isinstance(resources, list):
        fail(f"resource category {category} is invalid")
    matches = [
        item
        for item in resources
        if isinstance(item, dict) and item.get("stable_resource_id") == resource_id
    ]
    if len(matches) != 1:
        fail(
            f"expected exactly one {category} resource {resource_id}, "
            f"found {len(matches)}"
        )
    return matches[0]


def target_environment(target: str) -> str:
    return "development" if target == "local-development" else target


def templated_database_name(database: dict[str, Any], name: str) -> str:
    template = database.get("database")
    if (
        not isinstance(template, str)
        or template.count("<run_id>") != 1
        or template.count("<scenario>") != 1
    ):
        fail("database template must contain one <run_id> and one <scenario>")
    allowed_scenarios = database.get("allowed_scenarios")
    if (
        not isinstance(allowed_scenarios, list)
        or not allowed_scenarios
        or any(not isinstance(item, str) or not item for item in allowed_scenarios)
    ):
        fail("database template scenarios are missing or invalid")
    matcher = re.escape(template)
    matcher = matcher.replace(re.escape("<run_id>"), r"(?P<run_id>.+?)")
    matcher = matcher.replace(re.escape("<scenario>"), r"(?P<scenario>.+?)")
    match = re.fullmatch(matcher, name)
    if match is None or match.group("scenario") not in allowed_scenarios:
        fail("database name is outside the registered template or scenario set")
    run_id = match.group("run_id")
    run_id_pattern = database.get("run_id_pattern")
    if not isinstance(run_id_pattern, str) or re.fullmatch(run_id_pattern, run_id) is None:
        fail("database run_id does not match the registered policy")
    max_length = database.get("database_name_max_length")
    if not isinstance(max_length, int) or max_length < 1 or len(name) > max_length:
        fail("database name exceeds the registered maximum length")
    return name


def endpoint_for_consumer(database: dict[str, Any], consumer: str) -> dict[str, Any]:
    key = "upstream_endpoint" if consumer == "host" else "container_endpoint"
    endpoint = database.get(key)
    if not isinstance(endpoint, dict) or consumer not in endpoint.get("consumers", []):
        fail(f"database {database['stable_resource_id']} has no {consumer} endpoint")
    return endpoint


def emit(values: dict[str, str | int]) -> None:
    for name, value in values.items():
        rendered = str(value)
        if not re.fullmatch(r"[A-Z][A-Z0-9_]*", name) or not SAFE_VALUE.fullmatch(rendered):
            fail(f"unsafe registry value for {name}")
        print(f"{name}={rendered}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    p0e_source_parser = subparsers.add_parser("p0e-maintainer-source")
    p0e_source_parser.add_argument("--sha256", required=True)
    maintainer_source_parser = subparsers.add_parser("maintainer-source")
    maintainer_source_parser.add_argument("--sha256", required=True)

    database_parser = subparsers.add_parser("database-env")
    database_parser.add_argument("--deployment-target", required=True)
    database_parser.add_argument("--consumer", choices=("host", "container"), required=True)
    database_parser.add_argument("--resource-id")
    database_parser.add_argument("--database-name")

    qualification_parser = subparsers.add_parser("qualification-env")
    qualification_parser.add_argument("--runner-id", required=True)

    application_parser = subparsers.add_parser("application-registry")
    application_parser.add_argument("--resource-id", required=True)
    application_parser.add_argument("--application-registry", type=Path, required=True)

    validate_parser = subparsers.add_parser("validate")
    validate_parser.add_argument("--resource-id")
    validate_parser.add_argument("--deployment-target")
    validate_parser.add_argument("--consumer", choices=("host", "container"))
    args = parser.parse_args()
    registry = load_registry()

    if args.command in ("p0e-maintainer-source", "maintainer-source"):
        source = maintainer_source(args.sha256)
        if registry["authority"]["role"] != "maintainer":
            fail("P0-E registry must declare the maintainer role")
        print(source)
        return 0

    if args.command == "application-registry":
        if registry["authority"]["role"] != "maintainer":
            fail("application registry projection requires the explicit maintainer registry")
        source = args.application_registry
        if not source.is_absolute() or source.is_symlink():
            fail("application registry input must be an absolute, non-symlink file")
        try:
            application = json.loads(source.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as exception:
            fail(f"cannot read application registry input: {exception}")
        if (not isinstance(application, dict)
            or application.get("schema_version") != 1
            or not isinstance(application.get("project_id"), str)
            or not application["project_id"]
            or not isinstance(application.get("authority"), dict)
            or application.get("authority", {}).get("role") != "application"
            or not isinstance(application.get("resources"), dict)
            or not isinstance(application["resources"].get("databases"), list)):
            fail("application registry input identity or shape is invalid")
        manifest_path = source.parent.parent / ".peanut/application-manifest.json"
        if manifest_path.exists() or manifest_path.is_symlink():
            if not manifest_path.is_file() or manifest_path.is_symlink():
                fail("application manifest identity is invalid")
            try:
                manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError):
                fail("application manifest identity is invalid")
            if not isinstance(manifest, dict) or not isinstance(manifest.get("application"), dict) or manifest["application"].get("slug") != application["project_id"]:
                fail("application registry does not match the generated APP slug")
        database = dict(resource_by_id(registry, "databases", args.resource_id))
        if "<run_id>" in str(database.get("database")) or "<scenario>" in str(database.get("database")):
            fail("templated maintainer database requires a fixed lease-bound projection")
        database.pop("credential_ref", None)
        projected = {
            "schema_version": 1,
            "project_id": application["project_id"],
            "authority": {
                "owner": application["authority"].get("owner", "application owner"),
                "role": "application",
                "source": "selected versioned maintainer resource for this application instance",
                "resource_id": args.resource_id,
            },
            "resources": {key: ([database] if key == "databases" else [] if isinstance(value, list) else {"status": "unallocated", "resources": []})
                          for key, value in application["resources"].items()},
        }
        print(json.dumps(projected, ensure_ascii=False, indent=2))
        return 0

    if args.command == "validate":
        scope_arguments = (args.resource_id, args.deployment_target, args.consumer)
        scoped = any(value is not None for value in scope_arguments)
        if scoped and any(value is None for value in scope_arguments):
            fail("scoped validate requires --resource-id, --deployment-target and --consumer together")
        if registry["authority"]["role"] == "application":
            validate_application_registry(registry)
            if not scoped:
                print(f"registry={REGISTRY_PATH}")
                print("status=structure-valid")
                return 0
        if scoped:
            database = database_by_id(registry, args.resource_id)
            environments = database.get("environments")
            if (not isinstance(environments, list)
                or any(not isinstance(value, str) or not value for value in environments)
                or target_environment(args.deployment_target) not in environments):
                fail(f"database resource {args.resource_id} is not registered for {args.deployment_target}")
            name = database.get("database")
            if (not isinstance(name, str) or not name
                or "<run_id>" in name or "<scenario>" in name
                or not isinstance(database.get("owner"), str) or not database["owner"].strip()
                or database.get("service_type") != "mysql" or database.get("fallback") != "none"):
                fail("selected database requires a fixed schema, owner, MySQL service and explicit no-fallback contract")
            endpoint = endpoint_for_consumer(database, args.consumer)
            if (not isinstance(endpoint.get("endpoint_id"), str) or not endpoint["endpoint_id"].strip()
                or not isinstance(endpoint.get("host"), str) or not endpoint["host"].strip()
                or type(endpoint.get("port")) is not int or not 1 <= endpoint["port"] <= 65535):
                fail("selected database endpoint identity, host or port is invalid")
            scope_values = {
                "PEANUT_DATABASE_RESOURCE_ID": database["stable_resource_id"],
                "PEANUT_DEPLOYMENT_TARGET": args.deployment_target,
                "PEANUT_DATABASE_CONSUMER": args.consumer,
                "PEANUT_DATABASE_ENDPOINT_ID": endpoint["endpoint_id"],
            }
            # This result covers only the explicitly selected database and
            # endpoint. Unrelated tooling/listeners remain the default full
            # validation's responsibility and cannot turn this into a full pass.
            print(f"registry={REGISTRY_PATH}")
            emit(scope_values)
            print("status=database-scope-valid")
            return 0
        else:
            # Default full-registry validation retains its original ambiguity
            # rejection and endpoint requirements. A selected scope is explicit.
            for target in ("local-development", "local-production-preview", "local-multi-tenant-demo", "production", "production-candidate", "production-restore-verification"):
                database = database_for_target(registry, target)
                endpoint_for_consumer(database, "container")
            database = database_for_target(registry, "local-development")
            endpoint_for_consumer(database, "host")
        tooling = {
            item.get("stable_resource_id"): item
            for item in registry["resources"].get("tooling", [])
        }
        expected_tooling = {
            "peanut-admin-host-php-development": ("/opt/homebrew/bin/php", "8.3.24", 20180),
            "peanut-admin-host-composer-development": ("scripts/project-composer", "2.10.2"),
        }
        for resource_id, expected in expected_tooling.items():
            command, version, *port = expected
            item = tooling.get(resource_id)
            if not isinstance(item, dict) or item.get("command") != command or item.get("version") != version:
                fail(f"tooling resource {resource_id} does not match the fixed contract")
            if port and item.get("port") != port[0]:
                fail(f"tooling resource {resource_id} does not use registered port {port[0]}")
        expected_ports = {
            "DEV_HTTP_PORT": 20187,
            "PHP_PORT": 20180,
            "VITE_PORT": 20181,
            "PLATFORM_PORT": 20177,
            "MOBILE_PORT": 20182,
            "PC_PORT": 20185,
            "DOCS_PORT": 20186,
            "HTTP_PORT": 20190,
            "P0E_DB_TUNNEL_PORT": 20189,
            "MT_DEMO_PHP_PORT": 20178,
            "MT_DEMO_VITE_PORT": 20179,
            "MT_DEMO_PLATFORM_PORT": 20176,
        }
        listeners = registry["resources"].get("local_listeners", [])
        if not isinstance(listeners, list):
            fail("local listener registry is invalid")
        resource_ids: set[str] = set()
        claimed_ports: set[int] = set()
        for item in listeners:
            resource_id = item.get("stable_resource_id")
            port = item.get("port")
            if (
                not isinstance(resource_id, str)
                or not resource_id
                or resource_id in resource_ids
                or not isinstance(port, int)
                or port < 1
                or port > 65535
                or port in claimed_ports
                or not isinstance(item.get("environment"), str)
                or not item.get("environment")
                or not isinstance(item.get("owner"), str)
                or not item.get("owner")
                or item.get("fallback") != "none"
            ):
                fail(f"local listener registration is invalid: {resource_id}")
            resource_ids.add(resource_id)
            claimed_ports.add(port)
        for port_env, expected_port in expected_ports.items():
            matches = [item for item in listeners if item.get("port_env") == port_env]
            if len(matches) != 1 or matches[0].get("port") != expected_port:
                fail(
                    f"fixed local listener {port_env} does not use registered port "
                    f"{expected_port}"
                )
        redis = [
            item
            for item in registry["resources"].get("optional_services", [])
            if item.get("stable_resource_id") == "peanut-admin-local-redis-experiment"
        ]
        if len(redis) != 1 or redis[0].get("port_env") != "REDIS_PORT" or redis[0].get("port") != 20184:
            fail("optional Redis does not reserve the fixed project port 20184")
        print(f"registry={REGISTRY_PATH}")
        print("status=valid")
        return 0

    values: dict[str, str | int] = {}
    if args.command == "database-env":
        if args.resource_id is None:
            if args.database_name is not None:
                fail("--database-name requires an explicit --resource-id")
            database = database_for_target(registry, args.deployment_target)
            selected_database_name = database["database"]
        else:
            database = database_by_id(registry, args.resource_id)
            environment = target_environment(args.deployment_target)
            if environment not in database.get("environments", []):
                fail(
                    f"database resource {args.resource_id} is not registered for "
                    f"{args.deployment_target}"
                )
            database_template = database.get("database")
            is_templated = (
                isinstance(database_template, str)
                and ("<run_id>" in database_template or "<scenario>" in database_template)
            )
            if is_templated:
                if args.database_name is None:
                    fail("templated database resource requires an exact --database-name")
                selected_database_name = templated_database_name(database, args.database_name)
            else:
                if args.database_name is not None:
                    fail("database name override is allowed only for a templated resource")
                if not isinstance(database_template, str) or database_template == "":
                    fail("database resource has no fixed database name")
                selected_database_name = database_template
        endpoint = endpoint_for_consumer(database, args.consumer)
        values = {
            "PEANUT_DEPLOYMENT_TARGET": args.deployment_target,
            "PEANUT_DATABASE_RESOURCE_ID": database["stable_resource_id"],
            "PEANUT_DATABASE_ENDPOINT_ID": endpoint["endpoint_id"],
            "PEANUT_DATABASE_CONSUMER": args.consumer,
            "DB_HOST": endpoint["host"],
            "DB_PORT": endpoint["port"],
            "DB_NAME": selected_database_name,
        }
    if args.command == "qualification-env":
        runner = resource_by_id(registry, "tooling", args.runner_id)
        if (
            "qualification" not in runner.get("environments", [])
            or runner.get("fallback") != "none"
            or not isinstance(runner.get("compose_project"), str)
            or not isinstance(runner.get("candidate_worktree"), str)
            or not isinstance(runner.get("output_root"), str)
        ):
            fail(f"qualification runner {args.runner_id} is invalid")

        listener_ids = runner.get("listener_resource_ids")
        if not isinstance(listener_ids, list) or len(listener_ids) != 6:
            fail(f"qualification runner {args.runner_id} must register six listeners")
        listeners = {
            listener_id: resource_by_id(registry, "local_listeners", listener_id)
            for listener_id in listener_ids
        }
        port_values: dict[str, int] = {}
        for listener_id, listener in listeners.items():
            port = listener.get("port")
            port_env = listener.get("port_env")
            if (
                listener.get("environment") != "qualification"
                or listener.get("namespace") != runner["compose_project"]
                or not isinstance(port, int)
                or not isinstance(port_env, str)
            ):
                fail(f"qualification listener {listener_id} is invalid")
            for name in [port_env, *listener.get("additional_port_envs", [])]:
                if not isinstance(name, str) or name in port_values:
                    fail(f"qualification listener env {name} is invalid or duplicated")
                port_values[name] = port

        required_port_envs = {
            "MYSQL_PORT",
            "DB_PORT",
            "CACHE_PORT",
            "PEANUT_BROWSER_BACKEND_PORT",
            "PEANUT_BROWSER_FRONTEND_PORT",
            "PEANUT_STARTER_BACKEND_PORT",
            "PEANUT_STARTER_FRONTEND_PORT",
        }
        if set(port_values) != required_port_envs:
            fail(f"qualification runner {args.runner_id} has an incomplete port matrix")

        expected_tool_ids = {
            "peanut-admin-core-php83-cli",
            "peanut-admin-core-composer-2.10.2-cli",
            "peanut-admin-core-node24-pnpm11-cli",
            "peanut-admin-core-ripgrep15-cli",
            "peanut-admin-core-docker29-cli",
        }
        tool_ids = runner.get("tool_resource_ids")
        if not isinstance(tool_ids, list) or set(tool_ids) != expected_tool_ids:
            fail(f"qualification runner {args.runner_id} has an incomplete tool matrix")
        tools = {
            tool_id: resource_by_id(registry, "tooling", tool_id)
            for tool_id in tool_ids
        }
        path_parts = [
            str(Path(tools["peanut-admin-core-composer-2.10.2-cli"]["namespace"]).parent),
            tools["peanut-admin-core-node24-pnpm11-cli"]["namespace"],
            str(Path(tools["peanut-admin-core-php83-cli"]["command"]).parent),
            str(Path(tools["peanut-admin-core-ripgrep15-cli"]["namespace"]).parent),
            str(Path(tools["peanut-admin-core-docker29-cli"]["command"]).parent),
            "/usr/bin",
            "/bin",
            "/usr/sbin",
            "/sbin",
        ]
        values = {
            "PEANUT_QUALIFICATION_RUNNER_ID": args.runner_id,
            "PEANUT_QUALIFICATION_WORKTREE": runner["candidate_worktree"],
            "PEANUT_QUALIFICATION_OUTPUT_ROOT": runner["output_root"],
            "COMPOSE_PROJECT_NAME": runner["compose_project"],
            **port_values,
            "PATH": ":".join(dict.fromkeys(path_parts)),
        }
    emit(values)
    return 0


if __name__ == "__main__":
    sys.exit(main())
