#!/usr/bin/env node

import { execFileSync } from 'node:child_process'
import { createHash } from 'node:crypto'
import { isAbsolute, join } from 'node:path'
import { isDeepStrictEqual } from 'node:util'
import { fileURLToPath } from 'node:url'
import { readFileSync, writeFileSync } from 'node:fs'
import { dependencyMode, verifyDependencyLocks, lockedYamlParser } from './release-dependency-locks.mjs'
import { readTemplateArtifacts, verifyTemplateArtifacts } from './release-template-artifacts.mjs'

// 解析锁的工具依赖来自当前可信检查器，不从被检查候选加载执行代码。
const toolRoot = fileURLToPath(new URL('..', import.meta.url))
const prereleaseRequiredGroups = [
  'generated-application',
  'standalone-fresh',
  'multi-tenant-fresh',
  'production-compose',
]

const options = {
  tag: '', candidate: '', qualification: '', remote: '', writeLock: '', requireMain: false,
  staticOnly: false, templateArtifacts: '', releaseEvidence: '', prerelease: false,
}
const args = process.argv.slice(2)
for (let index = 0; index < args.length;) {
  const argument = args[index]
  const value = args[index + 1]
  if (argument === '--require-main') {
    options.requireMain = true
    index += 1
    continue
  }
  if (argument === '--static-only') {
    options.staticOnly = true
    index += 1
    continue
  }
  if (argument === '--prerelease') {
    options.prerelease = true
    index += 1
    continue
  }
  if (argument === '--help' || argument === '-h') {
    console.log(`Usage:
  scripts/check-release-consistency --candidate <full-commit> --qualification <summary.json> [--prerelease] [--require-main]
  scripts/check-release-consistency --tag vX.Y.Z [--qualification <summary.json>] [--remote origin]
      [--write-lock <absolute-file>] [--prerelease] --template-artifacts <absolute-build-root>
  scripts/check-release-consistency --static-only [--template-artifacts <absolute-build-root>]
      [--release-evidence <absolute-file>]

The candidate mode is the pre-tag release preflight. The tag mode verifies the
immutable release identity. Stable tag mode accepts only vX.Y.Z. Prerelease tag
mode must be explicit with --prerelease and accepts only strict
vX.Y.Z-<prerelease>. --require-main is the final-release gate and
requires the candidate to be the current origin/main commit. --write-lock
requires qualification evidence and creates an external, non-self-referential
candidate lock. --static-only without evidence is the development check: it
reports unpublished Core/lock/scaffold closure as pending. With supplied seal
evidence it validates that evidence strictly. It performs no publication and
never establishes release readiness.`)
    process.exit(0)
  }
  if (argument === '--tag' && value) options.tag = value
  else if (argument === '--candidate' && value) options.candidate = value
  else if (argument === '--qualification' && value) options.qualification = value
  else if (argument === '--remote' && value) options.remote = value
  else if (argument === '--write-lock' && value) options.writeLock = value
  else if (argument === '--template-artifacts' && value) options.templateArtifacts = value
  else if (argument === '--release-evidence' && value) options.releaseEvidence = value
  else {
    console.error(`check-release-consistency: unknown or incomplete argument: ${argument}`)
    process.exit(64)
  }
  index += 2
}

if (!options.staticOnly && (options.tag === '') === (options.candidate === '')) {
  console.error('check-release-consistency: choose exactly one of --tag or --candidate')
  process.exit(64)
}
if (options.staticOnly && (options.tag || options.candidate || options.qualification || options.remote || options.writeLock || options.requireMain)) {
  console.error('check-release-consistency: --static-only cannot run candidate, tag, remote, qualification or lock gates')
  process.exit(64)
}
if (!options.staticOnly && options.releaseEvidence) {
  console.error('check-release-consistency: Edition and release evidence inputs are only valid with --static-only')
  process.exit(64)
}
if (options.prerelease && !options.tag && !options.candidate) {
  console.error('check-release-consistency: --prerelease is only valid with --tag or --candidate')
  process.exit(64)
}
for (const path of [options.templateArtifacts, options.releaseEvidence].filter(Boolean)) {
  if (!isAbsolute(path)) {
    console.error('check-release-consistency: static evidence paths must be absolute')
    process.exit(64)
  }
}
const stableTagPattern = /^v\d+\.\d+\.\d+$/
const prereleaseIdentifier = '(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)'
const prereleaseTagPattern = new RegExp(`^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)-${prereleaseIdentifier}(?:\\.${prereleaseIdentifier})*$`)
if (options.tag && options.prerelease && !prereleaseTagPattern.test(options.tag)) {
  console.error('check-release-consistency: --prerelease tag must be strict annotated semver such as v2.1.4-rc.1')
  process.exit(64)
}
if (options.tag && !options.prerelease && !stableTagPattern.test(options.tag)) {
  console.error('check-release-consistency: --tag must be an annotated stable tag such as v2.1.4')
  process.exit(64)
}
if (options.candidate && !/^[0-9a-f]{40}$/.test(options.candidate)) {
  console.error('check-release-consistency: --candidate must be a full lowercase commit SHA')
  process.exit(64)
}
if (options.candidate && !options.qualification) {
  console.error('check-release-consistency: --candidate requires --qualification; use --static-only for structural checks')
  process.exit(64)
}
if (options.writeLock && (!options.qualification || !isAbsolute(options.writeLock))) {
  console.error('check-release-consistency: --write-lock requires --qualification and an absolute output path')
  process.exit(64)
}
if (options.requireMain && !options.candidate) {
  console.error('check-release-consistency: --require-main is only valid with --candidate')
  process.exit(64)
}

const git = (command) => execFileSync('git', command, { encoding: 'utf8' }).trim()
const gitOptional = (command) => {
  try { return git(command) } catch { return '' }
}
const gitSucceeds = (command) => {
  try { execFileSync('git', command, { stdio: 'ignore' }); return true } catch { return false }
}
const sha256 = (value) => createHash('sha256').update(value).digest('hex')
const versionCompare = (left, right) => {
  const leftParts = left.split('-', 1)[0].split('.').map(Number)
  const rightParts = right.split('-', 1)[0].split('.').map(Number)
  for (let index = 0; index < 3; index += 1) {
    if (leftParts[index] !== rightParts[index]) return leftParts[index] - rightParts[index]
  }
  return 0
}
const failures = []
const reference = options.staticOnly ? 'working-tree' : (options.tag || options.candidate)

// Daily development may name the next product version before its Core packages
// exist in public registries.  Keep this no-evidence static check structural and
// report release-only closure as pending; candidate/tag modes below remain strict.
if (options.staticOnly && !options.templateArtifacts && !options.releaseEvidence) {
  const pending = []
  const developmentFailures = []
  const readJson = (path) => {
    try { return JSON.parse(readFileSync(path, 'utf8')) }
    catch (error) { developmentFailures.push(`${path} is invalid: ${error.message}`); return {} }
  }
  const versions = readJson('release-versions.json')
  const metadata = readJson('RELEASE_METADATA.json')
  const inventory = readJson('scaffold/application-template-inventory.json')
  const fixture = readJson('server/tests/fixtures/p0e-runtime-qualification/matrix.json')
  const target = versions.source_product_version ?? ''
  const baseline = metadata.source_product_version ?? ''
  const stableVersion = /^\d+\.\d+\.\d+$/
  const strictSemver = /^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$/
  const currentV3 = versions.schema_version === 3 && versions.protocol === 'peanut.release-versions.v3'
  if (!currentV3 || !strictSemver.test(target) || versions.instance_version !== null
    || versions.scaffold_template !== target) developmentFailures.push('development version contract is invalid')
  let dependencyIdentity = null
  try {
    const mode = dependencyMode(versions)
    dependencyIdentity = verifyDependencyLocks(versions, path => readFileSync(path),
      mode === 'registry' ? lockedYamlParser(toolRoot) : undefined)
  } catch (error) { developmentFailures.push(error.message) }
  if (![2, 3].includes(metadata.schema_version) || metadata.protocol !== `peanut.release-metadata.v${metadata.schema_version}`
    || !stableVersion.test(baseline) || metadata.instance_version !== null
    || metadata.expected_tag !== `v${baseline}` || versionCompare(baseline, target) > 0) {
    developmentFailures.push('published release metadata is invalid or newer than the development target')
  }

  pending.push(dependencyIdentity?.mode === 'registry'
    ? 'public channel availability and four native frozen installs/builds remain required'
    : 'four clean client installs and builds must qualify the fixed Core Web candidate tarballs')
  if (baseline !== target) pending.push(`release metadata ${baseline} -> ${target} during candidate sealing`)
  if (inventory.template_version !== target) pending.push(`application inventory -> ${target}`)
  if (fixture.target_release?.version !== target) pending.push(`P0-E fixture -> ${target}`)
  pending.push(`two exact-source native template builds for v${target}`)
  if (!(readFileSync('CHANGELOG.md', 'utf8')).includes(`## [${target}]`)) pending.push(`CHANGELOG ${target} section`)

  if (developmentFailures.length) {
    console.error('check-release-consistency: FAIL development working-tree')
    developmentFailures.forEach((failure) => console.error(`- ${failure}`))
    process.exit(1)
  }
  console.log(JSON.stringify({
    status: 'passed',
    mode: 'development-static',
    dependency_identity: dependencyIdentity,
    target_version: target,
    published_baseline: baseline,
    release_dependency_closure: pending.length === 0 ? 'closed' : 'pending',
    product_release_ready: false,
    pending,
    limitation: 'Development validation does not publish Core packages, rewrite locks, qualify a candidate, create a tag, or publish a Release.',
  }, null, 2))
  process.exit(0)
}

if (options.tag && gitOptional(['cat-file', '-t', options.tag]) !== 'tag') {
  failures.push(`tag is not annotated: ${options.tag}`)
}

let commit = ''
let tree = ''
let metadataText = ''
let versionContractText = ''
let inventoryText = ''
let scaffoldText = ''
let fixtureText = ''
let metadata = null
let versionContract = null
let inventory = null
let scaffold = null
let fixture = null
let version = ''
let declaredCorePhp = ''
let declaredCoreWeb = ''
let declaredClientVersions = {}
let declaredClientCoreVersions = {}
let lockedCoreVersions = {}
let staticEditionEvidence = { complete: false, editions: [], manifests: [] }
let staticReleaseEvidence = { supplied: false, valid: false }
let templateInputs = null

const show = (path) => options.staticOnly
  ? readFileSync(path, 'utf8')
  : execFileSync('git', ['show', `${reference}:${path}`], {
      encoding: 'utf8',
      maxBuffer: 64 * 1024 * 1024,
    })
try {
  commit = git(['rev-parse', options.staticOnly ? 'HEAD' : `${reference}^{commit}`])
  tree = git(['rev-parse', options.staticOnly ? 'HEAD^{tree}' : `${reference}^{tree}`])
  if (options.candidate && commit !== options.candidate) failures.push('candidate commit identity changed')
  if (options.requireMain) {
    const mainCommit = gitOptional(['rev-parse', 'origin/main^{commit}'])
    if (!mainCommit) failures.push('origin/main is unavailable for the final-release gate')
    else if (mainCommit !== commit) failures.push(`candidate is not the current origin/main commit (origin/main=${mainCommit})`)
  }
  metadataText = show('RELEASE_METADATA.json')
  versionContractText = show('release-versions.json')
  inventoryText = show('scaffold/application-template-inventory.json')
  metadata = JSON.parse(metadataText)
  versionContract = JSON.parse(versionContractText)
  inventory = JSON.parse(inventoryText)
  version = [2, 3].includes(metadata.schema_version) && metadata.protocol === `peanut.release-metadata.v${metadata.schema_version}`
    ? (metadata.instance_version ?? metadata.source_product_version ?? '')
    : (metadata.version ?? '')
  if (!options.templateArtifacts) throw new Error('--template-artifacts is required for sealed candidate checks')
  scaffoldText = readFileSync(join(options.templateArtifacts, 'standalone/scaffold-manifest.json'), 'utf8')
  fixtureText = show('server/tests/fixtures/p0e-runtime-qualification/matrix.json')
  scaffold = JSON.parse(scaffoldText)
  fixture = JSON.parse(fixtureText)
  templateInputs = readTemplateArtifacts({ root: options.templateArtifacts, version, commit, tree,
    inventorySha256: sha256(inventoryText) })
  declaredCorePhp = JSON.parse(show('server/composer.json'))?.require?.['peanut-admin/core'] ?? ''
  for (const client of ['web', 'platform', 'pc', 'uniapp']) {
    const packageJson = JSON.parse(show(`${client}/package.json`))
    declaredClientVersions[client] = packageJson?.version ?? ''
    declaredClientCoreVersions[client] = packageJson?.dependencies?.['@peanut-admin/admin'] ?? ''
  }
  declaredCoreWeb = declaredClientCoreVersions.web
  const composerLock = JSON.parse(show('server/composer.lock'))
  lockedCoreVersions.composer = composerLock?.packages?.find((pkg) => pkg?.name === 'peanut-admin/core')?.version ?? ''
  const webCoreLock = show('web/pnpm-lock.yaml').match(/      '@peanut-admin\/admin':\n        specifier: ([^\n]+)\n        version: ([^\n(]+)/)
  lockedCoreVersions.webSpecifier = webCoreLock?.[1] ?? ''
  lockedCoreVersions.web = webCoreLock?.[2] ?? ''
  for (const client of ['platform', 'pc', 'uniapp']) {
    const packageLock = JSON.parse(show(`${client}/package-lock.json`))
    lockedCoreVersions[client] = packageLock?.packages?.['node_modules/@peanut-admin/admin']?.version ?? ''
    lockedCoreVersions[`${client}Specifier`] = packageLock?.packages?.['']?.dependencies?.['@peanut-admin/admin'] ?? ''
  }
} catch (error) {
  failures.push(`candidate contents are unreadable: ${error.message}`)
}

const expectedTag = `v${version}`
const strictSemver = /^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$/
const stableReleaseVersion = /^\d+\.\d+\.\d+$/
const prereleaseReleaseVersion = /^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*$/
const expectedReleaseVersion = options.prerelease ? prereleaseReleaseVersion : stableReleaseVersion
const historicalV1 = options.tag && versionContract?.schema_version === 1
  && versionContract?.protocol === 'peanut.release-versions.v1'
const currentV2 = versionContract?.schema_version === 2
  && versionContract?.protocol === 'peanut.release-versions.v2'
  && versionContract?.instance_version === null
const currentV3 = versionContract?.schema_version === 3
  && versionContract?.protocol === 'peanut.release-versions.v3'
  && versionContract?.instance_version === null
const currentContract = currentV2 || currentV3
const contractProductVersion = currentContract
  ? versionContract?.source_product_version
  : historicalV1 ? versionContract?.product_release : ''
const metadataCurrent = [2, 3].includes(metadata?.schema_version)
  && metadata?.protocol === `peanut.release-metadata.v${metadata?.schema_version}`
const metadataSourceVersion = metadataCurrent ? metadata?.source_product_version : null
const metadataInstanceVersion = metadataCurrent ? metadata?.instance_version : null
const metadataReleaseVersion = metadataCurrent
  ? (metadataInstanceVersion ?? metadataSourceVersion ?? '')
  : (metadata?.version ?? '')
if (versionContract && ((!historicalV1 && !currentContract)
  || !expectedReleaseVersion.test(contractProductVersion ?? '')
  || contractProductVersion !== (currentContract ? metadataSourceVersion : metadataReleaseVersion)
  || versionContract.scaffold_template !== inventory?.template_version
  || (currentContract && versionContract.generated_instance_default !== inventory?.application?.version)
  || (currentContract && !strictSemver.test(versionContract.generated_instance_default ?? ''))
  || (currentV2 && (versionContract.core_php !== contractProductVersion
    || versionContract.core_web !== contractProductVersion
    || versionContract.scaffold_template !== contractProductVersion
    || declaredCorePhp !== contractProductVersion
    || declaredCoreWeb !== contractProductVersion
    || Object.values(declaredClientVersions).some((value) => value !== contractProductVersion)
    || Object.values(declaredClientCoreVersions).some((value) => value !== contractProductVersion)
    || Object.values(lockedCoreVersions).some((value) => value !== contractProductVersion)
    || metadata?.public_runtime_dependencies?.composer !== `peanut-admin/core@${contractProductVersion}`
    || metadata?.public_runtime_dependencies?.web_npm !== `@peanut-admin/admin@${contractProductVersion}`
    || metadata?.public_runtime_dependencies?.platform_npm !== `@peanut-admin/admin@${contractProductVersion}`
    || metadata?.public_runtime_dependencies?.pc_npm !== `@peanut-admin/admin@${contractProductVersion}`
    || metadata?.public_runtime_dependencies?.uniapp_npm !== `@peanut-admin/admin@${contractProductVersion}`)))) {
  failures.push('release version contract does not match metadata and inventory')
}
if (currentContract && (!metadataCurrent
    || metadataSourceVersion !== versionContract?.source_product_version
    || metadataInstanceVersion !== versionContract?.instance_version
    || metadataReleaseVersion !== version)) {
  failures.push('release metadata does not preserve the source product and root instance identities')
}
if (currentV3) {
  try {
    if (dependencyMode(versionContract) !== 'registry') throw new Error('formal V3 candidate requires fixed native registry identities')
    if (!options.prerelease && (!stableReleaseVersion.test(versionContract.core_php.constraint)
      || Object.values(versionContract.core_web.packages).some(identity => !stableReleaseVersion.test(identity.version)))) {
      throw new Error('stable product releases require stable Core PHP and Core Web versions')
    }
    verifyDependencyLocks(versionContract, path => Buffer.from(show(path)), lockedYamlParser(toolRoot))
    if (versionContract.scaffold_template !== contractProductVersion
      || Object.values(declaredClientVersions).some(value => value !== contractProductVersion)
      || JSON.stringify(metadata?.public_runtime_dependencies?.composer) !== JSON.stringify(versionContract.core_php)
      || JSON.stringify(metadata?.public_runtime_dependencies?.npm) !== JSON.stringify(versionContract.core_web)) {
      throw new Error('V3 metadata or client product identity does not match the fixed dependency contract')
    }
  } catch (error) { failures.push(error.message) }
}
if (!expectedReleaseVersion.test(version)) failures.push(`metadata version is invalid for ${options.prerelease ? 'prerelease' : 'stable'} mode: ${version || 'missing'}`)
if (metadata && metadata.expected_tag !== expectedTag) failures.push(`metadata expected_tag does not match ${expectedTag}`)
if (options.tag && options.tag !== expectedTag) failures.push(`tag ${options.tag} does not match embedded version ${version}`)
for (const [path, expected] of Object.entries({
  ...(metadata?.lockfiles ?? {}),
  ...(metadata?.legal_files ?? {}),
})) {
  try {
    const actual = sha256(show(path))
    if (actual !== expected) failures.push(`${path} digest ${expected} does not match candidate ${actual}`)
  } catch (error) {
    failures.push(`${path} is unreadable: ${error.message}`)
  }
}

if (scaffold && inventory && fixture) {
  const release = scaffold.release ?? {}
  if (release.version !== version) failures.push(`scaffold release version ${release.version ?? 'missing'} does not match ${version}`)
  if (inventory.template_version !== version) failures.push(`inventory template version ${inventory.template_version ?? 'missing'} does not match ${version}`)
  if (release.source_commit !== commit || release.source_tree !== tree || release.inventory_sha256 !== sha256(inventoryText)) {
    failures.push('native templates must use the final candidate commit/tree/inventory')
  }
}

if (options.staticOnly) {
  if (templateInputs) {
    staticEditionEvidence = { complete: true, editions: Object.keys(templateInputs.editions).sort(),
      templates: templateInputs, archive_members: 'not_checked', native_projection: 'not_checked' }
  }

  if (options.releaseEvidence) {
    staticReleaseEvidence.supplied = true
    try {
      const evidence = JSON.parse(readFileSync(options.releaseEvidence, 'utf8'))
      const qualification = evidence.technical_qualification ?? {}
      const qualificationStatusValid = options.prerelease
        ? ['passed', 'partial-passed'].includes(qualification.status)
        : qualification.status === 'passed'
      staticReleaseEvidence.valid = evidence.schema_version === 1
        && evidence.product === metadata?.product
        && evidence.version === contractProductVersion
        && evidence.tag === expectedTag
        && evidence.commit === commit
        && qualificationStatusValid
        && templateInputs !== null && isDeepStrictEqual(evidence.template_artifacts, templateInputs)
      if (!staticReleaseEvidence.valid) failures.push('static release evidence is incomplete or belongs to another candidate')
    } catch (error) {
      failures.push(`static release evidence is unreadable: ${error.message}`)
    }
  }
}

try {
  if (!show('CHANGELOG.md').includes(`## [${version}]`)) failures.push(`CHANGELOG.md has no ${version} release section`)
} catch (error) {
  failures.push(`CHANGELOG.md is unreadable: ${error.message}`)
}

let qualification = null
let qualificationText = ''
if (options.qualification) {
  try {
    if (!isAbsolute(options.qualification)) throw new Error('qualification path must be absolute')
    qualificationText = readFileSync(options.qualification, 'utf8')
    qualification = JSON.parse(qualificationText)
    const expectedStatuses = options.prerelease ? ['passed', 'partial-passed'] : ['passed']
    if (!expectedStatuses.includes(qualification.status)) {
      failures.push(`qualification status is ${qualification.status ?? 'missing'}`)
    }
    if (qualification.candidate !== commit) failures.push(`qualification commit ${qualification.candidate ?? 'missing'} does not match candidate ${commit}`)
    if (qualification.candidate_tree !== tree) failures.push(`qualification tree ${qualification.candidate_tree ?? 'missing'} does not match candidate tree ${tree}`)
    if (!templateInputs || !isDeepStrictEqual(qualification.template_artifacts, templateInputs)) {
      failures.push('qualification does not bind the exact two-Edition native template artifacts')
    }
    const requiredGroups = options.prerelease ? prereleaseRequiredGroups : (fixture?.groups ?? [])
    if (options.prerelease && qualification.status === 'partial-passed'
      && !['selected-groups', 'through-group'].includes(qualification.scope)) {
      failures.push(`prerelease qualification scope is invalid: ${qualification.scope ?? 'missing'}`)
    }
    if (!options.prerelease && qualification.scope !== 'full') {
      failures.push(`stable qualification scope is ${qualification.scope ?? 'missing'} instead of full`)
    }
    if (options.prerelease && qualification.status === 'partial-passed') {
      const minimum = qualification.minimum_release_gate ?? {}
      if (minimum.protocol !== 'peanut.minimum-release-gate.v1'
        || minimum.candidate !== commit || minimum.candidate_tree !== tree
        || minimum.release_version !== version
        || minimum.ready_for_first_prerelease !== true
        || minimum.full_p0e_passed !== false
        || minimum.startup_health !== 'passed'
        || minimum.business?.standalone?.status !== 'passed'
        || minimum.business?.['multi-tenant']?.status !== 'passed'
        || minimum.upgrade_retention?.status !== 'reused'
        || !/^[a-f0-9]{64}$/.test(minimum.upgrade_retention?.evidence_sha256 ?? '')
        || !Array.isArray(minimum.artifacts) || minimum.artifacts.length !== 4
        || minimum.artifacts.some(item => !/^[a-f0-9]{64}$/.test(item.sha256 ?? ''))) {
        failures.push('prerelease Minimum Release Gate receipt is incomplete or belongs to another candidate')
      }
    }
    for (const group of requiredGroups) {
      if (qualification.groups?.[group]?.status !== 'passed') failures.push(`qualification group is not passed: ${group}`)
    }
    const cleanup = qualification.cleanup ?? {}
    for (const field of ['database_residual_count', 'container_residual_count', 'volume_residual_count', 'network_residual_count', 'image_residual_count', 'listener_residual_count']) {
      if (cleanup[field] !== 0) failures.push(`qualification cleanup ${field} is ${cleanup[field] ?? 'missing'}`)
    }
    if (cleanup.lease_released !== true) failures.push('qualification resource lease was not released')
  } catch (error) {
    failures.push(`qualification evidence is unreadable: ${error.message}`)
  }
}

if (options.remote && options.tag && commit) {
  try {
    const remoteTagObject = git(['ls-remote', '--tags', options.remote, `refs/tags/${options.tag}`]).split(/\s+/)[0] ?? ''
    const remoteCommit = git(['ls-remote', '--tags', options.remote, `refs/tags/${options.tag}^{}`]).split(/\s+/)[0] ?? ''
    const localTagObject = git(['rev-parse', `${options.tag}^{tag}`])
    if (remoteTagObject !== localTagObject || remoteCommit !== commit) failures.push(`local and ${options.remote} tag identities differ`)
  } catch (error) {
    failures.push(`remote tag preflight failed for ${options.remote}: ${error.message}`)
  }
}

if (failures.length > 0) {
  console.error(`check-release-consistency: FAIL ${reference}`)
  for (const failure of failures) console.error(`- ${failure}`)
  process.exit(1)
}

if (!options.staticOnly) {
  try {
    verifyTemplateArtifacts({ root: options.templateArtifacts, version, commit, tree,
      inventorySha256: sha256(inventoryText) }, toolRoot)
  } catch (error) {
    console.error(`check-release-consistency: native template check failed: ${error.message}`)
    process.exit(1)
  }
}

if (options.staticOnly) {
  const pending = []
  if (!staticEditionEvidence.complete) pending.push('two same-candidate native template manifests')
  if (!staticReleaseEvidence.valid) pending.push('sealed passed qualification and publication evidence')
  console.log(JSON.stringify({
    status: 'passed',
    mode: 'static-only',
    source_product_version: contractProductVersion,
    instance_version: versionContract?.instance_version ?? null,
    edition_evidence: staticEditionEvidence,
    release_evidence: staticReleaseEvidence,
    product_release_ready: false,
    pending,
    limitation: 'Static validation does not verify signatures, run qualification, approve dev-to-main, inspect a remote Release, or publish.',
  }, null, 2))
  process.exit(0)
}

if (options.writeLock) {
  const lock = {
    schema_version: 1,
    protocol: 'peanut.release-candidate-lock.v1',
    product: metadata.product,
    version,
    tag: expectedTag,
    candidate: { commit, tree },
    template_artifacts: templateInputs,
    qualification: {
      status: qualification.status,
      scope: qualification.scope,
      run_id: qualification.run_id,
      summary_sha256: sha256(qualificationText),
      planned_groups: qualification.planned_groups,
      groups: Object.fromEntries((fixture.groups ?? []).map((group) => [
        group,
        qualification.groups?.[group]?.status ?? 'not-run',
      ])),
      cleanup: qualification.cleanup,
    },
    inputs: {
      release_metadata_sha256: sha256(metadataText),
      version_contract_sha256: sha256(versionContractText),
      application_template_inventory_sha256: sha256(inventoryText),
      template_artifacts_sha256: sha256(JSON.stringify(templateInputs)),
      p0e_fixture_sha256: sha256(fixtureText),
    },
  }
  writeFileSync(options.writeLock, `${JSON.stringify(lock, null, 2)}\n`, { flag: 'wx', mode: 0o600 })
}

console.log(`check-release-consistency: PASS ${reference} commit=${commit} tree=${tree}`)
