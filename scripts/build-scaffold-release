#!/usr/bin/env php
<?php

declare(strict_types=1);

use app\common\infrastructure\scaffold\ReleaseDependencyIdentity;

const RELEASE_PRODUCT_TOKEN = 'Scaffold Product Token';
const RELEASE_SLUG_TOKEN = 'scaffold-product-token';
const RELEASE_PACKAGE_TOKEN = 'scaffold-vendor-token/scaffold-package-token';
const RELEASE_APPLICATION_VERSION_TOKEN = '999999.999999.999999';
const RELEASE_STRICT_SEMVER = '/^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$/D';

function releaseUsage(): never
{
    fwrite(STDERR, "Usage: php scripts/build-scaffold-release --version=<semver> (--source-commit=<full-sha>|--source-snapshot=<absolute-directory>) --output=<absolute-directory> [--work-root=<absolute-operation-directory>] [--edition=standalone|multi-tenant] [--workflow=none|runtime|full] [--internal-core-inputs=<absolute-release-core-inputs.json>] [--api-tool-root=<absolute-tool-root>] [--check]\n");
    exit(64);
}

$root = dirname(__DIR__);
$options = [];
$check = false;
foreach (array_slice($argv, 1) as $argument) {
    if ($argument === '--check') {
        $check = true;
        continue;
    }
    if (preg_match('/^--(version|source-commit|source-snapshot|tool-root|work-root|output|edition|workflow|internal-core-inputs|api-tool-root)=(.+)$/D', $argument, $matches) !== 1 || isset($options[$matches[1]])) {
        releaseUsage();
    }
    $options[$matches[1]] = $matches[2];
}
if (isset($options['tool-root'])) {
    if (!str_starts_with($options['tool-root'], '/') || !is_dir($options['tool-root']) || is_link($options['tool-root'])) { releaseUsage(); }
    $root = realpath($options['tool-root']);
}
require_once $root . '/server/vendor/autoload.php';
foreach (['version','output'] as $required) {
    if (!isset($options[$required])) {
        releaseUsage();
    }
}
if (preg_match(RELEASE_STRICT_SEMVER, $options['version']) !== 1) {
    releaseUsage();
}
if ((!isset($options['source-snapshot']) && (!isset($options['source-commit']) || preg_match('/^[a-f0-9]{40}$/D', $options['source-commit']) !== 1))
    || (isset($options['source-snapshot']) && (isset($options['source-commit']) || !str_starts_with($options['source-snapshot'], '/') || !is_dir($options['source-snapshot'])))
    || !str_starts_with($options['output'], '/')
    || (isset($options['api-tool-root']) && !str_starts_with($options['api-tool-root'], '/'))
    || (isset($options['edition']) && !in_array($options['edition'], ['standalone', 'multi-tenant'], true))
    || (isset($options['workflow']) && !in_array($options['workflow'], ['none', 'runtime', 'full'], true))) {
    releaseUsage();
}
if (isset($options['internal-core-inputs'])) {
    if ($check || !isset($options['edition']) || !str_starts_with($options['internal-core-inputs'], '/')) {
        releaseUsage();
    }
    releaseInputFile($options['internal-core-inputs']);
}

// A normal build can only create the currently declared scaffold template.
// Historical releases are still checked from their immutable artifact below;
// their source commits predate the current release-versions contract and must
// not be rejected merely because the current template version is newer.
if (!$check) {
    $contractRoot = isset($options['source-snapshot']) ? realpath($options['source-snapshot']) : $root;
    if (file_exists($options['output']) || is_link($options['output'])) {
        throw new RuntimeException('SCAFFOLD_RELEASE_OUTPUT_EXISTS');
    }
    try {
        $contract = json_decode((string) file_get_contents($contractRoot . '/release-versions.json'), true, 64, JSON_THROW_ON_ERROR);
        if (($contract['schema_version'] ?? null) !== 3
            || ($contract['protocol'] ?? null) !== 'peanut.release-versions.v3'
            || !array_key_exists('instance_version', $contract)
            || $contract['instance_version'] !== null
            || ($contract['scaffold_template'] ?? null) !== ($contract['source_product_version'] ?? null)
            || ($contract['source_product_version'] ?? null) !== $options['version']) {
            releaseUsage();
        }
    } catch (Throwable) {
        releaseUsage();
    }
} else {
    $existingManifestPath = rtrim($options['output'], '/') . '/scaffold-manifest.json';
    try {
        $existing = json_decode((string) file_get_contents($existingManifestPath), true, 512, JSON_THROW_ON_ERROR);
        if (($existing['release']['version'] ?? null) !== $options['version']) {
            releaseUsage();
        }
    } catch (Throwable) {
        releaseUsage();
    }
}

function releaseRun(array $command, ?string $cwd = null, array $environment = []): string
{
    $pipes = [];
    $process = proc_open($command, [1 => ['pipe','w'],2 => ['pipe','w']], $pipes, $cwd,
        $environment === [] ? null : array_replace(getenv(), $environment));
    if (!is_resource($process)) {
        throw new RuntimeException('SCAFFOLD_RELEASE_PROCESS_FAILED');
    }
    $stdout = stream_get_contents($pipes[1]);
    $stderr = stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);
    if (proc_close($process) !== 0 || !is_string($stdout)) {
        throw new RuntimeException('SCAFFOLD_RELEASE_COMMAND_FAILED: ' . trim((string) $stderr));
    }
    return $stdout;
}
function releaseDelete(string $path): void
{
    if (is_dir($path) && !is_link($path)) {
        foreach (array_diff(scandir($path) ?: [], ['.','..']) as $entry) {
            releaseDelete($path . '/' . $entry);
        }rmdir($path);
        return;
    }
    if (file_exists($path) || is_link($path)) {
        unlink($path);
    }
}
function releaseWrite(string $path, string $content, int $mode): void
{
    if (!is_dir(dirname($path)) && !mkdir(dirname($path), 0775, true)) {
        throw new RuntimeException('SCAFFOLD_RELEASE_DIRECTORY_FAILED');
    }
    if (file_put_contents($path, $content) === false || !chmod($path, $mode)) {
        throw new RuntimeException('SCAFFOLD_RELEASE_WRITE_FAILED');
    }
}
function releaseOwner(string $path): string
{
    if (str_starts_with($path, 'server/')) {
        return 'backend';
    }
    if (str_starts_with($path, 'web/') || str_starts_with($path, 'pc/') || str_starts_with($path, 'uniapp/') || str_starts_with($path, 'docs-site/')) {
        return 'frontend';
    }
    return 'host';
}
function releaseAssertTracked(string $root, string $path): void
{
    $relative = substr($path, strlen($root) + 1);
    if ($relative === $path) {
        throw new RuntimeException('SCAFFOLD_RELEASE_OUTPUT_OUTSIDE_REPOSITORY');
    }
    releaseRun(['git','-C',$root,'ls-files','--error-unmatch','--',$relative]);
}

/** Encode derived source metadata with the producer's existing write primitive. */
function releaseWriteJson(string $path, array $data, int $mode = 0644): void
{
    releaseWrite($path, json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n", $mode);
}

function releaseCopyFile(string $source, string $target, int $mode = 0644): void
{
    if (!is_file($source) || is_link($source)) {
        throw new RuntimeException('SCAFFOLD_RELEASE_INPUT_FILE_INVALID: ' . $source);
    }
    if (file_exists($target) || is_link($target)) {
        throw new RuntimeException('SCAFFOLD_RELEASE_OUTPUT_EXISTS: ' . $target);
    }
    if ((!is_dir(dirname($target)) && !mkdir(dirname($target), 0775, true))
        || !copy($source, $target)
        || !chmod($target, $mode)) {
        throw new RuntimeException('SCAFFOLD_RELEASE_COPY_FAILED: ' . $target);
    }
}

/** Require a fixed regular input without filesystem aliases or hard links. */
function releaseInputFile(string $path): void
{
    if ($path === '' || $path[0] !== '/' || str_contains($path, '\\') || str_contains($path, "\0")) {
        throw new RuntimeException('SCAFFOLD_RELEASE_PATH_INVALID');
    }
    $current = '';
    $parts = explode('/', substr($path, 1));
    foreach ($parts as $index => $part) {
        if ($part === '' || $part === '.' || $part === '..') {
            throw new RuntimeException('SCAFFOLD_RELEASE_PATH_INVALID');
        }
        $current .= '/' . $part;
        clearstatcache(true, $current);
        if (is_link($current)) {
            throw new RuntimeException('SCAFFOLD_RELEASE_PATH_LINK_REJECTED');
        }
        if (!file_exists($current)) {
            throw new RuntimeException('SCAFFOLD_RELEASE_PATH_MISSING');
        }
        if ($index < count($parts) - 1 && !is_dir($current)) {
            throw new RuntimeException('SCAFFOLD_RELEASE_PATH_PARENT_INVALID');
        }
    }
    $stat = stat($path);
    if (!is_file($path) || !is_array($stat) || $stat['nlink'] !== 1) {
        throw new RuntimeException('SCAFFOLD_RELEASE_INPUT_FILE_INVALID');
    }
}

function releaseReadJson(string $path): array
{
    releaseInputFile($path);
    $data = json_decode((string) file_get_contents($path), true, 512, JSON_THROW_ON_ERROR);
    if (!is_array($data)) {
        throw new RuntimeException('SCAFFOLD_RELEASE_JSON_INVALID: ' . $path);
    }
    return $data;
}

function releaseCoreInputs(string $path): array
{
    $inputs = releaseReadJson($path);
    $root = dirname($path);
    $archive = $inputs['core_php_archive'] ?? null;
    $core = $inputs['core_php'] ?? null;
    $repository = $inputs['composer_repository']['package'] ?? null;
    $local = ($core['source_type'] ?? null) === 'local';
    $identity = $core['source_identity'] ?? null;
    $web = $inputs['core_web'] ?? null;
    $webIdentity = is_array($web) ? ($web['source_identity'] ?? null) : null;
    $localIdentityValid = is_array($identity) && array_keys($identity) === ['kind', 'snapshot_sha256']
        && ($identity['kind'] ?? null) === 'local'
        && preg_match('/^[a-f0-9]{64}$/D', (string) ($identity['snapshot_sha256'] ?? '')) === 1
        && is_array($webIdentity) && array_keys($webIdentity) === ['kind', 'snapshot_sha256']
        && ($webIdentity['kind'] ?? null) === 'local'
        && preg_match('/^[a-f0-9]{64}$/D', (string) ($webIdentity['snapshot_sha256'] ?? '')) === 1
        && ($inputs['sources']['php'] ?? null) === $identity
        && ($inputs['sources']['web'] ?? null) === $webIdentity;
    if (!is_array($archive) || !is_array($core) || !is_array($repository)
        || ($inputs['status'] ?? null) !== 'frozen-core-build-inputs-not-product-release'
        || ($core['package'] ?? null) !== 'peanut-admin/core'
        || ($repository['name'] ?? null) !== 'peanut-admin/core') {
        throw new RuntimeException('SCAFFOLD_RELEASE_CORE_INPUTS_INVALID');
    }
    $relative = (string) ($archive['path'] ?? '');
    if ($relative === '' || str_starts_with($relative, '/') || str_contains($relative, '\\') || in_array('..', explode('/', $relative), true)) {
        throw new RuntimeException('SCAFFOLD_RELEASE_CORE_ARCHIVE_PATH_INVALID');
    }
    $zip = $root . '/' . $relative;
    releaseInputFile($zip);
    if (!is_file($zip) || is_link($zip)) {
        throw new RuntimeException('SCAFFOLD_RELEASE_CORE_ARCHIVE_MISSING');
    }
    $sha256 = hash_file('sha256', $zip);
    $sha1 = hash_file('sha1', $zip);
    $originValid = $local
        ? ($localIdentityValid && ($repository['dist']['reference'] ?? null) === $identity['snapshot_sha256']
            && !isset($repository['source']) && ($core['source_identity'] ?? null) === $identity
            && ($web['source_type'] ?? null) === 'local' && ($web['source_identity'] ?? null) === $webIdentity)
        : (($core['source_type'] ?? null) === 'git'
            && ($repository['dist']['reference'] ?? null) === ($core['source_reference'] ?? null)
            && ($repository['source']['reference'] ?? null) === ($core['source_reference'] ?? null)
            && ($inputs['sources']['php']['commit'] ?? null) === ($core['source_reference'] ?? null)
            && ($web['source_type'] ?? null) === 'git'
            && ($inputs['sources']['web']['commit'] ?? null) === ($web['source_reference'] ?? null));
    if (!is_string($sha256) || !hash_equals((string) ($archive['sha256'] ?? ''), $sha256)
        || !is_string($sha1) || !hash_equals((string) ($archive['sha1'] ?? ''), $sha1)
        || ($repository['dist']['shasum'] ?? null) !== $sha1
        || ($repository['version'] ?? null) !== ($core['resolved_version'] ?? null)
        || ($repository['dist']['type'] ?? null) !== 'zip'
        || ($repository['dist']['url'] ?? null) !== '../' . $relative || !$originValid) {
        throw new RuntimeException('SCAFFOLD_RELEASE_CORE_ARCHIVE_IDENTITY_INVALID');
    }
    return [
        'inputs' => $inputs,
        'archive_absolute' => $zip,
        'archive_relative' => $relative,
        'archive_sha256' => $sha256,
        'archive_sha1' => $sha1,
        'package' => $repository,
        'local' => $local,
        'source_identity' => $identity,
    ];
}

function releaseProjectComposer(string $application, array $corePackage, string $constraint): void
{
    $path = $application . '/server/composer.json';
    $composer = releaseReadJson($path);
    if (($composer['require']['peanut-admin/core'] ?? null) === null) {
        throw new RuntimeException('SCAFFOLD_RELEASE_CORE_REQUIRE_MISSING');
    }
    $composer['require']['peanut-admin/core'] = $constraint;
    $existing = is_array($composer['repositories'] ?? null) ? $composer['repositories'] : [];
    $repositories = [[
        'type' => 'package',
        'package' => $corePackage,
    ]];
    foreach ($existing as $repository) {
        if (!is_array($repository) || ($repository['type'] ?? null) === 'path') {
            throw new RuntimeException('SCAFFOLD_RELEASE_COMPOSER_REPOSITORY_UNSUPPORTED');
        }
        if (($repository['url'] ?? null) === 'https://github.com/peanut-business/peanut-admin-core-php.git') {
            continue;
        }
        $repositories[] = $repository;
    }
    $composer['repositories'] = $repositories;
    releaseWriteJson($path, $composer);
}

function releaseLockPackage(string $lockPath): array
{
    $lock = releaseReadJson($lockPath);
    foreach (($lock['packages'] ?? []) as $package) {
        if (is_array($package) && ($package['name'] ?? null) === 'peanut-admin/core') {
            return $package;
        }
    }
    throw new RuntimeException('SCAFFOLD_RELEASE_CORE_LOCK_MISSING');
}

function releaseLockRows(string $lockPath): string
{
    $lock = releaseReadJson($lockPath);
    $rows = [];
    foreach ([...($lock['packages'] ?? []), ...($lock['packages-dev'] ?? [])] as $package) {
        if (!is_array($package) || ($package['name'] ?? null) === 'peanut-admin/core') {
            continue;
        }
        $rows[] = implode("\0", [
            (string) ($package['name'] ?? ''),
            (string) ($package['version'] ?? ''),
            (string) ($package['source']['type'] ?? ''),
            (string) ($package['source']['url'] ?? ''),
            (string) ($package['source']['reference'] ?? ''),
            (string) ($package['dist']['type'] ?? ''),
            (string) ($package['dist']['url'] ?? ''),
            (string) ($package['dist']['reference'] ?? ''),
            (string) ($package['dist']['shasum'] ?? ''),
        ]);
    }
    sort($rows, SORT_STRING);
    return hash('sha256', implode("\n", $rows));
}

function releaseProjectModules(string $application, string $version): void
{
    foreach (glob($application . '/server/app/modules/*/*/composer.json') ?: [] as $path) {
        $composer = releaseReadJson($path);
        if (isset($composer['require']['peanut-admin/core'])) {
            $composer['require']['peanut-admin/core'] = $version;
            releaseWriteJson($path, $composer);
        }
    }
    $writer = new app\platform\infrastructure\plugin\PluginArtifactWriter($application . '/server', false);
    foreach (glob($application . '/plugins/*/plugin.json') ?: [] as $path) {
        $plugin = releaseReadJson($path);
        $specs = [];
        foreach ($plugin['modules'] as $module) {
            $specs[] = $module['key'] . '=' . $module['root'];
        }
        $writer->make($plugin['key'], $plugin['version'], $specs);
    }
    $writer->writeLock();
}

function releaseProjectCore(string $application, array $core, string $temporary): string
{
    $coreTarget = $application . '/' . $core['archive_relative'];
    releaseCopyFile($core['archive_absolute'], $coreTarget);
    $lockBefore = releaseLockRows($application . '/server/composer.lock');
    $version = (string) $core['inputs']['core_php']['resolved_version'];
    releaseProjectComposer($application, $core['package'], $version);
    releaseProjectModules($application, $version);
    releaseRun([
        'composer',
        'update', 'peanut-admin/core',
        '--working-dir=' . $application . '/server',
        '--no-install', '--no-scripts', '--no-interaction', '--no-progress', '--prefer-dist',
    ], $application, [
        'COMPOSER_HOME' => $temporary . '/composer-home',
        'COMPOSER_CACHE_DIR' => getenv('COMPOSER_CACHE_DIR') ?: $temporary . '/composer-cache',
    ]);
    $lockAfter = releaseLockRows($application . '/server/composer.lock');
    if (!hash_equals($lockBefore, $lockAfter)) {
        throw new RuntimeException('SCAFFOLD_RELEASE_THIRD_PARTY_LOCK_CHANGED');
    }
    $lockedCore = releaseLockPackage($application . '/server/composer.lock');
    $local = $core['local'] ?? false;
    if (($lockedCore['version'] ?? null) !== $version
        || ($local
            ? (isset($lockedCore['source']) || ($lockedCore['dist']['reference'] ?? null) !== ($core['source_identity']['snapshot_sha256'] ?? null))
            : (($lockedCore['source']['reference'] ?? null) !== ($core['inputs']['core_php']['source_reference'] ?? null)
                || ($lockedCore['dist']['reference'] ?? null) !== ($core['inputs']['core_php']['source_reference'] ?? null)))
        || ($lockedCore['dist']['shasum'] ?? null) !== $core['archive_sha1']) {
        throw new RuntimeException('SCAFFOLD_RELEASE_CORE_LOCK_IDENTITY_INVALID');
    }
    return $lockAfter;
}

function releaseProjectWeb(string $application, array $core, string $receipt, string $toolRoot): array
{
    $web = $core['inputs']['core_web'] ?? null;
    $suffixes = ['client', 'vue', 'ui-vue', 'nuxt', 'uniapp', 'testing'];
    $local = is_array($web) && ($web['source_type'] ?? null) === 'local';
    $identity = is_array($web) ? ($web['source_identity'] ?? null) : null;
    $sourceValid = $local
        ? (is_array($identity) && array_keys($identity) === ['kind', 'snapshot_sha256']
            && ($identity['kind'] ?? null) === 'local'
            && preg_match('/^[a-f0-9]{64}$/D', (string) ($identity['snapshot_sha256'] ?? '')) === 1
            && ($core['inputs']['sources']['web'] ?? null) === $identity)
        : (is_array($web) && ($web['source_type'] ?? null) === 'git'
            && ($web['source_reference'] ?? null) === ($core['inputs']['sources']['web']['commit'] ?? null)
            && preg_match('/^[a-f0-9]{40}$/D', (string) ($web['source_reference'] ?? '')) === 1);
    if (!is_array($web) || array_keys($web['packages'] ?? []) !== array_map(static fn(string $s): string => '@peanut-admin/' . $s, $suffixes)
        || !$sourceValid) {
        throw new RuntimeException('SCAFFOLD_RELEASE_WEB_INPUTS_INVALID');
    }
    $lockTool = $toolRoot . '/scripts/release-dependency-locks.mjs';
    $before = json_decode(releaseRun(['node', $lockTool, $application, '--third-party-only', '--tool-root=' . $toolRoot]), true, 512, JSON_THROW_ON_ERROR);
    $packages = [];
    $webVersion = $web['packages']['@peanut-admin/client']['version'] ?? null;
    if (!ReleaseDependencyIdentity::fixed($webVersion)) {
        throw new RuntimeException('SCAFFOLD_RELEASE_WEB_INPUTS_INVALID');
    }
    foreach ($web['packages'] as $name => $identity) {
        $suffix = substr($name, strlen('@peanut-admin/'));
        $path = $identity['archive'] ?? '';
        if (($identity['version'] ?? null) !== $webVersion
            || $path !== 'packages/core-web/peanut-admin-' . $suffix . '-' . $identity['version'] . '.tgz') {
            throw new RuntimeException('SCAFFOLD_RELEASE_WEB_ARCHIVE_IDENTITY_INVALID');
        }
        $input = dirname($receipt) . '/' . $path;
        releaseInputFile($input);
        if (!hash_equals((string) ($identity['sha256'] ?? ''), (string) hash_file('sha256', $input))) {
            throw new RuntimeException('SCAFFOLD_RELEASE_WEB_ARCHIVE_DIGEST_INVALID');
        }
        $destination = $application . '/' . $path;
        if (file_exists($destination)) {
            releaseInputFile($destination);
            if (!unlink($destination)) {
                throw new RuntimeException('SCAFFOLD_RELEASE_WEB_ARCHIVE_REPLACE_FAILED');
            }
        }
        releaseCopyFile($input, $destination);
        $packages[$name] = $identity + ['integrity' => 'sha512-' . base64_encode(hash_file('sha512', $input, true)), 'consumers' => []];
    }
    foreach (['web', 'platform', 'pc', 'uniapp'] as $client) {
        $path = $application . '/' . $client . '/package.json';
        $manifest = releaseReadJson($path);
        foreach (['dependencies', 'devDependencies', 'optionalDependencies'] as $section) {
            foreach (($manifest[$section] ?? []) as $name => $specifier) {
                if (!str_starts_with($name, '@peanut-admin/')) {
                    continue;
                }
                if (!isset($packages[$name])) {
                    throw new RuntimeException('SCAFFOLD_RELEASE_WEB_PACKAGE_UNKNOWN');
                }
                $manifest[$section][$name] = 'file:../' . $packages[$name]['archive'];
                $packages[$name]['consumers'][] = $client;
            }
        }
        releaseWriteJson($path, $manifest);
    }
    $versions = releaseReadJson($application . '/release-versions.json');
    $versions['core_php'] = $core['inputs']['core_php'];
    $versions['core_web'] = $web;
    releaseWriteJson($application . '/release-versions.json', $versions);
    // These are native lock generation operations, not hand-edited lock data.
    // Lifecycle hooks are disabled; none may install the APP or touch a database.
    releaseRun(['pnpm', '--dir', $application . '/web', 'install', '--lockfile-only', '--ignore-scripts'], $application, ['HUSKY' => '0']);
    foreach (['platform', 'pc', 'uniapp'] as $client) {
        releaseRun(['npm', '--prefix', $application . '/' . $client, 'install', '--package-lock-only', '--ignore-scripts', '--no-audit', '--no-fund'], $application, ['HUSKY' => '0']);
    }
    $after = json_decode(releaseRun(['node', $lockTool, $application, '--third-party-only', '--tool-root=' . $toolRoot]), true, 512, JSON_THROW_ON_ERROR);
    if ($before !== $after) {
        throw new RuntimeException('SCAFFOLD_RELEASE_WEB_THIRD_PARTY_LOCK_CHANGED');
    }
    releaseRun(['node', $lockTool, $application, '--core-inputs=' . $receipt, '--tool-root=' . $toolRoot]);
    foreach ($packages as &$identity) {
        $identity['consumers'] = array_values(array_unique($identity['consumers']));
        $identity['consumption'] = $identity['consumers'] === [] ? 'carried-not-consumed' : 'selected-client-dependency';
    }
    unset($identity);
    return ['packages' => $packages, 'third_party_locks' => $after];
}

function releaseProjectScaffold(string $application, array $core, string $temporary, array $sourceIdentity, string $receipt, string $toolRoot): array
{
    $manifestPath = $application . '/.peanut/application-manifest.json';
    $manifest = releaseReadJson($manifestPath);
    $localSource = ($sourceIdentity['kind'] ?? null) === 'local';
    $generationIdentity = $manifest['generation_source']['source_identity'] ?? null;
    $sourceMatches = $localSource
        ? ($generationIdentity === $sourceIdentity)
        : (($manifest['generation_source']['commit'] ?? null) === ($sourceIdentity['commit'] ?? null)
            && ($manifest['generation_source']['tree'] ?? null) === ($sourceIdentity['tree'] ?? null));
    if (!$sourceMatches
        || !is_array($manifest['files'] ?? null)
        || !is_string($manifest['digests']['managed_tree_sha256'] ?? null)) {
        throw new RuntimeException('SCAFFOLD_RELEASE_SCAFFOLD_SOURCE_INVALID');
    }
    $originalDigest = $manifest['digests']['managed_tree_sha256'];
    $versionPath = $application . '/release-versions.json';
    $versions = releaseReadJson($versionPath);
    $originalPhp = $versions['core_php'] ?? null;
    if (!defined('RELEASE_APPLICATION_VERSION_TOKEN')
        || !defined('RELEASE_PRODUCT_TOKEN')
        || !defined('RELEASE_SLUG_TOKEN')
        || !defined('RELEASE_PACKAGE_TOKEN')
        || ($versions['schema_version'] ?? null) !== 3
        || ($versions['protocol'] ?? null) !== 'peanut.release-versions.v3'
        || !is_array($originalPhp)
        || ($originalPhp['package'] ?? null) !== 'peanut-admin/core'
        || ($versions['instance_version'] ?? null) !== constant('RELEASE_APPLICATION_VERSION_TOKEN')
        || ($versions['source_product_version'] ?? null) !== ($versions['scaffold_template'] ?? null)
        || ($versions['scaffold_template'] ?? null) !== ($manifest['template']['version'] ?? null)) {
        throw new RuntimeException('SCAFFOLD_RELEASE_SCAFFOLD_VERSION_INVALID');
    }
    $coreIdentity = $core['inputs']['core_php'];
    $originalWeb = $versions['core_web'] ?? null;
    $requestedWeb = $core['inputs']['core_web'] ?? null;
    if (!is_array($originalWeb) || !is_array($requestedWeb)
        || !is_array($originalWeb['packages'] ?? null) || !is_array($requestedWeb['packages'] ?? null)) {
        throw new RuntimeException('SCAFFOLD_RELEASE_WEB_INPUTS_INVALID');
    }
    $sameWeb = ($requestedWeb['source_identity'] ?? null) === ($originalWeb['source_identity'] ?? null)
        && ($requestedWeb['source_reference'] ?? null) === ($originalWeb['source_reference'] ?? null)
        && array_keys($requestedWeb['packages']) === array_keys($originalWeb['packages']);
    foreach ($requestedWeb['packages'] as $name => $package) {
        $sameWeb = $sameWeb && is_array($package)
            && ($package['version'] ?? null) === ($originalWeb['packages'][$name]['version'] ?? null);
    }
    if (!$localSource && !$core['local'] && ($coreIdentity['source_reference'] ?? null) === ($originalPhp['source_reference'] ?? null)
        && ltrim((string) ($coreIdentity['resolved_version'] ?? ''), 'v') === ltrim((string) ($originalPhp['resolved_version'] ?? ''), 'v')
        && $sameWeb) {
        throw new RuntimeException('SCAFFOLD_RELEASE_SCAFFOLD_PROJECTION_REDUNDANT');
    }
    if ($core['local']) {
        $versions['core_php'] = $coreIdentity;
        $versions['core_web'] = $requestedWeb;
    } else {
        $versions['core_php']['constraint'] = $coreIdentity['resolved_version'];
        $versions['core_php']['resolved_version'] = $coreIdentity['resolved_version'];
        $versions['core_php']['source_reference'] = $coreIdentity['source_reference'];
    }
    releaseWriteJson($versionPath, $versions);
    releaseProjectCore($application, $core, $temporary);
    $web = releaseProjectWeb($application, $core, $receipt, $toolRoot);
    $versions = releaseReadJson($versionPath);

    $allowed = ['release-versions.json' => true, 'server/composer.json' => true,
        'server/composer.lock' => true, 'plugins.lock' => true];
    foreach (['web', 'platform', 'pc', 'uniapp'] as $client) {
        $allowed[$client . '/package.json'] = true;
        $allowed[$client . '/' . ($client === 'web' ? 'pnpm-lock.yaml' : 'package-lock.json')] = true;
    }
    $changes = [];
    $managed = [];
    foreach ($manifest['files'] as &$file) {
        $path = $file['path'] ?? null;
        if (!is_string($path) || !is_string($file['sha256'] ?? null)) {
            throw new RuntimeException('SCAFFOLD_RELEASE_SCAFFOLD_FILE_INVALID');
        }
        $actual = hash_file('sha256', $application . '/' . $path);
        if (!is_string($actual)) {
            throw new RuntimeException('SCAFFOLD_RELEASE_SCAFFOLD_FILE_MISSING: ' . $path);
        }
        if (!hash_equals($file['sha256'], $actual)) {
            if (!isset($allowed[$path]) && preg_match('#^server/app/modules/[a-z0-9_-]+/[a-z0-9_-]+/composer\.json$#D', $path) !== 1
                && preg_match('#^plugins/[a-z0-9._-]+/plugin\.json$#D', $path) !== 1) {
                throw new RuntimeException('SCAFFOLD_RELEASE_SCAFFOLD_PROJECTION_UNEXPECTED: ' . $path);
            }
            if (!in_array($file['classification'], ['managed', 'generated-managed'], true)
                || !is_string($file['baseline_path'] ?? null)) {
                throw new RuntimeException('SCAFFOLD_RELEASE_SCAFFOLD_PROJECTION_UNMANAGED: ' . $path);
            }
            $changes[] = ['path' => $path, 'before_sha256' => $file['sha256'], 'after_sha256' => $actual];
            $baseline = $application . '/' . $file['baseline_path'];
            if (!is_file($baseline) || is_link($baseline)
                || hash_file('sha256', $baseline) !== $file['baseline_sha256']) {
                throw new RuntimeException('SCAFFOLD_RELEASE_SCAFFOLD_BASELINE_INVALID: ' . $path);
            }
            if (!copy($application . '/' . $path, $baseline)) {
                throw new RuntimeException('SCAFFOLD_RELEASE_SCAFFOLD_BASELINE_WRITE_FAILED: ' . $path);
            }
            $file['sha256'] = $actual;
            $file['baseline_sha256'] = $actual;
        }
        if (in_array($file['classification'], ['managed', 'generated-managed'], true)) {
            $managed[] = $file;
        }
    }
    unset($file);
    $corePath = $core['archive_relative'];
    $archives = [$corePath => $core['archive_sha256']];
    foreach ($web['packages'] as $package) {
        $archives[$package['archive']] = $package['sha256'];
    }
    $additions = [];
    foreach ($archives as $path => $digest) {
        $bytes = file_get_contents($application . '/' . $path);
        if (!is_string($bytes) || !hash_equals($digest, hash('sha256', $bytes))) {
            throw new RuntimeException('SCAFFOLD_RELEASE_SCAFFOLD_CORE_READ_FAILED: ' . $path);
        }
        foreach ([constant('RELEASE_PRODUCT_TOKEN'), constant('RELEASE_SLUG_TOKEN'),
            constant('RELEASE_PACKAGE_TOKEN'), constant('RELEASE_APPLICATION_VERSION_TOKEN')] as $token) {
            if (str_contains($bytes, $token)) {
                throw new RuntimeException('SCAFFOLD_RELEASE_SCAFFOLD_CORE_TOKEN_COLLISION: ' . $path);
            }
        }
        foreach ($manifest['files'] as $file) {
            if ($file['path'] === $path) {
                throw new RuntimeException('SCAFFOLD_RELEASE_SCAFFOLD_CORE_PATH_COLLISION: ' . $path);
            }
        }
        $baseline = $manifest['ownership']['baseline_root'] . '/' . $path;
        releaseCopyFile($application . '/' . $path, $application . '/' . $baseline);
        $file = ['path' => $path, 'sha256' => $digest, 'mode' => 0644,
            'classification' => 'managed', 'owner' => 'host', 'source' => $path,
            'baseline_path' => $baseline, 'baseline_sha256' => $digest];
        $manifest['files'][] = $file;
        $managed[] = $file;
        $additions[] = ['path' => $path, 'sha256' => $digest];
    }
    usort($manifest['files'], static fn(array $a, array $b): int => strcmp($a['path'], $b['path']));
    $rows = array_map(static fn(array $file): string => $file['path'] . "\0" . $file['sha256'], $managed);
    sort($rows, SORT_STRING);
    $manifest['digests']['managed_tree_sha256'] = hash('sha256', implode("\n", $rows));
    releaseWriteJson($manifestPath, $manifest);
    $receiptDigest = hash_file('sha256', $receipt);
    if (!is_string($receiptDigest)) {
        throw new RuntimeException('SCAFFOLD_RELEASE_SCAFFOLD_RECEIPT_INVALID');
    }
    $projection = [
        'protocol' => 'peanut.internal-core-scaffold-projection.v1',
        'scope' => 'internal-upgrade-target-not-formal-release',
        'core_inputs_sha256' => $receiptDigest,
        'build_tools_sha256' => [
            'build_scaffold_release' => hash_file('sha256', $toolRoot . '/scripts/build-scaffold-release'),
        ],
        'core' => ['package' => 'peanut-admin/core', 'resolved_version' => $coreIdentity['resolved_version'],
            ...($core['local'] ? ['source_identity' => $coreIdentity['source_identity']] : ['source_reference' => $coreIdentity['source_reference']]), 'archive_path' => $corePath,
            'archive_sha256' => $core['archive_sha256'], 'archive_sha1' => $core['archive_sha1']],
        'core_web' => $web['packages'],
        'release_versions' => ['before' => $originalPhp, 'after' => $versions['core_php']],
        'managed_tree_sha256' => ['source' => $originalDigest, 'projected' => $manifest['digests']['managed_tree_sha256']],
        'changes' => $changes,
        'addition' => ['path' => $corePath, 'sha256' => $core['archive_sha256']],
        'additions' => $additions,
    ];
    if ($localSource) {
        $projection['source_identity'] = $sourceIdentity;
        $projection['core_web_source_identity'] = $core['inputs']['core_web']['source_identity'];
    } else {
        $projection['source'] = ['commit' => $sourceIdentity['commit'], 'tree' => $sourceIdentity['tree']];
        $projection['web_source_reference'] = $core['inputs']['core_web']['source_reference'];
    }
    return $projection;
}

$localSource = isset($options['source-snapshot']);
$commit = null;
$tree = null;
if (!$localSource) {
    $commit = trim(releaseRun(['git','-C',$root,'rev-parse',$options['source-commit'] . '^{commit}']));
    if (!hash_equals($options['source-commit'], $commit)) { throw new RuntimeException('SCAFFOLD_RELEASE_SOURCE_NOT_COMMIT'); }
    $tree = trim(releaseRun(['git','-C',$root,'rev-parse',$commit . '^{tree}']));
}
$temporaryRoot = isset($options['work-root']) ? realpath($options['work-root']) : realpath(sys_get_temp_dir());
if (isset($options['work-root']) && (!str_starts_with($options['work-root'], '/') || is_link($options['work-root']) || !is_dir($options['work-root']))) {
    throw new RuntimeException('SCAFFOLD_RELEASE_TEMP_ROOT_INVALID');
}
if ($temporaryRoot === false) {
    throw new RuntimeException('SCAFFOLD_RELEASE_TEMP_ROOT_INVALID');
}
$temporary = $temporaryRoot . '/peanut-scaffold-release-' . bin2hex(random_bytes(8));
if (!mkdir($temporary, 0700, true)) {
    throw new RuntimeException('SCAFFOLD_RELEASE_TEMP_FAILED');
}
if (isset($options['work-root'])) {
    // Keep native serializers and their locked tooling installs in this operation.
    putenv('TMPDIR=' . $temporary);
}
try {
    $source = $localSource ? realpath($options['source-snapshot']) : $temporary . '/source';
    if ($localSource) {
        require_once $source . '/scripts/scaffold-runtime/ScaffoldSourceIdentity.php';
        $sourceIdentity = \app\common\value\scaffold\ScaffoldSourceIdentity::local($source);
        spl_autoload_register(static function (string $class) use ($source): void {
            if (!str_starts_with($class, 'app\\')) { return; }
            $relative = str_replace('\\', '/', substr($class, 4)) . '.php';
            $file = $source . '/server/app/' . $relative;
            if (!is_file($file) || is_link($file)) { throw new RuntimeException('SCAFFOLD_LOCAL_SNAPSHOT_CLASS_MISSING: ' . $class); }
            require_once $file;
        }, true, true);
    } else {
    $origin = trim(releaseRun(['git','-C',$root,'remote','get-url','origin']));
    if ($origin === '') {
        throw new RuntimeException('SCAFFOLD_RELEASE_SOURCE_ORIGIN_INVALID');
    }
    // Fetch only the fixed commit into an independent repository. Its identity
    // and cleanliness must not depend on the enclosing maintainer checkout.
    releaseRun(['git','init','--quiet',$source]);
    releaseRun(['git','-C',$source,'fetch','--quiet','--no-tags','--depth=1',$root,$commit]);
    releaseRun(['git','-C',$source,'remote','add','origin',$origin]);
    releaseRun(['git','-C',$source,'checkout','--quiet','--detach',$commit]);
    if (realpath(trim(releaseRun(['git','-C',$source,'rev-parse','--show-toplevel']))) !== realpath($source)
        || !hash_equals($commit, trim(releaseRun(['git','-C',$source,'rev-parse','HEAD'])))
        || !hash_equals($tree, trim(releaseRun(['git','-C',$source,'rev-parse','HEAD^{tree}'])))
        || trim(releaseRun(['git','-C',$source,'status','--porcelain=v1','--untracked-files=all'])) !== '') {
        throw new RuntimeException('SCAFFOLD_RELEASE_SOURCE_IDENTITY_MISMATCH');
    }
    // A new artifact must use the standard producer from its declared source.
    // Historical --check still verifies immutable payloads without rebuilding tooling.
    if (!$check && (!hash_equals($commit, trim(releaseRun(['git', '-C', $root, 'rev-parse', 'HEAD'])))
        || trim(releaseRun(['git', '-C', $root, 'status', '--porcelain=v1', '--untracked-files=all'])) !== '')) {
        throw new RuntimeException('SCAFFOLD_RELEASE_PRODUCER_SOURCE_MISMATCH');
    }
    $sourceIdentity = ['kind' => 'git', 'commit' => $commit, 'tree' => $tree];
    }
    $modernCreator = is_file($source . '/server/app/common/infrastructure/scaffold/ApplicationCreator.php');
    require $source . ($modernCreator
        ? '/server/app/common/validation/scaffold/ScaffoldPathGuard.php'
        : '/server/app/common/service/scaffold/ScaffoldPathGuard.php');
    require $source . ($modernCreator
        ? '/server/app/common/value/scaffold/ScaffoldManifest.php'
        : '/server/app/common/service/scaffold/ScaffoldManifest.php');
    require $source . ($modernCreator
        ? '/server/app/common/infrastructure/scaffold/ApplicationCreator.php'
        : '/server/app/common/service/scaffold/ApplicationCreator.php');
    $application = $temporary . '/application';
    $edition = $options['edition'] ?? null;
    $creatorClass = $modernCreator
        ? \app\common\infrastructure\scaffold\ApplicationCreator::class
        : \app\common\service\scaffold\ApplicationCreator::class;
    $creatorArguments = [$source,$source . '/scaffold/application-template-inventory.json',$localSource ? $sourceIdentity : ['commit' => $commit,'tree' => $tree]];
    $constructor = (new ReflectionClass($creatorClass))->getConstructor();
    $constructorCount = $constructor?->getNumberOfParameters() ?? 0;
    if ($constructorCount >= 4) {
        $creatorArguments[] = null;
    }
    if ($constructorCount >= 5) {
        $creatorArguments[] = $edition !== null;
    }
    if (isset($options['api-tool-root']) && $constructorCount < 7) {
        throw new RuntimeException('SCAFFOLD_RELEASE_CREATOR_SIGNATURE_UNSUPPORTED');
    }
    if ($constructorCount >= 7) {
        if ($constructor->getParameters()[6]->getName() !== 'apiGeneratorPath') {
            throw new RuntimeException('SCAFFOLD_RELEASE_CREATOR_SIGNATURE_UNSUPPORTED');
        }
        $creatorArguments[] = null;
        $creatorArguments[] = rtrim($options['api-tool-root'] ?? $root, '/') . '/scripts/generate-api-contracts.php';
    }
    $creator = (new ReflectionClass($creatorClass))->newInstanceArgs($creatorArguments);
    $create = new ReflectionMethod($creator, 'create');
    $createParameters = array_map(static fn(ReflectionParameter $parameter): string => $parameter->getName(), $create->getParameters());
    if (isset($options['workflow']) && $createParameters !== ['productName','slug','packageIdentity','target','edition','applicationVersion','profile','workflow']) {
        throw new RuntimeException('SCAFFOLD_RELEASE_WORKFLOW_UNSUPPORTED');
    }
    if ($createParameters === ['productName','slug','packageIdentity','target']) {
        // The earliest immutable releases predate generated application
        // versions; their v2 manifests intentionally contain only three tokens.
        $manifest = $creator->create(
            RELEASE_PRODUCT_TOKEN,
            RELEASE_SLUG_TOKEN,
            RELEASE_PACKAGE_TOKEN,
            $application,
        );
    } elseif ($createParameters === ['productName','slug','packageIdentity','target','applicationVersion']) {
        // Immutable pre-edition releases accepted the application version as
        // argument five. Passing today's edition there corrupts their check.
        $manifest = $creator->create(
            RELEASE_PRODUCT_TOKEN,
            RELEASE_SLUG_TOKEN,
            RELEASE_PACKAGE_TOKEN,
            $application,
            RELEASE_APPLICATION_VERSION_TOKEN,
        );
    } elseif ($createParameters === ['productName','slug','packageIdentity','target','edition','applicationVersion','profile']
        || $createParameters === ['productName','slug','packageIdentity','target','edition','applicationVersion','profile','workflow']) {
        // An omitted workflow retains the immutable creator's own default.
        $manifest = $creator->create(
            RELEASE_PRODUCT_TOKEN,
            RELEASE_SLUG_TOKEN,
            RELEASE_PACKAGE_TOKEN,
            $application,
            $edition ?? 'multi-tenant',
            RELEASE_APPLICATION_VERSION_TOKEN,
            'full',
            ...(isset($options['workflow']) ? [$options['workflow']] : []),
        );
    } else {
        throw new RuntimeException('SCAFFOLD_RELEASE_CREATOR_SIGNATURE_UNSUPPORTED');
    }
    if (isset($options['workflow']) && ($manifest['application']['workflow'] ?? null) !== $options['workflow']) {
        throw new RuntimeException('SCAFFOLD_RELEASE_WORKFLOW_MISMATCH');
    }
    $internalProjection = null;
    if (isset($options['internal-core-inputs'])) {
        if (!$modernCreator || $edition === null
            || ($manifest['template']['version'] ?? null) !== $options['version']) {
            throw new RuntimeException('SCAFFOLD_RELEASE_INTERNAL_SOURCE_UNSUPPORTED');
        }
        foreach ([
            '/server/app/platform/exception/plugin/PluginArtifactToolException.php',
            '/server/app/platform/value/plugin/ModuleFrontendLayout.php',
            '/server/app/platform/infrastructure/plugin/PluginArtifactWriter.php',
            '/server/app/platform/exception/plugin/PluginLifecycleException.php',
            '/server/app/platform/value/plugin/PluginDescriptor.php',
            '/server/app/platform/infrastructure/plugin/PluginLockResolver.php',
        ] as $dependency) {
            require_once $source . $dependency;
        }
        $core = releaseCoreInputs($options['internal-core-inputs']);
        $internalProjection = releaseProjectScaffold(
            $application,
            $core,
            $temporary,
            $sourceIdentity,
            $options['internal-core-inputs'],
            $root,
        );
        $manifest = releaseReadJson($application . '/.peanut/application-manifest.json');
    }
    $generationSource = $manifest['generation_source'] ?? null;
    $identityMatches = $localSource
        ? (($manifest['template']['source_identity'] ?? null) === $sourceIdentity
            && ($generationSource['source_identity'] ?? null) === $sourceIdentity)
        : (($manifest['template']['source_commit'] ?? null) === $commit && ($manifest['template']['source_tree'] ?? null) === $tree
            && ($generationSource === null || (($generationSource['commit'] ?? null) === $commit && ($generationSource['tree'] ?? null) === $tree)));
    if (!$identityMatches || ($generationSource !== null && (!is_array($generationSource)
            || ($generationSource['inventory_sha256'] ?? null) !== hash_file('sha256', $source . '/scaffold/application-template-inventory.json')))) {
        throw new RuntimeException('SCAFFOLD_RELEASE_GENERATION_IDENTITY_MISMATCH');
    }
    $inventoryRaw = file_get_contents($source . '/scaffold/application-template-inventory.json');
    $inventory = json_decode((string) $inventoryRaw, true, 512, JSON_THROW_ON_ERROR);
    $inventoryTransforms = [];
    foreach ($inventory['files'] ?? [] as $inventoryEntry) {
        if (is_array($inventoryEntry) && is_string($inventoryEntry['path'] ?? null) && is_string($inventoryEntry['transform'] ?? null)) {
            $inventoryTransforms[$inventoryEntry['path']] = $inventoryEntry['transform'];
        }
    }
    $files = [];
    foreach ($manifest['files'] as $entry) {
        if (!in_array($entry['classification'], ['managed','generated-managed'], true)) {
            continue;
        }
        $path = $entry['path'];
        $content = file_get_contents($application . '/' . $path);
        if (!is_string($content) || !hash_equals($entry['sha256'], hash('sha256', $content))) {
            throw new RuntimeException('SCAFFOLD_RELEASE_GENERATED_TREE_MISMATCH: ' . $path);
        }
        $artifact = ['path' => $path,'source' => 'files/' . $path,'template_sha256' => hash('sha256', $content),'classification' => $entry['classification'],
            'transform' => ($inventoryTransforms[$path] ?? null) === 'composer-lock' ? 'composer-lock' : 'tokens','mode' => $entry['mode'] ?? ((fileperms($application . '/' . $path) & 0111) !== 0 ? 0755 : 0644),
            'policy' => $entry['classification'] === 'generated-managed' ? 'generated' : 'managed','owner' => releaseOwner($path)];
        $destination = rtrim($options['output'], '/') . '/' . $artifact['source'];
        if ($check) {
            if (!is_file($destination) || !hash_equals($artifact['template_sha256'], (string) hash_file('sha256', $destination)) || ((fileperms($destination) & 0777) !== $artifact['mode'])) {
                throw new RuntimeException('SCAFFOLD_RELEASE_ARTIFACT_STALE: ' . $path);
            }
        } else {
            releaseWrite($destination, $content, $artifact['mode']);
        }
        $files[] = $artifact;
    }
    usort($files, static fn(array $a, array $b): int => strcmp($a['path'], $b['path']));
    $releaseIdentity = [
        'version' => $options['version'],'source_identity' => $sourceIdentity,'inventory_sha256' => hash('sha256', (string) $inventoryRaw),
        'inventory_template_version' => $manifest['template']['version'],'managed_tree_sha256' => $manifest['digests']['managed_tree_sha256'],
    ];
    if (array_key_exists('workflow', $manifest['application'])) {
        $workflow = $manifest['application']['workflow'];
        if (!is_string($workflow) || !in_array($workflow, ['none', 'runtime', 'full'], true)) {
            throw new RuntimeException('SCAFFOLD_RELEASE_WORKFLOW_INVALID');
        }
        $releaseIdentity['workflow'] = $workflow;
    }
    if (($inventory['schema_version'] ?? null) === 1 && ($inventory['protocol'] ?? null) === 'peanut.create-app-inventory.v1') {
        $releaseIdentity['tokens'] = ['product_name' => RELEASE_PRODUCT_TOKEN,'slug' => RELEASE_SLUG_TOKEN,'package_identity' => RELEASE_PACKAGE_TOKEN];
        $release = $localSource
            ? ['schema_version' => 4,'protocol' => 'peanut.scaffold-release.v4','release' => $releaseIdentity + ['tokens' => ['product_name' => RELEASE_PRODUCT_TOKEN,'slug' => RELEASE_SLUG_TOKEN,'package_identity' => RELEASE_PACKAGE_TOKEN]],'files' => $files,'renames' => []]
            : ['schema_version' => 2,'protocol' => 'peanut.scaffold-release.v2','release' => $releaseIdentity + ['source_commit' => $commit,'source_tree' => $tree],'files' => $files,'renames' => []];
    } else {
        $applicationVersion = $inventory['application']['version'] ?? null;
        if (($inventory['schema_version'] ?? null) !== 2 || ($inventory['protocol'] ?? null) !== 'peanut.create-app-inventory.v2'
            || !is_string($applicationVersion) || preg_match('/^\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?$/D', $applicationVersion) !== 1) {
            throw new RuntimeException('SCAFFOLD_RELEASE_APPLICATION_VERSION_INVALID');
        }
        $releaseIdentity['tokens'] = ['product_name' => RELEASE_PRODUCT_TOKEN,'slug' => RELEASE_SLUG_TOKEN,'package_identity' => RELEASE_PACKAGE_TOKEN,
            'application_version' => RELEASE_APPLICATION_VERSION_TOKEN];
        $release = $localSource
            ? ['schema_version' => 4,'protocol' => 'peanut.scaffold-release.v4','application' => ['version' => $applicationVersion],
                'release' => $releaseIdentity + ['tokens' => ['product_name' => RELEASE_PRODUCT_TOKEN,'slug' => RELEASE_SLUG_TOKEN,'package_identity' => RELEASE_PACKAGE_TOKEN,'application_version' => RELEASE_APPLICATION_VERSION_TOKEN]],'files' => $files,'renames' => []]
            : ['schema_version' => 3,'protocol' => 'peanut.scaffold-release.v3','application' => ['version' => $applicationVersion],
                'release' => $releaseIdentity + ['source_commit' => $commit,'source_tree' => $tree,'tokens' => ['product_name' => RELEASE_PRODUCT_TOKEN,'slug' => RELEASE_SLUG_TOKEN,'package_identity' => RELEASE_PACKAGE_TOKEN,'application_version' => RELEASE_APPLICATION_VERSION_TOKEN]],'files' => $files,'renames' => []];
    }
    if ($edition !== null) {
        $release['edition'] = $manifest['edition'];
    }
    if ($internalProjection !== null) {
        $release['internal_core_projection'] = $internalProjection;
    }
    $json = json_encode($release, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n";
    $manifestPath = rtrim($options['output'], '/') . '/scaffold-manifest.json';
    if ($check) {
        if (!is_file($manifestPath) || !hash_equals($json, (string) file_get_contents($manifestPath))) {
            throw new RuntimeException('SCAFFOLD_RELEASE_MANIFEST_STALE');
        } echo "SCAFFOLD-RELEASE-{$options['version']} verified\n";
    } else {
        releaseWrite($manifestPath, $json, 0644);
        echo "wrote {$manifestPath} with " . count($files) . " managed files\n";
    }
    if ($edition !== null) {
        if ($internalProjection !== null) {
            $manifest['scaffold_candidate'] = [
                'manifest_sha256' => hash('sha256', $json),
                'core_inputs_sha256' => $internalProjection['core_inputs_sha256'],
                'formal_release_eligible' => false,
            ];
            releaseWriteJson($application . '/.peanut/application-manifest.json', $manifest);
        }
        // The same native projection produces creation defaults and upgrade bytes.
        $packageCommand = ['python3', ($check ? $root : $source) . '/scripts/package-scaffold-template.py',
            '--application', $application, '--output', rtrim($options['output'], '/'), '--tooling-source', $source . '/server'];
        if ($check) { $packageCommand[] = '--check'; }
        releaseRun($packageCommand);
    }
    // Historical in-repository releases remain versioned inputs. A freshly built
    // candidate outside scaffold/releases is verified against its exact source
    // commit above; requiring it in Git would prevent pre-release qualification.
    if ($check && str_starts_with(rtrim($options['output'], '/') . '/', $root . '/scaffold/releases/')) {
        foreach ($files as $file) {
            releaseAssertTracked($root, rtrim($options['output'], '/') . '/' . $file['source']);
        }
        releaseAssertTracked($root, $manifestPath);
    }
} finally {
    releaseDelete($temporary);
}
