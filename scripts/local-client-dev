#!/bin/sh

set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
env_file="$repo_dir/.local/host-client.env"
env_file_explicit=0
component=${1:-}
[ -n "$component" ] || { printf 'Usage: %s {web|platform|pc|mobile|uniapp-native|docs} [--env-file path] [--core-web-dir /absolute/path] [--dry-run] [-- extra args]\n' "$0" >&2; exit 2; }
shift
dry_run=0
core_web_dir=""
saved_core_selection=0
while [ $# -gt 0 ] && [ "$1" != -- ]; do
    case "$1" in
        --env-file) [ $# -ge 2 ] || { printf '%s\n' '--env-file requires a value' >&2; exit 2; }; env_file=$2; env_file_explicit=1; shift 2 ;;
        --core-web-dir) [ $# -ge 2 ] && [ -n "${2:-}" ] || { printf '%s\n' '--core-web-dir requires a non-empty value' >&2; exit 2; }; core_web_dir=$2; shift 2 ;;
        --dry-run) dry_run=1; shift ;;
        *) printf 'unsupported argument: %s\n' "$1" >&2; exit 2 ;;
    esac
done
[ "${1:-}" != "--" ] || shift
valid_env_file() { [ "${env_file#/}" != "$env_file" ] && [ -f "$env_file" ] && [ ! -L "$env_file" ]; }
if [ "$component" = uniapp-native ]; then
    # Native custom/SSR/device commands keep their existing environment and argv.
    # A maintainer host-client file is only adopted by an explicit --env-file.
    if [ "$env_file_explicit" = 1 ]; then
        valid_env_file || { printf 'client environment must be an absolute regular file: %s\n' "$env_file" >&2; exit 1; }
        export PEANUT_CLIENT_ENV_FILE="$env_file"
    fi
else
valid_env_file || {
    printf 'client environment must be an absolute regular file: %s\n' "$env_file" >&2
    exit 1
}
read_env() { awk -F= -v name="$1" '$1 == name { sub(/^[^=]*=/, ""); print; exit }' "$env_file"; }
php_port=$(read_env PHP_PORT)
[ -n "$php_port" ] || { printf '%s\n' 'PHP_PORT is missing from the client environment' >&2; exit 1; }
fi
if [ -z "$core_web_dir" ] && { [ -e "$repo_dir/.local/core-dev.json" ] || [ -L "$repo_dir/.local/core-dev.json" ]; }; then
    case "$component" in
        web|platform|pc|mobile|uniapp-native) core_web_dir=$("$repo_dir/scripts/core-dev" web-path); saved_core_selection=1 ;;
    esac
fi
if [ -n "$core_web_dir" ]; then
    case "$component" in
        web|platform|pc) core_client=$component ;;
        mobile|uniapp-native) core_client=uniapp ;;
        *) printf '%s\n' 'this client does not consume local Web Core' >&2; exit 2 ;;
    esac
    "$repo_dir/scripts/local-core-web" link-status --core-dir "$core_web_dir" --client "$core_client"
    core_web_dir=$(CDPATH= cd -- "$core_web_dir" && pwd -P)
fi
client_environment() {
    if [ "$component" = uniapp-native ]; then "$@";
    else env -i PATH="$PATH" HOME="$HOME" PEANUT_CLIENT_ENV_FILE="$env_file" "$@"; fi
}
clean_exec() {
    if [ -n "$core_web_dir" ]; then
        client_environment node --input-type=module -e '
import { existsSync, readFileSync, readdirSync, realpathSync } from "node:fs";
import { join } from "node:path";
import { spawn, spawnSync } from "node:child_process";
import { pathToFileURL } from "node:url";

const [repository, core, client, savedSelection, command, ...args] = process.argv.slice(1);
const { acquireClientLinks } = await import(pathToFileURL(join(repository, "scripts", "local-core-links.mjs")));
const linkLease = acquireClientLinks(repository, [client], `watch:${client}`);
const groups = new Set();
const leases = [linkLease];
// No native child starts before all link/output writers and source rechecks.
process.on("exit", () => { if (groups.size === 0) for (const lease of [...leases].reverse()) lease.release(); });
if (savedSelection === "1") {
    const selectedCore = spawnSync(join(repository, "scripts", "core-dev"), ["web-path"], { encoding: "utf8" });
    if (selectedCore.status !== 0 || realpathSync(selectedCore.stdout.trim()) !== realpathSync(core)) {
        throw new Error("Saved Core selection changed before client link admission");
    }
}
const readJson = (path) => JSON.parse(readFileSync(path, "utf8"));
const workspace = readJson(join(core, "package.json"));
if (workspace.name !== "@peanut-admin/web-workspace") {
    throw new Error("Selected Core workspace identity is invalid");
}
if (!existsSync(join(core, "node_modules", "typescript", "bin", "tsc"))) {
    throw new Error("Selected Core compiler is missing; install its frozen workspace dependencies in an idle window before starting dev");
}
const packages = new Map();
for (const entry of readdirSync(join(core, "packages"), { withFileTypes: true })) {
    if (!entry.isDirectory() || !/^[a-z][a-z0-9-]*$/.test(entry.name)) continue;
    const root = join(core, "packages", entry.name);
    if (!existsSync(join(root, "package.json"))) continue;
    const manifest = readJson(join(root, "package.json"));
    if (manifest.name === `@peanut-admin/${entry.name}`) packages.set(manifest.name, { root, manifest });
}
const consumer = readJson(join(repository, client, "package.json"));
const direct = Object.keys({ ...consumer.dependencies, ...consumer.optionalDependencies })
    .filter((name) => packages.has(name));
if (direct.length === 0) throw new Error("Client has no declared local Core dependency");
for (const name of direct) {
    if (realpathSync(join(repository, client, "node_modules", name)) !== realpathSync(packages.get(name).root)) {
        throw new Error(`Client does not link to the selected Core package: ${name}`);
    }
}
const seen = new Set();
const selected = [];
function select(name) {
    if (seen.has(name)) return;
    seen.add(name);
    const { root, manifest } = packages.get(name);
    for (const dependency of Object.keys({ ...manifest.dependencies, ...manifest.peerDependencies, ...manifest.optionalDependencies })) {
        if (packages.has(dependency)) select(dependency);
    }
    if (!existsSync(join(root, "tsconfig.json"))) throw new Error(`Core compiler configuration missing: ${name}`);
    if (typeof manifest.scripts?.watch !== "string" || manifest.scripts.watch.trim() === "") {
        throw new Error(`Core package has no native watch script: ${name}`);
    }
    selected.push({ name, root });
}
direct.forEach(select);

// A package output has one foreground compiler owner, even across clients.
const { acquireCoreWriters } = await import(pathToFileURL(join(core, "scripts", "local-core-writer.mjs")));
const lease = acquireCoreWriters(core, selected.map(({ name }) => name.split("/")[1]), { repository, operation: `watch:${client}` });
leases.push(lease);
// Recheck after both writer sets are acquired; keep the link record until exit.
for (const name of direct) {
    if (realpathSync(join(repository, client, "node_modules", name)) !== realpathSync(packages.get(name).root)) {
        throw new Error(`Client Core source changed during admission: ${name}`);
    }
}

// These process groups belong to this foreground dev command only.
let stopping = false;
let forceTimer;
let cleanupTimer;
function signalChildren(signal) {
    for (const pid of groups) {
        try { process.kill(-pid, signal); }
        catch (error) {
            if (error.code === "ESRCH") groups.delete(pid);
            else console.error(error);
        }
    }
}
function finishCleanup() {
    for (const pid of groups) {
        try { process.kill(-pid, 0); }
        catch (error) { if (error.code === "ESRCH") groups.delete(pid); }
    }
    if (groups.size === 0) {
        clearTimeout(forceTimer);
        clearInterval(cleanupTimer);
    }
}
function stop(code) {
    if (stopping) return;
    stopping = true;
    process.exitCode = code;
    signalChildren("SIGTERM");
    forceTimer = setTimeout(() => {
        signalChildren("SIGKILL");
        clearInterval(cleanupTimer);
    }, 5000);
    cleanupTimer = setInterval(finishCleanup, 50);
    finishCleanup();
}
function start(label, executable, arguments_, cwd, watcher) {
    const child = spawn(executable, arguments_, { cwd, env: lease.env, stdio: "inherit", detached: true });
    if (child.pid) groups.add(child.pid);
    child.on("error", (error) => { console.error(`${label}: ${error.message}`); stop(1); });
    child.on("close", (code, signal) => {
        if (!stopping) stop(watcher && code === 0 ? 1 : (code ?? (signal === "SIGINT" ? 130 : 143)));
        finishCleanup();
    });
}
process.on("SIGINT", () => stop(130));
process.on("SIGTERM", () => stop(143));
process.on("SIGHUP", () => stop(129));
for (const { name, root } of selected) {
    console.log(`local Core watch: ${name}`);
    start(name, "corepack", ["pnpm", "--filter", name, "run", "watch"], core, true);
}
start(client, command, args, process.cwd(), false);
' "$repo_dir" "$core_web_dir" "$core_client" "$saved_core_selection" "$@"
        return
    fi
    client_environment "$@"
}

case "$component" in
    uniapp-native)
        [ "$dry_run" != 1 ] || { printf 'component=uniapp-native command=uni'; printf ' <%s>' "$@"; printf '\n'; exit 0; }
        clean_exec uni "$@"
        ;;
    web)
        listen_port=$(read_env VITE_PORT)
        [ "$dry_run" != 1 ] || {
            printf 'component=web listen_port=%s api_origin=http://127.0.0.1:%s\n' "$listen_port" "$php_port"
            exit 0
        }
        clean_exec vite --config ./config/vite.config.dev.ts --host 127.0.0.1 --port "$listen_port" "$@"
        ;;
    platform)
        listen_port=$(read_env PLATFORM_PORT)
        [ "$dry_run" != 1 ] || {
            printf 'component=platform listen_port=%s api_origin=http://127.0.0.1:%s\n' "$listen_port" "$php_port"
            exit 0
        }
        clean_exec vite --configLoader runner --host 127.0.0.1 --port "$listen_port" "$@"
        ;;
    pc)
        listen_port=$(read_env PC_PORT)
        [ "$dry_run" != 1 ] || {
            printf 'component=pc listen_port=%s api_origin=http://127.0.0.1:%s\n' "$listen_port" "$php_port"
            exit 0
        }
        clean_exec nuxt dev --host 127.0.0.1 --port "$listen_port" "$@"
        ;;
    mobile)
        listen_port=$(read_env MOBILE_PORT)
        [ "$dry_run" != 1 ] || {
            printf 'component=mobile listen_port=%s api_origin=http://127.0.0.1:%s\n' "$listen_port" "$php_port"
            exit 0
        }
        clean_exec uni --host 127.0.0.1 --port "$listen_port" "$@"
        ;;
    docs)
        listen_port=$(read_env DOCS_PORT)
        [ "$dry_run" != 1 ] || {
            printf 'component=docs listen_port=%s\n' "$listen_port"
            exit 0
        }
        clean_exec vitepress dev . --host 127.0.0.1 --port "$listen_port" "$@"
        ;;
    *) printf 'Unsupported local client: %s\n' "$component" >&2; exit 2 ;;
esac
