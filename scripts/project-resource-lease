#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Peanut Admin project resource lease registry

Usage:
  scripts/project-resource-lease claim \
    --lease <run-id> --owner <owner> [--thread <thread-id>] \
    --candidate <40-hex-commit> [--candidate-repository <absolute-path>] \
    [--parent-lease <lease-id>] \
    [--role collaboration-read-existing --operation-contract <canonical-json>] \
    --gate <gate-name> [--ttl <seconds>] \
    --resource <type=value> [--resource <type=value> ...]
  scripts/project-resource-lease renew --lease <run-id> --owner <owner> [--ttl <seconds>]
  scripts/project-resource-lease release --lease <run-id> --owner <owner>
  scripts/project-resource-lease list
  scripts/project-resource-lease show --lease <run-id> [--verify-locks]
  scripts/project-resource-lease prune-expired

Examples:
  scripts/project-resource-lease claim \
    --lease mt05-browser-a1b2c3d --owner 019f-thread-id \
    --candidate 0123456789abcdef0123456789abcdef01234567 \
    --gate mt05-browser --ttl 14400 \
    --resource mysql-db=pa_mt05_browser_a1b2c3d \
    --resource port=18158 \
    --resource port=15183 \
    --resource output-dir=/absolute/path/to/evidence

The registry is local to this repository's Git common directory and is shared by
all Peanut Admin worktrees. It stores identities only; never pass credentials as
resource values.

Schema sharing requires a registered lease_policy.shared_access table/primary-key
contract and one mysql-access JSON resource per mysql-schema. JSON fields are
schema, operation (read|transaction|ddl|exclusive), complete=true, and tables.
Each table entry has table, access (read|write), rows ("*" or primary-key tuples).
Row keys use registered unsigned-decimal primary keys, in registered column order.
All transaction reads, writes, locking reads, triggers, cascades, unique checks and
business invariants must be covered; unknown/range/insert effects use whole-table
scope, or exclusive schema access. Locking reads are writes for this contract.
This is an execution declaration, not a SQL sandbox. DDL/exclusive uses tables=[].
Only read/read or disjoint complete table/row sets share; labels never isolate data.

collaboration-read-existing is a closed, same-owner/thread observation role, not
schema sharing. It requires a real runtime parent, independently owns its source
worktree, and accepts only its fixed operation contract (no --resource arguments).
The parent retains every runtime lock and its original candidate. An observer
record, including an expired one, prevents parent release until its owner safely
finishes the observation and explicitly releases the child; prune never removes it.
EOF
}

die() {
  printf 'resource-lease: %s\n' "$*" >&2
  exit 1
}

[[ $# -ge 1 ]] || { usage; exit 2; }
COMMAND="$1"
shift

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die 'run inside the Peanut Admin Git repository'
COMMON_DIR="$(git rev-parse --git-common-dir 2>/dev/null)" || die 'Git common directory is unavailable'
if [[ "$COMMON_DIR" != /* ]]; then
  COMMON_DIR="$REPO_ROOT/$COMMON_DIR"
fi
COMMON_DIR="$(cd "$COMMON_DIR" && pwd -P)"
REGISTRY_ROOT="$COMMON_DIR/peanut-admin-resource-leases"
LEASES_DIR="$REGISTRY_ROOT/leases"
RESOURCES_DIR="$REGISTRY_ROOT/resources"
MUTEX_DIR="$REGISTRY_ROOT/mutex"

umask 077
mkdir -p "$LEASES_DIR" "$RESOURCES_DIR"

LOCK_HELD=0
OBSERVATION_WINDOW_CHILD=0
COMMAND_COMPLETED=0
CLAIM_TMP_DIR=""
CREATED_RESOURCES_FILE=""
SEEN_FILE=""

remove_resource_dir() {
  local resource_dir="$1"
  [[ "$resource_dir" == "$RESOURCES_DIR/"* ]] || die 'refusing to remove a resource outside the registry'
  rm -f "$resource_dir/lease" "$resource_dir/type" "$resource_dir/value"
  rmdir "$resource_dir" 2>/dev/null || true
}

cleanup() {
  local status=$?
  # Bash 3.2 can enter EXIT with status 0 after a fatal nounset expansion.
  # Only reaching the normal dispatch end (or explicit help) permits success.
  if [[ "$status" == 0 && "$COMMAND_COMPLETED" != 1 ]]; then status=1; fi
  if [[ -n "$CREATED_RESOURCES_FILE" && -f "$CREATED_RESOURCES_FILE" ]]; then
    while IFS= read -r resource_dir; do
      [[ -n "$resource_dir" ]] && remove_resource_dir "$resource_dir"
    done < "$CREATED_RESOURCES_FILE"
    rm -f "$CREATED_RESOURCES_FILE"
  fi
  if [[ -n "$CLAIM_TMP_DIR" && -d "$CLAIM_TMP_DIR" ]]; then
    rm -f "$CLAIM_TMP_DIR/metadata.tsv" "$CLAIM_TMP_DIR/resources.tsv"
    rmdir "$CLAIM_TMP_DIR" 2>/dev/null || true
  fi
  if [[ -n "$SEEN_FILE" && -f "$SEEN_FILE" ]]; then
    rm -f "$SEEN_FILE"
  fi
  if [[ "$LOCK_HELD" == '1' ]]; then
    rm -f "$MUTEX_DIR/pid"
    rmdir "$MUTEX_DIR" 2>/dev/null || true
  fi
  exit "$status"
}
trap cleanup EXIT INT TERM

acquire_mutex() {
  local attempt holder
  if [[ "$OBSERVATION_WINDOW_CHILD" == 1 ]]; then
    # Only the fixed read-only show mode can reuse its actual PHP parent's lock.
    # Descriptor 3 is the private PID-file capability created by that PHP API.
    python3 - "$MUTEX_DIR" "$$" "$PPID" <<'PY' || die 'observation mutex context rejected'
import os, pathlib, stat, subprocess, sys
directory, verifier_pid, php_pid = sys.argv[1:]
p = pathlib.Path(directory); identity = p/'pid'
if str(p.resolve()) != directory or p.is_symlink() or not p.is_dir() or identity.is_symlink() or not identity.is_file():
    raise SystemExit('resource-lease: missing observation mutex')
actual_parent = subprocess.check_output(['/bin/ps','-p',verifier_pid,'-o','ppid='],text=True).strip()
fd = os.fstat(3); named = identity.stat()
if (os.getppid() != int(verifier_pid) or actual_parent != php_pid
    or not stat.S_ISREG(fd.st_mode) or fd.st_nlink != 1 or fd.st_uid != os.geteuid() or stat.S_IMODE(fd.st_mode) != 0o600
    or (fd.st_dev,fd.st_ino) != (named.st_dev,named.st_ino)
    or os.pread(3,64,0).decode().strip() != php_pid
    or identity.read_text().strip() != php_pid):
    raise SystemExit('resource-lease: observation mutex is not held by actual PHP parent')
os.kill(int(php_pid),0)
PY
    return
  fi
  for attempt in $(seq 1 100); do
    if mkdir "$MUTEX_DIR" 2>/dev/null; then
      printf '%s\n' "$$" > "$MUTEX_DIR/pid"
      LOCK_HELD=1
      return 0
    fi
    holder="$(cat "$MUTEX_DIR/pid" 2>/dev/null || true)"
    if [[ "$holder" =~ ^[0-9]+$ ]] && ! kill -0 "$holder" 2>/dev/null; then
      rm -f "$MUTEX_DIR/pid"
      rmdir "$MUTEX_DIR" 2>/dev/null || true
      continue
    fi
    sleep 0.05
  done
  die 'registry is busy; retry after the current claim/release operation finishes'
}

release_mutex() {
  if [[ "$LOCK_HELD" == '1' ]]; then
    rm -f "$MUTEX_DIR/pid"
    rmdir "$MUTEX_DIR" 2>/dev/null || true
    LOCK_HELD=0
  fi
}

validate_lease_id() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die 'lease id must be 1-64 letters, digits, dot, underscore, or hyphen'
}

validate_owner() {
  [[ -n "$1" && "$1" != *$'\n'* && "$1" != *$'\t'* ]] || die 'owner must be non-empty and contain no tabs/newlines'
}

validate_resource() {
  local resource="$1" type value
  [[ "$resource" == *=* ]] || die "resource must use type=value: $resource"
  type="${resource%%=*}"
  value="${resource#*=}"
  [[ "$type" =~ ^[a-z][a-z0-9_-]{0,31}$ ]] || die "invalid resource type: $type"
  [[ -n "$value" && "$value" != *$'\n'* && "$value" != *$'\t'* ]] || die "resource value must be non-empty and contain no tabs/newlines: $type"
}

# Identity proofs remain in resources.tsv. Only registered schema leases may
# share these fields; mutable directories, controllers, listeners and writers do not.
schema_identity_resource() {
  [[ "${SCHEMA_MODE:-exclusive}" == schema || "${SCHEMA_MODE:-exclusive}" == schema-shared ]] || return 1
  case "$1" in
    mysql-schema) [[ "$SCHEMA_MODE" == schema-shared ]] ;;
    resource-id|database-resource|endpoint|resource-scope|scope|gate|mysql-db|database|mysql-access|registry-sha256|registry-tool-sha256|environment|consumer|host|version) return 0 ;;
    *) return 1 ;;
  esac
}

# Runs under the existing registry mutex. No database access. Physical endpoint
# and complete physical table/primary-key sets, never aliases, define conflicts.
mysql_claim_policy() {
  python3 - "$LEASES_DIR" "${PEANUT_RESOURCE_REGISTRY:-}" "$1" "$2" "$3" "${@:4}" <<'PY'
import hashlib, json, pathlib, re, subprocess, sys, time
leases, registry_path, own, gate, operation, *args = sys.argv[1:]
def fail(message):
    raise SystemExit('resource-lease: ' + message)
def resources(items):
    result = {}
    for item in items:
        k, v = item.split('=', 1)
        result.setdefault(k, set()).add(v)
    return result
def object_without_duplicates(pairs):
    result = {}
    for key, value in pairs:
        if key in result: fail('duplicate MySQL access JSON field')
        result[key] = value
    return result
requested = resources(args)
active = []
active_gates = {}
expired_scopes = set()
lock_resources = {}
known_leases = set()
try:
    for lock in (pathlib.Path(leases).parent/'resources').iterdir():
        if lock.is_symlink() or not lock.is_dir(): raise ValueError('invalid resource lock directory')
        values = []
        for field in ('lease', 'type', 'value'):
            p = lock/field
            if p.is_symlink() or not p.is_file(): raise ValueError('invalid resource lock proof')
            value = p.read_text().removesuffix('\n')
            if not value or '\n' in value or '\t' in value: raise ValueError('invalid resource lock value')
            values.append(value)
        holder, kind, value = values
        if lock.name != hashlib.sha256((kind+'\t'+value).encode()).hexdigest():
            raise ValueError('invalid resource lock digest')
        lock_resources.setdefault(holder, set()).add((kind, value))
    lock_holders = set(lock_resources)
except (OSError, ValueError):
    fail('cannot establish resource lock boundary')
for path in pathlib.Path(leases).glob('*'):
    if not path.is_dir() or path.name.startswith('.') or path.name == own:
        continue
    try:
        # Native lease identity starts at metadata.tsv. Empty directories and
        # registry-only snapshots are not leases, unless a lock references them.
        # Preserve them; partial/corrupt lease records still fail closed.
        if not (path/'metadata.tsv').exists():
            entries = {p.name for p in path.iterdir()}
            archive = entries == {'registry.json'} and (path/'registry.json').is_file() and not (path/'registry.json').is_symlink()
            if (not entries or archive) and path.name not in lock_holders: continue
            raise ValueError('partial lease identity')
        rows = [line.split('\t') for line in (path/'metadata.tsv').read_text().splitlines()]
        keys = {'lease', 'owner', 'thread', 'candidate', 'candidate_repository', 'parent_lease', 'gate', 'worktree', 'created_at', 'expires_at', 'status'}
        if any(len(row) != 2 for row in rows): raise ValueError('invalid metadata fields')
        m = dict(rows)
        if (len(rows) != len(keys) or set(m) != keys or len(m) != len(rows)
            or any(not value for key,value in m.items() if key != 'parent_lease')
            or m['lease'] != path.name or m['status'] != 'ACTIVE'
            or not m['created_at'].isdigit() or not m['expires_at'].isdigit()
            or int(m['created_at']) > time.time() or int(m['expires_at']) <= int(m['created_at'])):
            raise ValueError('invalid lease metadata')
        known_leases.add(path.name)
        expired = int(m['expires_at']) <= time.time()
        resource_rows = [line.split('\t') for line in (path/'resources.tsv').read_text().splitlines()]
        if not resource_rows or any(len(row) != 3 or not all(row) for row in resource_rows):
            raise ValueError('invalid resource fields')
        if any(row[0] != hashlib.sha256((row[1]+'\t'+row[2]).encode()).hexdigest() for row in resource_rows):
            raise ValueError('invalid resource digest')
        r = resources(row[1]+'='+row[2] for row in resource_rows)
        for kind, value in lock_resources.get(path.name, set()):
            r.setdefault(kind, set()).add(value)
        if expired and not r.get('mysql-access') and path.name not in lock_holders: continue
        # Shared leases have no single schema lock directory. Keep their
        # persisted boundary exclusive after expiry until their owner releases
        # it. Legacy leases with unreturned locks retain their declared physical
        # boundary too; TTL alone cannot prove the old process has stopped.
        if expired: expired_scopes.add(path.name)
        active.append((path.name, r))
        active_gates[path.name] = m['gate']
    except (ValueError, OSError, KeyError):
        fail('cannot establish active lease boundary: '+path.name)
# A remaining physical lock without metadata is an exclusive boundary, never
# evidence of a compatible executor. Keep its real resource values for alias
# resolution; unrelated non-MySQL locks still use the ordinary exact lock path.
for holder in lock_holders - known_leases - {own}:
    active.append((holder, resources(kind+'='+value for kind, value in lock_resources[holder])))
    expired_scopes.add(holder)
special = bool(requested.get('mysql-schema') or requested.get('mysql-server') or requested.get('mysql-access'))
schema_active = any(r.get('mysql-schema') for _, r in active)
potential_management = any(requested.get(t) for t in ['port', 'mysql-resource', 'docker-container', 'docker-volume'])
database_access = bool(requested.get('mysql-db') or requested.get('database'))
if not special and not potential_management and (not schema_active or not database_access):
    print('exclusive'); sys.exit(0)
p = pathlib.Path(registry_path)
if not registry_path or not p.is_absolute() or p.is_symlink() or not p.is_file():
    fail('explicit registry required for MySQL schema/server boundary')
raw = p.read_bytes()
try: registry = json.loads(raw)
except ValueError: fail('invalid resource registry')
dbs = registry.get('resources', {}).get('databases', [])
policies = {}
for d in dbs:
    policy = d.get('lease_policy')
    if not isinstance(policy, dict) or policy.get('mode') != 'schema': continue
    e = d.get('upstream_endpoint') or {}
    physical = policy.get('physical_endpoint')
    server = policy.get('physical_resource_id')
    aliases = policy.get('server_resources')
    limit = policy.get('max_executors')
    if (type(limit) is not int or not 1 <= limit <= 8 or physical != str(e.get('host'))+':'+str(e.get('port'))
        or not isinstance(server, str) or not server or not isinstance(aliases, list) or not aliases
        or any(not isinstance(a, str) or re.fullmatch(r'(mysql-resource|docker-container|docker-volume)=[^\s=]+', a) is None for a in aliases)
        or {a.split('=',1)[0] for a in aliases} != {'mysql-resource', 'docker-container', 'docker-volume'}
        or 'mysql-resource='+server not in aliases):
        fail('invalid schema policy / missing physical management mapping')
    mapping = {'aliases': set(aliases), 'max_executors': limit, 'physical_resource_id': server}
    previous = policies.get(physical)
    if previous and previous != mapping: fail('inconsistent physical endpoint schema policy')
    policies[physical] = mapping
physical_names = {physical: set() for physical in policies}
for d in dbs:
    e = d.get('upstream_endpoint') or {}
    physical = str(e.get('host'))+':'+str(e.get('port'))
    if physical not in physical_names: continue
    names = [d.get('database')]
    for group in d.get('synthetic_databases', {}).values():
        if not isinstance(group, list): fail('invalid exact schema allowlist')
        names += group
    physical_names[physical].update(n for n in names if isinstance(n, str))
management_endpoints = set(requested.get('mysql-server', set()))
for physical, policy in policies.items():
    management_set = policy['aliases'] | {'port='+physical.rsplit(':', 1)[1]}
    if any(a.split('=', 1)[1] in requested.get(a.split('=', 1)[0], set()) for a in management_set):
        management_endpoints.add(physical)
if (special or management_endpoints) and requested.get('registry-sha256', set()) != {hashlib.sha256(raw).hexdigest()}:
    fail('schema/server registry digest must match current registry')
for value in management_endpoints:
    if value not in policies: fail('server endpoint not registered for schema locking')
    management_set = policies[value]['aliases'] | {'port='+value.rsplit(':', 1)[1], 'mysql-server='+value}
    if any(a.split('=', 1)[1] not in requested.get(a.split('=', 1)[0], set()) for a in management_set):
        fail('mysql-server requires the complete registered service/container/volume/port lock set')
schemas = requested.get('mysql-schema', set())
covered = set()
schema_databases = {}
for value in schemas:
    physical, sep, name = value.rpartition('/')
    if not sep or not re.fullmatch(r'[A-Za-z0-9_]{1,64}', name): fail('invalid exact schema key')
    matches = []
    for d in dbs:
        if d.get('stable_resource_id') not in requested.get('resource-id', set()) | requested.get('database-resource', set()): continue
        policy = d.get('lease_policy') or {}
        e = d.get('upstream_endpoint') or {}
        names = [d.get('database')]
        for group in d.get('synthetic_databases', {}).values():
            if not isinstance(group, list): fail('invalid exact schema allowlist')
            names += group
        if policy.get('mode') == 'schema' and policy.get('physical_endpoint') == physical and name in names and e.get('endpoint_id') in requested.get('endpoint', set()):
            if d.get('lease_gate') != gate: fail('schema resource gate mismatch')
            if 'qualification' in gate or 'performance' in gate or 'recovery' in gate: fail('qualification retains server exclusivity')
            matches.append(d)
    if len(matches) != 1: fail('schema resource/endpoint/allowlist mismatch')
    covered.add(name)
    schema_databases[value] = matches[0]
if schemas and (requested.get('mysql-db', set()) != covered or requested.get('database', set()) != covered):
    fail('mysql-db/database proof requires exact schema coverage')
if schemas and operation == 'verify':
    try:
        proof = dict(line.split('\t') for line in (pathlib.Path(leases)/own/'metadata.tsv').read_text().splitlines())
        repository = pathlib.Path(proof['candidate_repository']).resolve(strict=True)
        worktree = pathlib.Path(proof['worktree']).resolve(strict=True)
        top = subprocess.check_output(['git', '-C', str(repository), 'rev-parse', '--show-toplevel'], stderr=subprocess.DEVNULL, text=True).strip()
        head = subprocess.check_output(['git', '-C', str(repository), 'rev-parse', 'HEAD^{commit}'], stderr=subprocess.DEVNULL, text=True).strip()
        if repository != worktree or repository != pathlib.Path(top).resolve() or head != proof['candidate']:
            fail('MySQL lease candidate no longer matches the actual Git worktree HEAD')
    except (OSError, KeyError, ValueError, subprocess.CalledProcessError):
        fail('cannot establish the actual MySQL candidate Git identity')

def access_scopes(r, registered=None):
    """No access declaration on a historical schema lease means exclusive."""
    result = {}
    for raw_scope in r.get('mysql-access', set()):
        if len(raw_scope.encode()) > 65536: fail('MySQL access declaration too large')
        try: scope = json.loads(raw_scope, object_pairs_hook=object_without_duplicates)
        except ValueError: fail('invalid MySQL access JSON')
        if (not isinstance(scope, dict) or set(scope) != {'schema', 'operation', 'complete', 'tables'}
            or scope['complete'] is not True or not isinstance(scope['schema'], str)
            or scope['schema'] not in r.get('mysql-schema', set())
            or scope['schema'] in result or scope['operation'] not in ('read', 'transaction', 'ddl', 'exclusive')
            or not isinstance(scope['tables'], list)):
            fail('incomplete/unknown MySQL access scope')
        key = scope['schema']
        if not re.fullmatch(r'[a-z][a-z0-9_]{0,63}', key.rpartition('/')[2]):
            fail('shared schema requires a canonical lowercase registered name')
        if registered is None:
            physical, _, name = key.rpartition('/')
            matches = [d for d in dbs if (d.get('lease_policy') or {}).get('physical_endpoint') == physical
                       and (d.get('database') == name or any(name in g for g in d.get('synthetic_databases', {}).values()))
                       and d.get('stable_resource_id') in r.get('resource-id', set()) | r.get('database-resource', set())]
            if len(matches) != 1: fail('active MySQL scope lacks exact registered schema')
            database = matches[0]
        else:
            database = registered[key]
        contract = (database.get('lease_policy') or {}).get('shared_access')
        if (not isinstance(contract, dict) or set(contract) != {'schema_version', 'tables'}
            or type(contract['schema_version']) is not int or contract['schema_version'] != 1
            or not isinstance(contract['tables'], dict) or not contract['tables']):
            fail('schema sharing needs a registered physical table/primary-key contract')
        table_contracts = contract['tables']
        for table, identity in table_contracts.items():
            if (not re.fullmatch(r'[a-z][a-z0-9_]{0,63}', table) or not isinstance(identity, dict)
                or set(identity) != {'primary_key', 'key_encoding'} or not isinstance(identity['primary_key'], list)
                or any(not isinstance(c, str) or not re.fullmatch(r'[a-z][a-z0-9_]{0,63}', c) for c in identity['primary_key'])
                or len(set(identity['primary_key'])) != len(identity['primary_key'])
                or identity['key_encoding'] != 'unsigned-decimal'):
                fail('invalid registered physical table/primary-key contract')
        tables = {}
        for entry in scope['tables']:
            if (not isinstance(entry, dict) or set(entry) != {'table', 'access', 'rows'}
                or not isinstance(entry['table'], str) or entry['table'] not in table_contracts
                or entry['table'] in tables or entry['access'] not in ('read', 'write')):
                fail('unknown/duplicate physical table or access operation')
            rows = entry['rows']
            primary_key = table_contracts[entry['table']]['primary_key']
            if rows != '*':
                if not primary_key or not isinstance(rows, list) or not rows:
                    fail('unknown/empty row scope must use whole-table access')
                for row in rows:
                    if (not isinstance(row, list) or len(row) != len(primary_key)
                        or any(not isinstance(v, str) or not re.fullmatch(r'0|[1-9][0-9]*', v)
                               or len(v) > 20 or int(v) > 18446744073709551615 for v in row)):
                        fail('row scope needs canonical registered unsigned primary-key tuples')
                rows = {tuple(row) for row in rows}
            tables[entry['table']] = (entry['access'], rows)
        op = scope['operation']
        if (op in ('ddl', 'exclusive') and tables
            or op in ('read', 'transaction') and not tables
            or op == 'read' and any(mode != 'read' for mode, _ in tables.values())
            or op == 'transaction' and not any(mode == 'write' for mode, _ in tables.values())):
            fail('MySQL operation does not match complete access set')
        result[key] = (op, tables)
    return result

scopes = access_scopes(requested, schema_databases)
for key, database in schema_databases.items():
    if (database.get('lease_policy') or {}).get('shared_access') is not None and key not in scopes:
        fail('registered shared schema requires an explicit complete mysql-access declaration')
if scopes and set(scopes) != schemas:
    fail('mysql-access requires exact schema coverage; split mixed access contracts')

def conflicts(left, right):
    if left is None or right is None or left[0] in ('ddl', 'exclusive') or right[0] in ('ddl', 'exclusive'):
        return True
    for table in left[1].keys() & right[1].keys():
        lm, lr = left[1][table]
        rm, rr = right[1][table]
        if lm == rm == 'read': continue
        if lr == '*' or rr == '*' or lr & rr: return True
    return False

active_scopes = {}
for lease, r in active:
    if not r.get('mysql-access'): continue
    if lease in expired_scopes: continue
    # Stale registration or missing identity is never a proof of non-conflict.
    if r.get('registry-sha256') != {hashlib.sha256(raw).hexdigest()}:
        fail('active shared lease registry digest is stale: '+lease)
    parsed = access_scopes(r)
    if set(parsed) != r.get('mysql-schema', set()): fail('active access coverage is incomplete: '+lease)
    for key in parsed:
        physical, _, name = key.rpartition('/')
        matches = [d for d in dbs if (d.get('lease_policy') or {}).get('physical_endpoint') == physical
                   and (d.get('database') == name or any(name in g for g in d.get('synthetic_databases', {}).values()))
                   and d.get('stable_resource_id') in r.get('resource-id', set()) | r.get('database-resource', set())]
        if (len(matches) != 1 or matches[0].get('lease_gate') != active_gates[lease]
            or (matches[0].get('upstream_endpoint') or {}).get('endpoint_id') not in r.get('endpoint', set())):
            fail('active shared lease identity/gate/endpoint mismatch: '+lease)
    names = {key.rpartition('/')[2] for key in parsed}
    if r.get('mysql-db') != names or r.get('database') != names:
        fail('active shared lease database coverage mismatch: '+lease)
    active_scopes[lease] = parsed
def affected(r, physical):
    policy = policies.get(physical)
    if policy is None: fail('active schema lacks current physical management mapping')
    aliases = policy['aliases']
    # Legacy database-only leases did not necessarily claim the DB listener.
    # They remain exclusive against schema executors on this physical service.
    legacy_names = (r.get('mysql-db', set()) | r.get('database', set())) if not r.get('mysql-schema') else set()
    if legacy_names and not legacy_names <= set().union(*physical_names.values()):
        fail('legacy database lease lacks physical management mapping')
    return (physical in r.get('mysql-server', set()) or physical.rsplit(':',1)[1] in r.get('port', set())
            or bool(legacy_names & physical_names[physical])
            or any(a.split('=',1)[1] in r.get(a.split('=',1)[0], set()) for a in aliases))
for physical in management_endpoints:
    for lease, r in active:
        if affected(r, physical) or any(v.rpartition('/')[0] == physical for v in r.get('mysql-schema', set())):
            fail('unreturned runtime/management lease conflicts with server operation: '+lease)
endpoints = {v.rpartition('/')[0] for v in schemas}
for physical in endpoints:
    if affected(requested, physical): fail('schema lease cannot also hold server management/port lock')
    count = 0
    for lease, r in active:
        if affected(r, physical): fail('server-exclusive lease conflicts with schema: '+lease)
        same = {v for v in r.get('mysql-schema', set()) if v.rpartition('/')[0] == physical}
        if same:
            for key in same & schemas:
                if conflicts(scopes.get(key), active_scopes.get(lease, {}).get(key)):
                    fail('overlapping/exclusive physical schema access: '+lease)
            count += 1
    if count >= policies[physical]['max_executors']: fail('registered maximum schema runtime executors reached')
for lease, r in active:
    for value in r.get('mysql-schema', set()):
        if affected(requested, value.rpartition('/')[0]): fail('active schema conflicts with server operation: '+lease)
# A mixed exclusive/shared request retains a physical schema lock for every
# schema; reject it rather than accidentally serializing or weakening a subset.
shared = [s[0] in ('read', 'transaction') for s in scopes.values()]
if any(shared) and not all(shared): fail('split shared and exclusive schema leases')
print('schema-shared' if any(shared) else 'schema' if schemas else 'exclusive')
PY
}

resource_hash() {
  printf '%s\t%s' "$1" "$2" | shasum -a 256 | awk '{print $1}'
}

metadata_value() {
  local file="$1" key="$2"
  awk -F '\t' -v wanted="$key" '$1 == wanted {sub(/^[^\t]*\t/, ""); print; exit}' "$file"
}

lease_expired() {
  local lease_dir="$1" expires_at now
  expires_at="$(metadata_value "$lease_dir/metadata.tsv" expires_at 2>/dev/null || true)"
  now="$(date +%s)"
  [[ "$expires_at" =~ ^[0-9]+$ && "$expires_at" -le "$now" ]]
}

lease_has_resource() {
  local lease_dir="$1" resource_type="$2" resource_value="$3"
  awk -F '\t' -v wanted_type="$resource_type" -v wanted_value="$resource_value" '
    $2 == wanted_type && $3 == wanted_value { found=1 }
    END { exit found ? 0 : 1 }
  ' "$lease_dir/resources.tsv"
}

active_child_lease() {
  local parent_lease="$1" child_dir child_id child_parent
  shopt -s nullglob
  for child_dir in "$LEASES_DIR"/*; do
    [[ -d "$child_dir" && -f "$child_dir/metadata.tsv" ]] || continue
    child_id="$(metadata_value "$child_dir/metadata.tsv" lease)"
    [[ "$child_id" != "$parent_lease" ]] || continue
    child_parent="$(metadata_value "$child_dir/metadata.tsv" parent_lease 2>/dev/null || true)"
    if [[ "$child_parent" == "$parent_lease" ]] && {
      ! lease_expired "$child_dir" || lease_has_resource "$child_dir" lease-role collaboration-read-existing;
    }; then
      printf '%s\n' "$child_id"
      shopt -u nullglob
      return 0
    fi
  done
  shopt -u nullglob
  return 1
}

read_lease_role() {
  local lease_dir="$1" role_count contract_count hash type value lock_dir field created expires now parent_expires
  LEASE_ROLE=""; OPERATION_CONTRACT=""
  role_count="$(awk -F '\t' '$2=="lease-role" {n++} END {print n+0}' "$lease_dir/resources.tsv")"
  contract_count="$(awk -F '\t' '$2=="operation-contract" {n++} END {print n+0}' "$lease_dir/resources.tsv")"
  if [[ "$role_count" == 0 && "$contract_count" == 0 ]]; then return; fi
  [[ "$role_count" == 1 && "$contract_count" == 1 ]] || die 'invalid observation role resources'
  LEASE_ROLE="$(awk -F '\t' '$2=="lease-role" {print $3}' "$lease_dir/resources.tsv")"
  OPERATION_CONTRACT="$(awk -F '\t' '$2=="operation-contract" {print $3}' "$lease_dir/resources.tsv")"
  [[ "$LEASE_ROLE" == collaboration-read-existing ]] || die 'unsupported lease role'
  [[ "$(awk -F '\t' '$2!="lease-role" && $2!="operation-contract" && $2!="gate" && $2!="worktree" {n++} END {print n+0}' "$lease_dir/resources.tsv")" == 0 \
    && "$(wc -l < "$lease_dir/resources.tsv" | tr -d ' ')" == 4 ]] || die 'observer cannot own runtime resources'
  [[ "$(metadata_value "$lease_dir/metadata.tsv" gate)" == collaboration-runtime-observation \
    && -n "$(metadata_value "$lease_dir/metadata.tsv" parent_lease)" ]] || die 'observer requires its dedicated gate and real parent'
  lease_has_resource "$lease_dir" gate collaboration-runtime-observation || die 'observer gate resource mismatch'
  lease_has_resource "$lease_dir" worktree "$(metadata_value "$lease_dir/metadata.tsv" worktree)" || die 'observer must own its source worktree'
  [[ ! -L "$lease_dir" && ! -L "$lease_dir/metadata.tsv" && ! -L "$lease_dir/resources.tsv" ]] || die 'observer proof must be regular'
  awk -F '\t' '
    BEGIN {split("lease owner thread candidate candidate_repository parent_lease gate worktree created_at expires_at status", keys, " "); for (i in keys) allowed[keys[i]]=1}
    NF!=2 || !($1 in allowed) || seen[$1]++ || $2=="" {bad=1}
    END {exit bad || NR!=11 ? 1 : 0}
  ' "$lease_dir/metadata.tsv" || die 'observer metadata schema invalid'
  [[ "$(metadata_value "$lease_dir/metadata.tsv" status)" == ACTIVE \
    && "$(metadata_value "$lease_dir/metadata.tsv" lease)" == "$(basename "$lease_dir")" ]] || die 'observer identity/status invalid'
  created="$(metadata_value "$lease_dir/metadata.tsv" created_at)"
  expires="$(metadata_value "$lease_dir/metadata.tsv" expires_at)"; now="$(date +%s)"
  [[ "$created" =~ ^[0-9]+$ && "$expires" =~ ^[0-9]+$ \
    && "$created" -le "$now" && "$expires" -gt "$now" && "$expires" -gt "$created" ]] || die 'observer expired or invalid'
  validate_lease_id "$(metadata_value "$lease_dir/metadata.tsv" parent_lease)"
  parent_expires="$(metadata_value "$LEASES_DIR/$(metadata_value "$lease_dir/metadata.tsv" parent_lease)/metadata.tsv" expires_at)"
  [[ "$parent_expires" =~ ^[0-9]+$ && "$expires" -le "$parent_expires" ]] || die 'observer TTL exceeds runtime parent'
  awk -F '\t' 'NF!=3 || $1=="" || $2=="" || $3=="" || seen[$1]++ {bad=1} END {exit bad ? 1 : 0}' \
    "$lease_dir/resources.tsv" || die 'observer resource schema invalid'
  while IFS=$'\t' read -r hash type value; do
    validate_resource "$type=$value"
    [[ "$hash" == "$(resource_hash "$type" "$value")" ]] || die 'observer resource digest mismatch'
    lock_dir="$RESOURCES_DIR/$hash"
    [[ -d "$lock_dir" && ! -L "$lock_dir" ]] || die 'observer own lock missing'
    for field in lease type value; do [[ -f "$lock_dir/$field" && ! -L "$lock_dir/$field" ]] || die 'observer own lock invalid'; done
    [[ "$(cat "$lock_dir/lease")" == "$(metadata_value "$lease_dir/metadata.tsv" lease)" \
      && "$(cat "$lock_dir/type")" == "$type" && "$(cat "$lock_dir/value")" == "$value" ]] || die 'observer own lock ownership mismatch'
  done < "$lease_dir/resources.tsv"
}

# Runs only under the existing registry mutex. It proves the independently held
# runtime authority and the bounded source operation; the JSON never grants a DB.
validate_observation_parent_locked() {
  local parent_lease="$1" candidate="$2" candidate_repository="$3" worktree="$4" contract="$5"
  python3 - "$LEASES_DIR" "${PEANUT_RESOURCE_REGISTRY:-}" "$parent_lease" "$candidate" "$candidate_repository" "$worktree" "$contract" <<'PY' || die 'observation parent contract rejected'
import hashlib, json, pathlib, re, subprocess, sys
leases, registry_path, parent_id, candidate, source_root, worktree, raw_contract = sys.argv[1:]
def fail(message): raise SystemExit('resource-lease: observer '+message)
def unique(pairs):
    result = {}
    for k,v in pairs:
        if k in result: fail('duplicate contract field')
        result[k] = v
    return result
def git(root, *args):
    try: return subprocess.check_output(['git','-C',root,*args], stderr=subprocess.DEVNULL, text=True).strip()
    except (OSError, subprocess.CalledProcessError): fail('Git identity unavailable')
def exact_path(value):
    p = pathlib.Path(value)
    return p.is_absolute() and str(p.resolve()) == value
try: contract = json.loads(raw_contract, object_pairs_hook=unique)
except (ValueError, TypeError): fail('invalid operation contract')
keys = {'protocol','operation','resource_id','endpoint_id','database','environment','consumer',
        'resource_scope','gate','registry_sha256','credential_ref','instance_id','service_instance_id','source_tree','receipt_path'}
if not isinstance(contract, dict) or set(contract) != keys: fail('operation contract fields mismatch')
if raw_contract != json.dumps(contract, sort_keys=True, separators=(',',':'), ensure_ascii=False): fail('contract is not canonical JSON')
if any(not isinstance(v,str) or not v for k,v in contract.items() if k not in ('instance_id','service_instance_id')): fail('invalid contract value')
if (contract['protocol'] != 'peanut.collaboration-observation-authorization.v1'
    or contract['operation'] != 'collaboration-runtime-read-existing'
    or contract['environment'] != 'acceptance' or contract['consumer'] != 'host'
    or not re.fullmatch(r'[A-Za-z0-9_]{1,64}',contract['database'])): fail('operation is not the closed acceptance read')
identities = [contract['instance_id'],contract['service_instance_id']]
if any(x is not None for x in identities) and not all(isinstance(x,str) and re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._:-]{0,127}',x) for x in identities): fail('instance/service must be independently paired or both null')
lease_root = pathlib.Path(leases)
parent = lease_root / parent_id
metadata = dict(line.split('\t') for line in (parent/'metadata.tsv').read_text().splitlines())
runtime_root = metadata['candidate_repository']
if (not exact_path(source_root) or source_root != worktree
    or git(source_root,'rev-parse','--show-toplevel') != source_root
    or git(source_root,'rev-parse','HEAD') != candidate
    or git(source_root,'rev-parse','HEAD^{tree}') != contract['source_tree']
    or git(source_root,'status','--porcelain=v1','--untracked-files=no')): fail('source candidate/worktree drift')
if (not exact_path(runtime_root) or runtime_root != metadata['worktree']
    or git(runtime_root,'rev-parse','--show-toplevel') != runtime_root
    or git(runtime_root,'rev-parse','HEAD') != metadata['candidate']
    or git(runtime_root,'status','--porcelain=v1','--untracked-files=no')): fail('runtime candidate/worktree drift')
expected_common = str(lease_root.parent.parent.resolve())
for root in [source_root,runtime_root]:
    if git(root,'rev-parse','--path-format=absolute','--git-common-dir') != expected_common: fail('foreign candidate Git registry')
resources = {}
for line in (parent/'resources.tsv').read_text().splitlines():
    parts = line.split('\t')
    if len(parts) != 3: fail('invalid parent resource record')
    digest,kind,value = parts
    if (not re.fullmatch(r'[a-z][a-z0-9_-]{0,31}',kind) or not value
        or digest != hashlib.sha256((kind+'\t'+value).encode()).hexdigest()): fail('parent resource digest mismatch')
    values = resources.setdefault(kind,set())
    if value in values: fail('duplicate parent resource')
    values.add(value)
path = pathlib.Path(registry_path)
if not exact_path(registry_path) or not path.is_file(): fail('explicit registry required')
raw = path.read_bytes()
try: registry = json.loads(raw, object_pairs_hook=unique)
except ValueError: fail('invalid resource registry')
if (registry.get('schema_version') != 1 or registry.get('project_id') != 'peanut-admin'
    or registry.get('authority',{}).get('role') != 'maintainer'
    or hashlib.sha256(raw).hexdigest() != contract['registry_sha256']): fail('registry identity/digest mismatch')
matches = [x for x in registry.get('resources',{}).get('databases',[]) if x.get('stable_resource_id') == contract['resource_id']]
if len(matches) != 1: fail('resource is not uniquely registered')
d = matches[0]; endpoint = d.get('upstream_endpoint',{}); policy = d.get('lease_policy',{})
if (not isinstance(d.get('synthetic_databases',{}).get('standalone'),list)
    or d.get('application_runtime') is not True or d.get('service_type') != 'mysql'
    or d.get('version') != '8.4.10' or d.get('fallback') != 'none'
    or 'acceptance' not in d.get('environments',[])
    or contract['database'] not in d.get('synthetic_databases',{}).get('standalone',[])
    or policy.get('mode') != 'schema' or 'shared_access' in policy
    or endpoint.get('endpoint_id') != contract['endpoint_id'] or 'host' not in endpoint.get('consumers',[])
    or policy.get('physical_endpoint') != str(endpoint.get('host'))+':'+str(endpoint.get('port'))
    or d.get('resource_scope') != contract['resource_scope'] or d.get('lease_gate') != contract['gate']
    or d.get('credential_ref') != contract['credential_ref'] or metadata['gate'] != contract['gate']): fail('operation exceeds registered runtime authority')
schema = policy['physical_endpoint']+'/'+contract['database']
for kind,expected in [('database',{contract['database']}),('mysql-db',{contract['database']}),
                      ('mysql-schema',{schema}),('environment',{'acceptance'}),
                      ('resource-scope',{contract['resource_scope']}),('registry-sha256',{contract['registry_sha256']}),
                      ('worktree',{runtime_root})]:
    if resources.get(kind) != expected: fail('parent '+kind+' scope mismatch')
if (contract['resource_id'] not in resources.get('resource-id',set())
    or contract['endpoint_id'] not in resources.get('endpoint',set())
    or not resources.get('consumer') or not resources['consumer'] <= {'host','container'}): fail('parent physical resource/route mismatch')
outputs = resources.get('output-dir',set())
receipt = pathlib.Path(contract['receipt_path'])
if len(outputs) != 1: fail('parent output authority must be exact')
output = next(iter(outputs))
if (not exact_path(output) or not pathlib.Path(output).is_dir()
    or not receipt.is_absolute() or not exact_path(str(receipt.parent)) or not receipt.parent.is_dir()
    or re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9._-]{0,127}\.json',receipt.name) is None
    or receipt.is_symlink()): fail('invalid private observation receipt path')
try: receipt.parent.relative_to(output)
except ValueError: fail('receipt exceeds real parent output authority')
if receipt.exists() and (not receipt.is_file() or receipt.stat().st_nlink != 1): fail('unsafe existing observation receipt')
PY
  local parent_resources=() hash type value lock_dir lock_file SCHEMA_MODE
  while IFS=$'\t' read -r hash type value; do parent_resources+=("$type=$value"); done < "$LEASES_DIR/$parent_lease/resources.tsv"
  SCHEMA_MODE="$(mysql_claim_policy "$parent_lease" "$(metadata_value "$LEASES_DIR/$parent_lease/metadata.tsv" gate)" verify "${parent_resources[@]}")" \
    || die 'observer parent native MySQL authority rejected'
  [[ "$SCHEMA_MODE" == schema ]] || die 'observer requires an exclusively held registered schema'
  while IFS=$'\t' read -r hash type value; do
    validate_resource "$type=$value"
    [[ "$hash" == "$(resource_hash "$type" "$value")" ]] || die 'observer parent resource digest mismatch'
    # Schema identity evidence is not a second physical lock. Use the same native
    # classification as claim/show, only after the complete schema policy passed.
    if schema_identity_resource "$type"; then continue; fi
    lock_dir="$RESOURCES_DIR/$hash"
    [[ -d "$lock_dir" && ! -L "$lock_dir" ]] || die 'observer parent physical lock missing'
    for lock_file in lease type value; do
      [[ -f "$lock_dir/$lock_file" && ! -L "$lock_dir/$lock_file" ]] || die 'observer parent physical lock invalid'
    done
    [[ "$(cat "$lock_dir/lease")" == "$parent_lease" && "$(cat "$lock_dir/type")" == "$type" \
      && "$(cat "$lock_dir/value")" == "$value" ]] || die 'observer parent physical lock ownership mismatch'
  done < "$LEASES_DIR/$parent_lease/resources.tsv"
}

validate_parent_lease_locked() {
  local parent_lease="$1" owner="$2" thread_id="$3" candidate="$4" candidate_repository="$5" worktree="$6"
  local role="${7:-}" contract="${8:-}"
  local parent_dir="$LEASES_DIR/$parent_lease"
  [[ -d "$parent_dir" && -f "$parent_dir/metadata.tsv" ]] || die "parent lease does not exist: $parent_lease"
  [[ ! -L "$parent_dir" && ! -L "$parent_dir/metadata.tsv" && -f "$parent_dir/resources.tsv" && ! -L "$parent_dir/resources.tsv" ]] || die "parent lease proof is invalid: $parent_lease"
  awk -F '\t' '
    BEGIN {split("lease owner thread candidate candidate_repository parent_lease gate worktree created_at expires_at status", keys, " "); for (i in keys) allowed[keys[i]]=1}
    NF != 2 || !($1 in allowed) || seen[$1]++ || ($1 != "parent_lease" && $2 == "") {bad=1}
    END {exit bad || NR != 11 ? 1 : 0}
  ' "$parent_dir/metadata.tsv" || die "parent lease metadata schema is invalid: $parent_lease"
  [[ "$(metadata_value "$parent_dir/metadata.tsv" lease)" == "$parent_lease" ]] || die "parent lease id mismatch: $parent_lease"
  [[ "$(metadata_value "$parent_dir/metadata.tsv" status)" == ACTIVE ]] || die "parent lease is not ACTIVE: $parent_lease"
  [[ -z "$(metadata_value "$parent_dir/metadata.tsv" parent_lease)" ]] || die "nested parent lease is forbidden: $parent_lease"
  local created expires now hash type value lock_dir lock_file
  created="$(metadata_value "$parent_dir/metadata.tsv" created_at)"
  expires="$(metadata_value "$parent_dir/metadata.tsv" expires_at)"
  now="$(date +%s)"
  [[ "$created" =~ ^[0-9]+$ && "$expires" =~ ^[0-9]+$ ]] || die "parent lease timestamps are invalid: $parent_lease"
  [[ "$created" -le "$now" && "$expires" -gt "$created" ]] || die "parent lease timestamps are invalid: $parent_lease"
  ! lease_expired "$parent_dir" || die "parent lease is expired: $parent_lease"
  [[ "$(metadata_value "$parent_dir/metadata.tsv" owner)" == "$owner" ]] || die "parent lease belongs to another owner: $parent_lease"
  [[ "$(metadata_value "$parent_dir/metadata.tsv" thread)" == "$thread_id" ]] || die "parent lease belongs to another thread: $parent_lease"
  if [[ -n "$role" ]]; then
    [[ "$role" == collaboration-read-existing && -n "$contract" ]] || die 'invalid parent observation role'
    validate_observation_parent_locked "$parent_lease" "$candidate" "$candidate_repository" "$worktree" "$contract"
    return
  fi
  [[ "$(metadata_value "$parent_dir/metadata.tsv" candidate)" == "$candidate" ]] || die "parent lease candidate mismatch: $parent_lease"
  [[ "$(metadata_value "$parent_dir/metadata.tsv" candidate_repository)" == "$candidate_repository" ]] || die "parent lease candidate repository mismatch: $parent_lease"
  [[ "$(metadata_value "$parent_dir/metadata.tsv" worktree)" == "$worktree" ]] || die "parent lease worktree mismatch: $parent_lease"
  lease_has_resource "$parent_dir" worktree "$worktree" || die "parent lease does not own the worktree: $parent_lease"
  while IFS=$'\t' read -r hash type value; do
    [[ -n "$hash" && -n "$type" && -n "$value" && "$hash" == "$(resource_hash "$type" "$value")" ]] || die "parent resource hash is invalid: $parent_lease"
    if [[ "$type" == worktree ]]; then
      [[ "$value" == "$worktree" ]] || die "parent worktree resource mismatch: $parent_lease"
      lock_dir="$RESOURCES_DIR/$hash"
      [[ -d "$lock_dir" && ! -L "$lock_dir" ]] || die "parent worktree lock is missing: $parent_lease"
      for lock_file in lease type value; do
        [[ -f "$lock_dir/$lock_file" && ! -L "$lock_dir/$lock_file" ]] || die "parent worktree lock is invalid: $parent_lease"
      done
      [[ "$(cat "$lock_dir/lease")" == "$parent_lease" && "$(cat "$lock_dir/type")" == worktree && "$(cat "$lock_dir/value")" == "$worktree" ]] || die "parent worktree lock holder mismatch: $parent_lease"
    fi
  done < "$parent_dir/resources.tsv"
}

release_lease_locked() {
  local lease_id="$1" expected_owner="${2:-}" lease_dir owner hash type value resource_dir child_lease
  lease_dir="$LEASES_DIR/$lease_id"
  [[ -d "$lease_dir" ]] || die "lease does not exist: $lease_id"
  owner="$(metadata_value "$lease_dir/metadata.tsv" owner)"
  if [[ -n "$expected_owner" && "$owner" != "$expected_owner" ]]; then
    die "lease $lease_id belongs to $owner, not $expected_owner"
  fi
  if lease_has_resource "$lease_dir" lease-role collaboration-read-existing; then
    [[ -n "$expected_owner" ]] || die 'observer requires explicit owner release after safe completion'
  fi
  child_lease="$(active_child_lease "$lease_id" || true)"
  [[ -z "$child_lease" ]] || die "lease $lease_id has active child lease $child_lease"
  while IFS=$'\t' read -r hash type value; do
    [[ -n "$hash" ]] || continue
    resource_dir="$RESOURCES_DIR/$hash"
    if [[ -d "$resource_dir" && "$(cat "$resource_dir/lease" 2>/dev/null || true)" == "$lease_id" ]]; then
      remove_resource_dir "$resource_dir"
    fi
  done < "$lease_dir/resources.tsv"
  rm -f "$lease_dir/metadata.tsv" "$lease_dir/resources.tsv"
  rmdir "$lease_dir"
}

case "$COMMAND" in
  claim)
    LEASE_ID=""
    OWNER=""
    THREAD_ID=""
    CANDIDATE=""
    CANDIDATE_REPOSITORY="$REPO_ROOT"
    PARENT_LEASE=""
    LEASE_ROLE=""
    OPERATION_CONTRACT=""
    GATE=""
    TTL=14400
    RESOURCES=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --lease) [[ $# -ge 2 ]] || die '--lease requires a value'; LEASE_ID="$2"; shift 2 ;;
        --owner) [[ $# -ge 2 ]] || die '--owner requires a value'; OWNER="$2"; shift 2 ;;
        --thread) [[ $# -ge 2 ]] || die '--thread requires a value'; THREAD_ID="$2"; shift 2 ;;
        --candidate) [[ $# -ge 2 ]] || die '--candidate requires a value'; CANDIDATE="$2"; shift 2 ;;
        --candidate-repository) [[ $# -ge 2 ]] || die '--candidate-repository requires a value'; CANDIDATE_REPOSITORY="$2"; shift 2 ;;
        --parent-lease) [[ $# -ge 2 ]] || die '--parent-lease requires a value'; PARENT_LEASE="$2"; shift 2 ;;
        --role) [[ $# -ge 2 ]] || die '--role requires a value'; LEASE_ROLE="$2"; shift 2 ;;
        --operation-contract) [[ $# -ge 2 ]] || die '--operation-contract requires a value'; OPERATION_CONTRACT="$2"; shift 2 ;;
        --gate) [[ $# -ge 2 ]] || die '--gate requires a value'; GATE="$2"; shift 2 ;;
        --ttl) [[ $# -ge 2 ]] || die '--ttl requires a value'; TTL="$2"; shift 2 ;;
        --resource) [[ $# -ge 2 ]] || die '--resource requires a value'; RESOURCES+=("$2"); shift 2 ;;
        --help|-h) usage; COMMAND_COMPLETED=1; exit 0 ;;
        *) die "unknown claim option: $1" ;;
      esac
    done
    validate_lease_id "$LEASE_ID"
    validate_owner "$OWNER"
    [[ -n "$THREAD_ID" ]] || THREAD_ID="$OWNER"
    validate_owner "$THREAD_ID"
    [[ "$CANDIDATE" =~ ^[0-9a-f]{40}$ ]] || die 'candidate must be an exact lowercase 40-hex commit'
    [[ "$CANDIDATE_REPOSITORY" == /* && -d "$CANDIDATE_REPOSITORY" ]] \
      || die 'candidate repository must be an existing absolute directory'
    CANDIDATE_REPOSITORY="$(cd "$CANDIDATE_REPOSITORY" && pwd -P)"
    git -C "$CANDIDATE_REPOSITORY" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
      || die "candidate repository is not a Git worktree: $CANDIDATE_REPOSITORY"
    git -C "$CANDIDATE_REPOSITORY" cat-file -e "${CANDIDATE}^{commit}" 2>/dev/null \
      || die "candidate is unavailable in $CANDIDATE_REPOSITORY: $CANDIDATE"
    [[ "$GATE" =~ ^[a-z0-9][a-z0-9._-]{0,63}$ ]] || die 'gate has an invalid name'
    [[ "$TTL" =~ ^[0-9]+$ && "$TTL" -ge 60 && "$TTL" -le 86400 ]] || die 'ttl must be 60-86400 seconds'
    if [[ -n "$PARENT_LEASE" ]]; then
      validate_lease_id "$PARENT_LEASE"
      [[ "$PARENT_LEASE" != "$LEASE_ID" ]] || die 'parent lease must differ from child lease'
    fi
    WORKTREE="$(cd "$REPO_ROOT" && pwd -P)"
    for resource in ${RESOURCES[@]+"${RESOURCES[@]}"}; do
      [[ "${resource%%=*}" != lease-role && "${resource%%=*}" != operation-contract ]] || die 'reserved observation fields require --role'
    done
    if [[ -n "$LEASE_ROLE" || -n "$OPERATION_CONTRACT" ]]; then
      [[ "$LEASE_ROLE" == collaboration-read-existing && -n "$OPERATION_CONTRACT" \
        && -n "$PARENT_LEASE" && "$GATE" == collaboration-runtime-observation \
        && "${#RESOURCES[@]}" == 0 ]] || die 'observer requires dedicated role/parent/gate/contract and no resource arguments'
      RESOURCES+=("lease-role=$LEASE_ROLE" "operation-contract=$OPERATION_CONTRACT")
    fi
    RESOURCES+=("gate=$GATE")
    if [[ -z "$PARENT_LEASE" || -n "$LEASE_ROLE" ]]; then
      RESOURCES+=("worktree=$WORKTREE")
    fi
    for resource in "${RESOURCES[@]}"; do
      validate_resource "$resource"
      [[ -z "$PARENT_LEASE" || -n "$LEASE_ROLE" || "${resource%%=*}" != worktree ]] || die 'ordinary child lease must not claim a direct worktree resource'
    done

    acquire_mutex
    if [[ -n "$PARENT_LEASE" ]]; then
      validate_parent_lease_locked "$PARENT_LEASE" "$OWNER" "$THREAD_ID" "$CANDIDATE" "$CANDIDATE_REPOSITORY" "$WORKTREE" "$LEASE_ROLE" "$OPERATION_CONTRACT"
    fi
    SCHEMA_MODE="$(mysql_claim_policy "$LEASE_ID" "$GATE" claim "${RESOURCES[@]}")" || die 'MySQL lease policy rejected claim'
    LEASE_DIR="$LEASES_DIR/$LEASE_ID"
    [[ ! -e "$LEASE_DIR" ]] || die "lease already exists: $LEASE_ID"
    NOW="$(date +%s)"
    EXPIRES_AT=$((NOW + TTL))
    if [[ -n "$PARENT_LEASE" ]]; then
      PARENT_EXPIRES="$(metadata_value "$LEASES_DIR/$PARENT_LEASE/metadata.tsv" expires_at)"
      [[ "$EXPIRES_AT" -le "$PARENT_EXPIRES" ]] || EXPIRES_AT="$PARENT_EXPIRES"
    fi
    CLAIM_TMP_DIR="$LEASES_DIR/.claim-${LEASE_ID}-$$"
    CREATED_RESOURCES_FILE="$REGISTRY_ROOT/.created-${LEASE_ID}-$$"
    mkdir "$CLAIM_TMP_DIR"
    : > "$CLAIM_TMP_DIR/resources.tsv"
    : > "$CREATED_RESOURCES_FILE"
    SEEN_FILE="$REGISTRY_ROOT/.seen-${LEASE_ID}-$$"
    : > "$SEEN_FILE"

    for resource in "${RESOURCES[@]}"; do
      TYPE="${resource%%=*}"
      VALUE="${resource#*=}"
      HASH="$(resource_hash "$TYPE" "$VALUE")"
      if grep -Fxq "$HASH" "$SEEN_FILE"; then
        continue
      fi
      printf '%s\n' "$HASH" >> "$SEEN_FILE"
      RESOURCE_DIR="$RESOURCES_DIR/$HASH"
      if schema_identity_resource "$TYPE"; then
        # An old (even expired) exclusive schema lock must be returned by its
        # owner before this physical schema can become shared.
        if [[ "$TYPE" == mysql-schema && ( -e "$RESOURCE_DIR" || -L "$RESOURCE_DIR" ) ]]; then
          die "exclusive schema lock still exists: $VALUE"
        fi
        printf '%s\t%s\t%s\n' "$HASH" "$TYPE" "$VALUE" >> "$CLAIM_TMP_DIR/resources.tsv"
        continue
      fi
      if [[ -d "$RESOURCE_DIR" ]]; then
        HOLDER="$(cat "$RESOURCE_DIR/lease" 2>/dev/null || printf 'unknown')"
        die "resource conflict: $TYPE=$VALUE is held by lease $HOLDER"
      fi
      mkdir "$RESOURCE_DIR"
      printf '%s\n' "$LEASE_ID" > "$RESOURCE_DIR/lease"
      printf '%s\n' "$TYPE" > "$RESOURCE_DIR/type"
      printf '%s\n' "$VALUE" > "$RESOURCE_DIR/value"
      printf '%s\n' "$RESOURCE_DIR" >> "$CREATED_RESOURCES_FILE"
      printf '%s\t%s\t%s\n' "$HASH" "$TYPE" "$VALUE" >> "$CLAIM_TMP_DIR/resources.tsv"
    done
    rm -f "$SEEN_FILE"
    SEEN_FILE=""
    printf 'lease\t%s\nowner\t%s\nthread\t%s\ncandidate\t%s\ncandidate_repository\t%s\nparent_lease\t%s\ngate\t%s\nworktree\t%s\ncreated_at\t%s\nexpires_at\t%s\nstatus\tACTIVE\n' \
      "$LEASE_ID" "$OWNER" "$THREAD_ID" "$CANDIDATE" "$CANDIDATE_REPOSITORY" "$PARENT_LEASE" "$GATE" "$WORKTREE" "$NOW" "$EXPIRES_AT" > "$CLAIM_TMP_DIR/metadata.tsv"
    mv "$CLAIM_TMP_DIR" "$LEASE_DIR"
    # Keep this newly published directory in rollback scope until its actual
    # declarations and required locks have been read back under the same mutex.
    CLAIM_TMP_DIR="$LEASE_DIR"
    [[ -f "$LEASE_DIR/metadata.tsv" && ! -L "$LEASE_DIR/metadata.tsv" \
      && -f "$LEASE_DIR/resources.tsv" && ! -L "$LEASE_DIR/resources.tsv" \
      && "$(metadata_value "$LEASE_DIR/metadata.tsv" lease)" == "$LEASE_ID" \
      && "$(metadata_value "$LEASE_DIR/metadata.tsv" owner)" == "$OWNER" \
      && "$(metadata_value "$LEASE_DIR/metadata.tsv" thread)" == "$THREAD_ID" \
      && "$(metadata_value "$LEASE_DIR/metadata.tsv" candidate)" == "$CANDIDATE" \
      && "$(metadata_value "$LEASE_DIR/metadata.tsv" candidate_repository)" == "$CANDIDATE_REPOSITORY" \
      && "$(metadata_value "$LEASE_DIR/metadata.tsv" parent_lease)" == "$PARENT_LEASE" \
      && "$(metadata_value "$LEASE_DIR/metadata.tsv" gate)" == "$GATE" \
      && "$(metadata_value "$LEASE_DIR/metadata.tsv" worktree)" == "$WORKTREE" \
      && "$(metadata_value "$LEASE_DIR/metadata.tsv" status)" == ACTIVE ]] || die 'published claim metadata mismatch'
    for resource in "${RESOURCES[@]}"; do
      TYPE="${resource%%=*}"; VALUE="${resource#*=}"; HASH="$(resource_hash "$TYPE" "$VALUE")"
      lease_has_resource "$LEASE_DIR" "$TYPE" "$VALUE" || die 'published claim resource missing'
      if schema_identity_resource "$TYPE"; then continue; fi
      RESOURCE_DIR="$RESOURCES_DIR/$HASH"
      [[ -d "$RESOURCE_DIR" && ! -L "$RESOURCE_DIR" ]] || die 'published claim lock missing'
      for LOCK_FILE in lease type value; do
        [[ -f "$RESOURCE_DIR/$LOCK_FILE" && ! -L "$RESOURCE_DIR/$LOCK_FILE" ]] || die 'published claim lock invalid'
      done
      [[ "$(cat "$RESOURCE_DIR/lease")" == "$LEASE_ID" && "$(cat "$RESOURCE_DIR/type")" == "$TYPE" \
        && "$(cat "$RESOURCE_DIR/value")" == "$VALUE" ]] || die 'published claim lock ownership mismatch'
    done
    CLAIM_TMP_DIR=""
    rm -f "$CREATED_RESOURCES_FILE"
    CREATED_RESOURCES_FILE=""
    release_mutex
    printf 'lease=%s\nowner=%s\ncandidate=%s\ngate=%s\nexpires_at=%s\n' "$LEASE_ID" "$OWNER" "$CANDIDATE" "$GATE" "$EXPIRES_AT"
    ;;

  renew)
    LEASE_ID=""; OWNER=""; TTL=14400
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --lease) LEASE_ID="${2:-}"; shift 2 ;;
        --owner) OWNER="${2:-}"; shift 2 ;;
        --ttl) TTL="${2:-}"; shift 2 ;;
        *) die "unknown renew option: $1" ;;
      esac
    done
    validate_lease_id "$LEASE_ID"; validate_owner "$OWNER"
    [[ "$TTL" =~ ^[0-9]+$ && "$TTL" -ge 60 && "$TTL" -le 86400 ]] || die 'ttl must be 60-86400 seconds'
    acquire_mutex
    LEASE_DIR="$LEASES_DIR/$LEASE_ID"
    [[ -d "$LEASE_DIR" ]] || die "lease does not exist: $LEASE_ID"
    [[ "$(metadata_value "$LEASE_DIR/metadata.tsv" owner)" == "$OWNER" ]] || die "lease $LEASE_ID belongs to another owner"
    ! lease_expired "$LEASE_DIR" || die "lease is expired: $LEASE_ID"
    PARENT_LEASE="$(metadata_value "$LEASE_DIR/metadata.tsv" parent_lease)"
    read_lease_role "$LEASE_DIR"
    if awk -F '\t' '$2 == "mysql-schema" {found=1} END {exit found ? 0 : 1}' "$LEASE_DIR/resources.tsv"; then
      SCHEMA_PROOFS=()
      while IFS=$'\t' read -r HASH TYPE VALUE; do SCHEMA_PROOFS+=("$TYPE=$VALUE"); done < "$LEASE_DIR/resources.tsv"
      mysql_claim_policy "$LEASE_ID" "$(metadata_value "$LEASE_DIR/metadata.tsv" gate)" verify "${SCHEMA_PROOFS[@]}" >/dev/null || die 'MySQL schema renewal proof is invalid'
    fi
    NOW="$(date +%s)"; EXPIRES_AT=$((NOW + TTL)); TMP_METADATA="$LEASE_DIR/.metadata.$$"
    if [[ -n "$PARENT_LEASE" ]]; then
      validate_lease_id "$PARENT_LEASE"
      validate_parent_lease_locked "$PARENT_LEASE" "$OWNER" \
        "$(metadata_value "$LEASE_DIR/metadata.tsv" thread)" \
        "$(metadata_value "$LEASE_DIR/metadata.tsv" candidate)" \
        "$(metadata_value "$LEASE_DIR/metadata.tsv" candidate_repository)" \
        "$(metadata_value "$LEASE_DIR/metadata.tsv" worktree)" "$LEASE_ROLE" "$OPERATION_CONTRACT"
      PARENT_EXPIRES="$(metadata_value "$LEASES_DIR/$PARENT_LEASE/metadata.tsv" expires_at)"
      [[ "$EXPIRES_AT" -le "$PARENT_EXPIRES" ]] || EXPIRES_AT="$PARENT_EXPIRES"
    fi
    # Renewing the runtime holder must not shorten a previously granted observer
    # window. Ordinary children retain their existing renewal semantics.
    for CHILD_DIR in "$LEASES_DIR"/*; do
      [[ -d "$CHILD_DIR" && -f "$CHILD_DIR/metadata.tsv" ]] || continue
      if [[ "$(metadata_value "$CHILD_DIR/metadata.tsv" parent_lease)" == "$LEASE_ID" ]] \
        && lease_has_resource "$CHILD_DIR" lease-role collaboration-read-existing; then
        CHILD_EXPIRES="$(metadata_value "$CHILD_DIR/metadata.tsv" expires_at)"
        [[ "$CHILD_EXPIRES" =~ ^[0-9]+$ && "$EXPIRES_AT" -ge "$CHILD_EXPIRES" ]] \
          || die 'runtime renewal cannot shorten an existing observer window'
      fi
    done
    awk -F '\t' -v expires="$EXPIRES_AT" 'BEGIN{OFS="\t"} $1=="expires_at"{$2=expires} {print}' "$LEASE_DIR/metadata.tsv" > "$TMP_METADATA"
    mv "$TMP_METADATA" "$LEASE_DIR/metadata.tsv"
    release_mutex
    printf 'lease=%s\nexpires_at=%s\n' "$LEASE_ID" "$EXPIRES_AT"
    ;;

  release)
    LEASE_ID=""; OWNER=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --lease) LEASE_ID="${2:-}"; shift 2 ;;
        --owner) OWNER="${2:-}"; shift 2 ;;
        *) die "unknown release option: $1" ;;
      esac
    done
    validate_lease_id "$LEASE_ID"; validate_owner "$OWNER"
    acquire_mutex
    release_lease_locked "$LEASE_ID" "$OWNER"
    release_mutex
    printf 'released=%s\n' "$LEASE_ID"
    ;;

  list)
    printf 'LEASE\tSTATUS\tOWNER\tGATE\tCANDIDATE\tWORKTREE\tEXPIRES_AT\n'
    shopt -s nullglob
    for LEASE_DIR in "$LEASES_DIR"/*; do
      [[ -d "$LEASE_DIR" && -f "$LEASE_DIR/metadata.tsv" ]] || continue
      STATUS=ACTIVE
      if lease_expired "$LEASE_DIR"; then STATUS=EXPIRED; fi
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$(metadata_value "$LEASE_DIR/metadata.tsv" lease)" "$STATUS" \
        "$(metadata_value "$LEASE_DIR/metadata.tsv" owner)" "$(metadata_value "$LEASE_DIR/metadata.tsv" gate)" \
        "$(metadata_value "$LEASE_DIR/metadata.tsv" candidate)" "$(metadata_value "$LEASE_DIR/metadata.tsv" worktree)" \
        "$(metadata_value "$LEASE_DIR/metadata.tsv" expires_at)"
    done
    ;;

  show)
    LEASE_ID=""
    VERIFY_LOCKS=0
    if [[ $# -eq 4 && "${3:-}" == --verify-locks && "${4:-}" == --observer-window ]]; then
      VERIFY_LOCKS=1; OBSERVATION_WINDOW_CHILD=1; set -- "$1" "$2"
    elif [[ $# -eq 3 && "${3:-}" == --verify-locks ]]; then VERIFY_LOCKS=1; set -- "$1" "$2"; fi
    [[ "${1:-}" == '--lease' && -n "${2:-}" && $# -eq 2 ]] || die 'show requires --lease <run-id> [--verify-locks]'
    LEASE_ID="$2"; validate_lease_id "$LEASE_ID"; LEASE_DIR="$LEASES_DIR/$LEASE_ID"
    [[ -d "$LEASE_DIR" ]] || die "lease does not exist: $LEASE_ID"
    PARENT_LEASE="$(metadata_value "$LEASE_DIR/metadata.tsv" parent_lease 2>/dev/null || true)"
    if [[ -n "$PARENT_LEASE" || "$VERIFY_LOCKS" == 1 ]] || awk -F '\t' '$2 == "mysql-schema" {found=1} END {exit found ? 0 : 1}' "$LEASE_DIR/resources.tsv"; then acquire_mutex; fi
    read_lease_role "$LEASE_DIR"
    [[ "$OBSERVATION_WINDOW_CHILD" == 0 || "$LEASE_ROLE" == collaboration-read-existing ]] || die 'mutex reuse is only for the closed observation role'
    if [[ -n "$LEASE_ROLE" ]]; then VERIFY_LOCKS=1; fi
    if [[ -n "$PARENT_LEASE" ]]; then
      validate_parent_lease_locked \
        "$PARENT_LEASE" \
        "$(metadata_value "$LEASE_DIR/metadata.tsv" owner)" \
        "$(metadata_value "$LEASE_DIR/metadata.tsv" thread)" \
        "$(metadata_value "$LEASE_DIR/metadata.tsv" candidate)" \
        "$(metadata_value "$LEASE_DIR/metadata.tsv" candidate_repository)" \
        "$(metadata_value "$LEASE_DIR/metadata.tsv" worktree)" "$LEASE_ROLE" "$OPERATION_CONTRACT"
    fi
    SCHEMA_MODE=exclusive
    if awk -F '\t' '$2 == "mysql-schema" {found=1} END {exit found ? 0 : 1}' "$LEASE_DIR/resources.tsv"; then
      SCHEMA_PROOFS=()
      while IFS=$'\t' read -r HASH TYPE VALUE; do SCHEMA_PROOFS+=("$TYPE=$VALUE"); done < "$LEASE_DIR/resources.tsv"
      SCHEMA_MODE="$(mysql_claim_policy "$LEASE_ID" "$(metadata_value "$LEASE_DIR/metadata.tsv" gate)" verify "${SCHEMA_PROOFS[@]}")" || die 'MySQL schema proof is invalid'
      VERIFY_LOCKS=1
    fi
    if [[ "$VERIFY_LOCKS" == 1 ]]; then
      [[ ! -L "$LEASE_DIR" && -f "$LEASE_DIR/metadata.tsv" && ! -L "$LEASE_DIR/metadata.tsv" \
        && -f "$LEASE_DIR/resources.tsv" && ! -L "$LEASE_DIR/resources.tsv" ]] || die 'lease proof is invalid'
      awk -F '\t' '
        BEGIN {split("lease owner thread candidate candidate_repository parent_lease gate worktree created_at expires_at status", keys, " "); for (i in keys) allowed[keys[i]]=1}
        NF != 2 || !($1 in allowed) || seen[$1]++ || ($1 != "parent_lease" && $2 == "") {bad=1}
        END {exit bad || NR != 11 ? 1 : 0}
      ' "$LEASE_DIR/metadata.tsv" || die 'lease metadata schema is invalid'
      [[ "$(metadata_value "$LEASE_DIR/metadata.tsv" lease)" == "$LEASE_ID" \
        && "$(metadata_value "$LEASE_DIR/metadata.tsv" status)" == ACTIVE ]] || die 'lease identity/status is invalid'
      CREATED="$(metadata_value "$LEASE_DIR/metadata.tsv" created_at)"
      EXPIRES="$(metadata_value "$LEASE_DIR/metadata.tsv" expires_at)"
      NOW="$(date +%s)"
      [[ "$CREATED" =~ ^[0-9]+$ && "$EXPIRES" =~ ^[0-9]+$ \
        && "$CREATED" -le "$NOW" && "$EXPIRES" -gt "$NOW" && "$EXPIRES" -gt "$CREATED" ]] || die 'lease timestamps are invalid'
      awk -F '\t' 'NF != 3 || $1 == "" || $2 == "" || $3 == "" || seen[$1]++ {bad=1} END {exit bad || NR == 0 ? 1 : 0}' \
        "$LEASE_DIR/resources.tsv" || die 'lease resources schema is invalid'
      while IFS=$'\t' read -r HASH TYPE VALUE; do
        validate_resource "$TYPE=$VALUE"
        [[ "$HASH" == "$(resource_hash "$TYPE" "$VALUE")" ]] || die 'lease resource hash is invalid'
        if schema_identity_resource "$TYPE"; then
          [[ "$TYPE" != mysql-schema || ( ! -e "$RESOURCES_DIR/$HASH" && ! -L "$RESOURCES_DIR/$HASH" ) ]] || die 'exclusive schema lock conflicts with shared proof'
          continue
        fi
        LOCK_DIR="$RESOURCES_DIR/$HASH"
        [[ -d "$LOCK_DIR" && ! -L "$LOCK_DIR" ]] || die 'lease resource lock is invalid'
        for LOCK_FILE in lease type value; do
          [[ -f "$LOCK_DIR/$LOCK_FILE" && ! -L "$LOCK_DIR/$LOCK_FILE" ]] || die 'lease resource lock proof is invalid'
        done
        [[ "$(cat "$LOCK_DIR/lease")" == "$LEASE_ID" && "$(cat "$LOCK_DIR/type")" == "$TYPE" \
          && "$(cat "$LOCK_DIR/value")" == "$VALUE" ]] || die 'lease resource lock holder mismatch'
      done < "$LEASE_DIR/resources.tsv"
    fi
    cat "$LEASE_DIR/metadata.tsv"
    printf 'resources\n'
    awk -F '\t' '{printf "%s\t%s\n", $2, $3}' "$LEASE_DIR/resources.tsv"
    if [[ -n "$PARENT_LEASE" && -z "$LEASE_ROLE" ]]; then
      printf 'worktree\t%s\n' "$(metadata_value "$LEASE_DIR/metadata.tsv" worktree)"
    fi
    if [[ -n "$PARENT_LEASE" || "$VERIFY_LOCKS" == 1 ]]; then release_mutex; fi
    ;;

  prune-expired)
    [[ $# -eq 0 ]] || die 'prune-expired takes no options'
    acquire_mutex
    COUNT=0
    shopt -s nullglob
    for LEASE_DIR in "$LEASES_DIR"/*; do
      [[ -d "$LEASE_DIR" && -f "$LEASE_DIR/metadata.tsv" ]] || continue
      if lease_expired "$LEASE_DIR"; then
        # Expiry cannot prove the observer's SQL process has terminated.
        if lease_has_resource "$LEASE_DIR" lease-role collaboration-read-existing; then continue; fi
        LEASE_ID="$(metadata_value "$LEASE_DIR/metadata.tsv" lease)"
        if [[ -z "$(active_child_lease "$LEASE_ID" || true)" ]]; then
          release_lease_locked "$LEASE_ID"
          COUNT=$((COUNT + 1))
        fi
      fi
    done
    release_mutex
    printf 'pruned=%s\n' "$COUNT"
    ;;

  --help|-h|help)
    usage
    ;;
  *)
    die "unknown command: $COMMAND"
    ;;
esac
COMMAND_COMPLETED=1
