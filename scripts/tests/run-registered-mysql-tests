#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd -P)"
cd "$ROOT"

validated_environment_file=""

validate_environment_file() {
  local php_binary="$1" file="$2"
  "$php_binary" -r '
    try {
        $path = $argv[1];
        $keys = [
            "DB_HOST", "DB_PORT", "DB_NAME",
            "PEANUT_DATABASE_RESOURCE_ID", "PEANUT_DATABASE_ENDPOINT_ID",
            "PEANUT_DATABASE_CONSUMER",
        ];
        $counts = array_fill_keys($keys, 0);
        $lines = file($path, FILE_IGNORE_NEW_LINES);
        if (!is_array($lines)) {
            throw new RuntimeException("REGISTERED_MYSQL_ENV_FILE_INVALID");
        }
        foreach ($lines as $line) {
            if (preg_match("/^\\s*([A-Z][A-Z0-9_]*)\\s*=/D", $line, $matches) === 1
                && array_key_exists($matches[1], $counts)) {
                $counts[$matches[1]]++;
            }
        }
        $values = parse_ini_file($path, false, INI_SCANNER_RAW);
        if (!is_array($values)) {
            throw new RuntimeException("REGISTERED_MYSQL_ENV_FILE_INVALID");
        }
        foreach ($keys as $key) {
            if ($counts[$key] === 0 || !array_key_exists($key, $values)) {
                throw new RuntimeException("REGISTERED_MYSQL_ENV_FILE_REQUIRED:" . $key);
            }
            if ($counts[$key] !== 1) {
                throw new RuntimeException("REGISTERED_MYSQL_ENV_FILE_AMBIGUOUS:" . $key);
            }
            $expected = getenv($key);
            if (!is_string($expected) || !is_string($values[$key])
                || !hash_equals($expected, $values[$key])) {
                throw new RuntimeException("REGISTERED_MYSQL_ENV_FILE_MISMATCH:" . $key);
            }
        }
    } catch (Throwable $exception) {
        fwrite(STDERR, "ERROR: " . $exception->getMessage() . "\n");
        exit(2);
    }
  ' "$file"
  validated_environment_file="$file"
}

run_php_with_backend_environment() {
  [[ -n "$validated_environment_file" \
    && "$validated_environment_file" == "$environment_file" \
    && "${PEANUT_SERVER_ENV_FILE:-}" == "$environment_file" ]] \
    || { echo 'ERROR: backend environment was not validated' >&2; return 2; }
  # Registry and lease authorization remains process metadata. The application
  # reads file configuration through ThinkPHP Env, without a process mirror.
  "$@"
}

preflight() {
  run_php_with_backend_environment "$php_binary" -r '
    require_once $argv[1];
    require_once $argv[2];
    RegisteredMysqlTestResource::preflightEmptyDatabase();
  ' "$ROOT/server/tests/Support/CiBootstrap.php" "$ROOT/server/tests/Support/RegisteredMysqlTestResource.php"
}

suite_success_pattern() {
  case "$1" in
    */FileControlledAccessTest.php) printf '%s\n' 'FILE_CONTROLLED_ACCESS_OK assertions=[1-9][0-9]*' ;;
    */FileDeliveryEdgeCasesTest.php) printf '%s\n' 'FILE_DELIVERY_EDGE_CASES_OK assertions=[1-9][0-9]*' ;;
    */IntegrationSecurityMysqlTest.php) printf '%s\n' 'integration-security mysql harness: PASS \(40 checks\)' ;;
    */DictTenantIsolationTest.php) printf '%s\n' 'MT02-DICT-TENANT-ISOLATION-001 passed' ;;
    */FileTenantIsolationTest.php) printf '%s\n' 'MT03-FILE-TENANT-OWNERSHIP-001 passed' ;;
    */OperationLogTenantIsolationTest.php) printf '%s\n' 'MT03-OPERATION-LOG-TENANT-001 passed' ;;
    */OrgTenantIsolationTest.php) printf '%s\n' 'MT02-ORG-TENANT-ISOLATION-001 passed; assertions=[1-9][0-9]*' ;;
    */PlatformAccessHttpWiringTest.php) printf '%s\n' 'PM01-PLATFORM-ACCESS-HTTP-WIRING-001 passed' ;;
    */PlatformBootstrapInstallerTest.php) printf '%s\n' 'MT05-PLATFORM-BOOTSTRAP-001 identity stage passed; full installer not executed' ;;
    */PlatformModuleRuntimeHttpWiringTest.php) printf '%s\n' 'PLATFORM-MODULE-RUNTIME-HTTP-D3-001 passed' ;;
    */PlatformOperatorBoundaryTest.php) printf '%s\n' 'PM01-PLATFORM-OPERATOR-BOUNDARY-001 passed' ;;
    */PlatformTenantLifecycleApiTest.php) printf '%s\n' 'PM01-PLATFORM-TENANT-LIFECYCLE-HTTP-001 passed' ;;
    */PlatformTenantReadApiTest.php) printf '%s\n' 'PM01-PLATFORM-TENANT-READ-001 passed' ;;
    */TenantGovernanceTest.php) printf '%s\n' 'PM01-TENANT-GOVERNANCE-001 passed' ;;
    */TenantSessionHostTest.php) printf '%s\n' 'MT04-TENANT-SESSION-HOST-001 passed' ;;
    */TenantXlsxExportIsolationTest.php) printf '%s\n' 'MT03-TENANT-XLSX-EXPORT-001 passed' ;;
    */AdminRbacCrudTest.php) printf '%s\n' 'PB04-AUTH-CRUD-001 current IAM CRUD and rejection contracts passed' ;;
    */ConsumerModuleMemberRuntimeTest.php) printf '%s\n' 'CONSUMER-MEMBER-RUNTIME-001 passed \(7 checks\)' ;;
    */MenuGroupingTest.php) printf '%s\n' '"status":"passed","assertions":[1-9][0-9]*' ;;
    */ModuleCatalogApplierTest.php) printf '%s\n' 'MODULE-CATALOG-APPLIER-B-001 passed' ;;
    */ModuleInstallationMigrationMySqlTest.php) printf '%s\n' 'MODULE-INSTALLATION-MYSQL assertions=[1-9][0-9]*' ;;
    *) printf '%s\n' 'OK \([1-9][0-9]* tests?, [1-9][0-9]* assertions?\)' ;;
  esac
}

run_suite() {
  local target="$1" log child_status status post_status expected
  shift
  expected="^$(suite_success_pattern "$target")"
  log="$(mktemp "${RUNNER_TEMP:-${TMPDIR:-/tmp}}/peanut-admin-real-mysql.log.XXXXXX")"
  logs+=("$log")
  set +e
  run_php_with_backend_environment "$php_binary" "$ROOT/scripts/run-php-test" \
    "--env-file=$environment_file" --fail-on-skipped "$target" "$@" 2>&1 | tee "$log"
  child_status=${PIPESTATUS[0]}
  status="$child_status"
  set -e
  if [[ "$status" != 0 ]]; then
    echo "ERROR: real MySQL suite failed: $target" >&2
  elif ! grep -Eq "$expected" "$log"; then
    echo "ERROR: real MySQL suite did not report its expected assertion/check count: $target" >&2
    status=1
  fi
  if preflight; then post_status=0; else post_status=$?; fi
  printf 'MySQL suite=%s child_exit=%d behavior_exit=%d post_preflight_exit=%d\n' \
    "$target" "$child_status" "$status" "$post_status"
  [[ "$status" == 0 ]] || return "$status"
  return "$post_status"
}

