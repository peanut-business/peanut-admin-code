#!/usr/bin/env php
<?php

declare(strict_types=1);

use app\common\infrastructure\scaffold\ApplicationCreator;
use app\common\infrastructure\scaffold\DeterministicEditionArchive;
use app\common\value\scaffold\VersionContract;

function editionInstallerUsage(): never
{
    fwrite(STDERR, "Usage: php scripts/build-edition-installers --version=<semver> --source-commit=<full-sha> --output=<absolute-directory> [--check]\n");
    exit(64);
}

/** @param list<string> $command */
function editionInstallerRun(array $command, ?string $cwd = null): string
{
    $pipes = [];
    $process = proc_open($command, [1 => ['pipe', 'w'], 2 => ['redirect', 1]], $pipes, $cwd);
    if (!is_resource($process)) {
        throw new RuntimeException('EDITION_BUILD_PROCESS_FAILED');
    }
    $stdout = stream_get_contents($pipes[1]);
    fclose($pipes[1]);
    if (proc_close($process) !== 0 || !is_string($stdout)) {
        throw new RuntimeException('EDITION_BUILD_COMMAND_FAILED: ' . trim((string) $stdout));
    }
    return $stdout;
}

function editionInstallerDelete(string $path): void
{
    if (is_dir($path) && !is_link($path)) {
        foreach (array_diff(scandir($path) ?: [], ['.', '..']) as $entry) {
            editionInstallerDelete($path . '/' . $entry);
        }
        rmdir($path);
        return;
    }
    if (file_exists($path) || is_link($path)) {
        unlink($path);
    }
}

function editionInstallerWrite(string $path, string $content): void
{
    if ((!is_dir(dirname($path)) && !mkdir(dirname($path), 0775, true))
        || file_put_contents($path, $content) === false
        || !chmod($path, 0644)) {
        throw new RuntimeException('EDITION_BUILD_WRITE_FAILED: ' . $path);
    }
}

$root = dirname(__DIR__);
require_once $root . '/server/vendor/autoload.php';
$options = [];
$check = false;
foreach (array_slice($argv, 1) as $argument) {
    if ($argument === '--check') {
        $check = true;
        continue;
    }
    if (preg_match('/^--(version|source-commit|output)=(.+)$/D', $argument, $matches) !== 1
        || isset($options[$matches[1]])) {
        editionInstallerUsage();
    }
    $options[$matches[1]] = $matches[2];
}
foreach (['version', 'source-commit', 'output'] as $required) {
    if (!isset($options[$required])) {
        editionInstallerUsage();
    }
}
if (preg_match('/^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$/D', $options['version']) !== 1
    || preg_match('/^[a-f0-9]{40}$/D', $options['source-commit']) !== 1
    || !str_starts_with($options['output'], '/')) {
    editionInstallerUsage();
}

$commit = trim(editionInstallerRun(['git', '-C', $root, 'rev-parse', $options['source-commit'] . '^{commit}']));
if (!hash_equals($options['source-commit'], $commit)) {
    throw new RuntimeException('EDITION_BUILD_SOURCE_NOT_COMMIT');
}
$tree = trim(editionInstallerRun(['git', '-C', $root, 'rev-parse', $commit . '^{tree}']));
$temporaryRoot = realpath(sys_get_temp_dir());
if (!is_string($temporaryRoot)) {
    throw new RuntimeException('EDITION_BUILD_TEMP_ROOT_INVALID');
}
$temporary = $temporaryRoot . '/peanut-edition-build-' . bin2hex(random_bytes(8));
if (!mkdir($temporary, 0700, true)) {
    throw new RuntimeException('EDITION_BUILD_TEMP_FAILED');
}

try {
    $sourceArchive = $temporary . '/source.tar';
    $source = $temporary . '/source';
    mkdir($source, 0700);
    editionInstallerRun(['git', '-C', $root, 'archive', '--format=tar', '--output=' . $sourceArchive, $commit]);
    (new PharData($sourceArchive))->extractTo($source);

    require $source . '/server/app/common/value/scaffold/VersionContract.php';
    $versions = VersionContract::load($source . '/release-versions.json');
    if (!$versions->isV3()
        || $versions->sourceProductVersion() !== $options['version']
        || $versions->scaffoldTemplate() !== $options['version']) {
        throw new RuntimeException('EDITION_BUILD_VERSION_IDENTITY_MISMATCH');
    }
    require $source . '/server/app/common/validation/scaffold/ScaffoldPathGuard.php';
    require $source . '/server/app/common/value/scaffold/ScaffoldManifest.php';
    require $source . '/server/app/common/infrastructure/scaffold/ApplicationCreator.php';
    require $source . '/server/app/common/infrastructure/scaffold/DeterministicEditionArchive.php';

    $dependencyLocks = [];
    foreach ([
        'server/composer.lock',
        'web/pnpm-lock.yaml',
        'platform/package-lock.json',
        'pc/package-lock.json',
        'uniapp/package-lock.json',
    ] as $lockPath) {
        $digest = hash_file('sha256', $source . '/' . $lockPath);
        if (!is_string($digest)) {
            throw new RuntimeException('EDITION_BUILD_DEPENDENCY_LOCK_MISSING: ' . $lockPath);
        }
        $dependencyLocks[$lockPath] = $digest;
    }
    $editionProfileDigest = hash_file('sha256', $source . '/scaffold/edition-profiles.json');
    if (!is_string($editionProfileDigest)) {
        throw new RuntimeException('EDITION_BUILD_PROFILE_MISSING');
    }

    $artifacts = [];
    foreach (['standalone', 'multi-tenant'] as $edition) {
        $application = $temporary . '/application-' . $edition;
        $manifest = (new ApplicationCreator(
            $source,
            $source . '/scaffold/application-template-inventory.json',
            ['commit' => $commit, 'tree' => $tree],
        ))->create(
            'Peanut Admin',
            'peanut-admin',
            'peanut-admin/application',
            $application,
            $edition,
            $options['version'],
            'full',
        );
        // The consumer gets the existing generated upgrade baseline plus browser
        // builds, not the maintainer's dependency directories or a second scaffold.
        $assembled = $temporary . '/assembled-' . $edition;
        editionInstallerRun([
            'bash', $source . '/scripts/package-release.sh', $assembled,
            '--application-root=' . $application, '--directory-only',
        ], $source);
        $application = $assembled;
        $archiveRoot = 'peanut-admin-' . $options['version'] . '-' . $edition;
        $filename = $archiveRoot . '.tar.gz';
        $archive = $temporary . '/' . $filename;
        (new DeterministicEditionArchive())->write($application, $archiveRoot, $archive);
        $applicationManifestPath = $application . '/.peanut/application-manifest.json';
        $pluginLockPath = $application . '/plugins.lock';
        $pluginLock = json_decode((string) file_get_contents($pluginLockPath), true, 128, JSON_THROW_ON_ERROR);
        $modules = [];
        foreach ($pluginLock['plugins'] ?? [] as $plugin) {
            if (!is_array($plugin) || !is_string($plugin['key'] ?? null) || !is_string($plugin['version'] ?? null)) {
                throw new RuntimeException('EDITION_BUILD_MODULE_LOCK_INVALID');
            }
            $modules[] = ['key' => $plugin['key'], 'version' => $plugin['version']];
        }
        usort($modules, static fn(array $left, array $right): int => strcmp($left['key'], $right['key']));
        $artifact = [
            'schema_version' => 1,
            'protocol' => 'peanut.edition-installer.v1',
            'product' => ['name' => 'Peanut Admin', 'version' => $options['version']],
            'edition' => $manifest['edition'],
            'source' => [
                'commit' => $commit,
                'tree' => $tree,
                'inventory_sha256' => hash_file('sha256', $source . '/scaffold/application-template-inventory.json'),
            ],
            'build_inputs' => [
                'edition_profile_sha256' => $editionProfileDigest,
                'edition_generator_version' => $manifest['edition']['generator_version'],
                'dependency_locks' => $dependencyLocks,
                'module_profile' => $manifest['edition']['module_profile'],
                'module_lock_sha256' => hash_file('sha256', $pluginLockPath),
                'modules' => $modules,
            ],
            'application' => [
                'manifest_sha256' => hash_file('sha256', $applicationManifestPath),
                'managed_tree_sha256' => $manifest['digests']['managed_tree_sha256'],
                'app_owned_tree_sha256' => $manifest['digests']['app_owned_tree_sha256'],
                'file_count' => count($manifest['files']),
            ],
            'archive' => [
                'filename' => $filename,
                'root' => $archiveRoot,
                'format' => 'tar.gz',
                'sha256' => hash_file('sha256', $archive),
                'bytes' => filesize($archive),
            ],
        ];
        $manifestJson = json_encode(
            $artifact,
            JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR,
        ) . "\n";
        $manifestFilename = $filename . '.manifest.json';
        editionInstallerWrite($temporary . '/' . $manifestFilename, $manifestJson);
        $artifacts[] = [
            'edition' => $edition,
            'archive' => $filename,
            'manifest' => $manifestFilename,
            'sha256' => $artifact['archive']['sha256'],
        ];
    }
    $checksums = implode('', array_map(
        static fn(array $artifact): string => $artifact['sha256'] . '  ' . $artifact['archive'] . "\n",
        $artifacts,
    ));
    editionInstallerWrite($temporary . '/SHA256SUMS', $checksums);

    foreach ([...array_column($artifacts, 'archive'), ...array_column($artifacts, 'manifest'), 'SHA256SUMS'] as $filename) {
        $built = $temporary . '/' . $filename;
        $destination = rtrim($options['output'], '/') . '/' . $filename;
        if ($check) {
            if (!is_file($destination)
                || !hash_equals((string) hash_file('sha256', $built), (string) hash_file('sha256', $destination))) {
                throw new RuntimeException('EDITION_BUILD_ARTIFACT_STALE: ' . $filename);
            }
        } else {
            $bytes = file_get_contents($built);
            if (!is_string($bytes)) {
                throw new RuntimeException('EDITION_BUILD_ARTIFACT_UNREADABLE: ' . $filename);
            }
            editionInstallerWrite($destination, $bytes);
        }
    }
    echo json_encode([
        'status' => $check ? 'verified' : 'built',
        'version' => $options['version'],
        'source_commit' => $commit,
        'source_tree' => $tree,
        'artifacts' => $artifacts,
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n";
} finally {
    editionInstallerDelete($temporary);
}
