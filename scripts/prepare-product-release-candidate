#!/usr/bin/env python3
"""Prepare a product release candidate from public registry Core packages.

The script intentionally derives Composer/npm identities from native manifests
and lockfiles after running the package managers. Loose tarball/SRI strings are
not accepted. A coordinator-bound, read-only Web Core package evidence file may
supply the same registry metadata when direct npm metadata reads are unavailable;
native npm/pnpm lock generation and lock-vs-registry verification still run.
"""
from __future__ import annotations

import argparse
import base64
import datetime as dt
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
from functools import lru_cache
from urllib.parse import quote, unquote, urlparse
from urllib.request import HTTPRedirectHandler, Request, build_opener, urlopen
from typing import Any

ROOT = Path(__file__).resolve().parents[1]
CORE_WEB_PACKAGES = (
    "@peanut-admin/client",
    "@peanut-admin/vue",
    "@peanut-admin/ui-vue",
    "@peanut-admin/nuxt",
    "@peanut-admin/uniapp",
    "@peanut-admin/testing",
)
LEGAL_FILES = (
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "RELEASE_SBOM.spdx.json",
)
CLIENT_CORE_PACKAGES = {
    "web": ("@peanut-admin/vue", "@peanut-admin/ui-vue"),
    "platform": ("@peanut-admin/vue", "@peanut-admin/ui-vue"),
    "pc": ("@peanut-admin/client", "@peanut-admin/nuxt"),
    "uniapp": ("@peanut-admin/client", "@peanut-admin/uniapp"),
}
RELEASE_DELTA = (
    "Adopts the published fixed PHP Core and Web Core package identities recorded in "
    "public_runtime_dependencies, separates source product identity from customer-owned "
    "instance identity, and prepares one-source deterministic Standalone and Multi-tenant "
    "scaffold inputs."
)
SEMVER = re.compile(
    r"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)"
    r"(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)"
    r"(?:\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?"
    r"(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$"
)


def fail(message: str) -> None:
    raise SystemExit(f"prepare-product-release-candidate: {message}")


def read_json(path: Path) -> dict[str, Any]:
    data = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(data, dict):
        fail(f"expected JSON object: {path}")
    return data


def write_json(path: Path, data: dict[str, Any]) -> None:
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def required_release_file_sha256(relative: str) -> str:
    path = ROOT / relative
    if path.is_symlink() or not path.is_file():
        fail(f"required release file must be a real regular file: {relative}")
    return sha256(path)


def run(command: list[str], *, cwd: Path | None = None, dry_run: bool = False) -> None:
    actual_cwd = ROOT if cwd is None else cwd
    printable = " ".join(command)
    if dry_run:
        print(f"DRY-RUN {actual_cwd.relative_to(ROOT) if actual_cwd != ROOT else '.'}: {printable}")
        return
    subprocess.run(command, cwd=actual_cwd, check=True)


def require_semver(value: str, label: str) -> str:
    if not SEMVER.fullmatch(value):
        fail(f"{label} must be an exact SemVer value")
    return value


def update_package_version(path: Path, version: str) -> None:
    data = read_json(path)
    data["version"] = version
    write_json(path, data)


def set_core_web_specs(version: str) -> None:
    for client, names in CLIENT_CORE_PACKAGES.items():
        path = ROOT / client / "package.json"
        data = read_json(path)
        dependencies = data.get("dependencies", {})
        for name in names:
            if name not in dependencies:
                fail(f"{client}/package.json is missing {name}")
            dependencies[name] = version
        write_json(path, data)


def set_composer_spec(version: str) -> None:
    path = ROOT / "server/composer.json"
    data = read_json(path)
    require = data.get("require", {})
    if "peanut-admin/core" not in require:
        fail("server/composer.json is missing peanut-admin/core")
    require["peanut-admin/core"] = version
    write_json(path, data)


def composer_command() -> list[str]:
    composer = shutil.which("composer")
    if composer:
        return [composer]
    fail("the registered project Composer command is required")


def npm_command() -> str:
    npm = shutil.which("npm")
    if not npm:
        fail("npm is required to create native package-lock files")
    return npm


def corepack_command() -> str:
    pnpm = shutil.which("pnpm")
    if not pnpm:
        fail("the registered project pnpm command is required to create the native lock")
    return pnpm


def preflight_tools() -> None:
    checks = [
        [*composer_command(), "--version", "--no-ansi"],
        [npm_command(), "--version"],
        [corepack_command(), "--version"],
    ]
    for command in checks:
        try:
            subprocess.run(command, cwd=ROOT, check=True, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        except subprocess.CalledProcessError as error:
            fail(f"required tool is not ready: {' '.join(command)}: {error.stderr.strip()}")


def run_native_lock_updates(dry_run: bool) -> None:
    run(
        [
            *composer_command(),
            "update",
            "peanut-admin/core",
            "--with-dependencies",
            "--no-install",
            "--no-interaction",
            "--working-dir=server",
        ],
        dry_run=dry_run,
    )
    npm = "npm" if dry_run else npm_command()
    for client in ("platform", "pc", "uniapp"):
        run([npm, "install", "--package-lock-only", "--ignore-scripts"], cwd=ROOT / client, dry_run=dry_run)
    run(
        [
            "pnpm" if dry_run else corepack_command(),
            "--dir",
            "web",
            "install",
            "--lockfile-only",
            "--ignore-scripts",
            "--frozen-lockfile=false",
        ],
        dry_run=dry_run,
    )


def read_core_php(expected_version: str, expected_reference: str) -> dict[str, str]:
    lock = read_json(ROOT / "server/composer.lock")
    records = [item for item in lock.get("packages", []) if item.get("name") == "peanut-admin/core"]
    if len(records) != 1:
        fail("server/composer.lock must contain exactly one peanut-admin/core record")
    package = records[0]
    source = package.get("source") or {}
    if package.get("version", "").lstrip("v") != expected_version:
        fail("Composer lock did not resolve the requested Core PHP version")
    if source.get("reference") != expected_reference:
        fail("Composer lock source_reference differs from the fixed Core PHP source")
    if source.get("type") != "git" or source.get("url") != "https://github.com/peanut-business/peanut-admin-core-php.git":
        fail("Composer lock Core PHP source is not the public repository")
    return {
        "package": "peanut-admin/core",
        "constraint": expected_version,
        "resolved_version": package["version"],
        "source_type": source.get("type"),
        "source_url": source.get("url"),
        "source_reference": source.get("reference"),
    }


def npm_lock_package(client: str, name: str, expected_version: str) -> dict[str, str]:
    lock = read_json(ROOT / client / "package-lock.json")
    if lock.get("packages", {}).get("", {}).get("dependencies", {}).get(name) != expected_version:
        fail(f"{client}/package-lock.json root does not pin {name}")
    package = lock.get("packages", {}).get(f"node_modules/{name}")
    if not isinstance(package, dict):
        fail(f"{client}/package-lock.json is missing {name}")
    if package.get("version") != expected_version:
        fail(f"{client}/package-lock.json resolved {name} to {package.get('version')}")
    resolved = package.get("resolved")
    integrity = package.get("integrity")
    if not registry_tarball(resolved):
        fail(f"{client}/package-lock.json did not record registry tarball for {name}")
    validate_integrity(integrity, f"{client}:{name}")
    return {"version": expected_version, "resolved": resolved, "integrity": integrity}


def validate_integrity(value: Any, label: str) -> None:
    if not isinstance(value, str) or not value.startswith("sha512-"):
        fail(f"{label} integrity must be sha512 SRI")
    try:
        raw = base64.b64decode(value[7:], validate=True)
    except Exception as error:  # noqa: BLE001
        fail(f"{label} integrity is invalid: {error}")
    if len(raw) != 64:
        fail(f"{label} integrity is not a SHA-512 digest")


def registry_tarball(value: Any) -> bool:
    if not isinstance(value, str):
        return False
    parsed = urlparse(value)
    return parsed.scheme == "https" and parsed.hostname == "registry.npmjs.org" and parsed.port is None and parsed.path.endswith(".tgz") and not parsed.username and not parsed.password


def pnpm_lock_package(name: str, expected_version: str) -> dict[str, str]:
    text = (ROOT / "web/pnpm-lock.yaml").read_text(encoding="utf-8")
    importer = text.split("\npackages:\n", 1)[0]
    if not re.search(r"^      '" + re.escape(name) + r"':\n        specifier: " + re.escape(expected_version) + r"$", importer, re.M):
        fail(f"web/pnpm-lock.yaml importer does not pin {name}")
    escaped = re.escape(f"  '{name}@{expected_version}':")
    match = re.search(
        escaped
        + r"\n(?:    [^\n]*\n)*?    resolution:\s*\{([^}\n]+)\}",
        text,
    )
    if not match:
        fail(f"web/pnpm-lock.yaml is missing {name}@{expected_version}")
    fields: dict[str, str] = {}
    for part in match.group(1).split(","):
        if ":" not in part:
            continue
        key, value = part.split(":", 1)
        fields[key.strip()] = value.strip().strip("'\"")
    integrity = fields.get("integrity")
    validate_integrity(integrity, f"web:{name}")
    result = {"version": expected_version, "integrity": integrity}
    if "tarball" in fields:
        tarball = fields["tarball"]
        if not registry_tarball(tarball):
            fail(f"web:{name} tarball is not a registry URL")
        result["resolved"] = tarball
    return result


def npm_registry_package(name: str, expected_version: str) -> dict[str, Any]:
    npm = npm_command()
    output = subprocess.check_output(
        [npm, "view", f"{name}@{expected_version}", "version", "dist.tarball", "dist.integrity",
         "repository.url", "gitHead", "dist.attestations", "--json", "--registry=https://registry.npmjs.org"],
        cwd=ROOT,
        text=True,
    )
    data = json.loads(output)
    if data.get("version") != expected_version:
        fail(f"npm registry resolved {name} to {data.get('version')}")
    resolved = data.get("dist.tarball")
    integrity = data.get("dist.integrity")
    if not registry_tarball(resolved):
        fail(f"npm registry did not provide a tarball URL for {name}")
    validate_integrity(integrity, f"npm:{name}")
    repository = data.get("repository.url")
    if repository is None and isinstance(data.get("repository"), dict):
        repository = data["repository"].get("url")
    attestations = data.get("dist.attestations") or {}
    provenance = (npm_provenance(name, expected_version, attestations.get("url"))
                  if data.get("gitHead") is None else None)
    return {"version": expected_version, "resolved": resolved, "integrity": integrity,
            "repository": repository, "gitHead": data.get("gitHead"), "provenance": provenance}


def official_web_repository(value: Any) -> bool:
    if not isinstance(value, str):
        return False
    parsed = urlparse(value.removeprefix("git+"))
    return (parsed.scheme == "https" and parsed.hostname == "github.com" and parsed.port is None
            and not parsed.username and not parsed.password and not parsed.query and not parsed.fragment
            and parsed.path in ("/peanut-business/peanut-admin-core-web", "/peanut-business/peanut-admin-core-web.git"))


def provenance_url(value: Any, name: str, version: str) -> bool:
    if not isinstance(value, str):
        return False
    parsed = urlparse(value)
    return (parsed.scheme == "https" and parsed.hostname == "registry.npmjs.org" and parsed.port is None
            and not parsed.username and not parsed.password and not parsed.query and not parsed.fragment
            and unquote(parsed.path) == f"/-/npm/v1/attestations/{name}@{version}")


@lru_cache(maxsize=64)
def public_json(url: str) -> dict[str, Any]:
    parsed_url = urlparse(url)
    github_api = parsed_url.hostname == "api.github.com"
    if github_api and (parsed_url.scheme != "https" or parsed_url.port not in (None, 443)
                       or parsed_url.username or parsed_url.password):
        fail("GitHub API source evidence URL is not canonical HTTPS")
    headers = {"User-Agent": "Peanut-release-coordinator"}
    if github_api:
        token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
        if token:
            headers["Authorization"] = f"Bearer {token}"
    try:
        request = Request(url, headers=headers)
        if github_api:
            class RejectRedirect(HTTPRedirectHandler):
                def redirect_request(self, req, fp, code, msg, response_headers, newurl):
                    return None

            response = build_opener(RejectRedirect).open(request, timeout=30)
        else:
            response = urlopen(request, timeout=30)
        with response as stream:
            value = json.load(stream)
    except (OSError, ValueError) as error:
        fail(f"public source evidence lookup failed: {url}: {type(error).__name__}")
    if not isinstance(value, dict):
        fail("public source evidence must be a JSON object")
    return value


def npm_provenance(name: str, version: str, url: Any) -> dict[str, Any]:
    if not provenance_url(url, name, version):
        fail(f"npm provenance URL is missing or wrong for {name}")
    document = public_json(url)
    matches = [entry.get("bundle") for entry in document.get("attestations", [])
               if isinstance(entry, dict) and entry.get("predicateType") == "https://slsa.dev/provenance/v1"]
    if len(matches) != 1 or not isinstance(matches[0], dict):
        fail(f"npm provenance is absent or ambiguous for {name}")
    bundle = matches[0]
    canonical = json.dumps(bundle, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()
    return {"url": url, "bundle_sha256": hashlib.sha256(canonical).hexdigest(), "bundle": bundle}


@lru_cache(maxsize=64)
def verify_npm_provenance_signature(canonical_bundle: str, version: str) -> None:
    """Use npm's existing public Sigstore trust and verifier, never a project signing key."""
    node = shutil.which("node")
    if not node:
        fail("Node is required for npm provenance verification")
    try:
        npm_root = subprocess.check_output([npm_command(), "root", "--global"], cwd=ROOT, text=True, timeout=30).strip()
        program = r"""
const fs = require('node:fs');
const path = require('node:path');
const sigstore = require(path.join(process.argv[1], 'npm/node_modules/sigstore'));
const bundle = JSON.parse(fs.readFileSync(0, 'utf8'));
sigstore.verify(bundle, {
  certificateIdentityURI: `https://github.com/peanut-business/peanut-admin-core-web/.github/workflows/release.yml@refs/tags/v${process.argv[2]}`,
  certificateIssuer: 'https://token.actions.githubusercontent.com',
  tufForceCache: true,
}).catch(error => { console.error(error.message); process.exitCode = 1; });
"""
        result = subprocess.run([node, "-e", program, npm_root, version], input=canonical_bundle,
                                cwd=ROOT, text=True, capture_output=True, timeout=90)
    except (OSError, subprocess.SubprocessError) as error:
        fail(f"npm provenance verifier failed: {type(error).__name__}")
    if result.returncode != 0:
        fail(f"npm provenance signature verification failed: {result.stderr.strip()}")


def validate_web_source(name: str, version: str, reference: str, registry: dict[str, Any],
                        action_run: int | None = None) -> dict[str, Any]:
    """Shared registry/evidence source binding for candidate and live coordinator."""
    if registry.get("gitHead") is not None and registry["gitHead"] != reference:
        fail(f"npm registry gitHead differs from fixed Core Web source for {name}")
    provenance = registry.get("provenance")
    if provenance is None:
        if registry.get("gitHead") != reference:
            fail(f"npm registry gitHead is missing and verified provenance is required for {name}")
        return {"type": "npm-gitHead", "source_reference": reference}
    if not isinstance(provenance, dict) or set(provenance) != {"url", "bundle_sha256", "bundle"} \
            or not provenance_url(provenance.get("url"), name, version) or not isinstance(provenance.get("bundle"), dict):
        fail(f"npm provenance record shape or URL differs for {name}")
    canonical = json.dumps(provenance["bundle"], sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    if hashlib.sha256(canonical.encode()).hexdigest() != provenance["bundle_sha256"]:
        fail(f"npm provenance bundle SHA-256 differs for {name}")
    try:
        envelope = provenance["bundle"]["dsseEnvelope"]
        if envelope["payloadType"] != "application/vnd.in-toto+json":
            fail(f"npm provenance payload type differs for {name}")
        statement = json.loads(base64.b64decode(envelope["payload"], validate=True))
        expected_digest = base64.b64decode(registry["integrity"].removeprefix("sha512-"), validate=True).hex()
        if (statement["_type"] != "https://in-toto.io/Statement/v1"
                or statement["predicateType"] != "https://slsa.dev/provenance/v1"
                or statement["subject"] != [{"name": f"pkg:npm/{name.replace('@', '%40')}@{version}", "digest": {"sha512": expected_digest}}]):
            fail(f"npm provenance subject/integrity differs for {name}")
        definition = statement["predicate"]["buildDefinition"]
        workflow = definition["externalParameters"]["workflow"]
        official = "https://github.com/peanut-business/peanut-admin-core-web"
        if (definition["buildType"] != "https://slsa-framework.github.io/github-actions-buildtypes/workflow/v1"
                or workflow != {"ref": f"refs/tags/v{version}", "repository": official, "path": ".github/workflows/release.yml"}
                or definition["resolvedDependencies"] != [{"uri": f"git+{official}@refs/tags/v{version}", "digest": {"gitCommit": reference}}]):
            fail(f"npm provenance source/workflow differs for {name}")
        invocation = statement["predicate"]["runDetails"]["metadata"]["invocationId"]
        match = re.fullmatch(re.escape(official) + r"/actions/runs/([1-9][0-9]*)/attempts/([1-9][0-9]*)", invocation)
        if not match or (action_run is not None and int(match[1]) != action_run):
            fail(f"npm provenance Action run differs for {name}")
        run_id = int(match[1])
    except (KeyError, TypeError, ValueError) as error:
        fail(f"npm provenance statement is invalid for {name}: {type(error).__name__}")
    verify_npm_provenance_signature(canonical, version)
    if action_run is None:
        live = public_json(f"https://api.github.com/repos/peanut-business/peanut-admin-core-web/actions/runs/{run_id}")
        if (live.get("id") != run_id or live.get("path") != ".github/workflows/release.yml"
                or live.get("head_sha") != reference or live.get("head_branch") != f"v{version}"
                or live.get("conclusion") != "success"):
            fail(f"npm provenance live successful Action differs for {name}")
    return {"type": "npm-provenance", "source_reference": reference, "action_run": run_id,
            "bundle_sha256": provenance["bundle_sha256"], "signature_verified": True}


def read_web_package_evidence(path: Path, expected_sha256: str, expected_version: str,
                              expected_reference: str, *, expected_release_id: int | None = None,
                              expected_action_run: int | None = None) -> dict[str, dict[str, Any]]:
    if not path.is_absolute() or path.is_symlink():
        fail("Web Core package evidence must be an absolute real regular file")
    try:
        resolved = path.resolve(strict=True)
    except OSError:
        fail("Web Core package evidence must be an absolute real regular file")
    if not resolved.is_file():
        fail("Web Core package evidence must be an absolute real regular file")
    if resolved.stat().st_mode & 0o222:
        fail("Web Core package evidence must be read-only")
    if not re.fullmatch(r"[0-9a-f]{64}", expected_sha256):
        fail("Web Core package evidence SHA-256 must be lowercase hex")
    raw = resolved.read_bytes()
    if hashlib.sha256(raw).hexdigest() != expected_sha256:
        fail("Web Core package evidence bytes changed from the coordinator binding")
    try:
        data = json.loads(raw)
    except ValueError as error:
        fail(f"Web Core package evidence is invalid JSON: {error}")
    required = {"schema_version", "protocol", "repository", "tag", "version", "source_reference",
                "release_id", "action_run", "packages"}
    if (not isinstance(data, dict) or set(data) != required
            or data.get("schema_version") != 2
            or data.get("protocol") != "peanut.web-core-package-evidence.v2"
            or data.get("repository") != "peanut-business/peanut-admin-core-web"
            or data.get("tag") != f"v{expected_version}" or data.get("version") != expected_version
            or data.get("source_reference") != expected_reference
            or not isinstance(data.get("release_id"), int) or data["release_id"] < 1
            or not isinstance(data.get("action_run"), int) or data["action_run"] < 1):
        fail("Web Core package evidence identity differs")
    if ((expected_release_id is not None and data["release_id"] != expected_release_id)
            or (expected_action_run is not None and data["action_run"] != expected_action_run)):
        fail("Web Core package evidence identity differs from live release")
    records = data.get("packages")
    if not isinstance(records, dict) or set(records) != set(CORE_WEB_PACKAGES):
        fail("Web Core package evidence package set differs")
    registry: dict[str, dict[str, str]] = {}
    for name in CORE_WEB_PACKAGES:
        item = records.get(name)
        if not isinstance(item, dict) or set(item) != {
                "version", "repository", "source_reference", "gitHead", "tarball", "integrity", "provenance"}:
            fail(f"Web Core package evidence record shape differs: {name}")
        repository = item.get("repository")
        tarball = item.get("tarball")
        integrity = item.get("integrity")
        validate_integrity(integrity, f"evidence:{name}")
        if (item.get("version") != expected_version or item.get("source_reference") != expected_reference
                or not official_web_repository(repository)
                or not registry_tarball(tarball)):
            fail(f"Web Core package evidence metadata differs: {name}")
        registry[name] = {"version": expected_version, "resolved": tarball, "integrity": integrity,
                          "repository": repository, "gitHead": item["gitHead"], "provenance": item["provenance"]}
        binding = validate_web_source(name, expected_version, expected_reference, registry[name], expected_action_run)
        if binding["type"] == "npm-provenance" and binding["action_run"] != data["action_run"]:
            fail(f"Web Core package evidence Action metadata differs: {name}")
        registry[name]["source_binding"] = binding
    return registry


def read_core_web(expected_version: str, expected_reference: str,
                  registry_packages: dict[str, dict[str, Any]] | None = None) -> dict[str, Any]:
    packages: dict[str, dict[str, str]] = {}
    for name in CORE_WEB_PACKAGES:
        observations = []
        for client, names in CLIENT_CORE_PACKAGES.items():
            if name not in names:
                continue
            observations.append(
                pnpm_lock_package(name, expected_version)
                if client == "web"
                else npm_lock_package(client, name, expected_version)
            )
        registry = (registry_packages[name] if registry_packages is not None
                    else npm_registry_package(name, expected_version))
        if not official_web_repository(registry.get("repository")):
            fail(f"npm registry repository is missing or wrong for {name}")
        validate_web_source(name, expected_version, expected_reference, registry)
        verified = {key: registry[key] for key in ("version", "resolved", "integrity")}
        for item in observations:
            if item["version"] != verified["version"] or item["integrity"] != verified["integrity"]:
                fail(f"native locks disagree with npm registry for {name}")
            if "resolved" in item and item["resolved"] != verified["resolved"]:
                fail(f"native lock tarball disagrees with npm registry for {name}")
        packages[name] = verified
    return {
        "source_type": "git",
        "source_url": "https://github.com/peanut-business/peanut-admin-core-web.git",
        "source_reference": expected_reference,
        "packages": packages,
    }


def stable_version_key(value: Any) -> tuple[int, int, int, str] | None:
    if not isinstance(value, str) or not SEMVER.fullmatch(value):
        return None
    core = value.split("+", 1)[0]
    if "-" in core:
        return None
    major, minor, patch = (int(part) for part in core.split("."))
    return major, minor, patch, value


def github_core_release(repository: str, selected_version: str) -> str:
    """Resolve a published stable tag to its exact commit and successful release Action."""
    tag = "v" + selected_version
    prefix = "https://api.github.com/repos/" + repository
    release = public_json(prefix + "/releases/tags/" + tag)
    if release.get("tag_name") != tag or release.get("draft") is not False or release.get("prerelease") is not False:
        fail(f"stable GitHub Release is missing or differs: {repository}@{tag}")
    reference = public_json(prefix + "/git/ref/tags/" + tag).get("object")
    for _ in range(4):
        if not isinstance(reference, dict) or not isinstance(reference.get("sha"), str):
            fail(f"GitHub tag identity is invalid: {repository}@{tag}")
        if reference.get("type") == "commit":
            break
        if reference.get("type") != "tag":
            fail(f"GitHub tag does not resolve to a commit: {repository}@{tag}")
        reference = public_json(prefix + "/git/tags/" + reference["sha"]).get("object")
    if not isinstance(reference, dict) or reference.get("type") != "commit" or not re.fullmatch(r"[0-9a-f]{40}", reference.get("sha", "")):
        fail(f"GitHub annotated tag does not resolve to a commit: {repository}@{tag}")
    commit = reference["sha"]
    runs = public_json(prefix + "/actions/workflows/release.yml/runs?branch=" + quote(tag) + "&per_page=100")
    matches = [run for run in runs.get("workflow_runs", []) if isinstance(run, dict)
               and run.get("head_sha") == commit and run.get("head_branch") == tag
               and run.get("path") == ".github/workflows/release.yml"
               and run.get("conclusion") == "success"]
    if not matches:
        fail(f"successful release Action for exact tag is missing: {repository}@{tag}")
    return commit


def packagist_php_release(selected_version: str | None) -> dict[str, Any]:
    records = public_json("https://repo.packagist.org/p2/peanut-admin/core.json").get("packages", {}).get("peanut-admin/core")
    if not isinstance(records, list):
        fail("Packagist did not provide peanut-admin/core releases")
    candidates = []
    for item in records:
        if not isinstance(item, dict):
            continue
        version_value = str(item.get("version", "")).removeprefix("v")
        key = stable_version_key(version_value)
        source = item.get("source")
        if key is None or not isinstance(source, dict):
            continue
        if source.get("type") != "git" or source.get("url", "").rstrip("/").removesuffix(".git") != "https://github.com/peanut-business/peanut-admin-core-php":
            continue
        reference = source.get("reference")
        if not isinstance(reference, str) or not re.fullmatch(r"[0-9a-f]{40}", reference):
            continue
        candidates.append((key, version_value, reference))
    if selected_version is not None:
        require_semver(selected_version, "Core PHP version")
        if stable_version_key(selected_version) is None:
            fail("formal Core PHP version must be stable")
        candidates = [row for row in candidates if row[1] == selected_version]
    if not candidates:
        fail("requested stable Core PHP version is absent from Packagist")
    _, resolved, reference = max(candidates)
    verified_reference = github_core_release("peanut-business/peanut-admin-core-php", resolved)
    if verified_reference != reference:
        fail("Packagist Core PHP source differs from the successful GitHub release tag")
    return {"package": "peanut-admin/core", "version": resolved,
            "source": {"repository": "peanut-business/peanut-admin-core-php", "reference": reference}}


def npm_web_versions() -> tuple[dict[str, dict[str, Any]], set[str]]:
    documents = {}
    version_sets = []
    for name in CORE_WEB_PACKAGES:
        document = public_json("https://registry.npmjs.org/" + quote(name, safe=""))
        versions = document.get("versions")
        if not isinstance(versions, dict):
            fail(f"npm registry package metadata is invalid: {name}")
        documents[name] = document
        version_sets.append({version for version in versions if stable_version_key(version) is not None})
    return documents, set.intersection(*version_sets)


def npm_web_release(selected_version: str | None) -> dict[str, Any]:
    documents, available = npm_web_versions()
    if selected_version is not None:
        require_semver(selected_version, "Core Web version")
        if stable_version_key(selected_version) is None:
            fail("formal Core Web version must be stable")
        available &= {selected_version}
    if not available:
        fail("requested stable Core Web version is not available as a complete six-package set")
    resolved = max(available, key=stable_version_key)
    reference = github_core_release("peanut-business/peanut-admin-core-web", resolved)
    packages = {}
    for name in CORE_WEB_PACKAGES:
        registry = npm_registry_package(name, resolved)
        if not official_web_repository(registry.get("repository")):
            fail(f"npm registry repository is missing or wrong for {name}")
        binding = validate_web_source(name, resolved, reference, registry)
        registry_version = documents[name]["versions"].get(resolved, {}).get("version")
        if registry_version != resolved:
            fail(f"npm package version metadata differs for {name}")
        packages[name] = {"version": resolved, "resolved": registry["resolved"],
                          "integrity": registry["integrity"], "source_binding": binding}
    return {"version": resolved,
            "source": {"repository": "peanut-business/peanut-admin-core-web", "reference": reference},
            "packages": packages}


def resolve_core_release(core_php_version: str | None, core_web_version: str | None) -> dict[str, Any]:
    php = packagist_php_release(core_php_version)
    web = npm_web_release(core_web_version)
    return {"schema_version": 1, "protocol": "peanut.scaffold-core-release-resolution.v1",
            "core_php": php, "core_web": web}


def prepare_core_snapshot(root: Path, resolution_path: Path) -> dict[str, Any]:
    """Resolve native locks in a disposable Code source snapshot only."""
    global ROOT
    if not root.is_absolute() or not resolution_path.is_absolute():
        fail("snapshot and Core resolution paths must be absolute")
    ROOT = root.resolve(strict=True)
    if not ROOT.is_dir() or not (ROOT / "release-versions.json").is_file():
        fail("snapshot does not contain a scaffold release source")
    resolution = read_json(resolution_path)
    php = resolution.get("core_php")
    web = resolution.get("core_web")
    if resolution.get("schema_version") != 1 or resolution.get("protocol") != "peanut.scaffold-core-release-resolution.v1" \
            or not isinstance(php, dict) or not isinstance(web, dict):
        fail("Core release resolution protocol is invalid")
    php_version = require_semver(php.get("version", ""), "resolved Core PHP version")
    web_version = require_semver(web.get("version", ""), "resolved Core Web version")
    php_reference = php.get("source", {}).get("reference")
    web_reference = web.get("source", {}).get("reference")
    if stable_version_key(php_version) is None or stable_version_key(web_version) is None \
            or not re.fullmatch(r"[0-9a-f]{40}", str(php_reference)) \
            or not re.fullmatch(r"[0-9a-f]{40}", str(web_reference)) \
            or set(web.get("packages", {})) != set(CORE_WEB_PACKAGES) \
            or any(item.get("version") != web_version for item in web.get("packages", {}).values() if isinstance(item, dict)):
        fail("Core release resolution is incomplete or not a fixed stable identity")
    scaffold_version = read_json(ROOT / "release-versions.json").get("scaffold_template")
    if not isinstance(scaffold_version, str):
        fail("scaffold template version is missing")
    originals = {path: (ROOT / path).read_bytes() if (ROOT / path).exists() else None for path in PREPARED_FILES}
    try:
        set_composer_spec(php_version)
        set_core_web_specs(web_version)
        run_native_lock_updates(False)
        core_php = read_core_php(php_version, php_reference)
        core_web = read_core_web(web_version, web_reference)
        update_release_versions(scaffold_version, core_php, core_web)
        update_release_metadata(scaffold_version, core_php, core_web)
        return {"status": "prepared", "core_php": core_php, "core_web": core_web,
                "lockfiles": {relative: sha256(ROOT / relative) for relative in (
                    "server/composer.lock", "web/pnpm-lock.yaml", "platform/package-lock.json",
                    "pc/package-lock.json", "uniapp/package-lock.json")}}
    except BaseException:
        for relative, original in originals.items():
            target = ROOT / relative
            if original is None:
                target.unlink(missing_ok=True)
            else:
                target.write_bytes(original)
        raise


def prepare_local_core_snapshot(root: Path, core_inputs_path: Path, tool_root: Path) -> dict[str, Any]:
    """Project already-built local Core archives and native locks into a disposable source copy."""
    global ROOT
    if not root.is_absolute() or not core_inputs_path.is_absolute() or not tool_root.is_absolute():
        fail("snapshot, Core inputs and tool root must be absolute")
    ROOT = root.resolve(strict=True)
    tool_root = tool_root.resolve(strict=True)
    inputs = read_json(core_inputs_path)
    php, web = inputs.get("core_php"), inputs.get("core_web")
    if inputs.get("schema_version") != 1 or inputs.get("status") != "frozen-core-build-inputs-not-product-release" \
            or not isinstance(php, dict) or not isinstance(web, dict) \
            or php.get("source_type") != "local" or web.get("source_type") != "local":
        fail("local Core input receipt is invalid")
    for name, identity in (("php", php.get("source_identity")), ("web", web.get("source_identity"))):
        if not isinstance(identity, dict) or identity != inputs.get("sources", {}).get(name) \
                or set(identity) != {"kind", "snapshot_sha256"} or identity.get("kind") != "local" \
                or not re.fullmatch(r"[0-9a-f]{64}", str(identity.get("snapshot_sha256", ""))):
            fail(f"local Core {name} source identity is invalid")
    php_version = require_semver(php.get("resolved_version", ""), "local Core PHP version")
    web_packages = web.get("packages")
    if php.get("package") != "peanut-admin/core" or php.get("constraint") != php_version \
            or not isinstance(web_packages, dict) or set(web_packages) != set(CORE_WEB_PACKAGES):
        fail("local Core package declarations are invalid")
    web_version = None
    archive_rows = []
    php_archive = inputs.get("core_php_archive")
    if not isinstance(php_archive, dict) or set(php_archive) != {"path", "sha256", "sha1"} \
            or php_archive.get("path") != f"packages/core-php/peanut-admin-core-{php_version}.zip" \
            or not re.fullmatch(r"[0-9a-f]{64}", str(php_archive.get("sha256", ""))) \
            or not re.fullmatch(r"[0-9a-f]{40}", str(php_archive.get("sha1", ""))):
        fail("local PHP Core archive identity is invalid")
    archive_rows.append(php_archive)
    for name in CORE_WEB_PACKAGES:
        item = web_packages[name]
        suffix = name.removeprefix("@peanut-admin/")
        if not isinstance(item, dict) or set(item) != {"version", "archive", "sha256"} \
                or not isinstance(item.get("version"), str) or not SEMVER.fullmatch(item["version"]) \
                or item.get("archive") != f"packages/core-web/peanut-admin-{suffix}-{item.get('version')}.tgz" \
                or not re.fullmatch(r"[0-9a-f]{64}", str(item.get("sha256", ""))):
            fail(f"local Web Core archive identity is invalid: {name}")
        if web_version is None:
            web_version = item["version"]
        if item["version"] != web_version:
            fail("local Web Core six-package versions must match")
        archive_rows.append(item)
    archive_paths = set()
    for row in archive_rows:
        relative = Path(row["path"] if "path" in row else row["archive"])
        if relative.is_absolute() or ".." in relative.parts:
            fail("local Core archive path is unsafe")
        source = core_inputs_path.parent / relative
        if source.is_symlink() or not source.is_file() or sha256(source) != row["sha256"]:
            fail("local Core archive bytes differ from the receipt")
        target = ROOT / relative
        if target.exists() or target.is_symlink():
            fail(f"Core archive output already exists in source snapshot: {relative}")
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(source, target)
        target.chmod(0o644)
        archive_paths.add(relative.as_posix())
    versions = read_json(ROOT / "release-versions.json")
    composer_path = ROOT / "server/composer.json"
    composer = read_json(composer_path)
    if composer.get("require", {}).get("peanut-admin/core") is None:
        fail("snapshot is missing its PHP Core declaration")
    composer["require"]["peanut-admin/core"] = php_version
    existing = composer.get("repositories", [])
    repositories = [inputs["composer_repository"]]
    repositories.extend(item for item in existing if isinstance(item, dict)
                        and not (item.get("type") == "vcs" and "peanut-admin-core-php" in str(item.get("url", ""))))
    composer["repositories"] = repositories
    write_json(composer_path, composer)
    for client, selected in CLIENT_CORE_PACKAGES.items():
        path = ROOT / client / "package.json"
        manifest = read_json(path)
        for section in ("dependencies", "devDependencies", "optionalDependencies"):
            for name in selected:
                if name in manifest.get(section, {}):
                    manifest[section][name] = "file:../" + web_packages[name]["archive"]
        write_json(path, manifest)
    versions["core_php"] = php
    versions["core_web"] = web
    write_json(ROOT / "release-versions.json", versions)
    preflight_tools()
    lock_tool = ROOT / "scripts/release-dependency-locks.mjs"
    before = subprocess.check_output(["node", str(lock_tool), str(ROOT), "--third-party-only",
                                      "--tool-root=" + str(tool_root)], text=True)
    run_native_lock_updates(False)
    after = subprocess.check_output(["node", str(lock_tool), str(ROOT), "--third-party-only",
                                     "--tool-root=" + str(tool_root)], text=True)
    if json.loads(before) != json.loads(after):
        fail("local Core projection changed unrelated native locks")
    subprocess.run(["node", str(lock_tool), str(ROOT), "--internal-candidate",
                    "--tool-root=" + str(tool_root)], check=True)
    return {"status": "prepared", "core_php": php, "core_web": web,
            "archives": sorted(archive_paths),
            "lockfiles": {relative: sha256(ROOT / relative) for relative in (
                "server/composer.lock", "web/pnpm-lock.yaml", "platform/package-lock.json",
                "pc/package-lock.json", "uniapp/package-lock.json")}}


def update_release_versions(product_version: str, core_php: dict[str, str], core_web: dict[str, Any]) -> None:
    data = read_json(ROOT / "release-versions.json")
    data.update(
        {
            "schema_version": 3,
            "protocol": "peanut.release-versions.v3",
            "source_product_version": product_version,
            "instance_version": None,
            "scaffold_template": product_version,
            "core_php": core_php,
            "core_web": core_web,
        }
    )
    write_json(ROOT / "release-versions.json", data)


def update_release_metadata(product_version: str, core_php: dict[str, str], core_web: dict[str, Any]) -> None:
    channel = "prerelease" if "-" in product_version.split("+", 1)[0] else "stable"
    data = read_json(ROOT / "RELEASE_METADATA.json")
    data["schema_version"] = 3
    data["protocol"] = "peanut.release-metadata.v3"
    data["source_product_version"] = product_version
    data["instance_version"] = None
    data["expected_tag"] = f"v{product_version}"
    data["release_date"] = dt.date.today().isoformat()
    data["public_runtime_dependencies"] = {"composer": core_php, "npm": core_web}
    data["lockfiles"] = {
        "server/composer.lock": sha256(ROOT / "server/composer.lock"),
        "web/pnpm-lock.yaml": sha256(ROOT / "web/pnpm-lock.yaml"),
        "platform/package-lock.json": sha256(ROOT / "platform/package-lock.json"),
        "pc/package-lock.json": sha256(ROOT / "pc/package-lock.json"),
        "uniapp/package-lock.json": sha256(ROOT / "uniapp/package-lock.json"),
    }
    data["legal_files"] = {
        relative: required_release_file_sha256(relative)
        for relative in LEGAL_FILES
    }
    data.setdefault("technical_qualification", {})
    data["technical_qualification"].update(
        {
            "phase": f"{product_version}-{channel}-candidate",
            "result": "pending",
            "final_candidate_commit": None,
            "final_candidate_tree": None,
            "run_id": None,
            "groups_passed": 0,
            "summary_sha256": None,
            "cleanup_residual_count": None,
            "lease_released": False,
            "scaffold_version": product_version,
            "application_initial_version": read_json(ROOT / "release-versions.json")["generated_instance_default"],
            "evidence": f"Product {channel} candidate identity is prepared from public Core registry locks; qualification remains pending.",
            "release_delta": RELEASE_DELTA,
        }
    )
    write_json(ROOT / "RELEASE_METADATA.json", data)


PREPARED_FILES = (
    "server/composer.json", "server/composer.lock", "web/package.json", "web/pnpm-lock.yaml",
    "platform/package.json", "platform/package-lock.json", "pc/package.json", "pc/package-lock.json",
    "uniapp/package.json", "uniapp/package-lock.json", "release-versions.json", "RELEASE_METADATA.json",
)


def check_inputs(product_version: str) -> None:
    versions = read_json(ROOT / "release-versions.json")
    if (versions.get("schema_version"), versions.get("protocol"), versions.get("instance_version")) != (3, "peanut.release-versions.v3", None):
        fail("unsupported product version contract")
    require_semver(versions.get("generated_instance_default", ""), "APP initial version")
    metadata = read_json(ROOT / "RELEASE_METADATA.json")
    if not isinstance(metadata.get("technical_qualification"), dict) or metadata["technical_qualification"].get("result") not in ("pending", None):
        fail("existing qualified release metadata must not be replaced")
    qualification = metadata["technical_qualification"]
    if versions.get("source_product_version") == product_version:
        sealed_fields = ("final_candidate_commit", "final_candidate_tree", "run_id",
                         "summary_sha256", "cleanup_residual_count")
        if (qualification.get("result") != "pending"
                or any(qualification.get(field) is not None for field in sealed_fields)
                or qualification.get("groups_passed", 0) != 0
                or qualification.get("lease_released", False)):
            fail("same-version preparation requires a pending, unsealed candidate without qualification evidence")
    if (ROOT / "scaffold/releases" / f"v{product_version}").exists():
        fail("fixed scaffold release already exists")
    composer = read_json(ROOT / "server/composer.json")
    if "peanut-admin/core" not in composer.get("require", {}):
        fail("server/composer.json is missing peanut-admin/core")
    if any(item.get("type") in ("path", "artifact", "package") for item in composer.get("repositories", []) if isinstance(item, dict)):
        fail("server/composer.json has a local or synthetic package repository")
    for client, names in CLIENT_CORE_PACKAGES.items():
        manifest = read_json(ROOT / client / "package.json")
        dependencies = manifest.get("dependencies", {})
        if any(name not in dependencies for name in names):
            fail(f"{client}/package.json is missing a Core Web dependency")
        for section in ("dependencies", "devDependencies", "optionalDependencies"):
            for name, spec in manifest.get(section, {}).items():
                if name not in names and isinstance(spec, str) and spec.startswith(("file:", "link:", "workspace:", "git+", "./", "../")):
                    fail(f"{client}/package.json has a local dependency: {name}")


def prepare(product_version: str, core_php_version: str, core_php_reference: str,
            core_web_version: str, core_web_reference: str,
            core_web_package_evidence: tuple[Path, str] | None = None) -> None:
    check_inputs(product_version)
    # Native package managers may fail after writing a lock. Restore every owned input byte on failure.
    originals = {path: (ROOT / path).read_bytes() if (ROOT / path).exists() else None for path in PREPARED_FILES}
    try:
        set_composer_spec(core_php_version)
        set_core_web_specs(core_web_version)
        for path in ("web/package.json", "platform/package.json", "pc/package.json", "uniapp/package.json"):
            update_package_version(ROOT / path, product_version)
        run_native_lock_updates(False)
        core_php = read_core_php(core_php_version, core_php_reference)
        registry_packages = (read_web_package_evidence(
            core_web_package_evidence[0], core_web_package_evidence[1],
            core_web_version, core_web_reference,
        ) if core_web_package_evidence is not None else None)
        core_web = read_core_web(core_web_version, core_web_reference, registry_packages)
        update_release_versions(product_version, core_php, core_web)
        update_release_metadata(product_version, core_php, core_web)
    except BaseException:
        for path, original in originals.items():
            target = ROOT / path
            if original is None:
                target.unlink(missing_ok=True)
            else:
                target.write_bytes(original)
        raise


def prepare_release_workspace(workspace: Path, output_root: Path, local_core: bool,
                              php_version: str | None, web_version: str | None) -> None:
    """Prepare disposable inputs; the CLI owns output selection and atomic adoption."""
    source_root = ROOT
    parent = source_root / '.local/release'
    if not workspace.is_absolute() or workspace.is_symlink() or not workspace.is_dir() \
            or workspace.resolve().parent != parent.resolve() or any(workspace.iterdir()):
        fail('release workspace must be an empty operation directory under .local/release')
    if not output_root.is_absolute() or output_root.resolve() == source_root:
        fail('release output root must be absolute and distinct from source')
    temporary = workspace / 'tmp'
    temporary.mkdir(mode=0o700)
    os.environ['TMPDIR'] = str(temporary)
    helper = source_root / 'scripts/scaffold-runtime/ScaffoldSourceIdentity.php'

    def source_value(root: Path, method: str, excluded: list[str] | None = None) -> Any:
        code = ('require $argv[1]; echo json_encode(\\app\\common\\value\\scaffold\\ScaffoldSourceIdentity::'
                + method + '($argv[2]' + (', json_decode($argv[3],true,512,JSON_THROW_ON_ERROR)' if excluded is not None else '')
                + '), JSON_THROW_ON_ERROR);')
        command = ['php', '-r', code, str(helper), str(root)]
        if excluded is not None:
            command.append(json.dumps(excluded))
        return json.loads(subprocess.check_output(command, text=True, cwd=source_root))

    def snapshot(root: Path, target: Path) -> None:
        root = root.resolve(strict=True)
        exclusions = [output_root.resolve().relative_to(root).as_posix()] if output_root.resolve().is_relative_to(root) else []
        files = source_value(root, 'files', exclusions)
        target.mkdir(mode=0o700)
        for relative in files:
            original, destination = root / relative, target / relative
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(original, destination)
            destination.chmod(0o755 if original.stat().st_mode & 0o111 else 0o644)

    snapshot_root = workspace / 'source'
    print('[peanut release] Input snapshot', flush=True)
    snapshot(source_root, snapshot_root)
    producer = source_root / 'scripts/prepare-product-release-candidate'
    # Each preparation subcommand retains its own ROOT and native lock contract.
    if local_core:
        print('[peanut release] Core inputs: configured local sources', flush=True)
        host = read_json(source_root / '.local/toolchain/host.json')
        core = host.get('core', {})
        if any(not isinstance(core.get(name), str) or not core[name] for name in ('php', 'web')):
            fail('local PHP and Web Core paths must be configured')
        php_copy, web_copy = workspace / 'core-php', workspace / 'core-web'
        snapshot(source_root / core['php'], php_copy)
        snapshot(source_root / core['web'], web_copy)
        php_digest = source_value(php_copy, 'local')['snapshot_sha256']
        web_digest = source_value(web_copy, 'local')['snapshot_sha256']
        version = read_json(snapshot_root / 'release-versions.json').get('core_php', {}).get('resolved_version')
        if not isinstance(version, str):
            fail('local PHP Core version is missing')
        version = require_semver(version.removeprefix('v'), 'local PHP Core version')
        web_host = source_root / '.local/toolchain/cores/web/host.json'
        read_json(web_host)
        receipt_parent = workspace / 'core-inputs'
        receipt_parent.mkdir()
        receipt_dir = receipt_parent / 'frozen'
        run(['pnpm', '--dir', str(snapshot_root / 'web'), 'install', '--frozen-lockfile', '--ignore-scripts'])
        php_executable = shutil.which('php')
        if php_executable is None:
            fail('registered PHP command is required')
        run([sys.executable, str(source_root / 'scripts/project-env'), '--root', str(web_copy),
             '--state-root', str(source_root), '--host', str(web_host), 'exec', '--', sys.executable,
             str(source_root / 'scripts/freeze-core-release'), '--local', f'--php-core-dir={php_copy}',
             f'--web-core-dir={web_copy}', f'--output={receipt_dir}', f'--php-version={version}',
             f'--php-source-sha256={php_digest}', f'--web-source-sha256={web_digest}',
             f'--source-identity-helper={helper}', f'--source-identity-php={php_executable}'])
        run([sys.executable, str(producer), f'--prepare-local-core-snapshot={snapshot_root}',
             f'--core-inputs={receipt_dir / "release-core-inputs.json"}', f'--tool-root={snapshot_root}'])
    else:
        print('[peanut release] Core inputs: published fixed releases', flush=True)
        resolution = resolve_core_release(php_version, web_version)
        resolution_path = workspace / 'core-resolution.json'
        write_json(resolution_path, resolution)
        run([sys.executable, str(producer), f'--prepare-core-snapshot={snapshot_root}',
             f'--core-resolution={resolution_path}'])
    print('[peanut release] Derived inputs: locked dependencies, API, inventory', flush=True)
    run(['composer', 'install', f'--working-dir={snapshot_root / "server"}', '--no-scripts', '--no-plugins',
         '--no-interaction', '--no-progress', '--prefer-dist'])
    run(['pnpm', '--dir', str(snapshot_root / 'web'), 'install', '--frozen-lockfile', '--ignore-scripts'])
    run(['php', str(snapshot_root / 'scripts/generate-api-contracts.php')])
    run(['php', str(snapshot_root / 'scripts/build-application-template-inventory'), '--local'])


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument('--prepare-release-workspace', type=Path,
                        help='Prepare complete source/Core/derived inputs in an empty .local/release operation directory.')
    parser.add_argument('--release-output-root', type=Path)
    parser.add_argument('--with-local-core', action='store_true')
    parser.add_argument("--resolve-core", action="store_true",
                        help="Read-only resolution of exact published stable Core package identities.")
    parser.add_argument("--prepare-core-snapshot", type=Path,
                        help="Update only a disposable Code source snapshot from a verified Core resolution.")
    parser.add_argument("--prepare-local-core-snapshot", type=Path,
                        help="Project an existing local Core receipt into a disposable Code source copy.")
    parser.add_argument("--core-resolution", type=Path,
                        help="Exact JSON emitted by --resolve-core; used with --prepare-core-snapshot.")
    parser.add_argument("--core-inputs", type=Path,
                        help="Local frozen Core receipt; used with --prepare-local-core-snapshot.")
    parser.add_argument("--tool-root", type=Path,
                        help="Registered Code tooling root used only to parse the native Web lock.")
    parser.add_argument("--core-php-version")
    parser.add_argument("--core-web-version")
    parser.add_argument("--version")
    parser.add_argument("--core-php-reference")
    parser.add_argument("--core-web-reference")
    parser.add_argument("--core-web-package-evidence", type=Path)
    parser.add_argument("--core-web-package-evidence-sha256")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args()

    if args.prepare_release_workspace is not None:
        if args.release_output_root is None or args.resolve_core or args.prepare_core_snapshot or args.prepare_local_core_snapshot \
                or args.core_resolution or args.core_inputs or args.tool_root or args.version or args.core_php_reference \
                or args.core_web_reference or args.core_web_package_evidence or args.core_web_package_evidence_sha256 or args.dry_run \
                or (args.with_local_core and (args.core_php_version or args.core_web_version)):
            fail('--prepare-release-workspace requires only output root and optional Core selectors')
        prepare_release_workspace(args.prepare_release_workspace, args.release_output_root,
                                  args.with_local_core, args.core_php_version, args.core_web_version)
        return
    if args.release_output_root is not None or args.with_local_core:
        fail('--release-output-root and --with-local-core require --prepare-release-workspace')

    if args.resolve_core:
        if args.prepare_core_snapshot or args.prepare_local_core_snapshot or args.core_resolution or args.core_inputs or args.tool_root or args.version or args.core_php_reference or args.core_web_reference or args.core_web_package_evidence:
            fail("--resolve-core accepts only optional exact Core version selectors")
        print(json.dumps(resolve_core_release(args.core_php_version, args.core_web_version),
                         ensure_ascii=False, separators=(",", ":")))
        return

    if args.prepare_core_snapshot is not None:
        if args.prepare_local_core_snapshot or args.core_inputs or args.tool_root or args.core_resolution is None or args.version or args.core_php_version or args.core_web_version \
                or args.core_php_reference or args.core_web_reference or args.core_web_package_evidence:
            fail("--prepare-core-snapshot requires only --core-resolution")
        preflight_tools()
        print(json.dumps(prepare_core_snapshot(args.prepare_core_snapshot, args.core_resolution),
                         ensure_ascii=False, separators=(",", ":")))
        return

    if args.prepare_local_core_snapshot is not None:
        if args.prepare_core_snapshot or args.core_resolution or args.core_inputs is None or args.tool_root is None \
                or args.version or args.core_php_version or args.core_web_version \
                or args.core_php_reference or args.core_web_reference or args.core_web_package_evidence:
            fail("--prepare-local-core-snapshot requires --core-inputs and --tool-root")
        preflight_tools()
        print(json.dumps(prepare_local_core_snapshot(args.prepare_local_core_snapshot, args.core_inputs, args.tool_root),
                         ensure_ascii=False, separators=(",", ":")))
        return

    if not all((args.version, args.core_php_version, args.core_web_version,
                args.core_php_reference, args.core_web_reference)):
        fail("product release preparation requires version and exact PHP/Web Core version/reference")

    product_version = require_semver(args.version, "product version")
    core_php_version = require_semver(args.core_php_version, "Core PHP version")
    core_web_version = require_semver(args.core_web_version, "Core Web version")
    if '-' not in product_version.split('+', 1)[0] and any(
        '-' in version.split('+', 1)[0] for version in (core_php_version, core_web_version)
    ):
        fail("Stable product releases require stable Core PHP and Core Web versions")
    if any(re.search(r"(?:^|[.-])dev(?:[.-]|$)", version) for version in (core_php_version, core_web_version)):
        fail("Core versions must be fixed public releases, not development versions")
    if not re.fullmatch(r"[0-9a-f]{40}", args.core_php_reference):
        fail("Core PHP source reference must be a full lowercase SHA")
    if not re.fullmatch(r"[0-9a-f]{40}", args.core_web_reference):
        fail("Core Web source reference must be a full lowercase SHA")
    if (args.core_web_package_evidence is None) != (args.core_web_package_evidence_sha256 is None):
        fail("Web Core package evidence path and SHA-256 must be supplied together")
    core_web_package_evidence = None
    if args.core_web_package_evidence is not None:
        if not re.fullmatch(r"[0-9a-f]{64}", args.core_web_package_evidence_sha256):
            fail("Web Core package evidence SHA-256 must be lowercase hex")
        read_web_package_evidence(
            args.core_web_package_evidence,
            args.core_web_package_evidence_sha256,
            core_web_version,
            args.core_web_reference,
        )
        core_web_package_evidence = (args.core_web_package_evidence, args.core_web_package_evidence_sha256)

    check_inputs(product_version)
    if args.dry_run:
        print(f"DRY-RUN product version: {product_version}")
        print(f"DRY-RUN Core PHP: peanut-admin/core {core_php_version} {args.core_php_reference}")
        print(f"DRY-RUN Core Web: six @peanut-admin packages {core_web_version} {args.core_web_reference}")
        run_native_lock_updates(True)
        return

    preflight_tools()
    prepare(product_version, core_php_version, args.core_php_reference,
            core_web_version, args.core_web_reference, core_web_package_evidence)


if __name__ == "__main__":
    main()
