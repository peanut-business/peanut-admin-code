{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Controlled Task/Notification consumer inputs",
  "$defs": {
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "operation_id",
        "case_id",
        "protection_receipt",
        "resource_permission_receipt",
        "source_commit",
        "expires_at",
        "result_path",
        "fixture_sha256",
        "protection_sha256",
        "resource_permission_sha256",
        "schema_version",
        "steps",
        "remaining_http_budget",
        "protected_job_ids"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "operation_id": {
          "type": "string"
        },
        "case_id": {
          "enum": [
            "FUN-05",
            "WF-D05",
            "WF-D06",
            "WF-D07",
            "WF-D08",
            "WF-D09",
            "WF-D10",
            "WF-D11"
          ]
        },
        "protection_receipt": {
          "type": "string"
        },
        "resource_permission_receipt": {
          "type": "string"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "expires_at": {
          "type": "string"
        },
        "result_path": {
          "type": "string"
        },
        "fixture_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "protection_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "resource_permission_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "schema_version": {
          "const": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "diagnostics",
              "inbox",
              "mark-read",
              "recover"
            ]
          }
        },
        "remaining_http_budget": {
          "type": "integer",
          "minimum": 1
        },
        "protected_job_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_commit",
        "app_root",
        "source_sha256",
        "php",
        "origin",
        "host_header",
        "tenant_id",
        "principal",
        "instance_key",
        "sequence_no",
        "outbox_key",
        "task",
        "message",
        "strategy",
        "idempotency_key",
        "expected_status",
        "assertions",
        "row_scope_receipt",
        "row_scope_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "app_root": {
          "type": "string"
        },
        "source_sha256": {
          "type": "object",
          "minProperties": 9,
          "maxProperties": 9,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "php": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "binary",
            "sha256",
            "version",
            "runtime_receipt",
            "runtime_receipt_sha256"
          ],
          "properties": {
            "binary": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "version": {
              "type": "string",
              "pattern": "^8\\.3\\.[0-9]+$"
            },
            "runtime_receipt": {
              "type": "string"
            },
            "runtime_receipt_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "origin": {
          "type": "string"
        },
        "host_header": {
          "type": "string"
        },
        "tenant_id": {
          "type": "integer",
          "minimum": 1
        },
        "principal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "account_id",
            "member_id",
            "session_reference",
            "token_sha256"
          ],
          "properties": {
            "account_id": {
              "type": "integer",
              "minimum": 1
            },
            "member_id": {
              "type": "integer",
              "minimum": 1
            },
            "session_reference": {
              "type": "string"
            },
            "token_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "instance_key": {
          "type": "string",
          "pattern": "^instance_[0-9a-f]{32}$"
        },
        "sequence_no": {
          "type": "integer",
          "minimum": 1
        },
        "outbox_key": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^outbox_[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "task": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "job_key",
                "revision",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "job_key": {
                  "type": "string",
                  "pattern": "^job_[0-9a-f]{32}$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "status": {
                  "enum": [
                    "queued",
                    "running",
                    "dead",
                    "succeeded",
                    "cancelled"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "message_key",
                "revision"
              ],
              "properties": {
                "message_key": {
                  "type": "string",
                  "pattern": "^notice_[0-9a-f]{32}$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "strategy": {
          "enum": [
            "retry_original",
            "reauthorize"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{7,127}$"
        },
        "expected_status": {
          "enum": [
            200,
            401,
            403,
            404,
            409
          ]
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pointer",
              "equals"
            ],
            "properties": {
              "pointer": {
                "type": "string",
                "pattern": "^/"
              },
              "equals": {}
            }
          }
        },
        "row_scope_receipt": {
          "type": "string"
        },
        "row_scope_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "access_token"
      ],
      "properties": {
        "access_token": {
          "type": "string",
          "pattern": "^pa_tat_[A-Za-z0-9_-]+$"
        }
      }
    }
  }
}
