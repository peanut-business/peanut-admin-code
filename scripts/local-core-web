#!/usr/bin/env bash

set -Eeuo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
ROOT_DIR="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
WEB_DIR="$ROOT_DIR/web"
CORE_DIR=""
CORE_PACKAGE_DIR="$CORE_DIR/packages/web"
TARGET_DIR="$WEB_DIR/node_modules/@peanut-admin"
TARGET="$TARGET_DIR/admin"
ACTION="${1:-link}"
[ $# -gt 0 ] && shift
PEER_PACKAGES=(element-plus pinia vue vue-router)

die() {
    printf 'local-core-web: %s\n' "$*" >&2
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --core-dir) [[ $# -ge 2 ]] || die '--core-dir requires a value'; CORE_DIR="$2"; shift 2 ;;
        *) die "unsupported argument: $1" ;;
    esac
done
[[ "$CORE_DIR" == /* ]] || die '--core-dir must be an absolute path'
CORE_DIR="$(CDPATH= cd -- "$CORE_DIR" && pwd)"
if [[ -f "$CORE_DIR/package.json" ]]; then
    CORE_PACKAGE_DIR="$CORE_DIR"
elif [[ -f "$CORE_DIR/packages/web/package.json" ]]; then
    CORE_PACKAGE_DIR="$CORE_DIR/packages/web"
else
    die "core Web checkout not found: expected $CORE_DIR/package.json or $CORE_DIR/packages/web/package.json"
fi
[[ -d "$WEB_DIR" ]] || die "application Web directory is missing: $WEB_DIR"
[[ -f "$WEB_DIR/package.json" ]] || die "application Web manifest is missing: $WEB_DIR/package.json"

CORE_PACKAGE_DIR="$(CDPATH= cd -- "$CORE_PACKAGE_DIR" && pwd)"
required_version="$(node -e 'const manifest = require(process.argv[1]); process.stdout.write(manifest.dependencies?.["@peanut-admin/admin"] ?? "")' "$WEB_DIR/package.json")"
core_version="$(node -e 'const manifest = require(process.argv[1]); process.stdout.write(manifest.version ?? "")' "$CORE_PACKAGE_DIR/package.json")"
[[ -n "$required_version" ]] || die 'web/package.json does not pin @peanut-admin/admin'
[[ "$required_version" == "$core_version" ]] || die "version mismatch: application requires $required_version, local core declares $core_version"

link_application_peer() {
    local package="$1"
    local installed_package
    local peer_target="$CORE_PACKAGE_DIR/node_modules/$package"

    installed_package="$(cd "$WEB_DIR" && node -e 'const path = require("path"); process.stdout.write(path.dirname(require.resolve(process.argv[1] + "/package.json")))' "$package")"
    [[ -d "$installed_package" ]] || die "application peer package is missing: $package"
    mkdir -p "$(dirname "$peer_target")"
    if [[ -e "$peer_target" && ! -L "$peer_target" ]]; then
        [[ -d "$peer_target" ]] || die "local core peer path is not a directory: $peer_target"
        return 0
    fi
    if [[ -L "$peer_target" ]]; then
        rm -f "$peer_target"
    fi
    ln -s "$installed_package" "$peer_target"
}

assert_application_peer() {
    local package="$1"
    local peer_target="$CORE_PACKAGE_DIR/node_modules/$package"

    [[ -d "$peer_target" || -L "$peer_target" ]] || die "local core peer package is unavailable: $peer_target"
}

case "$ACTION" in
    link)
        [[ -d "$WEB_DIR/node_modules" ]] || die "install application Web dependencies before linking: $WEB_DIR/node_modules is missing"
        mkdir -p "$TARGET_DIR"
        if [[ -e "$TARGET" || -L "$TARGET" ]]; then
            [[ -L "$TARGET" ]] || die "refusing to replace a non-symlink package path: $TARGET"
            rm -f "$TARGET"
        fi
        ln -s "$CORE_PACKAGE_DIR" "$TARGET"
        for package in "${PEER_PACKAGES[@]}"; do
            link_application_peer "$package"
        done
        ;;
    status)
        [[ -L "$TARGET" ]] || die "local core Web package is not linked: $TARGET"
        for package in "${PEER_PACKAGES[@]}"; do
            assert_application_peer "$package"
        done
        ;;
    *)
        die 'usage: scripts/local-core-web {link|status} --core-dir /absolute/path'
        ;;
esac

[[ -L "$TARGET" ]] || die "local core Web package is not symlinked: $TARGET"
resolved_core="$(realpath "$TARGET")"
[[ "$resolved_core" == "$CORE_PACKAGE_DIR" ]] || die "core symlink resolves to $resolved_core, expected $CORE_PACKAGE_DIR"

printf 'local core Web active: %s -> %s\n' "$TARGET" "$resolved_core"
