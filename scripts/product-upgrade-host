#!/usr/bin/env python3
"""Fixed-image runtime phases subordinate to scripts/upgrade's product state."""
import argparse
import contextlib
import hashlib
import importlib.util
import io
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import stat
import sys
import urllib.request

# Frozen adapter directories must remain exactly their authenticated inventory.
sys.dont_write_bytecode = True


def sha(path):
    if path.is_symlink() or not path.is_file() or path.stat().st_nlink != 1:
        raise ValueError('phase input is missing or linked')
    return hashlib.sha256(path.read_bytes()).hexdigest()


def read(path, protected=False):
    sha(path)
    if protected and (path.resolve() != path or path.stat().st_mode & 0o777 != 0o600
                      or path.stat().st_uid not in (0, os.geteuid())):
        raise ValueError('dependency record is not protected')
    return json.loads(path.read_text())


def write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = path.with_name(path.name + '.next-' + os.urandom(8).hex())
    with temporary.open('xb') as output:
        os.fchmod(output.fileno(), 0o600)
        output.write(json.dumps(value, sort_keys=True).encode())
        output.flush(); os.fsync(output.fileno())
    os.replace(temporary, path)
    descriptor = os.open(path.parent, os.O_RDONLY)
    try: os.fsync(descriptor)
    finally: os.close(descriptor)


def run(*args, cwd=None):
    result = subprocess.run([str(a) for a in args], cwd=cwd, stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=650)
    if result.returncode:
        for line in result.stderr.decode('utf-8', errors='replace').splitlines():
            if not line.startswith('module-preflight:') or len(line) > 2048:
                continue
            try:
                diagnostic = json.loads(line[len('module-preflight:'):])
            except ValueError:
                continue
            if diagnostic.get('phase') != 'module-preflight' or not re.fullmatch(r'[A-Z][A-Z0-9_]{0,127}', str(diagnostic.get('code', ''))):
                continue
            safe = {'phase': 'module-preflight', 'code': diagnostic['code']}
            for key in ('plugin_key', 'module_key'):
                if re.fullmatch(r'[A-Za-z0-9_.:-]{1,128}', str(diagnostic.get(key, ''))): safe[key] = diagnostic[key]
            if re.fullmatch(r'[a-f0-9]{64}', str(diagnostic.get('diagnostic_sha256', ''))):
                safe['diagnostic_sha256'] = diagnostic['diagnostic_sha256']
            raise RuntimeError('module-preflight:' + json.dumps(safe, separators=(',', ':')))
        raise RuntimeError(f'phase command exit={result.returncode}; diagnostic_sha256={hashlib.sha256(result.stderr).hexdigest()}')
    return result.stdout.decode().strip()


def dependency_tree(root):
    """Exact process-interruption proof, including directory modes and walk failures."""
    if root.resolve() != root or root.is_symlink(): raise ValueError('unsafe dependency path')
    if not root.exists() and not root.is_symlink(): return None
    if root.resolve() != root or root.is_symlink() or not root.is_dir(): raise ValueError('unsafe dependency directory')
    files, directories = {}, {}
    def failed(error): raise error
    for base, dirs, names in os.walk(root, followlinks=False, onerror=failed):
        directory = Path(base)
        for child in [directory, *(directory / name for name in dirs)]:
            if child.is_symlink() or not child.is_dir() or child.stat().st_dev != root.stat().st_dev:
                raise ValueError('linked or mounted dependency directory')
        info = directory.stat()
        directories[directory.relative_to(root).as_posix()] = [stat.S_IMODE(info.st_mode), info.st_uid, info.st_gid]
        for name in names:
            path = directory / name; info = path.lstat()
            if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_dev != root.stat().st_dev:
                raise ValueError('unsafe dependency file')
            files[path.relative_to(root).as_posix()] = [sha(path), stat.S_IMODE(info.st_mode), info.st_uid, info.st_gid]
    return {'files': dict(sorted(files.items())), 'directories': dict(sorted(directories.items()))}


def dependency_record(path, value):
    if path.parent.resolve() != path.parent: raise ValueError('linked dependency record parent')
    if path.exists() or path.is_symlink():
        if read(path, True) != value: raise ValueError('immutable dependency record changed')
    else: write(path, value)


def dependency_inputs(workspace, inputs):
    server = Path(inputs['server_root'])
    if server not in (workspace / 'tools/prepared/server', workspace / 'dependencies/prepared/server'):
        raise ValueError('dependency stage is outside its fixed workspace')
    for directory in (server.parent.parent, server.parent, server):
        directory.mkdir(exist_ok=True, mode=0o700)
        if directory.resolve() != directory or directory.is_symlink() or directory.stat().st_mode & 0o077:
            raise ValueError('dependency staging directory is not private')
    for relative, proof in inputs['files'].items():
        if relative.startswith('/') or any(p in ('', '.', '..') for p in relative.split('/')) or '\\' in relative:
            raise ValueError('unsafe dependency input path')
        source = Path(proof['source']); target = server / relative
        if source.resolve() != source or sha(source) != proof['sha256'] or source.stat().st_mode & 0o777 != proof['mode']:
            raise ValueError('dependency source input changed')
        target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        if target.parent.resolve() != target.parent: raise ValueError('linked dependency stage parent')
        if target.exists() or target.is_symlink():
            if sha(target) != proof['sha256'] or target.stat().st_mode & 0o777 != proof['mode']:
                raise ValueError('dependency staging input changed')
        else:
            with target.open('xb') as output:
                os.fchmod(output.fileno(), proof['mode']); output.write(source.read_bytes()); output.flush(); os.fsync(output.fileno())
    for relative, proof in (inputs['archives'] or {}).items():
        source = Path(inputs['source_root']) / relative; target = server.parent / relative
        if source.resolve() != source or sha(source) != proof['sha256'] or source.stat().st_mode & 0o777 != 0o644:
            raise ValueError('canonical dependency archive changed')
        target.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
        if target.parent.resolve() != target.parent: raise ValueError('linked archive staging parent')
        if target.exists() or target.is_symlink():
            if sha(target) != proof['sha256']: raise ValueError('staged archive changed')
        else:
            with target.open('xb') as output:
                os.fchmod(output.fileno(), 0o644); output.write(source.read_bytes()); output.flush(); os.fsync(output.fileno())
    proof = {key: inputs[key] for key in ('server_root', 'composer_sha256', 'lock_sha256', 'archives')}
    dependency_record(server / '.vendor-inputs.json', {'protocol': 'peanut.source-vendor-inputs.v1', **proof})
    return server


def source_tools(root, workspace, check, expected=None):
    authority = workspace / 'tool-inputs.json'; inputs = read(authority, True)
    if authority.stat().st_mode & 0o777 != 0o600 or inputs.get('protocol') != 'peanut.source-tools-inputs.v1' \
            or inputs['instance_root'] != str(root) or inputs['workspace'] != str(workspace):
        raise ValueError('tool bundle input authority is invalid')
    trusted = workspace / 'trusted'
    for relative, digest in inputs['tools'].items():
        if sha(trusted / relative) != digest or (trusted / relative).stat().st_mode & 0o777 != inputs['tool_modes'][relative]:
            raise ValueError('frozen tool program changed')
    receipt = workspace / 'tools/bundle.json'
    server = workspace / 'tools/prepared/server'
    helper = trusted / 'server/docker/scripts/vendor-state.py'
    if receipt.exists() or receipt.is_symlink():
        if receipt.stat().st_mode & 0o777 != 0o600: raise ValueError('tool receipt mode changed')
        document = read(receipt, True)
        if expected is not None and sha(receipt) != expected: raise ValueError('tool bundle receipt changed')
        if document['input_sha256'] != sha(authority) or dependency_tree(server.parent) != document['tree']:
            raise ValueError('independent tool bundle changed')
    else:
        if check or expected is not None: raise ValueError('complete independent tool bundle is required')
        server = dependency_inputs(workspace, inputs['inputs'])
        # Resolve and authenticate the existing instance image before any pending/write boundary.
        spec = importlib.util.spec_from_file_location('tool_compose', trusted / 'server/docker/scripts/configure-collaboration.py')
        owner = importlib.util.module_from_spec(spec); spec.loader.exec_module(owner)
        ids = run(*owner.compose_arguments(root / 'server'), 'ps', '-a', '-q', 'php', cwd=root / 'server/docker').splitlines()
        if len(ids) != 1: raise ValueError('tool preparation PHP identity is ambiguous')
        detail = json.loads(run('docker', 'inspect', '--format',
            '{"Image":{{json .Image}},"Labels":{{json .Config.Labels}},"Mounts":{{json .Mounts}}}', ids[0]))
        labels = detail['Labels']
        if labels.get('com.docker.compose.service') != 'php' or labels.get('com.docker.compose.project.working_dir') != str(root / 'server/docker') \
                or not re.fullmatch(r'sha256:[a-f0-9]{64}', detail['Image']) \
                or sum(m.get('Type') == 'bind' and m.get('Source') == str(root / 'server')
                       and m.get('Destination') == '/run/peanut-owner/server' for m in detail['Mounts']) != 1 \
                or sum(m.get('Type') == 'bind' and m.get('Source') == str(root / 'server')
                       and m.get('Destination') == '/var/www/peanut-http/server' and m.get('RW') is False for m in detail['Mounts']) != 1:
            raise ValueError('tool preparation image belongs to another instance')
        config = json.loads(run(*owner.compose_arguments(root / 'server'), 'config', '--format', 'json', cwd=root / 'server/docker'))
        discovered = run('docker', 'ps', '-a', '--no-trunc', '--filter', 'label=com.docker.compose.project=' + config['name'],
                         '--filter', 'label=com.docker.compose.service=php', '--format', '{{.ID}}').splitlines()
        planned = config['services']['php']['volumes']
        expected_binds = sorted((v['source'], v['target'], v.get('read_only', False)) for v in planned if v['type'] == 'bind')
        actual_binds = sorted((v['Source'], v['Destination'], not v['RW']) for v in detail['Mounts'] if v['Type'] == 'bind')
        if labels.get('com.docker.compose.project') != config['name'] or discovered != ids \
                or any(v['type'] not in ('bind', 'tmpfs') for v in planned) or actual_binds != expected_binds:
            raise ValueError('tool preparation project or complete mounts differ from the native instance')
        build = {'input_sha256': sha(authority), 'image': detail['Image'], 'project': labels['com.docker.compose.project']}
        dependency_record(workspace / 'tools/build.json', build)
        run('sh', trusted / 'server/docker/scripts/prepare-vendor.sh', 'prepared', server, build['image'])
        for relative, proof in inputs['loaded_vendor'].items():
            path = server / 'vendor' / relative
            if path.resolve() != path or sha(path) != proof['sha256'] or path.stat().st_mode & 0o777 != proof['mode']:
                raise ValueError('independently installed tool dependency differs from a loaded dependency')
        document = {**build, 'tree': dependency_tree(server.parent)}
        dependency_record(receipt, document)
    run(sys.executable, helper, 'check', '--server', server, '--inputs', server / '.vendor-inputs.json')
    return {'tool_bundle_sha256': sha(receipt), 'tool_image': document['image'], 'tool_project': document['project']}


def source_vendor(root, workspace, state, phase):
    trusted = workspace / 'trusted'; server = root / 'server'
    helper = trusted / 'server/docker/scripts/vendor-state.py'
    preflight_path = workspace / 'recovery/vendor-preflight.json'
    def original_pair(source):
        run(sys.executable, helper, 'check', '--server', source)
        return {'tree': dependency_tree(source / 'vendor'), 'composer_sha256': sha(source / 'composer.json'),
                'lock_sha256': sha(source / 'composer.lock'), 'composer_mode': source.joinpath('composer.json').stat().st_mode & 0o777,
                'lock_mode': source.joinpath('composer.lock').stat().st_mode & 0o777}
    if phase == 'vendor-preflight':
        if state.get('vendor_preflight_sha256') is not None and sha(preflight_path) != state['vendor_preflight_sha256']:
            raise ValueError('pre-pending vendor proof changed')
        sources = sorted({server, Path(state['binding']['tool_root']) / 'server'})
        document = {'transition_id': state['transition_id'], 'servers': {str(source): original_pair(source) for source in sources}}
        dependency_record(preflight_path, document)
        return {'sha256': sha(preflight_path)}
    spec = importlib.util.spec_from_file_location('source_vendor_quiescence', trusted / 'server/docker/scripts/update-recovery.py')
    recovery = importlib.util.module_from_spec(spec); spec.loader.exec_module(recovery)
    observed = recovery.assert_stopped(server)
    if observed != {key: state['quiescence'][key] for key in observed}:
        raise ValueError('vendor operation lost its exact stopped-container/image proof')
    old_path = workspace / 'recovery/vendor-original.json'
    current, backup = server / 'vendor', workspace / 'recovery/old-vendor'
    staged, quarantine = workspace / 'dependencies/prepared/server/vendor', workspace / 'recovery/new-vendor'
    if phase == 'vendor-record':
        if sha(preflight_path) != state['vendor_preflight_sha256']: raise ValueError('pre-pending vendor proof changed')
        preflight = read(preflight_path, True)
        sources = sorted({server, Path(state['binding']['tool_root']) / 'server'})
        if preflight != {'transition_id': state['transition_id'], 'servers': {str(source): original_pair(source) for source in sources}}:
            raise ValueError('original APP or tool dependencies drifted after pre-pending verification')
        document = {'transition_id': state['transition_id'], **preflight['servers'][str(server)]}
        dependency_record(old_path, document)
        return {'sha256': sha(old_path)}
    if sha(old_path) != state['vendor_original_sha256']: raise ValueError('original vendor proof changed')
    old = read(old_path, True)
    if old['transition_id'] != state['transition_id']: raise ValueError('vendor preimage belongs to another transaction')
    if phase == 'vendor-paired':
        if dependency_tree(current) != old['tree'] or sha(server / 'composer.json') != old['composer_sha256'] \
                or sha(server / 'composer.lock') != old['lock_sha256']:
            raise ValueError('restored source and vendor are not the original pair')
        run(sys.executable, helper, 'check', '--server', server)
        return {'status': 'paired'}
    proof_path = workspace / 'dependencies/proof.json'
    if phase == 'vendor-stage':
        if sha(server / 'composer.json') != state['vendor_target_inputs']['composer_sha256'] \
                or sha(server / 'composer.lock') != state['vendor_target_inputs']['lock_sha256']:
            raise ValueError('applied dependency inputs differ from verified source')
        if proof_path.exists() or proof_path.is_symlink():
            proof = read(proof_path, True)
            actual = dependency_tree(current if proof['reuse'] else staged)
            if proof['transition_id'] != state['transition_id'] or proof['inputs'] != state['vendor_target_inputs'] or actual != proof['tree']:
                raise ValueError('complete target dependency stage changed')
        else:
            reuse = old['composer_sha256'] == sha(server / 'composer.json') and old['lock_sha256'] == sha(server / 'composer.lock')
            if reuse:
                if dependency_tree(current) != old['tree'] or dependency_tree(staged) is not None:
                    raise ValueError('unchanged vendor no longer matches its complete preimage')
                run(sys.executable, helper, 'check', '--server', server)
            else:
                target = dependency_inputs(workspace, state['vendor_target_inputs'])
                run('sh', trusted / 'server/docker/scripts/prepare-vendor.sh', 'prepared', target, state['quiescence']['images']['php'])
            proof = {'transition_id': state['transition_id'], 'inputs': state['vendor_target_inputs'],
                     'reuse': reuse, 'tree': dependency_tree(current if reuse else staged)}
            dependency_record(proof_path, proof)
        return {'sha256': sha(proof_path), 'reuse': proof['reuse']}
    if not state.get('vendor_intent'):
        if dependency_tree(current) != old['tree'] or dependency_tree(backup) is not None or dependency_tree(quarantine) is not None:
            raise ValueError('vendor changed before adoption intent')
        staged_tree = dependency_tree(staged)
        if proof_path.exists() or proof_path.is_symlink():
            proof = read(proof_path, True)
            if (state.get('vendor_target_sha256') is not None and sha(proof_path) != state['vendor_target_sha256']) \
                    or proof.get('transition_id') != state['transition_id'] or proof.get('inputs') != state.get('vendor_target_inputs') \
                    or type(proof.get('reuse')) is not bool:
                raise ValueError('unactivated vendor stage is not bound to this transaction')
            if proof['reuse']:
                if staged_tree is not None or proof['tree'] != old['tree']: raise ValueError('unexpected staged vendor for reuse')
            else:
                if staged_tree is None or staged_tree != proof['tree']: raise ValueError('unactivated vendor stage changed')
                run(sys.executable, helper, 'check', '--server', staged.parent, '--inputs', staged.parent / '.vendor-inputs.json')
        elif staged_tree is not None or state.get('vendor_target_sha256') is not None:
            raise ValueError('incomplete or unauthenticated vendor stage; no tree was changed')
        return {'status': 'original'}
    if sha(proof_path) != state['vendor_target_sha256']: raise ValueError('target dependency proof changed')
    target = read(proof_path, True)
    if target['transition_id'] != state['transition_id']: raise ValueError('target vendor belongs to another transaction')
    for directory in (server, backup.parent, staged.parent, quarantine.parent):
        if directory.resolve() != directory or not directory.is_dir() or directory.stat().st_dev != server.stat().st_dev:
            raise ValueError('vendor rename parents are not on one ordinary filesystem')
    for directory in (current, backup, staged, quarantine):
        if directory.exists() and directory.stat().st_dev != server.stat().st_dev:
            raise ValueError('vendor is a different filesystem or mount')
    # Component proofs work while source/lock/vendor are mixed; full installation checks follow pairing.
    physical = tuple(dependency_tree(p) for p in (current, backup, staged, quarantine))
    O, N = old['tree'], target['tree']
    forward = ((O, None, N, None), (None, O, N, None), (N, O, None, None))
    reverse = ((None, O, None, N), (O, None, None, N))
    if physical not in (*forward, *reverse): raise ValueError('unknown vendor physical state; no tree was changed')
    journal_path = workspace / 'dependency-switch.json'
    identity = {'transition_id': state['transition_id'], 'old_proof_sha256': state['vendor_original_sha256'],
                'target_proof_sha256': state['vendor_target_sha256'], 'plan_sha256': state['binding']['plan_sha256']}
    if journal_path.exists() or journal_path.is_symlink():
        journal = read(journal_path, True)
        if any(journal.get(k) != v for k, v in identity.items()): raise ValueError('vendor intent belongs to another transaction')
        allowed = {('forward', 'started'): forward, ('forward', 'completed'): (forward[2],),
                   ('reverse', 'started'): (*forward, *reverse), ('reverse', 'recovered'): (forward[0], reverse[1])}
        if physical not in allowed.get((journal.get('direction'), journal.get('status')), ()):
            raise ValueError('vendor journal and physical state disagree')
    else:
        if physical != forward[0]: raise ValueError('vendor moved without its durable intent')
        if phase == 'vendor-check': return {'status': 'original'}
        journal = {**identity, 'direction': 'forward', 'status': 'started'}; write(journal_path, journal)
    spec = importlib.util.spec_from_file_location('native_vendor_moves', trusted / 'server/docker/scripts/update-preparation.py')
    native = importlib.util.module_from_spec(spec); spec.loader.exec_module(native)
    if phase == 'vendor-switch':
        if state['activation_started'] or journal['direction'] != 'forward' or physical not in forward:
            raise ValueError('vendor forward adoption is no longer allowed')
        if physical == forward[0]: native.move(current, backup)
        physical = tuple(dependency_tree(p) for p in (current, backup, staged, quarantine))
        if physical == forward[1]: native.move(staged, current)
        if tuple(dependency_tree(p) for p in (current, backup, staged, quarantine)) != forward[2]:
            raise ValueError('vendor switch did not reach the exact target state')
        run(sys.executable, helper, 'check', '--server', server)
        journal['status'] = 'completed'; write(journal_path, journal)
        return {'status': 'adopted'}
    if phase == 'vendor-recover':
        if state['activation_started']: raise ValueError('vendor recovery after activation is forbidden')
        journal['direction'] = 'reverse'; journal['status'] = 'started'; write(journal_path, journal)
        if physical == forward[2]: native.move(current, quarantine)
        physical = tuple(dependency_tree(p) for p in (current, backup, staged, quarantine))
        if physical in (forward[1], reverse[0]): native.move(backup, current)
        physical = tuple(dependency_tree(p) for p in (current, backup, staged, quarantine))
        if physical not in (forward[0], reverse[1]): raise ValueError('vendor recovery did not restore its exact preimage')
        journal['status'] = 'recovered'; write(journal_path, journal)
        return {'status': 'restored'}
    return {'status': 'checked'}


def source_runtime():
    parser = argparse.ArgumentParser()
    parser.add_argument('phase', choices=('source-stop', 'source-check', 'source-project', 'source-open', 'source-admit',
        'source-tools', 'source-tools-check', 'source-vendor-preflight', 'source-vendor-record', 'source-vendor-stage', 'source-vendor-switch',
        'source-vendor-recover', 'source-vendor-check', 'source-vendor-paired'))
    parser.add_argument('--instance-root', type=Path, required=True)
    parser.add_argument('--workspace', type=Path, required=True)
    parser.add_argument('--receipt-sha256')
    args = parser.parse_args()
    root, workspace = args.instance_root, args.workspace
    for path in (root, workspace):
        if not path.is_absolute() or path.resolve() != path or path.is_symlink():
            raise ValueError('source maintenance paths are not canonical')
    checkpoint = workspace / 'source-runtime.json'
    if args.phase in ('source-tools', 'source-tools-check'):
        expected = args.receipt_sha256
        identity = sha(workspace / 'tool-inputs.json')
        if checkpoint.exists() or checkpoint.is_symlink():
            state = read(checkpoint, True); checksum = state.pop('state_sha256', None)
            canonical = json.dumps(state, sort_keys=True, ensure_ascii=False, separators=(',', ':')).encode()
            binding = state.get('binding', {})
            if checksum != hashlib.sha256(canonical).hexdigest() or state.get('protocol') != 'peanut.source-runtime-transition.v1' \
                    or binding.get('instance_root') != str(root) or binding.get('workspace') != str(workspace) \
                    or workspace.stat().st_mode & 0o077 or sha(workspace / 'tool-inputs.json') != binding.get('tool_inputs_sha256') \
                    or (expected is not None and expected != binding.get('tool_bundle_sha256')):
                raise ValueError('tool check is not bound to its source transaction')
            expected = binding['tool_bundle_sha256']; identity = state['transition_id']
        result = source_tools(root, workspace, args.phase == 'source-tools-check', expected)
        print(json.dumps({'phase': args.phase.removeprefix('source-'), 'transition_id': identity, **result})); return
    state = read(checkpoint)
    recorded = state.pop('state_sha256', None)
    canonical = json.dumps(state, sort_keys=True, ensure_ascii=False, separators=(',', ':')).encode()
    if recorded != hashlib.sha256(canonical).hexdigest() or state.get('protocol') != 'peanut.source-runtime-transition.v1' \
            or state['binding']['instance_root'] != str(root) or state['binding']['workspace'] != str(workspace) \
            or checkpoint.stat().st_mode & 0o777 != 0o600 or workspace.stat().st_mode & 0o077:
        raise ValueError('source maintenance checkpoint is not protected or bound')
    trusted = workspace / 'trusted'
    for relative, digest in state['binding']['tools'].items():
        if sha(trusted / relative) != digest:
            raise ValueError('source maintenance fixed tool changed')
    if args.phase.startswith('source-vendor-'):
        if state['activation_started']: raise ValueError('vendor mutation after activation is forbidden')
        head = root / 'server/private/installation/deployment.json'
        actual = sha(head) if head.exists() or head.is_symlink() else None
        expected = state.get('published_head_sha256', state['binding']['deployment']['head_sha256'])
        pending_path = root / 'server/runtime/upgrade/source-transition.json'
        pending = read(pending_path) if pending_path.exists() or pending_path.is_symlink() else None
        preflight = args.phase == 'source-vendor-preflight'
        if actual != expected or (preflight and state['phase'] not in ('tools-prepared', 'preparing')):
            raise ValueError('vendor operation lost its unactivated head or preparation phase')
        if preflight and (pending is None or pending.get('phase') in ('opened', 'recovered')):
            pass
        elif pending is None or pending.get('transition_id') != state['transition_id'] or pending.get('activation_started') is not False \
                or pending.get('binding_sha256') != hashlib.sha256(json.dumps(state['binding'], sort_keys=True, ensure_ascii=False, separators=(',', ':')).encode()).hexdigest():
            raise ValueError('vendor operation is not bound to the current unactivated head')
        result = source_vendor(root, workspace, state, args.phase.removeprefix('source-'))
        print(json.dumps({'phase': args.phase.removeprefix('source-'), 'transition_id': state['transition_id'], **result})); return
    tools = trusted / 'server/docker/scripts'
    spec = importlib.util.spec_from_file_location('source_recovery', tools / 'update-recovery.py')
    recovery = importlib.util.module_from_spec(spec); spec.loader.exec_module(recovery)
    spec = importlib.util.spec_from_file_location('source_collaboration', tools / 'configure-collaboration.py')
    collaboration = importlib.util.module_from_spec(spec); spec.loader.exec_module(collaboration)
    server = root / 'server'
    compose_args = collaboration.compose_arguments(server)

    def compose(*values):
        return run(*compose_args, *values, cwd=server / 'docker')

    def inspect_container(identifier):
        # Do not retrieve Config.Env or other credential-bearing container configuration.
        projection = '{"Id":{{json .Id}},"Image":{{json .Image}},"State":{{json .State}},"Labels":{{json .Config.Labels}},"Mounts":{{json .Mounts}}}'
        return json.loads(run('docker', 'inspect', '--format', projection, identifier))

    def bind_mounts(detail):
        return sorted([{'type': 'bind', 'source': mount['Source'], 'target': mount['Destination'],
                        'read_only': not mount['RW']} for mount in detail['Mounts'] if mount['Type'] == 'bind'],
                      key=lambda row: (row['target'], row['source']))

    def assert_instance(detail, service, project, expected=None):
        labels = detail['Labels']
        if labels.get('com.docker.compose.project') != project or labels.get('com.docker.compose.service') != service \
                or labels.get('com.docker.compose.project.working_dir') != str(server / 'docker'):
            raise ValueError('source service project or instance directory changed')
        mounts = bind_mounts(detail)
        required = {'php': (str(server), '/run/peanut-owner/server'),
                    'nginx': (str(server / 'public'), '/var/www/peanut-admin/server/public'),
                    'mysql': (str(server / 'docker/mysql'), '/var/lib/mysql')}[service]
        if not any((row['source'], row['target']) == required for row in mounts):
            raise ValueError('source service mount belongs to another instance')
        if service == 'php' and not any(row['source'] == str(server) and row['target'] == '/var/www/peanut-http/server'
                                        and row['read_only'] for row in mounts):
            raise ValueError('source service readonly program mount changed')
        if expected is not None and mounts != expected:
            raise ValueError('source service bind mounts changed after preparation')
        return mounts

    def prepared_override(quiescence):
        lines = ['services:']
        for service in ('php', 'nginx'):
            image = quiescence['images'][service]
            if not re.fullmatch(r'sha256:[a-f0-9]{64}', image): raise ValueError('source image identity is not immutable')
            volumes = quiescence['compose_volumes'][service]
            # Native !override replaces the entire mount sequence, including tmpfs, rather than merging mutable targets.
            lines += ['  ' + service + ':', '    image: ' + json.dumps(image), '    pull_policy: never',
                      '    volumes: !override ' + json.dumps(volumes, separators=(',', ':'))]
        encoded = ('\n'.join(lines) + '\n').encode()
        path = workspace / 'source-runtime-compose.override.yaml'
        if path.exists() or path.is_symlink():
            sha(path)
            if path.read_bytes() != encoded: raise ValueError('fixed source Compose override changed')
        else:
            temporary = path.with_name('.source-compose-' + os.urandom(8).hex())
            with temporary.open('xb') as output:
                os.fchmod(output.fileno(), 0o600); output.write(encoded); output.flush(); os.fsync(output.fileno())
            os.replace(temporary, path)
            descriptor = os.open(workspace, os.O_RDONLY)
            try: os.fsync(descriptor)
            finally: os.close(descriptor)
        return [*compose_args, '--project-directory', str(server / 'docker'), '--project-name', quiescence['project'], '-f', str(path)]

    def fixed_service(arguments, service, quiescence):
        identifiers = run(*arguments, 'ps', '-a', '-q', service, cwd=server / 'docker').splitlines()
        discovered = run('docker', 'ps', '-a', '--no-trunc', '--filter', 'label=com.docker.compose.project=' + quiescence['project'],
                         '--filter', 'label=com.docker.compose.service=' + service, '--format', '{{.ID}}').splitlines()
        if len(identifiers) != 1 or discovered != identifiers: raise ValueError('source service identity is ambiguous')
        detail = inspect_container(identifiers[0])
        assert_instance(detail, service, quiescence['project'], quiescence['instance_mounts'][service])
        if detail['Id'] != identifiers[0] or detail['Image'] != quiescence['images'][service]:
            raise ValueError('source service image or container identity changed')
        return detail

    phase = args.phase.removeprefix('source-')
    if phase == 'open':
        quiescence = state['quiescence']
        try:
            deployment = server / 'private/installation/deployment.json'
            expected_head = state.get('published_head_sha256', state['binding']['deployment']['head_sha256'])
            if deployment.exists() or deployment.is_symlink():
                actual_head = sha(deployment)
            elif state.get('recovery_admitted') is True and state['binding']['deployment']['head_sha256'] is None and expected_head is None:
                actual_head = None
            else:
                raise ValueError('source activation deployment head is missing')
            if state.get('activation_started') is not True or state.get('phase') != 'opening' or actual_head != expected_head:
                raise ValueError('source activation boundary or head is not current')
            fixed_args = prepared_override(quiescence)
            planned = json.loads(run(*fixed_args, 'config', '--format', 'json', cwd=server / 'docker'))
            if planned.get('name') != quiescence['project']: raise ValueError('fixed source project differs from preparation')
            for service in ('php', 'nginx'):
                spec = planned['services'][service]
                expected = quiescence['instance_mounts'][service]
                planned_binds = sorted([{'type': 'bind', 'source': row['source'], 'target': row['target'],
                                         'read_only': row.get('read_only', False)} for row in spec['volumes'] if row['type'] == 'bind'],
                                       key=lambda row: (row['target'], row['source']))
                if spec['image'] != quiescence['images'][service] or spec.get('pull_policy') != 'never' or planned_binds != expected:
                    raise ValueError('source startup inputs are not fixed to the original image and mounts')
            mysql = inspect_container(quiescence['containers']['mysql']['id'])
            assert_instance(mysql, 'mysql', quiescence['project'])
            if mysql['Image'] != quiescence['images']['mysql'] or not mysql['State']['Running']:
                raise ValueError('source database container identity changed before activation')
            # The unchanged native root entrypoint revalidates admission and publishes a new process context.
            for service in ('php', 'nginx'): fixed_service(fixed_args, service, quiescence)
            for service in ('php', 'nginx'):
                detail = fixed_service(fixed_args, service, quiescence)
                # Native Compose also waits for an existing running container without recreating it.
                recreate = '--no-recreate' if detail['State']['Running'] else '--force-recreate'
                run(*fixed_args, 'up', '-d', '--wait', '--wait-timeout', '180', '--no-build', '--no-deps', recreate,
                    '--pull', 'never', service, cwd=server / 'docker')
                # PHP's native healthcheck confirms its fresh process context before nginx can start.
                current = fixed_service(fixed_args, service, quiescence)['State']
                if not current['Running'] or current.get('Health', {}).get('Status') != 'healthy':
                    raise ValueError('source activation service is not healthy')
            for service in ('php', 'nginx'):
                current = fixed_service(fixed_args, service, quiescence)['State']
                if not current['Running'] or current.get('Health', {}).get('Status') != 'healthy':
                    raise ValueError('source activation service health changed before open')
        except Exception:
            # Stop only this bound project/working-directory's application services, independent of mutable Compose inputs.
            for service in ('nginx', 'php'):
                identifiers = run('docker', 'ps', '-a', '--no-trunc', '--filter', 'label=com.docker.compose.project=' + quiescence['project'],
                                  '--filter', 'label=com.docker.compose.service=' + service, '--format', '{{.ID}}').splitlines()
                for identifier in identifiers:
                    detail = inspect_container(identifier)
                    if detail['Labels'].get('com.docker.compose.project.working_dir') == str(server / 'docker'):
                        run('docker', 'stop', '--time', '60', identifier)
            raise
    else:
        initial_config = None
        if phase == 'stop':
            # Independent collaboration service ownership is not transferred to this coordinator.
            if state.get('quiescence') is not None and state.get('activation_started') is True:
                run(*prepared_override(state['quiescence']), 'stop', '--timeout', '60', 'nginx', 'php', cwd=server / 'docker')
            else:
                initial_config = json.loads(compose('config', '--format', 'json'))
                project = initial_config['name']
                for service in ('php', 'nginx', 'mysql'):
                    identifiers = compose('ps', '-a', '-q', service).splitlines()
                    if len(identifiers) != 1: raise ValueError('source stop service identity is ambiguous')
                    assert_instance(inspect_container(identifiers[0]), service, project)
                run(*compose_args, '--project-directory', str(server / 'docker'), '--project-name', project,
                    'stop', '--timeout', '60', 'nginx', 'php', cwd=server / 'docker')
        stopped = recovery.assert_stopped(server)
        stopped['instance_mounts'] = {}
        for service in ('php', 'nginx'):
            detail = inspect_container(stopped['containers'][service]['id'])
            stopped['instance_mounts'][service] = assert_instance(detail, service, stopped['project'])
        if state.get('quiescence') is None:
            initial_config = initial_config or json.loads(compose('config', '--format', 'json'))
            stopped['compose_volumes'] = {}
            for service in ('php', 'nginx'):
                volumes = initial_config['services'][service]['volumes']
                if any(row['type'] not in ('bind', 'tmpfs') for row in volumes): raise ValueError('source instance volume type is unsupported')
                for row in volumes:
                    if row['type'] == 'bind': row.setdefault('bind', {})['create_host_path'] = False
                planned_binds = sorted([{'type': 'bind', 'source': row['source'], 'target': row['target'],
                                         'read_only': row.get('read_only', False)} for row in volumes if row['type'] == 'bind'],
                                       key=lambda row: (row['target'], row['source']))
                if planned_binds != stopped['instance_mounts'][service]: raise ValueError('source instance configured mounts differ from its real containers')
                stopped['compose_volumes'][service] = volumes
        else:
            stopped['compose_volumes'] = state['quiescence']['compose_volumes']
        if state.get('quiescence') is not None and stopped != state['quiescence']:
            raise ValueError('source runtime container/image binding changed')
        if phase == 'admit':
            run('docker', 'run', '--rm', '--network', 'container:' + compose('ps', '-q', 'mysql'),
                '--mount', f'type=bind,src={root},dst={root}', '--mount', f'type=bind,src={workspace},dst={workspace}',
                '--entrypoint', 'php', state['quiescence']['images']['php'], tools / 'update-plan.php', 'source-admit',
                '--instance-server=' + str(server), '--workspace=' + str(workspace))
        if phase == 'project':
            target = workspace / 'prepared'
            if not target.exists():
                run(sys.executable, trusted / 'scripts/package-release-files.py', 'development-runtime',
                    '--application-root', root, '--target', target, cwd=root)
            elif not (target / 'server/.peanut/development-runtime.json').is_file():
                raise ValueError('incomplete projection is retained; recover before a new prepare')
            sha(target / 'server/.peanut/development-runtime.json')
        if phase == 'project' or (phase == 'check' and state['phase'] in ('runtime-prepared', 'runtime-installed', 'head-published', 'admitted')):
            spec = importlib.util.spec_from_file_location('source_producer', trusted / 'scripts/package-release-files.py')
            producer = importlib.util.module_from_spec(spec); spec.loader.exec_module(producer)
            identity = read(workspace / 'prepared/server/.peanut/development-runtime.json')
            derived = {'server/.peanut/application-manifest.json', 'server/.peanut/release-versions.json',
                'server/.peanut/RELEASE_METADATA.json', 'server/resources/project-resources.json',
                'server/docker/scripts/scaffold-runtime/ReleaseDependencyIdentity.php', 'server/plugins.lock',
                'server/.peanut/development-runtime.json'}
            for document in (identity, state['binding']['old_runtime']):
                for plugin in document['plugin_projection']['plugins']:
                    if not re.fullmatch(r'[a-z][a-z0-9.-]*', plugin['key']): raise ValueError('invalid projected plugin key')
                    derived.add('server/plugins/' + plugin['key'] + '/plugin.json')
            prefixes = (*producer.PROTECTED_RUNTIME_PREFIXES, 'server/private/', 'server/docker/tls/')
            def included(relative):
                return relative not in derived and relative not in ('server/docker/collaboration.env', 'server/.env.collaboration.lock') \
                    and producer.allowed_source(relative) and not any(relative == prefix.rstrip('/') or relative.startswith(prefix) for prefix in prefixes)
            actual = {}
            def walk_error(error): raise error
            for base, directories, files in os.walk(server, topdown=True, onerror=walk_error, followlinks=False):
                for name in list(directories):
                    path = Path(base) / name; relative = path.relative_to(root).as_posix()
                    if not included(relative): directories.remove(name)
                    elif path.is_symlink(): raise ValueError('linked source program directory')
                for name in files:
                    path = Path(base) / name; relative = path.relative_to(root).as_posix()
                    if included(relative): actual[relative] = [sha(path), path.stat().st_mode & 0o777]
            expected = {row['path']: [row['sha256'], row['mode']] for row in identity['files'] if row['path'] not in derived}
            if actual != expected: raise ValueError('complete source program set, digest or mode changed after projection')
    result = {'phase': phase, 'transition_id': state['transition_id']}
    if phase != 'open': result['quiescence'] = stopped
    print(json.dumps(result, separators=(',', ':')))


def main():
    if len(sys.argv) > 1 and sys.argv[1].startswith('source-'):
        return source_runtime()
    parser = argparse.ArgumentParser()
    parser.add_argument('phase', choices=('prepare', 'migration-preflight', 'backup', 'quiesce', 'migrate', 'switch',
        'reload-safe', 'migration-verify', 'health', 'activate', 'recover', 'resume-old', 'recovery-verify'))
    for name in ('instance-root', 'package', 'plan', 'state'): parser.add_argument('--' + name, type=Path, required=True)
    args = parser.parse_args(); root = args.instance_root; package = args.package; phase = args.phase
    for path in (root, package, args.plan, args.state):
        if not path.is_absolute() or path.resolve() != path or path.is_symlink(): raise ValueError('phase paths must be canonical')
    plan = read(args.plan); workspace = Path(plan['workspace']); trusted = workspace / 'trusted'
    if sha(trusted / 'manifest.json') != plan['runtime_sha256']: raise ValueError('installed adapter manifest changed')
    for relative, digest in read(trusted / 'manifest.json').items():
        if sha(trusted / relative) != digest: raise ValueError('installed phase adapter changed')
    tools = trusted / 'server/docker/scripts'
    spec = importlib.util.spec_from_file_location('product_recovery', tools / 'update-recovery.py')
    recovery = importlib.util.module_from_spec(spec); spec.loader.exec_module(recovery)
    spec = importlib.util.spec_from_file_location('collaboration_owner', tools / 'configure-collaboration.py')
    collaboration = importlib.util.module_from_spec(spec); spec.loader.exec_module(collaboration)
    product, state = recovery.product_binding(workspace)
    if product != plan or plan.get('scope') != 'server' or plan['instance_root'] != str(root) or plan['package']['root'] != str(package) \
        or plan['state_path'] != str(args.state) or state['phase_in_progress'] != phase:
        raise ValueError('phase differs from the sole product plan/state')
    server = root / 'server'; docker_dir = server / 'docker'; environment = recovery.env(docker_dir / '.env')
    images = {}
    for service in ('php', 'nginx', 'mysql'):
        reference = environment.get(service.upper() + '_IMAGE', '')
        if not re.fullmatch(r'(sha256:[a-f0-9]{64}|[A-Za-z0-9][A-Za-z0-9._:/-]{0,160}@sha256:[a-f0-9]{64})', reference):
            raise ValueError('runtime image must be prepared and immutable')
        images[service] = run('docker', 'image', 'inspect', '--format', '{{.Id}}', reference)
    collaboration_enabled=collaboration.backend_environment(server).get('COLLABORATION_ENABLED')=='enabled'
    if collaboration_enabled:
        reference=collaboration.environment(docker_dir/'collaboration.env')['COLLABORATION_IMAGE']
        if not collaboration.IMAGE.fullmatch(reference): raise ValueError('collaboration image is not fixed')
        images['collaboration']=run('docker','image','inspect','--format','{{.Id}}',reference)
    candidate = plan['candidate']; prepared = workspace / 'prepared'; target = prepared / 'server'
    arguments = argparse.Namespace(server=server, workspace=workspace); record_path = workspace / 'prepared.json'

    def compose(*values):
        return run(*collaboration.compose_arguments(server), *values, cwd=docker_dir)

    def php(tool, *values):
        mounts = ['--mount', f'type=bind,src={root},dst={root}', '--mount', f'type=bind,src={workspace},dst={workspace}']
        output = run('docker', 'run', '--rm', '--network', 'container:' + compose('ps', '-q', 'mysql'), *mounts,
            '--env', 'PEANUT_SERVER_ENV_FILE=' + str(server / '.env'),
            '--workdir', str(server), '--entrypoint', 'php', images['php'], tool, *values)
        return json.loads(output) if output else {}

    def native(operation):
        return php(tools / 'update-plan.php', operation, '--instance-server=' + str(server), '--workspace=' + str(workspace))

    def stopped(): return recovery.assert_stopped(server)

    def hold():
        if collaboration_enabled:
            drain_id='upgrade-'+hashlib.sha256(candidate.encode()).hexdigest()[:32]
            def lifecycle(action):
                value=php(server/'think','collaboration:lifecycle',action,'--drain-id='+drain_id)
                if value.get('protocol')!=collaboration.PROTOCOL or value.get('ok') is not True: raise ValueError('collaboration owner result is unconfirmed')
                return value['data']
            collaboration.disable(server,drain_id,True,lifecycle)
        native('hold'); compose('stop', '--timeout', '60', 'nginx', 'php'); return stopped()

    def preparation(operation):
        # The existing preparation command also prints its vendor checks; its bound record is authoritative.
        return run(sys.executable, tools / 'update-preparation.py', operation, '--server', server, '--workspace', workspace)

    def prepared_record():
        record = read(record_path)
        if record['candidate'] != candidate or record['plan_sha256'] != plan['plan_sha256'] or record['runtime_images'] != images \
            or record['inputs_sha256'] != sha(workspace / 'plan.json'): raise ValueError('prepared target, inputs or fixed images changed')
        return record

    def db(operation):
        value = php(tools / 'update-database.php', operation, server, workspace)
        if operation == 'preflight':
            modules = value.get('modules', {})
            native = read(workspace / 'plan.json')
            unsigned = dict(modules); digest = unsigned.pop('report_sha256', None)
            expected = hashlib.sha256(json.dumps(unsigned, sort_keys=True, ensure_ascii=False, separators=(',', ':')).encode()).hexdigest()
            if value.get('status') != 'completed' or value.get('candidate') != candidate or 'application' not in value \
                or modules.get('schema_version') != 1 or modules.get('protocol') != 'peanut.upgrade-module-preflight.v1' \
                or modules.get('may_apply') is not True or modules.get('candidate') != candidate \
                or modules.get('product_plan_sha256') != plan['plan_sha256'] \
                or modules.get('native_inputs_sha256') != sha(workspace / 'plan.json') \
                or modules.get('target_identity_sha256') != native['target']['identity_sha256'] or digest != expected:
                raise ValueError('module-preflight report is missing or differs from the fixed plan')
        return value

    def health(public=False):
        native('health'); containers = {}
        for service in ('mysql', 'php', 'nginx'):
            ids = compose('ps', '-a', '-q', service).splitlines()
            if len(ids) != 1: raise ValueError('runtime service is not unique')
            detail = json.loads(run('docker', 'inspect', '--format', '{{json .}}', ids[0]))
            if detail['Image'] != images[service] or detail['State']['Running'] != (service in ('mysql', 'php') or public):
                raise ValueError('runtime service or image differs from plan')
            containers[service] = {'id': detail['Id'], 'image': detail['Image']}
        if collaboration_enabled:
            service = collaboration.service_owner(server, 'status')
            if service['image_id'] != images['collaboration'] or service['running'] is not public:
                raise ValueError('independent collaboration service differs from plan')
            containers['collaboration'] = {'id': service['id'], 'image': service['image_id'],
                                         'compose_project': service['compose_project']}
        if public and collaboration_enabled:
            paired=collaboration.native(server,'status','runtime-status')
            if paired.get('ready') is not True: raise ValueError('signed collaboration readiness is unconfirmed')
        if public:
            bind = environment.get('HTTP_BIND', ''); port = environment.get('HTTP_PORT', '')
            if bind == '0.0.0.0': bind = '127.0.0.1'
            if bind not in ('127.0.0.1', '::1') or not port.isdigit(): raise ValueError('registered HTTP endpoint is unavailable')
            host = '[' + bind + ']' if ':' in bind else bind
            for path in ('/healthz', '/', '/legal/RELEASE_METADATA.json'):
                with urllib.request.build_opener(urllib.request.ProxyHandler({})).open(f'http://{host}:{port}{path}', timeout=10) as response:
                    if response.status != 200: raise ValueError('public runtime health failed')
        return {'services': containers, 'private_installed_health': True, 'public_http': public}

    if phase == 'prepare':
        if state['activation_started'] or state['database_recovery_required']: raise ValueError('prepare cannot restart after migration')
        if record_path.exists(): payload = prepared_record(); preparation('check')
        else:
            inputs = read(workspace / 'plan.json')
            if inputs.get('requirements', {}).get('runtime_environment_changed'): raise ValueError('environment changed; prepare compatible fixed images first')
            for relative in ('docker/Dockerfile', 'docker/compose.yaml','docker/compose.collaboration.yaml','docker/conf/nginx.collaboration.conf.template'):
                if (target / relative).exists() and sha(target / relative) != sha(server / relative): raise ValueError('runtime recipe changed; environment preparation is required')
            if sha(server / 'composer.lock') != sha(target / 'composer.lock') or sha(server / 'composer.json') != sha(target / 'composer.json'):
                run(tools / 'prepare-vendor.sh', 'prepared', target, images['php'])
            preparation('record')
            if not (target / 'vendor').exists(): shutil.copytree(server / 'vendor', target / 'vendor')
            shutil.copyfile(server / '.env', target / '.env'); os.chmod(target / '.env', 0o600)
            for name in ('private/resources', 'private/installation','private/collaboration'):
                if (server / name).exists(): shutil.copytree(server / name, target / name, dirs_exist_ok=True)
            if (target / 'docker/conf/nginx.conf').exists():
                run('docker', 'run', '--rm', '--network', 'none', '--add-host', 'php:127.0.0.1',
                    '--mount', f'type=bind,src={target / "docker/conf/nginx.conf"},dst=/etc/nginx/nginx.conf,readonly', '--entrypoint', 'nginx', images['nginx'], '-t')
            payload = {'candidate': candidate, 'plan_sha256': plan['plan_sha256'], 'kind': 'mounted-app-source', 'target': str(prepared),
                'runtime_images': images, 'inputs_sha256': sha(workspace / 'plan.json'), 'source': plan['package'],
                'dependency_preparation_sha256': sha(workspace / 'preparation.json')}
            write(record_path, payload)
    elif phase == 'migration-preflight': prepared_record(); payload = {'database': db('preflight')}
    elif phase == 'backup':
        prepared_record(); drained = hold()
        with contextlib.redirect_stdout(io.StringIO()):
            if (workspace / 'backup.json').exists(): recovery.verify(arguments)
            else: recovery.backup(arguments)
        payload = {'backup_sha256': sha(workspace / 'backup.json'), 'writers_stopped': drained}
    elif phase == 'quiesce': stopped(); recovery.verify(arguments); payload = {'write_gate': 'closed', 'backup_sha256': sha(workspace / 'backup.json')}
    elif phase == 'migrate':
        stopped(); recovery.verify(arguments); preparation('switch')
        if not state['database_recovery_required']: raise ValueError('migration intent must be persisted')
        payload = {'database': db('migrate')}
    elif phase == 'switch':
        stopped(); prepared_record(); preparation('check'); payload = {'active_target': 'mounted-source-in-place', 'source': plan['package'], 'runtime_images': images}
    elif phase == 'reload-safe':
        compose('up', '-d', '--wait', '--no-build', '--no-deps', '--force-recreate', 'php'); payload = {'php_reloaded': True, 'public_writers_stopped': True}
    elif phase == 'migration-verify': payload = {'database': db('verify')}
    elif phase == 'health': prepared_record(); payload = health(state['activation_started'])
    elif phase == 'activate':
        if not state['activation_started'] or 'health' not in state['evidence']: raise ValueError('healthy activation boundary must precede traffic')
        try:
            compose('stop', '--timeout', '60', 'php')
            native('health')
            native('publish')
            native('open')
            compose('up', '-d', '--wait', '--no-build', '--no-deps', '--force-recreate', 'php')
            if collaboration_enabled: collaboration.start(server)
            else: compose('up', '-d', '--wait', '--no-build', '--no-deps', '--force-recreate', 'nginx')
            payload = health(True)
        except Exception:
            try: native('hold')
            finally: compose('stop', '--timeout', '60', 'nginx', 'php')
            raise
    elif phase == 'recover':
        if state['activation_started']: raise ValueError('activation started; forward repair is required')
        hold()
        with contextlib.redirect_stdout(io.StringIO()):
            if state['database_recovery_required']: recovery.restore(arguments)
        if (workspace / 'preparation.json').exists(): preparation('recover')
        payload = {'recovery': 'paired-database-public-private-installation' if state['database_recovery_required'] else 'program-only', 'writers_stopped': True, 'resume_required': True}
    elif phase == 'resume-old':
        try:
            native('health'); native('open')
            compose('up', '-d', '--wait', '--no-build', '--no-deps', '--force-recreate', 'php')
            if collaboration_enabled: collaboration.start(server)
            else: compose('up', '-d', '--wait', '--no-build', '--no-deps', '--force-recreate', 'nginx')
            payload = health(True); payload['resumed_old_runtime'] = True
        except Exception:
            try: native('hold')
            finally: compose('stop', '--timeout', '60', 'nginx', 'php')
            raise
    else: payload = health(True); payload['recovered_runtime_verified'] = True
    print(json.dumps({'protocol': 'peanut.product-upgrade-host-evidence.v1', 'status': 'completed', 'phase': phase, 'candidate': candidate,
        'plan_sha256': plan['plan_sha256'], 'package_manifest_sha256': plan['package']['manifest_sha256'], 'payload': payload}))


if __name__ == '__main__':
    try: main()
    except (OSError, ValueError, RuntimeError, KeyError, subprocess.SubprocessError) as error:
        print(f'product-upgrade-host: {error}', file=sys.stderr); sys.exit(1)
