#!/usr/bin/env bash
set -Eeuo pipefail

die() { printf 'product-upgrade-host: %s\n' "$1" >&2; exit 1; }

usage() {
  printf '%s\n' \
    'Usage: scripts/product-upgrade-host <prepare|migration-preflight|backup|quiesce|migrate|switch|reload-safe|migration-verify|health|activate|recover|resume-old|recovery-verify> --instance-root=<absolute> --package=<absolute> --plan=<absolute> --state=<absolute>' >&2
  exit 64
}

[[ $# -eq 5 ]] || usage
phase="$1"; shift
case "$phase" in
  prepare|migration-preflight|backup|quiesce|migrate|switch|reload-safe|migration-verify|health|activate|recover|resume-old|recovery-verify) ;;
  *) usage ;;
esac
instance_root_option=
package_option=
plan_option=
state_option=
for argument in "$@"; do
  [[ "$argument" =~ ^--(instance-root|package|plan|state)=(/.+)$ ]] || usage
  case "${BASH_REMATCH[1]}" in
    instance-root) [[ -z "$instance_root_option" ]] || usage; instance_root_option="${BASH_REMATCH[2]}" ;;
    package) [[ -z "$package_option" ]] || usage; package_option="${BASH_REMATCH[2]}" ;;
    plan) [[ -z "$plan_option" ]] || usage; plan_option="${BASH_REMATCH[2]}" ;;
    state) [[ -z "$state_option" ]] || usage; state_option="${BASH_REMATCH[2]}" ;;
  esac
done
[[ -n "$instance_root_option" && -n "$package_option" && -n "$plan_option" && -n "$state_option" ]] || usage

for command_name in jq sha256sum tar gzip curl docker; do
  command -v "$command_name" >/dev/null || die "$command_name is required"
done
docker compose version >/dev/null 2>&1 || die 'Docker Compose v2 is required'

canonical_directory() {
  local path="$1" resolved
  resolved="$(realpath "$path" 2>/dev/null || true)"
  [[ -n "$resolved" && "$resolved" == "$path" && -d "$resolved" && ! -L "$path" ]] \
    || die 'directory input is not a canonical ordinary directory'
  printf '%s' "$resolved"
}
canonical_file() {
  local path="$1" resolved
  resolved="$(realpath "$path" 2>/dev/null || true)"
  [[ -n "$resolved" && "$resolved" == "$path" && -f "$resolved" && ! -L "$path" ]] \
    || die 'file input is not a canonical ordinary file'
  printf '%s' "$resolved"
}

instance_root="$(canonical_directory "$instance_root_option")"
package_root="$(canonical_directory "$package_option")"
plan_path="$(canonical_file "$plan_option")"
state_path="$(canonical_file "$state_option")"
[[ "$plan_path" == "$instance_root/.peanut/upgrades/product-plans/"*.json \
  && "$state_path" == "$instance_root/.peanut/upgrades/product-state/"*.json ]] \
  || die 'plan or state is outside the canonical product-upgrade roots'
[[ "$(stat -c '%a %h' "$plan_path")" == '600 1' \
  && "$(stat -c '%a %h' "$state_path")" == '600 1' ]] \
  || die 'plan and state must have mode 0600 and one hard link'

jq -e --arg root "$instance_root" --arg package "$package_root" '
  .schema_version == 2 and .protocol == "peanut.product-upgrade-plan.v2"
  and .instance_root == $root and .package.root == $package
  and (.candidate | type == "string" and test("^[A-Za-z0-9._-]{1,128}$"))
  and (.plan_sha256 | type == "string" and test("^sha256:[a-f0-9]{64}$"))
  and (.state_path | type == "string")
  and (.package.inventory_sha256 | type == "string" and test("^(sha256:)?[a-f0-9]{64}$"))
  and (.package.manifest_sha256 | type == "string" and test("^(sha256:)?[a-f0-9]{64}$"))
  and (.package.target_version | type == "string" and length > 0)
  and (.package.source_commit | type == "string" and test("^[a-f0-9]{40}$"))
  and (.package.source_tree | type == "string" and test("^[a-f0-9]{40}$"))
  and (.edition.name == "standalone" or .edition.name == "multi-tenant")
' "$plan_path" >/dev/null || die 'authenticated product-upgrade plan shape is invalid'

candidate="$(jq -r '.candidate' "$plan_path")"
plan_sha256="$(jq -r '.plan_sha256' "$plan_path")"
plan_state_path="$(jq -r '.state_path' "$plan_path")"
[[ "$plan_state_path" == "$state_path" ]] || die 'plan is bound to another product-upgrade state file'
jq -e --arg candidate "$candidate" --arg plan "$plan_sha256" --arg phase "$phase" '
  .schema_version == 1 and .protocol == "peanut.product-upgrade-state.v1"
  and .candidate == $candidate and .plan_sha256 == $plan
  and (.phase | type == "string") and .phase_in_progress == $phase
  and (.database_recovery_required | type == "boolean")
  and (.migration_completed | type == "boolean")
  and (.activation_started | type == "boolean")
  # PHP encodes the initial empty evidence map as []; populated phases use an object.
  and (.evidence | type == "object" or (type == "array" and length == 0))
' "$state_path" >/dev/null || die 'product-upgrade state binding or active phase is invalid'

package_manifest="$package_root/upgrade-manifest.json"
package_inventory="$package_root/META-INF/files.sha256"
[[ -f "$package_manifest" && ! -L "$package_manifest" \
  && -f "$package_inventory" && ! -L "$package_inventory" ]] \
  || die 'signed package manifest or inventory is missing'
manifest_sha="$(sha256sum "$package_manifest" | awk '{print $1}')"
inventory_sha="$(sha256sum "$package_inventory" | awk '{print $1}')"
plan_manifest_sha="$(jq -r '.package.manifest_sha256 | sub("^sha256:"; "")' "$plan_path")"
plan_inventory_sha="$(jq -r '.package.inventory_sha256 | sub("^sha256:"; "")' "$plan_path")"
[[ "$manifest_sha" == "$plan_manifest_sha" && "$inventory_sha" == "$plan_inventory_sha" ]] \
  || die 'signed package files differ from the authenticated plan'
target_version="$(jq -r '.package.target_version' "$plan_path")"
source_commit="$(jq -r '.package.source_commit' "$plan_path")"
source_tree="$(jq -r '.package.source_tree' "$plan_path")"
edition="$(jq -r '.edition.name' "$plan_path")"
jq -e --arg version "$target_version" --arg commit "$source_commit" --arg tree "$source_tree" --arg edition "$edition" '
  .protocol == "peanut.edition-upgrade-package.v1"
  and .target.version == $version and .build_source.commit == $commit
  and .build_source.tree == $tree and .edition.name == $edition
' "$package_manifest" >/dev/null || die 'package manifest differs from the authenticated plan'

runtime_root="${state_path%.json}.runtime"
[[ "$runtime_root" == "$instance_root/.peanut/upgrades/product-state/"*.runtime ]] \
  || die 'derived product-upgrade runtime path is unsafe'
prepared_root="$runtime_root/prepared-target"
prepared_record="$runtime_root/prepared.json"
backup_root="$instance_root/backups/product-upgrade-${candidate}"
previous_root="$runtime_root/previous"
recovery_record="$runtime_root/recovery.json"
resume_old_record="$runtime_root/resume-old.json"

backend_env="${PEANUT_SERVER_ENV_FILE:-}"
[[ "$backend_env" == /* ]] || die 'PEANUT_SERVER_ENV_FILE must select an absolute instance environment'
backend_env="$(canonical_file "$backend_env")"
if [[ "$backend_env" != "$instance_root/.env" && "$backend_env" != "$instance_root/server/.env" ]]; then
  backend_env_suffix="${backend_env#"$instance_root/server/.env."}"
  [[ "$backend_env" == "$instance_root/server/.env.$backend_env_suffix" \
    && "$backend_env_suffix" =~ ^[a-z0-9-]{1,64}$ ]] \
    || die 'PEANUT_SERVER_ENV_FILE must select the instance root or split backend environment'
fi
[[ "$(stat -c '%a %h' "$backend_env")" == '600 1' ]] \
  || die 'selected backend environment must have mode 0600 and one hard link'
root_env="$(canonical_file "$instance_root/.env")"

env_value() {
  local path="$1" key="$2" value count
  count="$(awk -F= -v key="$key" '$1 == key { count++ } END { print count + 0 }' "$path")"
  [[ "$count" == 1 ]] || die "environment key is missing or duplicated: $key"
  value="$(awk -F= -v key="$key" '$1 == key { sub(/^[^=]*=/, ""); print; exit }' "$path")"
  [[ -n "$value" ]] || die "environment value is empty: $key"
  printf '%s' "$value"
}

project_names="$({ docker ps -a --filter "label=com.docker.compose.project.working_dir=$instance_root" \
  --format '{{.Label "com.docker.compose.project"}}' || true; } | sed '/^$/d' | sort -u)"
[[ "$(printf '%s\n' "$project_names" | sed '/^$/d' | wc -l | tr -d ' ')" == 1 ]] \
  || die 'instance root does not resolve to exactly one Compose project'
compose_project="$project_names"
[[ "$compose_project" =~ ^[a-z0-9][a-z0-9_-]{0,62}$ ]] || die 'derived Compose project is invalid'

compose_environment=(--env-file "$root_env")
[[ "$backend_env" == "$root_env" ]] || compose_environment+=(--env-file "$backend_env")
current_receipt="$instance_root/DEPLOYMENT_RECEIPT.json"

pc_render_mode() {
  local file count mode=spa
  for file in "$root_env" "$backend_env"; do
    count="$(awk -F= '$1 == "PEANUT_PC_RENDER_MODE" { count++ } END { print count + 0 }' "$file")"
    [[ "$count" == 0 || "$count" == 1 ]] || die 'PC render mode is duplicated'
    [[ "$count" == 0 ]] || mode="$(env_value "$file" PEANUT_PC_RENDER_MODE)"
  done
  [[ "$mode" == spa || "$mode" == hybrid ]] || die 'PC render mode must be spa or hybrid'
  printf '%s' "$mode"
}

set_current_compose() {
  render_mode="$(pc_render_mode)"
  compose_profiles=(--profile bundled-db)
  writer_services=(php nginx cron)
  stop_services=(nginx cron php)
  [[ "$render_mode" != hybrid ]] || { compose_profiles+=(--profile ssr); writer_services=(pc php nginx cron); stop_services+=(pc); }
  compose_current=(env "PEANUT_PC_RENDER_MODE=$render_mode" "PEANUT_SERVER_ENV_FILE=$backend_env" "PEANUT_DEPLOYMENT_RECEIPT_FILE=$current_receipt" \
    docker compose "${compose_environment[@]}" -p "$compose_project" -f "$instance_root/compose.yaml" "${compose_profiles[@]}")
}
set_current_compose

assert_runtime_running() {
  local identities
  identities="${1:-$(service_identities)}"
  jq -e --arg mode "$render_mode" 'all(.mysql,.php,.nginx,.cron; .status == "running")
    and (if $mode == "hybrid" then .pc.status == "running" else (.pc == null or .pc.status != "running") end)' \
    <<<"$identities" >/dev/null || die 'runtime services are not running for the selected PC render mode'
}

write_json() {
  local path="$1" input="$2" temporary
  mkdir -p "$(dirname "$path")"
  temporary="${path}.tmp-$$"
  printf '%s\n' "$input" | jq -S . >"$temporary"
  chmod 600 "$temporary"
  mv -f -- "$temporary" "$path"
}

tree_digest() {
  local root="$1"
  (cd "$root" && find . -type f -print0 | sort -z \
    | xargs -0 sha256sum | sha256sum | awk '{print "sha256:" $1}')
}

emit() {
  local payload="$1"
  jq -n --arg phase "$phase" --arg candidate "$candidate" --arg plan "$plan_sha256" \
    --arg manifest "sha256:$manifest_sha" --argjson payload "$payload" \
    '{protocol:"peanut.product-upgrade-host-evidence.v1",status:"completed",phase:$phase,candidate:$candidate,plan_sha256:$plan,package_manifest_sha256:$manifest,payload:$payload}'
}

service_identities() {
  local json='{}' service container
  for service in mysql pc php nginx cron; do
    container="$(docker ps -a --filter "label=com.docker.compose.project=$compose_project" \
      --filter "label=com.docker.compose.service=$service" --format '{{.ID}}' | head -n 1)"
    if [[ -n "$container" ]]; then
      json="$(jq -c --arg service "$service" --arg id "$(docker inspect --format '{{.Id}}' "$container")" \
        --arg image "$(docker inspect --format '{{.Image}}' "$container")" \
        --arg status "$(docker inspect --format '{{.State.Status}}' "$container")" \
        --arg started_at "$(docker inspect --format '{{.State.StartedAt}}' "$container")" \
        --arg finished_at "$(docker inspect --format '{{.State.FinishedAt}}' "$container")" \
        --argjson restart_count "$(docker inspect --format '{{.RestartCount}}' "$container")" \
        '. + {($service):{container_id:$id,image_id:$image,status:$status,
          started_at:$started_at,finished_at:$finished_at,restart_count:$restart_count}}' <<<"$json")"
    fi
  done
  printf '%s' "$json"
}

set_env_key() {
  local file="$1" key="$2" value="$3" temporary
  temporary="${file}.tmp-$$"
  awk -F= -v key="$key" '$1 != key { print }' "$file" >"$temporary"
  printf '%s=%s\n' "$key" "$value" >>"$temporary"
  chmod 600 "$temporary"
  mv -f -- "$temporary" "$file"
}

prepared_payload() {
  [[ -f "$prepared_record" && ! -L "$prepared_record" ]] || die 'prepared target evidence is missing'
  jq -e --arg candidate "$candidate" --arg plan "$plan_sha256" \
    '.candidate == $candidate and .plan_sha256 == $plan' "$prepared_record" >/dev/null \
    || die 'prepared target evidence is bound to another plan'
  jq -c '.payload' "$prepared_record"
}

set_target_compose() {
  local payload receipt receipt_b64 php_image nginx_image pc_image
  payload="$(prepared_payload)"
  receipt="$(jq -r '.prepared_target.receipt_path' <<<"$payload")"
  [[ -f "$receipt" && ! -L "$receipt" ]] || die 'prepared target receipt is unavailable'
  php_image="$(jq -r '.prepared_target.images.php' <<<"$payload")"
  nginx_image="$(jq -r '.prepared_target.images.nginx' <<<"$payload")"
  pc_image="$(jq -r '.prepared_target.images.pc // empty' <<<"$payload")"
  target_images=("$php_image" "$nginx_image")
  [[ "$render_mode" != hybrid ]] || target_images+=("$pc_image")
  jq -e --arg mode "$render_mode" '.prepared_target.images | keys == (if $mode == "hybrid" then ["nginx","pc","php"] else ["nginx","php"] end)
    and all(.[]; type == "string" and test("^sha256:[a-f0-9]{64}$"))' <<<"$payload" >/dev/null \
    || die 'prepared target image set differs from the selected PC render mode'
  docker image inspect "${target_images[@]}" >/dev/null \
    || die 'prepared target images are unavailable'
  receipt_b64="$(base64 -w0 "$receipt")"
  target_compose=(env "PEANUT_PC_RENDER_MODE=$render_mode" "PHP_IMAGE=$php_image" "NGINX_IMAGE=$nginx_image" "PC_IMAGE=$pc_image" \
    "PEANUT_SOURCE_COMMIT=$source_commit" "PEANUT_SOURCE_TREE=$source_tree" \
    "PEANUT_SERVER_ENV_FILE=$backend_env" "PEANUT_DEPLOYMENT_RECEIPT_FILE=$receipt" \
    "PEANUT_DEPLOYMENT_RECEIPT_BASE64=$receipt_b64" docker compose "${compose_environment[@]}" \
    -p "$compose_project" -f "$prepared_root/compose.yaml" "${compose_profiles[@]}")
}

database_phase() {
  local operation output helper
  case "$phase" in
    migration-preflight) operation=preflight ;;
    migrate) operation=apply ;;
    migration-verify) operation=verify ;;
    *) die 'database phase mapping is invalid' ;;
  esac
  helper="$package_root/scripts/upgrade-runtime/product-upgrade-database"
  [[ -f "$helper" && ! -L "$helper" && -x "$helper" ]] \
    || die 'signed package database helper is unavailable'
  if [[ "$phase" == migrate ]]; then
    jq -e '
      .database_recovery_required == true
      and (.evidence.backup | type == "object") and (.evidence.quiesce | type == "object")
    ' "$state_path" >/dev/null || die 'database migration requires durable backup and quiescence state'
    assert_backup_quiescence_continuity
  elif [[ "$phase" == migration-verify ]]; then
    jq -e '.database_recovery_required == true and .migration_completed == true' "$state_path" >/dev/null \
      || die 'database verification requires durable migration completion'
    if [[ "$(jq -r '.activation_started' "$state_path")" == false ]]; then
      assert_public_writers_stopped
    fi
  fi
  set_target_compose
  output="$("${target_compose[@]}" run -T --rm --no-deps --entrypoint php \
    --volume "$package_root:/package:ro" \
    --volume "$plan_path:/run/peanut/product-plan.json:ro" \
    php /package/scripts/upgrade-runtime/product-upgrade-database "$operation" \
    --application-root=/var/www/peanut-admin --package=/package \
    --plan=/run/peanut/product-plan.json </dev/null)" \
    || die "target-container database $operation failed"
  jq -e --arg operation "$operation" --arg candidate "$candidate" --arg plan "$plan_sha256" \
    --arg target "$target_version" '
      .protocol == "peanut.product-upgrade-database-evidence.v1" and .status == "completed"
      and .operation == $operation and .candidate == $candidate and .plan_sha256 == $plan
      and .target_version == $target and (.application_statuses | type == "object")
      and (if $operation == "apply" then (.module | type == "object") else true end)
    ' <<<"$output" >/dev/null || die 'target-container database evidence is invalid'
  emit "$(jq -n --arg operation "$operation" --argjson result "$output" \
    '{database:{operation:$operation,result:$result}}')"
}

prepare_phase() {
  legacy_runtime_mount="$(docker volume inspect --format '{{.Mountpoint}}' "${compose_project}_php-runtime")"
  installation_mount="$(docker volume inspect --format '{{.Mountpoint}}' "${compose_project}_php-installation")"
  [[ -d "$legacy_runtime_mount" && -d "$installation_mount" ]] \
    || die 'installation state volumes are unavailable'
  for marker in executing.json installed.json baseline.json; do
    [[ ! -e "$legacy_runtime_mount/installation/$marker" \
      && ! -L "$legacy_runtime_mount/installation/$marker" ]] \
      || die 'legacy installation identity requires explicit maintenance migration before upgrade prepare'
    [[ ! -e "$instance_root/server/runtime/installation/$marker" \
      && ! -L "$instance_root/server/runtime/installation/$marker" ]] \
      || die 'legacy installation identity requires explicit maintenance migration before upgrade prepare'
  done
  [[ -f "$installation_mount/installed.json" && ! -L "$installation_mount/installed.json" \
    && -f "$installation_mount/baseline.json" && ! -L "$installation_mount/baseline.json" ]] \
    || die 'private installation identity is incomplete'
  if [[ -e "$installation_mount/migration.json" || -L "$installation_mount/migration.json" ]]; then
    [[ -f "$installation_mount/migration.json" && ! -L "$installation_mount/migration.json" ]] \
      || die 'installation migration record is unsafe'
    jq -e '.protocol == "peanut.installation-state-migration.v1" and .phase == "complete"' \
      "$installation_mount/migration.json" >/dev/null \
      || die 'installation migration has not completed'
  fi
  if [[ -f "$prepared_record" ]]; then emit "$(prepared_payload)"; return; fi
  [[ ! -e "$runtime_root" && ! -L "$runtime_root" ]] || die 'new prepare phase found an unbound runtime directory'
  [[ ! -L "$instance_root/server/private/installation" ]] \
    || die 'private installation identity must not be a symbolic link'
  umask 077
  mkdir -p "$prepared_root" "$previous_root"
  cp -p "$root_env" "$previous_root/root.env"
  [[ "$backend_env" == "$root_env" ]] || cp -p "$backend_env" "$previous_root/server.env"
  [[ ! -f "$current_receipt" ]] || cp -p "$current_receipt" "$previous_root/DEPLOYMENT_RECEIPT.json"

  tar -C "$instance_root" \
    --exclude='./.git' --exclude='./.peanut/upgrades/product.lock' \
    --exclude='./.peanut/upgrades/product-plans' --exclude='./.peanut/upgrades/product-state' \
    --exclude='./backups' --exclude='./.env' --exclude='./.env.*' \
    --exclude='./server/.env' --exclude='./server/.env.*' --exclude='./DEPLOYMENT_RECEIPT.json' \
    --exclude='./server/runtime' --exclude='./server/public/storage' --exclude='./server/private/storage' \
    --exclude='./server/private/installation/execution.lock' \
    --exclude='*/node_modules' --exclude='*/vendor' -cf - . \
    | tar -C "$prepared_root" -xf -
  # The excluded secret and volume paths also contain managed template placeholders.
  for placeholder in .env.example server/.env.example \
    server/runtime/.gitkeep server/public/storage/.gitkeep server/private/storage/.gitkeep; do
    [[ -f "$instance_root/$placeholder" && ! -L "$instance_root/$placeholder" ]] \
      || die 'managed staging placeholder is unavailable'
    mkdir -p "$(dirname "$prepared_root/$placeholder")"
    cp -p "$instance_root/$placeholder" "$prepared_root/$placeholder"
  done
  [[ -d "$package_root/target/files" && -f "$package_root/target/scaffold-manifest.json" ]] \
    || die 'signed package does not contain a materializable target'
  scaffold_plan="$(jq -r '.scaffold_plan // empty' "$plan_path")"
  [[ "$scaffold_plan" == "$instance_root/.peanut/upgrades/plans/"*.json \
    && -f "$scaffold_plan" && ! -L "$scaffold_plan" ]] \
    || die 'product plan does not bind an immutable scaffold plan'
  stage_plan="$prepared_root/.peanut/upgrades/plans/$candidate.json"
  mkdir -p "$(dirname "$stage_plan")"
  cp -p "$scaffold_plan" "$stage_plan"
  installed_autoload="$instance_root/server/vendor/autoload.php"
  [[ -f "$installed_autoload" && ! -L "$installed_autoload" ]] \
    || die 'installed Composer autoload is unavailable for signed scaffold materialization'
  php -d "auto_prepend_file=$installed_autoload" "$package_root/scripts/scaffold-upgrade" apply \
    --project-root="$prepared_root" --plan="$stage_plan" </dev/null >/dev/null \
    || die 'signed scaffold engine could not materialize the prepared target'
  rm -rf -- "$prepared_root/.peanut/upgrades"
  for marker in executing.json installed.json baseline.json migration.json; do
    source_marker="$instance_root/server/private/installation/$marker"
    prepared_marker="$prepared_root/server/private/installation/$marker"
    if [[ -e "$source_marker" || -L "$source_marker" ]]; then
      [[ -f "$source_marker" && ! -L "$source_marker" && -f "$prepared_marker" && ! -L "$prepared_marker" ]] \
        || die 'private installation identity is not a regular preserved file'
      [[ "$(sha256sum "$source_marker" | awk '{print $1}')" == "$(sha256sum "$prepared_marker" | awk '{print $1}')" ]] \
        || die 'prepared target changed private installation identity'
    else
      [[ ! -e "$prepared_marker" && ! -L "$prepared_marker" ]] \
        || die 'prepared target introduced an installation identity marker'
    fi
  done
  [[ -f "$prepared_root/compose.yaml" && -f "$prepared_root/deploy/docker-compose.prod.yml" \
    && -f "$prepared_root/deploy/docker/production.Dockerfile" \
    && -f "$prepared_root/.peanut/application-manifest.json" \
    && -d "$prepared_root/.peanut/scaffold-baseline/$target_version/files" ]] \
    || die 'materialized target lacks its production Compose build'

  suffix="upgrade-${plan_sha256#sha256:}"; suffix="${suffix:0:28}"
  php_image="peanut-admin-php:$suffix"; nginx_image="peanut-admin-nginx:$suffix"; pc_image="peanut-admin-pc:$suffix"
  receipt="$runtime_root/DEPLOYMENT_RECEIPT.json"
  target_name="$(env_value "$backend_env" PEANUT_DEPLOYMENT_TARGET)"
  jq -n --arg target "$target_name" --arg edition "$edition" --arg version "$target_version" \
    --arg candidate "$candidate" --arg plan "$plan_sha256" \
    --arg commit "$source_commit" --arg tree "$source_tree" \
    --arg inventory "sha256:$inventory_sha" --arg manifest "sha256:$manifest_sha" \
    --arg generated_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema_version:1,protocol:"peanut.product-upgrade-runtime-receipt.v1",target:$target,edition:$edition,
      release:{version:$version,commit:$commit,tree:$tree},
      upgrade_package:{candidate:$candidate,plan_sha256:$plan,inventory_sha256:$inventory,manifest_sha256:$manifest},
      images:null,generated_at:$generated_at}' >"$receipt"
  chmod 600 "$receipt"
  receipt_b64="$(base64 -w0 "$receipt")"
  compose_target=(env "PEANUT_PC_RENDER_MODE=$render_mode" "PHP_IMAGE=$php_image" "NGINX_IMAGE=$nginx_image" "PC_IMAGE=$pc_image" \
    "PEANUT_SOURCE_COMMIT=$source_commit" "PEANUT_SOURCE_TREE=$source_tree" \
    "PEANUT_SERVER_ENV_FILE=$backend_env" "PEANUT_DEPLOYMENT_RECEIPT_FILE=$receipt" \
    "PEANUT_DEPLOYMENT_RECEIPT_BASE64=$receipt_b64" docker compose "${compose_environment[@]}" \
    -p "$compose_project" -f "$prepared_root/compose.yaml" "${compose_profiles[@]}")
  "${compose_target[@]}" config >/dev/null
  build_services=(php nginx)
  build_images=("$php_image" "$nginx_image")
  [[ "$render_mode" != hybrid ]] || { build_services+=(pc); build_images+=("$pc_image"); }
  "${compose_target[@]}" build "${build_services[@]}" >&2
  php_id="$(docker image inspect --format '{{.Id}}' "$php_image")"
  nginx_id="$(docker image inspect --format '{{.Id}}' "$nginx_image")"
  pc_id=""
  [[ "$render_mode" != hybrid ]] || pc_id="$(docker image inspect --format '{{.Id}}' "$pc_image")"
  for image in "${build_images[@]}"; do
    [[ "$(docker image inspect --format '{{.Id}}' "$image")" =~ ^sha256:[a-f0-9]{64}$ ]] || die 'prepared image digest is invalid'
    [[ "$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$image")" == "$source_commit" \
      && "$(docker image inspect --format '{{index .Config.Labels "org.peanut-admin.source-tree"}}' "$image")" == "$source_tree" ]] \
      || die 'prepared image source labels differ from the authenticated package'
  done
  jq --arg php "$php_id" --arg nginx "$nginx_id" --arg pc "$pc_id" \
    '.images=({php:$php,nginx:$nginx} + (if $pc == "" then {} else {pc:$pc} end))' "$receipt" >"$receipt.tmp"
  chmod 600 "$receipt.tmp"; mv -f "$receipt.tmp" "$receipt"
  materialized_digest="$(tree_digest "$prepared_root")"
  lock_json='{}'
  for lock in server/composer.lock web/pnpm-lock.yaml platform/package-lock.json pc/package-lock.json uniapp/package-lock.json; do
    [[ -f "$prepared_root/$lock" ]] || continue
    lock_json="$(jq -c --arg path "$lock" --arg digest "sha256:$(sha256sum "$prepared_root/$lock" | awk '{print $1}')" \
      '. + {($path):$digest}' <<<"$lock_json")"
  done
  payload="$(jq -n --arg kind docker-compose-image-set --arg path "$prepared_root" \
    --arg digest "$materialized_digest" --arg php "$php_id" --arg nginx "$nginx_id" --arg pc "$pc_id" \
    --arg receipt "$receipt" \
    --arg application_manifest "sha256:$(sha256sum "$prepared_root/.peanut/application-manifest.json" | awk '{print $1}')" \
    --argjson locks "$lock_json" \
    '{prepared_target:{kind:$kind,path_or_image:$path,digest:$digest,application_manifest_sha256:$application_manifest,
        images:({php:$php,nginx:$nginx} + (if $pc == "" then {} else {pc:$pc} end)),receipt_path:$receipt},
      dependency_locks:$locks,frontend_artifacts:{admin_image:$nginx,pc_image:(if $pc == "" then $nginx else $pc end)}}')"
  write_json "$prepared_record" "$(jq -n --arg candidate "$candidate" --arg plan "$plan_sha256" --argjson payload "$payload" \
    '{candidate:$candidate,plan_sha256:$plan,payload:$payload}')"
  emit "$payload"
}

assert_writers_stopped() {
  running="$("${compose_current[@]}" ps --status running --services | sort | paste -sd, -)"
  [[ "$running" == mysql ]] || die 'writer drain did not leave only the database service running'
  unexpected="$(docker ps --filter "label=com.docker.compose.project=$compose_project" \
    --format '{{.Label "com.docker.compose.service"}}' | grep -Ev '^(mysql)?$' || true)"
  [[ -z "$unexpected" ]] || die 'a Compose one-off or application writer remained active'
}

assert_public_writers_stopped() {
  running="$("${compose_current[@]}" ps --status running --services | sort | paste -sd, -)"
  [[ "$running" == mysql,php ]] || die 'safe reload must leave only database and isolated PHP running'
  unexpected="$(docker ps --filter "label=com.docker.compose.project=$compose_project" \
    --format '{{.Label "com.docker.compose.service"}}' | grep -Ev '^(mysql|php)?$' || true)"
  [[ -z "$unexpected" ]] || die 'public traffic, worker, or one-off service is active before activation'
}

stop_writers() {
  "${compose_current[@]}" stop --timeout 60 "${stop_services[@]}" >/dev/null
  assert_writers_stopped
}

start_previous_writers() {
  "${compose_current[@]}" up -d --wait --no-deps "${writer_services[@]}" >/dev/null
}

backup_file_path() {
  case "$1" in
    database.sql.gz|php-storage.tar.gz|php-private-storage.tar.gz|php-installation.tar.gz|manifest.json) printf '%s/%s' "$backup_root" "$1" ;;
    *) die 'backup checksum references an unknown file' ;;
  esac
}

backup_file_sha() {
  sha256sum "$(backup_file_path "$1")" | awk '{print $1}'
}

assert_backup_regular_file() {
  local path
  path="$(backup_file_path "$1")"
  [[ -f "$path" && ! -L "$path" && "$(stat -c '%a %h' "$path")" == '600 1' ]] \
    || die 'bound product-upgrade backup contains a linked or non-regular file'
}

verify_backup_checksums() {
  local line digest marker filename count=0
  local seen_database= seen_public= seen_private= seen_installation= seen_manifest=
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" =~ ^([a-f0-9]{64})([[:space:]][[:space:]\*])(database\.sql\.gz|php-storage\.tar\.gz|php-private-storage\.tar\.gz|php-installation\.tar\.gz|manifest\.json)$ ]] \
      || die 'backup checksum manifest contains an unsafe entry'
    digest="${BASH_REMATCH[1]}"
    marker="${BASH_REMATCH[2]}"
    filename="${BASH_REMATCH[3]}"
    [[ "$marker" == '  ' || "$marker" == ' *' ]] || die 'backup checksum manifest contains an unsafe entry'
    case "$filename" in
      database.sql.gz) [[ -z "$seen_database" ]] || die 'backup checksum manifest contains a duplicate entry'; seen_database="$digest" ;;
      php-storage.tar.gz) [[ -z "$seen_public" ]] || die 'backup checksum manifest contains a duplicate entry'; seen_public="$digest" ;;
      php-private-storage.tar.gz) [[ -z "$seen_private" ]] || die 'backup checksum manifest contains a duplicate entry'; seen_private="$digest" ;;
      php-installation.tar.gz) [[ -z "$seen_installation" ]] || die 'backup checksum manifest contains a duplicate entry'; seen_installation="$digest" ;;
      manifest.json) [[ -z "$seen_manifest" ]] || die 'backup checksum manifest contains a duplicate entry'; seen_manifest="$digest" ;;
    esac
    count=$((count + 1))
  done <"$backup_root/SHA256SUMS"
  [[ "$count" == 5 && -n "$seen_database" && -n "$seen_public" && -n "$seen_private" && -n "$seen_installation" && -n "$seen_manifest" ]] \
    || die 'backup checksum manifest omits a required artifact'
  [[ "$seen_database" == "$(backup_file_sha database.sql.gz)" \
    && "$seen_public" == "$(backup_file_sha php-storage.tar.gz)" \
    && "$seen_private" == "$(backup_file_sha php-private-storage.tar.gz)" \
    && "$seen_installation" == "$(backup_file_sha php-installation.tar.gz)" \
    && "$seen_manifest" == "$(backup_file_sha manifest.json)" ]] \
    || die 'backup checksum manifest differs from actual backup bytes'
}

verify_storage_archive() {
  local archive="$1"
  LC_ALL=C tar -tvzf "$archive" | awk 'substr($0, 1, 1) != "-" && substr($0, 1, 1) != "d" { exit 1 }' \
    || die 'storage archive contains links or special files'
  # Keep names intact, fail closed on escaped/control names, and check duplicates
  # in one pass. pipefail also rejects a failed or truncated tar listing.
  LC_ALL=C tar -tzf "$archive" | LC_ALL=C awk '
    {
      name = $0
      if (name == "" || name ~ /^\// || name ~ /\\/ || name ~ /\/\// || name ~ /[[:cntrl:]]/) exit 1
      while (sub(/^\.\//, "", name)) {}
      if (name == "") name = "."
      if (name != ".") sub(/\/+$/, "", name)
      if (name != "." && name ~ /(^|\/)\.\.?($|\/)/) exit 1
      if (seen[name]++) exit 1
    }
  ' || die 'storage archive contains unsafe, duplicate or ambiguous paths'
}

assert_backup_state_binding() {
  local database_sha public_sha private_sha installation_sha manifest_sha database_name public_storage_volume private_storage_volume installation_volume
  database_sha="sha256:$(backup_file_sha database.sql.gz)"
  public_sha="sha256:$(backup_file_sha php-storage.tar.gz)"
  private_sha="sha256:$(backup_file_sha php-private-storage.tar.gz)"
  installation_sha="sha256:$(backup_file_sha php-installation.tar.gz)"
  manifest_sha="sha256:$(backup_file_sha manifest.json)"
  database_name="$(jq -r '.runtime.database_name' "$backup_root/manifest.json")"
  public_storage_volume="$(jq -r '.runtime.storage_volumes.public' "$backup_root/manifest.json")"
  private_storage_volume="$(jq -r '.runtime.storage_volumes.private' "$backup_root/manifest.json")"
  installation_volume="$(jq -r '.runtime.installation_volume' "$backup_root/manifest.json")"
  jq -e --arg candidate "$candidate" --arg plan "$plan_sha256" \
    --arg manifest "$manifest_sha" --arg database "$database_sha" \
    --arg public "$public_sha" --arg private "$private_sha" --arg installation "$installation_sha" \
    --arg database_path "$backup_root/database.sql.gz" \
    --arg public_path "$backup_root/php-storage.tar.gz" \
    --arg private_path "$backup_root/php-private-storage.tar.gz" \
    --arg installation_path "$backup_root/php-installation.tar.gz" \
    --arg manifest_path "$backup_root/manifest.json" \
    --arg package_sha "sha256:$plan_manifest_sha" \
    --arg database_resource "$(env_value "$backend_env" PEANUT_DATABASE_RESOURCE_ID)" \
    --arg compose_project "$compose_project" '
      .evidence.backup.payload.protocol == "peanut.product-upgrade-host-evidence.v1"
      and .evidence.backup.payload.status == "completed"
      and .evidence.backup.payload.phase == "backup"
      and .evidence.backup.payload.candidate == $candidate
      and .evidence.backup.payload.plan_sha256 == $plan
      and .evidence.backup.payload.package_manifest_sha256 == $package_sha
      and .evidence.backup.payload.payload.backup.manifest_path == $manifest_path
      and .evidence.backup.payload.payload.backup.kind == "database-storage-and-installation-volumes"
      and .evidence.backup.payload.payload.backup.manifest_sha256 == $manifest
      and .evidence.backup.payload.payload.backup.database == {path:$database_path,sha256:$database}
      and .evidence.backup.payload.payload.backup.storage.public == {path:$public_path,sha256:$public}
      and .evidence.backup.payload.payload.backup.storage.private == {path:$private_path,sha256:$private}
      and .evidence.backup.payload.payload.backup.installation == {path:$installation_path,sha256:$installation}
      and .evidence.backup.payload.payload.resources.database_resource_id == $database_resource
      and .evidence.backup.payload.payload.resources.compose_project == $compose_project
    ' "$state_path" >/dev/null || die 'state backup evidence is not bound to the selected backup bytes'
  [[ "$database_name" == "$(env_value "$backend_env" DB_NAME)" \
    && "$database_name" =~ ^[A-Za-z0-9_]{1,64}$ \
    && "$public_storage_volume" == "${compose_project}_php-storage" \
    && "$private_storage_volume" == "${compose_project}_php-private-storage" \
    && "$installation_volume" == "${compose_project}_php-installation" ]] \
    || die 'bound backup runtime identity is invalid'
}

verify_backup() {
  [[ -d "$backup_root" && ! -L "$backup_root" \
    && -f "$backup_root/database.sql.gz" && -f "$backup_root/php-storage.tar.gz" \
    && -f "$backup_root/php-private-storage.tar.gz" && -f "$backup_root/php-installation.tar.gz" \
    && -f "$backup_root/manifest.json" && -f "$backup_root/SHA256SUMS" && ! -L "$backup_root/SHA256SUMS" \
    && "$(stat -c '%a %h' "$backup_root/SHA256SUMS")" == '600 1' \
    && "$(realpath "$backup_root")" == "$backup_root" ]] \
    || die 'bound product-upgrade backup is incomplete'
  for backup_file in database.sql.gz php-storage.tar.gz php-private-storage.tar.gz php-installation.tar.gz manifest.json; do
    assert_backup_regular_file "$backup_file"
  done
  verify_backup_checksums
  gzip -t "$backup_root/database.sql.gz" || die 'bound product-upgrade backup failed verification'
  verify_storage_archive "$backup_root/php-storage.tar.gz"
  verify_storage_archive "$backup_root/php-private-storage.tar.gz"
  verify_storage_archive "$backup_root/php-installation.tar.gz"
  database_sha="sha256:$(backup_file_sha database.sql.gz)"
  public_files_sha="sha256:$(backup_file_sha php-storage.tar.gz)"
  private_files_sha="sha256:$(backup_file_sha php-private-storage.tar.gz)"
  installation_sha="sha256:$(backup_file_sha php-installation.tar.gz)"
  jq -e --arg candidate "$candidate" --arg plan "$plan_sha256" \
    --arg database_sha "$database_sha" \
    --arg public_files_sha "$public_files_sha" --arg private_files_sha "$private_files_sha" --arg installation_sha "$installation_sha" \
    '.schema_version == 1 and .protocol == "peanut.product-upgrade-backup.v1" and .candidate == $candidate and .plan_sha256 == $plan
      and (.runtime.quiesced_services | type == "object")
      and (.runtime.database_name | type == "string" and test("^[A-Za-z0-9_]{1,64}$"))
      and (.runtime.storage_volumes.public | type == "string" and length > 0)
      and (.runtime.storage_volumes.private | type == "string" and length > 0)
      and (.runtime.installation_volume | type == "string" and length > 0)
      and (.artifacts | keys == ["database","installation","storage"])
      and .artifacts.database == {filename:"database.sql.gz",sha256:$database_sha}
      and (.artifacts.storage | keys == ["private","public"])
      and .artifacts.storage.public == {filename:"php-storage.tar.gz",sha256:$public_files_sha}
      and .artifacts.storage.private == {filename:"php-private-storage.tar.gz",sha256:$private_files_sha}
      and .artifacts.installation == {filename:"php-installation.tar.gz",sha256:$installation_sha}' \
    "$backup_root/manifest.json" >/dev/null || die 'backup manifest is bound to another upgrade'
}

assert_backup_quiescence_continuity() {
  local current_services
  assert_writers_stopped
  current_services="$(service_identities)"
  jq -e --argjson current "$current_services" '.runtime.quiesced_services == $current' \
    "$backup_root/manifest.json" >/dev/null \
    || die 'a writer container changed after the bound backup; stale backup reuse is forbidden'
}

backup_payload() {
  verify_backup
  assert_backup_quiescence_continuity
  jq -n --arg manifest "$backup_root/manifest.json" \
    --arg manifest_sha "sha256:$(sha256sum "$backup_root/manifest.json" | awk '{print $1}')" \
    --arg database "$backup_root/database.sql.gz" \
    --arg database_sha "sha256:$(sha256sum "$backup_root/database.sql.gz" | awk '{print $1}')" \
    --arg public_files "$backup_root/php-storage.tar.gz" \
    --arg public_files_sha "sha256:$(sha256sum "$backup_root/php-storage.tar.gz" | awk '{print $1}')" \
    --arg private_files "$backup_root/php-private-storage.tar.gz" \
    --arg private_files_sha "sha256:$(sha256sum "$backup_root/php-private-storage.tar.gz" | awk '{print $1}')" \
    --arg installation "$backup_root/php-installation.tar.gz" \
    --arg installation_sha "sha256:$(sha256sum "$backup_root/php-installation.tar.gz" | awk '{print $1}')" \
    --arg database_resource "$(env_value "$backend_env" PEANUT_DATABASE_RESOURCE_ID)" \
    --arg compose_project "$compose_project" \
    '{backup:{kind:"database-storage-and-installation-volumes",manifest_path:$manifest,manifest_sha256:$manifest_sha,
      database:{path:$database,sha256:$database_sha},storage:{
        public:{path:$public_files,sha256:$public_files_sha},
        private:{path:$private_files,sha256:$private_files_sha}},
      installation:{path:$installation,sha256:$installation_sha}},
      resources:{database_resource_id:$database_resource,compose_project:$compose_project}}'
}

backup_phase() {
  if [[ -d "$backup_root" ]]; then
    emit "$(backup_payload)"
    return
  fi
  mkdir -p "$(dirname "$backup_root")"
  mkdir -m 0700 "$backup_root"
  database_name="$(env_value "$backend_env" DB_NAME)"
  [[ "$database_name" =~ ^[A-Za-z0-9_]{1,64}$ ]] || die 'database name is unsafe'
  public_storage_volume="${compose_project}_php-storage"
  private_storage_volume="${compose_project}_php-private-storage"
  installation_volume="${compose_project}_php-installation"
  public_storage_mount="$(docker volume inspect --format '{{.Mountpoint}}' "$public_storage_volume")"
  private_storage_mount="$(docker volume inspect --format '{{.Mountpoint}}' "$private_storage_volume")"
  installation_mount="$(docker volume inspect --format '{{.Mountpoint}}' "$installation_volume")"
  [[ -d "$public_storage_mount" && -d "$private_storage_mount" && -d "$installation_mount" ]] \
    || die 'registered application storage volumes are unavailable'
  before="$(service_identities)"
  stopped=0
  backup_complete=0
  resume_on_failure() {
    local status=$?
    if (( backup_complete == 0 )); then
      find "$backup_root" -mindepth 1 -delete >/dev/null 2>&1 || true
      rmdir "$backup_root" >/dev/null 2>&1 || true
    fi
    if (( stopped == 1 && backup_complete == 0 )); then
      start_previous_writers >/dev/null 2>&1 || true
    fi
    exit "$status"
  }
  trap resume_on_failure EXIT
  stopped=1
  stop_writers
  "${compose_current[@]}" exec -T mysql sh -c \
    'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysqldump --single-transaction --quick --routines --events --triggers --hex-blob --set-gtid-purged=OFF -uroot "$1"' \
    sh "$database_name" | gzip -9 >"$backup_root/database.sql.gz"
  tar --one-file-system --numeric-owner -C "$public_storage_mount" -czf "$backup_root/php-storage.tar.gz" .
  tar --one-file-system --numeric-owner -C "$private_storage_mount" -czf "$backup_root/php-private-storage.tar.gz" .
  tar --one-file-system --numeric-owner -C "$installation_mount" -czf "$backup_root/php-installation.tar.gz" .
  database_sha="$(sha256sum "$backup_root/database.sql.gz" | awk '{print $1}')"
  public_files_sha="$(sha256sum "$backup_root/php-storage.tar.gz" | awk '{print $1}')"
  private_files_sha="$(sha256sum "$backup_root/php-private-storage.tar.gz" | awk '{print $1}')"
  installation_sha="$(sha256sum "$backup_root/php-installation.tar.gz" | awk '{print $1}')"
  quiesced="$(service_identities)"
  jq -n --arg candidate "$candidate" --arg plan "$plan_sha256" \
    --arg database_name "$database_name" \
    --arg public_storage_volume "$public_storage_volume" --arg private_storage_volume "$private_storage_volume" \
    --arg installation_volume "$installation_volume" \
    --arg database_sha "sha256:$database_sha" \
    --arg public_files_sha "sha256:$public_files_sha" --arg private_files_sha "sha256:$private_files_sha" \
    --arg installation_sha "sha256:$installation_sha" \
    --argjson services "$before" --argjson quiesced "$quiesced" \
    --arg created_at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    '{schema_version:1,protocol:"peanut.product-upgrade-backup.v1",candidate:$candidate,plan_sha256:$plan,
      runtime:{database_name:$database_name,storage_volumes:{
          public:$public_storage_volume,private:$private_storage_volume},installation_volume:$installation_volume,
        services_before_backup:$services,quiesced_services:$quiesced},
      artifacts:{database:{filename:"database.sql.gz",sha256:$database_sha},storage:{
          public:{filename:"php-storage.tar.gz",sha256:$public_files_sha},
          private:{filename:"php-private-storage.tar.gz",sha256:$private_files_sha}},
        installation:{filename:"php-installation.tar.gz",sha256:$installation_sha}},created_at:$created_at}' \
    >"$backup_root/manifest.json"
  (cd "$backup_root" && sha256sum database.sql.gz php-storage.tar.gz php-private-storage.tar.gz php-installation.tar.gz manifest.json >SHA256SUMS)
  chmod 600 "$backup_root"/*
  verify_backup
  backup_complete=1
  trap - EXIT
  emit "$(backup_payload)"
}

quiesce_phase() {
  verify_backup
  assert_backup_quiescence_continuity
  before="$(service_identities)"
  marker="$runtime_root/write-gate.json"
  payload="$(jq -n --arg kind stopped-compose-writers --arg project "$compose_project" \
    --arg marker "$marker" --argjson before "$before" --argjson after "$(service_identities)" \
    --argjson drained "$(printf '%s\n' "${writer_services[@]}" | jq -R . | jq -s .)" \
    '{write_gate:{kind:$kind,marker:$marker,active:true},compose_project:$project,observed_before:$before,observed_after:$after,drained_services:$drained}')"
  write_json "$marker" "$payload"
  emit "$payload"
}

switch_phase() {
  [[ "$(jq -r '.migration_completed' "$state_path")" == true ]] \
    || die 'target switch requires orchestrator-confirmed migration completion'
  payload="$(prepared_payload)"
  receipt="$(jq -r '.prepared_target.receipt_path' <<<"$payload")"
  [[ -f "$receipt" && ! -L "$receipt" ]] || die 'prepared runtime receipt is unavailable'
  running="$("${compose_current[@]}" ps --status running --services | sort | paste -sd, -)"
  [[ "$running" == mysql ]] || die 'target switch requires the quiesced Compose state'
  php_id="$(jq -r '.prepared_target.images.php' <<<"$payload")"
  nginx_id="$(jq -r '.prepared_target.images.nginx' <<<"$payload")"
  pc_id="$(jq -r '.prepared_target.images.pc // empty' <<<"$payload")"
  set_target_compose
  install -m 0644 "$receipt" "$current_receipt"
  set_env_key "$root_env" PHP_IMAGE "$php_id"
  set_env_key "$root_env" NGINX_IMAGE "$nginx_id"
  set_env_key "$root_env" PC_IMAGE "$pc_id"
  set_env_key "$root_env" PEANUT_SOURCE_COMMIT "$source_commit"
  set_env_key "$root_env" PEANUT_SOURCE_TREE "$source_tree"
  set_env_key "$root_env" PEANUT_DEPLOYMENT_RECEIPT_FILE "$current_receipt"
  active_digest="$(jq -n --arg receipt "sha256:$(sha256sum "$current_receipt" | awk '{print $1}')" \
    --arg php "$php_id" --arg nginx "$nginx_id" --arg pc "$pc_id" \
    '{receipt:$receipt,images:({php:$php,nginx:$nginx} + (if $pc == "" then {} else {pc:$pc} end))}' | sha256sum | awk '{print "sha256:" $1}')"
  emit "$(jq -n --arg digest "$active_digest" --arg receipt "$current_receipt" \
    --arg php "$php_id" --arg nginx "$nginx_id" --arg pc "$pc_id" \
    '{active_target:{kind:"docker-compose-image-set",digest:$digest,receipt_path:$receipt,images:({php:$php,nginx:$nginx} + (if $pc == "" then {} else {pc:$pc} end))}}')"
}

reload_safe_phase() {
  "${compose_current[@]}" config >/dev/null
  "${compose_current[@]}" up -d --wait mysql >/dev/null
  "${compose_current[@]}" run -T --rm --no-deps --entrypoint php php \
    server/database/environment-guard.php --current </dev/null >/dev/null
  "${compose_current[@]}" up -d --wait --no-deps php >/dev/null
  assert_public_writers_stopped
  identities="$(service_identities)"
  emit "$(jq -n --arg project "$compose_project" --argjson services "$identities" \
    '{compose_project:$project,write_gate_active:true,services:$services}')"
}

health_phase() {
  [[ -f "$current_receipt" && ! -L "$current_receipt" ]] || die 'runtime receipt is missing'
  activated="$(jq -r '.activation_started' "$state_path")"
  if [[ "$activated" == false ]]; then
    assert_public_writers_stopped
  else
    identities="$(service_identities)"
    assert_runtime_running "$identities"
    port="$(env_value "$root_env" HTTP_PORT)"; [[ "$port" =~ ^[0-9]{1,5}$ ]] || die 'HTTP port is invalid'
    curl -fsS --retry 3 --retry-delay 1 "http://127.0.0.1:$port/healthz" >/dev/null
    curl -fsS "http://127.0.0.1:$port/legal/RELEASE_METADATA.json" | jq -e 'type == "object"' >/dev/null
    curl -fsS "http://127.0.0.1:$port/" >/dev/null
  fi
  "${compose_current[@]}" exec -T php php server/database/environment-guard.php --current </dev/null >/dev/null
  "${compose_current[@]}" exec -T php php server/think plugin:lock --check </dev/null >/dev/null
  installation_status="$("${compose_current[@]}" exec -T php php server/database/install.php --status </dev/null)" \
    || die 'installed business state probe failed'
  jq -e --arg edition "$edition" '
    .state == "installed" and .code == "INSTALL_ALREADY_COMPLETED"
    and (.health | type == "object")
    and (.health.tenant_count | type == "number" and . >= 1)
    and (.health.owner_count | type == "number" and . >= 1)
    and (.health.operator_count | type == "number" and . >= (if $edition == "multi-tenant" then 1 else 0 end))
    and (.health.application_migration_count | type == "number")
    and (.health.module_migration_count | type == "number")
    and (.health.menu_count | type == "number" and . >= 1)
    and (.health.permission_count | type == "number" and . >= 1)
  ' <<<"$installation_status" >/dev/null || die 'installed business state is incomplete'
  identities="$(service_identities)"
  php_container="$(jq -r '.php.container_id // empty' <<<"$identities")"
  [[ "$php_container" =~ ^[a-f0-9]{64}$ ]] || die 'running PHP service identity is unavailable'
  runtime_receipt="$(docker exec "$php_container" cat /var/www/peanut-admin/DEPLOYMENT_RECEIPT.json)"
  [[ "$(cat "$current_receipt")" == "$runtime_receipt" ]] || die 'host and PHP runtime receipts differ'
  prepared_images="$(prepared_payload | jq -c '.prepared_target.images')"
  jq -e --arg candidate "$candidate" --arg plan "$plan_sha256" --arg commit "$source_commit" --arg tree "$source_tree" \
    --argjson activated "$activated" --arg mode "$render_mode" --argjson prepared_images "$prepared_images" \
    --arg php "$(jq -r '.php.image_id' <<<"$identities")" \
    --arg nginx "$(jq -r '.nginx.image_id' <<<"$identities")" \
    --arg pc "$(jq -r '.pc.image_id' <<<"$identities")" '
    .protocol == "peanut.product-upgrade-runtime-receipt.v1"
    and .upgrade_package.candidate == $candidate and .upgrade_package.plan_sha256 == $plan
    and .release.commit == $commit and .release.tree == $tree
    and .images == $prepared_images and .images.php == $php
    and (if $activated then .images.nginx == $nginx and (if $mode == "hybrid" then .images.pc == $pc else (.images | has("pc") | not) end) else true end)
  ' "$current_receipt" >/dev/null || die 'runtime receipt or image binding differs from the upgrade plan'
  runtime_digest="$(printf '%s\n%s\n' "$(sha256sum "$current_receipt")" "$(jq -S . <<<"$identities")" | sha256sum | awk '{print "sha256:" $1}')"
  emit "$(jq -n --arg candidate "$candidate" --arg commit "$source_commit" --arg tree "$source_tree" \
    --argjson activated "$activated" \
    --arg digest "$runtime_digest" --argjson services "$identities" \
    --argjson installation_health "$(jq -c '.health' <<<"$installation_status")" \
    '{candidate:$candidate,commit:$commit,tree:$tree,runtime_digest:$digest,services:$services,
      write_gate_active:($activated | not),activation_started:$activated,installation_health:$installation_health,
      probes:{database_environment:true,plugin_lock:true,
        installation_status:true,receipt_image_binding:true,
        public_http:(if $activated then true else null end)}}')"
}

activate_phase() {
  jq -e '.activation_started == true and (.evidence.health | type == "object")' "$state_path" >/dev/null \
    || die 'activation requires durable healthy state and activation boundary'
  "${compose_current[@]}" up -d --wait --no-deps "${writer_services[@]}" >/dev/null
  identities="$(service_identities)"
  assert_runtime_running "$identities"
  port="$(env_value "$root_env" HTTP_PORT)"; [[ "$port" =~ ^[0-9]{1,5}$ ]] || die 'HTTP port is invalid'
  curl -fsS --retry 12 --retry-delay 2 "http://127.0.0.1:$port/healthz" >/dev/null
  curl -fsS "http://127.0.0.1:$port/legal/RELEASE_METADATA.json" | jq -e 'type == "object"' >/dev/null
  curl -fsS "http://127.0.0.1:$port/" >/dev/null
  installation_status="$("${compose_current[@]}" exec -T php php server/database/install.php --status </dev/null)" \
    || die 'activated business state probe failed'
  jq -e --arg edition "$edition" '
    .state == "installed" and (.health.tenant_count | type == "number" and . >= 1)
    and (.health.owner_count | type == "number" and . >= 1)
    and (.health.operator_count | type == "number" and . >= (if $edition == "multi-tenant" then 1 else 0 end))
  ' <<<"$installation_status" >/dev/null || die 'activated business state is incomplete'
  emit "$(jq -n --arg project "$compose_project" --argjson services "$identities" \
    --argjson installation_health "$(jq -c '.health' <<<"$installation_status")" \
    '{activation:{opened:true,automatic_destructive_recovery_forbidden:true},compose_project:$project,
      services:$services,installation_health:$installation_health,
      probes:{healthz:true,legal_metadata:true,root_http:true,installation_status:true}}')"
}

restore_previous_runtime() {
  [[ -f "$previous_root/root.env" ]] || die 'previous root environment is unavailable'
  cp -p "$previous_root/root.env" "$root_env"
  if [[ -f "$previous_root/server.env" ]]; then cp -p "$previous_root/server.env" "$backend_env"; fi
  if [[ -f "$previous_root/DEPLOYMENT_RECEIPT.json" ]]; then
    install -m 0644 "$previous_root/DEPLOYMENT_RECEIPT.json" "$current_receipt"
  fi
  set_current_compose
}

recover_phase() {
  [[ "$(jq -r '.activation_started // false' "$state_path")" == false ]] \
    || die 'automatic destructive recovery is forbidden after activation starts'
  if [[ -f "$recovery_record" ]]; then
    [[ ! -L "$recovery_record" && "$(stat -c '%a %h' "$recovery_record")" == '600 1' ]] \
      || die 'durable host recovery record is invalid'
    jq -e --arg candidate "$candidate" --arg plan "$plan_sha256" '
      .protocol == "peanut.product-upgrade-host-recovery.v1" and .status == "data-runtime-restored"
      and .candidate == $candidate and .plan_sha256 == $plan
      and .payload.recovery.writers_stopped == true and .payload.recovery.resume_required == true
    ' "$recovery_record" >/dev/null || die 'durable host recovery record is bound to another upgrade'
    if [[ -f "$resume_old_record" ]]; then
      jq -e --arg candidate "$candidate" --arg plan "$plan_sha256" \
        --arg recovery_sha "sha256:$(sha256sum "$recovery_record" | awk '{print $1}')" '
          .protocol == "peanut.product-upgrade-host-resume-old.v1" and .status == "completed"
          and .candidate == $candidate and .plan_sha256 == $plan
          and .recovery_record_sha256 == $recovery_sha
          and .payload.recovery.resumed_old_runtime == true and .payload.recovery.verified == true
        ' "$resume_old_record" >/dev/null || die 'durable old runtime resume record is invalid'
    else
      assert_writers_stopped
    fi
    emit "$(jq -c '.payload' "$recovery_record")"
    return
  fi
  database_recovery_required="$(jq -r '.database_recovery_required // false' "$state_path")"
  recovery_kind=program-only
  backup_manifest_sha=null
  if [[ "$database_recovery_required" == true ]]; then
    verify_backup
    assert_backup_state_binding
    database_name="$(jq -r '.runtime.database_name' "$backup_root/manifest.json")"
    public_storage_volume="$(jq -r '.runtime.storage_volumes.public' "$backup_root/manifest.json")"
    private_storage_volume="$(jq -r '.runtime.storage_volumes.private' "$backup_root/manifest.json")"
    installation_volume="$(jq -r '.runtime.installation_volume' "$backup_root/manifest.json")"
    [[ "$database_name" =~ ^[A-Za-z0-9_]{1,64}$ \
      && "$public_storage_volume" == "${compose_project}_php-storage" \
      && "$private_storage_volume" == "${compose_project}_php-private-storage" \
      && "$installation_volume" == "${compose_project}_php-installation" ]] \
      || die 'bound backup runtime identity is invalid'
  fi
  stop_writers
  if [[ "$database_recovery_required" == true ]]; then
    "${compose_current[@]}" exec -T mysql sh -c \
      'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysql -uroot -e "DROP DATABASE IF EXISTS \`$1\`; CREATE DATABASE \`$1\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci"' \
      sh "$database_name"
    gzip -dc "$backup_root/database.sql.gz" | "${compose_current[@]}" exec -T mysql sh -c \
      'MYSQL_PWD="$MYSQL_ROOT_PASSWORD" exec mysql -uroot "$1"' sh "$database_name"
    public_storage_mount="$(docker volume inspect --format '{{.Mountpoint}}' "$public_storage_volume")"
    private_storage_mount="$(docker volume inspect --format '{{.Mountpoint}}' "$private_storage_volume")"
    installation_mount="$(docker volume inspect --format '{{.Mountpoint}}' "$installation_volume")"
    [[ -d "$public_storage_mount" && -d "$private_storage_mount" && -d "$installation_mount" ]] \
      || die 'bound storage volumes are unavailable for recovery'
    find "$public_storage_mount" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
    find "$private_storage_mount" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
    find "$installation_mount" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
    tar -xzf "$backup_root/php-storage.tar.gz" -C "$public_storage_mount"
    tar -xzf "$backup_root/php-private-storage.tar.gz" -C "$private_storage_mount"
    tar -xzf "$backup_root/php-installation.tar.gz" -C "$installation_mount"
    backup_manifest_sha="sha256:$(sha256sum "$backup_root/manifest.json" | awk '{print $1}')"
    recovery_kind=database-public-private-storage-installation-and-program
  fi
  restore_previous_runtime
  "${compose_current[@]}" up -d --wait mysql >/dev/null
  assert_writers_stopped
  restored_database_name="$(env_value "$backend_env" DB_NAME)"
  restored_database_resource="$(env_value "$backend_env" PEANUT_DATABASE_RESOURCE_ID)"
  recovery_payload="$(jq -n --arg kind "$recovery_kind" --arg backup_manifest_sha "$backup_manifest_sha" \
    --arg database_name "$restored_database_name" --arg database_resource "$restored_database_resource" \
    --arg public_storage_volume "${compose_project}_php-storage" \
    --arg private_storage_volume "${compose_project}_php-private-storage" \
    --arg installation_volume "${compose_project}_php-installation" \
    --argjson services "$(service_identities)" \
    '{recovery:{kind:$kind,data_runtime_restored:true,writers_stopped:true,resume_required:true,
        backup_manifest_sha256:(if $backup_manifest_sha == "null" then null else $backup_manifest_sha end)},
      restored_resources:{database_name:$database_name,database_resource_id:$database_resource,
        storage_volumes:{public:$public_storage_volume,private:$private_storage_volume},
        installation_volume:$installation_volume},
      services:$services}')"
  write_json "$recovery_record" "$(jq -n --arg candidate "$candidate" --arg plan "$plan_sha256" \
    --argjson payload "$recovery_payload" \
    '{schema_version:1,protocol:"peanut.product-upgrade-host-recovery.v1",status:"data-runtime-restored",
      candidate:$candidate,plan_sha256:$plan,payload:$payload}')"
  emit "$recovery_payload"
}

resume_old_phase() {
  [[ -f "$recovery_record" && ! -L "$recovery_record" \
    && "$(stat -c '%a %h' "$recovery_record")" == '600 1' ]] \
    || die 'old runtime resume requires durable host recovery evidence'
  jq -e --arg candidate "$candidate" --arg plan "$plan_sha256" '
    .protocol == "peanut.product-upgrade-host-recovery.v1" and .status == "data-runtime-restored"
    and .candidate == $candidate and .plan_sha256 == $plan
    and .payload.recovery.resume_required == true
  ' "$recovery_record" >/dev/null || die 'old runtime resume evidence is invalid'
  [[ "$(jq -r '.activation_started' "$state_path")" == false ]] \
    || die 'old runtime resume is forbidden after activation starts'
  if [[ -e "$resume_old_record" || -L "$resume_old_record" ]]; then
    [[ -f "$resume_old_record" && ! -L "$resume_old_record" \
      && "$(stat -c '%a %h' "$resume_old_record")" == '600 1' ]] \
      || die 'durable old runtime resume record is invalid'
    jq -e --arg candidate "$candidate" --arg plan "$plan_sha256" \
      --arg recovery_sha "sha256:$(sha256sum "$recovery_record" | awk '{print $1}')" \
      --arg receipt_sha "sha256:$(sha256sum "$current_receipt" | awk '{print $1}')" '
        .protocol == "peanut.product-upgrade-host-resume-old.v1" and .status == "completed"
        and .candidate == $candidate and .plan_sha256 == $plan
        and .recovery_record_sha256 == $recovery_sha and .runtime_receipt_sha256 == $receipt_sha
        and .payload.recovery.resumed_old_runtime == true and .payload.recovery.verified == true
      ' "$resume_old_record" >/dev/null || die 'durable old runtime resume record is bound to another runtime'
    # Replay the completed operation, not its writes. recovery-verify observes live health.
    emit "$(jq -c '.payload' "$resume_old_record")"
    return
  fi
  resume_old_record_written=0
  resume_old_failure() {
    local status=$? stop_status drain_status
    trap - EXIT INT TERM
    set +e
    if (( status != 0 )); then
      "${compose_current[@]}" stop --timeout 60 "${stop_services[@]}" >/dev/null
      stop_status=$?
      (assert_writers_stopped)
      drain_status=$?
      # Never leave a receipt for an operation whose final response failed.
      if (( resume_old_record_written == 1 )); then rm -f -- "$resume_old_record"; fi
      rm -f -- "${resume_old_record}.tmp-$$"
      if (( stop_status != 0 || drain_status != 0 )); then
        printf 'product-upgrade-host: resume failed (exit %s); writer isolation unconfirmed, manual intervention required\n' "$status" >&2
      else
        printf 'product-upgrade-host: resume failed (exit %s); application writers stopped, same-plan retry required\n' "$status" >&2
      fi
    fi
    exit "$status"
  }
  trap resume_old_failure EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  "${compose_current[@]}" config >/dev/null
  "${compose_current[@]}" up -d --wait mysql >/dev/null
  "${compose_current[@]}" up -d --wait --no-deps "${writer_services[@]}" >/dev/null
  assert_runtime_running
  "${compose_current[@]}" exec -T php php server/database/environment-guard.php --current </dev/null >/dev/null
  "${compose_current[@]}" exec -T php php server/think plugin:lock --check </dev/null >/dev/null
  installation_status="$("${compose_current[@]}" exec -T php php server/database/install.php --status </dev/null)" \
    || die 'recovered business state probe failed'
  jq -e --arg edition "$edition" '
    .state == "installed" and (.health.tenant_count | type == "number" and . >= 1)
    and (.health.owner_count | type == "number" and . >= 1)
    and (.health.operator_count | type == "number" and . >= (if $edition == "multi-tenant" then 1 else 0 end))
  ' <<<"$installation_status" >/dev/null || die 'recovered business state is incomplete'
  port="$(env_value "$root_env" HTTP_PORT)"; [[ "$port" =~ ^[0-9]{1,5}$ ]] || die 'HTTP port is invalid'
  curl -fsS --retry 12 --retry-delay 2 "http://127.0.0.1:$port/healthz" >/dev/null
  identities="$(service_identities)"
  php_container="$(jq -r '.php.container_id // empty' <<<"$identities")"
  [[ "$php_container" =~ ^[a-f0-9]{64}$ ]] || die 'recovered PHP service identity is unavailable'
  runtime_receipt="$(docker exec "$php_container" cat /var/www/peanut-admin/DEPLOYMENT_RECEIPT.json)"
  [[ "$(cat "$current_receipt")" == "$runtime_receipt" ]] \
    || die 'recovered host and PHP runtime receipts differ'
  resume_payload="$(jq -n --arg project "$compose_project" --argjson services "$identities" \
    --argjson installation_health "$(jq -c '.health' <<<"$installation_status")" \
    '{recovery:{resumed_old_runtime:true,verified:true},compose_project:$project,
      services:$services,installation_health:$installation_health,
      probes:{healthz:true,database_environment:true,plugin_lock:true,installation_status:true,receipt_binding:true}}')"
  write_json "$resume_old_record" "$(jq -n --arg candidate "$candidate" --arg plan "$plan_sha256" \
    --arg recovery_sha "sha256:$(sha256sum "$recovery_record" | awk '{print $1}')" \
    --arg receipt_sha "sha256:$(sha256sum "$current_receipt" | awk '{print $1}')" \
    --argjson payload "$resume_payload" \
    '{schema_version:1,protocol:"peanut.product-upgrade-host-resume-old.v1",status:"completed",
      candidate:$candidate,plan_sha256:$plan,recovery_record_sha256:$recovery_sha,
      runtime_receipt_sha256:$receipt_sha,payload:$payload}')"
  resume_old_record_written=1
  emit "$resume_payload"
  trap - EXIT INT TERM
}

recovery_verify_phase() {
  [[ "$(jq -r '.phase' "$state_path")" == recovered ]] \
    || die 'recovery verification requires recovered terminal state'
  for record in "$recovery_record" "$resume_old_record"; do
    [[ -f "$record" && ! -L "$record" && "$(stat -c '%a %h' "$record")" == '600 1' ]] \
      || die 'durable recovery verification record is unavailable'
  done
  recovery_sha="sha256:$(sha256sum "$recovery_record" | awk '{print $1}')"
  receipt_sha="sha256:$(sha256sum "$current_receipt" | awk '{print $1}')"
  database_recovery_required="$(jq -r '.database_recovery_required' "$state_path")"
  if [[ "$database_recovery_required" == true ]]; then
    # Verify the durable binding, not the already-restored backup contents again.
    expected_backup_manifest_sha="$(jq -er --arg candidate "$candidate" --arg plan "$plan_sha256" \
      --arg manifest "sha256:$manifest_sha" '
        .evidence.backup.payload
        | select(.protocol == "peanut.product-upgrade-host-evidence.v1"
          and .status == "completed" and .phase == "backup"
          and .candidate == $candidate and .plan_sha256 == $plan
          and .package_manifest_sha256 == $manifest)
        | .payload.backup.manifest_sha256
        | select(type == "string" and test("^sha256:[a-f0-9]{64}$"))
      ' "$state_path")" || die 'durable backup state binding is invalid'
    expected_recovery_kind=database-public-private-storage-installation-and-program
  else
    expected_recovery_kind=program-only
    expected_backup_manifest_sha=null
  fi
  expected_database_name="$(env_value "$backend_env" DB_NAME)"
  expected_database_resource="$(env_value "$backend_env" PEANUT_DATABASE_RESOURCE_ID)"
  public_storage_volume="${compose_project}_php-storage"
  private_storage_volume="${compose_project}_php-private-storage"
  installation_volume="${compose_project}_php-installation"
  jq -e --arg candidate "$candidate" --arg plan "$plan_sha256" \
    --arg kind "$expected_recovery_kind" --arg backup_manifest_sha "$expected_backup_manifest_sha" \
    --arg database_name "$expected_database_name" --arg database_resource "$expected_database_resource" \
    --arg public_storage_volume "$public_storage_volume" --arg private_storage_volume "$private_storage_volume" \
    --arg installation_volume "$installation_volume" '
      .schema_version == 1
      and .protocol == "peanut.product-upgrade-host-recovery.v1"
      and .status == "data-runtime-restored"
      and .candidate == $candidate and .plan_sha256 == $plan
      and .payload.recovery.kind == $kind
      and .payload.recovery.data_runtime_restored == true
      and .payload.recovery.writers_stopped == true
      and .payload.recovery.resume_required == true
      and (if $backup_manifest_sha == "null" then
          .payload.recovery.backup_manifest_sha256 == null
        else
          .payload.recovery.backup_manifest_sha256 == $backup_manifest_sha
        end)
      and .payload.restored_resources.database_name == $database_name
      and .payload.restored_resources.database_resource_id == $database_resource
      and .payload.restored_resources.storage_volumes.public == $public_storage_volume
      and .payload.restored_resources.storage_volumes.private == $private_storage_volume
      and .payload.restored_resources.installation_volume == $installation_volume
      and (.payload.services | type == "object")
    ' "$recovery_record" >/dev/null || die 'durable recovery record is invalid'
  jq -e --arg candidate "$candidate" --arg plan "$plan_sha256" \
    --arg recovery_sha "$recovery_sha" --arg receipt_sha "$receipt_sha" \
    --arg compose_project "$compose_project" '
      .protocol == "peanut.product-upgrade-host-resume-old.v1" and .status == "completed"
      and .candidate == $candidate and .plan_sha256 == $plan
      and .recovery_record_sha256 == $recovery_sha and .runtime_receipt_sha256 == $receipt_sha
      and .payload.recovery.resumed_old_runtime == true and .payload.recovery.verified == true
      and .payload.compose_project == $compose_project
      and .payload.probes == {healthz:true,database_environment:true,plugin_lock:true,installation_status:true,receipt_binding:true}
      and (.payload.installation_health | type == "object")
    ' "$resume_old_record" >/dev/null || die 'durable old runtime receipt is invalid'
  docker volume inspect "$public_storage_volume" "$private_storage_volume" "$installation_volume" >/dev/null \
    || die 'recovered storage volumes are unavailable'
  identities="$(service_identities)"
  assert_runtime_running "$identities"
  saved_images="$(jq -c '.payload.services | with_entries(.value = .value.image_id)' "$resume_old_record")"
  current_images="$(jq -c 'with_entries(.value = .value.image_id)' <<<"$identities")"
  [[ "$saved_images" == "$current_images" ]] || die 'recovered runtime image identity changed'
  "${compose_current[@]}" exec -T php php server/database/environment-guard.php --current </dev/null >/dev/null \
    || die 'recovered database_environment verification failed'
  "${compose_current[@]}" exec -T php php server/think plugin:lock --check </dev/null >/dev/null \
    || die 'recovered plugin_lock verification failed'
  installation_status="$("${compose_current[@]}" exec -T php php server/database/install.php --status </dev/null)" \
    || die 'recovered installation_status verification failed'
  jq -e --arg edition "$edition" '
    .state == "installed" and (.health.tenant_count | type == "number" and . >= 1)
    and (.health.owner_count | type == "number" and . >= 1)
    and (.health.operator_count | type == "number" and . >= (if $edition == "multi-tenant" then 1 else 0 end))
  ' <<<"$installation_status" >/dev/null || die 'recovered business state verification is incomplete'
  # Writers have resumed: legitimate new tenants must not invalidate live health.
  php_container="$(jq -r '.php.container_id // empty' <<<"$identities")"
  runtime_receipt="$(docker exec "$php_container" cat /var/www/peanut-admin/DEPLOYMENT_RECEIPT.json)" \
    || die 'recovered runtime receipt read failed'
  [[ "$(cat "$current_receipt")" == "$runtime_receipt" ]] \
    || die 'recovered runtime receipt identity changed'
  port="$(env_value "$root_env" HTTP_PORT)"; [[ "$port" =~ ^[0-9]{1,5}$ ]] || die 'HTTP port is invalid'
  curl -fsS --retry 3 --retry-delay 1 "http://127.0.0.1:$port/healthz" >/dev/null \
    || die 'recovered healthz verification failed'
  emit "$(jq -n --arg recovery_record_sha "$recovery_sha" --arg resume_record_sha \
    "sha256:$(sha256sum "$resume_old_record" | awk '{print $1}')" \
    --argjson services "$identities" --argjson installation_health "$(jq -c '.health' <<<"$installation_status")" \
    '{recovery:{verified:true,read_only:true,recovery_record_sha256:$recovery_record_sha,
        resume_record_sha256:$resume_record_sha},services:$services,installation_health:$installation_health}')"
}

case "$phase" in
  prepare) prepare_phase ;;
  migration-preflight|migrate|migration-verify) database_phase ;;
  backup) backup_phase ;;
  quiesce) quiesce_phase ;;
  switch) switch_phase ;;
  reload-safe) reload_safe_phase ;;
  health) health_phase ;;
  activate) activate_phase ;;
  recover) recover_phase ;;
  resume-old) resume_old_phase ;;
  recovery-verify) recovery_verify_phase ;;
esac
