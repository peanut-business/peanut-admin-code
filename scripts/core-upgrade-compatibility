#!/usr/bin/env bash

set -Eeuo pipefail

usage() {
  printf 'Usage: scripts/core-upgrade-compatibility --candidate <full-commit> --cache /absolute/path --output /absolute/path\n' >&2
  exit 64
}

die() {
  printf 'core-upgrade-compatibility: %s\n' "$*" >&2
  exit 1
}

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
FIXTURE="$ROOT/server/tests/fixtures/core-upgrade-compatibility"
METADATA="$FIXTURE/fixture.json"
COMPOSER_BIN="$ROOT/scripts/project-composer"
PHP_BIN="/opt/homebrew/bin/php"
PNPM_BIN="pnpm"

cache_input=''
output_input=''
candidate_input=''
while [[ $# -gt 0 ]]; do
  case "$1" in
    --candidate) [[ $# -ge 2 ]] || usage; candidate_input="$2"; shift 2 ;;
    --cache) [[ $# -ge 2 ]] || usage; cache_input="$2"; shift 2 ;;
    --output) [[ $# -ge 2 ]] || usage; output_input="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[[ -n "$candidate_input" && -n "$cache_input" && -n "$output_input" ]] || usage

canonical_empty_target() {
  local input="$1" label="$2" parent base physical
  [[ "$input" == /* ]] || die "$label must be absolute"
  parent="$(dirname "$input")"
  base="$(basename "$input")"
  [[ -d "$parent" ]] || die "$label parent does not exist: $parent"
  physical="$(cd "$parent" && pwd -P)/$base"
  [[ ! -L "$input" ]] || die "$label must not be a symlink: $input"
  if [[ -e "$physical" ]]; then
    [[ -d "$physical" ]] || die "$label must be a directory"
    [[ -z "$(find "$physical" -mindepth 1 -print -quit)" ]] || die "$label must be empty: $physical"
  fi
  printf '%s\n' "$physical"
}

CACHE="$(canonical_empty_target "$cache_input" cache)"
OUTPUT="$(canonical_empty_target "$output_input" output)"
[[ "$CACHE" != "$OUTPUT" ]] || die 'cache and output must differ'
case "$CACHE/" in "$OUTPUT/"*) die 'cache must not be inside output' ;; esac
case "$OUTPUT/" in "$CACHE/"*) die 'output must not be inside cache' ;; esac
mkdir -p "$CACHE" "$OUTPUT"

for command in git jq "$PHP_BIN" "$COMPOSER_BIN" "$PNPM_BIN" npm node shasum; do
  command -v "$command" >/dev/null 2>&1 || die "required command is unavailable: $command"
done
jq -e '.schema_version == 2' "$METADATA" >/dev/null || die 'fixture metadata is invalid'
[[ "$candidate_input" =~ ^[a-f0-9]{40}$ ]] || die 'candidate must be a full commit SHA'
CANDIDATE="$(git -C "$ROOT" rev-parse "${candidate_input}^{commit}")"
[[ "$CANDIDATE" == "$candidate_input" ]] || die 'candidate commit identity changed'
[[ "$(git -C "$ROOT" rev-parse HEAD)" == "$CANDIDATE" ]] || die 'working tree is not checked out at the fixed candidate'
CANDIDATE_TREE="$(git -C "$ROOT" rev-parse "${CANDIDATE}^{tree}")"

CURRENT_VERSION="$(jq -r '.current_create_app.release_identity.version' "$METADATA")"
CURRENT_RELEASE_MANIFEST="$ROOT/scaffold/releases/v${CURRENT_VERSION}/scaffold-manifest.json"
CURRENT_APP="$OUTPUT/current-create-app"
LEGACY_WORK="$CACHE/legacy-selection"
LEGACY_COMMIT="$(jq -r '.legacy_pre_alpha5.source_commit' "$METADATA")"
LEGACY_APP="$LEGACY_WORK/$LEGACY_COMMIT"
CORE_MONOREPO="$CACHE/core-monorepo"
CORE_SPLIT="$CACHE/core-split"
COMPOSER_CACHE="$CACHE/composer"
PNPM_STORE="$CACHE/pnpm-store"
CHECKPOINT="$OUTPUT/checkpoint.json"
CURRENT_PHASE=initialization

cleanup() {
  local status=$?
  if [[ "$status" -ne 0 && -f "$CHECKPOINT" ]]; then
    jq --arg phase "$CURRENT_PHASE" --argjson exit_code "$status" \
      '.status = "failed" | .failure = {phase:$phase, exit_code:$exit_code}' \
      "$CHECKPOINT" >"${CHECKPOINT}.tmp" 2>/dev/null \
      && mv "${CHECKPOINT}.tmp" "$CHECKPOINT" \
      || true
  fi
}
trap cleanup EXIT INT TERM

check_expected_digest() {
  local key="$1" actual="$2" expected
  expected="$(jq -r "$key" "$METADATA")"
  [[ "$expected" =~ ^[a-f0-9]{64}$ ]] || die "fixed digest is missing: $key"
  [[ "$expected" == "$actual" ]] || die "fixed digest mismatch: $key expected=$expected actual=$actual"
}

file_sha256() {
  shasum -a 256 "$1" | awk '{print $1}'
}

LEGACY_LOCK_SHA256="$(git -C "$ROOT" show "${LEGACY_COMMIT}:server/composer.lock" | shasum -a 256 | awk '{print $1}')"
ALPHA5_LOCK_SHA256="$(file_sha256 "$FIXTURE/composer-alpha5.lock")"
WEB_ALPHA4_LOCK_SHA256="$(file_sha256 "$FIXTURE/pnpm-alpha4-lock.yaml")"
WEB_ALPHA5_LOCK_SHA256="$(file_sha256 "$FIXTURE/pnpm-alpha5-lock.yaml")"
[[ "$LEGACY_LOCK_SHA256" == "$(jq -r '.legacy_pre_alpha5.composer_lock_sha256' "$METADATA")" ]] || die 'legacy Composer lock digest changed'

jq -n \
  --arg candidate "$CANDIDATE" --arg candidate_tree "$CANDIDATE_TREE" \
  --arg legacy_commit "$LEGACY_COMMIT" \
  --arg legacy_archive "$(jq -r '.legacy_pre_alpha5.archive_sha256' "$METADATA")" \
  --arg legacy_lock "$LEGACY_LOCK_SHA256" --arg alpha5_lock "$ALPHA5_LOCK_SHA256" \
  --arg web_alpha4_lock "$WEB_ALPHA4_LOCK_SHA256" --arg web_alpha5_lock "$WEB_ALPHA5_LOCK_SHA256" \
  --argjson continuation "$(jq '.continuation_evidence' "$METADATA")" \
  '{schema_version:1,status:"running",execution_mode:"new_candidate_full_matrix",candidate:{commit:$candidate,tree:$candidate_tree},legacy:{commit:$legacy_commit,archive_sha256:$legacy_archive},locks:{composer_alpha2_sha256:$legacy_lock,composer_alpha5_sha256:$alpha5_lock,pnpm_alpha4_sha256:$web_alpha4_lock,pnpm_alpha5_sha256:$web_alpha5_lock},continuation_evidence:$continuation,phases:{}}' >"$CHECKPOINT"

record_phase() {
  local phase="$1" detail="$2" temporary="${CHECKPOINT}.tmp"
  jq --arg phase "$phase" --arg detail "$detail" '.phases[$phase] = {status:"passed",summary:$detail}' "$CHECKPOINT" >"$temporary"
  mv "$temporary" "$CHECKPOINT"
}

CURRENT_RELEASE_COMMIT="$(jq -r '.release.source_commit' "$CURRENT_RELEASE_MANIFEST")"
CURRENT_RELEASE_TREE="$(jq -r '.release.source_tree' "$CURRENT_RELEASE_MANIFEST")"
CURRENT_INVENTORY_SHA256="$(file_sha256 "$ROOT/scaffold/application-template-inventory.json")"
[[ "$(git -C "$ROOT" rev-parse "${CURRENT_RELEASE_COMMIT}^{commit}")" == "$CURRENT_RELEASE_COMMIT" ]] || die 'current create-app release source commit is unavailable'
[[ "$(git -C "$ROOT" rev-parse "${CURRENT_RELEASE_COMMIT}^{tree}")" == "$CURRENT_RELEASE_TREE" ]] || die 'current create-app release source tree changed'
jq -e --arg version "$CURRENT_VERSION" \
  --arg inventory "$(jq -r '.current_create_app.release_identity.inventory_sha256' "$METADATA")" \
  --arg managed "$(jq -r '.current_create_app.release_identity.managed_tree_sha256' "$METADATA")" \
  --argjson file_count "$(jq -r '.current_create_app.release_identity.file_count' "$METADATA")" \
  '.release.version == $version
   and .release.inventory_template_version == $version
   and .release.inventory_sha256 == $inventory
   and .release.managed_tree_sha256 == $managed
   and (.files | length) == $file_count' "$CURRENT_RELEASE_MANIFEST" >/dev/null \
  || die 'current create-app release seal changed'
[[ -z "$(git -C "$ROOT" status --porcelain=v1 --untracked-files=all)" ]] || die 'candidate working tree is not clean'
"$PHP_BIN" "$ROOT/scripts/create-app" \
  --name="$(jq -r '.current_create_app.application_name' "$METADATA")" \
  --slug="$(jq -r '.current_create_app.slug' "$METADATA")" \
  --package="$(jq -r '.current_create_app.package_identity' "$METADATA")" \
  --edition=standalone \
  --target="$CURRENT_APP" >"$OUTPUT/create-app.json"

CURRENT_MANIFEST="$CURRENT_APP/.peanut/application-manifest.json"
current_identity_matches() {
  local manifest="$1"
  jq -e \
    --arg name "$(jq -r '.current_create_app.application_name' "$METADATA")" \
    --arg slug "$(jq -r '.current_create_app.slug' "$METADATA")" \
    --arg package "$(jq -r '.current_create_app.package_identity' "$METADATA")" \
    --arg version "$CURRENT_VERSION" --arg release_commit "$CURRENT_RELEASE_COMMIT" --arg release_tree "$CURRENT_RELEASE_TREE" \
    --arg release_inventory "$(jq -r '.current_create_app.release_identity.inventory_sha256' "$METADATA")" \
    --arg candidate "$CANDIDATE" --arg candidate_tree "$CANDIDATE_TREE" --arg candidate_inventory "$CURRENT_INVENTORY_SHA256" \
    '.schema_version == 2
     and .protocol == "peanut.application-scaffold.v2"
     and .application == {name:$name,slug:$slug,package_identity:$package,version:"0.1.0"}
     and .template == {version:$version,inventory_sha256:$release_inventory,source_commit:$release_commit,source_tree:$release_tree}
     and .generation_source == {commit:$candidate,tree:$candidate_tree,inventory_sha256:$candidate_inventory}' "$manifest" >/dev/null
}
current_identity_matches "$CURRENT_MANIFEST" || die 'current create-app release/generation identity mismatch'
for identity_case in release candidate inventory; do
  tampered="$OUTPUT/identity-tamper-${identity_case}.json"
  case "$identity_case" in
    release) jq '.template.source_commit = ("0" * 40)' "$CURRENT_MANIFEST" >"$tampered" ;;
    candidate) jq '.generation_source.commit = ("0" * 40)' "$CURRENT_MANIFEST" >"$tampered" ;;
    inventory) jq '.generation_source.inventory_sha256 = ("0" * 64)' "$CURRENT_MANIFEST" >"$tampered" ;;
  esac
  if current_identity_matches "$tampered"; then die "identity fixture accepted wrong ${identity_case}"; fi
done
current_manifest_sha="$(shasum -a 256 "$CURRENT_MANIFEST" | awk '{print $1}')"
check_expected_digest '.current_create_app.expected.managed_tree_sha256' "$(jq -r '.digests.managed_tree_sha256' "$CURRENT_MANIFEST")"
check_expected_digest '.current_create_app.expected.app_owned_tree_sha256' "$(jq -r '.digests.app_owned_tree_sha256' "$CURRENT_MANIFEST")"
jq -e --slurpfile release "$CURRENT_RELEASE_MANIFEST" --argjson expected "$(jq -r '.current_create_app.expected.application_file_count' "$METADATA")" '
  ([.files[] | select(.classification == "managed" or .classification == "generated-managed") | {path,mode,classification}] | sort_by(.path))
    == ([$release[0].files[] | {path,mode,classification}] | sort_by(.path))
  and (.files | length) == $expected
' "$CURRENT_MANIFEST" >/dev/null || die 'current create-app managed set or application file count changed'

mkdir -p "$CURRENT_APP/web/src/core"
cp "$FIXTURE/web-probe.ts" "$CURRENT_APP/web/src/core/core-upgrade-compatibility-probe.ts"

"$ROOT/scripts/select-legacy-pre-alpha5-fixture" \
  --head "$(jq -r '.legacy_pre_alpha5.selection_head' "$METADATA")" \
  --work-dir "$LEGACY_WORK" >"$OUTPUT/legacy-selection.json"
jq -e --slurpfile expected "$METADATA" '
  ($expected[0]) as $expected |
  .name == $expected.legacy_pre_alpha5.name
  and .selection_head == $expected.legacy_pre_alpha5.selection_head
  and .source_commit == $expected.legacy_pre_alpha5.source_commit
  and .source_tree == $expected.legacy_pre_alpha5.source_tree
  and .archive_sha256 == $expected.legacy_pre_alpha5.archive_sha256
  and .composer_json_sha256 == $expected.legacy_pre_alpha5.composer_json_sha256
  and .composer_lock_sha256 == $expected.legacy_pre_alpha5.composer_lock_sha256
  and .version == $expected.php.old_version
  and .source_reference == $expected.php.old_source_reference
  and .public_psr4_root_count == 10
  and .overlay_files == []
' "$OUTPUT/legacy-selection.json" >/dev/null || die 'legacy-pre-alpha5 selector identity changed'

tree_digest() {
  local root="$1" mode="$2" manifest="${3:-}"
  "$PHP_BIN" /dev/stdin "$root" "$mode" "$manifest" <<'PHP'
<?php
$root = $argv[1];
$mode = $argv[2];
$manifestPath = $argv[3];
$allowed = ['server/composer.json', 'server/composer.lock', 'web/package.json', 'web/pnpm-lock.yaml'];
$excluded = ['vendor', 'node_modules', 'dist', 'runtime', '.cache', '.pnpm-store', 'output', '.peanut'];
$paths = [];
if ($mode === 'current-app-owned') {
    $manifest = json_decode((string) file_get_contents($manifestPath), true, 512, JSON_THROW_ON_ERROR);
    foreach ($manifest['files'] as $file) {
        if (($file['classification'] ?? null) === 'app-owned') $paths[] = $file['path'];
    }
    $paths[] = 'web/src/core/core-upgrade-compatibility-probe.ts';
} elseif ($mode === 'legacy-host') {
    $paths = [
        'server/app/common/contract/AdminPermissionPolicy.php',
        'server/app/common/composition/CoreServiceOverrides.php',
        'server/app/common/policy/permission/RegisteredAdminPermissionPolicy.php',
        'server/tests/Productization/AdminPermissionHostTest.php',
    ];
} elseif ($mode === 'empty-overlay') {
    echo hash('sha256', '');
    exit(0);
} else {
    $iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS));
    foreach ($iterator as $file) {
        if (!$file->isFile() || $file->isLink()) continue;
        $path = str_replace(DIRECTORY_SEPARATOR, '/', substr($file->getPathname(), strlen($root) + 1));
        if (in_array($path, $allowed, true)) continue;
        if (array_intersect($excluded, explode('/', $path)) !== []) continue;
        $paths[] = $path;
    }
}
$rows = [];
foreach (array_values(array_unique($paths)) as $path) {
    $absolute = $root . '/' . $path;
    if (!is_file($absolute)) { fwrite(STDERR, "missing digest input: {$path}\n"); exit(1); }
    $rows[] = $path . "\0" . hash_file('sha256', $absolute);
}
sort($rows, SORT_STRING);
echo hash('sha256', implode("\n", $rows));
PHP
}

current_app_owned_before="$(tree_digest "$CURRENT_APP" current-app-owned "$CURRENT_MANIFEST")"
current_source_before="$(tree_digest "$CURRENT_APP" source)"
legacy_host_before="$(tree_digest "$LEGACY_APP" legacy-host)"
legacy_source_before="$(tree_digest "$LEGACY_APP" source)"
legacy_overlay_before="$(tree_digest "$LEGACY_APP" empty-overlay)"
printf 'current_app_owned_with_probe_sha256=%s\ncurrent_application_source_sha256=%s\nlegacy_app_owned_host_sha256=%s\nlegacy_application_source_sha256=%s\nlegacy_overlay_sha256=%s\n' \
  "$current_app_owned_before" "$current_source_before" "$legacy_host_before" "$legacy_source_before" "$legacy_overlay_before" >"$OUTPUT/source-digests.txt"
check_expected_digest '.current_create_app.expected.app_owned_with_probe_sha256' "$current_app_owned_before"
check_expected_digest '.current_create_app.expected.application_source_sha256' "$current_source_before"
check_expected_digest '.legacy_pre_alpha5.app_owned_host_sha256' "$legacy_host_before"
check_expected_digest '.legacy_pre_alpha5.application_source_sha256' "$legacy_source_before"
check_expected_digest '.legacy_pre_alpha5.overlay_sha256' "$legacy_overlay_before"

set_json_version() {
  local manifest="$1" expression="$2" version="$3" temporary
  temporary="${manifest}.tmp"
  jq "$expression = \$version" --arg version "$version" "$manifest" >"$temporary"
  mv "$temporary" "$manifest"
}

assert_php_identity() {
  local app="$1" version="$2" reference="$3"
  "$PHP_BIN" /dev/stdin "$app/server/composer.lock" "$app/server/vendor/composer/installed.json" "$version" "$reference" <<'PHP'
<?php
[$script, $lockPath, $installedPath, $version, $reference] = $argv;
foreach ([$lockPath, $installedPath] as $path) {
    $document = json_decode((string) file_get_contents($path), true, 512, JSON_THROW_ON_ERROR);
    $packages = $document['packages'] ?? $document;
    $found = false;
    foreach ($packages as $package) {
        if (($package['name'] ?? null) !== 'peanut-admin/core') continue;
        $found = ($package['version'] ?? null) === $version
            && ($package['dist']['reference'] ?? null) === $reference;
        if ($path === $lockPath) $found = $found && ($package['source']['reference'] ?? null) === $reference;
    }
    if (!$found) exit(1);
}
PHP
  [[ $? == 0 ]] || die "Composer identity mismatch for $version"
}

assert_web_identity() {
  local version="$1" integrity="$2"
  [[ "$(jq -r '.version' "$CURRENT_APP/web/node_modules/@peanut-admin/admin/package.json")" == "$version" ]] || die "installed npm version mismatch for $version"
  grep -F -- "resolution: {integrity: $integrity}" "$CURRENT_APP/web/pnpm-lock.yaml" >/dev/null || die "pnpm integrity mismatch for $version"
}

php_public_entry_gate() {
  local scan_root="$1" phase="$2" php_manifest="$LEGACY_APP/server/vendor/peanut-admin/core/composer.json"
  "$PHP_BIN" /dev/stdin "$scan_root" "$php_manifest" <<'PHP'
<?php
$root = $argv[1];
$manifest = json_decode((string) file_get_contents($argv[2]), true, 512, JSON_THROW_ON_ERROR);
$prefixes = array_keys($manifest['autoload']['psr-4'] ?? []);
$iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root . '/server', FilesystemIterator::SKIP_DOTS));
foreach ($iterator as $file) {
    if (!$file->isFile() || $file->getExtension() !== 'php' || str_contains($file->getPathname(), '/vendor/')) continue;
    $content = (string) file_get_contents($file->getPathname());
    if (preg_match('#(?:vendor/peanut-admin|packages/php|peanut-admin/core/.*/src/)#i', $content)) exit(1);
    preg_match_all('/\b(?:use|new|extends|implements|instanceof)\s+\\\\?(PeanutAdmin\\\\[A-Za-z0-9_\\\\]+)/', $content, $matches);
    foreach ($matches[1] as $class) {
        $ok = false;
        foreach ($prefixes as $prefix) if (str_starts_with($class . '\\', $prefix)) { $ok = true; break; }
        if (!$ok) { fwrite(STDERR, "undeclared Composer namespace: {$class}\n"); exit(1); }
    }
}
PHP
  jq -S '.autoload["psr-4"] | keys' "$php_manifest" >"$OUTPUT/${phase}-composer-namespaces.json"
}

web_public_entry_gate() {
  local phase="$1" npm_manifest="$CURRENT_APP/web/node_modules/@peanut-admin/admin/package.json"
  node "$FIXTURE/web-public-entry-gate.mjs" "$CURRENT_APP" "$npm_manifest"
  jq -S '.exports | keys' "$npm_manifest" >"$OUTPUT/${phase}-npm-exports.json"
}

run_php_phase() {
  local phase="$1" version="$2" reference="$3"
  COMPOSER_CACHE_DIR="$COMPOSER_CACHE" "$COMPOSER_BIN" install --working-dir "$LEGACY_APP/server" --no-interaction --no-progress --prefer-dist
  assert_php_identity "$LEGACY_APP" "$version" "$reference"
  "$PHP_BIN" "$LEGACY_APP/server/tests/Productization/AdminPermissionHostTest.php"
  php_public_entry_gate "$LEGACY_APP" "$phase"
}

run_web_phase() {
  local phase="$1" version="$2" integrity="$3"
  (cd "$CURRENT_APP/web" && HUSKY=0 "$PNPM_BIN" install --frozen-lockfile --store-dir "$PNPM_STORE")
  assert_web_identity "$version" "$integrity"
  (cd "$CURRENT_APP/web" && "$PNPM_BIN" run type:check && "$PNPM_BIN" run build)
  web_public_entry_gate "$phase"
}

php_old="$(jq -r '.php.old_version' "$METADATA")"
php_old_ref="$(jq -r '.php.old_source_reference' "$METADATA")"
php_new="$(jq -r '.php.new_version' "$METADATA")"
php_new_ref="$(jq -r '.php.new_source_reference' "$METADATA")"
web_old="$(jq -r '.web.old_version' "$METADATA")"
web_old_integrity="$(jq -r '.web.old_integrity' "$METADATA")"
web_new="$(jq -r '.web.new_version' "$METADATA")"
web_new_integrity="$(jq -r '.web.new_integrity' "$METADATA")"

CURRENT_PHASE=php-alpha2
run_php_phase php-alpha2 "$php_old" "$php_old_ref"
record_phase php-alpha2 "frozen install, autoload, native PB04-AUTH-HOST-001 and public PSR-4 gate passed"
set_json_version "$CURRENT_APP/web/package.json" '.dependencies["@peanut-admin/admin"]' "$web_old"
cp "$FIXTURE/pnpm-alpha4-lock.yaml" "$CURRENT_APP/web/pnpm-lock.yaml"
CURRENT_PHASE=web-alpha4
run_web_phase web-alpha4 "$web_old" "$web_old_integrity"
record_phase web-alpha4 "frozen install, lock integrity, typecheck, build, consumer and public export gate passed"

[[ "$(tree_digest "$LEGACY_APP" legacy-host)" == "$legacy_host_before" ]] || die 'old PHP phase changed app-owned Host files'
[[ "$(tree_digest "$LEGACY_APP" source)" == "$legacy_source_before" ]] || die 'old PHP phase changed legacy application source'
[[ "$(tree_digest "$CURRENT_APP" current-app-owned "$CURRENT_MANIFEST")" == "$current_app_owned_before" ]] || die 'old Web phase changed current app-owned source'
[[ "$(tree_digest "$CURRENT_APP" source)" == "$current_source_before" ]] || die 'old Web phase changed current application source'

set_json_version "$LEGACY_APP/server/composer.json" '.require["peanut-admin/core"]' "$php_new"
cp "$FIXTURE/composer-alpha5.lock" "$LEGACY_APP/server/composer.lock"
CURRENT_PHASE=php-alpha5
run_php_phase php-alpha5 "$php_new" "$php_new_ref"
php_public_entry_gate "$CURRENT_APP" current-create-app-php-alpha5
record_phase php-alpha5 "manifest/lock-only upgrade, frozen install, same Host test and legacy/current PSR-4 gates passed"
set_json_version "$CURRENT_APP/web/package.json" '.dependencies["@peanut-admin/admin"]' "$web_new"
cp "$FIXTURE/pnpm-alpha5-lock.yaml" "$CURRENT_APP/web/pnpm-lock.yaml"
CURRENT_PHASE=web-alpha5
run_web_phase web-alpha5 "$web_new" "$web_new_integrity"
record_phase web-alpha5 "manifest/lock-only upgrade, frozen install, typecheck, build, same consumer and public export gate passed"

[[ "$(tree_digest "$LEGACY_APP" legacy-host)" == "$legacy_host_before" ]] || die 'PHP upgrade changed app-owned Host files'
[[ "$(tree_digest "$LEGACY_APP" source)" == "$legacy_source_before" ]] || die 'PHP upgrade changed legacy application source'
[[ "$(tree_digest "$LEGACY_APP" empty-overlay)" == "$legacy_overlay_before" ]] || die 'PHP upgrade changed legacy overlay'
[[ "$(tree_digest "$CURRENT_APP" current-app-owned "$CURRENT_MANIFEST")" == "$current_app_owned_before" ]] || die 'Web upgrade changed current app-owned source'
[[ "$(tree_digest "$CURRENT_APP" source)" == "$current_source_before" ]] || die 'Web upgrade changed current application source'
jq -e --slurp '.[0] - .[1] == []' "$OUTPUT/php-alpha2-composer-namespaces.json" "$OUTPUT/php-alpha5-composer-namespaces.json" >/dev/null || die 'alpha.5 removed an alpha.2 public Composer namespace'
jq -e --slurp '.[0] - .[1] == []' "$OUTPUT/web-alpha4-npm-exports.json" "$OUTPUT/web-alpha5-npm-exports.json" >/dev/null || die 'alpha.5 removed an alpha.4 installed npm export'

CURRENT_PHASE=release-identities
git init -q "$CORE_MONOREPO"
git -C "$CORE_MONOREPO" remote add origin https://github.com/peanut-opensource/peanut-admin.git
git -C "$CORE_MONOREPO" fetch -q --depth=1 origin tag v0.1.0-alpha.4 tag v0.1.0-alpha.5
for field in tag_object commit tree; do
  expected="$(jq -r ".known_release_identity_defect.${field}" "$METADATA")"
  case "$field" in
    tag_object) actual="$(git -C "$CORE_MONOREPO" rev-parse v0.1.0-alpha.4)" ;;
    commit) actual="$(git -C "$CORE_MONOREPO" rev-parse 'v0.1.0-alpha.4^{commit}')" ;;
    tree) actual="$(git -C "$CORE_MONOREPO" rev-parse 'v0.1.0-alpha.4^{tree}')" ;;
  esac
  [[ "$actual" == "$expected" ]] || die "core alpha.4 $field changed"
done
[[ "$(git -C "$CORE_MONOREPO" show v0.1.0-alpha.4:packages/php/composer.json | jq -r '.version')" == "$(jq -r '.known_release_identity_defect.embedded_package_version' "$METADATA")" ]] || die 'recorded alpha.4 embedded PHP identity changed'
if COMPOSER_CACHE_DIR="$COMPOSER_CACHE" "$COMPOSER_BIN" show peanut-admin/core 0.1.0-alpha.4 --all --format=json >/dev/null 2>&1; then
  die 'Packagist unexpectedly exposes alpha.4; release identity policy requires review'
fi
for field in tag_object commit tree; do
  expected="$(jq -r ".php.new_monorepo_${field}" "$METADATA")"
  case "$field" in
    tag_object) actual="$(git -C "$CORE_MONOREPO" rev-parse v0.1.0-alpha.5)" ;;
    commit) actual="$(git -C "$CORE_MONOREPO" rev-parse 'v0.1.0-alpha.5^{commit}')" ;;
    tree) actual="$(git -C "$CORE_MONOREPO" rev-parse 'v0.1.0-alpha.5^{tree}')" ;;
  esac
  [[ "$actual" == "$expected" ]] || die "core alpha.5 $field changed"
done
[[ "$(git -C "$CORE_MONOREPO" show v0.1.0-alpha.5:packages/php/composer.json | jq -r '.version')" == "$php_new" ]] || die 'core alpha.5 embedded PHP identity mismatches tag'

git init -q "$CORE_SPLIT"
git -C "$CORE_SPLIT" remote add origin https://github.com/peanut-opensource/peanut-admin-core.git
git -C "$CORE_SPLIT" fetch -q --depth=1 origin tag v0.1.0-alpha.2 tag v0.1.0-alpha.5
for side in old new; do
  version="$(jq -r ".php.${side}_version" "$METADATA")"
  [[ "$(git -C "$CORE_SPLIT" rev-parse "v${version}")" == "$(jq -r ".php.${side}_split_tag_object" "$METADATA")" ]] || die "Composer split tag changed for $version"
  [[ "$(git -C "$CORE_SPLIT" rev-parse "v${version}^{commit}")" == "$(jq -r ".php.${side}_split_commit" "$METADATA")" ]] || die "Composer split commit changed for $version"
  [[ "$(git -C "$CORE_SPLIT" rev-parse "v${version}^{tree}")" == "$(jq -r ".php.${side}_split_tree" "$METADATA")" ]] || die "Composer split tree changed for $version"
  [[ "$(git -C "$CORE_SPLIT" show "v${version}:composer.json" | jq -r '.version')" == "$version" ]] || die "Composer split metadata mismatches tag $version"
done

for side in old new; do
  version="$(jq -r ".php.${side}_version" "$METADATA")"
  reference="$(jq -r ".php.${side}_source_reference" "$METADATA")"
  identity="$OUTPUT/packagist-${version}.json"
  COMPOSER_CACHE_DIR="$COMPOSER_CACHE" "$COMPOSER_BIN" show peanut-admin/core "$version" --all --format=json >"$identity"
  jq -e --arg version "$version" --arg reference "$reference" '.versions == [$version] and .source.reference == $reference and .dist.reference == $reference' "$identity" >/dev/null || die "Packagist identity mismatch for $version"
done

npm view "@peanut-admin/admin@${web_old}" exports --json | jq -S 'keys' >"$OUTPUT/npm-alpha4-exports.json"
npm view "@peanut-admin/admin@${web_new}" exports --json | jq -S 'keys' >"$OUTPUT/npm-alpha5-exports.json"
jq -e --slurp '.[0] - .[1] == []' "$OUTPUT/npm-alpha4-exports.json" "$OUTPUT/npm-alpha5-exports.json" >/dev/null || die 'alpha.5 removed an alpha.4 Registry npm export'
for side in old new; do
  version="$(jq -r ".web.${side}_version" "$METADATA")"
  integrity="$(jq -r ".web.${side}_integrity" "$METADATA")"
  shasum="$(jq -r ".web.${side}_shasum" "$METADATA")"
  identity="$OUTPUT/npm-${version}.json"
  npm view "@peanut-admin/admin@${version}" version dist.integrity dist.shasum --json >"$identity"
  jq -e --arg version "$version" --arg integrity "$integrity" --arg shasum "$shasum" '.version == $version and .["dist.integrity"] == $integrity and .["dist.shasum"] == $shasum' "$identity" >/dev/null || die "npm Registry identity changed for $version"
done
record_phase release-identities "monorepo tags, Composer split tags, Packagist and npm Registry identities matched fixed metadata"

CURRENT_PHASE=final-proof
jq -n \
  --arg release_commit "$CURRENT_RELEASE_COMMIT" --arg release_tree "$CURRENT_RELEASE_TREE" --arg current_manifest "$current_manifest_sha" \
  --arg generation_commit "$CANDIDATE" --arg generation_tree "$CANDIDATE_TREE" --arg generation_inventory "$CURRENT_INVENTORY_SHA256" \
  --arg current_source "$current_source_before" --arg current_app_owned "$current_app_owned_before" \
  --arg legacy_commit "$LEGACY_COMMIT" --arg legacy_tree "$(jq -r '.legacy_pre_alpha5.source_tree' "$METADATA")" \
  --arg legacy_archive "$(jq -r '.legacy_pre_alpha5.archive_sha256' "$METADATA")" --arg legacy_source "$legacy_source_before" \
  --arg legacy_host "$legacy_host_before" --arg legacy_overlay "$legacy_overlay_before" \
  --arg php_old "$php_old" --arg php_old_ref "$php_old_ref" --arg php_new "$php_new" --arg php_new_ref "$php_new_ref" \
  --arg web_old "$web_old" --arg web_old_integrity "$web_old_integrity" --arg web_new "$web_new" --arg web_new_integrity "$web_new_integrity" \
  --arg candidate "$CANDIDATE" --arg candidate_tree "$CANDIDATE_TREE" \
  --argjson continuation "$(jq '.continuation_evidence' "$METADATA")" \
  --argjson defect "$(jq '.known_release_identity_defect' "$METADATA")" \
  '{schema_version:2,status:"passed",execution_mode:"new_candidate_full_matrix",candidate:{commit:$candidate,tree:$candidate_tree},continuation_evidence:$continuation,current_create_app:{release_identity:{commit:$release_commit,tree:$release_tree},generation_identity:{commit:$generation_commit,tree:$generation_tree,inventory_sha256:$generation_inventory},generated_manifest_sha256:$current_manifest,application_source_sha256:$current_source,app_owned_with_probe_sha256:$current_app_owned},legacy_pre_alpha5:{source_commit:$legacy_commit,source_tree:$legacy_tree,archive_sha256:$legacy_archive,application_source_sha256:$legacy_source,app_owned_host_sha256:$legacy_host,overlay_sha256:$legacy_overlay,overlay_files:[]},php:{old:$php_old,old_source_reference:$php_old_ref,new:$php_new,new_source_reference:$php_new_ref,status:"passed"},web:{old:$web_old,old_integrity:$web_old_integrity,new:$web_new,new_integrity:$web_new_integrity,status:"passed"},public_entry_gate:"passed",source_diff_gate:"passed",known_php_release_identity_defect:$defect,not_covered:["database","services","ports","containers","browser","full PC build","full UniApp build","publication"]}' >"$OUTPUT/summary.json"

record_phase final-proof "PSR-4/npm exports retained; deep-import and source/app-owned digest gates passed"
jq '.status = "passed"' "$CHECKPOINT" >"${CHECKPOINT}.tmp"
mv "${CHECKPOINT}.tmp" "$CHECKPOINT"

printf 'CORE-UPGRADE-COMPATIBILITY-002 passed; summary=%s\n' "$OUTPUT/summary.json"
