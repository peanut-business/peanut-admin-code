#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
base_ref=''
head_ref='HEAD'
paths_file=''
output_file=''
fallback_full=0
force_all=0
reason='path classification'
comparison='merge-base'

usage() {
  cat >&2 <<'EOF'
Usage:
  scripts/ci-change-classifier --base=<git-ref> [--head=<git-ref>] [--fallback-full] [--github-output=<path>]
  scripts/ci-change-classifier --paths-file=<path> [--github-output=<path>]
  scripts/ci-change-classifier --all [--reason=<text>] [--github-output=<path>]
EOF
  exit 2
}

for argument in "$@"; do
  case "$argument" in
    --base=*) base_ref="${argument#--base=}" ;;
    --head=*) head_ref="${argument#--head=}" ;;
    --paths-file=*) paths_file="${argument#--paths-file=}" ;;
    --github-output=*) output_file="${argument#--github-output=}" ;;
    --reason=*) reason="${argument#--reason=}" ;;
    --comparison=*) comparison="${argument#--comparison=}" ;;
    --fallback-full) fallback_full=1 ;;
    --all) force_all=1 ;;
    *) usage ;;
  esac
done

[[ "$comparison" == 'merge-base' || "$comparison" == 'direct' ]] || usage

[[ -z "$output_file" || "$output_file" == /* ]] || usage
[[ -z "$paths_file" || "$paths_file" == /* ]] || usage
if [[ "$force_all" -eq 0 && -z "$paths_file" && -z "$base_ref" ]]; then
  usage
fi
if [[ -n "$paths_file" && -n "$base_ref" ]]; then
  usage
fi

groups=(server web platform pc uniapp create_app integration api docs)
server=false
web=false
platform=false
pc=false
uniapp=false
create_app=false
integration=false
api=false
docs=false
conservative='false'
baseline='explicit'
declare -a paths=()

select_all() {
  server=true
  web=true
  platform=true
  pc=true
  uniapp=true
  create_app=true
  integration=true
  api=true
  docs=true
}

add_path() {
  local path="$1"
  [[ -n "$path" ]] || return 0
  [[ "$path" != /* && "$path" != *'..'* ]] || {
    printf 'ci-change-classifier: unsafe changed path: %s\n' "$path" >&2
    exit 2
  }
  paths+=("$path")
}

if [[ "$force_all" -eq 1 ]]; then
  select_all
  baseline='manual-full'
elif [[ -n "$paths_file" ]]; then
  [[ -f "$paths_file" && ! -L "$paths_file" ]] || {
    printf 'ci-change-classifier: paths file is unavailable: %s\n' "$paths_file" >&2
    exit 2
  }
  while IFS= read -r path || [[ -n "$path" ]]; do
    add_path "$path"
  done <"$paths_file"
else
  cd "$ROOT"
  if ! git rev-parse --verify "${base_ref}^{commit}" >/dev/null 2>&1 \
    || ! git rev-parse --verify "${head_ref}^{commit}" >/dev/null 2>&1; then
    if [[ "$fallback_full" -ne 1 ]]; then
      printf 'ci-change-classifier: comparison baseline is unavailable: %s...%s\n' "$base_ref" "$head_ref" >&2
      exit 1
    fi
    select_all
    conservative='true'
    baseline='fallback-full'
    reason="comparison baseline unavailable: ${base_ref}...${head_ref}"
  else
    diff_file="$(mktemp "${TMPDIR:-/tmp}/peanut-ci-classifier-diff.XXXXXX")"
    if [[ "$comparison" == 'direct' ]]; then
      diff_label="${base_ref}..${head_ref}"
      diff_command=(git diff --name-status -z "$base_ref" "$head_ref")
    else
      diff_label="${base_ref}...${head_ref}"
      diff_command=(git diff --name-status -z "${base_ref}...${head_ref}")
    fi
    if ! "${diff_command[@]}" >"$diff_file"; then
      rm -f -- "$diff_file"
      if [[ "$fallback_full" -ne 1 ]]; then
        printf 'ci-change-classifier: comparison failed: %s\n' "$diff_label" >&2
        exit 1
      fi
      select_all
      conservative='true'
      baseline='fallback-full'
      reason="comparison failed: ${diff_label}"
    else
      baseline="explicit-${comparison}"
    while IFS= read -r -d '' status; do
      if [[ "$status" == R* || "$status" == C* ]]; then
        IFS= read -r -d '' old_path || { echo 'ci-change-classifier: truncated rename record' >&2; exit 1; }
        IFS= read -r -d '' new_path || { echo 'ci-change-classifier: truncated rename record' >&2; exit 1; }
        add_path "$old_path"
        add_path "$new_path"
      else
        IFS= read -r -d '' path || { echo 'ci-change-classifier: truncated change record' >&2; exit 1; }
        add_path "$path"
      fi
      done <"$diff_file"
      rm -f -- "$diff_file"
    fi
  fi
fi

if [[ "$force_all" -eq 0 && "$baseline" != 'fallback-full' && "${#paths[@]}" -eq 0 ]]; then
  echo 'ci-change-classifier: comparison produced zero changed paths; refusing an empty green run' >&2
  exit 1
fi

mark() {
  local group
  for group in "$@"; do
    case "$group" in
      server) server=true ;;
      web) web=true ;;
      platform) platform=true ;;
      pc) pc=true ;;
      uniapp) uniapp=true ;;
      create_app) create_app=true ;;
      integration) integration=true ;;
      api) api=true ;;
      docs) docs=true ;;
      *)
        printf 'ci-change-classifier: classifier referenced unknown group: %s\n' "$group" >&2
        exit 2
        ;;
    esac
  done
}

classify() {
  local path="$1"
  case "$path" in
    .github/workflows/*|scripts/ci-change-classifier|scripts/ci-server-check.sh|scripts/ci-summary|scripts/tests/ci-change-classifier-test)
      select_all
      ;;
    docs/*|README.md|CHANGELOG.md|SECURITY.md|NOTICE|LICENSE|THIRD_PARTY_NOTICES.md|server/app/api/metadata/README.md|scripts/check-public-docs)
      mark docs
      ;;
    release-versions.json|release-versions.schema.json|RELEASE_METADATA.json|RELEASE_SBOM.spdx.json|UPGRADE_TRUSTED_KEYS.json)
      select_all
      ;;
    server/composer.json|server/composer.lock)
      mark server create_app integration
      ;;
    web/package.json|web/pnpm-lock.yaml)
      mark web create_app
      ;;
    platform/package.json|platform/package-lock.json)
      mark platform create_app
      ;;
    pc/package.json|pc/package-lock.json)
      mark pc create_app
      ;;
    uniapp/package.json|uniapp/package-lock.json)
      mark uniapp create_app
      ;;
    packages/*)
      mark web platform pc uniapp create_app integration
      ;;
    server/generated/*|web/src/generated/*|web/src/modules/*/generated/openapi.ts|scripts/generate-api-contracts.php|scripts/check-openapi)
      mark server web platform pc uniapp api docs integration
      ;;
    server/app/api/metadata/*|server/app/modules/*/*/api/metadata/*|server/route/*|server/config/admin_api_access.php)
      mark server web platform pc uniapp api docs integration
      ;;
    server/tests/Modules/Official/Integration/IntegrationSecurityMysqlTest.php|server/tests/Modules/Official/Notification/mysql-harness.php|server/tests/Multitenancy/MemberSessionTenantIsolationTest.php|server/tests/Support/RegisteredMysqlTestResource.php|scripts/tests/run-registered-mysql-tests|resources/project-resources.json|scripts/project-resource-registry|scripts/project-resource-lease)
      mark server integration
      ;;
    server/tests/*|server/app/*|server/config/*|server/database/*|server/bootstrap/*|server/public/*|server/think|scripts/run-php-test|scripts/check-admin-api-permissions.php|scripts/check-test-integrity|scripts/check-thinkphp-architecture)
      mark server
      ;;
    plugins/*|plugins.lock)
      mark server web create_app integration
      ;;
    web/src/modules/*|web/src/*|web/tests/*|web/vite.config.*|web/tsconfig.json)
      mark web
      [[ "$path" == web/src/modules/* ]] && mark create_app integration
      ;;
    platform/src/*|platform/tests/*|platform/vite.config.*|platform/tsconfig.json)
      mark platform
      ;;
    pc/*)
      mark pc
      ;;
    uniapp/*)
      mark uniapp
      ;;
    scaffold/*|scripts/create-app|scripts/build-application-template-inventory|scripts/build-scaffold-release)
      mark server web platform pc uniapp create_app docs integration
      ;;
    scripts/build-edition-installers|scripts/build-edition-upgrades|scripts/consumer-module-reference-chain|scripts/consumer-upgrade-qualification|scripts/combined-upgrade-qualification|scripts/scaffold-upgrade|scripts/scaffold-runtime/*|scripts/package-release.sh)
      mark server web platform pc uniapp create_app docs integration
      ;;
    deploy/*|compose.yaml|.dockerignore|.env.example|server/.env.example|web/.env.*|platform/.env.*|pc/.env.*|uniapp/.env.*)
      mark server web platform pc uniapp create_app integration docs
      ;;
    .githooks/*|.github/pull_request_template.md|AGENTS.md|.gitignore|.gitattributes|.vscode/*)
      mark docs
      ;;
    resources/*|scripts/*)
      select_all
      conservative='true'
      reason="unclassified shared tool or resource: ${path}"
      ;;
    *)
      select_all
      conservative='true'
      reason="unclassified path: ${path}"
      ;;
  esac
}

if [[ "$force_all" -eq 0 && "$baseline" != 'fallback-full' ]]; then
  for path in "${paths[@]}"; do
    classify "$path"
  done
fi

emit() {
  local line="$1"
  printf '%s\n' "$line"
  if [[ -n "$output_file" ]]; then
    printf '%s\n' "$line" >>"$output_file"
  fi
}

for group in "${groups[@]}"; do
  case "$group" in
    server) value="$server" ;;
    web) value="$web" ;;
    platform) value="$platform" ;;
    pc) value="$pc" ;;
    uniapp) value="$uniapp" ;;
    create_app) value="$create_app" ;;
    integration) value="$integration" ;;
    api) value="$api" ;;
    docs) value="$docs" ;;
  esac
  emit "${group}=${value}"
done
emit "conservative=${conservative}"
emit "baseline=${baseline}"
emit "changed_count=${#paths[@]}"
emit "reason=${reason//$'\n'/ }"
