#!/bin/sh

set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
state_dir="$repo_dir/.local"
env_file="$state_dir/stack.env"
backend_env="$repo_dir/server/.env"
pid_file="$state_dir/php-runtime.pid"
log_file="$state_dir/php-runtime.log"
log_lines=100
php_bin=/opt/homebrew/bin/php
composer_bin="$repo_dir/scripts/project-composer"
expected_php_version=8.3.24
expected_composer_version=2.10.2
resource_registry="$repo_dir/scripts/project-resource-registry"

die() {
    printf 'local-php-runtime: %s\n' "$*" >&2
    exit 1
}

read_env() {
    name=$1
    awk -F= -v name="$name" '$1 == name { sub(/^[^=]*=/, ""); print; exit }' "$env_file"
}

runtime_pid() {
    [ -f "$pid_file" ] || return 1
    pid=$(cat "$pid_file" 2>/dev/null || true)
    case "$pid" in
        ''|*[!0-9]*) return 1 ;;
    esac
    printf '%s\n' "$pid"
}

is_running() {
    pid=$(runtime_pid) || return 1
    kill -0 "$pid" 2>/dev/null
}

is_owned_process() {
    is_running || return 1
    port=$(read_env PHP_PORT)
    command_line=$(ps -p "$(runtime_pid)" -o command= 2>/dev/null || true)
    case "$command_line" in
        *"$php_bin"*"-S 0.0.0.0:$port"*"$repo_dir/server/public/router.php"*) return 0 ;;
        *) return 1 ;;
    esac
}

health_check() {
    port=$(read_env PHP_PORT)
    [ -n "$port" ] || return 1
    "$php_bin" -r '$s=@fsockopen("127.0.0.1", (int)$argv[1], $e, $m, 1); if (!$s) exit(1); fclose($s);' "$port"
}

show_failure() {
    printf 'PHP runtime is not healthy. Log: %s\n' "$log_file" >&2
    [ -f "$log_file" ] && tail -n 30 "$log_file" >&2 || true
}

start_runtime() {
    [ -x "$php_bin" ] || die "registered PHP is unavailable: $php_bin"
    [ -x "$composer_bin" ] || die "registered Composer is unavailable: $composer_bin"
    [ -f "$env_file" ] || die "local environment is missing: $env_file"
    [ -f "$backend_env" ] || die "backend environment is missing: $backend_env"
    if grep -Eq '^(PHP_(ENV_NAME|APP_|DB_|JWT_|DEPLOYMENT_MODE|PUBLIC_DEFAULT|PLATFORM_|TENANT_|ADMIN_|OWNER_|PEANUT_)|APP_|DB_|JWT_|DEPLOYMENT_MODE=|PUBLIC_DEFAULT_TENANT_FALLBACK=|PLATFORM_(HOSTS|IDENTIFIER_HMAC_KEY|INITIAL_EMAIL|INITIAL_PASSWORD)=|TENANT_|ADMIN_|OWNER_INVITATION_|PEANUT_(DEPLOYMENT_TARGET|DATABASE_|RESOURCE_LEASE_PROOF|STORAGE_|DEMO_|MODULE_))' "$env_file"; then
        die "orchestration environment contains backend configuration: $env_file"
    fi
    actual_php_version=$("$php_bin" -r 'echo PHP_VERSION;')
    [ "$actual_php_version" = "$expected_php_version" ] ||
        die "registered PHP version mismatch: expected $expected_php_version, got $actual_php_version"
    composer_identity=$("$composer_bin" --version 2>&1)
    case "$composer_identity" in
        "Composer version $expected_composer_version "*"PHP version $expected_php_version "*) ;;
        *) die "registered Composer identity mismatch: expected Composer $expected_composer_version on PHP $expected_php_version" ;;
    esac
    "$resource_registry" validate >/dev/null

    if is_running; then
        if is_owned_process; then
            if health_check; then
                printf 'PHP runtime already healthy (pid=%s, log=%s)\n' "$(runtime_pid)" "$log_file"
                return 0
            fi
            show_failure
            die "tracked process $(runtime_pid) is running but port health failed"
        fi
        health_check && die "pid file points to an unowned process while the registered port is occupied: $(runtime_pid)"
        stale_pid=$(runtime_pid)
        rm -f "$pid_file"
        printf 'Removed reused stale PHP pid file (pid=%s). Previous log: %s\n' "$stale_pid" "$log_file" >&2
    fi
    if [ -f "$pid_file" ]; then
        stale_pid=$(cat "$pid_file" 2>/dev/null || printf unknown)
        rm -f "$pid_file"
        printf 'Removed stale PHP pid file (pid=%s). Previous log: %s\n' "$stale_pid" "$log_file" >&2
    fi

    if [ ! -f "$repo_dir/server/vendor/autoload.php" ]; then
        printf 'Installing locked PHP dependencies with %s\n' "$composer_bin"
        (cd "$repo_dir/server" && "$composer_bin" install --no-interaction --prefer-dist)
    fi

    port=$(read_env PHP_PORT)
    [ -n "$port" ] || die 'PHP_PORT is missing from the local environment'
    : > "$log_file"
    (
        cd "$repo_dir/server"
        PEANUT_SERVER_ENV_FILE="$backend_env" \
        HTTP_PROXY= HTTPS_PROXY= ALL_PROXY= http_proxy= https_proxy= all_proxy= \
        NO_PROXY="127.0.0.1,localhost,192.168.192.2" \
        no_proxy="127.0.0.1,localhost,192.168.192.2" \
        nohup "$php_bin" \
            -d upload_max_filesize=200M \
            -d post_max_size=210M \
            -d max_file_uploads=20 \
            -S "0.0.0.0:$port" \
            -t "$repo_dir/server/public" \
            "$repo_dir/server/public/router.php" \
            >> "$log_file" 2>&1 </dev/null &
        printf '%s\n' "$!" > "$pid_file"
    )
    pid=$(runtime_pid) || die 'PHP runtime pid was not recorded'

    attempt=0
    while [ "$attempt" -lt 30 ]; do
        if ! kill -0 "$pid" 2>/dev/null; then
            rm -f "$pid_file"
            show_failure
            die "PHP runtime exited during startup (pid=$pid)"
        fi
        if health_check; then
            printf 'PHP runtime healthy (pid=%s, port=%s, log=%s)\n' "$pid" "$port" "$log_file"
            return 0
        fi
        attempt=$((attempt + 1))
        sleep 1
    done

    kill "$pid" 2>/dev/null || true
    wait "$pid" 2>/dev/null || true
    rm -f "$pid_file"
    show_failure
    die "PHP runtime did not become healthy on port $port"
}

stop_runtime() {
    if ! is_running; then
        if [ -f "$pid_file" ]; then
            stale_pid=$(cat "$pid_file" 2>/dev/null || printf unknown)
            rm -f "$pid_file"
            printf 'Removed stale PHP pid file (pid=%s). Log retained: %s\n' "$stale_pid" "$log_file"
        else
            printf 'PHP runtime already stopped.\n'
        fi
        return 0
    fi

    pid=$(runtime_pid)
    is_owned_process || die "refusing to stop unowned process: $pid"
    kill "$pid"
    attempt=0
    while kill -0 "$pid" 2>/dev/null && [ "$attempt" -lt 20 ]; do
        attempt=$((attempt + 1))
        sleep 1
    done
    if kill -0 "$pid" 2>/dev/null; then
        kill -KILL "$pid"
    fi
    wait "$pid" 2>/dev/null || true
    rm -f "$pid_file"
    printf 'PHP runtime stopped (pid=%s). Log retained: %s\n' "$pid" "$log_file"
}

status_runtime() {
    if ! is_running; then
        if [ -f "$pid_file" ]; then
            show_failure
            die "tracked PHP process $(cat "$pid_file" 2>/dev/null || printf unknown) has crashed"
        fi
        die 'PHP runtime is stopped'
    fi
    is_owned_process || die "pid file points to an unowned process: $(runtime_pid)"
    health_check || { show_failure; die "PHP runtime process $(runtime_pid) is alive but unhealthy"; }
    printf 'PHP runtime healthy (pid=%s, port=%s, log=%s)\n' "$(runtime_pid)" "$(read_env PHP_PORT)" "$log_file"
}

command=${1:-}
[ $# -gt 0 ] && shift
while [ $# -gt 0 ]; do
    case "$1" in
        --env-file) [ $# -ge 2 ] || die '--env-file requires a value'; env_file=$2; shift 2 ;;
        --backend-env) [ $# -ge 2 ] || die '--backend-env requires a value'; backend_env=$2; shift 2 ;;
        --pid-file) [ $# -ge 2 ] || die '--pid-file requires a value'; pid_file=$2; shift 2 ;;
        --log-file) [ $# -ge 2 ] || die '--log-file requires a value'; log_file=$2; shift 2 ;;
        --log-lines) [ $# -ge 2 ] || die '--log-lines requires a value'; log_lines=$2; shift 2 ;;
        *) die "unsupported argument: $1" ;;
    esac
done
case "$log_lines" in ''|*[!0-9]*) die '--log-lines must be a positive integer' ;; esac

case "$command" in
    start) start_runtime ;;
    stop) stop_runtime ;;
    restart) stop_runtime; start_runtime ;;
    status) status_runtime ;;
    logs) [ -f "$log_file" ] || die "log does not exist: $log_file"; tail -n "$log_lines" "$log_file" ;;
    *) printf 'Usage: %s {start|stop|restart|status|logs} [--env-file path] [--backend-env path] [--pid-file path] [--log-file path] [--log-lines n]\n' "$0" >&2; exit 2 ;;
esac
