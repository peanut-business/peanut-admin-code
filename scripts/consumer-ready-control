#!/usr/bin/env python3
"""Read-only preflight controller for Peanut Admin consumer-ready delivery."""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import subprocess
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parent.parent
POLICY_PATH = ROOT / "resources/consumer-ready-control.json"
SEMVER = re.compile(r"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$")
COMMIT = re.compile(r"^[0-9a-f]{40}$")
CORE_WEB_PACKAGES = [
    "@peanut-admin/client", "@peanut-admin/vue", "@peanut-admin/ui-vue",
    "@peanut-admin/nuxt", "@peanut-admin/uniapp", "@peanut-admin/testing",
]


class ControlError(RuntimeError):
    pass


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exception:
        raise ControlError(f"cannot read JSON authority {path.relative_to(ROOT)}: {exception}") from exception
    if not isinstance(value, dict):
        raise ControlError(f"JSON authority root must be an object: {path.relative_to(ROOT)}")
    return value


def run(arguments: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        arguments,
        cwd=ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )


def git(*arguments: str) -> str:
    result = run(["git", *arguments])
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        raise ControlError(f"git {' '.join(arguments)} failed: {detail}")
    return result.stdout.strip()


def sha256_text(value: str) -> str:
    return hashlib.sha256(value.encode()).hexdigest()


def current_version_contract(versions: dict[str, Any], target_version: str) -> bool:
    if (
        versions.get("schema_version") != 3
        or versions.get("protocol") != "peanut.release-versions.v3"
        or versions.get("source_product_version") != target_version
        or versions.get("instance_version") is not None
        or versions.get("scaffold_template") != target_version
        or SEMVER.fullmatch(target_version) is None
    ):
        return False
    php = versions.get("core_php")
    web = versions.get("core_web")
    if (
        not isinstance(php, dict)
        or list(php) != ["package", "constraint", "resolved_version", "source_type", "source_url", "source_reference"]
        or php.get("package") != "peanut-admin/core"
        or re.fullmatch(r"dev-[A-Za-z0-9._-]+#[0-9a-f]{40}", str(php.get("constraint", ""))) is None
        or not str(php.get("resolved_version", "")).startswith("dev-")
        or php.get("source_type") != "git"
        or not str(php.get("source_url", "")).startswith("https://")
        or COMMIT.fullmatch(str(php.get("source_reference", ""))) is None
        or not str(php.get("constraint", "")).endswith("#" + str(php.get("source_reference", "")))
        or not isinstance(web, dict)
        or list(web) != ["source_type", "source_url", "source_reference", "packages"]
        or web.get("source_type") != "git"
        or not str(web.get("source_url", "")).startswith("https://")
        or COMMIT.fullmatch(str(web.get("source_reference", ""))) is None
    ):
        return False
    packages = web.get("packages")
    if not isinstance(packages, dict) or list(packages) != CORE_WEB_PACKAGES:
        return False
    for identity in packages.values():
        if not isinstance(identity, dict) or list(identity) != ["version", "archive", "sha256"]:
            return False
        archive = identity.get("archive")
        digest = identity.get("sha256")
        if (
            not isinstance(identity.get("version"), str)
            or SEMVER.fullmatch(identity["version"]) is None
            or not isinstance(archive, str)
            or re.fullmatch(r"packages/core-web/peanut-admin-[a-z-]+-[0-9A-Za-z.+-]+\.tgz", archive) is None
            or not isinstance(digest, str)
            or re.fullmatch(r"[0-9a-f]{64}", digest) is None
        ):
            return False
        path = ROOT / archive
        if not path.is_file() or path.is_symlink() or hashlib.sha256(path.read_bytes()).hexdigest() != digest:
            return False
    return True


def semantic_core(version: str) -> tuple[int, int, int]:
    match = re.match(r"^(\d+)\.(\d+)\.(\d+)", version)
    return tuple(int(part) for part in match.groups()) if match else ()


class Report:
    def __init__(self, phase: str) -> None:
        self.phase = phase
        self.checks: list[dict[str, Any]] = []
        self.failures: list[dict[str, str]] = []
        self.warnings: list[dict[str, str]] = []
        self.derived: dict[str, Any] = {}

    def check(self, code: str, passed: bool, detail: str, remediation: str) -> None:
        self.checks.append({"code": code, "status": "passed" if passed else "failed", "detail": detail})
        if not passed:
            self.failures.append({"code": code, "detail": detail, "remediation": remediation})

    def warn(self, code: str, detail: str) -> None:
        self.warnings.append({"code": code, "detail": detail})

    def command_check(self, code: str, arguments: list[str], remediation: str) -> None:
        result = run(arguments)
        lines = (result.stdout or result.stderr).strip().splitlines()
        summary = lines[-1] if lines else f"exit={result.returncode}"
        self.check(code, result.returncode == 0, summary, remediation)

    def output(self, target_version: str, candidate: str, candidate_tree: str, mode: str) -> int:
        status = "ready" if not self.failures else "blocked"
        print(json.dumps({
            "schema_version": 1,
            "protocol": "peanut.consumer-ready-preflight.v1",
            "status": status,
            "mode": mode,
            "phase": self.phase,
            "target_version": target_version,
            "candidate": candidate,
            "candidate_tree": candidate_tree,
            "checks": self.checks,
            "failures": self.failures,
            "warnings": self.warnings,
            "derived": self.derived,
        }, ensure_ascii=False, indent=2, sort_keys=True))
        return 0 if status == "ready" else 1


def policy_path(policy: dict[str, Any], section: str, name: str) -> Path:
    relative = policy.get(section, {}).get(name)
    if not isinstance(relative, str) or not relative or Path(relative).is_absolute():
        raise ControlError(f"policy {section} entry is invalid: {name}")
    return ROOT / relative


def maximum_run_id_length(pattern: str) -> int:
    match = re.fullmatch(r"\^\[a-z0-9\]\{1,(\d+)\}\$", pattern)
    if match is None:
        raise ControlError(f"unsupported P0-E run_id_pattern: {pattern}")
    return int(match.group(1))


def validate_output_path(report: Report, label: str, path: Path, run_id: str) -> None:
    code = label.upper().replace("-", "_")
    safe = path.is_absolute() and path != Path("/") and run_id in path.name and not path.is_symlink()
    report.check(f"{code}_PATH_SAFE", safe, str(path),
                 f"use an absolute, non-root {label} whose basename contains the exact run ID")
    if safe:
        report.check(f"{code}_PATH_ABSENT", not path.exists(), f"exists={path.exists()} path={path}",
                     f"choose an absent {label}; do not reuse another candidate output")


def qualification_output_exclusion(
    phase: str,
    qualification_path: Path | None,
    candidate: str,
    candidate_tree: str,
) -> Path | None:
    if phase != "release" or qualification_path is None or not qualification_path.is_absolute():
        return None
    try:
        resolved = qualification_path.resolve(strict=True)
        payload = json.loads(resolved.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    if resolved != qualification_path or not isinstance(payload, dict):
        return None
    run_id = payload.get("run_id")
    if not isinstance(run_id, str) or re.fullmatch(r"[a-z0-9]{1,11}", run_id) is None:
        return None
    expected = ROOT / "output" / f"p0e-{run_id}" / "summary.json"
    if (
        resolved != expected
        or payload.get("status") != "passed"
        or payload.get("candidate") != candidate
        or payload.get("candidate_tree") != candidate_tree
    ):
        return None
    return expected.parent.relative_to(ROOT)


def remote_version_check(report: Report, policy: dict[str, Any], tag: str) -> None:
    remote = policy.get("remote", {}).get("name")
    repository = policy.get("remote", {}).get("repository")
    if not isinstance(remote, str) or not isinstance(repository, str):
        raise ControlError("remote policy is invalid")
    tags = run(["git", "ls-remote", "--tags", remote, f"refs/tags/{tag}", f"refs/tags/{tag}^{{}}"])
    report.check("REMOTE_TAG_AVAILABLE", tags.returncode == 0 and tags.stdout.strip() == "",
                 (tags.stderr or tags.stdout or f"{tag} is absent").strip(),
                 "select an unused version or repair remote access before sealing")
    release = run(["gh", "release", "view", tag, "--repo", repository, "--json", "tagName"])
    missing = "release not found" in release.stderr.lower() or "http 404" in release.stderr.lower()
    report.check("REMOTE_RELEASE_AVAILABLE", release.returncode != 0 and missing,
                 (release.stdout or release.stderr).strip(),
                 "select an unused version; if this is not a 404, repair GitHub access before sealing")


def preflight(args: argparse.Namespace) -> int:
    policy = read_json(POLICY_PATH)
    if (
        policy.get("schema_version") != 1
        or policy.get("protocol") != "peanut.consumer-ready-control.v1"
        or policy.get("project_id") != "peanut-admin"
        or policy.get("mode") != "minimal-read-only-preflight"
        or args.phase not in policy.get("phases", [])
    ):
        raise ControlError("unsupported or foreign controller policy")

    versions = read_json(policy_path(policy, "authorities", "version_contract"))
    metadata = read_json(policy_path(policy, "authorities", "release_metadata"))
    inventory = read_json(policy_path(policy, "authorities", "application_inventory"))
    fixture = read_json(policy_path(policy, "authorities", "qualification_fixture"))
    resources = read_json(policy_path(policy, "authorities", "project_resources"))
    p0e_resources = read_json(policy_path(policy, "authorities", "p0e_resources"))

    metadata_v2 = (
        metadata.get("schema_version") == 2
        and metadata.get("protocol") == "peanut.release-metadata.v2"
    )
    metadata_source_version = metadata.get("source_product_version") if metadata_v2 else None
    metadata_instance_version = metadata.get("instance_version") if metadata_v2 else None
    metadata_release_version = (
        metadata_instance_version or metadata_source_version or ""
        if metadata_v2
        else metadata.get("version")
    )

    target_version = args.target_version or str(versions.get("source_product_version", ""))
    candidate = git("rev-parse", f"{args.candidate}^{{commit}}")
    candidate_tree = git("rev-parse", f"{candidate}^{{tree}}")
    head = git("rev-parse", "HEAD^{commit}")
    report = Report(args.phase)
    report.derived.update({"head": head, "tag": f"v{target_version}"})

    report.check("TARGET_VERSION_VALID", SEMVER.fullmatch(target_version) is not None, target_version,
                 "use a valid SemVer version")
    report.check("CANDIDATE_EXACT", COMMIT.fullmatch(candidate) is not None, candidate,
                 "resolve the candidate through Git instead of typing or abbreviating a SHA")
    report.check("CANDIDATE_IS_HEAD", candidate == head, f"candidate={candidate} head={head}",
                 "check out the exact candidate before preflight")
    status_arguments = ["status", "--porcelain=v1", "--untracked-files=all"]
    evidence_output = qualification_output_exclusion(
        args.phase,
        args.qualification,
        candidate,
        candidate_tree,
    )
    if evidence_output is not None:
        status_arguments.extend(["--", ".", f":(exclude){evidence_output.as_posix()}/**"])
    worktree_status = git(*status_arguments)
    report.check("WORKTREE_CLEAN", worktree_status == "", worktree_status or "clean",
                 "commit or remove candidate changes before freeze or qualification")

    version_values = {
        "schema_version": versions.get("schema_version"),
        "protocol": versions.get("protocol"),
        "source_product_version": versions.get("source_product_version"),
        "instance_version": versions.get("instance_version"),
        "scaffold_template": versions.get("scaffold_template"),
        "generated_instance_default": versions.get("generated_instance_default"),
        "core_php": versions.get("core_php"),
        "core_web": versions.get("core_web"),
        "metadata_schema_version": metadata.get("schema_version"),
        "metadata_protocol": metadata.get("protocol"),
        "metadata_source_product_version": metadata_source_version,
        "metadata_instance_version": metadata_instance_version,
        "metadata_release_version": metadata_release_version,
        "metadata_tag": metadata.get("expected_tag"),
        "inventory_template": inventory.get("template_version"),
        "fixture_version": fixture.get("target_release", {}).get("version"),
    }
    expected_values = {
        "schema_version": versions.get("schema_version"),
        "protocol": versions.get("protocol"),
        "source_product_version": target_version,
        "instance_version": None,
        "scaffold_template": target_version,
        "generated_instance_default": inventory.get("application", {}).get("version"),
        "core_php": versions.get("core_php"),
        "core_web": versions.get("core_web"),
        "metadata_schema_version": 2,
        "metadata_protocol": "peanut.release-metadata.v2",
        "metadata_source_product_version": target_version,
        "metadata_instance_version": None,
        "metadata_release_version": target_version,
        "metadata_tag": f"v{target_version}",
        "inventory_template": target_version,
        "fixture_version": target_version,
    }
    if args.phase == "prepare":
        baseline_version = metadata_source_version if isinstance(metadata_source_version, str) else ""
        target_parts = semantic_core(target_version) if SEMVER.fullmatch(target_version) else ()
        baseline_parts = semantic_core(baseline_version) if SEMVER.fullmatch(baseline_version) else ()
        historical_v2 = (
            versions.get("schema_version") == 2
            and versions.get("protocol") == "peanut.release-versions.v2"
            and versions.get("source_product_version") == target_version
            and versions.get("instance_version") is None
            and versions.get("scaffold_template") == target_version
            and versions.get("core_php") == target_version
            and versions.get("core_web") == target_version
        )
        development_identity_valid = (
            (historical_v2 or current_version_contract(versions, target_version))
            and metadata_v2
            and metadata_instance_version is None
            and bool(baseline_parts)
            and bool(target_parts)
            and baseline_parts <= target_parts
            and metadata.get("expected_tag") == f"v{baseline_version}"
        )
        report.check("DEVELOPMENT_VERSION_CONTRACT_VALID", development_identity_valid,
                     json.dumps(version_values, sort_keys=True),
                     "repair the target version contract or the internally inconsistent published baseline")
        if version_values != expected_values:
            report.warn("RELEASE_IDENTITY_CLOSURE_PENDING",
                        "published metadata, inventory, scaffold fixture or Core locks may remain on the previous release until seal")
    else:
        report.check("VERSION_IDENTITY_ALIGNED",
                     (current_version_contract(versions, target_version)
                      or (versions.get("schema_version") == 2
                          and versions.get("protocol") == "peanut.release-versions.v2"
                          and versions.get("core_php") == target_version
                          and versions.get("core_web") == target_version))
                     and version_values == expected_values,
                     json.dumps(version_values, sort_keys=True),
                     "align release-versions, metadata, inventory and P0-E fixture before sealing")
    changelog = (ROOT / "CHANGELOG.md").read_text(encoding="utf-8")
    if args.phase == "prepare" and f"## [{target_version}]" not in changelog:
        report.warn("CHANGELOG_TARGET_PENDING", f"section=## [{target_version}]")
    else:
        report.check("CHANGELOG_NAMES_TARGET", f"## [{target_version}]" in changelog,
                     f"section=## [{target_version}]", "add the target release section before sealing")

    local_tag = run(["git", "show-ref", "--verify", "--quiet", f"refs/tags/v{target_version}"])
    report.check("LOCAL_TAG_AVAILABLE", local_tag.returncode != 0, f"tag=v{target_version}",
                 "select an unused version; never move or overwrite a release tag")
    if args.check_remote:
        remote_version_check(report, policy, f"v{target_version}")
    elif args.phase in {"seal", "qualify", "release"}:
        report.check("REMOTE_VERSION_CHECKED", False, "--check-remote was not provided",
                     "rerun the preflight with --check-remote before sealing or qualification")
    else:
        report.warn("REMOTE_VERSION_NOT_CHECKED", "prepare phase used local identities only")

    database_id = policy.get("p0e", {}).get("database_resource_id")
    databases = resources.get("resources", {}).get("databases", [])
    matches = [item for item in databases if isinstance(item, dict) and item.get("stable_resource_id") == database_id]
    if len(matches) != 1:
        raise ControlError(f"expected exactly one P0-E database resource {database_id}")
    database = matches[0]
    scenarios = list(fixture.get("scenarios", {}).keys())
    allowed = database.get("allowed_scenarios", [])
    report.check("P0E_SCENARIOS_REGISTERED", scenarios == allowed,
                 f"fixture={scenarios} registry={allowed}",
                 "make fixture scenarios and the resource whitelist identical")
    max_run = maximum_run_id_length(str(database.get("run_id_pattern", "")))
    template = str(database.get("database", ""))
    max_name = int(database.get("database_name_max_length", 0))
    generated_names = [template.replace("<run_id>", "x" * max_run).replace("<scenario>", scenario)
                       for scenario in scenarios]
    oversized = [name for name in generated_names if len(name) > max_name]
    report.check("P0E_DATABASE_NAMES_FIT", not oversized,
                 json.dumps({name: len(name) for name in generated_names}, sort_keys=True),
                 "shorten the physical scenario suffix before changing or running the Gate")
    report.check("P0E_ADMIN_BINDING_MATCHES",
                 p0e_resources.get("database_administration_binding", {}).get("database_resource_id") == database_id,
                 f"database_resource_id={database_id}",
                 "repair the source-only P0-E administration binding before resource claim")

    lease_tool = policy_path(policy, "commands", "resource_lease")
    leases = run([str(lease_tool), "list"])
    lease_lines = [line for line in leases.stdout.splitlines() if line.strip()]
    report.check("RESOURCE_LEASE_REGISTRY_READABLE", leases.returncode == 0,
                 leases.stdout.strip() or leases.stderr.strip(),
                 "repair the shared project lease registry before any resource claim")
    conflicting_leases: list[str] = []
    if leases.returncode == 0:
        for line in lease_lines[1:]:
            lease_id = line.split("\t", 1)[0]
            shown = run([str(lease_tool), "show", "--lease", lease_id])
            if shown.returncode == 0 and database_id in shown.stdout:
                conflicting_leases.append(lease_id)
    if conflicting_leases and args.phase in {"qualify", "release"}:
        report.check("P0E_RESOURCE_LEASE_CLEAR", False, json.dumps(conflicting_leases),
                     "wait for, release or explicitly transfer the lease that owns the registered P0-E database resource")
    elif conflicting_leases:
        report.warn("P0E_RESOURCE_LEASE_ACTIVE", json.dumps(conflicting_leases))
    else:
        report.check("P0E_RESOURCE_LEASE_CLEAR", True, "no active lease owns the P0-E database resource", "")
    report.command_check("RESOURCE_REGISTRY_VALID",
                         [str(policy_path(policy, "commands", "resource_registry")), "validate"],
                         "repair the versioned project resource registry")

    scaffold_dir = ROOT / "scaffold/releases" / f"v{target_version}"
    if args.phase in {"seal", "qualify", "release"}:
        manifest_path = scaffold_dir / "scaffold-manifest.json"
        try:
            manifest_text = manifest_path.read_text(encoding="utf-8")
            manifest = json.loads(manifest_text)
        except (OSError, json.JSONDecodeError) as exception:
            report.check("SCAFFOLD_MANIFEST_AVAILABLE", False, str(exception),
                         "seal the target scaffold once from the functional freeze commit")
            manifest = {}
            manifest_text = ""
        else:
            report.check("SCAFFOLD_MANIFEST_AVAILABLE", True, str(manifest_path.relative_to(ROOT)), "")
        release = manifest.get("release", {}) if isinstance(manifest, dict) else {}
        target = fixture.get("target_release", {})
        fixture_expected = {
            "version": release.get("version"),
            "source_commit": release.get("source_commit"),
            "source_tree": release.get("source_tree"),
            "manifest_sha256": sha256_text(manifest_text),
            "inventory_sha256": release.get("inventory_sha256"),
            "managed_tree_sha256": release.get("managed_tree_sha256"),
            "file_count": len(manifest.get("files", [])) if isinstance(manifest.get("files"), list) else None,
        }
        actual_fixture = {key: target.get(key) for key in fixture_expected}
        report.check("SCAFFOLD_FIXTURE_ALIGNED", fixture_expected == actual_fixture,
                     json.dumps({"expected": fixture_expected, "actual": actual_fixture}, sort_keys=True),
                     "regenerate only the target fixture identity from the sealed manifest")
        source_commit = str(release.get("source_commit", ""))
        source_tree = str(release.get("source_tree", ""))
        source_valid = COMMIT.fullmatch(source_commit) is not None and COMMIT.fullmatch(source_tree) is not None
        if source_valid:
            resolved_tree = run(["git", "rev-parse", f"{source_commit}^{{tree}}"])
            source_valid = resolved_tree.returncode == 0 and resolved_tree.stdout.strip() == source_tree
        report.check("SCAFFOLD_SOURCE_IDENTITY_VALID", source_valid,
                     f"commit={source_commit} tree={source_tree}",
                     "seal from one exact tracked functional-freeze commit and tree")
        report.command_check("APPLICATION_INVENTORY_CURRENT",
                             ["php", str(policy_path(policy, "commands", "inventory_builder")), "--check"],
                             "regenerate the application inventory before sealing")
        if source_valid:
            report.command_check(
                "SCAFFOLD_RELEASE_CURRENT",
                ["php", str(policy_path(policy, "commands", "scaffold_builder")),
                 f"--version={target_version}", f"--source-commit={source_commit}",
                 f"--output={scaffold_dir}", "--check"],
                "invalidate this candidate and seal a new version if the scaffold is stale",
            )

        consistency = [str(policy_path(policy, "commands", "release_consistency")), "--candidate", candidate]
        if args.phase in {"qualify", "release"}:
            consistency.append("--require-main")
        if args.phase == "release":
            if args.qualification is None:
                report.check("QUALIFICATION_PROVIDED", False, "missing --qualification",
                             "provide the absolute passed summary from the exact main candidate")
            else:
                consistency.extend(["--qualification", str(args.qualification)])
        report.command_check("RELEASE_IDENTITY_CONSISTENT", consistency,
                             "repair all reported identities before entering the next phase")

    if args.phase == "qualify":
        report.command_check("P0E_BROWSER_TOOLING_READY",
                             [str(policy_path(policy, "commands", "browser_tooling")), "check"],
                             "install the exact registered P0-E browser CLI before resource claim")
        run_pattern = re.compile(str(database.get("run_id_pattern", "")))
        run_id = args.run_id or ""
        report.check("RUN_ID_VALID", run_pattern.fullmatch(run_id) is not None, run_id or "missing",
                     "choose a unique run ID that matches the registered P0-E policy")
        if run_pattern.fullmatch(run_id) is not None:
            output_dir = args.output_dir or ROOT / "output" / f"p0e-{run_id}"
            cache_dir = args.cache_dir or Path.home() / ".cache/peanut-admin" / f"p0e-{run_id}"
            validate_output_path(report, "output-dir", output_dir, run_id)
            validate_output_path(report, "cache-dir", cache_dir, run_id)
            actual_names = [template.replace("<run_id>", run_id).replace("<scenario>", scenario)
                            for scenario in scenarios]
            report.check("RUN_DATABASE_NAMES_FIT", all(len(name) <= max_name for name in actual_names),
                         json.dumps(actual_names),
                         "choose a valid run ID or shorten a registered physical scenario suffix")
            report.derived.update({"run_id": run_id, "output_dir": str(output_dir),
                                   "cache_dir": str(cache_dir), "databases": actual_names})

    return report.output(target_version, candidate, candidate_tree, str(policy.get("mode")))


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    preflight_parser = subparsers.add_parser("preflight", help="run the no-resource preparation checks")
    preflight_parser.add_argument("--phase", choices=("prepare", "seal", "qualify", "release"), required=True)
    preflight_parser.add_argument("--target-version")
    preflight_parser.add_argument("--candidate", default="HEAD")
    preflight_parser.add_argument("--check-remote", action="store_true")
    preflight_parser.add_argument("--run-id")
    preflight_parser.add_argument("--output-dir", type=Path)
    preflight_parser.add_argument("--cache-dir", type=Path)
    preflight_parser.add_argument("--qualification", type=Path)
    return parser.parse_args()


def main() -> int:
    try:
        args = parse_arguments()
        if args.command == "preflight":
            return preflight(args)
    except ControlError as exception:
        print(json.dumps({
            "schema_version": 1,
            "protocol": "peanut.consumer-ready-preflight.v1",
            "status": "error",
            "error": str(exception),
        }, ensure_ascii=False, indent=2, sort_keys=True))
        return 2
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
