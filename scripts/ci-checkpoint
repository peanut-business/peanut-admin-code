#!/usr/bin/env python3
"""Select validation cadence; never infer that a deferred draft was tested."""
import argparse
import json
import sys
from pathlib import Path


def select(event_name: str, payload: dict) -> str:
    if event_name == 'pull_request':
        pr = payload.get('pull_request')
        if not isinstance(pr, dict) or type(pr.get('draft')) is not bool:
            raise ValueError('pull_request.draft must be an explicit boolean')
        return 'deferred' if pr['draft'] else 'required'
    if event_name in ('push', 'workflow_dispatch'):
        return 'required'
    raise ValueError(f'unsupported checkpoint event: {event_name}')


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--event-name', required=True, choices=('pull_request', 'push', 'workflow_dispatch'))
    parser.add_argument('--event-file', required=True, type=Path)
    parser.add_argument('--github-output', type=Path)
    parser.add_argument('--github-summary', type=Path)
    args = parser.parse_args()
    payload = json.loads(args.event_file.read_text())
    if not isinstance(payload, dict):
        raise ValueError('event payload must be an object')
    decision = select(args.event_name, payload)
    output = f'validation={decision}\n'
    if args.github_output:
        with args.github_output.open('a') as handle:
            handle.write(output)
    sys.stdout.write(output)
    note = ('Draft checkpoint: integration tests/builds are deferred, NOT passed. '
            'Run focused tests locally at a coherent change boundary. '
            'Ready for review triggers affected CI; subsequent ready-PR pushes are rechecked.'
            if decision == 'deferred' else
            'Integration checkpoint: affected checks are required. Missing, failed or cancelled required jobs block the summary.')
    print(note)
    if args.github_summary:
        with args.github_summary.open('a') as handle:
            handle.write('## Validation checkpoint\n\n' + note + '\n')
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (ValueError, OSError) as error:
        print(f'ci-checkpoint: {error}', file=sys.stderr)
        raise SystemExit(2)
