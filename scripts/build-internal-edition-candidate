#!/usr/bin/env php
<?php

declare(strict_types=1);

use app\common\infrastructure\scaffold\ApplicationCreator;
use app\common\infrastructure\scaffold\DeterministicEditionArchive;
use app\common\infrastructure\scaffold\ReleaseDependencyIdentity;
use app\common\value\scaffold\VersionContract;

function internalCandidateUsage(): never
{
    fwrite(STDERR, "Usage: php scripts/build-internal-edition-candidate --source-commit=<full-sha> --edition=<standalone|multi-tenant> --profile=full --workflow=full --core-inputs=<absolute-release-core-inputs.json> --output=<absent-absolute-directory>\n");
    exit(64);
}

/** @param list<string> $command @param array<string,string> $environment */
function internalCandidateRun(array $command, ?string $cwd = null, array $environment = []): string
{
    $pipes = [];
    $mergedEnvironment = null;
    if ($environment !== []) {
        $baseEnvironment = $_ENV;
        foreach (['PATH', 'HOME', 'TMPDIR', 'SystemRoot', 'COMSPEC', 'PATHEXT'] as $name) {
            $value = getenv($name);
            if (is_string($value) && $value !== '') {
                $baseEnvironment[$name] = $value;
            }
        }
        $mergedEnvironment = array_replace($baseEnvironment, $environment);
    }
    $process = proc_open(
        $command,
        [1 => ['pipe', 'w'], 2 => ['redirect', 1]],
        $pipes,
        $cwd,
        $mergedEnvironment,
    );
    if (!is_resource($process)) {
        throw new RuntimeException('INTERNAL_CANDIDATE_PROCESS_FAILED');
    }
    $stdout = stream_get_contents($pipes[1]);
    fclose($pipes[1]);
    if (proc_close($process) !== 0 || !is_string($stdout)) {
        throw new RuntimeException('INTERNAL_CANDIDATE_COMMAND_FAILED: ' . implode(' ', $command) . ': ' . trim((string) $stdout));
    }
    return $stdout;
}

function internalCandidateDelete(string $path): void
{
    if (!file_exists($path) && !is_link($path)) {
        return;
    }
    if (is_dir($path) && !is_link($path)) {
        foreach (array_diff(scandir($path) ?: [], ['.', '..']) as $entry) {
            internalCandidateDelete($path . '/' . $entry);
        }
        rmdir($path);
        return;
    }
    unlink($path);
}

/** @param array<string,mixed> $data */
function internalCandidateWriteJson(string $path, array $data, int $mode = 0644): void
{
    $json = json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n";
    if ((!is_dir(dirname($path)) && !mkdir(dirname($path), 0775, true))
        || file_put_contents($path, $json) === false
        || !chmod($path, $mode)) {
        throw new RuntimeException('INTERNAL_CANDIDATE_WRITE_FAILED: ' . $path);
    }
}

function internalCandidateCopyFile(string $source, string $target, int $mode = 0644): void
{
    if (!is_file($source) || is_link($source)) {
        throw new RuntimeException('INTERNAL_CANDIDATE_INPUT_FILE_INVALID: ' . $source);
    }
    if (file_exists($target) || is_link($target)) {
        throw new RuntimeException('INTERNAL_CANDIDATE_OUTPUT_EXISTS: ' . $target);
    }
    if ((!is_dir(dirname($target)) && !mkdir(dirname($target), 0775, true))
        || !copy($source, $target)
        || !chmod($target, $mode)) {
        throw new RuntimeException('INTERNAL_CANDIDATE_COPY_FAILED: ' . $target);
    }
}

/** Reject aliases and links before reading inputs or creating output directories. */
function internalCandidatePath(string $path, bool $allowMissing = false, bool $regularFile = false): void
{
    if ($path === '' || $path[0] !== '/' || str_contains($path, '\\') || str_contains($path, "\0")) {
        throw new RuntimeException('INTERNAL_CANDIDATE_PATH_INVALID');
    }
    $current = '';
    $parts = explode('/', substr($path, 1));
    foreach ($parts as $index => $part) {
        if ($part === '' || $part === '.' || $part === '..') {
            throw new RuntimeException('INTERNAL_CANDIDATE_PATH_INVALID');
        }
        $current .= '/' . $part;
        clearstatcache(true, $current);
        if (is_link($current)) {
            throw new RuntimeException('INTERNAL_CANDIDATE_PATH_LINK_REJECTED');
        }
        if (!file_exists($current)) {
            if (!$allowMissing) {
                throw new RuntimeException('INTERNAL_CANDIDATE_PATH_MISSING');
            }
            continue;
        }
        if ($index < count($parts) - 1 && !is_dir($current)) {
            throw new RuntimeException('INTERNAL_CANDIDATE_PATH_PARENT_INVALID');
        }
    }
    if ($regularFile) {
        $stat = stat($path);
        if (!is_file($path) || !is_array($stat) || $stat['nlink'] !== 1) {
            throw new RuntimeException('INTERNAL_CANDIDATE_INPUT_FILE_INVALID');
        }
    }
}

/** @return array<string,mixed> */
function internalCandidateReadJson(string $path): array
{
    internalCandidatePath($path, false, true);
    $data = json_decode((string) file_get_contents($path), true, 512, JSON_THROW_ON_ERROR);
    if (!is_array($data)) {
        throw new RuntimeException('INTERNAL_CANDIDATE_JSON_INVALID: ' . $path);
    }
    return $data;
}

/** @return array<string,mixed> */
function internalCandidateCoreInputs(string $path): array
{
    $inputs = internalCandidateReadJson($path);
    $root = dirname($path);
    $archive = $inputs['core_php_archive'] ?? null;
    $core = $inputs['core_php'] ?? null;
    $repository = $inputs['composer_repository']['package'] ?? null;
    $local = ($core['source_type'] ?? null) === 'local';
    $identity = $core['source_identity'] ?? null;
    $web = $inputs['core_web'] ?? null;
    $webIdentity = is_array($web) ? ($web['source_identity'] ?? null) : null;
    $localIdentityValid = is_array($identity) && array_keys($identity) === ['kind', 'snapshot_sha256']
        && ($identity['kind'] ?? null) === 'local'
        && preg_match('/^[a-f0-9]{64}$/D', (string) ($identity['snapshot_sha256'] ?? '')) === 1
        && is_array($webIdentity) && array_keys($webIdentity) === ['kind', 'snapshot_sha256']
        && ($webIdentity['kind'] ?? null) === 'local'
        && preg_match('/^[a-f0-9]{64}$/D', (string) ($webIdentity['snapshot_sha256'] ?? '')) === 1
        && ($inputs['sources']['php'] ?? null) === $identity
        && ($inputs['sources']['web'] ?? null) === $webIdentity;
    if (!is_array($archive) || !is_array($core) || !is_array($repository)
        || ($inputs['status'] ?? null) !== 'frozen-core-build-inputs-not-product-release'
        || ($core['package'] ?? null) !== 'peanut-admin/core'
        || ($repository['name'] ?? null) !== 'peanut-admin/core') {
        throw new RuntimeException('INTERNAL_CANDIDATE_CORE_INPUTS_INVALID');
    }
    $relative = (string) ($archive['path'] ?? '');
    if ($relative === '' || str_starts_with($relative, '/') || str_contains($relative, '\\') || in_array('..', explode('/', $relative), true)) {
        throw new RuntimeException('INTERNAL_CANDIDATE_CORE_ARCHIVE_PATH_INVALID');
    }
    $zip = $root . '/' . $relative;
    internalCandidatePath($zip, false, true);
    if (!is_file($zip) || is_link($zip)) {
        throw new RuntimeException('INTERNAL_CANDIDATE_CORE_ARCHIVE_MISSING');
    }
    $sha256 = hash_file('sha256', $zip);
    $sha1 = hash_file('sha1', $zip);
    $originValid = $local
        ? ($localIdentityValid && ($repository['dist']['reference'] ?? null) === $identity['snapshot_sha256']
            && !isset($repository['source']) && ($core['source_identity'] ?? null) === $identity
            && ($web['source_type'] ?? null) === 'local' && ($web['source_identity'] ?? null) === $webIdentity)
        : (($core['source_type'] ?? null) === 'git'
            && ($repository['dist']['reference'] ?? null) === ($core['source_reference'] ?? null)
            && ($repository['source']['reference'] ?? null) === ($core['source_reference'] ?? null)
            && ($inputs['sources']['php']['commit'] ?? null) === ($core['source_reference'] ?? null)
            && ($web['source_type'] ?? null) === 'git'
            && ($inputs['sources']['web']['commit'] ?? null) === ($web['source_reference'] ?? null));
    if (!is_string($sha256) || !hash_equals((string) ($archive['sha256'] ?? ''), $sha256)
        || !is_string($sha1) || !hash_equals((string) ($archive['sha1'] ?? ''), $sha1)
        || ($repository['dist']['shasum'] ?? null) !== $sha1
        || ($repository['version'] ?? null) !== ($core['resolved_version'] ?? null)
        || ($repository['dist']['type'] ?? null) !== 'zip'
        || ($repository['dist']['url'] ?? null) !== '../' . $relative || !$originValid) {
        throw new RuntimeException('INTERNAL_CANDIDATE_CORE_ARCHIVE_IDENTITY_INVALID');
    }
    return [
        'inputs' => $inputs,
        'archive_absolute' => $zip,
        'archive_relative' => $relative,
        'archive_sha256' => $sha256,
        'archive_sha1' => $sha1,
        'package' => $repository,
        'local' => $local,
        'source_identity' => $identity,
    ];
}

/** @param array<string,mixed> $corePackage */
function internalCandidateProjectComposer(string $application, array $corePackage, string $constraint): void
{
    $path = $application . '/server/composer.json';
    $composer = internalCandidateReadJson($path);
    if (($composer['require']['peanut-admin/core'] ?? null) === null) {
        throw new RuntimeException('INTERNAL_CANDIDATE_CORE_REQUIRE_MISSING');
    }
    $composer['require']['peanut-admin/core'] = $constraint;
    $existing = is_array($composer['repositories'] ?? null) ? $composer['repositories'] : [];
    $repositories = [[
        'type' => 'package',
        'package' => $corePackage,
    ]];
    foreach ($existing as $repository) {
        if (!is_array($repository) || ($repository['type'] ?? null) === 'path') {
            throw new RuntimeException('INTERNAL_CANDIDATE_COMPOSER_REPOSITORY_UNSUPPORTED');
        }
        if (($repository['url'] ?? null) === 'https://github.com/peanut-business/peanut-admin-core-php.git') {
            continue;
        }
        $repositories[] = $repository;
    }
    $composer['repositories'] = $repositories;
    internalCandidateWriteJson($path, $composer);
}

/** @return array<string,mixed> */
function internalCandidateLockPackage(string $lockPath): array
{
    $lock = internalCandidateReadJson($lockPath);
    foreach (($lock['packages'] ?? []) as $package) {
        if (is_array($package) && ($package['name'] ?? null) === 'peanut-admin/core') {
            return $package;
        }
    }
    throw new RuntimeException('INTERNAL_CANDIDATE_CORE_LOCK_MISSING');
}

function internalCandidateLockRows(string $lockPath): string
{
    $lock = internalCandidateReadJson($lockPath);
    $rows = [];
    foreach ([...($lock['packages'] ?? []), ...($lock['packages-dev'] ?? [])] as $package) {
        if (!is_array($package) || ($package['name'] ?? null) === 'peanut-admin/core') {
            continue;
        }
        $rows[] = implode("\0", [
            (string) ($package['name'] ?? ''),
            (string) ($package['version'] ?? ''),
            (string) ($package['source']['type'] ?? ''),
            (string) ($package['source']['url'] ?? ''),
            (string) ($package['source']['reference'] ?? ''),
            (string) ($package['dist']['type'] ?? ''),
            (string) ($package['dist']['url'] ?? ''),
            (string) ($package['dist']['reference'] ?? ''),
            (string) ($package['dist']['shasum'] ?? ''),
        ]);
    }
    sort($rows, SORT_STRING);
    return hash('sha256', implode("\n", $rows));
}

/** Bind every active module declaration through the existing native artifact writer. */
function internalCandidateProjectModules(string $application, string $version): void
{
    foreach (glob($application . '/server/app/modules/*/*/composer.json') ?: [] as $path) {
        $composer = internalCandidateReadJson($path);
        if (isset($composer['require']['peanut-admin/core'])) {
            $composer['require']['peanut-admin/core'] = $version;
            internalCandidateWriteJson($path, $composer);
        }
    }
    $writer = new app\platform\infrastructure\plugin\PluginArtifactWriter($application . '/server', false);
    foreach (glob($application . '/plugins/*/plugin.json') ?: [] as $path) {
        $plugin = internalCandidateReadJson($path);
        $specs = [];
        foreach ($plugin['modules'] as $module) {
            $specs[] = $module['key'] . '=' . $module['root'];
        }
        $writer->make($plugin['key'], $plugin['version'], $specs);
    }
    $writer->writeLock();
    $writer->checkLock();
}

/** @param array<string,mixed> $core */
function internalCandidateProjectCore(string $application, array $core, string $temporary): string
{
    $coreTarget = $application . '/' . $core['archive_relative'];
    internalCandidateCopyFile($core['archive_absolute'], $coreTarget);
    $lockBefore = internalCandidateLockRows($application . '/server/composer.lock');
    $version = (string) $core['inputs']['core_php']['resolved_version'];
    internalCandidateProjectComposer($application, $core['package'], $version);
    internalCandidateProjectModules($application, $version);
    internalCandidateRun([
        'composer',
        'update', 'peanut-admin/core',
        '--working-dir=' . $application . '/server',
        '--no-install', '--no-scripts', '--no-interaction', '--no-progress', '--prefer-dist',
    ], $application, [
        'COMPOSER_HOME' => $temporary . '/composer-home',
        'COMPOSER_CACHE_DIR' => getenv('COMPOSER_CACHE_DIR') ?: $temporary . '/composer-cache',
    ]);
    $lockAfter = internalCandidateLockRows($application . '/server/composer.lock');
    if (!hash_equals($lockBefore, $lockAfter)) {
        throw new RuntimeException('INTERNAL_CANDIDATE_THIRD_PARTY_LOCK_CHANGED');
    }
    $lockedCore = internalCandidateLockPackage($application . '/server/composer.lock');
    $local = $core['local'] ?? false;
    if (($lockedCore['version'] ?? null) !== $version
        || ($local
            ? (isset($lockedCore['source']) || ($lockedCore['dist']['reference'] ?? null) !== ($core['source_identity']['snapshot_sha256'] ?? null))
            : (($lockedCore['source']['reference'] ?? null) !== ($core['inputs']['core_php']['source_reference'] ?? null)
                || ($lockedCore['dist']['reference'] ?? null) !== ($core['inputs']['core_php']['source_reference'] ?? null)))
        || ($lockedCore['dist']['shasum'] ?? null) !== $core['archive_sha1']) {
        throw new RuntimeException('INTERNAL_CANDIDATE_CORE_LOCK_IDENTITY_INVALID');
    }
    return $lockAfter;
}

/** Carry all six immutable Web inputs; native managers resolve actual consumers only.
 * @return array{packages:array<string,mixed>,third_party_locks:array<string,string>}
 */
function internalCandidateProjectWeb(string $application, array $core, string $receipt, string $toolRoot): array
{
    $web = $core['inputs']['core_web'] ?? null;
    $suffixes = ['client', 'vue', 'ui-vue', 'nuxt', 'uniapp', 'testing'];
    $local = is_array($web) && ($web['source_type'] ?? null) === 'local';
    $identity = is_array($web) ? ($web['source_identity'] ?? null) : null;
    $sourceValid = $local
        ? (is_array($identity) && array_keys($identity) === ['kind', 'snapshot_sha256']
            && ($identity['kind'] ?? null) === 'local'
            && preg_match('/^[a-f0-9]{64}$/D', (string) ($identity['snapshot_sha256'] ?? '')) === 1
            && ($core['inputs']['sources']['web'] ?? null) === $identity)
        : (is_array($web) && ($web['source_type'] ?? null) === 'git'
            && ($web['source_reference'] ?? null) === ($core['inputs']['sources']['web']['commit'] ?? null)
            && preg_match('/^[a-f0-9]{40}$/D', (string) ($web['source_reference'] ?? '')) === 1);
    if (!is_array($web) || array_keys($web['packages'] ?? []) !== array_map(static fn(string $s): string => '@peanut-admin/' . $s, $suffixes)
        || !$sourceValid) {
        throw new RuntimeException('INTERNAL_CANDIDATE_WEB_INPUTS_INVALID');
    }
    $lockTool = $toolRoot . '/scripts/release-dependency-locks.mjs';
    $before = json_decode(internalCandidateRun(['node', $lockTool, $application, '--third-party-only', '--tool-root=' . $toolRoot]), true, 512, JSON_THROW_ON_ERROR);
    $packages = [];
    $webVersion = $web['packages']['@peanut-admin/client']['version'] ?? null;
    if (!ReleaseDependencyIdentity::fixed($webVersion)) {
        throw new RuntimeException('INTERNAL_CANDIDATE_WEB_INPUTS_INVALID');
    }
    foreach ($web['packages'] as $name => $identity) {
        $suffix = substr($name, strlen('@peanut-admin/'));
        $path = $identity['archive'] ?? '';
        if (($identity['version'] ?? null) !== $webVersion
            || $path !== 'packages/core-web/peanut-admin-' . $suffix . '-' . $identity['version'] . '.tgz') {
            throw new RuntimeException('INTERNAL_CANDIDATE_WEB_ARCHIVE_IDENTITY_INVALID');
        }
        $input = dirname($receipt) . '/' . $path;
        internalCandidatePath($input, false, true);
        if (!hash_equals((string) ($identity['sha256'] ?? ''), (string) hash_file('sha256', $input))) {
            throw new RuntimeException('INTERNAL_CANDIDATE_WEB_ARCHIVE_DIGEST_INVALID');
        }
        $destination = $application . '/' . $path;
        if (file_exists($destination)) {
            internalCandidatePath($destination, false, true);
            if (!unlink($destination)) {
                throw new RuntimeException('INTERNAL_CANDIDATE_WEB_ARCHIVE_REPLACE_FAILED');
            }
        }
        internalCandidateCopyFile($input, $destination);
        $packages[$name] = $identity + ['integrity' => 'sha512-' . base64_encode(hash_file('sha512', $input, true)), 'consumers' => []];
    }
    foreach (['web', 'platform', 'pc', 'uniapp'] as $client) {
        $path = $application . '/' . $client . '/package.json';
        $manifest = internalCandidateReadJson($path);
        foreach (['dependencies', 'devDependencies', 'optionalDependencies'] as $section) {
            foreach (($manifest[$section] ?? []) as $name => $specifier) {
                if (!str_starts_with($name, '@peanut-admin/')) {
                    continue;
                }
                if (!isset($packages[$name])) {
                    throw new RuntimeException('INTERNAL_CANDIDATE_WEB_PACKAGE_UNKNOWN');
                }
                $manifest[$section][$name] = 'file:../' . $packages[$name]['archive'];
                $packages[$name]['consumers'][] = $client;
            }
        }
        internalCandidateWriteJson($path, $manifest);
    }
    $versions = internalCandidateReadJson($application . '/release-versions.json');
    $versions['core_php'] = $core['inputs']['core_php'];
    $versions['core_web'] = $web;
    internalCandidateWriteJson($application . '/release-versions.json', $versions);
    // These are native lock generation operations, not hand-edited lock data.
    // Lifecycle hooks are disabled; none may install the APP or touch a database.
    internalCandidateRun(['pnpm', '--dir', $application . '/web', 'install', '--lockfile-only', '--ignore-scripts'], $application, ['HUSKY' => '0']);
    foreach (['platform', 'pc', 'uniapp'] as $client) {
        internalCandidateRun(['npm', '--prefix', $application . '/' . $client, 'install', '--package-lock-only', '--ignore-scripts', '--no-audit', '--no-fund'], $application, ['HUSKY' => '0']);
    }
    $after = json_decode(internalCandidateRun(['node', $lockTool, $application, '--third-party-only', '--tool-root=' . $toolRoot]), true, 512, JSON_THROW_ON_ERROR);
    if ($before !== $after) {
        throw new RuntimeException('INTERNAL_CANDIDATE_WEB_THIRD_PARTY_LOCK_CHANGED');
    }
    internalCandidateRun(['node', $lockTool, $application, '--internal-candidate', '--tool-root=' . $toolRoot]);
    foreach ($packages as &$identity) {
        $identity['consumers'] = array_values(array_unique($identity['consumers']));
        $identity['consumption'] = $identity['consumers'] === [] ? 'carried-not-consumed' : 'selected-client-dependency';
    }
    unset($identity);
    return ['packages' => $packages, 'third_party_locks' => $after];
}

/**
 * Seal the explicit upgrade projection into the generated application's own
 * managed baseline before the scaffold release artifacts are copied out.
 * @param array<string,mixed> $core
 * @return array<string,mixed>
 */
function internalCandidateProjectScaffold(string $application, array $core, string $temporary, array $sourceIdentity, string $receipt): array
{
    $manifestPath = $application . '/.peanut/application-manifest.json';
    $manifest = internalCandidateReadJson($manifestPath);
    $localSource = ($sourceIdentity['kind'] ?? null) === 'local';
    $generationIdentity = $manifest['generation_source']['source_identity'] ?? null;
    $sourceMatches = $localSource
        ? ($generationIdentity === $sourceIdentity)
        : (($manifest['generation_source']['commit'] ?? null) === ($sourceIdentity['commit'] ?? null)
            && ($manifest['generation_source']['tree'] ?? null) === ($sourceIdentity['tree'] ?? null));
    if (!$sourceMatches
        || !is_array($manifest['files'] ?? null)
        || !is_string($manifest['digests']['managed_tree_sha256'] ?? null)) {
        throw new RuntimeException('INTERNAL_CANDIDATE_SCAFFOLD_SOURCE_INVALID');
    }
    $originalDigest = $manifest['digests']['managed_tree_sha256'];
    $versionPath = $application . '/release-versions.json';
    $versions = internalCandidateReadJson($versionPath);
    $originalPhp = $versions['core_php'] ?? null;
    if (!defined('RELEASE_APPLICATION_VERSION_TOKEN')
        || !defined('RELEASE_PRODUCT_TOKEN')
        || !defined('RELEASE_SLUG_TOKEN')
        || !defined('RELEASE_PACKAGE_TOKEN')
        || ($versions['schema_version'] ?? null) !== 3
        || ($versions['protocol'] ?? null) !== 'peanut.release-versions.v3'
        || !is_array($originalPhp)
        || ($originalPhp['package'] ?? null) !== 'peanut-admin/core'
        || ($versions['instance_version'] ?? null) !== constant('RELEASE_APPLICATION_VERSION_TOKEN')
        || ($versions['source_product_version'] ?? null) !== ($versions['scaffold_template'] ?? null)
        || ($versions['scaffold_template'] ?? null) !== ($manifest['template']['version'] ?? null)) {
        throw new RuntimeException('INTERNAL_CANDIDATE_SCAFFOLD_VERSION_INVALID');
    }
    $coreIdentity = $core['inputs']['core_php'];
    $originalWeb = $versions['core_web'] ?? null;
    $requestedWeb = $core['inputs']['core_web'] ?? null;
    if (!is_array($originalWeb) || !is_array($requestedWeb)
        || !is_array($originalWeb['packages'] ?? null) || !is_array($requestedWeb['packages'] ?? null)) {
        throw new RuntimeException('INTERNAL_CANDIDATE_WEB_INPUTS_INVALID');
    }
    $sameWeb = ($requestedWeb['source_identity'] ?? null) === ($originalWeb['source_identity'] ?? null)
        && ($requestedWeb['source_reference'] ?? null) === ($originalWeb['source_reference'] ?? null)
        && array_keys($requestedWeb['packages']) === array_keys($originalWeb['packages']);
    foreach ($requestedWeb['packages'] as $name => $package) {
        $sameWeb = $sameWeb && is_array($package)
            && ($package['version'] ?? null) === ($originalWeb['packages'][$name]['version'] ?? null);
    }
    if (!$localSource && !$core['local'] && ($coreIdentity['source_reference'] ?? null) === ($originalPhp['source_reference'] ?? null)
        && ltrim((string) ($coreIdentity['resolved_version'] ?? ''), 'v') === ltrim((string) ($originalPhp['resolved_version'] ?? ''), 'v')
        && $sameWeb) {
        throw new RuntimeException('INTERNAL_CANDIDATE_SCAFFOLD_PROJECTION_REDUNDANT');
    }
    if ($core['local']) {
        $versions['core_php'] = $coreIdentity;
        $versions['core_web'] = $requestedWeb;
    } else {
        $versions['core_php']['constraint'] = $coreIdentity['resolved_version'];
        $versions['core_php']['resolved_version'] = $coreIdentity['resolved_version'];
        $versions['core_php']['source_reference'] = $coreIdentity['source_reference'];
    }
    internalCandidateWriteJson($versionPath, $versions);
    internalCandidateProjectCore($application, $core, $temporary);
    $web = internalCandidateProjectWeb($application, $core, $receipt, dirname(__DIR__));
    $versions = internalCandidateReadJson($versionPath);

    $allowed = ['release-versions.json' => true, 'server/composer.json' => true,
        'server/composer.lock' => true, 'plugins.lock' => true];
    foreach (['web', 'platform', 'pc', 'uniapp'] as $client) {
        $allowed[$client . '/package.json'] = true;
        $allowed[$client . '/' . ($client === 'web' ? 'pnpm-lock.yaml' : 'package-lock.json')] = true;
    }
    $changes = [];
    $managed = [];
    foreach ($manifest['files'] as &$file) {
        $path = $file['path'] ?? null;
        if (!is_string($path) || !is_string($file['sha256'] ?? null)) {
            throw new RuntimeException('INTERNAL_CANDIDATE_SCAFFOLD_FILE_INVALID');
        }
        $actual = hash_file('sha256', $application . '/' . $path);
        if (!is_string($actual)) {
            throw new RuntimeException('INTERNAL_CANDIDATE_SCAFFOLD_FILE_MISSING: ' . $path);
        }
        if (!hash_equals($file['sha256'], $actual)) {
            if (!isset($allowed[$path]) && preg_match('#^server/app/modules/[a-z0-9_-]+/[a-z0-9_-]+/composer\.json$#D', $path) !== 1
                && preg_match('#^plugins/[a-z0-9._-]+/plugin\.json$#D', $path) !== 1) {
                throw new RuntimeException('INTERNAL_CANDIDATE_SCAFFOLD_PROJECTION_UNEXPECTED: ' . $path);
            }
            if (!in_array($file['classification'], ['managed', 'generated-managed'], true)
                || !is_string($file['baseline_path'] ?? null)) {
                throw new RuntimeException('INTERNAL_CANDIDATE_SCAFFOLD_PROJECTION_UNMANAGED: ' . $path);
            }
            $changes[] = ['path' => $path, 'before_sha256' => $file['sha256'], 'after_sha256' => $actual];
            $baseline = $application . '/' . $file['baseline_path'];
            if (!is_file($baseline) || is_link($baseline)
                || hash_file('sha256', $baseline) !== $file['baseline_sha256']) {
                throw new RuntimeException('INTERNAL_CANDIDATE_SCAFFOLD_BASELINE_INVALID: ' . $path);
            }
            if (!copy($application . '/' . $path, $baseline)) {
                throw new RuntimeException('INTERNAL_CANDIDATE_SCAFFOLD_BASELINE_WRITE_FAILED: ' . $path);
            }
            $file['sha256'] = $actual;
            $file['baseline_sha256'] = $actual;
        }
        if (in_array($file['classification'], ['managed', 'generated-managed'], true)) {
            $managed[] = $file;
        }
    }
    unset($file);
    $corePath = $core['archive_relative'];
    $archives = [$corePath => $core['archive_sha256']];
    foreach ($web['packages'] as $package) {
        $archives[$package['archive']] = $package['sha256'];
    }
    $additions = [];
    foreach ($archives as $path => $digest) {
        $bytes = file_get_contents($application . '/' . $path);
        if (!is_string($bytes) || !hash_equals($digest, hash('sha256', $bytes))) {
            throw new RuntimeException('INTERNAL_CANDIDATE_SCAFFOLD_CORE_READ_FAILED: ' . $path);
        }
        foreach ([constant('RELEASE_PRODUCT_TOKEN'), constant('RELEASE_SLUG_TOKEN'),
            constant('RELEASE_PACKAGE_TOKEN'), constant('RELEASE_APPLICATION_VERSION_TOKEN')] as $token) {
            if (str_contains($bytes, $token)) {
                throw new RuntimeException('INTERNAL_CANDIDATE_SCAFFOLD_CORE_TOKEN_COLLISION: ' . $path);
            }
        }
        foreach ($manifest['files'] as $file) {
            if ($file['path'] === $path) {
                throw new RuntimeException('INTERNAL_CANDIDATE_SCAFFOLD_CORE_PATH_COLLISION: ' . $path);
            }
        }
        $baseline = $manifest['ownership']['baseline_root'] . '/' . $path;
        internalCandidateCopyFile($application . '/' . $path, $application . '/' . $baseline);
        $file = ['path' => $path, 'sha256' => $digest, 'mode' => 0644,
            'classification' => 'managed', 'owner' => 'host', 'source' => $path,
            'baseline_path' => $baseline, 'baseline_sha256' => $digest];
        $manifest['files'][] = $file;
        $managed[] = $file;
        $additions[] = ['path' => $path, 'sha256' => $digest];
    }
    usort($manifest['files'], static fn(array $a, array $b): int => strcmp($a['path'], $b['path']));
    $rows = array_map(static fn(array $file): string => $file['path'] . "\0" . $file['sha256'], $managed);
    sort($rows, SORT_STRING);
    $manifest['digests']['managed_tree_sha256'] = hash('sha256', implode("\n", $rows));
    internalCandidateWriteJson($manifestPath, $manifest);
    $receiptDigest = hash_file('sha256', $receipt);
    if (!is_string($receiptDigest)) {
        throw new RuntimeException('INTERNAL_CANDIDATE_SCAFFOLD_RECEIPT_INVALID');
    }
    $projection = [
        'protocol' => 'peanut.internal-core-scaffold-projection.v1',
        'scope' => 'internal-upgrade-target-not-formal-release',
        'core_inputs_sha256' => $receiptDigest,
        'build_tools_sha256' => [
            'build_scaffold_release' => hash_file('sha256', __DIR__ . '/build-scaffold-release'),
            'build_internal_edition_candidate' => hash_file('sha256', __FILE__),
        ],
        'core' => ['package' => 'peanut-admin/core', 'resolved_version' => $coreIdentity['resolved_version'],
            ...($core['local'] ? ['source_identity' => $coreIdentity['source_identity']] : ['source_reference' => $coreIdentity['source_reference']]), 'archive_path' => $corePath,
            'archive_sha256' => $core['archive_sha256'], 'archive_sha1' => $core['archive_sha1']],
        'core_web' => $web['packages'],
        'release_versions' => ['before' => $originalPhp, 'after' => $versions['core_php']],
        'managed_tree_sha256' => ['source' => $originalDigest, 'projected' => $manifest['digests']['managed_tree_sha256']],
        'changes' => $changes,
        'addition' => ['path' => $corePath, 'sha256' => $core['archive_sha256']],
        'additions' => $additions,
    ];
    if ($localSource) {
        $projection['source_identity'] = $sourceIdentity;
        $projection['core_web_source_identity'] = $core['inputs']['core_web']['source_identity'];
    } else {
        $projection['source'] = ['commit' => $sourceIdentity['commit'], 'tree' => $sourceIdentity['tree']];
        $projection['web_source_reference'] = $core['inputs']['core_web']['source_reference'];
    }
    return $projection;
}

function internalCandidateMain(array $argv): void
{
    $root = dirname(__DIR__);
    require_once $root . '/server/vendor/autoload.php';

    $options = [];
    foreach (array_slice($argv, 1) as $argument) {
        if (preg_match('/^--(source-commit|edition|profile|workflow|core-inputs|output)=(.+)$/D', $argument, $matches) !== 1
            || isset($options[$matches[1]])) {
            internalCandidateUsage();
        }
        $options[$matches[1]] = $matches[2];
    }
    foreach (['source-commit', 'edition', 'profile', 'workflow', 'core-inputs', 'output'] as $required) {
        if (!isset($options[$required])) {
            internalCandidateUsage();
        }
    }
    if (preg_match('/^[a-f0-9]{40}$/D', $options['source-commit']) !== 1
        || !in_array($options['edition'], ['standalone', 'multi-tenant'], true)
        || $options['profile'] !== 'full' || $options['workflow'] !== 'full'
        || !str_starts_with($options['core-inputs'], '/')
        || !str_starts_with($options['output'], '/')
        || file_exists($options['output'])
        || is_link($options['output'])) {
        internalCandidateUsage();
    }

    internalCandidatePath($options['core-inputs'], false, true);
    internalCandidatePath($options['output'], true);
    internalCandidatePath(sys_get_temp_dir());

    $commit = trim(internalCandidateRun(['git', '-C', $root, 'rev-parse', $options['source-commit'] . '^{commit}']));
    if (!hash_equals($options['source-commit'], $commit)) {
        throw new RuntimeException('INTERNAL_CANDIDATE_SOURCE_NOT_COMMIT');
    }
    $tree = trim(internalCandidateRun(['git', '-C', $root, 'rev-parse', $commit . '^{tree}']));
    $temporaryRoot = realpath(sys_get_temp_dir());
    if (!is_string($temporaryRoot) || is_link($temporaryRoot)) {
        throw new RuntimeException('INTERNAL_CANDIDATE_TEMP_ROOT_INVALID');
    }
    $temporary = $temporaryRoot . '/peanut-internal-candidate-' . bin2hex(random_bytes(8));
    if (!mkdir($temporary, 0700, true)) {
        throw new RuntimeException('INTERNAL_CANDIDATE_TEMP_FAILED');
    }
    $completed = false;
    // Emit the actual private root before child work so even an uncatchable
    // termination leaves a durable Job-log pointer to the retained state.
    fwrite(STDERR, 'INTERNAL_CANDIDATE_PRIVATE_STAGING: ' . $temporary
        . '; owner_uid=' . (function_exists('posix_geteuid') ? (string) posix_geteuid() : 'unavailable')
        . '; owner_pid=' . getmypid() . '; lifecycle_owner=invoking-build-Session-owner' . "\n");

    try {
        $source = $temporary . '/source';
        $origin = trim(internalCandidateRun(['git', '-C', $root, 'remote', 'get-url', 'origin']));
        if ($origin === '') {
            throw new RuntimeException('INTERNAL_CANDIDATE_SOURCE_ORIGIN_INVALID');
        }
        // Use an independent shallow repository for the exact fixed source commit.
        internalCandidateRun(['git', 'init', '--quiet', $source]);
        internalCandidateRun(['git', '-C', $source, 'fetch', '--quiet', '--no-tags', '--depth=1', $root, $commit]);
        internalCandidateRun(['git', '-C', $source, 'remote', 'add', 'origin', $origin]);
        internalCandidateRun(['git', '-C', $source, 'checkout', '--quiet', '--detach', $commit]);
        if (realpath(trim(internalCandidateRun(['git', '-C', $source, 'rev-parse', '--show-toplevel']))) !== realpath($source)
            || !hash_equals($commit, trim(internalCandidateRun(['git', '-C', $source, 'rev-parse', 'HEAD'])))
            || !hash_equals($tree, trim(internalCandidateRun(['git', '-C', $source, 'rev-parse', 'HEAD^{tree}'])))
            || trim(internalCandidateRun(['git', '-C', $source, 'status', '--porcelain=v1', '--untracked-files=all'])) !== '') {
            throw new RuntimeException('INTERNAL_CANDIDATE_SOURCE_IDENTITY_MISMATCH');
        }
        foreach (['build-internal-edition-candidate', 'internal_candidate_contract.py', 'package-release.sh', 'package-release-files.py', 'release-dependency-locks.mjs'] as $tool) {
            if (hash_file('sha256', $source . '/scripts/' . $tool) !== hash_file('sha256', $root . '/scripts/' . $tool)) {
                throw new RuntimeException('INTERNAL_CANDIDATE_TOOL_SOURCE_MISMATCH: ' . $tool);
            }
        }

        require $source . '/server/app/common/value/scaffold/VersionContract.php';
        require $source . '/server/app/common/validation/scaffold/ScaffoldPathGuard.php';
        require $source . '/server/app/common/value/scaffold/ScaffoldManifest.php';
        require $source . '/server/app/common/value/scaffold/EditionProfile.php';
        require $source . '/server/app/common/infrastructure/scaffold/EditionProjector.php';
        require $source . '/server/app/platform/exception/plugin/PluginArtifactToolException.php';
        require $source . '/server/app/platform/value/plugin/ModuleFrontendLayout.php';
        require $source . '/server/app/platform/infrastructure/plugin/PluginArtifactWriter.php';
        require $source . '/server/app/platform/exception/plugin/PluginLifecycleException.php';
        require $source . '/server/app/platform/value/plugin/PluginDescriptor.php';
        require $source . '/server/app/platform/infrastructure/plugin/PluginLockResolver.php';
        require $source . '/server/app/common/infrastructure/scaffold/ApplicationCreator.php';
        require $source . '/server/app/common/infrastructure/scaffold/DeterministicEditionArchive.php';

        $versions = VersionContract::load($source . '/release-versions.json');
        if (!$versions->isV3()) {
            throw new RuntimeException('INTERNAL_CANDIDATE_VERSION_CONTRACT_INVALID');
        }
        $core = internalCandidateCoreInputs($options['core-inputs']);
        $application = $temporary . '/application';
        $manifest = (new ApplicationCreator(
            $source,
            $source . '/scaffold/application-template-inventory.json',
            ['commit' => $commit, 'tree' => $tree],
            apiGeneratorPath: $root . '/scripts/generate-api-contracts.php',
        ))->create(
            'Peanut Admin',
            'peanut-admin',
            'peanut-admin/application-internal-candidate',
            $application,
            $options['edition'],
            $versions->sourceProductVersion(),
            $options['profile'],
            $options['workflow'],
        );
        // Preserve the original generated source and baseline, including empty-storage placeholders.
        $contractTool = $root . '/scripts/internal_candidate_contract.py';
        $captured = $temporary . '/original-tree.json';
        internalCandidateRun(['python3', $contractTool, 'capture', $application, $captured]);
        $lockAfter = internalCandidateProjectCore($application, $core, $temporary);
        $web = internalCandidateProjectWeb($application, $core, $options['core-inputs'], $root);
        $coreDescriptor = [
            'package' => $core['inputs']['core_php']['package'],
            'constraint' => $core['inputs']['core_php']['resolved_version'],
            'resolved_version' => $core['inputs']['core_php']['resolved_version'],
            'source_reference' => $core['inputs']['core_php']['source_reference'],
            'path_in_archive' => $core['archive_relative'],
            'sha256' => $core['archive_sha256'],
            'sha1' => $core['archive_sha1'],
        ];
        $coreDescriptorPath = $temporary . '/core-descriptor.json';
        $selection = ['edition' => $options['edition'], 'profile' => $options['profile'], 'workflow' => $options['workflow'],
            'clients' => ['Admin', 'Platform', 'PC SPA', 'UniApp H5']];
        internalCandidateWriteJson($coreDescriptorPath, ['core' => $coreDescriptor, 'core_web' => $web['packages'],
            'web_source_reference' => $core['inputs']['core_web']['source_reference'],
            'core_inputs_sha256' => hash_file('sha256', $options['core-inputs']), 'selection' => $selection]);
        $sealed = json_decode(internalCandidateRun([
            'python3', $contractTool, 'seal', $application, $captured, $coreDescriptorPath,
        ]), true, 512, JSON_THROW_ON_ERROR);


        $archiveRoot = 'peanut-admin-internal-' . $versions->sourceProductVersion() . '-' . $options['edition'];
        $archiveName = $archiveRoot . '.tar.gz';
        $archive = $temporary . '/' . $archiveName;
        $assembled = $temporary . '/' . $archiveRoot;
        internalCandidateRun(['bash', $source . '/scripts/package-release.sh', $assembled,
            '--application-root=' . $application, '--internal-candidate', '--directory-only'], $source,
            ['COMPOSER_HOME' => $temporary . '/composer-home', 'COMPOSER_CACHE_DIR' => getenv('COMPOSER_CACHE_DIR') ?: $temporary . '/composer-cache', 'HUSKY' => '0']);
        $installedProof = internalCandidateReadJson($assembled . '.dependency-proof.json');
        (new DeterministicEditionArchive())->write($assembled, $archiveRoot, $archive);
        $candidateManifest = [
            'schema_version' => 1,
            'protocol' => 'peanut.internal-edition-candidate.v1',
            'scope' => 'internal-candidate',
            'status' => 'internal-build-input-not-formal-release',
            'qualification_scope' => 'complete-app-source-and-four-browser-builds-not-runtime-qualified',
            'selection' => $selection,
            'frontend' => ['state' => 'native-frozen-installs-origin-verified-and-four-clients-built',
                'core_packages' => $web['packages'], 'installed_proof' => $installedProof],
            'product' => ['name' => 'Peanut Admin', 'version' => $versions->sourceProductVersion()],
            'edition' => $manifest['edition'],
            'source' => [
                'repository' => 'peanut-business/peanut-admin-code',
                'commit' => $commit,
                'tree' => $tree,
                'inventory_sha256' => hash_file('sha256', $source . '/scaffold/application-template-inventory.json'),
            ],
            'core_php_archive' => $coreDescriptor,
            'core_web_archives' => $web['packages'],
            'candidate_marker' => $sealed['candidate_marker'],
            'projection' => $sealed['projection'],
            'build_tool_inputs' => [
                'builder_sha256' => hash_file('sha256', __FILE__),
                'contract_sha256' => hash_file('sha256', $contractTool),
                'core_receipt_sha256' => hash_file('sha256', $options['core-inputs']),
                'package_release_sha256' => hash_file('sha256', $source . '/scripts/package-release.sh'),
                'package_release_files_sha256' => hash_file('sha256', $source . '/scripts/package-release-files.py'),
                'dependency_locks_tool_sha256' => hash_file('sha256', $source . '/scripts/release-dependency-locks.mjs'),
                // ApplicationCreator already requires source-identical inputs
                // and the matching installed lock/package before using this tool.
                'api_generator_sha256' => hash_file('sha256', $root . '/scripts/generate-api-contracts.php'),
                'api_generator_dependency_lock_sha256' => hash_file('sha256', $root . '/web/pnpm-lock.yaml'),
                'api_generator_package_version' => internalCandidateReadJson($root . '/web/package.json')['devDependencies']['openapi-typescript'],
            ],
            'dependency_locks' => [
                'server/composer.lock' => hash_file('sha256', $application . '/server/composer.lock'),
                'web/pnpm-lock.yaml' => hash_file('sha256', $application . '/web/pnpm-lock.yaml'),
                'platform/package-lock.json' => hash_file('sha256', $application . '/platform/package-lock.json'),
                'pc/package-lock.json' => hash_file('sha256', $application . '/pc/package-lock.json'),
                'uniapp/package-lock.json' => hash_file('sha256', $application . '/uniapp/package-lock.json'),
                'third_party_composer_rows_sha256' => $lockAfter,
                'third_party_web_locks_sha256' => $web['third_party_locks'],
            ],
            'application' => [
                'digest_scope' => 'original-generated-baseline-preserved-projection-recorded-separately',
                'manifest_sha256' => hash_file('sha256', $application . '/.peanut/application-manifest.json'),
                'managed_tree_sha256' => $manifest['digests']['managed_tree_sha256'],
                'app_owned_tree_sha256' => $manifest['digests']['app_owned_tree_sha256'],
                'file_count' => count($manifest['files']),
                'release_identity_sha256' => hash_file('sha256', $assembled . '/.peanut/application-release.json'),
            ],
            'archive' => [
                'filename' => $archiveName,
                'root' => $archiveRoot,
                'format' => 'tar.gz',
                'sha256' => hash_file('sha256', $archive),
                'bytes' => filesize($archive),
            ],
            'formal_release' => [
                'eligible' => false,
                'reason' => 'internal candidate carries seven fixed Core archives; no public release or runtime qualification',
            ],
        ];
        $expectedManifest = $temporary . '/candidate-manifest.json';
        internalCandidateWriteJson($expectedManifest, $candidateManifest);
        internalCandidateRun(['python3', $contractTool, 'verify-assembled', $assembled, $expectedManifest]);
        if (!mkdir($options['output'], 0775, true)) {
            throw new RuntimeException('INTERNAL_CANDIDATE_OUTPUT_CREATE_FAILED');
        }
        internalCandidateCopyFile($archive, rtrim($options['output'], '/') . '/' . $archiveName);
        internalCandidateWriteJson(rtrim($options['output'], '/') . '/' . $archiveName . '.manifest.json', $candidateManifest);
        internalCandidateWriteJson(rtrim($options['output'], '/') . '/receipt.json', [
            'schema_version' => 1,
            'status' => 'built',
            'protocol' => 'peanut.internal-edition-candidate.v1',
            'source_commit' => $commit,
            'source_tree' => $tree,
            'edition' => $options['edition'],
            'archive' => $candidateManifest['archive'],
            'manifest_sha256' => hash_file('sha256', rtrim($options['output'], '/') . '/' . $archiveName . '.manifest.json'),
        ]);
        echo json_encode([
            'status' => 'built',
            'protocol' => 'peanut.internal-edition-candidate.v1',
            'output' => $options['output'],
            'archive' => $candidateManifest['archive'],
            'manifest_sha256' => hash_file('sha256', rtrim($options['output'], '/') . '/' . $archiveName . '.manifest.json'),
        ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n";
        $completed = true;
    } finally {
        if ($completed) {
            internalCandidateDelete($temporary);
        } else {
            // This 0700 directory belongs to this invocation, never to the
            // distributable APP. Keep native locks, installed trees and any
            // nested packager failure state for the actual build owner.
            try {
                internalCandidateWriteJson($temporary . '/failure-context.json', [
                    'status' => 'failed-unqualified-private-diagnostics',
                    'owner_uid' => function_exists('posix_geteuid') ? posix_geteuid() : null,
                    'owner_pid' => getmypid(),
                    'lifecycle_owner' => 'invoking build Session owner; retain until explicit diagnosis and cleanup',
                    'source' => ['commit' => $commit, 'tree' => $tree],
                    'temporary_root' => $temporary,
                    'application' => $temporary . '/application',
                    'packaging_workspaces' => array_values(glob($temporary . '/.peanut-package.*', GLOB_ONLYDIR) ?: []),
                ], 0600);
            } catch (Throwable) {
                // A full disk or another diagnostics write error must not
                // replace the original failure or delete its native state.
                fwrite(STDERR, "INTERNAL_CANDIDATE_FAILURE_CONTEXT_WRITE_FAILED\n");
            }
            fwrite(STDERR, 'INTERNAL_CANDIDATE_FAILURE_RETAINED: ' . $temporary
                . '; owner_uid=' . (function_exists('posix_geteuid') ? (string) posix_geteuid() : 'unavailable')
                . '; owner_pid=' . getmypid() . '; cleanup=invoking-build-Session-owner-after-diagnosis' . "\n");
        }
    }
}

if (realpath((string) ($_SERVER['SCRIPT_FILENAME'] ?? '')) === __FILE__) {
    internalCandidateMain($argv);
}
