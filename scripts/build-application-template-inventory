#!/usr/bin/env php
<?php

declare(strict_types=1);

use app\common\value\scaffold\ScaffoldConfiguration;

$root = dirname(__DIR__);
$output = $root . '/scaffold/application-template-inventory.json';
require_once $root . '/server/app/common/value/scaffold/VersionContract.php';
require_once $root . '/scripts/scaffold-runtime/ScaffoldSourceIdentity.php';
$versions = \app\common\value\scaffold\VersionContract::load($root . '/release-versions.json');
$configuration = ScaffoldConfiguration::load();

/** @return array<string,true> */
function declaredCoreWebArchives(\app\common\value\scaffold\VersionContract $versions): array
{
    $packages = $versions->coreWebIdentity()['packages'] ?? null;
    if (!is_array($packages)) {
        throw new RuntimeException('application inventory Core Web package identity is invalid');
    }
    $archives = [];
    foreach ($packages as $package => $identity) {
        if (!is_string($package) || !is_array($identity)) {
            throw new RuntimeException('application inventory Core Web package identity is invalid');
        }
        $archive = $identity['archive'] ?? null;
        if ($archive === null) {
            continue;
        }
        if (!is_string($archive)
            || preg_match('#^packages/core-web/peanut-admin-[a-z-]+-[0-9A-Za-z.+-]+\\.tgz$#D', $archive) !== 1
            || isset($archives[$archive])) {
            throw new RuntimeException('application inventory Core Web archive identity is invalid: ' . $package);
        }
        $archives[$archive] = true;
    }
    return $archives;
}

/** @return array<string,true> */
function declaredCorePhpArchives(string $root, \app\common\value\scaffold\VersionContract $versions): array
{
    $composer = json_decode((string) file_get_contents($root . '/server/composer.json'), true, 512, JSON_THROW_ON_ERROR);
    $archives = [];
    foreach ($composer['repositories'] ?? [] as $repository) {
        $package = $repository['package'] ?? null;
        if (($repository['type'] ?? null) !== 'package' || ($package['name'] ?? null) !== 'peanut-admin/core') { continue; }
        $url = $package['dist']['url'] ?? '';
        if (!is_string($url) || !str_starts_with($url, '../packages/core-php/')) { continue; }
        $archive = substr($url, 3);
        if ($archive !== 'packages/core-php/peanut-admin-core-' . $versions->corePhp() . '.zip'
            || ($package['dist']['type'] ?? null) !== 'zip') {
            throw new RuntimeException('application inventory Core PHP archive identity is invalid');
        }
        $archives[$archive] = true;
    }
    return $archives;
}

function inventoryGitFiles(string $root, array $declaredCoreWebArchives, array $declaredCorePhpArchives): array
{
    $local = in_array('--local', array_slice($GLOBALS['argv'], 1), true);
    if ($local) {
        $files = \app\common\value\scaffold\ScaffoldSourceIdentity::files($root);
    } else {
    $command = ['git', '-C', $root, '-c', 'core.quotepath=false', 'ls-files', '--cached', '--others', '--exclude-standard'];
    $pipes = [];
    $process = proc_open($command, [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);
    if (!is_resource($process)) {
        throw new RuntimeException('unable to run git ls-files');
    }
    $stdout = stream_get_contents($pipes[1]);
    $stderr = stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);
    if (proc_close($process) !== 0 || !is_string($stdout)) {
        throw new RuntimeException('git ls-files failed: ' . trim((string) $stderr));
    }
    $files = array_values(array_filter(explode("\n", trim($stdout)), 'strlen'));
    }
    $files = array_values(array_filter($files, static fn(string $path): bool => !ScaffoldConfiguration::matches($path, $GLOBALS['configuration']['inventory_omissions'])
        // Only archives declared by the active Core identity and dependency
        // declarations belong in APP baselines; stale development inputs do not.
        && (!str_starts_with($path, 'packages/core-web/') || !str_ends_with($path, '.tgz')
            || isset($declaredCoreWebArchives[$path]))
        && (!str_starts_with($path, 'packages/core-php/') || !str_ends_with($path, '.zip')
            || isset($declaredCorePhpArchives[$path]))
        && (file_exists($root . '/' . $path) || is_link($root . '/' . $path))));
    sort($files, SORT_STRING);
    return $files;
}

function classification(string $path): string
{
    $delivery = $GLOBALS['configuration']['delivery'];
    if (ScaffoldConfiguration::matches($path, $delivery['managed'])) { return 'managed'; }
    if (!in_array($path, $delivery['retained_paths'], true)
        && ScaffoldConfiguration::matches($path, $delivery['excluded'])) { return 'excluded'; }
    if (in_array($path, $delivery['generated_managed_paths'], true)) { return 'generated-managed'; }
    if (ScaffoldConfiguration::matches($path, $delivery['application_owned'])) { return 'app-owned'; }
    return 'managed';
}

function transform(string $path, string $classification): string
{
    if ($classification === 'excluded') { return 'copy'; }
    foreach ($GLOBALS['configuration']['transforms'] as $selection) {
        if (ScaffoldConfiguration::matches($path, $selection)) { return $selection['transform']; }
    }
    return 'copy';
}

function adapterKind(string $path): ?string
{
    foreach ($GLOBALS['configuration']['delivery']['adapters'] as $kind => $paths) {
        if (in_array($path, $paths, true)) { return $kind; }
    }
    return null;
}

/** @return list<string> */
function profilesForPath(string $path): array
{
    $delivery = $GLOBALS['configuration']['delivery'];
    foreach ($delivery['profile_overrides'] as $prefix => $profiles) {
        if (str_starts_with($path, $prefix)) { return $profiles; }
    }
    return $delivery['default_profiles'];
}

function sourceDigest(string $absolute, string $path, string $transform): string
{
    // These transforms intentionally rebuild the target from application parameters;
    // their source prose is not part of the generated bytes or adoption contract.
    if (!str_starts_with($path, 'server/resources/scaffold-application/')
        && in_array($transform, ['changelog', 'release-metadata', 'resources', 'readme', 'docs-page', 'version-contract'], true)) {
        return hash('sha256', "peanut.create-app-semantic-source.v1\0{$path}\0{$transform}");
    }
    $digest = hash_file('sha256', $absolute);
    if (!is_string($digest)) {
        throw new RuntimeException('unable to hash inventory source: ' . $absolute);
    }
    return $digest;
}

$entries = [];
$coreWebArchives = declaredCoreWebArchives($versions);
$corePhpArchives = declaredCorePhpArchives($root, $versions);
foreach (inventoryGitFiles($root, $coreWebArchives, $corePhpArchives) as $path) {
    $absolute = $root . '/' . $path;
    $mapping = $configuration['file_mappings'][$path] ?? null;
    $target = $mapping['target'] ?? $path;
    $classification = $mapping['classification'] ?? classification($path);
    if (!file_exists($absolute) && $classification === 'excluded') {
        continue;
    }
    if ((!is_file($absolute) && $path !== 'scaffold/application-template-inventory.json') || is_link($absolute)) {
        throw new RuntimeException('inventory only supports regular files: ' . $path);
    }
    $entry = [
        'path' => $path,
        'target' => $target,
        'classification' => $classification,
        'owner' => $configuration['delivery']['owner_by_classification'][$classification],
        'transform' => $mapping['transform'] ?? transform($path, $classification),
        'mode' => is_file($absolute) && (fileperms($absolute) & 0111) !== 0 ? 0755 : 0644,
        'profiles' => $mapping['profiles'] ?? profilesForPath($path),
    ];
    if ($classification !== 'excluded') {
        $entry['source_sha256'] = sourceDigest($absolute, $path, $entry['transform']);
    }
    $adapterKind = adapterKind($path);
    if ($adapterKind !== null) {
        $entry['adapter_kind'] = $adapterKind;
    }
    $entries[] = $entry;
}

$inventory = [
    'schema_version' => 2,
    'template_version' => $versions->scaffoldTemplate(),
    'protocol' => 'peanut.create-app-inventory.v2',
    'application' => ['version' => $versions->generatedInstanceDefault()],
    'variables' => $configuration['variables'],
    'files' => $entries,
];
$json = json_encode($inventory, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n";
if (in_array('--check', array_slice($argv, 1), true)) {
    $actual = is_file($output) ? file_get_contents($output) : false;
    if (!is_string($actual) || !hash_equals($json, $actual)) {
        fwrite(STDERR, "application template inventory is stale\n");
        exit(1);
    }
    echo "CREATE-APP-INVENTORY-001 passed\n";
    exit(0);
}
if (file_put_contents($output, $json) === false) {
    throw new RuntimeException('unable to write inventory');
}
echo "wrote scaffold/application-template-inventory.json with " . count($entries) . " entries\n";
