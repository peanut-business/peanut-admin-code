#!/usr/bin/env php
<?php
declare(strict_types=1);

$root = dirname(__DIR__);
$output = $root . '/scaffold/application-template-inventory.json';
require_once $root . '/server/app/common/value/scaffold/VersionContract.php';
$versions = \app\common\value\scaffold\VersionContract::load($root . '/release-versions.json');

function inventoryGitFiles(string $root): array
{
    $command = ['git', '-C', $root, '-c', 'core.quotepath=false', 'ls-files', '--cached', '--others', '--exclude-standard'];
    $pipes = [];
    $process = proc_open($command, [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);
    if (!is_resource($process)) {
        throw new RuntimeException('unable to run git ls-files');
    }
    $stdout = stream_get_contents($pipes[1]);
    $stderr = stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);
    if (proc_close($process) !== 0 || !is_string($stdout)) {
        throw new RuntimeException('git ls-files failed: ' . trim((string)$stderr));
    }
    $files = array_values(array_filter(explode("\n", trim($stdout)), 'strlen'));
    $files = array_values(array_filter($files, static fn(string $path): bool => $path !== 'scaffold/application-template-inventory.json'
        && !str_starts_with($path, 'scaffold/')
        && $path !== 'SECURITY.md' // Generated applications receive their own declared security template.
        && !str_starts_with($path, 'output/')
        && (file_exists($root . '/' . $path) || is_link($root . '/' . $path))));
    sort($files, SORT_STRING);
    return $files;
}

function excluded(string $path): bool
{
    // Repository delivery/editor settings do not belong to generated applications.
    if (str_starts_with($path, '.githooks/') || str_starts_with($path, '.vscode/')
        || str_starts_with($path, 'evidence/')
        || str_starts_with($path, 'deploy/tests/')) {
        return true;
    }
    if (str_starts_with($path, 'server/tests/') && !in_array($path, [
        'server/tests/Multitenancy/NativeAdminIdentityRuntimeContractTest.php',
        'server/tests/Multitenancy/OfficialCapabilityTenantQualificationTest.php',
        'server/tests/Productization/FreshSchemaBaselineTest.php',
    ], true)) {
        return true;
    }
    if (str_starts_with($path, 'server/tests/fixtures/core-upgrade-compatibility/')) {
        return true;
    }
    if ((str_starts_with($path, 'scripts/p0e-') || $path === 'scripts/consumer-upgrade-qualification')
        || $path === 'resources/p0e-runtime-qualification.json'
        || $path === 'server/tests/Productization/P0eRuntimeQualificationTest.php'
        || str_starts_with($path, 'server/tests/fixtures/p0e-runtime-qualification/')) {
        return true;
    }
    return str_starts_with($path, 'output/')
        || (str_starts_with($path, 'docs/') && !in_array($path, [
            'docs/peanut-admin-development-guide.md',
            'docs/peanut-admin-release-deployment.md',
            'docs/peanut-admin-user-manual.md',
            'docs/plugin-module-development.md',
        ], true))
        || in_array($path, [
            'AGENTS.md', 'AGENT_EXECUTION_RULES.md', 'SECURITY.md',
            'resources/codegraph-registry.json', 'resources/service-registry.json',
            'resources/consumer-ready-control.json',
            'scripts/create-app', 'scripts/build-application-template-inventory', 'scripts/build-scaffold-release',
            'scripts/check-test-integrity', 'scripts/generate-all-modules-packaging-evidence',
            'scripts/build-edition-installers', 'scripts/build-edition-upgrades',
            'scripts/core-qualification-runner',
            'scripts/core-upgrade-compatibility', 'scripts/combined-upgrade-qualification',
            'scripts/consumer-module-reference-chain', 'scripts/consumer-ready-control',
            'scripts/select-legacy-pre-alpha5-fixture',
            'scripts/test-core-upgrade-public-entry-gate',
            'scripts/check-product-capability-ledger',
            'scripts/check-release-consistency', 'scripts/generate-release-legal.mjs', 'scripts/publish-github-release',
            'server/database/seed-multi-tenant-demo.php',
            'docs-site/.vitepress/theme/ProductStatus.vue',
            'server/tests/Productization/CreateApplicationTest.php',
            'server/tests/Productization/CombinedUpgradePolicyTest.php',
            '.github/workflows/core-upgrade-compatibility.yml',
            '.github/workflows/product-capability-ledger.yml',
            '.github/workflows/docs-site.yml',
            '.github/workflows/repository-policy.yml',
            '.github/workflows/resource-registry.yml',
            '.github/pull_request_template.md',
            'server/tests/Productization/ScaffoldUpgradeRunnerTest.php',
            'scripts/scaffold-upgrade',
        ], true)
        || str_starts_with($path, 'server/app/common/infrastructure/scaffold/')
        || str_starts_with($path, 'scripts/scaffold-runtime/')
        || str_starts_with($path, 'web/.claude/')
        || str_starts_with($path, 'plugins/fixture.delivery-record/')
        || str_starts_with($path, 'server/app/modules/fixture/delivery_record/')
        || str_starts_with($path, 'server/fixtures/plugin-module-lifecycle/')
        || str_starts_with($path, 'web/src/modules/fixture-delivery-record/')
        || $path === 'web/tests/Productization/plugin-contribution.test.ts'
        || str_starts_with($path, 'scaffold/')
        || str_starts_with($path, 'server/tests/fixtures/scaffold-upgrade/');
}

function classification(string $path): string
{
    $managedHostPaths = [
        'server/app/AppService.php',
        'server/app/BaseController.php',
        'server/app/middleware.php',
        'server/app/adminapi/middleware.php',
        'server/app/api/middleware.php',
        'server/app/installation/middleware.php',
        'server/app/platform/middleware.php',
        'server/app/adminapi/http/middleware/AuthMiddleware.php',
        'server/app/adminapi/http/middleware/LoginMiddleware.php',
        'server/app/adminapi/http/middleware/OperationLogMiddleware.php',
        'server/app/api/middleware/CheckTokenMiddleware.php',
        'server/app/api/middleware/PublicTenantModuleMiddleware.php',
        'server/app/common/http/middleware/InstallationStateMiddleware.php',
        'server/app/common/http/middleware/MaintenanceWriteGateMiddleware.php',
        'server/app/common/traits/ApiResponseTrait.php',
        'server/app/common/traits/CrudTrait.php',
        'server/app/common/validate/InputValidator.php',
        'server/app/common/validate/ListsValidate.php',
        'server/app/common/validate/MemberProfileSelfFieldValidate.php',
        'server/app/common/validate/PageSizeRule.php',
        'server/app/common/validate/TenantContextValidate.php',
        'server/app/common/validate/ValidatedInput.php',
        'server/app/installation/http/middleware/InstallationExecutionMiddleware.php',
        'server/app/platform/http/middleware/PlatformHostMiddleware.php',
        'server/app/platform/http/middleware/PlatformInstanceToolMiddleware.php',
        'server/app/platform/http/middleware/PlatformLoginMiddleware.php',
        'server/app/platform/http/middleware/PlatformPermissionMiddleware.php',
        'server/app/common/contract/module/ModuleGovernanceProvider.php',
        'server/app/common/contract/module/PluginLifecycleCommands.php',
        'server/app/common/contract/module/ModuleQualificationQuery.php',
        'server/app/common/contract/module/ModuleQualification.php',
        'server/app/common/contract/module/TenantModuleState.php',
        'server/app/common/persistence/AdvisoryLockExecution.php',
        'server/app/common/persistence/AdvisoryLockUnavailable.php',
        'server/app/common/persistence/TenantPersistenceConfiguration.php',
        'server/app/common/infrastructure/module/ModuleHostLayoutFactory.php',
        'server/app/common/value/module/ModulePhpNamespace.php',
        'server/app/platform/infrastructure/module/ThinkPhpModuleGovernanceProvider.php',
        'server/app/platform/infrastructure/module/DeployedTenantModuleRegistry.php',
        'server/app/platform/services/module/ModuleQualificationQueryService.php',
        'server/app/platform/validation/module/OpisManifestSchemaValidator.php',
        'server/app/platform/validation/module/ReflectionContractInspector.php',
        'server/app/platform/validation/module/StrictVersionConstraintMatcher.php',
        'server/app/platform/services/plugin/PluginLifecycleService.php',
        'server/app/platform/exception/plugin/PluginLifecycleException.php',
        'server/app/platform/value/plugin/PluginDescriptor.php',
        'server/app/platform/infrastructure/plugin/PluginLockResolver.php',
        'server/app/platform/composition/plugin/PluginModuleRegistryFactory.php',
        'server/app/platform/composition/plugin/ModuleDefinitionRegistryFactory.php',
        'server/app/platform/policy/plugin/ModuleLifecyclePolicy.php',
        'server/app/platform/infrastructure/plugin/ModuleCatalogApplier.php',
        'server/app/platform/infrastructure/plugin/ScopedMenuCatalogRepository.php',
        'server/app/platform/infrastructure/plugin/ModuleCatalogMutationRepository.php',
    ];
    if (in_array($path, $managedHostPaths, true)) {
        return 'managed';
    }
    // Official Modules remain governed by their package/lock projection; customer extensions stay app-owned.
    if (str_starts_with($path, 'server/app/modules/official/')) {
        return 'managed';
    }
    if (excluded($path)) {
        return 'excluded';
    }
    if (in_array($path, [
        'README.md', 'LICENSE', 'NOTICE', 'THIRD_PARTY_NOTICES.md', 'RELEASE_SBOM.spdx.json',
        'CHANGELOG.md', 'RELEASE_METADATA.json', 'resources/project-resources.json',
        'server/config/brand.json', 'web/src/generated/brand.json', 'pc/generated/brand.json',
        'uniapp/src/generated/brand.json', 'docs-site/generated/brand.json',
    ], true)) {
        return 'generated-managed';
    }
    if (in_array($path, [
        'deploy/docker-compose.remote-development.yml', 'scripts/project-development-database.sh',
        'server/tests/Productization/DatabaseResourceRegistryTest.php',
        'scripts/local-stack.sh', 'scripts/local-php-runtime', 'scripts/local-environment-probe',
        'deploy/docker-compose.dev.yml', 'deploy/docker/php-development-entrypoint.sh',
        'deploy/docker/php-development.Dockerfile', 'deploy/nginx/development.conf',
        'deploy/local-stack.env.example',
    ], true)) {
        return 'excluded';
    }
    if ($path === 'server/database/seed-demo-data.php') {
        return 'managed';
    }
    if ($path === 'server/app/common/value/installation/ApplicationReleaseVersions.php') {
        return 'managed';
    }
    if ($path === 'scripts/seed-demo-data') {
        return 'app-owned';
    }
    if ($path === 'SECURITY.md') {
        return 'app-owned';
    }
    if (str_starts_with($path, 'docs-site/') || str_starts_with($path, 'platform/src/')
        || str_starts_with($path, 'server/app/') || str_starts_with($path, 'server/database/')
        || str_starts_with($path, 'server/tests/') || str_starts_with($path, 'web/src/views/')
        || str_starts_with($path, 'web/tests/') || str_starts_with($path, 'pc/pages/')
        || str_starts_with($path, 'pc/components/') || str_starts_with($path, 'uniapp/src/')
        || in_array($path, ['server/config/peanut.php', 'web/src/peanut.overrides.ts'], true)) {
        return 'app-owned';
    }
    return 'managed';
}

function transform(string $path, string $classification): string
{
    if ($classification === 'excluded') {
        return 'copy';
    }
    if ($path === 'README.md') return 'readme';
    if ($path === 'LICENSE' || $path === 'NOTICE') return 'license';
    if ($path === 'CHANGELOG.md') return 'changelog';
    if ($path === 'THIRD_PARTY_NOTICES.md') return 'third-party-notices';
    if ($path === 'RELEASE_SBOM.spdx.json') return 'sbom';
    if ($path === 'RELEASE_METADATA.json') return 'release-metadata';
    if ($path === 'resources/project-resources.json') return 'resources';
    if ($path === 'plugins.lock') return 'plugins-lock';
    if ($path === 'server/composer.lock') return 'composer-lock';
    if ($path === 'release-versions.json') return 'version-contract';
    if ($path === 'server/config/modules.php') return 'modules-config';
    if ($path === '.github/workflows/ci.yml') return 'ci';
    if ($path === 'server/database/environment-guard.php') return 'environment-guard';
    if ((str_starts_with($path, 'server/app/modules/') && basename($path) === 'composer.json')
        || (str_starts_with($path, 'web/src/modules/') && basename($path) === 'package.json')) {
        return 'text';
    }
    if ($path === 'SECURITY.md' || ((str_starts_with($path, 'docs-site/') || str_starts_with($path, 'docs/')) && str_ends_with($path, '.md'))) return 'docs-page';
    if (preg_match('#(^|/)(config/brand|generated/brand)\.json$#', $path) === 1) return 'brand';
    if (preg_match('#/brand/(logo|favicon)\.svg$#', $path) === 1) return 'brand-asset';
    if (preg_match('#(^|/)(composer\.json|package\.json|package-lock\.json|pnpm-lock\.yaml)$#', $path) === 1) return 'package';
    $basename = basename($path);
    $extension = strtolower(pathinfo($path, PATHINFO_EXTENSION));
    $textExtensions = ['php', 'json', 'md', 'sql', 'stub', 'ts', 'tsx', 'js', 'mjs', 'cjs', 'sh', 'lock', 'vue', 'css', 'less', 'scss', 'html', 'xml', 'yaml', 'yml', 'toml', 'txt', 'svg', 'conf', 'ini', 'env', 'example', 'dockerfile'];
    if (in_array($extension, $textExtensions, true)
        || str_starts_with($path, 'scripts/')
        || in_array($basename, ['compose.yaml', 'think', '.gitignore', '.dockerignore', '.env.example', '.htaccess'], true)
        || str_contains($basename, 'Dockerfile')) {
        return 'text';
    }
    return 'copy';
}

function adapterKind(string $path): ?string
{
    return match ($path) {
        'server/app/common/policy/permission/RegisteredAdminPermissionPolicy.php',
        'server/app/modules/official/reference_codes/src/Infrastructure/ThinkPhpTenantDictionaryProvider.php',
        'server/app/modules/official/reference_codes/src/Infrastructure/ThinkPhpSystemDictionaryProvider.php',
        'server/app/modules/official/task/src/Service/CrontabSchedulerService.php',
        'server/app/modules/official/settings/src/Infrastructure/TenantSettingWebsiteStore.php',
        'server/app/modules/official/import_export/src/Infrastructure/File/AppFileMediaGateway.php',
        'server/app/common/infrastructure/notice/ApplicationNoticeSmsSender.php',
        'server/app/common/services/notice/NoticeChannelService.php',
        'server/app/common/context/notice/NoticeTenantContext.php',
        'server/app/modules/official/notification/src/Service/VerificationCodeService.php' => 'framework-adapter',
        'server/app/modules/official/settings/src/Infrastructure/BrandDefaults.php',
        'server/app/modules/official/settings/src/Service/WebsiteConfigService.php',
        'server/app/common/infrastructure/crontab/CrontabTenantLock.php',
        'server/app/common/infrastructure/export/OperationLogExportProvider.php',
        'server/app/common/contract/notice/sms/SmsDriver.php',
        'server/app/common/infrastructure/notice/sms/AliyunSms.php',
        'server/app/common/infrastructure/notice/sms/TencentSms.php',
        'server/app/modules/official/oauth/src/Service/OAuthBrowserCallbackService.php',
        'server/app/common/infrastructure/oauth/WechatOAuthTransport.php',
        'web/src/core/tenant-session.ts',
        'web/src/core/runtime.ts' => 'application-provider',
        default => null,
    };
}

/** @return list<string> */
function profilesForPath(string $path): array
{
    // 已装配的官方模块包含运营端贡献；任何 profile 都不能丢失其声明的源码或宿主。
    // 是否构建/暴露运营入口仍由 EditionProjector 决定，不靠删除依赖文件实现。
    if (str_starts_with($path, 'docs-site/')) {
        return ['full'];
    }
    if (str_starts_with($path, 'pc/') || str_starts_with($path, 'uniapp/')) {
        return ['standard', 'full'];
    }
    return ['minimal', 'standard', 'full'];
}

function sourceDigest(string $absolute, string $path, string $transform): string
{
    // These transforms intentionally rebuild the target from application parameters;
    // their source prose is not part of the generated bytes or adoption contract.
    if (!str_starts_with($path, 'server/resources/scaffold-application/')
        && in_array($transform, ['changelog', 'release-metadata', 'resources', 'readme', 'docs-page', 'version-contract'], true)) {
        return hash('sha256', "peanut.create-app-semantic-source.v1\0{$path}\0{$transform}");
    }
    $digest = hash_file('sha256', $absolute);
    if (!is_string($digest)) {
        throw new RuntimeException('unable to hash inventory source: ' . $absolute);
    }
    return $digest;
}

$entries = [];
foreach (inventoryGitFiles($root) as $path) {
    $absolute = $root . '/' . $path;
    $templatePrefix = 'server/resources/scaffold-application/';
    $isApplicationTemplate = str_starts_with($path, $templatePrefix) && str_ends_with($path, '.stub');
    $target = $isApplicationTemplate ? substr($path, strlen($templatePrefix), -5) : $path;
    $classification = $isApplicationTemplate ? 'app-owned' : classification($path);
    if (!file_exists($absolute) && $classification === 'excluded') {
        continue;
    }
    if ((!is_file($absolute) && $path !== 'scaffold/application-template-inventory.json') || is_link($absolute)) {
        throw new RuntimeException('inventory only supports regular files: ' . $path);
    }
    $entry = [
        'path' => $path,
        'target' => $target,
        'classification' => $classification,
        'owner' => $classification === 'app-owned' ? 'application' : ($classification === 'excluded' ? 'template-source-only' : 'scaffold'),
        'transform' => $isApplicationTemplate ? 'docs-page' : transform($path, $classification),
        'mode' => is_file($absolute) && (fileperms($absolute) & 0111) !== 0 ? 0755 : 0644,
        'profiles' => $isApplicationTemplate ? ['minimal', 'standard', 'full'] : profilesForPath($path),
    ];
    if ($classification !== 'excluded') {
        $entry['source_sha256'] = sourceDigest($absolute, $path, $entry['transform']);
    }
    $adapterKind = adapterKind($path);
    if ($adapterKind !== null) {
        $entry['adapter_kind'] = $adapterKind;
    }
    $entries[] = $entry;
}

$inventory = [
    'schema_version' => 2,
    'template_version' => $versions->scaffoldTemplate(),
    'protocol' => 'peanut.create-app-inventory.v2',
    'application' => ['version' => $versions->generatedInstanceDefault()],
    'variables' => ['APPLICATION_VERSION', 'PACKAGE_IDENTITY', 'PRODUCT_NAME', 'SLUG'],
    'untracked_exclusions' => [
        '.git/**', '.local/**', '.env', 'server/.env', '**/vendor/**', '**/node_modules/**',
        '**/dist/**', '**/runtime/**', '**/.cache/**', 'server/public/uploads/**',
        'server/public/storage/**', 'output/**', '*.log', '.DS_Store',
    ],
    'files' => $entries,
];
$json = json_encode($inventory, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n";
if (in_array('--check', array_slice($argv, 1), true)) {
    $actual = is_file($output) ? file_get_contents($output) : false;
    if (!is_string($actual) || !hash_equals($json, $actual)) {
        fwrite(STDERR, "application template inventory is stale\n");
        exit(1);
    }
    echo "CREATE-APP-INVENTORY-001 passed\n";
    exit(0);
}
if (file_put_contents($output, $json) === false) {
    throw new RuntimeException('unable to write inventory');
}
echo "wrote scaffold/application-template-inventory.json with " . count($entries) . " entries\n";
