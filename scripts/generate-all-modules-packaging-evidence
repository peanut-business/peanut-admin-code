#!/usr/bin/env php
<?php

declare(strict_types=1);

use app\platform\validation\plugin\ModulePackagePreflight;
use app\platform\services\plugin\PluginPackageArchiveService;

$root = dirname(__DIR__);
require $root . '/server/vendor/autoload.php';

function packagingEvidenceFail(string $message): never
{
    throw new RuntimeException($message);
}

/** @param list<string> $command @param array<string,string> $environment @return array{stdout:string,stderr:string} */
function packagingEvidenceRun(array $command, ?string $cwd = null, array $environment = []): array
{
    $pipes = [];
    $childEnvironment = [];
    foreach (['PATH', 'HOME', 'TMPDIR', 'SystemRoot', 'COMSPEC', 'PATHEXT'] as $osKey) {
        $osValue = getenv($osKey);
        if ($osValue !== false) {
            $childEnvironment[$osKey] = $osValue;
        }
    }
    foreach ($environment as $key => $value) {
        $childEnvironment[(string) $key] = (string) $value;
    }
    $process = proc_open(
        $command,
        [1 => ['pipe', 'w'], 2 => ['pipe', 'w']],
        $pipes,
        $cwd,
        $childEnvironment,
    );
    if (!is_resource($process)) {
        packagingEvidenceFail('unable to start packaging evidence command');
    }
    $stdout = stream_get_contents($pipes[1]);
    $stderr = stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);
    $code = proc_close($process);
    if ($code !== 0) {
        packagingEvidenceFail(
            'packaging evidence command failed(' . $code . '): ' . trim((string) $stderr),
        );
    }
    return ['stdout' => (string) $stdout, 'stderr' => (string) $stderr];
}

function packagingEvidenceArgument(array $arguments, string $name, string $default): string
{
    $value = $default;
    foreach ($arguments as $argument) {
        if (!str_starts_with($argument, '--' . $name . '=')) {
            packagingEvidenceFail('Usage: php scripts/generate-all-modules-packaging-evidence [--output=<absolute-json-path>]');
        }
        if ($value !== $default) {
            packagingEvidenceFail('duplicate --' . $name . ' option');
        }
        $value = substr($argument, strlen('--' . $name . '='));
    }
    if ($value === '' || !str_starts_with($value, '/')) {
        packagingEvidenceFail('--' . $name . ' must be an absolute path');
    }
    return $value;
}

/** @return array{files:int,sha256:string,filename_dev_tools_hits:list<string>,symbol_hits:list<string>} */
function packagingEvidenceDistFacts(string $root): array
{
    $rows = [];
    $filenameDevToolsHits = [];
    $symbols = [
        'dev-tools',
        'instance-tools/modules',
        'MODULE_RUNTIME_MUTATION_DISABLED',
        'platform.module.read',
        'platform.module.install',
        'platform.module.uninstall',
        'platform.module.disable',
        'platform.module.sync',
    ];
    $symbolHits = [];
    if (!is_dir($root)) {
        packagingEvidenceFail('production Web build output is missing: ' . $root);
    }
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS),
    );
    foreach ($iterator as $file) {
        if ($file->isLink() || !$file->isFile()) {
            packagingEvidenceFail('production Web build output contains a non-regular entry');
        }
        $relative = str_replace('\\', '/', substr($file->getPathname(), strlen($root) + 1));
        $digest = hash_file('sha256', $file->getPathname());
        if (!is_string($digest)) {
            packagingEvidenceFail('production Web build output digest is unavailable: ' . $relative);
        }
        $rows[] = $relative . "\0" . $digest . "\0" . ($file->getPerms() & 0777);
        if (str_contains(strtolower($relative), 'dev-tools')) {
            $filenameDevToolsHits[] = $relative;
        }
        $contents = file_get_contents($file->getPathname());
        if (!is_string($contents)) {
            packagingEvidenceFail('production Web build output is unreadable: ' . $relative);
        }
        foreach ($symbols as $symbol) {
            if (str_contains($contents, $symbol)) {
                $symbolHits[$symbol] = true;
            }
        }
    }
    sort($rows, SORT_STRING);
    sort($filenameDevToolsHits, SORT_STRING);
    $symbolHits = array_keys($symbolHits);
    sort($symbolHits, SORT_STRING);
    return [
        'files' => count($rows),
        'sha256' => hash('sha256', implode("\n", $rows)),
        'filename_dev_tools_hits' => $filenameDevToolsHits,
        'symbol_hits' => $symbolHits,
    ];
}

$outputPath = packagingEvidenceArgument(
    array_slice($argv, 1),
    'output',
    '/tmp/module-packages-test/packaging-results.json',
);
$outputDirectory = dirname($outputPath);
if (!is_dir($outputDirectory) && !mkdir($outputDirectory, 0775, true) && !is_dir($outputDirectory)) {
    packagingEvidenceFail('packaging evidence output directory is unavailable: ' . $outputDirectory);
}

$candidate = trim(packagingEvidenceRun(['git', '-C', $root, 'rev-parse', 'HEAD^{commit}'])['stdout']);
$sourceTree = trim(packagingEvidenceRun(['git', '-C', $root, 'rev-parse', 'HEAD^{tree}'])['stdout']);
if (preg_match('/^[a-f0-9]{40}$/D', $candidate) !== 1
    || preg_match('/^[a-f0-9]{40}$/D', $sourceTree) !== 1) {
    packagingEvidenceFail('current source identity is invalid');
}
if (trim(packagingEvidenceRun(['git', '-C', $root, 'status', '--porcelain', '--untracked-files=normal'])['stdout']) !== '') {
    packagingEvidenceFail('source worktree must be clean before generating packaging evidence');
}

$pluginLock = json_decode((string) file_get_contents($root . '/plugins.lock'), true, 64, JSON_THROW_ON_ERROR);
if (!is_array($pluginLock['plugins'] ?? null) || !array_is_list($pluginLock['plugins'])) {
    packagingEvidenceFail('Bundled Plugin lock is invalid');
}
$moduleKeys = [];
foreach ($pluginLock['plugins'] as $plugin) {
    if (!is_array($plugin)) {
        packagingEvidenceFail('Bundled Plugin lock entry is invalid');
    }
    foreach ($plugin['modules'] ?? [] as $module) {
        $key = is_array($module) ? ($module['key'] ?? null) : null;
        if (!is_string($key) || !str_starts_with($key, 'official.')) {
            continue;
        }
        if (isset($moduleKeys[$key])) {
            packagingEvidenceFail('Bundled official Module is duplicated: ' . $key);
        }
        $moduleKeys[$key] = true;
    }
}
$moduleKeys = array_keys($moduleKeys);
sort($moduleKeys, SORT_STRING);
if ($moduleKeys === []) {
    packagingEvidenceFail('Bundled official Module inventory is empty');
}

$packageDirectory = $outputDirectory . '/packages';
if (!is_dir($packageDirectory) && !mkdir($packageDirectory, 0775, true) && !is_dir($packageDirectory)) {
    packagingEvidenceFail('Module package output directory is unavailable: ' . $packageDirectory);
}
$archiveService = new PluginPackageArchiveService($root . '/server');
$preflight = new ModulePackagePreflight($root);
$results = [];
foreach ($moduleKeys as $moduleKey) {
    $archivePath = $packageDirectory . '/' . str_replace('.', '-', $moduleKey) . '.tar';
    $packed = $archiveService->packModule($moduleKey, $archivePath);
    $results[] = [
        'module_key' => $moduleKey,
        'version' => $preflight->inspect($moduleKey)['version'],
        'exit_code' => 0,
        'error' => null,
        'tar_path' => $packed['path'],
        'tar_size' => filesize($packed['path']),
        'sha256' => $packed['sha256'],
    ];
}

// The repository uses a Git worktree whose .git entry is a file. Husky's
// prepare hook is a local Git-hook install, not a production build input; CI
// already disables it for the same frozen dependency install.
packagingEvidenceRun(
    ['pnpm', '--dir', 'web', 'install', '--frozen-lockfile'],
    $root,
    ['HUSKY' => '0', 'CI' => '1'],
);
packagingEvidenceRun(['pnpm', '--dir', 'web', 'build'], $root);
$distFacts = packagingEvidenceDistFacts($root . '/web/dist');
$evidence = [
    'schema_version' => 2,
    'candidate' => $candidate,
    'source_tree' => $sourceTree,
    'results' => $results,
    'production_build' => [
        'command' => 'pnpm --dir web build',
        'install_command' => 'pnpm --dir web install --frozen-lockfile',
        'install_environment' => ['HUSKY' => '0', 'CI' => '1'],
        'candidate' => $candidate,
        'source_tree' => $sourceTree,
        'exit_code' => 0,
        'dist_path' => 'web/dist',
        'files' => $distFacts['files'],
        'tree_sha256' => $distFacts['sha256'],
        'filename_dev_tools_hits' => $distFacts['filename_dev_tools_hits'],
        'symbol_hits' => $distFacts['symbol_hits'],
    ],
];
$temporary = $outputPath . '.tmp-' . bin2hex(random_bytes(8));
$json = json_encode($evidence, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n";
if (file_put_contents($temporary, $json, LOCK_EX) === false || !rename($temporary, $outputPath)) {
    if (is_file($temporary)) {
        unlink($temporary);
    }
    packagingEvidenceFail('packaging evidence could not be promoted: ' . $outputPath);
}

echo 'wrote ' . $outputPath . ' for ' . count($moduleKeys) . " official Modules\n";
