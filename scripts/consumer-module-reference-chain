    $tenantAuth = $app->make(PeanutAdmin\Modules\Identity\Auth\TenantAuthService::class);
    $role = $roles->create($ownerContext, 'reference-member-b', 'Reference Member B', 'CR21 Tenant B no-permission role');
    $memberEmail = 'cr21-reference-member-b-' . bin2hex(random_bytes(4)) . '@example.test';
    $memberPassword = bin2hex(random_bytes(18)) . 'Aa1!';
    $member = $members->createAdministrator(
        $ownerContext,
        $memberEmail,
        'CR21 Reference Member B',
        $memberPassword,
        null,
        [(int)$role['id']],
        true,
    );
    $memberLogin = $tenantAuth->login(
        $memberEmail,
        $memberPassword,
        'tenant-b',
        '127.0.0.1',
        'CR21 reference chain member B',
        $requestId('tenant-login-member-b'),
    );
    if (!$memberLogin instanceof PeanutAdmin\Modules\Identity\Auth\TenantAuthentication) {
        throw new RuntimeException('CR21_REFERENCE_MEMBER_B_LOGIN_DID_NOT_AUTHENTICATE');
    }
    $memberContext = $tenantAuth->context($memberLogin->tokens->access->expose(), $requestId('tenant-member-b-context'));
    $principal = $authorization->principal($memberContext);
    if ($principal->root || $principal->tenantId !== $tenantId
        || $authorization->decide($memberContext, $principal, 'acme.reference-chain.write')->allowed) {
        throw new RuntimeException('CR21_REFERENCE_MEMBER_B_CROSSTENANT_AUTHORIZATION_LEAK');
    }
    $records = $app->make(Acme\Modules\ReferenceChain\Contract\ReferenceChainCommands::class);
    $expectReferencePermissionDenied(fn() => $records->create($memberContext, 'tenant-b-denied'), $pdo);
    echo json_encode($snapshot() + [
        'cross_tenant_member_authorization' => [
            'entry' => 'native_non_root_member_cross_tenant_denied',
            'member_id' => (int)$member['id'],
            'tenant_id' => (int)$memberContext->tenantId,
            'root' => $principal->root,
            'grant_visible' => false,
            'denied_zero_write' => true,
        ],
    ], JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), PHP_EOL;
    exit(0);
}
if ($action === 'disable-tenants') {
    $service = $app->make(PeanutAdmin\Modules\Identity\Platform\Application\PlatformTenantAdminService::class);
    foreach ($pdo->query("SELECT tenant_id FROM pa_tenant_module WHERE module_key='acme.reference-chain' AND status='enabled' ORDER BY tenant_id")->fetchAll() as $row) {
        $service->disableModule($platformContext(), (int)$row['tenant_id'], $module, 'CR21 Package maintenance prerequisite');
    }
    echo json_encode($snapshot(), JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), PHP_EOL;
    exit(0);
}
if ($action === 'service-read-default') {
    $records = $app->make(Acme\Modules\ReferenceChain\Contract\ReferenceChainCommands::class)->list($tenantContext('default'));
    echo json_encode($snapshot() + ['service_read' => $records], JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), PHP_EOL;
    exit(0);
}
if ($action === 'snapshot') {
    echo json_encode($snapshot(), JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), PHP_EOL;
    exit(0);
}
throw new RuntimeException('unknown CR21 helper action');
'''


def helper_action(
    helper: Path,
    consumer: Path,
    env: dict[str, str],
    action: str,
    log: Path,
    arguments: list[str] | None = None,
) -> dict[str, Any]:
    return json_output(
        command(
            [str(PHP), str(helper), str(consumer), action, *(arguments or [])],
            cwd=consumer,
            env=env,
            log=log,
        ),
        f"consumer helper {action}",
    )


def expect(condition: bool, message: str) -> None:
    if not condition:
        fail(message)


def tenant_statuses(snapshot: dict[str, Any]) -> dict[str, str]:
    rows = snapshot.get("tenant_modules", [])
    return {str(row["code"]): str(row["status"]) for row in rows if isinstance(row, dict)}


def rbac_counts(snapshot: dict[str, Any]) -> dict[str, int]:
    rows = snapshot.get("rbac", [])
    return {str(row["code"]): int(row["grants"]) for row in rows if isinstance(row, dict)}


def package_install(
    consumer: Path,
    env: dict[str, str],
    archive: Path,
    digest: str,
    log: Path,
) -> dict[str, Any]:
    return run_think(consumer, env, [
        "module:install-package", str(archive), f"--sha256={digest}",
    ], log)


def package_update(
    consumer: Path,
    env: dict[str, str],
    archive: Path,
    digest: str,
    dry_run: bool,
    log: Path,
) -> dict[str, Any]:
    arguments = [
        "module:update-package", str(archive), f"--sha256={digest}",
    ]
    if dry_run:
        arguments.append("--dry-run")
    return run_think(consumer, env, arguments, log)


def package_disable(
    consumer: Path,
    env: dict[str, str],
    log: Path,
) -> dict[str, Any]:
    return run_think(consumer, env, ["module:disable-package", MODULE_KEY], log)


def preview_and_execute(
    consumer: Path,
    env: dict[str, str],
    output: Path,
    purge: bool,
    log: Path,
) -> tuple[dict[str, Any], dict[str, Any]]:
    arguments = ["module:uninstall-package", MODULE_KEY]
    if purge:
        arguments.append("--purge")
    preview = run_think(consumer, env, arguments, log)
    plan = preview.get("confirm_plan")
    digest = preview.get("plan_digest")
    expect(isinstance(plan, dict) and isinstance(digest, str) and re.fullmatch(r"[a-f0-9]{64}", digest) is not None,
           "retire/purge preview did not return its canonical confirmation")
    plan_path = output / ("purge-plan.json" if purge else "retire-plan.json")
    write_json(plan_path, plan, 0o600)
    execute = [*arguments, f"--confirm-plan-file={plan_path}", f"--confirm-plan-digest={digest}"]
    result = run_think(consumer, env, execute, log)
    return preview, result


def p0e_installer_inputs(args: argparse.Namespace, candidate_tree: str) -> dict[str, Any]:
    """Authenticate a build-derived Installer inside the fixed native P0-E lease."""
    plan_path = Path(args.qualification_plan)
    expect(plan_path.is_absolute() and plan_path.is_file() and not plan_path.is_symlink(),
           "P0-E requires its regular absolute qualification plan")
    value = read_json(plan_path)
    native = runpy.run_path(str(TOOL_ROOT / "scripts/p0e-runtime-qualification"))
    selection = value.get("selection_scope")
    expect(selection in ("full", "through-group", "selected-groups"), "P0-E selection scope is invalid")
    native_args = argparse.Namespace(
        candidate=args.candidate, run_id=value["run_id"], lease=args.lease,
        owner=value["owner"], thread=value["thread"], parent_lease=value["parent_lease"],
        output_dir=value["paths"]["output-dir"], cache_dir=value["paths"]["cache-dir"],
        http_port=value["ports"]["http"], docs_port=value["ports"]["docs"], minimum_release=False,
        through_group=value["through_group"],
        groups=",".join(value["groups"]) if selection == "selected-groups" else None,
        source_root=args.source_root, qualification_tool_commit=args.qualification_tool_commit,
        qualification_tool_files_sha256=args.qualification_tool_files_sha256,
    )
    native["configure_source"](native_args)
    expect(bool(native_args.owner) and bool(native_args.thread), "P0-E plan is not an owned execution plan")
    actual = native["plan"](native_args, require_clean=True)
    expect(value == actual and value["candidate_tree"] == candidate_tree,
           "P0-E plan differs from its fixed native inputs")
    native["verify_lease"](native_args, actual)
    cache = Path(value["paths"]["cache-dir"])
    output = Path(value["paths"]["output-dir"])
    if TOOL_BINDING is not None:
        binding_path = output / "qualification-tool-binding.json"
        expect(binding_path.is_file() and not binding_path.is_symlink()
               and not any(parent.is_symlink() for parent in binding_path.parents),
               "consumer qualification tool binding path is unsafe")
        binding = read_json(binding_path)
        expect(all(binding.get(key) == expected for key, expected in TOOL_BINDING.items())
               and binding.get("plan_sha256") == sha256(plan_path),
               "consumer qualification tool binding differs from the original plan")
    expect(plan_path == output / "plan.json" and "consumer-module-lifecycle" in value["groups"]
           and args.installer_mode == "formal" and args.edition == "multi-tenant"
           and args.database == value["databases"]["consumer_module_cycle"]
           and args.author_database == value["databases"]["multi_tenant_fresh"],
           "P0-E consumer scenario differs from the owned plan")
    filename = f"peanut-admin-{value['target_release']['version']}-multi-tenant.tar.gz"
    expect(Path(args.installer_package) == cache / "edition-artifacts" / filename
           and Path(args.installer_manifest) == cache / "edition-artifacts" / (filename + ".manifest.json"),
           "P0-E Installer is outside its generated artifact paths")
    receipt_path = output / "groups/generated-application.json"
    checkpoint_path = output / "checkpoint.json"
    for path in (plan_path, receipt_path, checkpoint_path, Path(args.installer_package), Path(args.installer_manifest)):
        expect(path.is_file() and not path.is_symlink()
               and not any(parent.is_symlink() for parent in path.parents),
               "P0-E derived input has an unsafe file identity")
    receipt = read_json(receipt_path)
    checkpoint = read_json(checkpoint_path)
    expect(receipt.get("schema_version") == 1 and receipt.get("status") == "passed"
           and receipt.get("candidate") == args.candidate and receipt.get("candidate_tree") == candidate_tree
           and receipt.get("target_release") == value["target_release"]
           and checkpoint.get("schema_version") == 1
           and checkpoint.get("candidate") == args.candidate and checkpoint.get("candidate_tree") == candidate_tree
           and checkpoint.get("lease") == args.lease and checkpoint.get("run_id") == value["run_id"]
           and checkpoint.get("parent_lease") == value["parent_lease"]
           and checkpoint.get("planned_groups") == value["groups"]
           and checkpoint.get("groups", {}).get("generated-application", {}).get("status") == "passed",
           "P0-E generated Installer has no matching completed native evidence")
    if TOOL_BINDING is not None:
        expect(checkpoint.get("qualification_tool_binding_sha256") == sha256(binding_path),
               "consumer checkpoint tool binding differs")
    edition = receipt.get("editions", {}).get("multi-tenant", {})
    artifact = read_json(Path(args.installer_manifest))
    expect(edition.get("archive_sha256") == args.installer_sha256
           and edition.get("installer_manifest_sha256") == args.installer_manifest_sha256
           and edition.get("application_manifest_sha256") == artifact.get("application", {}).get("manifest_sha256")
           and sha256(Path(args.installer_package)) == args.installer_sha256
           and sha256(Path(args.installer_manifest)) == args.installer_manifest_sha256,
           "P0-E Installer digests differ from the completed generated group")
    return value


def run_chain(args: argparse.Namespace) -> dict[str, Any]:
    global ROOT, LEASE_TOOL, COMPOSER, TOOL_BINDING
    native = runpy.run_path(str(TOOL_ROOT / "scripts/p0e-runtime-qualification"))
    TOOL_BINDING = native["configure_source"](args)
    if TOOL_BINDING is not None:
        expect(bool(args.qualification_plan), "independent qualification tools require the original P0-E plan")
        ROOT = Path(TOOL_BINDING["source_root"])
        LEASE_TOOL = ROOT / "scripts/project-resource-lease"
        COMPOSER = ROOT / "scripts/project-composer"
    if not re.fullmatch(r"[0-9a-f]{40}", args.candidate):
        fail("candidate must be an exact lowercase 40-hex commit")
    if command(["git", "rev-parse", "HEAD"]).strip() != args.candidate:
        fail("candidate does not match current HEAD")
    candidate_tree = command(["git", "rev-parse", "HEAD^{tree}"]).strip()
    if not re.fullmatch(r"[0-9a-f]{40}", candidate_tree):
        fail("candidate tree identity is invalid")
    if command(["git", "status", "--porcelain", "--untracked-files=all"]).strip() != "":
        fail("candidate worktree must be clean")
    installer_package = Path(args.installer_package)
    installer_manifest = Path(args.installer_manifest)
    for path, label in ((installer_package, "--installer-package"), (installer_manifest, "--installer-manifest")):
        if not path.is_absolute() or not path.is_file() or path.is_symlink():
            fail(f"{label} must name one regular absolute file")
    installer_artifact = read_json(installer_manifest)
    artifact_input = validate_installer_artifact(
        args,
        candidate_tree,
        installer_package,
        installer_manifest,
        installer_artifact,
    )
    if not re.fullmatch(r"[a-z][a-z0-9_]{0,63}", args.database):
        fail("database name is invalid")
    expect(bool(args.author_database), "--author-database is required for independent Application A")
    expect(args.author_database != args.database, "author and consumer runtime databases must differ")
    output = Path(args.output)
    if not output.is_absolute() or output == Path("/") or output.exists() or output.is_symlink():
        fail("output must be an absent absolute path")
    metadata, resources = lease_fields(args.lease)
    resource_set = set(resources)
    qualification = None
    if metadata.get("gate") == "p0e-runtime-qualification":
        expect(bool(args.qualification_plan), "P0-E consumer requires its native qualification plan")
        qualification = p0e_installer_inputs(args, candidate_tree)
        cache_roots = [Path(value) for kind, value in resources if kind == "cache-dir"]
        expect(len(cache_roots) == 1 and output == cache_roots[0] / "consumer-module-lifecycle",
               "P0-E consumer output is outside the lease-owned cache")
        expected_resources = {
            ("resource-id", args.database_resource),
            ("endpoint", args.endpoint),
            ("mysql-db", args.database),
            ("mysql-db", args.author_database),
        }
    else:
        expect(not args.qualification_plan, "qualification plan is only valid for the native P0-E lease")
        expected_resources = {
            ("database-resource", args.database_resource),
            ("endpoint", args.endpoint),
            ("database", args.database),
            ("output-root", str(output)),
            ("cache-root", str(output / "cache")),
        }
        expected_resources.update({
            ("installer-archive", str(installer_package)),
            ("installer-archive-sha256", args.installer_sha256),
            ("installer-manifest", str(installer_manifest)),
            ("installer-manifest-sha256", args.installer_manifest_sha256),
        })
    expect(metadata.get("candidate") == args.candidate and metadata.get("status") == "ACTIVE",
           "active lease candidate does not match")
    expect(metadata.get("worktree") == str(ROOT), "active lease worktree does not match")
    expect(expected_resources.issubset(resource_set), "lease is missing a consumer Module resource")
    expect(("database", args.author_database) in resource_set, "author database is not leased")
    registered_database(args.database_resource, args.endpoint, args.database, qualification)
    registered_database(args.database_resource, args.endpoint, args.author_database, qualification)
    assert_empty_database(args.database)
    assert_empty_database(args.author_database)

    output.mkdir(mode=0o700, parents=True)
    logs = output / "logs"
    author = output / "application-a"
    consumer = output / "application-b"
    cache = output / "cache/composer"
    cache.mkdir(parents=True)
    completed = False
    identity_context = output / "consumer-identity-context.json"
    identity_seed_path = consumer / "server/.env.cr21.identity-seed"
    try:
        extract_installer(installer_package, installer_artifact, author)
        extract_installer(installer_package, installer_artifact, consumer)
        template_version = str(installer_artifact.get("product", {}).get("version", ""))
        for project in [author, consumer]:
            manifest = read_json(project / ".peanut/application-manifest.json")
            expect(manifest.get("template", {}).get("source_commit") == args.candidate
                   and manifest.get("template", {}).get("source_tree") == candidate_tree
                   and manifest.get("template", {}).get("version") == template_version
                   and manifest.get("generation_source", {}).get("commit") == args.candidate
                   and manifest.get("generation_source", {}).get("tree") == candidate_tree
                   and manifest.get("application", {}).get("edition") == args.edition,
                   "generated application did not use the fixed candidate")
            expect(not (project / ".git").exists(), "generated application retained source Git metadata")
            for relative in (
                "scripts/project-composer",
                "server/think",
                "server/app/command/ModuleCreate.php",
                "server/app/command/ModuleCheck.php",
                "server/app/command/ModulePack.php",
                "server/app/command/ModuleAdoptPackage.php",
                "server/app/command/ModuleInstallPackage.php",
                "server/app/command/ModuleUpdatePackage.php",
                "server/app/command/ModuleDisablePackage.php",
                "server/app/command/ModuleUninstallPackage.php",
            ):
                tool = project / relative
                expect(tool.is_file() and not tool.is_symlink(), f"generated Module tool is unavailable: {relative}")
                source = tool.read_text(encoding="utf-8")
                expect(
                    str(ROOT) not in source
                    and "/peanut-admin-project/" not in source
                    and "Project/docs" not in source,
                    f"generated Module tool retained a maintainer-private path: {relative}",
                )
            # The package identity is already checked. Prepare only the owner's
            # private preflight directories; installation state remains native.
            for relative in ("server/private", "server/private/installation", "server/private/resources"):
                directory = project / relative
                expect(not directory.is_symlink() and (not directory.exists() or directory.is_dir()),
                       "generated private preflight directory is unsafe")
                directory.mkdir(mode=0o700, parents=True, exist_ok=True)
                directory.chmod(0o700)
        author_resource = "cr21-author-mysql84-development"
        author_endpoint = "cr21-author-mysql84-development-host"
        consumer_resource = "cr21-consumer-mysql84-development"
        consumer_endpoint = "cr21-consumer-mysql84-development-host"
        configured_registries = {
            "application_a": configure_generated_database(
                author,
                author_resource,
                author_endpoint,
                args.author_database,
            ),
            "application_b": configure_generated_database(
                consumer,
                consumer_resource,
                consumer_endpoint,
                args.database,
            ),
        }
        owned_before = {"application_a": app_owned_proof(author), "application_b": app_owned_proof(consumer)}

        author_env = backend_environment(
            author / "server/.env.cr21",
            args.author_database,
            author_resource,
            author_endpoint,
            args.edition,
        )
        consumer_env = backend_environment(
            consumer / "server/.env.cr21",
            args.database,
            consumer_resource,
            consumer_endpoint,
            args.edition,
        )
        install_dependencies(author, cache, author_env, logs / "composer-a.log")
        install_dependencies(consumer, cache, consumer_env, logs / "composer-b.log")
        author_install = author / "server/.env.cr21.installation"
        author_credentials = "ADMIN_INITIAL_EMAIL=author@example.test\nADMIN_INITIAL_PASSWORD=" + secrets.token_urlsafe(24) + "\n"
        if args.edition == "multi-tenant":
            author_credentials += "PLATFORM_INITIAL_EMAIL=author-platform@example.test\nPLATFORM_INITIAL_PASSWORD=" + secrets.token_urlsafe(24) + "\n"
        author_install.write_text(author_credentials, encoding="utf-8")
        author_install.chmod(0o600)
        try:
            author_initialized = json_output(command(
                [str(PHP), "server/database/install.php"], cwd=author,
                env=author_env | {"PEANUT_INSTALLATION_ENV_FILE": str(author_install)},
                log=logs / "author-install.log",
            ), "author fresh install")
            expect(author_initialized.get("state") == "installed"
                   and int(author_initialized.get("health", {}).get("installed_table_count", 0)) > 0,
                   "author fixed-package application was not installed")
        finally:
            author_install.unlink(missing_ok=True)

        created = run_think(author, author_env, ["module:create", MODULE_KEY, "--vendor=acme", "--client=admin-web"], logs / "author.log")
        expect(created.get("module_key") == MODULE_KEY, "module:create returned another identity")
        backend, frontend = author_module_v1(author)
        check_v1 = run_think(author, author_env, ["module:check", MODULE_KEY], logs / "author.log")
        expect(check_v1.get("status") == "ready" and len(check_v1.get("checks", [])) == 8,
               "module:check v1 did not pass all eight checks")
        v1_path = output / "acme-reference-chain-v1.tar"
        packed_v1 = run_think(author, author_env, [
            "module:pack", MODULE_KEY, f"--output={v1_path}",
        ], logs / "author.log")
        v1_sha = str(packed_v1.get("sha256", ""))
        expect(v1_sha == sha256(v1_path), "v1 package digest changed")
        check_v1_package = run_think(author, author_env, [
            "module:check", MODULE_KEY, f"--package={v1_path}", f"--sha256={v1_sha}",
        ], logs / "author.log")
        expect(check_v1_package.get("status") == "ready", "module:check did not accept canonical v1 package")

        installation_path = consumer / "server/.env.cr21.installation"
        admin_email = "cr21-admin@example.test"
        admin_password = secrets.token_urlsafe(24)
        platform_email = "cr21-platform@example.test"
        platform_password = secrets.token_urlsafe(24)
        tenant_b_email = "cr21-tenant-b-owner@example.test"
        tenant_b_password = secrets.token_urlsafe(24)
        installation_credentials = (
            f"ADMIN_INITIAL_EMAIL={admin_email}\n"
            f"ADMIN_INITIAL_PASSWORD={admin_password}\n"
        )
        if args.edition == "multi-tenant":
            installation_credentials += (
                f"PLATFORM_INITIAL_EMAIL={platform_email}\n"
                f"PLATFORM_INITIAL_PASSWORD={platform_password}\n"
            )
        installation_path.write_text(
            installation_credentials,
            encoding="utf-8",
        )
        installation_path.chmod(0o600)
        identity_seed_path.write_text(
            (
                f"ADMIN_INITIAL_EMAIL={admin_email}\n"
                f"ADMIN_INITIAL_PASSWORD={admin_password}\n"
                f"PLATFORM_INITIAL_EMAIL={platform_email}\n"
                f"PLATFORM_INITIAL_PASSWORD={platform_password}\n"
                f"TENANT_B_OWNER_EMAIL={tenant_b_email}\n"
                f"TENANT_B_OWNER_PASSWORD={tenant_b_password}\n"
            ),
            encoding="utf-8",
        )
        identity_seed_path.chmod(0o600)
        install_env = consumer_env | {"PEANUT_INSTALLATION_ENV_FILE": str(installation_path)}
        helper = output / "consumer-lifecycle.php"
        helper.write_text(lifecycle_helper(), encoding="utf-8")
        helper.chmod(0o600)
        try:
            installed = json_output(command(
                [str(PHP), "server/database/install.php"], cwd=consumer, env=install_env, log=logs / "consumer.log"
            ), "consumer fresh install")
            expect(installed.get("state") == "installed"
                   and int(installed.get("health", {}).get("installed_table_count", 0)) > 0,
                   "consumer fresh install did not create the canonical schema")
            issued_identity = helper_action(
                helper,
                consumer,
                consumer_env,
                "issue-identities",
                logs / "consumer.log",
                [str(identity_context), str(identity_seed_path)],
            )
            expect(
                issued_identity.get("status") == "issued"
                and issued_identity.get("identity_context_file") == "written_0600"
                and not identity_context.is_symlink()
                and (identity_context.stat().st_mode & 0o777) == 0o600,
                "native authentication did not produce a private identity context",
            )
        finally:
            installation_path.unlink(missing_ok=True)
            identity_seed_path.unlink(missing_ok=True)
        install_v1 = package_install(
            consumer, consumer_env, v1_path, v1_sha, logs / "consumer.log"
        )
        expect(install_v1.get("operation") == "installed", "consumer v1 package install failed")
        installed_snapshot = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        expect(
            tenant_statuses(installed_snapshot) == {}
            and rbac_counts(installed_snapshot) == {}
            and installed_snapshot.get("owned_table") is True
            and installed_snapshot.get("owned_rows") == 0,
            "Package installation implicitly opened a Tenant, granted RBAC, or created business data",
        )

        fixture = helper_action(helper, consumer, consumer_env, "fixture", logs / "consumer.log")
        expect(tenant_statuses(fixture) == {} and rbac_counts(fixture) == {} and fixture.get("owned_rows") == 0,
               "synthetic Tenant fixture changed Module, RBAC, or business state")
        seeded = helper_action(
            helper,
            consumer,
            consumer_env,
            "provision-default",
            logs / "consumer.log",
            [str(identity_context)],
        )
        expect(tenant_statuses(seeded) == {"default": "enabled"},
               "formal service did not preserve Tenant A/B initial Module separation")
        expect(rbac_counts(seeded) == {"default": 1}, "Role service did not establish Tenant A RBAC")
        expect(seeded.get("owned_rows") == 1 and seeded.get("migration_count") == 1
               and len(seeded.get("service_read", {}).get("items", [])) == 1,
               "v1 Module service write/read or migration state is invalid")
        member_authorization = seeded.get("member_authorization", {})
        expect(
            member_authorization.get("entry") == "native_non_root_member_grant_revoke"
            and member_authorization.get("root") is False
            and member_authorization.get("role_keys") == ["reference-member"]
            and member_authorization.get("before_grant_denied_zero_write") is True
            and member_authorization.get("grant_visible") is True
            and member_authorization.get("service_read_write") is True
            and member_authorization.get("revoke_denied_zero_write") is True,
            "ordinary non-root member grant/revoke runtime was not proven",
        )
        enabled_b = helper_action(
            helper,
            consumer,
            consumer_env,
            "enable-b",
            logs / "consumer.log",
            [str(identity_context)],
        )
        expect(tenant_statuses(enabled_b) == {"default": "enabled", "tenant-b": "enabled"}
               and rbac_counts(enabled_b) == {"default": 1},
               "TenantModule enablement changed Package or RBAC state")
        cross_tenant_member_authorization = enabled_b.get("cross_tenant_member_authorization", {})
        expect(
            cross_tenant_member_authorization.get("entry") == "native_non_root_member_cross_tenant_denied"
            and cross_tenant_member_authorization.get("root") is False
            and cross_tenant_member_authorization.get("grant_visible") is False
            and cross_tenant_member_authorization.get("denied_zero_write") is True,
            "ordinary non-root member cross-Tenant denial was not proven",
        )

        author_module_v2(backend, frontend)
        check_v2 = run_think(author, author_env, ["module:check", MODULE_KEY], logs / "author.log")
        expect(check_v2.get("status") == "ready", "module:check v2 failed")
        v2_path = output / "acme-reference-chain-v2.tar"
        packed_v2 = run_think(author, author_env, [
            "module:pack", MODULE_KEY, f"--output={v2_path}",
        ], logs / "author.log")
        v2_sha = str(packed_v2.get("sha256", ""))
        expect(v2_sha == sha256(v2_path) and v2_sha != v1_sha, "v2 immutable package identity is invalid")
        check_v2_package = run_think(author, author_env, [
            "module:check", MODULE_KEY, f"--package={v2_path}", f"--sha256={v2_sha}",
        ], logs / "author.log")
        expect(check_v2_package.get("status") == "ready", "module:check did not accept canonical v2 package")
        before_update = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        dry_run = package_update(
            consumer, consumer_env, v2_path, v2_sha, True, logs / "consumer.log"
        )
        expect(dry_run.get("operation") == "update" and dry_run.get("dry_run") is True,
               "v2 update dry-run did not return a zero-write plan")
        after_dry_run = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        expect(after_dry_run == before_update, "v2 update dry-run changed consumer state")
        updated = package_update(
            consumer, consumer_env, v2_path, v2_sha, False, logs / "consumer.log"
        )
        expect(updated.get("operation") == "upgraded", "consumer v2 package update failed")
        after_update = helper_action(
            helper,
            consumer,
            consumer_env,
            "service-read-default",
            logs / "consumer.log",
            [str(identity_context)],
        )
        expect(after_update.get("plugin", {}).get("installed_version") == "2.0.0"
               and after_update.get("migration_count") == 2 and after_update.get("v2_column") is True,
               "v2 package, migration, and schema identity diverged")
        expect(tenant_statuses(after_update) == tenant_statuses(enabled_b)
               and rbac_counts(after_update) == rbac_counts(enabled_b)
               and after_update.get("owned_rows") == 1
               and len(after_update.get("service_read", {}).get("items", [])) == 1,
               "v2 update changed TenantModule/RBAC data or broke the Module service read")

        disabled_tenants = helper_action(
            helper,
            consumer,
            consumer_env,
            "disable-tenants",
            logs / "consumer.log",
            [str(identity_context)],
        )
        expect(set(tenant_statuses(disabled_tenants).values()) == {"disabled"}, "TenantModules were not disabled")
        disabled_package = package_disable(
            consumer, consumer_env, logs / "consumer.log"
        )
        after_disable = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        expect(disabled_package.get("operation") == "disabled"
               and after_disable.get("module_installation", {}).get("status") == "maintenance",
               "Package disable did not enter maintenance")
        reactivated = package_install(
            consumer, consumer_env, v2_path, v2_sha, logs / "consumer.log"
        )
        expect(reactivated.get("operation") == "reactivated", "same-artifact Package reactivation failed")
        after_reactivate = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        expect(after_reactivate.get("module_installation", {}).get("status") == "active"
               and rbac_counts(after_reactivate) == {"default": 1},
               "Package reactivation changed RBAC or Module state")

        retire_preview, retired = preview_and_execute(
            consumer, consumer_env, output, False, logs / "consumer.log"
        )
        expect(retired.get("operation") == "retired", "Package retire failed")
        after_retire = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        expect(after_retire.get("owned_table") is True and after_retire.get("owned_rows") == 1
               and after_retire.get("migration_count") == 2 and rbac_counts(after_retire) == {"default": 1},
               "retire did not preserve business data, migration ledger, and RBAC")
        purge_preview, purged = preview_and_execute(
            consumer, consumer_env, output, True, logs / "consumer.log"
        )
        expect(purged.get("operation") == "purged", "Package Purge failed")
        after_purge = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        expect(after_purge.get("plugin", {}).get("status") == "uninstalled"
               and after_purge.get("module_installation") is None
               and tenant_statuses(after_purge) == {"default": "disabled", "tenant-b": "disabled"}
               and after_purge.get("owned_table") is False and after_purge.get("migration_count") == 0
               and after_purge.get("permission_count") == 0 and after_purge.get("rbac") == [],
               "Purge changed TenantModule or left Package, Module, owned data, migration, catalog, or RBAC state")

        owned_after = {"application_a": app_owned_proof(author), "application_b": app_owned_proof(consumer)}
        expect(owned_after == owned_before, "consumer lifecycle changed a generated application app-owned file")
        summary = {
            "schema_version": 1,
            "status": "passed",
            "candidate": args.candidate,
            "candidate_tree": candidate_tree,
            "installer_archive_sha256": sha256(installer_package),
            "installer_manifest_sha256": sha256(installer_manifest),
            "artifact_input": artifact_input,
            "formal_installer_input": args.installer_mode == "formal",
            "lease": args.lease,
            "database_resource_id": args.database_resource,
            "endpoint_id": args.endpoint,
            "author_database": args.author_database,
            "database": args.database,
            "edition": args.edition,
            "applications": {
                "author_manifest_sha256": sha256(author / ".peanut/application-manifest.json"),
                "consumer_manifest_sha256": sha256(consumer / ".peanut/application-manifest.json"),
                "app_owned_before": owned_before,
                "app_owned_after": owned_after,
                "configured_resource_registry_sha256": configured_registries,
            },
            "module": {
                "key": MODULE_KEY,
                "v1_sha256": v1_sha,
                "v2_sha256": v2_sha,
                "v2_source_tree_sha256": tree_sha256(backend),
            },
            "gates": {
                "application_a_direct_installer_extract_and_fresh_install": "passed",
                "application_b_direct_installer_extract_and_fresh_install": "passed",
                "check_v1_v2": "passed",
                "canonical_pack_v1_v2": "passed",
                "install_update": "passed",
                "tenant_package_rbac_separation": "passed",
                "disable_reactivate": "passed",
                "retire_purge": "passed",
                "app_owned_preservation": "passed",
                "runtime_mutation_entry": "generated_application_module_cli",
                "identity_context_entry": "native_auth_service_access_tokens_from_private_file",
                "tenant_fixture_entry": "native_provision_accept_activate",
                "tenant_module_entry": "platform_tenant_admin_service",
                "rbac_entry": "role_admin_service",
                "member_authorization_entry": "native_non_root_member_grant_revoke_cross_tenant_denied",
                "business_data_entry": "module_contract_service",
                "source_private_fixture_copy": "not_used",
                "generation_mode": ("internal_candidate_backend_package_direct" if args.installer_mode == "internal-candidate"
                                    else "fixed_edition_installer_package_direct"),
            },
            "snapshots": {
                "after_update": after_update,
                "after_retire": after_retire,
                "after_purge": after_purge,
            },
            "preview_digests": {
                "retire": retire_preview["plan_digest"],
                "purge": purge_preview["plan_digest"],
            },
        }
        write_json(output / "summary.json", summary)
        completed = True
        return summary
    finally:
        # Retain diagnostics, never retained login tokens or seed passwords.
        identity_context.unlink(missing_ok=True)
        identity_seed_path.unlink(missing_ok=True)
        if completed and not args.keep:
            shutil.rmtree(output)


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--candidate", required=True)
    parser.add_argument("--source-root")
    parser.add_argument("--qualification-tool-commit")
    parser.add_argument("--qualification-tool-files-sha256")
    parser.add_argument("--lease", required=True)
    parser.add_argument("--database", required=True)
    parser.add_argument("--database-resource", required=True, help="Explicit registered development database resource")
    parser.add_argument("--endpoint", required=True, help="Explicit endpoint in that resource")
    parser.add_argument("--author-database", required=True, help="Separately registered and leased Application A runtime database")
    parser.add_argument("--output", required=True)
    parser.add_argument("--env-file", required=True)
    parser.add_argument("--installer-package", required=True, help="Absolute fixed Edition installer archive used directly for both applications")
    parser.add_argument("--installer-manifest", required=True, help="Absolute external manifest for the fixed installer archive")
    parser.add_argument("--installer-sha256", required=True, help="Lease-bound SHA-256 of the fixed installer archive")
    parser.add_argument("--installer-manifest-sha256", required=True, help="Lease-bound SHA-256 of the external installer manifest")
    parser.add_argument("--installer-mode", choices=("formal", "internal-candidate"), default="formal")
    parser.add_argument("--qualification-plan", help="Native P0-E plan authenticating its build-derived Installer inputs")
    parser.add_argument("--edition", choices=("multi-tenant",), default="multi-tenant")
    parser.add_argument("--allow-dependency-network", action="store_true", help="Permit locked package downloads; no dependency updates")
    parser.add_argument("--keep", action="store_true", help="Keep the lease-owned output after success")
    args = parser.parse_args()
    path = Path(args.env_file)
    if not path.is_absolute() or not path.is_file() or path.is_symlink() or (path.stat().st_mode & 0o777) != 0o600:
        fail("--env-file must name an absolute permission-0600 file")
    allowed = {"DB_HOST", "DB_PORT", "DB_USER", "DB_PASS"}
    for line in path.read_text(encoding="utf-8").splitlines():
        name, separator, value = line.partition("=")
        if not separator or name not in allowed or name in CONFIG_VALUES or value == "":
            fail("--env-file has an invalid schema")
        CONFIG_VALUES[name] = value
    if CONFIG_VALUES.keys() != allowed:
        fail("--env-file is missing a required database value")
    if args.allow_dependency_network:
        CONFIG_VALUES["DEPENDENCY_NETWORK"] = "allowed"
    return args


def main() -> int:
    try:
        summary = run_chain(parse_arguments())
        print(json.dumps(summary, ensure_ascii=False, sort_keys=True))
        return 0
    except ChainError as exception:
        print(f"consumer-module-reference-chain: {exception}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
