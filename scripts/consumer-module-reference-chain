$identityBundle = static function () use ($identityFile): array {
    clearstatcache(true, $identityFile);
    if ($identityFile === '') {
        throw new RuntimeException('CR21_IDENTITY_CONTEXT_REQUIRED');
    }
    if (!is_file($identityFile) || is_link($identityFile) || (fileperms($identityFile) & 0777) !== 0600) {
        throw new RuntimeException('CR21_IDENTITY_CONTEXT_FILE_INVALID');
    }
    $decoded = json_decode((string)file_get_contents($identityFile), true, 512, JSON_THROW_ON_ERROR);
    if (!is_array($decoded)) {
        throw new RuntimeException('CR21_IDENTITY_CONTEXT_JSON_INVALID');
    }
    return $decoded;
};
$privateKeyValueFile = static function (string $path, string $label): array {
    clearstatcache(true, $path);
    if ($path === '' || !is_file($path) || is_link($path) || (fileperms($path) & 0777) !== 0600) {
        throw new RuntimeException($label . '_FILE_INVALID');
    }
    $values = parse_ini_file($path, false, INI_SCANNER_RAW);
    if (!is_array($values)) {
        throw new RuntimeException($label . '_FILE_UNREADABLE');
    }
    return $values;
};
$requiredSecret = static function (array $values, string $key): string {
    $value = $values[$key] ?? null;
    if (!is_string($value) || trim($value) === '') {
        throw new RuntimeException('CR21_SECRET_MISSING:' . $key);
    }
    return $value;
};
$requiredToken = static function (array $bundle, string $key): string {
    $token = $bundle[$key] ?? null;
    if (!is_string($token) || trim($token) === '') {
        throw new RuntimeException('CR21_IDENTITY_CONTEXT_TOKEN_MISSING:' . $key);
    }
    return $token;
};
$tenantToken = static function (array $bundle, string $tenantCode) use ($requiredToken): string {
    $tokens = $bundle['tenant_access_tokens'] ?? null;
    if (!is_array($tokens)) {
        throw new RuntimeException('CR21_IDENTITY_CONTEXT_TENANT_TOKENS_MISSING');
    }
    return $requiredToken($tokens, $tenantCode);
};
$requestId = static function (string $audience): string {
    return 'cr21-' . $audience . '-' . bin2hex(random_bytes(8));
};
$expectReferencePermissionDenied = static function (callable $operation, PDO $pdo): void {
    $before = (int)$pdo->query('SELECT COUNT(*) FROM pa_acme_reference_chain_record')->fetchColumn();
    try {
        $operation();
    } catch (RuntimeException $error) {
        if ($error->getMessage() !== 'REFERENCE_CHAIN_PERMISSION_DENIED') {
            throw $error;
        }
        $after = (int)$pdo->query('SELECT COUNT(*) FROM pa_acme_reference_chain_record')->fetchColumn();
        if ($after !== $before) {
            throw new RuntimeException('CR21_REFERENCE_CHAIN_DENIAL_MUTATED_DATA');
        }
        return;
    }
    throw new RuntimeException('CR21_REFERENCE_CHAIN_PERMISSION_DENIAL_MISSING');
};
$writeIdentityBundle = static function (string $path, array $bundle): void {
    if ($path === '') {
        throw new RuntimeException('CR21_IDENTITY_CONTEXT_OUTPUT_REQUIRED');
    }
    $directory = dirname($path);
    if (!is_dir($directory) || is_link($path)) {
        throw new RuntimeException('CR21_IDENTITY_CONTEXT_OUTPUT_INVALID');
    }
    $temporary = $path . '.tmp-' . bin2hex(random_bytes(8));
    try {
        $json = json_encode($bundle, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES);
        $handle = fopen($temporary, 'x');
        if ($handle === false) {
            throw new RuntimeException('CR21_IDENTITY_CONTEXT_WRITE_FAILED');
        }
        try {
            if (!chmod($temporary, 0600) || fwrite($handle, $json) !== strlen($json)) {
                throw new RuntimeException('CR21_IDENTITY_CONTEXT_WRITE_FAILED');
            }
        } finally {
            fclose($handle);
        }
        if (!rename($temporary, $path)) {
            throw new RuntimeException('CR21_IDENTITY_CONTEXT_WRITE_FAILED');
        }
    } finally {
        if (is_file($temporary) && !is_link($temporary)) {
            unlink($temporary);
        }
    }
};
$platformContext = static function () use ($app, $identityBundle, $requiredToken, $requestId): PeanutAdmin\Kernel\Context\PlatformContext {
    $context = $app->make(app\platform\identity\PlatformOperatorIdentityPort::class)
        ->requireActive($requiredToken($identityBundle(), 'platform_access_token'), $requestId('platform'));
    return $context->core;
};
$tenantContext = static function (string $tenantCode) use ($app, $pdo, $identityBundle, $tenantToken, $requestId): PeanutAdmin\Kernel\Auth\TenantContext {
    $context = $app->make(PeanutAdmin\Modules\Identity\Auth\TenantAuthService::class)
        ->context($tenantToken($identityBundle(), $tenantCode), $requestId('tenant'));
    $query = $pdo->prepare("SELECT id FROM pa_tenant WHERE code=? AND status='active'");
    $query->execute([$tenantCode]);
    $tenantId = $query->fetchColumn();
    if ($tenantId === false || (int)$tenantId !== $context->tenantId) {
        throw new RuntimeException('CR21_IDENTITY_CONTEXT_TENANT_MISMATCH:' . $tenantCode);
    }
    return $context;
};

