#!/usr/bin/env python3
"""Run the CR21 two-application consumer Module reference chain."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import runpy
import shutil
import stat
import subprocess
import sys
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parent.parent
TOOL_ROOT = ROOT
TOOL_BINDING: dict[str, Any] | None = None
LEASE_TOOL = ROOT / "scripts/project-resource-lease"
PHP = Path(os.environ.get("PEANUT_PHP_BINARY") or shutil.which("php") or "/usr/bin/php")
MODULE_KEY = "acme.reference-chain"


class ChainError(RuntimeError):
    pass


def fail(message: str) -> None:
    raise ChainError(message)


def command(
    arguments: list[str],
    *,
    cwd: Path | None = None,
    env: dict[str, str] | None = None,
    log: Path | None = None,
) -> str:
    merged = {
        key: value
        for key in ("PATH", "HOME", "TMPDIR", "SystemRoot", "COMSPEC", "PATHEXT")
        if (value := os.environ.get(key))
    }
    if env:
        merged.update(env)
    result = subprocess.run(
        arguments,
        cwd=ROOT if cwd is None else cwd,
        env=merged,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    if log is not None:
        log.parent.mkdir(parents=True, exist_ok=True)
        with log.open("a", encoding="utf-8") as stream:
            stream.write("$ " + " ".join(arguments) + "\n")
            stream.write(result.stdout)
            if not result.stdout.endswith("\n"):
                stream.write("\n")
    if result.returncode != 0:
        detail = result.stdout.strip().splitlines()
        suffix = detail[-1] if detail else "no output"
        fail(f"command failed ({result.returncode}): {arguments[0]}: {suffix}")
    return result.stdout


def json_output(output: str, label: str) -> dict[str, Any]:
    try:
        value = json.loads(output.strip())
        if isinstance(value, dict):
            return value
    except json.JSONDecodeError:
        pass
    for line in reversed(output.splitlines()):
        try:
            value = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(value, dict):
            return value
    fail(f"{label} did not return a JSON object")


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exception:
        fail(f"cannot read JSON {path}: {exception}")
    if not isinstance(value, dict):
        fail(f"JSON root must be an object: {path}")
    return value


def write_json(path: Path, value: Any, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    path.chmod(mode)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def app_owned_proof(project_root: Path) -> dict[str, Any]:
    manifest = read_json(project_root / ".peanut/application-manifest.json")
    files = manifest.get("files")
    if not isinstance(files, list):
        fail("application manifest files are invalid")
    paths: list[str] = []
    rows: list[str] = []
    for item in files:
        if not isinstance(item, dict) or item.get("classification") != "app-owned":
            continue
        relative = item.get("path")
        if not isinstance(relative, str) or not relative or relative.startswith("/") or ".." in Path(relative).parts:
            fail("application manifest contains an unsafe app-owned path")
        path = project_root / relative
        if not path.is_file() or path.is_symlink():
            fail(f"app-owned file is unavailable: {relative}")
        mode = stat.S_IMODE(path.stat().st_mode)
        paths.append(relative)
        rows.append(f"{relative}\0{sha256(path)}\0{mode:04o}")
    if not rows:
        fail("application manifest contains no app-owned files")
    return {
        "file_count": len(rows),
        "paths_sha256": hashlib.sha256("\n".join(paths).encode()).hexdigest(),
        "tree_sha256": hashlib.sha256("\n".join(rows).encode()).hexdigest(),
    }


def tree_sha256(root: Path) -> str:
    rows: list[str] = []
    for path in sorted(root.rglob("*")):
        if path.is_file() and not path.is_symlink():
            rows.append(f"{path.relative_to(root).as_posix()}\0{sha256(path)}")
    return hashlib.sha256("\n".join(rows).encode()).hexdigest()


def lease_fields(lease_id: str) -> tuple[dict[str, str], list[tuple[str, str]]]:
    output = command([str(LEASE_TOOL), "show", "--lease", lease_id])
    metadata: dict[str, str] = {}
    resources: list[tuple[str, str]] = []
    in_resources = False
    for line in output.splitlines():
        if line == "resources":
            in_resources = True
            continue
        parts = line.split("\t", 1)
        if len(parts) != 2:
            continue
        if in_resources:
            resources.append((parts[0], parts[1]))
        else:
            metadata[parts[0]] = parts[1]
    return metadata, resources


def run_think(project: Path, env: dict[str, str], arguments: list[str], log: Path) -> dict[str, Any]:
    return json_output(
        command([str(PHP), "think", *arguments], cwd=project / "server", env=env, log=log),
        "think " + " ".join(arguments),
    )


def author_module_v1(author: Path) -> tuple[Path, Path]:
    backend = author / "server/app/modules/acme/reference_chain"
    frontend = author / "web/src/modules/acme-reference-chain"
    manifest_path = backend / "module.json"
    manifest = read_json(manifest_path)
    manifest["description"] = "CR21 independent consumer reference chain"
    identity_manifest_path = author / "server/app/modules/official/identity/module.json"
    if not identity_manifest_path.is_file():
        fail("official.identity module manifest is unavailable in the author application")
    identity_manifest = read_json(identity_manifest_path)
    identity_version = identity_manifest.get("version")
    if not isinstance(identity_version, str) or identity_version == "":
        fail("official.identity module manifest has no valid version")
    raw_dependencies = manifest.get("dependencies", [])
    if not isinstance(raw_dependencies, list):
        fail("reference-chain dependencies must be a list")
    dependencies: list[dict[str, str]] = []
    identity_seen = False
    for item in raw_dependencies:
        if not isinstance(item, dict) or not isinstance(item.get("module_key"), str) or not isinstance(item.get("version"), str):
            fail("reference-chain dependency entries must declare module_key and version")
        dependency = {"module_key": item["module_key"], "version": item["version"]}
        if dependency["module_key"] == "official.identity":
            if identity_seen:
                fail("reference-chain dependencies contain duplicate official.identity entries")
            dependency["version"] = identity_version
            identity_seen = True
        dependencies.append(dependency)
    if not identity_seen:
        dependencies.append({"module_key": "official.identity", "version": identity_version})
    manifest["dependencies"] = dependencies
    manifest["database"]["owned_tables"] = ["pa_acme_reference_chain_record"]
    manifest["contracts"]["exports"] = ["Acme\\Modules\\ReferenceChain\\Contract\\ReferenceChainCommands"]
    for directory in ["src/Contract", "src/Service"]:
        (backend / directory).mkdir(parents=True, exist_ok=True)
    write_json(manifest_path, manifest)
    (backend / "src/Contract/ReferenceChainCommands.php").write_text(
        """<?php
declare(strict_types=1);

namespace Acme\\Modules\\ReferenceChain\\Contract;

use PeanutAdmin\\Kernel\\Auth\\TenantContext;

interface ReferenceChainCommands
{
    /** @return array{id:int,tenant_id:int,reference:string} */
    public function create(TenantContext $context, string $reference): array;

    /** @return array{items:list<array{id:int,tenant_id:int,reference:string}>,has_more:bool,next_cursor:int|null} */
    public function list(TenantContext $context, int $limit = 50, int $afterId = 0): array;
}
""",
        encoding="utf-8",
    )
    (backend / "src/Service/ReferenceChainService.php").write_text(
        """<?php
declare(strict_types=1);

namespace Acme\\Modules\\ReferenceChain\\Service;

use Acme\\Modules\\ReferenceChain\\Contract\\ReferenceChainCommands;
use app\\common\\contract\\authorization\\AdminAuthorizationQuery;
use app\\common\\contract\\module\\ModuleQualificationQuery;
use PeanutAdmin\\Kernel\\Auth\\TenantContext;
use RuntimeException;
use think\\db\\Raw;
use think\\facade\\Db;

final readonly class ReferenceChainService implements ReferenceChainCommands
{
    public function __construct(
        private AdminAuthorizationQuery $authorization,
        private ModuleQualificationQuery $modules,
    ) {}

    public function create(TenantContext $context, string $reference): array
    {
        $reference = trim($reference);
        if ($reference === '' || strlen($reference) > 120) {
            throw new RuntimeException('REFERENCE_CHAIN_REFERENCE_INVALID');
        }
        $this->assertPermission($context);
        return Db::transaction(function () use ($context, $reference): array {
            $this->assertEnabled($context->tenantId);
            $id = $this->intId(Db::name('acme_reference_chain_record')->insertGetId([
                'tenant_id' => $context->tenantId,
                'reference' => $reference,
                'created_at' => new Raw('UTC_TIMESTAMP(3)'),
            ]));
            return $this->row($context->tenantId, $id);
        });
    }

    public function list(TenantContext $context, int $limit = 50, int $afterId = 0): array
    {
        if ($limit < 1 || $limit > 100) {
            throw new RuntimeException('REFERENCE_CHAIN_LIST_LIMIT_INVALID');
        }
        if ($afterId < 0) {
            throw new RuntimeException('REFERENCE_CHAIN_CURSOR_INVALID');
        }
        $this->assertPermission($context);
        $this->assertEnabled($context->tenantId);
        $rows = Db::name('acme_reference_chain_record')
            ->where('tenant_id', $context->tenantId)
            ->where('id', '>', $afterId)
            ->field(['id', 'tenant_id', 'reference'])
            ->order('id')->limit($limit + 1)->select()->toArray();
        $items = array_map(fn(array $row): array => $this->normalizeRow($row), array_slice($rows, 0, $limit));
        return [
            'items' => $items,
            'has_more' => count($rows) > $limit,
            'next_cursor' => count($rows) > $limit && $items !== [] ? $items[array_key_last($items)]['id'] : null,
        ];
    }

    private function assertEnabled(int $tenantId): void
    {
        if (!in_array('acme.reference-chain', $this->modules->activeTenantModuleKeys($tenantId), true)) {
            throw new RuntimeException('REFERENCE_CHAIN_MODULE_NOT_ENABLED');
        }
    }

    private function assertPermission(TenantContext $context): void
    {
        $principal = $this->authorization->principal($context);
        if (!$this->authorization->decide($context, $principal, 'acme.reference-chain.write')->allowed) {
            throw new RuntimeException('REFERENCE_CHAIN_PERMISSION_DENIED');
        }
    }

    /** @return array{id:int,tenant_id:int,reference:string} */
    private function row(int $tenantId, int $id): array
    {
        $row = Db::name('acme_reference_chain_record')->where('tenant_id', $tenantId)
            ->where('id', $id)->field(['id', 'tenant_id', 'reference'])->find();
        if (!is_array($row)) {
            throw new RuntimeException('REFERENCE_CHAIN_RECORD_NOT_FOUND');
        }
        return $this->normalizeRow($row);
    }

    /** @param array<string,mixed> $row @return array{id:int,tenant_id:int,reference:string} */
    private function normalizeRow(array $row): array
    {
        return [
            'id' => $this->intId($row['id'] ?? null),
            'tenant_id' => $this->intId($row['tenant_id'] ?? null),
            'reference' => (string)($row['reference'] ?? ''),
        ];
    }

    private function intId(mixed $value): int
    {
        $text = is_int($value) ? (string)$value : (is_string($value) ? $value : '');
        if ($text === '' || preg_match('/^[1-9][0-9]*$/', $text) !== 1 || $this->compareUnsigned($text, (string)PHP_INT_MAX) > 0) {
            throw new RuntimeException('REFERENCE_CHAIN_ID_OUT_OF_RANGE');
        }
        return (int)$text;
    }

    private function compareUnsigned(string $left, string $right): int
    {
        $left = ltrim($left, '0') ?: '0';
        $right = ltrim($right, '0') ?: '0';
        return strlen($left) <=> strlen($right) ?: strcmp($left, $right);
    }
}
""",
        encoding="utf-8",
    )
    (backend / "src/ModuleProvider.php").write_text(
        """<?php
declare(strict_types=1);

namespace Acme\\Modules\\ReferenceChain;

use Acme\\Modules\\ReferenceChain\\Contract\\ReferenceChainCommands;
use Acme\\Modules\\ReferenceChain\\Service\\ReferenceChainService;
use PeanutAdmin\\Kernel\\Module\\ModuleProvider as ModuleProviderContract;

final class ModuleProvider implements ModuleProviderContract
{
    public function moduleKey(): string
    {
        return 'acme.reference-chain';
    }

    public function bindings(): array
    {
        return [ReferenceChainCommands::class => ReferenceChainService::class];
    }
}
""",
        encoding="utf-8",
    )
    write_json(backend / "resources/permissions.json", [{
        "key": "acme.reference-chain.write",
        "type": "action",
        "name": "Write reference records",
        "risk_level": "sensitive",
    }])
    write_json(backend / "resources/menus.json", [{
        "key": "acme.reference-chain.page",
        "scope": "tenant",
        "parent_key": None,
        "type": "page",
        "name": "Reference Chain",
        "route_name": "acme-reference-chain",
        "route_path": "/app/acme/reference-chain",
        "component_key": "acme.reference-chain.page",
        "required_permission": "acme.reference-chain.write",
        "icon": "Link",
        "sort_order": 900,
        "client_keys": ["admin-web"],
    }])
    migration = backend / "database/migrations/20260828010101_create_reference_chain.sql"
    migration.write_text(
        "CREATE TABLE `pa_acme_reference_chain_record` (\n"
        "  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,\n"
        "  `tenant_id` BIGINT UNSIGNED NOT NULL,\n"
        "  `reference` VARCHAR(120) NOT NULL,\n"
        "  `created_at` DATETIME(3) NOT NULL,\n"
        "  PRIMARY KEY (`id`),\n"
        "  KEY `idx_acme_reference_tenant` (`tenant_id`,`id`),\n"
        "  CONSTRAINT `fk_acme_reference_tenant` FOREIGN KEY (`tenant_id`) REFERENCES `pa_tenant` (`id`) ON DELETE RESTRICT\n"
        ") ENGINE=InnoDB DEFAULT CHARACTER SET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;\n",
        encoding="utf-8",
    )
    return backend, frontend


def author_module_v2(backend: Path, frontend: Path) -> None:
    for path in [backend / "module.json", backend / "composer.json", frontend / "package.json"]:
        document = read_json(path)
        document["version"] = "2.0.0"
        write_json(path, document)
    (backend / "database/migrations/20260828010201_add_revision_note.sql").write_text(
        "ALTER TABLE `pa_acme_reference_chain_record` ADD COLUMN `revision_note` VARCHAR(160) NULL AFTER `reference`;\n",
        encoding="utf-8",
    )


def lifecycle_helper() -> str:
    return r'''<?php
declare(strict_types=1);

// Credentials remain private even on diagnostics or retained failed runs.
umask(0077);
ini_set('zend.exception_ignore_args', '1');
set_exception_handler(static function (Throwable $error): void {
    fwrite(STDERR, json_encode([
        'error' => 'CR21_HELPER_FAILED',
        'exception' => get_class($error),
        'source' => basename($error->getFile()),
        'line' => $error->getLine(),
    ], JSON_THROW_ON_ERROR) . PHP_EOL);
    exit(1);
});

require $argv[1] . '/server/vendor/autoload.php';

$action = $argv[2] ?? '';
$identityFile = $argv[3] ?? '';
$app = (new think\App($argv[1] . '/server'))->initialize();
$pdo = new PDO(
    'mysql:host=' . env('DB_HOST', '127.0.0.1') . ';port=' . env('DB_PORT', '3306') . ';dbname=' . env('DB_NAME') . ';charset=utf8mb4',
    (string)env('DB_USER'),
    (string)env('DB_PASS'),
    [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION, PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC]
);
$module = 'acme.reference-chain';
$tableExists = static function (PDO $pdo): bool {
    return (int)$pdo->query("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE() AND table_name='pa_acme_reference_chain_record'")->fetchColumn() === 1;
};
$snapshot = static function () use ($pdo, $module, $tableExists): array {
    $plugin = $pdo->query("SELECT installed_version,status FROM pa_plugin_installation WHERE plugin_key='acme.reference-chain'")->fetch() ?: null;
    $installation = $pdo->query("SELECT installed_version,status FROM pa_module_installation WHERE module_key='acme.reference-chain'")->fetch() ?: null;
    $tenantModules = $pdo->query("SELECT t.code,tm.status FROM pa_tenant_module tm JOIN pa_tenant t ON t.id=tm.tenant_id WHERE tm.module_key='acme.reference-chain' ORDER BY t.code")->fetchAll();
    $rbac = $pdo->query("SELECT t.code,COUNT(*) grants FROM pa_role_permission rp JOIN pa_role r ON r.tenant_id=rp.tenant_id AND r.id=rp.role_id JOIN pa_tenant t ON t.id=rp.tenant_id JOIN pa_permission p ON p.id=rp.permission_id WHERE p.module_key='acme.reference-chain' GROUP BY t.code ORDER BY t.code")->fetchAll();
    $exists = $tableExists($pdo);
    return [
        'plugin' => $plugin,
        'module_installation' => $installation,
        'tenant_modules' => $tenantModules,
        'rbac' => $rbac,
        'permission_count' => (int)$pdo->query("SELECT COUNT(*) FROM pa_permission WHERE module_key='acme.reference-chain'")->fetchColumn(),
        'migration_count' => (int)$pdo->query("SELECT COUNT(*) FROM pa_module_migration WHERE module_key='acme.reference-chain' AND status='applied'")->fetchColumn(),
        'owned_table' => $exists,
        'owned_rows' => $exists ? (int)$pdo->query('SELECT COUNT(*) FROM pa_acme_reference_chain_record')->fetchColumn() : 0,
        'v2_column' => $exists ? (int)$pdo->query("SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='pa_acme_reference_chain_record' AND column_name='revision_note'")->fetchColumn() === 1 : false,
    ];
};

$identityBundle = static function () use ($identityFile): array {
    clearstatcache(true, $identityFile);
    if ($identityFile === '') {
        throw new RuntimeException('CR21_IDENTITY_CONTEXT_REQUIRED');
    }
    if (!is_file($identityFile) || is_link($identityFile) || (fileperms($identityFile) & 0777) !== 0600) {
        throw new RuntimeException('CR21_IDENTITY_CONTEXT_FILE_INVALID');
    }
    $decoded = json_decode((string)file_get_contents($identityFile), true, 512, JSON_THROW_ON_ERROR);
    if (!is_array($decoded)) {
        throw new RuntimeException('CR21_IDENTITY_CONTEXT_JSON_INVALID');
    }
    return $decoded;
};
$privateKeyValueFile = static function (string $path, string $label): array {
    clearstatcache(true, $path);
    if ($path === '' || !is_file($path) || is_link($path) || (fileperms($path) & 0777) !== 0600) {
        throw new RuntimeException($label . '_FILE_INVALID');
    }
    $values = parse_ini_file($path, false, INI_SCANNER_RAW);
    if (!is_array($values)) {
        throw new RuntimeException($label . '_FILE_UNREADABLE');
    }
    return $values;
};
$requiredSecret = static function (array $values, string $key): string {
    $value = $values[$key] ?? null;
    if (!is_string($value) || trim($value) === '') {
        throw new RuntimeException('CR21_SECRET_MISSING:' . $key);
    }
    return $value;
};
$requiredToken = static function (array $bundle, string $key): string {
    $token = $bundle[$key] ?? null;
    if (!is_string($token) || trim($token) === '') {
        throw new RuntimeException('CR21_IDENTITY_CONTEXT_TOKEN_MISSING:' . $key);
    }
    return $token;
};
$tenantToken = static function (array $bundle, string $tenantCode) use ($requiredToken): string {
    $tokens = $bundle['tenant_access_tokens'] ?? null;
    if (!is_array($tokens)) {
        throw new RuntimeException('CR21_IDENTITY_CONTEXT_TENANT_TOKENS_MISSING');
    }
    return $requiredToken($tokens, $tenantCode);
};
$requestId = static function (string $audience): string {
    return 'cr21-' . $audience . '-' . bin2hex(random_bytes(8));
};
$expectReferencePermissionDenied = static function (callable $operation, PDO $pdo): void {
    $before = (int)$pdo->query('SELECT COUNT(*) FROM pa_acme_reference_chain_record')->fetchColumn();
    try {
        $operation();
    } catch (RuntimeException $error) {
        if ($error->getMessage() !== 'REFERENCE_CHAIN_PERMISSION_DENIED') {
            throw $error;
        }
        $after = (int)$pdo->query('SELECT COUNT(*) FROM pa_acme_reference_chain_record')->fetchColumn();
        if ($after !== $before) {
            throw new RuntimeException('CR21_REFERENCE_CHAIN_DENIAL_MUTATED_DATA');
        }
        return;
    }
    throw new RuntimeException('CR21_REFERENCE_CHAIN_PERMISSION_DENIAL_MISSING');
};
$writeIdentityBundle = static function (string $path, array $bundle): void {
    if ($path === '') {
        throw new RuntimeException('CR21_IDENTITY_CONTEXT_OUTPUT_REQUIRED');
    }
    $directory = dirname($path);
    if (!is_dir($directory) || is_link($path)) {
        throw new RuntimeException('CR21_IDENTITY_CONTEXT_OUTPUT_INVALID');
    }
    $temporary = $path . '.tmp-' . bin2hex(random_bytes(8));
    try {
        $json = json_encode($bundle, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES);
        $handle = fopen($temporary, 'x');
        if ($handle === false) {
            throw new RuntimeException('CR21_IDENTITY_CONTEXT_WRITE_FAILED');
        }
        try {
            if (!chmod($temporary, 0600) || fwrite($handle, $json) !== strlen($json)) {
                throw new RuntimeException('CR21_IDENTITY_CONTEXT_WRITE_FAILED');
            }
        } finally {
            fclose($handle);
        }
        if (!rename($temporary, $path)) {
            throw new RuntimeException('CR21_IDENTITY_CONTEXT_WRITE_FAILED');
        }
    } finally {
        if (is_file($temporary) && !is_link($temporary)) {
            unlink($temporary);
        }
    }
};
$platformContext = static function () use ($app, $identityBundle, $requiredToken, $requestId): PeanutAdmin\Kernel\Context\PlatformContext {
    $context = $app->make(app\platform\identity\PlatformOperatorIdentityPort::class)
        ->requireActive($requiredToken($identityBundle(), 'platform_access_token'), $requestId('platform'));
    return $context->core;
};
$tenantContext = static function (string $tenantCode) use ($app, $pdo, $identityBundle, $tenantToken, $requestId): PeanutAdmin\Kernel\Auth\TenantContext {
    $context = $app->make(PeanutAdmin\Modules\Identity\Auth\TenantAuthService::class)
        ->context($tenantToken($identityBundle(), $tenantCode), $requestId('tenant'));
    $query = $pdo->prepare("SELECT id FROM pa_tenant WHERE code=? AND status='active'");
    $query->execute([$tenantCode]);
    $tenantId = $query->fetchColumn();
    if ($tenantId === false || (int)$tenantId !== $context->tenantId) {
        throw new RuntimeException('CR21_IDENTITY_CONTEXT_TENANT_MISMATCH:' . $tenantCode);
    }
    return $context;
};

if ($action === 'fixture') {
    echo json_encode($snapshot() + ['tenant_fixture' => 'native_provision_accept_activate'], JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), PHP_EOL;
    exit(0);
}
if ($action === 'issue-identities') {
    $outputIdentityFile = $argv[3] ?? '';
    $credentialFile = $argv[4] ?? '';
    $credentials = $privateKeyValueFile($credentialFile, 'CR21_IDENTITY_SEED');
    foreach (['PLATFORM_INITIAL_EMAIL', 'PLATFORM_INITIAL_PASSWORD', 'ADMIN_INITIAL_EMAIL',
        'ADMIN_INITIAL_PASSWORD', 'TENANT_B_OWNER_EMAIL', 'TENANT_B_OWNER_PASSWORD'] as $key) {
        $requiredSecret($credentials, $key);
    }
    $platform = $app->make(app\platform\services\PlatformOperatorSessionService::class)
        ->login(
            $requiredSecret($credentials, 'PLATFORM_INITIAL_EMAIL'),
            $requiredSecret($credentials, 'PLATFORM_INITIAL_PASSWORD'),
            '127.0.0.1',
            'CR21 reference chain',
            $requestId('platform-login'),
        );
    $tenantAuth = $app->make(PeanutAdmin\Modules\Identity\Auth\TenantAuthService::class);
    $default = $tenantAuth->login(
        $requiredSecret($credentials, 'ADMIN_INITIAL_EMAIL'),
        $requiredSecret($credentials, 'ADMIN_INITIAL_PASSWORD'),
        'default',
        '127.0.0.1',
        'CR21 reference chain',
        $requestId('tenant-login-default'),
    );
    if (!$default instanceof PeanutAdmin\Modules\Identity\Auth\TenantAuthentication) {
        throw new RuntimeException('CR21_DEFAULT_TENANT_LOGIN_DID_NOT_AUTHENTICATE');
    }
    $existingTenantB = $pdo->query("SELECT status FROM pa_tenant WHERE code='tenant-b'")->fetchColumn();
    if ($existingTenantB === false) {
    $invitation = $app->make(PeanutAdmin\Modules\Identity\Invitation\TenantOwnerInvitationAdminService::class)
        ->provision(
            $platform->context,
            'tenant-b',
            'Tenant B',
            $requiredSecret($credentials, 'TENANT_B_OWNER_EMAIL'),
            'Tenant B Owner',
            24,
        );
    $acceptToken = $invitation['accept_token'] ?? null;
    if (!is_string($acceptToken) || $acceptToken === '') {
        throw new RuntimeException('CR21_TENANT_B_INVITATION_TOKEN_UNAVAILABLE');
    }
    $accepted = $app->make(PeanutAdmin\Modules\Identity\Invitation\TenantOwnerInvitationPublicService::class)
        ->accept($acceptToken, $requiredSecret($credentials, 'TENANT_B_OWNER_PASSWORD'));
    if (($accepted['status'] ?? null) !== 'accepted'
        || (int)($accepted['tenant_id'] ?? 0) !== (int)($invitation['tenant_id'] ?? 0)) {
        throw new RuntimeException('CR21_TENANT_B_ACCEPTANCE_MISMATCH');
    }
    // Acceptance creates the owner, but does not activate a provisioning tenant.
    $tenantRow = $pdo->prepare("SELECT id,revision,status FROM pa_tenant WHERE id=? AND code='tenant-b'");
    $tenantRow->execute([(int)$accepted['tenant_id']]);
    $beforeActivation = $tenantRow->fetch();
    if (!is_array($beforeActivation) || $beforeActivation['status'] !== 'provisioning') {
        throw new RuntimeException('CR21_TENANT_B_ACTIVATION_BASELINE_INVALID');
    }
    $activated = $app->make(PeanutAdmin\Modules\Identity\Platform\Application\PlatformTenantAdminService::class)
        ->transitionTenant(
            $platform->context,
            (int)$beforeActivation['id'],
            (int)$beforeActivation['revision'],
            PeanutAdmin\Modules\Identity\Tenancy\TenantStatus::Active,
            'CR21 activate accepted synthetic owner',
        );
    if (($activated['status'] ?? null) !== 'active') {
        throw new RuntimeException('CR21_TENANT_B_ACTIVATION_FAILED');
    }
    } elseif ($existingTenantB !== 'active') {
        throw new RuntimeException('CR21_EXISTING_TENANT_B_NOT_ACTIVE');
    }
    $tenantB = $tenantAuth->login(
        $requiredSecret($credentials, 'TENANT_B_OWNER_EMAIL'),
        $requiredSecret($credentials, 'TENANT_B_OWNER_PASSWORD'),
        'tenant-b',
        '127.0.0.1',
        'CR21 reference chain',
        $requestId('tenant-login-b'),
    );
    if (!$tenantB instanceof PeanutAdmin\Modules\Identity\Auth\TenantAuthentication) {
        throw new RuntimeException('CR21_TENANT_B_LOGIN_DID_NOT_AUTHENTICATE');
    }
    $writeIdentityBundle($outputIdentityFile, [
        'schema_version' => 1,
        'source' => 'native_auth_services_existing_consumer',
        'platform_access_token' => $platform->tokens->access->expose(),
        'tenant_access_tokens' => [
            'default' => $default->tokens->access->expose(),
            'tenant-b' => $tenantB->tokens->access->expose(),
        ],
    ]);
    echo json_encode([
        'status' => 'issued',
        'platform_context' => 'native_platform_login',
        'tenant_contexts' => ['default' => 'native_tenant_login', 'tenant-b' => 'native_invitation_accept_login'],
        'tenant_b' => $existingTenantB === false ? 'provisioned_accepted_and_activated' : 'existing_active_native_login',
        'identity_context_file' => 'written_0600',
    ], JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), PHP_EOL;
    exit(0);
}
if ($action === 'provision-default') {
    $tenantId = (int)$pdo->query("SELECT id FROM pa_tenant WHERE code='default' AND status='active'")->fetchColumn();
    $app->make(PeanutAdmin\Modules\Identity\Platform\Application\PlatformTenantAdminService::class)
        ->enableModule($platformContext(), $tenantId, $module, [], 'manual', null, null, 'CR21 formal service enablement');
    $ownerContext = $tenantContext('default');
    $roles = $app->make(app\common\runtime\authorization\RoleAdministrationRuntime::class)->service();
    $members = $app->make(app\common\runtime\org\TenantAdminRuntime::class)->members();
    $authorization = $app->make(app\common\contract\authorization\AdminAuthorizationQuery::class);
    $tenantAuth = $app->make(PeanutAdmin\Modules\Identity\Auth\TenantAuthService::class);
    $role = $roles->create($ownerContext, 'reference-member', 'Reference Member', 'CR21 non-root member role');
    $memberEmail = 'cr21-reference-member-' . bin2hex(random_bytes(4)) . '@example.test';
    $memberPassword = bin2hex(random_bytes(18)) . 'Aa1!';
    $member = $members->createAdministrator(
        $ownerContext,
        $memberEmail,
        'CR21 Reference Member',
        $memberPassword,
        null,
        [(int)$role['id']],
        true,
    );
    $memberLogin = $tenantAuth->login(
        $memberEmail,
        $memberPassword,
        'default',
        '127.0.0.1',
        'CR21 reference chain member',
        $requestId('tenant-login-member'),
    );
    if (!$memberLogin instanceof PeanutAdmin\Modules\Identity\Auth\TenantAuthentication) {
        throw new RuntimeException('CR21_REFERENCE_MEMBER_LOGIN_DID_NOT_AUTHENTICATE');
    }
    $memberContext = $tenantAuth->context($memberLogin->tokens->access->expose(), $requestId('tenant-member-context'));
    $memberPrincipal = $authorization->principal($memberContext);
    if ($memberPrincipal->root || $memberPrincipal->tenantId !== $tenantId
        || $memberPrincipal->id !== (int)$member['id']
        || in_array('core.tenant-owner', array_column($memberPrincipal->roles, 'key'), true)) {
        throw new RuntimeException('CR21_REFERENCE_MEMBER_NOT_ORDINARY');
    }
    $records = $app->make(Acme\Modules\ReferenceChain\Contract\ReferenceChainCommands::class);
    $expectReferencePermissionDenied(fn() => $records->create($memberContext, 'tenant-a-denied-before-grant'), $pdo);
    $role = $roles->replacePermissions($ownerContext, (int)$role['id'], ['acme.reference-chain.write'], (int)$role['revision']);
    $grantedPrincipal = $authorization->principal($memberContext);
    $grantDecision = $authorization->decide($memberContext, $grantedPrincipal, 'acme.reference-chain.write');
    if ($grantedPrincipal->root || !$grantDecision->allowed || !in_array('acme.reference-chain.write', $role['permission_keys'] ?? [], true)) {
        throw new RuntimeException('CR21_REFERENCE_MEMBER_GRANT_NOT_VISIBLE');
    }
    $created = $records->create($memberContext, 'tenant-a');
    $read = $records->list($memberContext);
    if ((int)($created['tenant_id'] ?? 0) !== $tenantId || count($read['items'] ?? []) !== 1) {
        throw new RuntimeException('CR21_REFERENCE_MEMBER_SERVICE_READ_WRITE_INVALID');
    }
    $role = $roles->replacePermissions($ownerContext, (int)$role['id'], [], (int)$role['revision']);
    $revokedPrincipal = $authorization->principal($memberContext);
    $revokeDecision = $authorization->decide($memberContext, $revokedPrincipal, 'acme.reference-chain.write');
    if ($revokedPrincipal->root || $revokeDecision->allowed || ($role['permission_keys'] ?? []) !== []) {
        throw new RuntimeException('CR21_REFERENCE_MEMBER_REVOKE_NOT_VISIBLE');
    }
    $expectReferencePermissionDenied(fn() => $records->create($memberContext, 'tenant-a-denied-after-revoke'), $pdo);
    $role = $roles->replacePermissions($ownerContext, (int)$role['id'], ['acme.reference-chain.write'], (int)$role['revision']);
    echo json_encode($snapshot() + [
        'service_write' => $created,
        'service_read' => $read,
        'role_service' => $role,
        'member_authorization' => [
            'entry' => 'native_non_root_member_grant_revoke',
            'member_id' => (int)$member['id'],
            'account_id' => (int)$memberContext->accountId,
            'tenant_id' => (int)$memberContext->tenantId,
            'root' => $memberPrincipal->root,
            'role_keys' => array_values(array_column($memberPrincipal->roles, 'key')),
            'before_grant_denied_zero_write' => true,
            'grant_visible' => true,
            'service_read_write' => true,
            'revoke_denied_zero_write' => true,
        ],
    ], JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), PHP_EOL;
    exit(0);
}
if ($action === 'enable-b') {
    $tenantId = (int)$pdo->query("SELECT id FROM pa_tenant WHERE code='tenant-b' AND status='active'")->fetchColumn();
    $app->make(PeanutAdmin\Modules\Identity\Platform\Application\PlatformTenantAdminService::class)
        ->enableModule($platformContext(), $tenantId, $module, [], 'manual', null, null, 'CR21 second Tenant enablement');
    $ownerContext = $tenantContext('tenant-b');
    $roles = $app->make(app\common\runtime\authorization\RoleAdministrationRuntime::class)->service();
    $members = $app->make(app\common\runtime\org\TenantAdminRuntime::class)->members();
    $authorization = $app->make(app\common\contract\authorization\AdminAuthorizationQuery::class);
    $tenantAuth = $app->make(PeanutAdmin\Modules\Identity\Auth\TenantAuthService::class);
    $role = $roles->create($ownerContext, 'reference-member-b', 'Reference Member B', 'CR21 Tenant B no-permission role');
    $memberEmail = 'cr21-reference-member-b-' . bin2hex(random_bytes(4)) . '@example.test';
    $memberPassword = bin2hex(random_bytes(18)) . 'Aa1!';
    $member = $members->createAdministrator(
        $ownerContext,
        $memberEmail,
        'CR21 Reference Member B',
        $memberPassword,
        null,
        [(int)$role['id']],
        true,
    );
    $memberLogin = $tenantAuth->login(
        $memberEmail,
        $memberPassword,
        'tenant-b',
        '127.0.0.1',
        'CR21 reference chain member B',
        $requestId('tenant-login-member-b'),
    );
    if (!$memberLogin instanceof PeanutAdmin\Modules\Identity\Auth\TenantAuthentication) {
        throw new RuntimeException('CR21_REFERENCE_MEMBER_B_LOGIN_DID_NOT_AUTHENTICATE');
    }
    $memberContext = $tenantAuth->context($memberLogin->tokens->access->expose(), $requestId('tenant-member-b-context'));
    $principal = $authorization->principal($memberContext);
    if ($principal->root || $principal->tenantId !== $tenantId
        || $authorization->decide($memberContext, $principal, 'acme.reference-chain.write')->allowed) {
        throw new RuntimeException('CR21_REFERENCE_MEMBER_B_CROSSTENANT_AUTHORIZATION_LEAK');
    }
    $records = $app->make(Acme\Modules\ReferenceChain\Contract\ReferenceChainCommands::class);
    $expectReferencePermissionDenied(fn() => $records->create($memberContext, 'tenant-b-denied'), $pdo);
    echo json_encode($snapshot() + [
        'cross_tenant_member_authorization' => [
            'entry' => 'native_non_root_member_cross_tenant_denied',
            'member_id' => (int)$member['id'],
            'tenant_id' => (int)$memberContext->tenantId,
            'root' => $principal->root,
            'grant_visible' => false,
            'denied_zero_write' => true,
        ],
    ], JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), PHP_EOL;
    exit(0);
}
if ($action === 'disable-tenants') {
    $service = $app->make(PeanutAdmin\Modules\Identity\Platform\Application\PlatformTenantAdminService::class);
    foreach ($pdo->query("SELECT tenant_id FROM pa_tenant_module WHERE module_key='acme.reference-chain' AND status='enabled' ORDER BY tenant_id")->fetchAll() as $row) {
        $service->disableModule($platformContext(), (int)$row['tenant_id'], $module, 'CR21 Package maintenance prerequisite');
    }
    echo json_encode($snapshot(), JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), PHP_EOL;
    exit(0);
}
if ($action === 'service-read-default') {
    $records = $app->make(Acme\Modules\ReferenceChain\Contract\ReferenceChainCommands::class)->list($tenantContext('default'));
    echo json_encode($snapshot() + ['service_read' => $records], JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), PHP_EOL;
    exit(0);
}
if ($action === 'snapshot') {
    echo json_encode($snapshot(), JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), PHP_EOL;
    exit(0);
}
throw new RuntimeException('unknown CR21 helper action');
'''


def helper_action(
    helper: Path,
    consumer: Path,
    env: dict[str, str],
    action: str,
    log: Path,
    arguments: list[str] | None = None,
) -> dict[str, Any]:
    return json_output(
        command(
            [str(PHP), str(helper), str(consumer), action, *(arguments or [])],
            cwd=consumer,
            env=env,
            log=log,
        ),
        f"consumer helper {action}",
    )


def expect(condition: bool, message: str) -> None:
    if not condition:
        fail(message)


def tenant_statuses(snapshot: dict[str, Any]) -> dict[str, str]:
    rows = snapshot.get("tenant_modules", [])
    return {str(row["code"]): str(row["status"]) for row in rows if isinstance(row, dict)}


def rbac_counts(snapshot: dict[str, Any]) -> dict[str, int]:
    rows = snapshot.get("rbac", [])
    return {str(row["code"]): int(row["grants"]) for row in rows if isinstance(row, dict)}


def package_install(
    consumer: Path,
    env: dict[str, str],
    archive: Path,
    digest: str,
    log: Path,
) -> dict[str, Any]:
    return run_think(consumer, env, [
        "module:install-package", str(archive), f"--sha256={digest}",
    ], log)


def package_update(
    consumer: Path,
    env: dict[str, str],
    archive: Path,
    digest: str,
    dry_run: bool,
    log: Path,
) -> dict[str, Any]:
    arguments = [
        "module:update-package", str(archive), f"--sha256={digest}",
    ]
    if dry_run:
        arguments.append("--dry-run")
    return run_think(consumer, env, arguments, log)


def package_disable(
    consumer: Path,
    env: dict[str, str],
    log: Path,
) -> dict[str, Any]:
    return run_think(consumer, env, ["module:disable-package", MODULE_KEY], log)


def preview_and_execute(
    consumer: Path,
    env: dict[str, str],
    output: Path,
    purge: bool,
    log: Path,
) -> tuple[dict[str, Any], dict[str, Any]]:
    arguments = ["module:uninstall-package", MODULE_KEY]
    if purge:
        arguments.append("--purge")
    preview = run_think(consumer, env, arguments, log)
    plan = preview.get("confirm_plan")
    digest = preview.get("plan_digest")
    expect(isinstance(plan, dict) and isinstance(digest, str) and re.fullmatch(r"[a-f0-9]{64}", digest) is not None,
           "retire/purge preview did not return its canonical confirmation")
    plan_path = output / ("purge-plan.json" if purge else "retire-plan.json")
    write_json(plan_path, plan, 0o600)
    execute = [*arguments, f"--confirm-plan-file={plan_path}", f"--confirm-plan-digest={digest}"]
    result = run_think(consumer, env, execute, log)
    return preview, result


def run_chain(args: argparse.Namespace) -> dict[str, Any]:
    global ROOT, LEASE_TOOL, TOOL_BINDING
    native = runpy.run_path(str(TOOL_ROOT / "scripts/p0e-runtime-qualification"))
    TOOL_BINDING = native["configure_source"](args)
    if TOOL_BINDING is not None:
        expect(bool(args.qualification_plan), "independent qualification tools require the original P0-E plan")
        ROOT = Path(TOOL_BINDING["source_root"])
        LEASE_TOOL = ROOT / "scripts/project-resource-lease"
    if not re.fullmatch(r"[0-9a-f]{40}", args.candidate):
        fail("candidate must be an exact lowercase 40-hex commit")
    if command(["git", "rev-parse", "HEAD"]).strip() != args.candidate:
        fail("candidate does not match current HEAD")
    candidate_tree = command(["git", "rev-parse", "HEAD^{tree}"]).strip()
    if not re.fullmatch(r"[0-9a-f]{40}", candidate_tree):
        fail("candidate tree identity is invalid")
    if command(["git", "status", "--porcelain", "--untracked-files=all"]).strip() != "":
        fail("candidate worktree must be clean")
    plan_path = Path(args.qualification_plan)
    qualification = read_json(plan_path)
    inputs = native["lifecycle_inputs"](args, candidate_tree)
    expect(qualification.get("candidate") == args.candidate and qualification.get("candidate_tree") == candidate_tree
           and qualification.get("lifecycle_inputs") == inputs
           and qualification.get("template_artifacts") == inputs["template_artifacts"]
           and "consumer-module-lifecycle" in qualification.get("groups", []), "fixed lifecycle plan identity differs")
    native_args = argparse.Namespace(**{
        "candidate": args.candidate, "run_id": qualification["run_id"], "lease": args.lease,
        "owner": qualification["owner"], "thread": qualification["thread"], "parent_lease": qualification["parent_lease"],
    })
    native["verify_lease"](native_args, qualification)
    apps = inputs["applications"]
    author_app, consumer_app = apps["standalone"], apps["multi-tenant"]
    expect(args.author_app == author_app["root"] and args.consumer_app == consumer_app["root"]
           and args.author_app != args.consumer_app, "only the two registered permanent APPs are admitted")
    author, consumer = Path(args.author_app), Path(args.consumer_app)
    args.author_database, args.database = author_app["database"], consumer_app["database"]
    args.database_resource, args.endpoint = consumer_app["resource_id"], consumer_app["endpoint_id"]
    args.edition = "multi-tenant"
    output = Path(args.output)
    expect(output == Path(qualification["paths"]["cache-dir"]) / "consumer-module-lifecycle"
           and not output.exists() and output.resolve() == output, "consumer output must be the absent exact lease-owned leaf")
    metadata, resources = lease_fields(args.lease)
    expect(metadata.get("candidate") == args.candidate and metadata.get("status") == "ACTIVE"
           and metadata.get("worktree") == str(ROOT), "active native source lease differs")
    def app_environment(app: dict[str, Any]) -> dict[str, str]:
        admission = native["runtime_admission"](app, app["root"], app["head"])
        native["verify_runtime_admission"](admission, qualification["owner"], qualification["thread"])
        return native["runtime_environment"](app, admission, php=str(PHP))
    author_env, consumer_env = app_environment(author_app), app_environment(consumer_app)
    for app, env in ((author_app, author_env), (consumer_app, consumer_env)):
        status = json_output(command([str(PHP), "server/database/install.php", "--status"],
                                     cwd=Path(app["root"]), env=env), "permanent APP installation")
        expect(status.get("state") == "installed" and int(status.get("health", {}).get("installed_table_count", 0)) > 0,
               "permanent APP must already be installed; no installation attempted")
    seed = native["file_reference"](inputs["consumer_identity_seed"])
    expect(str(seed) == args.identity_seed_file and seed.stat().st_mode & 0o777 == 0o600,
           "existing identity credential reference differs; no password reset is permitted")

    output.mkdir(mode=0o700, parents=True)
    logs = output / "logs"
    completed = False
    identity_context = output / "consumer-identity-context.json"
    identity_seed_path = output / "identity-seed.env"
    try:
        # The native APPs retain their Git, registry, configuration, secrets and installation identity.
        configured_registries = {label: sha256(project / "resources/project-resources.json")
                                 for label, project in (("application_a", author), ("application_b", consumer))}
        owned_before = {"application_a": app_owned_proof(author), "application_b": app_owned_proof(consumer)}
        for project in (author, consumer):
            for relative in ("server/think", "server/vendor/autoload.php", "server/app/command/ModuleCreate.php",
                             "server/app/command/ModuleCheck.php", "server/app/command/ModulePack.php",
                             "server/app/command/ModuleInstallPackage.php", "server/app/command/ModuleUpdatePackage.php",
                             "server/app/command/ModuleDisablePackage.php", "server/app/command/ModuleUninstallPackage.php"):
                expect((project / relative).is_file() and not (project / relative).is_symlink(),
                       "permanent APP native Module entry/dependencies unavailable")
        expect(not (author / "server/app/modules/acme/reference_chain").exists()
               and not (consumer / "server/app/modules/acme/reference_chain").exists(),
               "reference Module source already exists; reconcile the original run, never overwrite it")
        helper = output / "consumer-lifecycle.php"
        helper.write_text(lifecycle_helper(), encoding="utf-8")
        helper.chmod(0o600)
        initial = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        expect(initial.get("plugin") is None and initial.get("module_installation") is None
               and initial.get("owned_table") is False and initial.get("migration_count") == 0
               and initial.get("permission_count") == 0 and initial.get("rbac") == [],
               "reference Module has prior state; preserve and reconcile, never reset it")

        created = run_think(author, author_env, ["module:create", MODULE_KEY, "--vendor=acme", "--client=admin-web"], logs / "author.log")
        expect(created.get("module_key") == MODULE_KEY, "module:create returned another identity")
        backend, frontend = author_module_v1(author)
        check_v1 = run_think(author, author_env, ["module:check", MODULE_KEY], logs / "author.log")
        expect(check_v1.get("status") == "ready" and len(check_v1.get("checks", [])) == 8,
               "module:check v1 did not pass all eight checks")
        v1_path = output / "acme-reference-chain-v1.tar"
        packed_v1 = run_think(author, author_env, [
            "module:pack", MODULE_KEY, f"--output={v1_path}",
        ], logs / "author.log")
        v1_sha = str(packed_v1.get("sha256", ""))
        expect(v1_sha == sha256(v1_path), "v1 package digest changed")
        check_v1_package = run_think(author, author_env, [
            "module:check", MODULE_KEY, f"--package={v1_path}", f"--sha256={v1_sha}",
        ], logs / "author.log")
        expect(check_v1_package.get("status") == "ready", "module:check did not accept canonical v1 package")

        # Authenticate the actual installed accounts through the existing native services.
        # A private copy belongs to this invocation; the original credential file is never changed.
        shutil.copyfile(seed, identity_seed_path)
        identity_seed_path.chmod(0o600)
        issued_identity = helper_action(helper, consumer, consumer_env, "issue-identities", logs / "consumer.log",
                                       [str(identity_context), str(identity_seed_path)])
        expect(issued_identity.get("status") == "issued"
               and issued_identity.get("identity_context_file") == "written_0600"
               and not identity_context.is_symlink() and identity_context.stat().st_mode & 0o777 == 0o600,
               "native authentication did not produce a private identity context")
        identity_seed_path.unlink()

        install_v1 = package_install(
            consumer, consumer_env, v1_path, v1_sha, logs / "consumer.log"
        )
        expect(install_v1.get("operation") == "installed", "consumer v1 package install failed")
        installed_snapshot = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        expect(
            tenant_statuses(installed_snapshot) == {}
            and rbac_counts(installed_snapshot) == {}
            and installed_snapshot.get("owned_table") is True
            and installed_snapshot.get("owned_rows") == 0,
            "Package installation implicitly opened a Tenant, granted RBAC, or created business data",
        )

        fixture = helper_action(helper, consumer, consumer_env, "fixture", logs / "consumer.log")
        expect(tenant_statuses(fixture) == {} and rbac_counts(fixture) == {} and fixture.get("owned_rows") == 0,
               "synthetic Tenant fixture changed Module, RBAC, or business state")
        seeded = helper_action(
            helper,
            consumer,
            consumer_env,
            "provision-default",
            logs / "consumer.log",
            [str(identity_context)],
        )
        expect(tenant_statuses(seeded) == {"default": "enabled"},
               "formal service did not preserve Tenant A/B initial Module separation")
        expect(rbac_counts(seeded) == {"default": 1}, "Role service did not establish Tenant A RBAC")
        expect(seeded.get("owned_rows") == 1 and seeded.get("migration_count") == 1
               and len(seeded.get("service_read", {}).get("items", [])) == 1,
               "v1 Module service write/read or migration state is invalid")
        member_authorization = seeded.get("member_authorization", {})
        expect(
            member_authorization.get("entry") == "native_non_root_member_grant_revoke"
            and member_authorization.get("root") is False
            and member_authorization.get("role_keys") == ["reference-member"]
            and member_authorization.get("before_grant_denied_zero_write") is True
            and member_authorization.get("grant_visible") is True
            and member_authorization.get("service_read_write") is True
            and member_authorization.get("revoke_denied_zero_write") is True,
            "ordinary non-root member grant/revoke runtime was not proven",
        )
        enabled_b = helper_action(
            helper,
            consumer,
            consumer_env,
            "enable-b",
            logs / "consumer.log",
            [str(identity_context)],
        )
        expect(tenant_statuses(enabled_b) == {"default": "enabled", "tenant-b": "enabled"}
               and rbac_counts(enabled_b) == {"default": 1},
               "TenantModule enablement changed Package or RBAC state")
        cross_tenant_member_authorization = enabled_b.get("cross_tenant_member_authorization", {})
        expect(
            cross_tenant_member_authorization.get("entry") == "native_non_root_member_cross_tenant_denied"
            and cross_tenant_member_authorization.get("root") is False
            and cross_tenant_member_authorization.get("grant_visible") is False
            and cross_tenant_member_authorization.get("denied_zero_write") is True,
            "ordinary non-root member cross-Tenant denial was not proven",
        )

        author_module_v2(backend, frontend)
        check_v2 = run_think(author, author_env, ["module:check", MODULE_KEY], logs / "author.log")
        expect(check_v2.get("status") == "ready", "module:check v2 failed")
        v2_path = output / "acme-reference-chain-v2.tar"
        packed_v2 = run_think(author, author_env, [
            "module:pack", MODULE_KEY, f"--output={v2_path}",
        ], logs / "author.log")
        v2_sha = str(packed_v2.get("sha256", ""))
        expect(v2_sha == sha256(v2_path) and v2_sha != v1_sha, "v2 immutable package identity is invalid")
        check_v2_package = run_think(author, author_env, [
            "module:check", MODULE_KEY, f"--package={v2_path}", f"--sha256={v2_sha}",
        ], logs / "author.log")
        expect(check_v2_package.get("status") == "ready", "module:check did not accept canonical v2 package")
        before_update = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        dry_run = package_update(
            consumer, consumer_env, v2_path, v2_sha, True, logs / "consumer.log"
        )
        expect(dry_run.get("operation") == "update" and dry_run.get("dry_run") is True,
               "v2 update dry-run did not return a zero-write plan")
        after_dry_run = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        expect(after_dry_run == before_update, "v2 update dry-run changed consumer state")
        updated = package_update(
            consumer, consumer_env, v2_path, v2_sha, False, logs / "consumer.log"
        )
        expect(updated.get("operation") == "upgraded", "consumer v2 package update failed")
        after_update = helper_action(
            helper,
            consumer,
            consumer_env,
            "service-read-default",
            logs / "consumer.log",
            [str(identity_context)],
        )
        expect(after_update.get("plugin", {}).get("installed_version") == "2.0.0"
               and after_update.get("migration_count") == 2 and after_update.get("v2_column") is True,
               "v2 package, migration, and schema identity diverged")
        expect(tenant_statuses(after_update) == tenant_statuses(enabled_b)
               and rbac_counts(after_update) == rbac_counts(enabled_b)
               and after_update.get("owned_rows") == 1
               and len(after_update.get("service_read", {}).get("items", [])) == 1,
               "v2 update changed TenantModule/RBAC data or broke the Module service read")

        disabled_tenants = helper_action(
            helper,
            consumer,
            consumer_env,
            "disable-tenants",
            logs / "consumer.log",
            [str(identity_context)],
        )
        expect(set(tenant_statuses(disabled_tenants).values()) == {"disabled"}, "TenantModules were not disabled")
        disabled_package = package_disable(
            consumer, consumer_env, logs / "consumer.log"
        )
        after_disable = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        expect(disabled_package.get("operation") == "disabled"
               and after_disable.get("module_installation", {}).get("status") == "maintenance",
               "Package disable did not enter maintenance")
        reactivated = package_install(
            consumer, consumer_env, v2_path, v2_sha, logs / "consumer.log"
        )
        expect(reactivated.get("operation") == "reactivated", "same-artifact Package reactivation failed")
        after_reactivate = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        expect(after_reactivate.get("module_installation", {}).get("status") == "active"
               and rbac_counts(after_reactivate) == {"default": 1},
               "Package reactivation changed RBAC or Module state")

        retire_preview, retired = preview_and_execute(
            consumer, consumer_env, output, False, logs / "consumer.log"
        )
        expect(retired.get("operation") == "retired", "Package retire failed")
        after_retire = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        expect(after_retire.get("owned_table") is True and after_retire.get("owned_rows") == 1
               and after_retire.get("migration_count") == 2 and rbac_counts(after_retire) == {"default": 1},
               "retire did not preserve business data, migration ledger, and RBAC")
        purge_preview, purged = preview_and_execute(
            consumer, consumer_env, output, True, logs / "consumer.log"
        )
        expect(purged.get("operation") == "purged", "Package Purge failed")
        after_purge = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        expect(after_purge.get("plugin", {}).get("status") == "uninstalled"
               and after_purge.get("module_installation") is None
               and tenant_statuses(after_purge) == {"default": "disabled", "tenant-b": "disabled"}
               and after_purge.get("owned_table") is False and after_purge.get("migration_count") == 0
               and after_purge.get("permission_count") == 0 and after_purge.get("rbac") == [],
               "Purge changed TenantModule or left Package, Module, owned data, migration, catalog, or RBAC state")

        owned_after = {"application_a": app_owned_proof(author), "application_b": app_owned_proof(consumer)}
        expect(owned_after == owned_before, "consumer lifecycle changed a generated application app-owned file")
        summary = {
            "schema_version": 1,
            "status": "passed",
            "candidate": args.candidate,
            "candidate_tree": candidate_tree,
            "template_artifacts": inputs["template_artifacts"],
            "lifecycle_input_sha256": inputs["input_sha256"],
            "fixed_app_inputs": {label: native["app_binding"](app) for label, app in (("author", author_app), ("consumer", consumer_app))},
            "lease": args.lease,
            "database_resource_id": args.database_resource,
            "endpoint_id": args.endpoint,
            "author_database": args.author_database,
            "database": args.database,
            "edition": args.edition,
            "applications": {
                "author_manifest_sha256": sha256(author / ".peanut/application-manifest.json"),
                "consumer_manifest_sha256": sha256(consumer / ".peanut/application-manifest.json"),
                "app_owned_before": owned_before,
                "app_owned_after": owned_after,
                "configured_resource_registry_sha256": configured_registries,
            },
            "module": {
                "key": MODULE_KEY,
                "v1_sha256": v1_sha,
                "v2_sha256": v2_sha,
                "v2_source_tree_sha256": tree_sha256(backend),
            },
            "gates": {
                "application_a_existing_installation_native_status": "passed",
                "application_b_existing_installation_native_status": "passed",
                "check_v1_v2": "passed",
                "canonical_pack_v1_v2": "passed",
                "install_update": "passed",
                "tenant_package_rbac_separation": "passed",
                "disable_reactivate": "passed",
                "retire_purge": "passed",
                "app_owned_preservation": "passed",
                "runtime_mutation_entry": "permanent_application_native_module_cli",
                "identity_context_entry": "native_auth_service_access_tokens_from_private_file",
                "tenant_fixture_entry": "native_provision_accept_activate",
                "tenant_module_entry": "platform_tenant_admin_service",
                "rbac_entry": "role_admin_service",
                "member_authorization_entry": "native_non_root_member_grant_revoke_cross_tenant_denied",
                "business_data_entry": "module_contract_service",
                "source_private_fixture_copy": "not_used",
                "generation_mode": "fixed_adopted_permanent_applications",
            },
            "snapshots": {
                "after_update": after_update,
                "after_retire": after_retire,
                "after_purge": after_purge,
            },
            "preview_digests": {
                "retire": retire_preview["plan_digest"],
                "purge": purge_preview["plan_digest"],
            },
        }
        write_json(output / "summary.json", summary)
        completed = True
        return summary
    finally:
        # Retain diagnostics, never retained login tokens or seed passwords.
        identity_context.unlink(missing_ok=True)
        identity_seed_path.unlink(missing_ok=True)
        # Preserve Module artifacts, logs and recovery plans; never delete a permanent APP.
        # Only the two invocation-owned private authentication files above are removed.


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--candidate", required=True)
    parser.add_argument("--source-root")
    parser.add_argument("--qualification-tool-commit")
    parser.add_argument("--qualification-tool-files-sha256")
    parser.add_argument("--lease", required=True)
    parser.add_argument("--lifecycle-input", required=True, help="Exact native template/CLI/permanent APP input manifest")
    parser.add_argument("--lifecycle-input-sha256", required=True)
    parser.add_argument("--qualification-plan", required=True)
    parser.add_argument("--author-app", required=True)
    parser.add_argument("--consumer-app", required=True)
    parser.add_argument("--identity-seed-file", required=True, help="Existing private account credentials; never an installer seed/reset")
    parser.add_argument("--output", required=True)
    parser.add_argument("--keep", action="store_true", help="Evidence is always preserved; no APP cleanup")
    return parser.parse_args()


def main() -> int:
    try:
        summary = run_chain(parse_arguments())
        print(json.dumps(summary, ensure_ascii=False, sort_keys=True))
        return 0
    except ChainError as exception:
        print(f"consumer-module-reference-chain: {exception}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
