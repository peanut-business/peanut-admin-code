import secrets
import shutil
import stat
import subprocess
import sys
import tarfile
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parent.parent
TOOL_ROOT = ROOT
TOOL_BINDING: dict[str, Any] | None = None
LEASE_TOOL = ROOT / "scripts/project-resource-lease"
PHP = Path(os.environ.get("PEANUT_PHP_BINARY") or shutil.which("php") or "/usr/bin/php")
COMPOSER = ROOT / "scripts/project-composer"
MODULE_KEY = "acme.reference-chain"
BACKEND_ENVIRONMENT_KEYS = {
    "APP_ENV",
    "APP_DEBUG",
    "PEANUT_DEPLOYMENT_TARGET",
    "PEANUT_DATABASE_RESOURCE_ID",
    "PEANUT_DATABASE_ENDPOINT_ID",
    "PEANUT_DATABASE_CONSUMER",
    "DEPLOYMENT_MODE",
    "DB_HOST",
    "DB_PORT",
    "DB_NAME",
    "DB_USER",
    "DB_PASS",
    "DB_PREFIX",
    "JWT_SECRET",
    "PEANUT_MODULE_KERNEL_VERSION",
}
CONFIG_VALUES: dict[str, str] = {}


class ChainError(RuntimeError):
    pass


def fail(message: str) -> None:
    raise ChainError(message)


def command(
    arguments: list[str],
    *,
    cwd: Path | None = None,
    env: dict[str, str] | None = None,
    log: Path | None = None,
) -> str:
    merged = {
        key: value
        for key in ("PATH", "HOME", "TMPDIR", "SystemRoot", "COMSPEC", "PATHEXT")
        if (value := os.environ.get(key))
    }
    if env:
        merged.update(env)
    result = subprocess.run(
        arguments,
        cwd=ROOT if cwd is None else cwd,
        env=merged,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    if log is not None:
        log.parent.mkdir(parents=True, exist_ok=True)
        with log.open("a", encoding="utf-8") as stream:
            stream.write("$ " + " ".join(arguments) + "\n")
            stream.write(result.stdout)
            if not result.stdout.endswith("\n"):
                stream.write("\n")
    if result.returncode != 0:
        detail = result.stdout.strip().splitlines()
        suffix = detail[-1] if detail else "no output"
        fail(f"command failed ({result.returncode}): {arguments[0]}: {suffix}")
    return result.stdout


def json_output(output: str, label: str) -> dict[str, Any]:
    try:
        value = json.loads(output.strip())
        if isinstance(value, dict):
            return value
    except json.JSONDecodeError:
        pass
    for line in reversed(output.splitlines()):
        try:
            value = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(value, dict):
            return value
    fail(f"{label} did not return a JSON object")


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exception:
        fail(f"cannot read JSON {path}: {exception}")
    if not isinstance(value, dict):
        fail(f"JSON root must be an object: {path}")
    return value


def write_json(path: Path, value: Any, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    path.chmod(mode)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def app_owned_proof(project_root: Path) -> dict[str, Any]:
    manifest = read_json(project_root / ".peanut/application-manifest.json")
    files = manifest.get("files")
    if not isinstance(files, list):
        fail("application manifest files are invalid")
    paths: list[str] = []
    rows: list[str] = []
    for item in files:
        if not isinstance(item, dict) or item.get("classification") != "app-owned":
            continue
        relative = item.get("path")
        if not isinstance(relative, str) or not relative or relative.startswith("/") or ".." in Path(relative).parts:
            fail("application manifest contains an unsafe app-owned path")
        path = project_root / relative
        if not path.is_file() or path.is_symlink():
            fail(f"app-owned file is unavailable: {relative}")
        mode = stat.S_IMODE(path.stat().st_mode)
        paths.append(relative)
        rows.append(f"{relative}\0{sha256(path)}\0{mode:04o}")
    if not rows:
        fail("application manifest contains no app-owned files")
    return {
        "file_count": len(rows),
        "paths_sha256": hashlib.sha256("\n".join(paths).encode()).hexdigest(),
        "tree_sha256": hashlib.sha256("\n".join(rows).encode()).hexdigest(),
    }


def tree_sha256(root: Path) -> str:
    rows: list[str] = []
    for path in sorted(root.rglob("*")):
        if path.is_file() and not path.is_symlink():
            rows.append(f"{path.relative_to(root).as_posix()}\0{sha256(path)}")
    return hashlib.sha256("\n".join(rows).encode()).hexdigest()


def lease_fields(lease_id: str) -> tuple[dict[str, str], list[tuple[str, str]]]:
    output = command([str(LEASE_TOOL), "show", "--lease", lease_id])
    metadata: dict[str, str] = {}
    resources: list[tuple[str, str]] = []
    in_resources = False
    for line in output.splitlines():
        if line == "resources":
            in_resources = True
            continue
        parts = line.split("\t", 1)
        if len(parts) != 2:
            continue
        if in_resources:
            resources.append((parts[0], parts[1]))
        else:
            metadata[parts[0]] = parts[1]
    return metadata, resources


def registered_database(resource_id: str, endpoint_id: str, database: str, qualification: dict[str, Any] | None = None) -> tuple[str, int]:
    """Use the existing registry as authority; caller strings never grant a database."""
    expect(bool(os.environ.get("PEANUT_RESOURCE_REGISTRY")),
           "CR21 requires PEANUT_RESOURCE_REGISTRY pointing to the verified private Project registry")
    registry_path = Path(os.environ.get("PEANUT_RESOURCE_REGISTRY") or ROOT / "resources/project-resources.json")
    expect(registry_path.is_absolute() and not registry_path.is_symlink(),
           "PEANUT_RESOURCE_REGISTRY must be an absolute, non-symlink file")
    registry = read_json(registry_path)
    matches = [item for item in registry.get("resources", {}).get("databases", [])
               if isinstance(item, dict) and item.get("stable_resource_id") == resource_id]
    expect(len(matches) == 1, "database resource is missing or ambiguous")
    resource = matches[0]
    environments = resource.get("environments", [])
    eligible_test_resource = (
        "development-test" in environments
        and resource.get("application_runtime") is False
        and resource.get("lifecycle") == "ephemeral"
    )
    expect("development" in environments or eligible_test_resource,
           "resource is not an authorized development or ephemeral development-test runtime")
    endpoint = resource.get("upstream_endpoint")
    expect(isinstance(endpoint, dict) and endpoint.get("endpoint_id") == endpoint_id
           and "host" in endpoint.get("consumers", []), "endpoint is not the registered host endpoint")
    declared = set()
    def collect(value: Any) -> None:
        if isinstance(value, str):
            declared.add(value)
        elif isinstance(value, list):
            for item in value:
                collect(item)
        elif isinstance(value, dict):
            for item in value.values():
                collect(item)
    collect(resource.get("database"))
    collect(resource.get("synthetic_databases", {}))
    if qualification is not None:
        expect(resource_id == qualification["resource_id"]
               and sha256(registry_path) == qualification["registry_sha256"]
               and database in qualification["databases"].values(),
               "database is outside the verified P0-E registry projection")
    else:
        expect(database in declared, "database is not explicitly registered on this resource")
    host, port = endpoint.get("host"), endpoint.get("port")
    expect(isinstance(host, str) and isinstance(port, int) and 1 <= port <= 65535,
           "registered endpoint is invalid")
    expect(required_environment("DB_HOST") == host and required_environment("DB_PORT") == str(port),
           "credential endpoint differs from the registered endpoint")
    return host, port


def assert_empty_database(database: str) -> None:
    # Read-only preflight: no connection to an unregistered target, no DROP/CREATE here.
    code = r'''
$c=json_decode(stream_get_contents(STDIN),true,512,JSON_THROW_ON_ERROR);
$p=new PDO('mysql:host='.$c['host'].';port='.$c['port'].';charset=utf8mb4',$c['user'],$c['password'],[PDO::ATTR_ERRMODE=>PDO::ERRMODE_EXCEPTION]);
$q=$p->prepare('SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=?');
$q->execute([$c['database']]);
if ((int)$q->fetchColumn()!==0) throw new RuntimeException('CONSUMER_DATABASE_NOT_EMPTY');
echo "empty\n";
'''
    process = subprocess.run([str(PHP), "-r", code], text=True, input=json.dumps({
        "host": required_environment("DB_HOST"), "port": required_environment("DB_PORT"),
        "user": required_environment("DB_USER"), "password": required_environment("DB_PASS"),
        "database": database,
    }), stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    expect(process.returncode == 0 and process.stdout.strip() == "empty",
           "database preflight failed or target contains existing data; no reset performed")


def required_environment(name: str) -> str:
    value = CONFIG_VALUES.get(name, "")
    if value == "":
        fail(f"missing required environment: {name}")
    return value


def ini_quote(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def configure_generated_database(
    project: Path,
    resource_id: str,
    endpoint_id: str,
    database: str,
) -> str:
    registry_path = project / "resources/project-resources.json"
    registry = read_json(registry_path)
    resources = registry.get("resources")
    if not isinstance(resources, dict) or not isinstance(resources.get("databases"), list):
        fail("generated application database registry is invalid")
    host = required_environment("DB_HOST")
    port = required_environment("DB_PORT")
    if not port.isdigit():
        fail("registered database port is invalid")
    if any(item.get("stable_resource_id") == resource_id for item in resources["databases"] if isinstance(item, dict)):
        fail("generated application database resource is duplicated")
    resources["databases"].append({
        "stable_resource_id": resource_id,
        "purpose": "CR21 lease-owned independent application lifecycle verification",
        "environments": ["development"],
        "owner": "CR21 generated application owner",
        "service_type": "mysql",
        "version": "8.4.10",
        "database": database,
        "deployment_modes": ["multi-tenant"],
        "schema": "pa_ table prefix",
        "namespace": database,
        "upstream_endpoint": {
            "endpoint_id": endpoint_id,
            "host": host,
            "port": int(port),
            "consumers": ["host"],
            "network_scope": "lease-owned Peanut Admin development gate endpoint",
        },
        "container_endpoint": None,
        "credential_ref": "CR21 lease process environment; secret values are not persisted",
        "data_source": "fresh synthetic CR21 application database",
        "freshness_requirement": "database is absent or empty before the lease-owned fresh install",
        "health_check": "consumer-module-reference-chain validates the exact endpoint, database and empty baseline",
        "fallback": "none",
        "lifecycle": "ephemeral",
        "cleanup_responsibility": "active CR21 resource lease owner",
        "backup_responsibility": "not applicable; synthetic fresh-only data",
    })
    write_json(registry_path, registry)
    return sha256(registry_path)


def backend_environment(
    path: Path,
    database: str,
    resource_id: str,
    endpoint_id: str,
    edition: str,
) -> dict[str, str]:
    values = {
        "APP_ENV": "development",
        "APP_DEBUG": "true",
        "PEANUT_DEPLOYMENT_TARGET": "local-development",
        "PEANUT_DATABASE_RESOURCE_ID": resource_id,
        "PEANUT_DATABASE_ENDPOINT_ID": endpoint_id,
        "PEANUT_DATABASE_CONSUMER": "host",
        "DEPLOYMENT_MODE": edition,
        "DB_HOST": required_environment("DB_HOST"),
        "DB_PORT": required_environment("DB_PORT"),
        "DB_NAME": database,
        "DB_USER": required_environment("DB_USER"),
        "DB_PASS": required_environment("DB_PASS"),
        "DB_PREFIX": "pa_",
        "JWT_SECRET": secrets.token_hex(32),
        "TENANT_IDENTIFIER_HMAC_KEY": secrets.token_hex(32),
        "PLATFORM_IDENTIFIER_HMAC_KEY": secrets.token_hex(32),
        "ASYNC_SIGNING_KEY": secrets.token_hex(32),
        "PEANUT_MODULE_KERNEL_VERSION": "1.0.0",
    }
    path.write_text(
        "".join(f"{key}={ini_quote(value)}\n" for key, value in values.items()),
        encoding="utf-8",
    )
    path.chmod(0o600)
    return {"PEANUT_SERVER_ENV_FILE": str(path)}


def extract_installer(package: Path, artifact: dict[str, Any], target: Path) -> None:
    archive = artifact.get("archive")
    if not isinstance(archive, dict) or archive.get("format") != "tar.gz":
        fail("Edition installer artifact archive contract is invalid")
    archive_root = archive.get("root")
    if not isinstance(archive_root, str) or not re.fullmatch(r"[A-Za-z0-9._-]+", archive_root):
        fail("Edition installer archive root is invalid")
    if archive.get("sha256") != sha256(package):
        fail("Edition installer archive digest differs from its fixed manifest")
    expect(not target.exists() and not target.is_symlink(), "Edition installer target already exists")
    stage = target.parent / ("." + target.name + ".extract-" + secrets.token_hex(6))
    stage.mkdir(mode=0o700)
    try:
        with tarfile.open(package, "r:gz") as archive_file:
            members = archive_file.getmembers()
            expect(bool(members), "Edition installer archive is empty")
            expect(len({member.name for member in members}) == len(members), "Edition installer contains duplicate members")
            for member in members:
                parts = Path(member.name).parts
                expect(parts and parts[0] == archive_root and ".." not in parts
                       and not member.issym() and not member.islnk()
                       and (member.isdir() or member.isfile()),
                       "Edition installer contains an unsafe member")
            archive_file.extractall(stage, filter="data")
        extracted = stage / archive_root
        expect(extracted.is_dir() and not extracted.is_symlink(), "Edition installer root is missing")
        application_manifest = extracted / ".peanut/application-manifest.json"
        expect(application_manifest.is_file() and not application_manifest.is_symlink()
               and artifact.get("application", {}).get("manifest_sha256") == sha256(application_manifest),
               "Edition installer application manifest digest is invalid")
        marker = extracted / ".peanut/internal-candidate.json"
        if artifact.get("protocol") == "peanut.internal-edition-candidate.v1":
            import runpy
            contract = runpy.run_path(str(ROOT / "scripts/internal_candidate_contract.py"))
            try:
                contract["verify"](extracted, artifact)
            except (ValueError, OSError, KeyError, TypeError) as error:
                fail("internal Edition candidate integrity failed: " + str(error))
        else:
            expect(not marker.exists(), "formal Edition installer contains internal candidate marker")
        expect(not target.exists() and not target.is_symlink(), "Edition installer target already exists")
        os.replace(extracted, target)
    finally:
        shutil.rmtree(stage, ignore_errors=True)


def validate_installer_artifact(
    args: argparse.Namespace,
    candidate_tree: str,
    installer_package: Path,
    installer_manifest: Path,
    installer_artifact: dict[str, Any],
) -> dict[str, Any]:
    if not re.fullmatch(r"[a-f0-9]{64}", args.installer_sha256) \
            or not re.fullmatch(r"[a-f0-9]{64}", args.installer_manifest_sha256) \
            or sha256(installer_package) != args.installer_sha256 \
            or sha256(installer_manifest) != args.installer_manifest_sha256:
        fail("fixed Edition installer hashes do not match the lease-bound inputs")
    protocol = installer_artifact.get("protocol")
    common_valid = (
        installer_artifact.get("schema_version") == 1
        and installer_artifact.get("edition", {}).get("name") == args.edition
        and installer_artifact.get("source", {}).get("commit") == args.candidate
        and installer_artifact.get("source", {}).get("tree") == candidate_tree
        and installer_artifact.get("archive", {}).get("filename") == installer_package.name
    )
    if args.installer_mode == "formal":
        if not common_valid or protocol != "peanut.edition-installer.v1":
            fail("fixed Edition installer identity does not match candidate/tree/edition")
    elif args.installer_mode == "internal-candidate":
        core = installer_artifact.get("core_php_archive", {})
        core_path = core.get("path_in_archive") if isinstance(core, dict) else None
        if (
            not common_valid
            or protocol != "peanut.internal-edition-candidate.v1"
            or installer_artifact.get("scope") != "internal-candidate"
            or installer_artifact.get("status") == "formal-release"
            or not isinstance(core, dict)
            or core.get("package") != "peanut-admin/core"
            or not isinstance(core_path, str)
            or core_path.startswith("/")
            or "\\" in core_path
            or ".." in Path(core_path).parts
            or not re.fullmatch(r"[a-f0-9]{64}", str(core.get("sha256", "")))
            or not re.fullmatch(r"[a-f0-9]{40}", str(core.get("sha1", "")))
            or not re.fullmatch(r"[a-f0-9]{40}", str(core.get("source_reference", "")))
            or installer_artifact.get("formal_release", {}).get("eligible") is not False
        ):
            fail("internal Edition candidate identity does not match candidate/tree/edition")
        archive_root = installer_artifact.get("archive", {}).get("root")
        if not isinstance(archive_root, str):
            fail("internal Edition candidate identity does not match candidate/tree/edition")
        expected_member = archive_root + "/" + core_path
        with tarfile.open(installer_package, "r:gz") as archive_file:
            try:
                member = archive_file.getmember(expected_member)
            except KeyError:
                fail("internal Edition candidate Core archive is missing")
            expect(member.isfile() and not member.issym() and not member.islnk(),
                   "internal Edition candidate Core archive is unsafe")
            stream = archive_file.extractfile(member)
            expect(stream is not None, "internal Edition candidate Core archive is unreadable")
            with stream:
                data = stream.read()
            expect(hashlib.sha256(data).hexdigest() == core.get("sha256")
                   and hashlib.sha1(data).hexdigest() == core.get("sha1"),
                   "internal Edition candidate Core archive digest differs")
    else:
        fail("installer mode is invalid")
    archive = installer_artifact.get("archive", {})
    application = installer_artifact.get("application", {})
    return {
        "mode": args.installer_mode,
        "protocol": protocol,
        "archive_path": str(installer_package),
        "manifest_path": str(installer_manifest),
        "archive_sha256": args.installer_sha256,
        "manifest_sha256": args.installer_manifest_sha256,
        "archive_root": archive.get("root"),
        "application_manifest_sha256": application.get("manifest_sha256"),
        "formal_release_eligible": installer_artifact.get("formal_release", {}).get("eligible", args.installer_mode == "formal"),
    }


def install_dependencies(
    project: Path,
    _cache: Path,
    backend_env: dict[str, str],
    log: Path,
) -> None:
    environment = backend_env | ({"COMPOSER_DISABLE_NETWORK": "1"} if CONFIG_VALUES.get("DEPENDENCY_NETWORK") != "allowed" else {})
    wrapper = project / "scripts/project-composer"
    wrapper_source = COMPOSER.read_text(encoding="utf-8")
    version_match = re.search(r"^VERSION='([^']+)'$", wrapper_source, re.MULTILINE)
    if version_match is None:
        fail("source Composer wrapper has no pinned version")
    source_tool = ROOT / ".local/toolchain" / f"composer-{version_match.group(1)}.phar"
    if not source_tool.is_file() or source_tool.is_symlink():
        fail("verified source Composer tool is unavailable; run scripts/project-composer prepare")
    command([str(COMPOSER), "--version", "--no-ansi"], cwd=ROOT, env=environment, log=log)
    target_tool = project / ".local/toolchain" / source_tool.name
    target_tool.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    shutil.copy2(source_tool, target_tool)
    target_tool.chmod(0o755)
    command([str(wrapper), "--version", "--no-ansi"], cwd=project, env=environment, log=log)
    command(
        [
            str(wrapper), "install", "--working-dir=server",
            "--no-interaction", "--no-progress", "--prefer-dist",
        ],
        cwd=project,
        env=environment,
        log=log,
    )


def run_think(project: Path, env: dict[str, str], arguments: list[str], log: Path) -> dict[str, Any]:
    return json_output(
        command([str(PHP), "think", *arguments], cwd=project / "server", env=env, log=log),
        "think " + " ".join(arguments),
    )


def author_module_v1(author: Path) -> tuple[Path, Path]:
    backend = author / "server/app/modules/acme/reference_chain"
    frontend = author / "web/src/modules/acme-reference-chain"
    manifest_path = backend / "module.json"
    manifest = read_json(manifest_path)
    manifest["description"] = "CR21 independent consumer reference chain"
    identity_manifest_path = author / "server/app/modules/official/identity/module.json"
    if not identity_manifest_path.is_file():
        fail("official.identity module manifest is unavailable in the author application")
    identity_manifest = read_json(identity_manifest_path)
    identity_version = identity_manifest.get("version")
    if not isinstance(identity_version, str) or identity_version == "":
        fail("official.identity module manifest has no valid version")
    raw_dependencies = manifest.get("dependencies", [])
    if not isinstance(raw_dependencies, list):
        fail("reference-chain dependencies must be a list")
    dependencies: list[dict[str, str]] = []
    identity_seen = False
    for item in raw_dependencies:
        if not isinstance(item, dict) or not isinstance(item.get("module_key"), str) or not isinstance(item.get("version"), str):
            fail("reference-chain dependency entries must declare module_key and version")
        dependency = {"module_key": item["module_key"], "version": item["version"]}
        if dependency["module_key"] == "official.identity":
            if identity_seen:
                fail("reference-chain dependencies contain duplicate official.identity entries")
            dependency["version"] = identity_version
            identity_seen = True
        dependencies.append(dependency)
    if not identity_seen:
        dependencies.append({"module_key": "official.identity", "version": identity_version})
    manifest["dependencies"] = dependencies
    manifest["database"]["owned_tables"] = ["pa_acme_reference_chain_record"]
    manifest["contracts"]["exports"] = ["Acme\\Modules\\ReferenceChain\\Contract\\ReferenceChainCommands"]
    for directory in ["src/Contract", "src/Service"]:
        (backend / directory).mkdir(parents=True, exist_ok=True)
    write_json(manifest_path, manifest)
    (backend / "src/Contract/ReferenceChainCommands.php").write_text(
        """<?php
declare(strict_types=1);

namespace Acme\\Modules\\ReferenceChain\\Contract;

use PeanutAdmin\\Kernel\\Auth\\TenantContext;

interface ReferenceChainCommands
{
    /** @return array{id:int,tenant_id:int,reference:string} */
    public function create(TenantContext $context, string $reference): array;

    /** @return array{items:list<array{id:int,tenant_id:int,reference:string}>,has_more:bool,next_cursor:int|null} */
    public function list(TenantContext $context, int $limit = 50, int $afterId = 0): array;
}
""",
        encoding="utf-8",
    )
    (backend / "src/Service/ReferenceChainService.php").write_text(
        """<?php
declare(strict_types=1);

namespace Acme\\Modules\\ReferenceChain\\Service;

use Acme\\Modules\\ReferenceChain\\Contract\\ReferenceChainCommands;
use app\\common\\contract\\authorization\\AdminAuthorizationQuery;
use app\\common\\contract\\module\\ModuleQualificationQuery;
use PeanutAdmin\\Kernel\\Auth\\TenantContext;
use RuntimeException;
use think\\db\\Raw;
use think\\facade\\Db;

final readonly class ReferenceChainService implements ReferenceChainCommands
{
    public function __construct(
        private AdminAuthorizationQuery $authorization,
        private ModuleQualificationQuery $modules,
    ) {}

    public function create(TenantContext $context, string $reference): array
    {
        $reference = trim($reference);
        if ($reference === '' || strlen($reference) > 120) {
            throw new RuntimeException('REFERENCE_CHAIN_REFERENCE_INVALID');
        }
        $this->assertPermission($context);
        return Db::transaction(function () use ($context, $reference): array {
            $this->assertEnabled($context->tenantId);
            $id = $this->intId(Db::name('acme_reference_chain_record')->insertGetId([
                'tenant_id' => $context->tenantId,
                'reference' => $reference,
                'created_at' => new Raw('UTC_TIMESTAMP(3)'),
            ]));
            return $this->row($context->tenantId, $id);
        });
    }

    public function list(TenantContext $context, int $limit = 50, int $afterId = 0): array
    {
        if ($limit < 1 || $limit > 100) {
            throw new RuntimeException('REFERENCE_CHAIN_LIST_LIMIT_INVALID');
        }
        if ($afterId < 0) {
            throw new RuntimeException('REFERENCE_CHAIN_CURSOR_INVALID');
        }
        $this->assertPermission($context);
        $this->assertEnabled($context->tenantId);
        $rows = Db::name('acme_reference_chain_record')
            ->where('tenant_id', $context->tenantId)
            ->where('id', '>', $afterId)
            ->field(['id', 'tenant_id', 'reference'])
            ->order('id')->limit($limit + 1)->select()->toArray();
        $items = array_map(fn(array $row): array => $this->normalizeRow($row), array_slice($rows, 0, $limit));
        return [
            'items' => $items,
            'has_more' => count($rows) > $limit,
            'next_cursor' => count($rows) > $limit && $items !== [] ? $items[array_key_last($items)]['id'] : null,
        ];
    }

    private function assertEnabled(int $tenantId): void
    {
        if (!in_array('acme.reference-chain', $this->modules->activeTenantModuleKeys($tenantId), true)) {
            throw new RuntimeException('REFERENCE_CHAIN_MODULE_NOT_ENABLED');
        }
    }

    private function assertPermission(TenantContext $context): void
    {
        $principal = $this->authorization->principal($context);
        if (!$this->authorization->decide($context, $principal, 'acme.reference-chain.write')->allowed) {
            throw new RuntimeException('REFERENCE_CHAIN_PERMISSION_DENIED');
        }
    }

    /** @return array{id:int,tenant_id:int,reference:string} */
    private function row(int $tenantId, int $id): array
    {
        $row = Db::name('acme_reference_chain_record')->where('tenant_id', $tenantId)
            ->where('id', $id)->field(['id', 'tenant_id', 'reference'])->find();
        if (!is_array($row)) {
            throw new RuntimeException('REFERENCE_CHAIN_RECORD_NOT_FOUND');
        }
        return $this->normalizeRow($row);
    }

    /** @param array<string,mixed> $row @return array{id:int,tenant_id:int,reference:string} */
    private function normalizeRow(array $row): array
    {
        return [
            'id' => $this->intId($row['id'] ?? null),
            'tenant_id' => $this->intId($row['tenant_id'] ?? null),
            'reference' => (string)($row['reference'] ?? ''),
        ];
    }

    private function intId(mixed $value): int
    {
        $text = is_int($value) ? (string)$value : (is_string($value) ? $value : '');
        if ($text === '' || preg_match('/^[1-9][0-9]*$/', $text) !== 1 || $this->compareUnsigned($text, (string)PHP_INT_MAX) > 0) {
            throw new RuntimeException('REFERENCE_CHAIN_ID_OUT_OF_RANGE');
        }
        return (int)$text;
    }

    private function compareUnsigned(string $left, string $right): int
    {
        $left = ltrim($left, '0') ?: '0';
        $right = ltrim($right, '0') ?: '0';
        return strlen($left) <=> strlen($right) ?: strcmp($left, $right);
    }
}
