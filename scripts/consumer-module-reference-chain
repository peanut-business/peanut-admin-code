import shutil
import stat
import subprocess
import sys
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parent.parent
LEASE_TOOL = ROOT / "scripts/project-resource-lease"
PHP = Path(os.environ.get("PEANUT_PHP_BINARY") or shutil.which("php") or "/usr/bin/php")
COMPOSER = ROOT / "scripts/project-composer"
MODULE_KEY = "acme.reference-chain"
PACKAGE_KEY_ID = "cr21-author"
BACKEND_ENVIRONMENT_KEYS = {
    "APP_ENV",
    "APP_DEBUG",
    "PEANUT_DEPLOYMENT_TARGET",
    "PEANUT_DATABASE_RESOURCE_ID",
    "PEANUT_DATABASE_ENDPOINT_ID",
    "PEANUT_DATABASE_CONSUMER",
    "DEPLOYMENT_MODE",
    "DB_HOST",
    "DB_PORT",
    "DB_NAME",
    "DB_USER",
    "DB_PASS",
    "DB_ROOT_PASS",
    "DB_PREFIX",
    "JWT_SECRET",
    "PEANUT_MODULE_KERNEL_VERSION",
    "PEANUT_MODULE_TRUSTED_KEYS_JSON",
}
CONFIG_VALUES: dict[str, str] = {}


class ChainError(RuntimeError):
    pass


def fail(message: str) -> None:
    raise ChainError(message)


def command(
    arguments: list[str],
    *,
    cwd: Path = ROOT,
    env: dict[str, str] | None = None,
    log: Path | None = None,
) -> str:
    merged = {
        key: value
        for key in ("PATH", "HOME", "TMPDIR", "SystemRoot", "COMSPEC", "PATHEXT")
        if (value := os.environ.get(key))
    }
    if env:
        merged.update(env)
    result = subprocess.run(
        arguments,
        cwd=cwd,
        env=merged,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )
    if log is not None:
        log.parent.mkdir(parents=True, exist_ok=True)
        with log.open("a", encoding="utf-8") as stream:
            stream.write("$ " + " ".join(arguments) + "\n")
            stream.write(result.stdout)
            if not result.stdout.endswith("\n"):
                stream.write("\n")
    if result.returncode != 0:
        detail = result.stdout.strip().splitlines()
        suffix = detail[-1] if detail else "no output"
        fail(f"command failed ({result.returncode}): {arguments[0]}: {suffix}")
    return result.stdout


def json_output(output: str, label: str) -> dict[str, Any]:
    try:
        value = json.loads(output.strip())
        if isinstance(value, dict):
            return value
    except json.JSONDecodeError:
        pass
    for line in reversed(output.splitlines()):
        try:
            value = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(value, dict):
            return value
    fail(f"{label} did not return a JSON object")


def read_json(path: Path) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exception:
        fail(f"cannot read JSON {path}: {exception}")
    if not isinstance(value, dict):
        fail(f"JSON root must be an object: {path}")
    return value


def write_json(path: Path, value: Any, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps(value, ensure_ascii=False, indent=2, sort_keys=True) + "\n",
        encoding="utf-8",
    )
    path.chmod(mode)


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def app_owned_proof(project_root: Path) -> dict[str, Any]:
    manifest = read_json(project_root / ".peanut/application-manifest.json")
    files = manifest.get("files")
    if not isinstance(files, list):
        fail("application manifest files are invalid")
    paths: list[str] = []
    rows: list[str] = []
    for item in files:
        if not isinstance(item, dict) or item.get("classification") != "app-owned":
            continue
        relative = item.get("path")
        if not isinstance(relative, str) or not relative or relative.startswith("/") or ".." in Path(relative).parts:
            fail("application manifest contains an unsafe app-owned path")
        path = project_root / relative
        if not path.is_file() or path.is_symlink():
            fail(f"app-owned file is unavailable: {relative}")
        mode = stat.S_IMODE(path.stat().st_mode)
        paths.append(relative)
        rows.append(f"{relative}\0{sha256(path)}\0{mode:04o}")
    if not rows:
        fail("application manifest contains no app-owned files")
    return {
        "file_count": len(rows),
        "paths_sha256": hashlib.sha256("\n".join(paths).encode()).hexdigest(),
        "tree_sha256": hashlib.sha256("\n".join(rows).encode()).hexdigest(),
    }


def tree_sha256(root: Path) -> str:
    rows: list[str] = []
    for path in sorted(root.rglob("*")):
        if path.is_file() and not path.is_symlink():
            rows.append(f"{path.relative_to(root).as_posix()}\0{sha256(path)}")
    return hashlib.sha256("\n".join(rows).encode()).hexdigest()


def lease_fields(lease_id: str) -> tuple[dict[str, str], list[tuple[str, str]]]:
    output = command([str(LEASE_TOOL), "show", "--lease", lease_id])
    metadata: dict[str, str] = {}
    resources: list[tuple[str, str]] = []
    in_resources = False
    for line in output.splitlines():
        if line == "resources":
            in_resources = True
            continue
        parts = line.split("\t", 1)
        if len(parts) != 2:
            continue
        if in_resources:
            resources.append((parts[0], parts[1]))
        else:
            metadata[parts[0]] = parts[1]
    return metadata, resources


def registered_database(resource_id: str, endpoint_id: str, database: str) -> tuple[str, int]:
    """Use the existing registry as authority; caller strings never grant a database."""
    registry = read_json(ROOT / "resources/project-resources.json")
    matches = [item for item in registry.get("resources", {}).get("databases", [])
               if isinstance(item, dict) and item.get("stable_resource_id") == resource_id]
    expect(len(matches) == 1, "database resource is missing or ambiguous")
    resource = matches[0]
    environments = resource.get("environments", [])
    eligible_test_resource = (
        "development-test" in environments
        and resource.get("application_runtime") is True
        and resource.get("lifecycle") == "ephemeral"
    )
    expect("development" in environments or eligible_test_resource,
           "resource is not an authorized development or ephemeral development-test runtime")
    endpoint = resource.get("upstream_endpoint")
    expect(isinstance(endpoint, dict) and endpoint.get("endpoint_id") == endpoint_id
           and "host" in endpoint.get("consumers", []), "endpoint is not the registered host endpoint")
    declared = set()
    def collect(value: Any) -> None:
        if isinstance(value, str):
            declared.add(value)
        elif isinstance(value, list):
            for item in value:
                collect(item)
        elif isinstance(value, dict):
            for item in value.values():
                collect(item)
    collect(resource.get("database"))
    collect(resource.get("synthetic_databases", {}))
    expect(database in declared, "database is not explicitly registered on this resource")
    host, port = endpoint.get("host"), endpoint.get("port")
    expect(isinstance(host, str) and isinstance(port, int) and 1 <= port <= 65535,
           "registered endpoint is invalid")
    expect(required_environment("DB_HOST") == host and required_environment("DB_PORT") == str(port),
           "credential endpoint differs from the registered endpoint")
    return host, port


def assert_empty_database(database: str) -> None:
    # Read-only preflight: no connection to an unregistered target, no DROP/CREATE here.
    code = r'''
$c=json_decode(stream_get_contents(STDIN),true,512,JSON_THROW_ON_ERROR);
$p=new PDO('mysql:host='.$c['host'].';port='.$c['port'].';charset=utf8mb4',$c['user'],$c['password'],[PDO::ATTR_ERRMODE=>PDO::ERRMODE_EXCEPTION]);
$q=$p->prepare('SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=?');
$q->execute([$c['database']]);
if ((int)$q->fetchColumn()!==0) throw new RuntimeException('CONSUMER_DATABASE_NOT_EMPTY');
echo "empty\n";
'''
    process = subprocess.run([str(PHP), "-r", code], text=True, input=json.dumps({
        "host": required_environment("DB_HOST"), "port": required_environment("DB_PORT"),
        "user": required_environment("DB_USER"), "password": required_environment("DB_PASS"),
        "database": database,
    }), stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    expect(process.returncode == 0 and process.stdout.strip() == "empty",
           "database preflight failed or target contains existing data; no reset performed")


def required_environment(name: str) -> str:
    value = CONFIG_VALUES.get(name, "")
    if value == "":
        fail(f"missing required environment: {name}")
    return value


def ini_quote(value: str) -> str:
    return '"' + value.replace("\\", "\\\\").replace('"', '\\"') + '"'


def backend_ini_value(name: str, value: str) -> str:
    if name == "PEANUT_MODULE_TRUSTED_KEYS_JSON":
        if re.fullmatch(r'\{"[a-z0-9-]+":"[A-Za-z0-9+/=]+"\}', value) is None:
            fail("trusted Module key map is not a canonical single-key JSON object")
        return value
    return ini_quote(value)


def configure_generated_database(
    project: Path,
    resource_id: str,
    endpoint_id: str,
    database: str,
) -> str:
    registry_path = project / "resources/project-resources.json"
    registry = read_json(registry_path)
    resources = registry.get("resources")
    if not isinstance(resources, dict) or not isinstance(resources.get("databases"), list):
        fail("generated application database registry is invalid")
    host = required_environment("DB_HOST")
    port = required_environment("DB_PORT")
    if not port.isdigit():
        fail("registered database port is invalid")
    if any(item.get("stable_resource_id") == resource_id for item in resources["databases"] if isinstance(item, dict)):
        fail("generated application database resource is duplicated")
    resources["databases"].append({
        "stable_resource_id": resource_id,
        "purpose": "CR21 lease-owned independent application lifecycle verification",
        "environments": ["development"],
        "owner": "CR21 generated application owner",
        "service_type": "mysql",
        "version": "8.4.10",
        "database": database,
        "schema": "pa_ table prefix",
        "namespace": database,
        "upstream_endpoint": {
            "endpoint_id": endpoint_id,
            "host": host,
            "port": int(port),
            "consumers": ["host"],
            "network_scope": "lease-owned Peanut Admin development gate endpoint",
        },
        "container_endpoint": None,
        "credential_ref": "CR21 lease process environment; secret values are not persisted",
        "data_source": "fresh synthetic CR21 application database",
        "freshness_requirement": "database is absent or empty before the lease-owned fresh install",
        "health_check": "consumer-module-reference-chain validates the exact endpoint, database and empty baseline",
        "fallback": "none",
        "lifecycle": "ephemeral",
        "cleanup_responsibility": "active CR21 resource lease owner",
        "backup_responsibility": "not applicable; synthetic fresh-only data",
    })
    write_json(registry_path, registry)
    return sha256(registry_path)


def backend_environment(
    path: Path,
    database: str,
    public_key: str,
    resource_id: str,
    endpoint_id: str,
    edition: str,
) -> dict[str, str]:
    values = {
        "APP_ENV": "development",
        "APP_DEBUG": "true",
        "PEANUT_DEPLOYMENT_TARGET": "local-development",
        "PEANUT_DATABASE_RESOURCE_ID": resource_id,
        "PEANUT_DATABASE_ENDPOINT_ID": endpoint_id,
        "PEANUT_DATABASE_CONSUMER": "host",
        "DEPLOYMENT_MODE": edition,
        "DB_HOST": required_environment("DB_HOST"),
        "DB_PORT": required_environment("DB_PORT"),
        "DB_NAME": database,
        "DB_USER": required_environment("DB_USER"),
        "DB_PASS": required_environment("DB_PASS"),
        "DB_ROOT_PASS": "",
        "DB_PREFIX": "pa_",
        "JWT_SECRET": secrets.token_hex(32),
        "TENANT_IDENTIFIER_HMAC_KEY": secrets.token_hex(32),
        "PLATFORM_IDENTIFIER_HMAC_KEY": secrets.token_hex(32),
        "ASYNC_SIGNING_KEY": secrets.token_hex(32),
        "PEANUT_MODULE_KERNEL_VERSION": "1.0.0",
        "PEANUT_MODULE_TRUSTED_KEYS_JSON": json.dumps({PACKAGE_KEY_ID: public_key}, separators=(",", ":")),
    }
    path.write_text(
        "".join(f"{key}={backend_ini_value(key, value)}\n" for key, value in values.items()),
        encoding="utf-8",
    )
    path.chmod(0o600)
    return {"PEANUT_SERVER_ENV_FILE": str(path)}


def create_application(
    target: Path,
    name: str,
    slug: str,
    package: str,
    candidate_manifest: Path | None,
    edition: str,
    log: Path,
) -> None:
    arguments = [
        str(PHP), str(ROOT / "scripts/create-app"),
        f"--name={name}", f"--slug={slug}", f"--package={package}",
        f"--target={target}", f"--edition={edition}", "--profile=full",
    ]
    if candidate_manifest is not None:
        arguments.append(f"--scaffold-manifest={candidate_manifest}")
    command(arguments, log=log)


def install_dependencies(
    project: Path,
    _cache: Path,
    backend_env: dict[str, str],
    log: Path,
) -> None:
    environment = backend_env | ({"COMPOSER_DISABLE_NETWORK": "1"} if CONFIG_VALUES.get("DEPENDENCY_NETWORK") != "allowed" else {})
    wrapper = project / "scripts/project-composer"
    wrapper_source = COMPOSER.read_text(encoding="utf-8")
    version_match = re.search(r"^VERSION='([^']+)'$", wrapper_source, re.MULTILINE)
    if version_match is None:
        fail("source Composer wrapper has no pinned version")
    source_tool = ROOT / ".local/toolchain" / f"composer-{version_match.group(1)}.phar"
    if not source_tool.is_file() or source_tool.is_symlink():
        fail("verified source Composer tool is unavailable; run scripts/project-composer prepare")
    command([str(COMPOSER), "--version", "--no-ansi"], cwd=ROOT, env=environment, log=log)
    target_tool = project / ".local/toolchain" / source_tool.name
    target_tool.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    shutil.copy2(source_tool, target_tool)
    target_tool.chmod(0o755)
    command([str(wrapper), "--version", "--no-ansi"], cwd=project, env=environment, log=log)
    command(
        [
            str(wrapper), "install", "--working-dir=server",
            "--no-interaction", "--no-progress", "--prefer-dist",
        ],
        cwd=project,
        env=environment,
        log=log,
    )


def run_think(project: Path, env: dict[str, str], arguments: list[str], log: Path) -> dict[str, Any]:
    return json_output(
        command([str(PHP), "think", *arguments], cwd=project / "server", env=env, log=log),
        "think " + " ".join(arguments),
    )


def author_module_v1(author: Path) -> tuple[Path, Path]:
    backend = author / "server/app/modules/acme/reference_chain"
    frontend = author / "web/src/modules/acme-reference-chain"
    manifest_path = backend / "module.json"
    manifest = read_json(manifest_path)
    manifest["description"] = "CR21 independent consumer reference chain"
    manifest["database"]["owned_tables"] = ["pa_acme_reference_chain_record"]
    write_json(manifest_path, manifest)
    (backend / "src/Contract/ReferenceChainCommands.php").write_text(
        """<?php
declare(strict_types=1);

namespace Acme\\ReferenceChain\\Contract;

use PeanutAdmin\\Kernel\\Auth\\TenantContext;

interface ReferenceChainCommands
{
    /** @return array{id:int,tenant_id:int,reference:string} */
    public function create(TenantContext $context, string $reference): array;

    /** @return list<array{id:int,tenant_id:int,reference:string}> */
    public function list(TenantContext $context): array;
}
""",
        encoding="utf-8",
    )
    (backend / "src/Service/ReferenceChainService.php").write_text(
        """<?php
declare(strict_types=1);

namespace Acme\\ReferenceChain\\Service;

use Acme\\ReferenceChain\\Contract\\ReferenceChainCommands;
use app\\common\\contract\\authorization\\AdminAuthorizationQuery;
use PeanutAdmin\\Kernel\\Auth\\TenantContext;
use RuntimeException;
use think\\db\\Raw;
use think\\facade\\Db;

final readonly class ReferenceChainService implements ReferenceChainCommands
{
    public function __construct(private AdminAuthorizationQuery $authorization) {}

    public function create(TenantContext $context, string $reference): array
    {
        $reference = trim($reference);
        if ($reference === '' || strlen($reference) > 120) {
            throw new RuntimeException('REFERENCE_CHAIN_REFERENCE_INVALID');
        }
        $this->assertPermission($context);
        return Db::transaction(function () use ($context, $reference): array {
            $this->assertEnabled($context->tenantId);
            $id = (int)Db::name('acme_reference_chain_record')->insertGetId([
                'tenant_id' => $context->tenantId,
                'reference' => $reference,
                'created_at' => new Raw('UTC_TIMESTAMP(3)'),
            ]);
            return $this->row($context->tenantId, $id);
        });
    }

    public function list(TenantContext $context): array
    {
        $this->assertPermission($context);
        $this->assertEnabled($context->tenantId);
        return array_values(Db::name('acme_reference_chain_record')
            ->where('tenant_id', $context->tenantId)
            ->field(['id', 'tenant_id', 'reference'])
            ->order('id')->select()->toArray());
    }

    private function assertEnabled(int $tenantId): void
    {
        $enabled = Db::name('tenant_module')->where('tenant_id', $tenantId)
            ->where('module_key', 'acme.reference-chain')->where('status', 'enabled')->find();
        if ($enabled === null) {
            throw new RuntimeException('REFERENCE_CHAIN_MODULE_NOT_ENABLED');
        }
    }

    private function assertPermission(TenantContext $context): void
    {
        $principal = $this->authorization->principal($context);
        if (!$this->authorization->decide($context, $principal, 'acme.reference-chain.write')->allowed) {
            throw new RuntimeException('REFERENCE_CHAIN_PERMISSION_DENIED');
        }
    }

    /** @return array{id:int,tenant_id:int,reference:string} */
    private function row(int $tenantId, int $id): array
    {
        $row = Db::name('acme_reference_chain_record')->where('tenant_id', $tenantId)
            ->where('id', $id)->field(['id', 'tenant_id', 'reference'])->find();
        if (!is_array($row)) {
            throw new RuntimeException('REFERENCE_CHAIN_RECORD_NOT_FOUND');
        }
        return ['id' => (int)$row['id'], 'tenant_id' => (int)$row['tenant_id'], 'reference' => (string)$row['reference']];
    }
}
""",
        encoding="utf-8",
    )
    (backend / "src/ModuleProvider.php").write_text(
        """<?php
declare(strict_types=1);

namespace Acme\\ReferenceChain;

use Acme\\ReferenceChain\\Contract\\ReferenceChainCommands;
use Acme\\ReferenceChain\\Service\\ReferenceChainService;
use PeanutAdmin\\Kernel\\Module\\ModuleProvider as ModuleProviderContract;

final class ModuleProvider implements ModuleProviderContract
{
    public function moduleKey(): string
    {
        return 'acme.reference-chain';
    }

    public function bindings(): array
    {
        return [ReferenceChainCommands::class => ReferenceChainService::class];
    }
}
""",
        encoding="utf-8",
    )
    write_json(backend / "resources/permissions.json", [{
        "key": "acme.reference-chain.write",
        "type": "action",
        "name": "Write reference records",
        "risk_level": "sensitive",
    }])
    write_json(backend / "resources/menus.json", [{
        "key": "acme.reference-chain.page",
        "scope": "tenant",
        "parent_key": None,
        "type": "page",
        "name": "Reference Chain",
        "route_name": "acme-reference-chain",
        "route_path": "/app/acme/reference-chain",
        "component_key": "acme.reference-chain.page",
        "required_permission": "acme.reference-chain.write",
        "icon": "Link",
        "sort_order": 900,
        "client_keys": ["admin-web"],
    }])
    migration = backend / "database/migrations/20260828010101_create_reference_chain.sql"
    migration.write_text(
        "CREATE TABLE `pa_acme_reference_chain_record` (\n"
        "  `id` BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,\n"
        "  `tenant_id` BIGINT UNSIGNED NOT NULL,\n"
        "  `reference` VARCHAR(120) NOT NULL,\n"
        "  `created_at` DATETIME(3) NOT NULL,\n"
        "  PRIMARY KEY (`id`),\n"
        "  KEY `idx_acme_reference_tenant` (`tenant_id`,`id`),\n"
        "  CONSTRAINT `fk_acme_reference_tenant` FOREIGN KEY (`tenant_id`) REFERENCES `pa_tenant` (`id`) ON DELETE RESTRICT\n"
        ") ENGINE=InnoDB DEFAULT CHARACTER SET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci;\n",
        encoding="utf-8",
    )
    return backend, frontend


def author_module_v2(backend: Path, frontend: Path) -> None:
    for path in [backend / "module.json", backend / "composer.json", frontend / "package.json"]:
        document = read_json(path)
        document["version"] = "2.0.0"
        write_json(path, document)
    (backend / "database/migrations/20260828010201_add_revision_note.sql").write_text(
        "ALTER TABLE `pa_acme_reference_chain_record` ADD COLUMN `revision_note` VARCHAR(160) NULL AFTER `reference`;\n",
        encoding="utf-8",
    )


def lifecycle_helper() -> str:
    return r'''<?php
declare(strict_types=1);

require $argv[1] . '/server/bootstrap/environment.php';
require $argv[1] . '/server/vendor/autoload.php';

$action = $argv[2] ?? '';
$app = (new think\App($argv[1] . '/server'))->initialize();
$pdo = new PDO(
    'mysql:host=' . getenv('DB_HOST') . ';port=' . getenv('DB_PORT') . ';dbname=' . getenv('DB_NAME') . ';charset=utf8mb4',
    (string)getenv('DB_USER'),
    (string)getenv('DB_PASS'),
    [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION, PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC]
);
$module = 'acme.reference-chain';
$tableExists = static function (PDO $pdo): bool {
    return (int)$pdo->query("SELECT COUNT(*) FROM information_schema.tables WHERE table_schema=DATABASE() AND table_name='pa_acme_reference_chain_record'")->fetchColumn() === 1;
};
$snapshot = static function () use ($pdo, $module, $tableExists): array {
    $plugin = $pdo->query("SELECT installed_version,status FROM pa_plugin_installation WHERE plugin_key='acme.reference-chain'")->fetch() ?: null;
    $installation = $pdo->query("SELECT installed_version,status FROM pa_module_installation WHERE module_key='acme.reference-chain'")->fetch() ?: null;
    $tenantModules = $pdo->query("SELECT t.code,tm.status FROM pa_tenant_module tm JOIN pa_tenant t ON t.id=tm.tenant_id WHERE tm.module_key='acme.reference-chain' ORDER BY t.code")->fetchAll();
    $rbac = $pdo->query("SELECT t.code,COUNT(*) grants FROM pa_role_permission rp JOIN pa_role r ON r.tenant_id=rp.tenant_id AND r.id=rp.role_id JOIN pa_tenant t ON t.id=rp.tenant_id JOIN pa_permission p ON p.id=rp.permission_id WHERE p.module_key='acme.reference-chain' GROUP BY t.code ORDER BY t.code")->fetchAll();
    $exists = $tableExists($pdo);
    return [
        'plugin' => $plugin,
        'module_installation' => $installation,
        'tenant_modules' => $tenantModules,
        'rbac' => $rbac,
        'permission_count' => (int)$pdo->query("SELECT COUNT(*) FROM pa_permission WHERE module_key='acme.reference-chain'")->fetchColumn(),
        'migration_count' => (int)$pdo->query("SELECT COUNT(*) FROM pa_module_migration WHERE module_key='acme.reference-chain' AND status='applied'")->fetchColumn(),
        'owned_table' => $exists,
        'owned_rows' => $exists ? (int)$pdo->query('SELECT COUNT(*) FROM pa_acme_reference_chain_record')->fetchColumn() : 0,
        'v2_column' => $exists ? (int)$pdo->query("SELECT COUNT(*) FROM information_schema.columns WHERE table_schema=DATABASE() AND table_name='pa_acme_reference_chain_record' AND column_name='revision_note'")->fetchColumn() === 1 : false,
    ];
};

$platformContext = static function () use ($pdo): PeanutAdmin\Kernel\Context\PlatformContext {
    $operator = $pdo->query("SELECT id,account_id FROM pa_platform_operator WHERE status='active' ORDER BY id LIMIT 1")->fetch();
    if (!is_array($operator)) throw new RuntimeException('active Platform operator fixture is unavailable');
    return PeanutAdmin\Kernel\Context\PlatformContext::fromTrustedAutomation(
        (int)$operator['account_id'],
        (int)$operator['id'],
        'platform-web',
        'cr21-platform-' . bin2hex(random_bytes(8)),
        new DateTimeImmutable('now', new DateTimeZone('UTC')),
    );
};
$tenantContext = static function (string $tenantCode) use ($pdo): PeanutAdmin\Kernel\Auth\TenantContext {
    $query = $pdo->prepare("SELECT t.id tenant_id,t.authorization_revision,m.account_id,m.id member_id FROM pa_tenant t JOIN pa_tenant_member m ON m.tenant_id=t.id WHERE t.code=? AND t.status='active' AND m.status='active' ORDER BY m.id LIMIT 1");
    $query->execute([$tenantCode]);
    $subject = $query->fetch();
    if (!is_array($subject)) throw new RuntimeException('active Tenant member fixture is unavailable');
    return PeanutAdmin\Kernel\Auth\TenantContext::fromValidatedSession(
        new PeanutAdmin\Kernel\Auth\ValidatedTenantSession(
            1,
            'cr21-service-session',
            (int)$subject['tenant_id'],
            (int)$subject['account_id'],
            (int)$subject['member_id'],
            'admin-web',
            new DateTimeImmutable('now', new DateTimeZone('UTC')),
            (int)$subject['authorization_revision'],
        ),
        'cr21-tenant-' . bin2hex(random_bytes(8)),
    );
};

if ($action === 'fixture') {
    $tenantA = $pdo->query("SELECT id FROM pa_tenant WHERE code='default' AND status='active'")->fetchColumn();
    if ($tenantA === false) throw new RuntimeException('default Tenant is unavailable');
    $pdo->exec("INSERT INTO pa_tenant(code,name,display_name,status,activated_at,created_at,updated_at) VALUES ('tenant-b','Tenant B','Tenant B','active',UTC_TIMESTAMP(3),UTC_TIMESTAMP(3),UTC_TIMESTAMP(3))");
    echo json_encode($snapshot(), JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), PHP_EOL;
    exit(0);
}
if ($action === 'provision-default') {
    $tenantId = (int)$pdo->query("SELECT id FROM pa_tenant WHERE code='default' AND status='active'")->fetchColumn();
    $app->make(PeanutAdmin\Modules\Identity\Platform\Application\PlatformTenantAdminService::class)
        ->enableModule($platformContext(), $tenantId, $module, [], 'manual', null, null, 'CR21 formal service enablement');
    $context = $tenantContext('default');
    $roles = $app->make(app\common\runtime\authorization\RoleAdministrationRuntime::class)->service();
    $role = $roles->create($context, 'reference-owner', 'Reference Owner', 'CR21 service-owned role');
    $role = $roles->replacePermissions($context, (int)$role['id'], ['acme.reference-chain.write'], (int)$role['authorization_revision']);
    $records = $app->make(Acme\ReferenceChain\Contract\ReferenceChainCommands::class);
    $created = $records->create($context, 'tenant-a');
    echo json_encode($snapshot() + ['service_write' => $created, 'service_read' => $records->list($context), 'role_service' => $role], JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), PHP_EOL;
    exit(0);
}
if ($action === 'enable-b') {
    $tenantId = (int)$pdo->query("SELECT id FROM pa_tenant WHERE code='tenant-b' AND status='active'")->fetchColumn();
    $app->make(PeanutAdmin\Modules\Identity\Platform\Application\PlatformTenantAdminService::class)
        ->enableModule($platformContext(), $tenantId, $module, [], 'manual', null, null, 'CR21 second Tenant enablement');
    echo json_encode($snapshot(), JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), PHP_EOL;
    exit(0);
}
if ($action === 'disable-tenants') {
    $service = $app->make(PeanutAdmin\Modules\Identity\Platform\Application\PlatformTenantAdminService::class);
    foreach ($pdo->query("SELECT tenant_id FROM pa_tenant_module WHERE module_key='acme.reference-chain' AND status='enabled' ORDER BY tenant_id")->fetchAll() as $row) {
        $service->disableModule($platformContext(), (int)$row['tenant_id'], $module, 'CR21 Package maintenance prerequisite');
    }
    echo json_encode($snapshot(), JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), PHP_EOL;
    exit(0);
}
if ($action === 'service-read-default') {
    $records = $app->make(Acme\ReferenceChain\Contract\ReferenceChainCommands::class)->list($tenantContext('default'));
    echo json_encode($snapshot() + ['service_read' => $records], JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), PHP_EOL;
    exit(0);
}
if ($action === 'snapshot') {
    echo json_encode($snapshot(), JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES), PHP_EOL;
    exit(0);
}
throw new RuntimeException('unknown CR21 helper action');
'''


def helper_action(
    helper: Path,
    consumer: Path,
    env: dict[str, str],
    action: str,
    log: Path,
    arguments: list[str] | None = None,
) -> dict[str, Any]:
    return json_output(
        command(
            [str(PHP), str(helper), str(consumer), action, *(arguments or [])],
            cwd=consumer,
            env=env,
            log=log,
        ),
        f"consumer helper {action}",
    )


def expect(condition: bool, message: str) -> None:
    if not condition:
        fail(message)


def tenant_statuses(snapshot: dict[str, Any]) -> dict[str, str]:
    rows = snapshot.get("tenant_modules", [])
    return {str(row["code"]): str(row["status"]) for row in rows if isinstance(row, dict)}


def rbac_counts(snapshot: dict[str, Any]) -> dict[str, int]:
    rows = snapshot.get("rbac", [])
    return {str(row["code"]): int(row["grants"]) for row in rows if isinstance(row, dict)}


def package_install(
    consumer: Path,
    env: dict[str, str],
    archive: Path,
    digest: str,
    log: Path,
) -> dict[str, Any]:
    return run_think(consumer, env, [
        "module:install-package", str(archive), f"--sha256={digest}",
        f"--signature-key-id={PACKAGE_KEY_ID}",
    ], log)


def package_update(
    consumer: Path,
    env: dict[str, str],
    archive: Path,
    digest: str,
    dry_run: bool,
    log: Path,
) -> dict[str, Any]:
    arguments = [
        "module:update-package", str(archive), f"--sha256={digest}",
        f"--signature-key-id={PACKAGE_KEY_ID}",
    ]
    if dry_run:
        arguments.append("--dry-run")
    return run_think(consumer, env, arguments, log)


def package_disable(
    consumer: Path,
    env: dict[str, str],
    log: Path,
) -> dict[str, Any]:
    return run_think(consumer, env, ["module:disable-package", MODULE_KEY], log)


def preview_and_execute(
    consumer: Path,
    env: dict[str, str],
    output: Path,
    purge: bool,
    log: Path,
) -> tuple[dict[str, Any], dict[str, Any]]:
    arguments = ["module:uninstall-package", MODULE_KEY]
    if purge:
        arguments.append("--purge")
    preview = run_think(consumer, env, arguments, log)
    plan = preview.get("confirm_plan")
    digest = preview.get("plan_digest")
    expect(isinstance(plan, dict) and isinstance(digest, str) and re.fullmatch(r"[a-f0-9]{64}", digest) is not None,
           "retire/purge preview did not return its canonical confirmation")
    plan_path = output / ("purge-plan.json" if purge else "retire-plan.json")
    write_json(plan_path, plan, 0o600)
    execute = [*arguments, f"--confirm-plan-file={plan_path}", f"--confirm-plan-digest={digest}"]
    result = run_think(consumer, env, execute, log)
    return preview, result


def run_chain(args: argparse.Namespace) -> dict[str, Any]:
    if not re.fullmatch(r"[0-9a-f]{40}", args.candidate):
        fail("candidate must be an exact lowercase 40-hex commit")
    if command(["git", "rev-parse", "HEAD"]).strip() != args.candidate:
        fail("candidate does not match current HEAD")
    candidate_tree = command(["git", "rev-parse", "HEAD^{tree}"]).strip()
    if not re.fullmatch(r"[0-9a-f]{40}", candidate_tree):
        fail("candidate tree identity is invalid")
    if command(["git", "status", "--porcelain", "--untracked-files=no"]).strip() != "":
        fail("candidate worktree must be clean")
    candidate_manifest: Path | None = None
    candidate_release: dict[str, Any] = {}
    if args.candidate_manifest:
        candidate_manifest = Path(args.candidate_manifest)
        if (
            not candidate_manifest.is_absolute()
            or not candidate_manifest.is_file()
            or candidate_manifest.is_symlink()
            or candidate_manifest.name != "scaffold-manifest.json"
        ):
            fail("--candidate-manifest must name one regular absolute scaffold-manifest.json")
        manifest_document = read_json(candidate_manifest)
        release = manifest_document.get("release")
        if not isinstance(release, dict):
            fail("candidate manifest release identity is invalid")
        candidate_release = release
        if release.get("source_commit") != args.candidate or release.get("source_tree") != candidate_tree:
            fail("candidate manifest does not seal the selected candidate commit/tree")
    if candidate_manifest is None and not args.formal_release_adoption:
        fail("--candidate-manifest is required for an explicit development candidate")
    if candidate_manifest is not None and args.formal_release_adoption:
        fail("--candidate-manifest and --formal-release-adoption are mutually exclusive")
    if not re.fullmatch(r"[a-z][a-z0-9_]{0,63}", args.database):
        fail("database name is invalid")
    registered_database(args.database_resource, args.endpoint, args.database)
    if args.author_database:
        expect(args.author_database != args.database, "author and consumer runtime databases must differ")
        registered_database(args.database_resource, args.endpoint, args.author_database)
    output = Path(args.output)
    if not output.is_absolute() or output == Path("/") or output.exists() or output.is_symlink():
        fail("output must be an absent absolute path")
    metadata, resources = lease_fields(args.lease)
    resource_set = set(resources)
    if metadata.get("gate") == "p0e-runtime-qualification":
        cache_roots = [Path(value) for kind, value in resources if kind == "cache-dir"]
        expect(len(cache_roots) == 1 and output == cache_roots[0] / "consumer-module-lifecycle",
               "P0-E consumer output is outside the lease-owned cache")
        expected_resources = {
            ("resource-id", "peanut-admin-p0e-mysql84-gate"),
            ("endpoint", "192.168.192.2:20183"),
            ("mysql-db", args.database),
        }
    else:
        expected_resources = {
            ("database-resource", args.database_resource),
            ("endpoint", args.endpoint),
            ("database", args.database),
            ("output-root", str(output)),
            ("cache-root", str(output / "cache")),
        }
    expect(metadata.get("candidate") == args.candidate and metadata.get("status") == "ACTIVE",
           "active lease candidate does not match")
    expect(metadata.get("worktree") == str(ROOT), "active lease worktree does not match")
    expect(expected_resources.issubset(resource_set), "lease is missing a consumer Module resource")
    if args.author_database:
        expect(("database", args.author_database) in resource_set, "author database is not leased")
    assert_empty_database(args.database)
    if args.author_database:
        assert_empty_database(args.author_database)

    output.mkdir(mode=0o700, parents=True)
    logs = output / "logs"
    author = output / "application-a"
    consumer = output / "application-b"
    cache = output / "cache/composer"
    cache.mkdir(parents=True)
    completed = False
    try:
        create_application(
            author,
            "CR21 Author",
            "cr21-author",
            "consumer/author",
            candidate_manifest,
            args.edition,
            logs / "create-app-a.log",
        )
        create_application(
            consumer,
            "CR21 Consumer",
            "cr21-consumer",
            "consumer/runtime",
            candidate_manifest,
            args.edition,
            logs / "create-app-b.log",
        )
        inventory = read_json(ROOT / "scaffold/application-template-inventory.json")
        template_version = str(inventory.get("template_version", ""))
        release_identity: dict[str, Any] = candidate_release
        if not release_identity and args.formal_release_adoption:
            release = read_json(ROOT / "scaffold/releases" / f"v{template_version}" / "scaffold-manifest.json")
            release_identity = release.get("release", {})
        for project in [author, consumer]:
            manifest = read_json(project / ".peanut/application-manifest.json")
            adopted = bool(release_identity)
            expected_template_commit = str(release_identity.get("source_commit", "")) if adopted else args.candidate
            expected_template_tree = str(release_identity.get("source_tree", "")) if adopted else candidate_tree
            expect(manifest.get("template", {}).get("source_commit") == expected_template_commit
                   and manifest.get("template", {}).get("source_tree") == expected_template_tree
                   and manifest.get("template", {}).get("version") == template_version
                   and manifest.get("generation_source", {}).get("commit") == args.candidate
                   and manifest.get("generation_source", {}).get("tree") == candidate_tree
                   and manifest.get("application", {}).get("edition") == args.edition,
                   "generated application did not use the fixed candidate")
            expect(not (project / ".git").exists(), "generated application retained source Git metadata")
            for relative in (
                "scripts/project-composer",
                "server/think",
                "server/app/command/ModuleCreate.php",
                "server/app/command/ModuleCheck.php",
                "server/app/command/ModulePack.php",
                "server/app/command/ModuleAdoptPackage.php",
                "server/app/command/ModuleInstallPackage.php",
                "server/app/command/ModuleUpdatePackage.php",
                "server/app/command/ModuleDisablePackage.php",
                "server/app/command/ModuleUninstallPackage.php",
            ):
                tool = project / relative
                expect(tool.is_file() and not tool.is_symlink(), f"generated Module tool is unavailable: {relative}")
                source = tool.read_text(encoding="utf-8")
                expect(
                    str(ROOT) not in source
                    and "/peanut-admin-project/" not in source
                    and "Project/docs" not in source,
                    f"generated Module tool retained a maintainer-private path: {relative}",
                )
        author_resource = "cr21-author-mysql84-development"
        author_endpoint = "cr21-author-mysql84-development-host"
        consumer_resource = "cr21-consumer-mysql84-development"
        consumer_endpoint = "cr21-consumer-mysql84-development-host"
        configured_registries = {
            "application_a": configure_generated_database(
                author,
                author_resource,
                author_endpoint,
                args.author_database or args.database,
            ),
            "application_b": configure_generated_database(
                consumer,
                consumer_resource,
                consumer_endpoint,
                args.database,
            ),
        }
        owned_before = {"application_a": app_owned_proof(author), "application_b": app_owned_proof(consumer)}

        keys = json_output(command([
            str(PHP), "-r",
            '$k=sodium_crypto_sign_keypair(); echo json_encode(["public"=>base64_encode(sodium_crypto_sign_publickey($k)),"secret"=>base64_encode(sodium_crypto_sign_secretkey($k))]),PHP_EOL;',
        ]), "signing key generation")
        public_key = str(keys.get("public", ""))
        secret_key = output / "author-signing-key.base64"
        secret_key.write_text(str(keys.get("secret", "")) + "\n", encoding="utf-8")
        secret_key.chmod(0o600)
        expect(public_key != "" and secret_key.stat().st_size > 1, "ephemeral signing key generation failed")
        author_env = backend_environment(
            author / "server/.env.cr21",
            args.author_database or args.database,
            public_key,
            author_resource,
            author_endpoint,
            args.edition,
        )
        consumer_env = backend_environment(
            consumer / "server/.env.cr21",
            args.database,
            public_key,
            consumer_resource,
            consumer_endpoint,
            args.edition,
        )
        install_dependencies(author, cache, author_env, logs / "composer-a.log")
        install_dependencies(consumer, cache, consumer_env, logs / "composer-b.log")
        if args.author_database:
            author_install = author / "server/.env.cr21.installation"
            author_install.write_text(
                "ADMIN_INITIAL_EMAIL=author@example.test\nADMIN_INITIAL_PASSWORD=" + secrets.token_urlsafe(24)
                + "\nPLATFORM_INITIAL_EMAIL=author-platform@example.test\nPLATFORM_INITIAL_PASSWORD="
                + secrets.token_urlsafe(24) + "\n", encoding="utf-8",
            )
            author_install.chmod(0o600)
            try:
                author_initialized = json_output(command(
                    [str(PHP), "server/database/install.php"], cwd=author,
                    env=author_env | {"PEANUT_INSTALLATION_ENV_FILE": str(author_install)},
                    log=logs / "author-install.log",
                ), "author fresh install")
                expect(author_initialized.get("state") == "installed", "author application was not initialized")
            finally:
                author_install.unlink(missing_ok=True)

        created = run_think(author, author_env, ["module:create", MODULE_KEY, "--vendor=acme"], logs / "author.log")
        expect(created.get("module_key") == MODULE_KEY, "module:create returned another identity")
        backend, frontend = author_module_v1(author)
        check_v1 = run_think(author, author_env, ["module:check", MODULE_KEY], logs / "author.log")
        expect(check_v1.get("status") == "ready" and len(check_v1.get("checks", [])) == 8,
               "module:check v1 did not pass all eight checks")
        v1_path = output / "acme-reference-chain-v1.tar"
        packed_v1 = run_think(author, author_env, [
            "module:pack", MODULE_KEY, f"--output={v1_path}", f"--signing-key-id={PACKAGE_KEY_ID}",
            f"--signing-secret-key-file={secret_key}",
        ], logs / "author.log")
        v1_sha = str(packed_v1.get("sha256", ""))
        expect(v1_sha == sha256(v1_path), "v1 package digest changed")
        check_v1_package = run_think(author, author_env, [
            "module:check", MODULE_KEY, f"--package={v1_path}", f"--sha256={v1_sha}",
        ], logs / "author.log")
        expect(check_v1_package.get("status") == "ready", "module:check did not accept signed v1 package")

        installation_path = consumer / "server/.env.cr21.installation"
        installation_credentials = (
            "ADMIN_INITIAL_EMAIL=cr21-admin@example.test\n"
            "ADMIN_INITIAL_PASSWORD=cr21-admin-strong-password\n"
        )
        if args.edition == "multi-tenant":
            installation_credentials += (
                "PLATFORM_INITIAL_EMAIL=cr21-platform@example.test\n"
                "PLATFORM_INITIAL_PASSWORD=cr21-platform-strong-password\n"
            )
        installation_path.write_text(
            installation_credentials,
            encoding="utf-8",
        )
        installation_path.chmod(0o600)
        install_env = consumer_env | {"PEANUT_INSTALLATION_ENV_FILE": str(installation_path)}
        installed = json_output(command(
            [str(PHP), "server/database/install.php"], cwd=consumer, env=install_env, log=logs / "consumer.log"
        ), "consumer fresh install")
        installation_path.unlink()
        expect(installed.get("state") == "installed"
               and int(installed.get("health", {}).get("installed_table_count", 0)) > 0,
               "consumer fresh install did not create the canonical schema")
        helper = output / "consumer-lifecycle.php"
        helper.write_text(lifecycle_helper(), encoding="utf-8")
        helper.chmod(0o600)
        install_v1 = package_install(
            consumer, consumer_env, v1_path, v1_sha, logs / "consumer.log"
        )
        expect(install_v1.get("operation") == "installed", "consumer v1 package install failed")
        installed_snapshot = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        expect(
            tenant_statuses(installed_snapshot) == {}
            and rbac_counts(installed_snapshot) == {}
            and installed_snapshot.get("owned_table") is True
            and installed_snapshot.get("owned_rows") == 0,
            "Package installation implicitly opened a Tenant, granted RBAC, or created business data",
        )

        fixture = helper_action(helper, consumer, consumer_env, "fixture", logs / "consumer.log")
        expect(tenant_statuses(fixture) == {} and rbac_counts(fixture) == {} and fixture.get("owned_rows") == 0,
               "synthetic Tenant fixture changed Module, RBAC, or business state")
        seeded = helper_action(helper, consumer, consumer_env, "provision-default", logs / "consumer.log")
        expect(tenant_statuses(seeded) == {"default": "enabled"},
               "formal service did not preserve Tenant A/B initial Module separation")
        expect(rbac_counts(seeded) == {"default": 1}, "Role service did not establish Tenant A RBAC")
        expect(seeded.get("owned_rows") == 1 and seeded.get("migration_count") == 1
               and len(seeded.get("service_read", [])) == 1,
               "v1 Module service write/read or migration state is invalid")
        enabled_b = helper_action(helper, consumer, consumer_env, "enable-b", logs / "consumer.log")
        expect(tenant_statuses(enabled_b) == {"default": "enabled", "tenant-b": "enabled"}
               and rbac_counts(enabled_b) == {"default": 1},
               "TenantModule enablement changed Package or RBAC state")

        author_module_v2(backend, frontend)
        check_v2 = run_think(author, author_env, ["module:check", MODULE_KEY], logs / "author.log")
        expect(check_v2.get("status") == "ready", "module:check v2 failed")
        v2_path = output / "acme-reference-chain-v2.tar"
        packed_v2 = run_think(author, author_env, [
            "module:pack", MODULE_KEY, f"--output={v2_path}", f"--signing-key-id={PACKAGE_KEY_ID}",
            f"--signing-secret-key-file={secret_key}",
        ], logs / "author.log")
        v2_sha = str(packed_v2.get("sha256", ""))
        expect(v2_sha == sha256(v2_path) and v2_sha != v1_sha, "v2 immutable package identity is invalid")
        check_v2_package = run_think(author, author_env, [
            "module:check", MODULE_KEY, f"--package={v2_path}", f"--sha256={v2_sha}",
        ], logs / "author.log")
        expect(check_v2_package.get("status") == "ready", "module:check did not accept signed v2 package")
        dry_run = package_update(
            consumer, consumer_env, v2_path, v2_sha, True, logs / "consumer.log"
        )
        expect(dry_run.get("operation") == "update" and dry_run.get("dry_run") is True,
               "v2 update dry-run did not return a zero-write plan")
        before_update = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        expect(before_update == enabled_b, "v2 update dry-run changed consumer state")
        updated = package_update(
            consumer, consumer_env, v2_path, v2_sha, False, logs / "consumer.log"
        )
        expect(updated.get("operation") == "upgraded", "consumer v2 package update failed")
        after_update = helper_action(helper, consumer, consumer_env, "service-read-default", logs / "consumer.log")
        expect(after_update.get("plugin", {}).get("installed_version") == "2.0.0"
               and after_update.get("migration_count") == 2 and after_update.get("v2_column") is True,
               "v2 package, migration, and schema identity diverged")
        expect(tenant_statuses(after_update) == tenant_statuses(enabled_b)
               and rbac_counts(after_update) == rbac_counts(enabled_b)
               and after_update.get("owned_rows") == 1
               and len(after_update.get("service_read", [])) == 1,
               "v2 update changed TenantModule/RBAC data or broke the Module service read")

        disabled_tenants = helper_action(helper, consumer, consumer_env, "disable-tenants", logs / "consumer.log")
        expect(set(tenant_statuses(disabled_tenants).values()) == {"disabled"}, "TenantModules were not disabled")
        disabled_package = package_disable(
            consumer, consumer_env, logs / "consumer.log"
        )
        after_disable = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        expect(disabled_package.get("operation") == "disabled"
               and after_disable.get("module_installation", {}).get("status") == "maintenance",
               "Package disable did not enter maintenance")
        reactivated = package_install(
            consumer, consumer_env, v2_path, v2_sha, logs / "consumer.log"
        )
        expect(reactivated.get("operation") == "reactivated", "same-artifact Package reactivation failed")
        after_reactivate = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        expect(after_reactivate.get("module_installation", {}).get("status") == "active"
               and rbac_counts(after_reactivate) == {"default": 1},
               "Package reactivation changed RBAC or Module state")

        retire_preview, retired = preview_and_execute(
            consumer, consumer_env, output, False, logs / "consumer.log"
        )
        expect(retired.get("operation") == "retired", "Package retire failed")
        after_retire = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        expect(after_retire.get("owned_table") is True and after_retire.get("owned_rows") == 1
               and after_retire.get("migration_count") == 2 and rbac_counts(after_retire) == {"default": 1},
               "retire did not preserve business data, migration ledger, and RBAC")
        purge_preview, purged = preview_and_execute(
            consumer, consumer_env, output, True, logs / "consumer.log"
        )
        expect(purged.get("operation") == "purged", "Package Purge failed")
        after_purge = helper_action(helper, consumer, consumer_env, "snapshot", logs / "consumer.log")
        expect(after_purge.get("plugin", {}).get("status") == "uninstalled"
               and after_purge.get("module_installation") is None
               and tenant_statuses(after_purge) == {"default": "disabled", "tenant-b": "disabled"}
               and after_purge.get("owned_table") is False and after_purge.get("migration_count") == 0
               and after_purge.get("permission_count") == 0 and after_purge.get("rbac") == [],
               "Purge changed TenantModule or left Package, Module, owned data, migration, catalog, or RBAC state")

        owned_after = {"application_a": app_owned_proof(author), "application_b": app_owned_proof(consumer)}
        expect(owned_after == owned_before, "consumer lifecycle changed a generated application app-owned file")
        summary = {
            "schema_version": 1,
            "status": "passed",
            "candidate": args.candidate,
            "candidate_tree": candidate_tree,
            "candidate_manifest_sha256": sha256(candidate_manifest) if candidate_manifest is not None else None,
            "lease": args.lease,
            "database_resource_id": args.database_resource,
            "endpoint_id": args.endpoint,
            "author_database": args.author_database,
            "database": args.database,
            "edition": args.edition,
            "applications": {
                "author_manifest_sha256": sha256(author / ".peanut/application-manifest.json"),
                "consumer_manifest_sha256": sha256(consumer / ".peanut/application-manifest.json"),
                "app_owned_before": owned_before,
                "app_owned_after": owned_after,
                "configured_resource_registry_sha256": configured_registries,
            },
            "module": {
                "key": MODULE_KEY,
                "v1_sha256": v1_sha,
                "v2_sha256": v2_sha,
                "v2_source_tree_sha256": tree_sha256(backend),
                "signature_key_id": PACKAGE_KEY_ID,
            },
            "gates": {
                "create": "passed",
                "check_v1_v2": "passed",
                "signed_pack_v1_v2": "passed",
                "install_update": "passed",
                "tenant_package_rbac_separation": "passed",
                "disable_reactivate": "passed",
                "retire_purge": "passed",
                "app_owned_preservation": "passed",
                "runtime_mutation_entry": "generated_application_module_cli",
                "tenant_fixture_entry": "synthetic_sql_fixture_not_product_entry",
                "tenant_module_entry": "platform_tenant_admin_service",
                "rbac_entry": "role_admin_service",
                "business_data_entry": "module_contract_service",
                "source_private_fixture_copy": "not_used",
                "generation_mode": (
                    "sealed_candidate_manifest"
                    if candidate_manifest is not None
                    else ("formal_release_adoption" if args.formal_release_adoption else "development_source_candidate")
                ),
                "sealed_candidate_adoption": "passed" if candidate_manifest is not None else "not_requested",
                "formal_release_adoption": "passed" if args.formal_release_adoption else "not_requested",
            },
            "snapshots": {
                "after_update": after_update,
                "after_retire": after_retire,
                "after_purge": after_purge,
            },
            "preview_digests": {
                "retire": retire_preview["plan_digest"],
                "purge": purge_preview["plan_digest"],
            },
        }
        write_json(output / "summary.json", summary)
        completed = True
        return summary
    finally:
        if completed and not args.keep:
            shutil.rmtree(output)


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--candidate", required=True)
    parser.add_argument("--lease", required=True)
    parser.add_argument("--database", required=True)
    parser.add_argument("--database-resource", required=True, help="Explicit registered development database resource")
    parser.add_argument("--endpoint", required=True, help="Explicit endpoint in that resource")
    parser.add_argument("--author-database", help="Optional separately registered and leased author runtime database")
    parser.add_argument("--output", required=True)
    parser.add_argument("--env-file", required=True)
    parser.add_argument("--candidate-manifest")
    parser.add_argument("--edition", choices=("standalone", "multi-tenant"), default="standalone")
    parser.add_argument("--formal-release-adoption", action="store_true")
    parser.add_argument("--allow-dependency-network", action="store_true", help="Permit locked package downloads; no dependency updates")
    parser.add_argument("--keep", action="store_true", help="Keep the lease-owned output after success")
    args = parser.parse_args()
    path = Path(args.env_file)
    if not path.is_absolute() or not path.is_file() or path.is_symlink() or (path.stat().st_mode & 0o777) != 0o600:
        fail("--env-file must name an absolute permission-0600 file")
    allowed = {"DB_HOST", "DB_PORT", "DB_USER", "DB_PASS"}
    for line in path.read_text(encoding="utf-8").splitlines():
        name, separator, value = line.partition("=")
        if not separator or name not in allowed or name in CONFIG_VALUES or value == "":
            fail("--env-file has an invalid schema")
        CONFIG_VALUES[name] = value
    if CONFIG_VALUES.keys() != allowed:
        fail("--env-file is missing a required database value")
    if args.allow_dependency_network:
        CONFIG_VALUES["DEPENDENCY_NETWORK"] = "allowed"
    return args


def main() -> int:
    try:
        summary = run_chain(parse_arguments())
        print(json.dumps(summary, ensure_ascii=False, sort_keys=True))
        return 0
    except ChainError as exception:
        print(f"consumer-module-reference-chain: {exception}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
