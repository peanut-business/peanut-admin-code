#!/usr/bin/env bash
set -euo pipefail

die() { printf 'ops-module-worker: %s\n' "$1" >&2; exit 1; }

[[ $# -eq 1 && "$1" == '--once' ]] || die 'usage: scripts/ops-module-worker --once'
for command_name in git jq ssh; do
  command -v "$command_name" >/dev/null || die "$command_name is required"
done

project_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
registry="${PEANUT_RESOURCE_REGISTRY:-$project_root/resources/project-resources.json}"
[[ "$registry" == /* && ! -L "$registry" ]] || die 'PEANUT_RESOURCE_REGISTRY must be an absolute, non-symlink file'
resource_id='peanut-admin-production-module-delivery-worker'
worker_json="$(jq -ce --arg id "$resource_id" '.. | objects | select(.stable_resource_id? == $id)' "$registry")" \
  || die 'registered Module delivery worker is missing'
control_checkout="$(jq -r '.control_checkout' <<<"$worker_json")"
ssh_alias="$(jq -r '.ssh_alias' <<<"$worker_json")"
deployment_root="$(jq -r '.deployment_root' <<<"$worker_json")"
target="$(jq -r '.deployment_target' <<<"$worker_json")"
[[ "$project_root" == "$control_checkout" ]] || die 'run from the registered deployment-control checkout'
[[ "$ssh_alias" == oracle3 && "$deployment_root" == /www/docker/peanut-admin && "$target" == production ]] \
  || die 'registered Module delivery boundary is invalid'
git -C "$project_root" diff --quiet || die 'deployment-control checkout has unstaged changes'
git -C "$project_root" diff --cached --quiet || die 'deployment-control checkout has staged changes'

remote_module() {
  local action="$1" task_key="${2:-}" revision="${3:-}" error_code="${4:-}"
  [[ "$action" =~ ^(claim|advance|execute|heartbeat|succeed|fail)$ ]] || return 64
  [[ -z "$task_key" || "$task_key" =~ ^job_[a-f0-9]{32}$ ]] || return 64
  [[ -z "$revision" || "$revision" =~ ^[1-9][0-9]*$ ]] || return 64
  [[ -z "$error_code" || "$error_code" =~ ^OPS_MODULE_[A-Z0-9_]+$ ]] || return 64
  ssh -o BatchMode=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=120 \
    "$ssh_alias" sudo -n bash -s -- \
    "$deployment_root" "$action" "$task_key" "$revision" "$error_code" <<'REMOTE'
set -euo pipefail
root="$1"; action="$2"; task_key="$3"; revision="$4"; error_code="$5"
[[ "$root" == /www/docker/peanut-admin ]] || exit 64
cd "$root"
command=(docker compose -f compose.yaml --profile bundled-db run -T --rm --no-deps --entrypoint php php server/think ops-module:task "$action")
[[ -z "$task_key" ]] || command+=(--task-key "$task_key")
[[ -z "$revision" ]] || command+=(--revision "$revision")
[[ -z "$error_code" ]] || command+=(--error-code "$error_code")
exec "${command[@]}"
REMOTE
}

remote_child_worker() {
  local kind="$1"
  [[ "$kind" == backup || "$kind" == restore ]] || return 64
  ssh -o BatchMode=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=120 \
    "$ssh_alias" sudo -n bash -s -- "$deployment_root" "$kind" <<'REMOTE'
set -euo pipefail
root="$1"; kind="$2"
[[ "$root" == /www/docker/peanut-admin ]] || exit 64
cd "$root"
case "$kind" in
  backup) exec scripts/ops-backup-worker --once ;;
  restore) exec scripts/ops-restore-worker --once ;;
  *) exit 64 ;;
esac
REMOTE
}

claim_json="$(remote_module claim)" || die 'Module operation task claim failed'
jq -e '.ok == true' <<<"$claim_json" >/dev/null || die 'Module operation task claim was rejected'
if [[ "$(jq -r '.result == null' <<<"$claim_json")" == true ]]; then
  printf 'ops-module-worker: no queued Module operation task\n'
  exit 0
fi

task_key="$(jq -r '.result.task_key' <<<"$claim_json")"
revision="$(jq -r '.result.execution_revision' <<<"$claim_json")"
[[ "$task_key" =~ ^job_[a-f0-9]{32}$ && "$revision" =~ ^[1-9][0-9]*$ ]] \
  || die 'claimed task identity is invalid'

failure_code='OPS_MODULE_PREFLIGHT_FAILED'
heartbeat_pid=''
worker_pid=$$
stop_heartbeat() {
  if [[ -n "$heartbeat_pid" ]]; then
    kill "$heartbeat_pid" >/dev/null 2>&1 || true
    wait "$heartbeat_pid" >/dev/null 2>&1 || true
    heartbeat_pid=''
  fi
}
mark_failed() {
  local exit_status="${1:-1}"
  trap - ERR INT TERM
  stop_heartbeat
  remote_module fail "$task_key" "$revision" "$failure_code" >/dev/null 2>&1 || true
  printf 'ops-module-worker: failed task=%s code=%s; maintenance and recovery pointer are retained\n' \
    "$task_key" "$failure_code" >&2
  [[ "$exit_status" -ne 0 ]] || exit_status=1
  exit "$exit_status"
}
heartbeat_loop() {
  while sleep 60; do
    remote_module heartbeat "$task_key" "$revision" >/dev/null \
      || { kill -TERM "$worker_pid"; return 1; }
  done
}
trap 'mark_failed $?' ERR
trap 'mark_failed 130' INT TERM
remote_module heartbeat "$task_key" "$revision" >/dev/null
heartbeat_loop &
heartbeat_pid=$!

advance_json="$(remote_module advance "$task_key" "$revision")"
jq -e '.ok == true and .result.action == "run_backup"' <<<"$advance_json" >/dev/null
failure_code='OPS_MODULE_BACKUP_FAILED'
remote_child_worker backup

advance_json="$(remote_module advance "$task_key" "$revision")"
jq -e '.ok == true and .result.action == "run_restore"' <<<"$advance_json" >/dev/null
failure_code='OPS_MODULE_RESTORE_FAILED'
remote_child_worker restore

failure_code='OPS_MODULE_MAINTENANCE_FAILED'
advance_json="$(remote_module advance "$task_key" "$revision")"
jq -e '.ok == true and .result.action == "execute"' <<<"$advance_json" >/dev/null

failure_code='OPS_MODULE_EXECUTION_FAILED'
execute_json="$(remote_module execute "$task_key" "$revision")"
jq -e '.ok == true and .result.action == "run_smoke" and (.result.result_sha256 | test("^[a-f0-9]{64}$"))' \
  <<<"$execute_json" >/dev/null

stop_heartbeat
failure_code='OPS_MODULE_SMOKE_FAILED'
succeed_json="$(remote_module succeed "$task_key" "$revision")"
jq -e '.ok == true and .result.status == "succeeded" and (.result.recovery_pointer_sha256 | test("^[a-f0-9]{64}$"))' \
  <<<"$succeed_json" >/dev/null || { failure_code='OPS_MODULE_RECOVERY_POINTER_FAILED'; false; }

trap - ERR INT TERM
printf 'ops-module-worker: succeeded task=%s operation=%s package=%s recovery_pointer=%s\n' \
  "$task_key" "$(jq -r '.result.operation' <<<"$succeed_json")" \
  "$(jq -r '.result.package_key' <<<"$succeed_json")" \
  "$(jq -r '.result.recovery_pointer_sha256' <<<"$succeed_json")"
