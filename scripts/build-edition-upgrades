#!/usr/bin/env php
<?php

declare(strict_types=1);

use app\common\infrastructure\scaffold\DeterministicEditionArchive;
use app\common\infrastructure\scaffold\EditionUpgradePackage;
use app\common\infrastructure\scaffold\Semver;

const EDITION_UPGRADE_STRICT_SEMVER = '/^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$/D';

function editionUpgradeUsage(): never
{
    fwrite(STDERR, "Usage: php scripts/build-edition-upgrades --version=<semver> --minimum-source-version=<semver> --source-commit=<full-sha> --output=<absolute-directory> [--internal-core-inputs=<absolute-release-core-inputs.json>] [--adoption-source-version=<semver> --adoption-source-commit=<full-sha>] [--check]\n");
    exit(64);
}

/** @param list<string> $command */
function editionUpgradeRun(array $command, ?string $cwd = null): string
{
    $pipes = [];
    $process = proc_open($command, [1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes, $cwd);
    if (!is_resource($process)) {
        throw new RuntimeException('EDITION_UPGRADE_PROCESS_FAILED');
    }
    $stdout = stream_get_contents($pipes[1]);
    $stderr = stream_get_contents($pipes[2]);
    fclose($pipes[1]);
    fclose($pipes[2]);
    if (proc_close($process) !== 0 || !is_string($stdout)) {
        throw new RuntimeException('EDITION_UPGRADE_COMMAND_FAILED: ' . trim((string) $stderr));
    }
    return $stdout;
}

function editionUpgradeDelete(string $path): void
{
    if (is_dir($path) && !is_link($path)) {
        foreach (array_diff(scandir($path) ?: [], ['.', '..']) as $entry) {
            editionUpgradeDelete($path . '/' . $entry);
        }
        rmdir($path);
        return;
    }
    if (file_exists($path) || is_link($path)) {
        unlink($path);
    }
}

function editionUpgradeWrite(string $path, string $content, int $mode = 0644): void
{
    if ((!is_dir(dirname($path)) && !mkdir(dirname($path), 0775, true))
        || file_put_contents($path, $content) === false || !chmod($path, $mode)) {
        throw new RuntimeException('EDITION_UPGRADE_WRITE_FAILED: ' . $path);
    }
}

/** @return array<string,string> */
function editionUpgradeInventory(string $root): array
{
    $files = [];
    $iterator = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root, FilesystemIterator::SKIP_DOTS));
    foreach ($iterator as $file) {
        if ($file->isLink() || !$file->isFile()) {
            throw new RuntimeException('EDITION_UPGRADE_MEMBER_INVALID');
        }
        $path = str_replace('\\', '/', substr($file->getPathname(), strlen($root) + 1));
        if (str_starts_with($path, 'META-INF/')) {
            continue;
        }
        $digest = hash_file('sha256', $file->getPathname());
        if (!is_string($digest)) {
            throw new RuntimeException('EDITION_UPGRADE_DIGEST_FAILED: ' . $path);
        }
        $files[$path] = $digest;
    }
    ksort($files, SORT_STRING);
    return $files;
}

$root = dirname(__DIR__);
require_once $root . '/scripts/scaffold-runtime/ScaffoldPathGuard.php';
require_once $root . '/scripts/scaffold-runtime/ScaffoldManifest.php';
require_once $root . '/scripts/scaffold-runtime/Semver.php';
require_once $root . '/scripts/scaffold-runtime/EditionUpgradePackage.php';
require_once $root . '/server/app/common/infrastructure/scaffold/DeterministicEditionArchive.php';
$options = [];
$check = false;
foreach (array_slice($argv, 1) as $argument) {
    if ($argument === '--check') {
        $check = true;
        continue;
    }
    if (preg_match('/^--(version|minimum-source-version|source-commit|output|internal-core-inputs|adoption-source-version|adoption-source-commit)=(.+)$/D', $argument, $matches) !== 1
        || isset($options[$matches[1]])) {
        editionUpgradeUsage();
    }
    $options[$matches[1]] = $matches[2];
}
foreach (['version', 'minimum-source-version', 'source-commit', 'output'] as $required) {
    if (!isset($options[$required])) {
        editionUpgradeUsage();
    }
}
foreach (['version', 'minimum-source-version'] as $versionOption) {
    if (preg_match(EDITION_UPGRADE_STRICT_SEMVER, $options[$versionOption]) !== 1) {
        editionUpgradeUsage();
    }
}
if (Semver::greaterThanOrEqualTo($options['minimum-source-version'], $options['version'])
    || explode('.', $options['minimum-source-version'], 2)[0] !== explode('.', $options['version'], 2)[0]
    || preg_match('/^[a-f0-9]{40}$/D', $options['source-commit']) !== 1
    || !str_starts_with($options['output'], '/')) {
    editionUpgradeUsage();
}
$hasAdoptionVersion = isset($options['adoption-source-version']);
$hasAdoptionCommit = isset($options['adoption-source-commit']);
if ($hasAdoptionVersion) {
    if (preg_match(EDITION_UPGRADE_STRICT_SEMVER, $options['adoption-source-version']) !== 1) {
        editionUpgradeUsage();
    }
}
if ($hasAdoptionVersion !== $hasAdoptionCommit
    || ($hasAdoptionVersion && (preg_match('/^[a-f0-9]{40}$/D', $options['adoption-source-commit']) !== 1
        || Semver::lessThan($options['adoption-source-version'], $options['minimum-source-version'])
        || Semver::greaterThanOrEqualTo($options['adoption-source-version'], $options['version'])))) {
    editionUpgradeUsage();
}
if (isset($options['internal-core-inputs']) && !str_starts_with($options['internal-core-inputs'], '/')) {
    editionUpgradeUsage();
}

$commit = trim(editionUpgradeRun(['git', '-C', $root, 'rev-parse', $options['source-commit'] . '^{commit}']));
if (!hash_equals($options['source-commit'], $commit)) {
    throw new RuntimeException('EDITION_UPGRADE_SOURCE_NOT_COMMIT');
}
$tree = trim(editionUpgradeRun(['git', '-C', $root, 'rev-parse', $commit . '^{tree}']));
$adoptionCommit = $hasAdoptionCommit
    ? trim(editionUpgradeRun(['git', '-C', $root, 'rev-parse', $options['adoption-source-commit'] . '^{commit}']))
    : null;
if ($adoptionCommit !== null && !hash_equals($options['adoption-source-commit'], $adoptionCommit)) {
    throw new RuntimeException('EDITION_UPGRADE_ADOPTION_SOURCE_NOT_COMMIT');
}
$adoptionTree = $adoptionCommit === null
    ? null
    : trim(editionUpgradeRun(['git', '-C', $root, 'rev-parse', $adoptionCommit . '^{tree}']));
$temporaryRoot = realpath(sys_get_temp_dir());
if (!is_string($temporaryRoot)) {
    throw new RuntimeException('EDITION_UPGRADE_TEMP_ROOT_INVALID');
}
$temporary = $temporaryRoot . '/peanut-edition-upgrades-' . bin2hex(random_bytes(8));
if (!mkdir($temporary, 0700, true)) {
    throw new RuntimeException('EDITION_UPGRADE_TEMP_FAILED');
}

try {
    $artifacts = [];
    foreach (['standalone', 'multi-tenant'] as $edition) {
        $target = $temporary . '/target-' . $edition;
        $scaffoldCommand = [
            'php', $root . '/scripts/build-scaffold-release',
            '--version=' . $options['version'],
            '--source-commit=' . $commit,
            '--output=' . $target,
            '--edition=' . $edition,
        ];
        if (isset($options['internal-core-inputs'])) {
            $scaffoldCommand[] = '--internal-core-inputs=' . $options['internal-core-inputs'];
        }
        editionUpgradeRun($scaffoldCommand);
        $targetManifestPath = $target . '/scaffold-manifest.json';
        $targetManifest = json_decode((string) file_get_contents($targetManifestPath), true, 512, JSON_THROW_ON_ERROR);
        if (($targetManifest['edition']['name'] ?? null) !== $edition
            || ($targetManifest['release']['source_commit'] ?? null) !== $commit
            || ($targetManifest['release']['source_tree'] ?? null) !== $tree) {
            throw new RuntimeException('EDITION_UPGRADE_TARGET_IDENTITY_INVALID');
        }
        $internalProjection = $targetManifest['internal_core_projection'] ?? null;
        if (isset($options['internal-core-inputs'])) {
            if (!is_array($internalProjection)
                || ($internalProjection['protocol'] ?? null) !== 'peanut.internal-core-scaffold-projection.v1'
                || ($internalProjection['source'] ?? null) !== ['commit' => $commit, 'tree' => $tree]
                || ($internalProjection['managed_tree_sha256']['projected'] ?? null) !== ($targetManifest['release']['managed_tree_sha256'] ?? null)
                || ($internalProjection['core_inputs_sha256'] ?? null) !== hash_file('sha256', $options['internal-core-inputs'])) {
                throw new RuntimeException('EDITION_UPGRADE_INTERNAL_PROJECTION_INVALID');
            }
            $corePath = $internalProjection['core']['archive_path'] ?? null;
            $releaseVersions = json_decode((string) file_get_contents($target . '/files/release-versions.json'), true, 512, JSON_THROW_ON_ERROR);
            $lock = json_decode((string) file_get_contents($target . '/files/server/composer.lock'), true, 512, JSON_THROW_ON_ERROR);
            $locked = array_values(array_filter($lock['packages'] ?? [], static fn(mixed $package): bool => is_array($package) && ($package['name'] ?? null) === 'peanut-admin/core'));
            if (!is_string($corePath)
                || !isset($targetManifest['files']) || !is_array($targetManifest['files'])
                || ($releaseVersions['core_php'] ?? null) !== ($internalProjection['release_versions']['after'] ?? null)
                || count($locked) !== 1
                || ($locked[0]['version'] ?? null) !== ($internalProjection['core']['resolved_version'] ?? null)
                || ($locked[0]['source']['reference'] ?? null) !== ($internalProjection['core']['source_reference'] ?? null)
                || ($locked[0]['dist']['reference'] ?? null) !== ($internalProjection['core']['source_reference'] ?? null)
                || ($locked[0]['dist']['url'] ?? null) !== '../' . $corePath
                || ($locked[0]['dist']['shasum'] ?? null) !== ($internalProjection['core']['archive_sha1'] ?? null)
                || hash_file('sha256', $target . '/files/' . $corePath) !== ($internalProjection['core']['archive_sha256'] ?? null)) {
                throw new RuntimeException('EDITION_UPGRADE_INTERNAL_DEPENDENCY_INVALID');
            }
            $managedRows = [];
            foreach ($targetManifest['files'] as $entry) {
                $path = $entry['path'] ?? null;
                $digest = $entry['template_sha256'] ?? null;
                if (!is_string($path) || !is_string($digest)
                    || hash_file('sha256', $target . '/files/' . $path) !== $digest) {
                    throw new RuntimeException('EDITION_UPGRADE_INTERNAL_TARGET_FILE_INVALID');
                }
                $managedRows[] = $path . "\0" . $digest;
            }
            sort($managedRows, SORT_STRING);
            if (hash('sha256', implode("\n", $managedRows)) !== $targetManifest['release']['managed_tree_sha256']) {
                throw new RuntimeException('EDITION_UPGRADE_INTERNAL_TARGET_TREE_INVALID');
            }
        } elseif ($internalProjection !== null) {
            throw new RuntimeException('EDITION_UPGRADE_UNEXPECTED_INTERNAL_PROJECTION');
        }
        $files = [];
        foreach ($targetManifest['files'] ?? [] as $file) {
            if (is_array($file) && is_string($file['path'] ?? null)) {
                $files[$file['path']] = $file;
            }
        }
        $migrations = [];
        foreach ($files as $path => $file) {
            if (str_starts_with($path, 'server/database/migrations/') && str_ends_with($path, '.sql')) {
                $migrations[] = ['path' => $path, 'sha256' => $file['template_sha256']];
            }
        }
        usort($migrations, static fn(array $left, array $right): int => strcmp($left['path'], $right['path']));

        $archiveRoot = 'peanut-admin-' . $options['version'] . '-' . $edition . '-upgrade';
        $package = $temporary . '/' . $archiveRoot;
        if (!mkdir($package, 0700, true) || !rename($target, $package . '/target')) {
            throw new RuntimeException('EDITION_UPGRADE_STAGE_FAILED');
        }
        $adoptionFiles = [];
        if ($adoptionCommit !== null) {
            foreach (EditionUpgradePackage::OWNERSHIP_ADOPTION_PATHS as $path) {
                if (!isset($files[$path]) || ($files[$path]['classification'] ?? null) !== 'managed') {
                    throw new RuntimeException('EDITION_UPGRADE_ADOPTION_TARGET_INVALID: ' . $path);
                }
                $contents = editionUpgradeRun(['git', '-C', $root, 'show', $adoptionCommit . ':' . $path]);
                $source = 'adoption/files/' . $path;
                editionUpgradeWrite($package . '/' . $source, $contents, 0644);
                $adoptionFiles[] = [
                    'path' => $path,
                    'source' => $source,
                    'sha256' => hash('sha256', $contents),
                    'mode' => 0644,
                    'classification' => 'managed',
                    'owner' => 'scaffold',
                ];
            }
        }
        foreach ([
            'scripts/scaffold-upgrade' => ['scripts/scaffold-upgrade', 0755],
            'scripts/scaffold-runtime/ScaffoldPathGuard.php' => ['scripts/scaffold-runtime/ScaffoldPathGuard.php', 0644],
            'scripts/scaffold-runtime/ScaffoldManifest.php' => ['scripts/scaffold-runtime/ScaffoldManifest.php', 0644],
            'scripts/scaffold-runtime/ScaffoldUpgradeLedger.php' => ['scripts/scaffold-runtime/ScaffoldUpgradeLedger.php', 0644],
            'scripts/scaffold-runtime/Semver.php' => ['scripts/scaffold-runtime/Semver.php', 0644],
            'scripts/scaffold-runtime/ReleaseDependencyIdentity.php' => ['scripts/scaffold-runtime/ReleaseDependencyIdentity.php', 0644],
            'scripts/scaffold-runtime/ScaffoldUpgradeRunner.php' => ['scripts/scaffold-runtime/ScaffoldUpgradeRunner.php', 0644],
            'scripts/scaffold-runtime/EditionUpgradePackage.php' => ['scripts/scaffold-runtime/EditionUpgradePackage.php', 0644],
            'server/app/platform/exception/plugin/PluginLifecycleException.php' => ['scripts/upgrade-runtime/PluginLifecycleException.php', 0644],
            'server/app/platform/value/plugin/PluginDescriptor.php' => ['scripts/upgrade-runtime/PluginDescriptor.php', 0644],
            'server/app/platform/infrastructure/plugin/PluginLockResolver.php' => ['scripts/upgrade-runtime/PluginLockResolver.php', 0644],
            'server/app/common/services/upgrade/ApplicationMigrationRunner.php' => ['scripts/upgrade-runtime/ApplicationMigrationRunner.php', 0644],
            'scripts/product-upgrade-database' => ['scripts/upgrade-runtime/product-upgrade-database', 0755],
            'scripts/product-upgrade-host' => ['scripts/upgrade-runtime/product-upgrade-host', 0755],
        ] as $sourcePath => [$packagePath, $mode]) {
            $contents = editionUpgradeRun(['git', '-C', $root, 'show', $commit . ':' . $sourcePath]);
            editionUpgradeWrite($package . '/' . $packagePath, $contents, $mode);
        }
        $manifest = [
            'schema_version' => 1,
            'protocol' => 'peanut.edition-upgrade-package.v1',
            'product' => ['name' => 'Peanut Admin'],
            'edition' => [
                'name' => $edition,
                'deployment_mode' => $targetManifest['edition']['deployment_mode'],
                'profile_sha256' => $targetManifest['edition']['source_sha256'],
                'generator_version' => $targetManifest['edition']['generator_version'],
                'module_profile' => $targetManifest['edition']['module_profile'],
                'tenant_bootstrap' => $targetManifest['edition']['tenant_bootstrap'],
                'schema_projection' => $targetManifest['edition']['schema']['projection'],
            ],
            'compatibility' => [
                'source' => [
                    'minimum_inclusive' => $options['minimum-source-version'],
                    'maximum_exclusive' => $options['version'],
                ],
                'major_policy' => 'same-major',
                'edition_conversion' => false,
            ],
            'build_source' => [
                'commit' => $commit,
                'tree' => $tree,
                'inventory_sha256' => $targetManifest['release']['inventory_sha256'],
            ],
            'target' => [
                'version' => $options['version'],
                'scaffold_manifest' => 'target/scaffold-manifest.json',
                'scaffold_manifest_sha256' => hash_file('sha256', $package . '/target/scaffold-manifest.json'),
                'managed_tree_sha256' => $targetManifest['release']['managed_tree_sha256'],
            ],
            'upgrader' => [
                'installed_entrypoint' => 'scripts/upgrade',
                'internal_scaffold_engine' => 'scripts/scaffold-upgrade',
                'host_driver' => 'scripts/upgrade-runtime/product-upgrade-host',
                'database_driver' => 'scripts/upgrade-runtime/product-upgrade-database',
            ],
            'migration_chain' => ['strategy' => 'append-only-ledger', 'files' => $migrations],
            'ownership' => [
                'automatic' => ['managed', 'generated-managed'],
                'preserved' => ['app-owned', 'third-party-module', 'secret'],
            ],
            'recovery' => [
                'managed_files' => 'scaffold-recovery-plan',
                'database' => 'operator-backup-required',
            ],
        ];
        if ($internalProjection !== null) {
            $manifest['scope'] = 'internal-upgrade-candidate';
            $manifest['formal_release_eligible'] = false;
            $manifest['target']['internal_core_projection'] = $internalProjection;
        }
        if ($adoptionCommit !== null) {
            $manifest['ownership']['adoption'] = [
                'protocol' => 'peanut.ownership-adoption.v1',
                'source' => [
                    'version' => $options['adoption-source-version'],
                    'commit' => $adoptionCommit,
                    'tree' => $adoptionTree,
                ],
                'files' => $adoptionFiles,
            ];
        }
        editionUpgradeWrite(
            $package . '/upgrade-manifest.json',
            json_encode($manifest, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n",
        );
        $inventory = editionUpgradeInventory($package);
        $inventoryBytes = '';
        foreach ($inventory as $path => $digest) {
            $inventoryBytes .= $path . "\0" . $digest . "\n";
        }
        editionUpgradeWrite($package . '/META-INF/files.sha256', $inventoryBytes);


        $filename = $archiveRoot . '.tar.gz';
        $archive = $temporary . '/' . $filename;
        (new DeterministicEditionArchive())->write($package, $archiveRoot, $archive);
        $artifact = [
            'schema_version' => 1,
            'protocol' => 'peanut.edition-upgrade-artifact.v1',
            'product' => ['name' => 'Peanut Admin', 'version' => $options['version']],
            'edition' => $manifest['edition'],
            'compatibility' => $manifest['compatibility'],
            'source' => $manifest['build_source'],
            'package' => [
                'manifest_sha256' => hash_file('sha256', $package . '/upgrade-manifest.json'),
                'inventory_sha256' => hash('sha256', $inventoryBytes),
            ],
            'archive' => [
                'filename' => $filename,
                'root' => $archiveRoot,
                'format' => 'tar.gz',
                'sha256' => hash_file('sha256', $archive),
                'bytes' => filesize($archive),
            ],
        ];
        if ($internalProjection !== null) {
            $artifact['scope'] = 'internal-upgrade-candidate';
            $artifact['formal_release_eligible'] = false;
        }
        $external = $filename . '.manifest.json';
        editionUpgradeWrite(
            $temporary . '/' . $external,
            json_encode($artifact, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE | JSON_THROW_ON_ERROR) . "\n",
        );
        $artifacts[] = ['edition' => $edition, 'archive' => $filename, 'manifest' => $external, 'sha256' => $artifact['archive']['sha256']];
    }
    $checksums = implode('', array_map(static fn(array $artifact): string => $artifact['sha256'] . '  ' . $artifact['archive'] . "\n", $artifacts));
    editionUpgradeWrite($temporary . '/SHA256SUMS.upgrades', $checksums);

    foreach ([...array_column($artifacts, 'archive'), ...array_column($artifacts, 'manifest'), 'SHA256SUMS.upgrades'] as $filename) {
        $built = $temporary . '/' . $filename;
        $destination = rtrim($options['output'], '/') . '/' . $filename;
        if ($check) {
            if (!is_file($destination) || !hash_equals((string) hash_file('sha256', $built), (string) hash_file('sha256', $destination))) {
                throw new RuntimeException('EDITION_UPGRADE_ARTIFACT_STALE: ' . $filename);
            }
        } else {
            editionUpgradeWrite($destination, (string) file_get_contents($built));
        }
    }
    echo json_encode([
        'status' => $check ? 'verified' : 'built',
        'version' => $options['version'],
        'minimum_source_version' => $options['minimum-source-version'],
        'source_commit' => $commit,
        'source_tree' => $tree,
        'artifacts' => $artifacts,
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n";
} finally {
    editionUpgradeDelete($temporary);
}
