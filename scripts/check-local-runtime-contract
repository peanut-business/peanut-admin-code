#!/bin/sh

set -eu

repo_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
test_dir=$(mktemp -d "${TMPDIR:-/tmp}/peanut-runtime-contract.XXXXXX")
orchestration_env="$test_dir/stack.env"
backend_env="$test_dir/server.env"
source_commit=$(git -C "$repo_dir" rev-parse HEAD)
source_tree=$(git -C "$repo_dir" rev-parse 'HEAD^{tree}')
trap 'rm -rf "$test_dir"' EXIT INT TERM

real_config_fingerprint() {
    for path in "$repo_dir/.local/stack.env" "$repo_dir/.local/container-client.env" \
        "$repo_dir/server/.env" "$repo_dir/server/.env.local-production-preview"; do
        if [ -f "$path" ] && [ ! -L "$path" ]; then
            printf '%s:' "$path"
            shasum -a 256 "$path" | awk '{print $1}'
        elif [ -e "$path" ] || [ -L "$path" ]; then
            printf '%s:non-regular\n' "$path"
        else
            printf '%s:absent\n' "$path"
        fi
    done
}
real_config_before=$(real_config_fingerprint)

cat > "$orchestration_env" <<'EOF'
PHP_PORT=22180
VITE_PORT=22181
MOBILE_PORT=22182
REDIS_PORT=22184
PC_PORT=22185
DOCS_PORT=22186
DEV_HTTP_PORT=22187
HTTP_PORT=22190
PHP_IMAGE=peanut-admin-php:contract
NGINX_IMAGE=peanut-admin-nginx:contract
PEANUT_PUBLIC_SCHEME=http
PEANUT_TRUSTED_HOSTS=localhost
EOF
printf 'PEANUT_SOURCE_COMMIT=%s\nPEANUT_SOURCE_TREE=%s\nPEANUT_DEPLOYMENT_RECEIPT_FILE=%s\n' \
    "$source_commit" "$source_tree" "$test_dir/DEPLOYMENT_RECEIPT.json" >> "$orchestration_env"
printf '{}\n' > "$test_dir/DEPLOYMENT_RECEIPT.json"
cat > "$backend_env" <<'EOF'
APP_ENV=development
APP_DEBUG=true
PEANUT_DEPLOYMENT_TARGET=local-development
PEANUT_DATABASE_RESOURCE_ID=peanut-admin-mysql84-development
PEANUT_DATABASE_ENDPOINT_ID=peanut-admin-mysql84-development-host-direct
PEANUT_DATABASE_CONSUMER=host
DEPLOYMENT_MODE=standalone
DB_HOST=192.168.192.2
DB_PORT=20183
DB_NAME=peanut_admin_development
DB_USER=peanut_admin_development
DB_PASS=contract-only-placeholder
DB_ROOT_PASS=contract-only-root-placeholder
DB_PREFIX=pa_
JWT_SECRET=contract-only-jwt-placeholder
TENANT_IDENTIFIER_HMAC_KEY=contract-only-tenant-placeholder
PLATFORM_IDENTIFIER_HMAC_KEY=contract-only-platform-placeholder
EOF
chmod 600 "$orchestration_env" "$backend_env"

urls=$(PEANUT_LOCAL_ENV_FILE="$orchestration_env" PEANUT_SERVER_ENV_FILE="$backend_env" "$repo_dir/scripts/local-stack.sh" urls)
real_config_after=$(real_config_fingerprint)
[ "$real_config_before" = "$real_config_after" ] || {
    printf 'local-stack isolated URL contract modified a real local configuration\n' >&2
    exit 1
}
[ -f "$test_dir/container-client.env" ] || {
    printf 'local-stack did not keep generated client configuration inside the isolated directory\n' >&2
    exit 1
}
for expected in 22180 22181 22182 22185 22186 22187 22190; do
    printf '%s\n' "$urls" | grep -q ":$expected/" || {
        printf 'missing custom port in URL output: %s\n' "$expected" >&2
        exit 1
    }
done

for pair in PHP_PORT=22180 VITE_PORT=22181 MOBILE_PORT=22182 REDIS_PORT=22184 PC_PORT=22185 DOCS_PORT=22186 DEV_HTTP_PORT=22187 HTTP_PORT=22190; do
    grep -qx "$pair" "$orchestration_env" || {
        printf 'ensure_env overwrote custom listener: %s\n' "$pair" >&2
        exit 1
    }
done

set -a
# shellcheck disable=SC1090 -- isolated contract environment.
. "$orchestration_env"
set +a
compose=$(docker compose --profile redis --env-file "$orchestration_env" -f "$repo_dir/deploy/docker-compose.dev.yml" config)
for mapping in 'host_ip: 127.0.0.1' 'published: "22181"' 'published: "22182"' 'published: "22184"' 'published: "22185"' 'published: "22186"' 'published: "22187"' host.docker.internal:22180; do
    printf '%s\n' "$compose" | grep -q "$mapping" || {
        printf 'Compose config is missing custom mapping: %s\n' "$mapping" >&2
        exit 1
    }
done

production_compose=$(PEANUT_SERVER_ENV_FILE="$backend_env" \
    docker compose --env-file "$orchestration_env" --env-file "$backend_env" -f "$repo_dir/deploy/docker-compose.prod.yml" config)
printf '%s\n' "$production_compose" | grep -q 'published: "22190"' || {
    printf 'production-preview Compose config lost custom HTTP_PORT\n' >&2
    exit 1
}
printf '%s\n' "$production_compose" | grep -Fq "source: $backend_env" || {
    printf 'production Nginx service lost the isolated backend environment source\n' >&2
    exit 1
}
printf '%s\n' "$production_compose" | grep -Fq 'target: /var/www/peanut-admin/server/.env.source' || {
    printf 'production Nginx service lost the read-only backend environment target\n' >&2
    exit 1
}
grep -Fq 'peanut-read-backend-enum "$backend_source" DEPLOYMENT_MODE' \
    "$repo_dir/deploy/docker/nginx-select-admin.sh" || {
    printf 'production Nginx selector lost its deployment mode source\n' >&2
    exit 1
}
if printf '%s\n' "$production_compose" | grep -q 'PHP_APP_ENV:'; then
    printf 'production Compose still exposes ThinkPHP internal aliases\n' >&2
    exit 1
fi
for entrypoint in server/think server/public/index.php; do
    grep -q 'bootstrap/environment.php' "$repo_dir/$entrypoint" || {
        printf 'PHP entry point lost the backend environment loader: %s\n' "$entrypoint" >&2
        exit 1
    }
done
for conventional_key in PLATFORM_HOSTS TENANT_ADMIN_HOSTS OWNER_INVITATION_DELIVERY_MODE PEANUT_MODULE_TRUSTED_KEYS_JSON; do
    grep -q "'$conventional_key'" "$repo_dir/server/bootstrap/environment.php" || {
        printf 'backend environment loader lost key: %s\n' "$conventional_key" >&2
        exit 1
    }
done
grep -q '\${HTTP_PORT:-18092}:80' "$repo_dir/deploy/docker-compose.prod.yml" || {
    printf 'production deployment default is no longer scoped to 18092\n' >&2
    exit 1
}

dockerfile="$repo_dir/deploy/docker/production.Dockerfile"
for mode in standalone multi-tenant; do
    grep -q "VITE_DEPLOYMENT_MODE=$mode" "$dockerfile" || {
        printf 'production admin builder lost %s mode\n' "$mode" >&2
        exit 1
    }
done
grep -q 'nginx-select-admin.sh /docker-entrypoint.d/40-select-admin.sh' "$dockerfile" || {
    printf 'production Nginx image lost the runtime admin selector\n' >&2
    exit 1
}
php_stage=$(sed -n '/^FROM php:8\.3-fpm-bookworm AS php$/,/^FROM nginx:/p' "$dockerfile")
[ "$(printf '%s\n' "$php_stage" | grep -c '^COPY \. \.$')" -eq 1 ] || {
    printf 'production PHP image lost its whole fixed-package copy\n' >&2
    exit 1
}
if grep -Eq '^server/bootstrap(/|$)' "$repo_dir/.dockerignore"; then
    printf 'production PHP image excludes the environment bootstrap directory\n' >&2
    exit 1
fi

for expectation in "web 22181 22180" "pc 22185 22180" "mobile 22182 22180"; do
    set -- $expectation
    component=$1
    listen_port=$2
    api_port=${3:-}
    case "$component" in
        mobile) component_dir=uniapp ;;
        *) component_dir=$component ;;
    esac
    client_output=$(
        cd "$repo_dir/$component_dir"
        "$repo_dir/scripts/local-client-dev" "$component" \
            --env-file "$orchestration_env" --dry-run
    )
    printf '%s\n' "$client_output" | grep -q "listen_port=$listen_port" || {
        printf 'local %s command lost custom listen port %s\n' "$component" "$listen_port" >&2
        exit 1
    }
    if [ -n "$api_port" ]; then
        printf '%s\n' "$client_output" | grep -q "api_origin=http://127.0.0.1:$api_port" || {
            printf 'local %s command lost custom API port %s\n' "$component" "$api_port" >&2
            exit 1
        }
    fi
done

printf 'local runtime override contract passed\n'
