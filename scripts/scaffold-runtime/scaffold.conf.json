      },
      "server/tests/Productization/InstallerBootstrapTest.php": {
        "MD5(CONCAT(MD5('admin123456')": "MD5(CONCAT(MD5('__INSTALLER_MUST_REPLACE__')",
        "密码：admin123456": "密码必须由安装器注入",
        "known password expression must not reach the database": "placeholder password expression must not reach the database",
        "installer must only replace the executable seed": "installer must preserve the neutral seed comment"
      },
      "scripts/check-local-runtime-contract": {
        "peanut-admin-php:contract": {
          "variable": "SLUG",
          "suffix": "-php:contract"
        },
        "peanut-admin-nginx:contract": {
          "variable": "SLUG",
          "suffix": "-nginx:contract"
        },
        "peanut-admin-mysql84-development-host-direct": {
          "variable": "SLUG",
          "suffix": "-mysql84-contract-host"
        },
        "peanut-admin-mysql84-development": {
          "variable": "SLUG",
          "suffix": "-mysql84-contract"
        },
        "DB_HOST=192.168.192.2": "DB_HOST=127.0.0.1",
        "DB_PORT=20183": "DB_PORT=3306",
        "DB_NAME=peanut_admin_development": {
          "variable": "SLUG",
          "prefix": "DB_NAME=",
          "suffix": "-contract"
        },
        "DB_USER=peanut_admin_development": {
          "variable": "SLUG",
          "prefix": "DB_USER=",
          "suffix": "-contract"
        }
      }
    }
  }
