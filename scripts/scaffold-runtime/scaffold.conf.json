      "transform": "modules-config"
    },
    {
      "paths": [
        "server/database/environment-guard.php"
      ],
      "transform": "environment-guard"
    },
    {
      "patterns": [
        "^server/app/modules/.+/composer\\.json$",
        "^(web|platform|pc|uniapp)/(?:src/)?modules/.+/package\\.json$"
      ],
      "transform": "text"
    },
    {
      "prefixes": [
        "docs/public/",
        "docs/development/",
        "docs/architecture/"
      ],
      "paths": [
        "docs/README.md",
        "docs/module-layout.md"
      ],
      "transform": "text"
    },
    {
      "paths": [
        "SECURITY.md"
      ],
      "patterns": [
        "^(docs-site/|docs/).*\\.md$"
      ],
      "transform": "docs-page"
    },
    {
      "patterns": [
        "(^|/)(config/brand|generated/brand)\\.json$"
      ],
      "transform": "brand"
    },
    {
      "patterns": [
        "/brand/(logo|favicon)\\.svg$"
      ],
      "transform": "brand-asset"
    },
    {
      "patterns": [
        "(^|/)(composer\\.json|package\\.json|package-lock\\.json|pnpm-lock\\.yaml)$"
      ],
      "transform": "package"
    },
    {
      "patterns": [
        "\\.(?i:php|json|md|sql|stub|ts|tsx|js|mjs|cjs|sh|lock|vue|css|less|scss|html|xml|yaml|yml|toml|txt|svg|conf|ini|env|example|dockerfile)$",
        "(^|/)(compose\\.yaml|think|\\.gitignore|\\.dockerignore|\\.env\\.example|\\.htaccess)$",
        "(^|/)[^/]*Dockerfile[^/]*$"
      ],
      "prefixes": [
        "scripts/"
      ],
      "transform": "text"
    }
  ],
