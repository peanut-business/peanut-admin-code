    },
    {
      "paths": [
        "LICENSE",
        "NOTICE"
      ],
      "transform": "license"
    },
    {
      "paths": [
        "CHANGELOG.md"
      ],
      "transform": "changelog"
    },
    {
      "paths": [
        "THIRD_PARTY_NOTICES.md"
      ],
