#!/usr/bin/env bash

set -Eeuo pipefail

usage() {
  printf 'Usage:\n' >&2
  printf '  scripts/combined-upgrade-qualification --candidate <full-commit> --cache <absolute-empty-dir> --output <absolute-empty-dir>\n' >&2
  printf '  scripts/combined-upgrade-qualification --validate-policy <fixture.json>\n' >&2
  exit 64
}

die() {
  printf 'combined-upgrade-qualification: %s\n' "$*" >&2
  exit 1
}

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
DEFAULT_FIXTURE="$ROOT/server/tests/fixtures/core-upgrade-compatibility/combined-upgrade.json"
PHP_BIN="/opt/homebrew/bin/php"
COMPOSER_BIN="$ROOT/scripts/project-composer"
PNPM_BIN="pnpm"
NPM_BIN="npm"

validate_fixture() {
  local fixture="$1"
  "$PHP_BIN" /dev/stdin "$fixture" "$ROOT" <<'PHP'
<?php
declare(strict_types=1);

[$script, $fixturePath, $root] = $argv;
$fail = static function (string $message): never {
    fwrite(STDERR, "combined-upgrade-policy: {$message}\n");
    exit(1);
};
$raw = @file_get_contents($fixturePath);
try {
    $fixture = is_string($raw) ? json_decode($raw, true, 512, JSON_THROW_ON_ERROR) : null;
} catch (Throwable $exception) {
    $fail('fixture JSON is invalid: ' . $exception->getMessage());
}
if (!is_array($fixture)
    || ($fixture['schema_version'] ?? null) !== 1
    || ($fixture['protocol'] ?? null) !== 'peanut.combined-upgrade-qualification.v1'
    || ($fixture['promise'] ?? null) !== 'stable-public-api-no-app-owned-refactor') {
    $fail('fixture schema or promise is invalid');
}
$application = $fixture['application'] ?? null;
$chain = $fixture['release_chain'] ?? null;
$transitions = $fixture['transitions'] ?? null;
if (!is_array($application) || !is_array($chain) || count($chain) < 2 || !is_array($transitions)) {
    $fail('application, release chain, or transitions are invalid');
}
$versions = [];
foreach ($chain as $index => $expected) {
    if (!is_array($expected) || preg_match('/^\d+\.\d+\.\d+$/D', (string)($expected['version'] ?? '')) !== 1) {
        $fail("release chain entry {$index} is invalid");
    }
    $version = (string)$expected['version'];
    if (isset($versions[$version])) $fail("duplicate release {$version}");
    $versions[$version] = true;
    $manifestPath = "{$root}/scaffold/releases/v{$version}/scaffold-manifest.json";
    $manifestRaw = @file_get_contents($manifestPath);
    $manifest = is_string($manifestRaw) ? json_decode($manifestRaw, true) : null;
    $releaseProtocol = $manifest['protocol'] ?? null;
    $releaseProtocolValid = is_array($manifest) && (
        (($manifest['schema_version'] ?? null) === 2 && $releaseProtocol === 'peanut.scaffold-release.v2')
        || (($manifest['schema_version'] ?? null) === 3 && $releaseProtocol === 'peanut.scaffold-release.v3')
    );
    if (!$releaseProtocolValid) {
        $fail("release manifest {$version} is unavailable or invalid");
    }
    if ($releaseProtocol === 'peanut.scaffold-release.v3'
        && (($manifest['application']['version'] ?? null) !== '0.1.0'
            || array_keys($manifest['release']['tokens'] ?? []) !== ['product_name','slug','package_identity','application_version'])) {
        $fail("release {$version} application version contract is invalid");
    }
    $identity = $manifest['release'] ?? [];
    $checks = [
        'source_commit' => $identity['source_commit'] ?? null,
        'source_tree' => $identity['source_tree'] ?? null,
        'inventory_sha256' => $identity['inventory_sha256'] ?? null,
        'managed_tree_sha256' => $identity['managed_tree_sha256'] ?? null,
    ];
    foreach ($checks as $field => $actual) {
        if (!is_string($actual) || !hash_equals((string)($expected[$field] ?? ''), $actual)) {
            $fail("release {$version} {$field} identity changed");
        }
    }
    if (($identity['version'] ?? null) !== $version
        || ($identity['inventory_template_version'] ?? null) !== $version
        || count($manifest['files'] ?? []) !== ($expected['file_count'] ?? null)
        || !hash_equals((string)($expected['manifest_sha256'] ?? ''), hash('sha256', (string)$manifestRaw))) {
        $fail("release {$version} manifest identity changed");
    }
    $commit = trim((string)shell_exec('git -C ' . escapeshellarg($root) . ' rev-parse ' . escapeshellarg($checks['source_commit'] . '^{commit}') . ' 2>/dev/null'));
    $tree = trim((string)shell_exec('git -C ' . escapeshellarg($root) . ' rev-parse ' . escapeshellarg($checks['source_commit'] . '^{tree}') . ' 2>/dev/null'));
    if ($commit !== $checks['source_commit'] || $tree !== $checks['source_tree']) {
        $fail("release {$version} source commit/tree is unavailable");
    }
}
$discovered = [];
foreach (glob("{$root}/scaffold/releases/v*/scaffold-manifest.json") ?: [] as $path) {
    if (preg_match('#/v(\d+\.\d+\.\d+)/scaffold-manifest\.json$#D', $path, $matches) === 1) $discovered[] = $matches[1];
}
usort($discovered, 'version_compare');
$declared = array_column($chain, 'version');
if ($discovered !== $declared) $fail('release chain does not enumerate every immutable scaffold release in order');
if (($application['initial_version'] ?? null) !== $declared[0]
    || ($application['target_version'] ?? null) !== $declared[array_key_last($declared)]) {
    $fail('application initial/target version does not match the release chain');
}
if (count($transitions) !== count($chain) - 1) $fail('every adjacent release needs one transition policy');
$allowedKinds = ['migration', 'codemod', 'manual-action'];
foreach ($transitions as $index => $transition) {
    if (!is_array($transition)
        || ($transition['from'] ?? null) !== $declared[$index]
        || ($transition['to'] ?? null) !== $declared[$index + 1]
        || !is_array($transition['actions'] ?? null)) {
        $fail("transition {$index} does not match the adjacent release chain");
    }
    $compatibility = $transition['compatibility'] ?? null;
    $actions = $transition['actions'];
    if ($compatibility === 'stable-public-api') {
        if ($actions !== []) $fail("stable transition {$index} must not smuggle migration actions");
        continue;
    }
    if ($compatibility !== 'breaking' || $actions === []) {
        $fail("breaking transition {$index} needs a machine-readable migration, codemod, or manual-action");
    }
    foreach ($actions as $actionIndex => $action) {
        if (!is_array($action)
            || preg_match('/^[a-z0-9][a-z0-9._-]*$/D', (string)($action['id'] ?? '')) !== 1
            || !in_array($action['kind'] ?? null, $allowedKinds, true)
            || !is_string($action['artifact'] ?? null)
            || ($action['artifact'] ?? '') === ''
            || preg_match('/^[a-f0-9]{64}$/D', (string)($action['sha256'] ?? '')) !== 1) {
            $fail("breaking transition {$index} action {$actionIndex} is not machine-readable");
        }
        $artifact = realpath($root . '/' . $action['artifact']);
        if ($artifact === false || !is_file($artifact) || !str_starts_with($artifact, realpath($root) . DIRECTORY_SEPARATOR)
            || !hash_equals((string)$action['sha256'], hash_file('sha256', $artifact))) {
            $fail("breaking transition {$index} action {$actionIndex} artifact identity changed");
        }
    }
}
$customizations = $fixture['customizations'] ?? null;
if (!is_array($customizations) || count($customizations) < 2) $fail('host and business-domain customizations are required');
$roles = [];
foreach ($customizations as $customization) {
    if (!is_array($customization)
        || !in_array($customization['role'] ?? null, ['host', 'business-domain'], true)
        || preg_match('#^(?!/)(?!.*(?:^|/)\.\.(?:/|$))[A-Za-z0-9._/-]+$#D', (string)($customization['path'] ?? '')) !== 1
        || preg_match('/^[a-f0-9]{64}$/D', (string)($customization['before_sha256'] ?? '')) !== 1
        || preg_match('/^[a-f0-9]{64}$/D', (string)($customization['after_sha256'] ?? '')) !== 1
        || !is_string($customization['anchor'] ?? null)
        || ($customization['anchor'] ?? '') === ''
        || !is_string($customization['replacement'] ?? null)
        || ($customization['replacement'] ?? '') === ($customization['anchor'] ?? '')) {
        $fail('customization fixture is invalid');
    }
    $roles[$customization['role']] = true;
}
if (!isset($roles['host'], $roles['business-domain'])) $fail('customizations must include Host and business-domain source');
$target = $fixture['target_dependencies'] ?? null;
$files = is_array($target) ? ($target['files'] ?? null) : null;
$phpProbes = $fixture['php_probes'] ?? null;
$expectedPaths = [
    'server/composer.json', 'server/composer.lock',
    'web/package.json', 'web/pnpm-lock.yaml',
    'pc/package.json', 'pc/package-lock.json',
    'uniapp/package.json', 'uniapp/package-lock.json',
];
if (!is_array($target) || !is_array($target['composer'] ?? null) || !is_array($target['npm'] ?? null)
    || !is_array($files) || array_column($files, 'path') !== $expectedPaths) {
    $fail('target dependency identity file set is invalid');
}
foreach ($files as $file) {
    if (preg_match('/^[a-f0-9]{64}$/D', (string)($file['sha256'] ?? '')) !== 1) $fail('target dependency digest is invalid');
}
if (!is_array($phpProbes) || $phpProbes === []) $fail('PHP domain probes are required');
foreach ($phpProbes as $index => $probe) {
    if (!is_string($probe)
        || preg_match('#^server/tests/fixtures/core-upgrade-compatibility/[A-Za-z0-9._/-]+\.php$#D', $probe) !== 1) {
        $fail("PHP domain probe {$index} path is invalid");
    }
    $probePath = realpath($root . '/' . $probe);
    if ($probePath === false || !is_file($probePath)
        || !str_starts_with($probePath, realpath($root) . DIRECTORY_SEPARATOR)) {
        $fail("PHP domain probe {$index} is unavailable");
    }
}
echo $application['target_version'], "\n";
PHP
}

if [[ "${1:-}" == '--validate-policy' ]]; then
  [[ $# -eq 2 ]] || usage
  validate_fixture "$2" >/dev/null
  printf 'COMBINED-UPGRADE-POLICY-001 passed\n'
  exit 0
fi

cache_input=''
output_input=''
candidate_input=''
while [[ $# -gt 0 ]]; do
  case "$1" in
    --candidate) [[ $# -ge 2 ]] || usage; candidate_input="$2"; shift 2 ;;
    --cache) [[ $# -ge 2 ]] || usage; cache_input="$2"; shift 2 ;;
    --output) [[ $# -ge 2 ]] || usage; output_input="$2"; shift 2 ;;
    *) usage ;;
  esac
done
[[ -n "$candidate_input" && -n "$cache_input" && -n "$output_input" ]] || usage

canonical_empty_target() {
  local input="$1" label="$2" parent base physical
  [[ "$input" == /* ]] || die "$label must be absolute"
  parent="$(dirname "$input")"
  base="$(basename "$input")"
  [[ -d "$parent" ]] || die "$label parent does not exist: $parent"
  physical="$(cd "$parent" && pwd -P)/$base"
  [[ ! -L "$input" ]] || die "$label must not be a symlink"
  if [[ -e "$physical" ]]; then
    [[ -d "$physical" ]] || die "$label must be a directory"
    [[ -z "$(find "$physical" -mindepth 1 -print -quit)" ]] || die "$label must be empty"
  fi
  printf '%s\n' "$physical"
}

for command in git jq node "$PHP_BIN" "$COMPOSER_BIN" "$PNPM_BIN" "$NPM_BIN" shasum; do
  command -v "$command" >/dev/null 2>&1 || die "required command is unavailable: $command"
done
validate_fixture "$DEFAULT_FIXTURE" >/dev/null

CACHE="$(canonical_empty_target "$cache_input" cache)"
OUTPUT="$(canonical_empty_target "$output_input" output)"
[[ "$CACHE" != "$OUTPUT" ]] || die 'cache and output must differ'
case "$CACHE/" in "$OUTPUT/"*) die 'cache must not be inside output' ;; esac
case "$OUTPUT/" in "$CACHE/"*) die 'output must not be inside cache' ;; esac
mkdir -p "$CACHE" "$OUTPUT" "$OUTPUT/logs"

[[ "$candidate_input" =~ ^[a-f0-9]{40}$ ]] || die 'candidate must be a full commit SHA'
CANDIDATE="$(git -C "$ROOT" rev-parse "${candidate_input}^{commit}")"
[[ "$CANDIDATE" == "$candidate_input" ]] || die 'candidate commit identity changed'
[[ "$(git -C "$ROOT" rev-parse HEAD)" == "$CANDIDATE" ]] || die 'working tree is not checked out at the fixed candidate'
[[ -z "$(git -C "$ROOT" status --porcelain=v1 --untracked-files=all)" ]] || die 'candidate working tree is not clean'
CANDIDATE_TREE="$(git -C "$ROOT" rev-parse "${CANDIDATE}^{tree}")"

FIXTURE="$DEFAULT_FIXTURE"
CHECKPOINT="$OUTPUT/checkpoint.json"
CURRENT_PHASE=initialization
APP="$OUTPUT/modified-old-application"
SOURCE="$CACHE/v1-source"
COMPOSER_CACHE="$CACHE/composer"
PNPM_STORE="$CACHE/pnpm-store"
NPM_CACHE="$CACHE/npm"

jq -n --arg candidate "$CANDIDATE" --arg tree "$CANDIDATE_TREE" \
  --arg fixture_sha256 "$(shasum -a 256 "$FIXTURE" | awk '{print $1}')" \
  '{schema_version:1,status:"running",execution_mode:"new_candidate_full_combined_path",candidate:{commit:$candidate,tree:$tree},fixture_sha256:$fixture_sha256,phases:{}}' >"$CHECKPOINT"

cleanup() {
  local status=$?
  if [[ "$status" -ne 0 && -f "$CHECKPOINT" ]]; then
    jq --arg phase "$CURRENT_PHASE" --argjson exit_code "$status" \
      '.status="failed" | .failure={phase:$phase,exit_code:$exit_code}' "$CHECKPOINT" >"${CHECKPOINT}.tmp" 2>/dev/null \
      && mv "${CHECKPOINT}.tmp" "$CHECKPOINT" || true
  fi
}
trap cleanup EXIT INT TERM

record_phase() {
  local phase="$1" summary="$2"
  jq --arg phase "$phase" --arg summary "$summary" '.phases[$phase]={status:"passed",summary:$summary}' \
    "$CHECKPOINT" >"${CHECKPOINT}.tmp"
  mv "${CHECKPOINT}.tmp" "$CHECKPOINT"
}

run_logged() {
  local name="$1"
  shift
  if ! "$@" >"$OUTPUT/logs/${name}.log" 2>&1; then
    tail -n 100 "$OUTPUT/logs/${name}.log" >&2 || true
    die "command failed: $name"
  fi
}

app_owned_digest() {
  "$PHP_BIN" /dev/stdin "$1" <<'PHP'
<?php
$root = $argv[1];
$manifest = json_decode((string)file_get_contents($root . '/.peanut/application-manifest.json'), true, 512, JSON_THROW_ON_ERROR);
$rows = [];
foreach ($manifest['files'] as $file) {
    if (($file['classification'] ?? null) !== 'app-owned') continue;
    $path = $root . '/' . $file['path'];
    if (!is_file($path) || is_link($path)) exit(1);
    $rows[] = $file['path'] . "\0" . hash_file('sha256', $path) . "\0" . (fileperms($path) & 0777);
}
sort($rows, SORT_STRING);
echo hash('sha256', implode("\n", $rows));
PHP
}

tracked_state() {
  "$PHP_BIN" /dev/stdin "$1" "$2" <<'PHP'
<?php
$root = $argv[1]; $output = $argv[2];
$manifest = json_decode((string)file_get_contents($root . '/.peanut/application-manifest.json'), true, 512, JSON_THROW_ON_ERROR);
$state = [];
foreach ($manifest['files'] as $file) {
    $path = $root . '/' . $file['path'];
    $state[$file['path']] = is_file($path) && !is_link($path)
        ? ['present'=>true,'sha256'=>hash_file('sha256',$path),'mode'=>fileperms($path)&0777]
        : ['present'=>false,'sha256'=>null,'mode'=>null];
}
ksort($state, SORT_STRING);
file_put_contents($output, json_encode($state, JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES|JSON_THROW_ON_ERROR) . "\n");
PHP
}

assert_application_identity() {
  "$PHP_BIN" /dev/stdin "$1" "$2" <<'PHP'
<?php
$app = $argv[1]; $releasePath = $argv[2];
$application = json_decode((string)file_get_contents($app . '/.peanut/application-manifest.json'), true, 512, JSON_THROW_ON_ERROR);
$release = json_decode((string)file_get_contents($releasePath), true, 512, JSON_THROW_ON_ERROR);
$identity = $release['release'];
$expected = ['version'=>$identity['version'],'inventory_sha256'=>$identity['inventory_sha256'],'source_commit'=>$identity['source_commit'],'source_tree'=>$identity['source_tree']];
if (($application['template'] ?? null) !== $expected) exit(1);
if (($release['protocol'] ?? null) === 'peanut.scaffold-release.v3'
    && (($application['schema_version'] ?? null) !== 2
        || ($application['protocol'] ?? null) !== 'peanut.application-scaffold.v2'
        || ($application['application']['version'] ?? null) !== ($release['application']['version'] ?? null))) exit(1);
$managed = [];
foreach ($application['files'] as $file) {
    if (in_array($file['classification'] ?? null, ['managed','generated-managed'], true)) {
        $path = $app . '/' . $file['path'];
        if (!is_file($path) || is_link($path)) exit(1);
        $managed[$file['path']] = [$file['classification'], fileperms($path) & 0777];
    }
}
$releaseManaged = [];
foreach ($release['files'] as $file) $releaseManaged[$file['path']] = [$file['classification'], $file['mode']];
ksort($managed, SORT_STRING); ksort($releaseManaged, SORT_STRING);
if ($managed !== $releaseManaged) exit(1);
PHP
  [[ $? -eq 0 ]] || die 'application/release manifest identity mismatch'
}

apply_customizations() {
  "$PHP_BIN" /dev/stdin "$1" "$FIXTURE" <<'PHP'
<?php
$root = $argv[1];
$fixture = json_decode((string)file_get_contents($argv[2]), true, 512, JSON_THROW_ON_ERROR);
$manifest = json_decode((string)file_get_contents($root . '/.peanut/application-manifest.json'), true, 512, JSON_THROW_ON_ERROR);
$appOwned = [];
foreach ($manifest['files'] as $file) if (($file['classification'] ?? null) === 'app-owned') $appOwned[$file['path']] = true;
foreach ($fixture['customizations'] as $customization) {
    $relative = $customization['path'];
    $path = $root . '/' . $relative;
    if (!isset($appOwned[$relative]) || !is_file($path) || is_link($path)
        || !hash_equals($customization['before_sha256'], hash_file('sha256', $path))) exit(1);
    $content = (string)file_get_contents($path);
    if (substr_count($content, $customization['anchor']) !== 1) exit(1);
    $content = str_replace($customization['anchor'], $customization['replacement'], $content);
    if (file_put_contents($path, $content, LOCK_EX) === false
        || !hash_equals($customization['after_sha256'], hash_file('sha256', $path))) exit(1);
}
PHP
  [[ $? -eq 0 ]] || die 'deterministic downstream customization failed'
}

assert_customizations() {
  "$PHP_BIN" /dev/stdin "$1" "$FIXTURE" <<'PHP'
<?php
$root = $argv[1];
$fixture = json_decode((string)file_get_contents($argv[2]), true, 512, JSON_THROW_ON_ERROR);
foreach ($fixture['customizations'] as $customization) {
    $path = $root . '/' . $customization['path'];
    if (!is_file($path) || !hash_equals($customization['after_sha256'], hash_file('sha256', $path))) exit(1);
}
PHP
  [[ $? -eq 0 ]] || die 'app-owned Host/business customization changed'
}

assert_transition_diff() {
  "$PHP_BIN" /dev/stdin "$1" "$2" "$3" "$4" "$5" <<'PHP'
<?php
[$script,$beforePath,$afterPath,$planPath,$fromManifestPath,$toManifestPath]=$argv;
$before=json_decode((string)file_get_contents($beforePath),true,512,JSON_THROW_ON_ERROR);
$after=json_decode((string)file_get_contents($afterPath),true,512,JSON_THROW_ON_ERROR);
$plan=json_decode((string)file_get_contents($planPath),true,512,JSON_THROW_ON_ERROR);
$from=json_decode((string)file_get_contents($fromManifestPath),true,512,JSON_THROW_ON_ERROR);
$to=json_decode((string)file_get_contents($toManifestPath),true,512,JSON_THROW_ON_ERROR);
$managed=[];foreach(array_merge($from['files'],$to['files']) as $file)$managed[$file['path']]=$file['classification'];
$expected=[];
foreach($plan['actions'] as $action){
    if(!isset($managed[$action['path']])||!in_array($action['classification'],['managed','generated-managed'],true))exit(1);
    if(in_array($action['action'],['create','delete','replace','regenerate'],true))$expected[]=$action['path'];
}
$actual=[];
foreach(array_unique(array_merge(array_keys($before),array_keys($after))) as $path)if(($before[$path]??null)!==($after[$path]??null))$actual[]=$path;
sort($expected,SORT_STRING);sort($actual,SORT_STRING);
if($expected!==$actual){fwrite(STDERR,'unexpected transition diff: '.json_encode(['expected'=>$expected,'actual'=>$actual])."\n");exit(1);}
PHP
  [[ $? -eq 0 ]] || die 'scaffold transition wrote outside its managed action set'
}

assert_dependency_files() {
  "$PHP_BIN" /dev/stdin "$1" "$FIXTURE" <<'PHP'
<?php
$root=$argv[1];$fixture=json_decode((string)file_get_contents($argv[2]),true,512,JSON_THROW_ON_ERROR);
foreach($fixture['target_dependencies']['files'] as $file){$path=$root.'/'.$file['path'];if(!is_file($path)||!hash_equals($file['sha256'],hash_file('sha256',$path)))exit(1);}
PHP
  [[ $? -eq 0 ]] || die 'target dependency manifest/lock digest mismatch'
}

assert_php_identity() {
  "$PHP_BIN" /dev/stdin "$APP" "$FIXTURE" <<'PHP'
<?php
$app=$argv[1];$fixture=json_decode((string)file_get_contents($argv[2]),true,512,JSON_THROW_ON_ERROR);$target=$fixture['target_dependencies']['composer'];
$manifest=json_decode((string)file_get_contents($app.'/server/composer.json'),true,512,JSON_THROW_ON_ERROR);
if(($manifest['require'][$target['package']]??null)!==$target['version'])exit(1);
foreach([$app.'/server/composer.lock',$app.'/server/vendor/composer/installed.json'] as $path){$data=json_decode((string)file_get_contents($path),true,512,JSON_THROW_ON_ERROR);$packages=$data['packages']??$data;$matched=false;foreach($packages as $package){if(($package['name']??null)!==$target['package'])continue;$matched=($package['version']??null)===$target['version']&&($package['dist']['reference']??null)===$target['reference'];if($path!==$app.'/server/vendor/composer/installed.json')$matched=$matched&&($package['source']['reference']??null)===$target['reference'];}if(!$matched)exit(1);}
PHP
  [[ $? -eq 0 ]] || die 'installed Composer target identity mismatch'
}

run_php_probes() {
  local phase="$1" probe
  while IFS= read -r probe; do
    run_logged "${phase}-$(basename "$probe" .php)" "$PHP_BIN" "$ROOT/$probe" "$APP"
  done < <(jq -r '.php_probes[]' "$FIXTURE")
}

remove_tree() {
  "$PHP_BIN" /dev/stdin "$1" "$APP" <<'PHP'
<?php
$path=$argv[1];$root=realpath($argv[2]);if($root===false||!str_starts_with($path,$root.DIRECTORY_SEPARATOR)||is_link($path))exit(1);if(!file_exists($path))exit(0);
$iterator=new RecursiveIteratorIterator(new RecursiveDirectoryIterator($path,FilesystemIterator::SKIP_DOTS),RecursiveIteratorIterator::CHILD_FIRST);
foreach($iterator as$file){$name=$file->getPathname();$file->isDir()&&!$file->isLink()?rmdir($name):unlink($name);}rmdir($path);
PHP
  [[ $? -eq 0 ]] || die "failed to clear isolated dependency tree: $1"
}

CURRENT_PHASE=materialize-old-application
initial_version="$(jq -r '.application.initial_version' "$FIXTURE")"
initial_manifest="$ROOT/scaffold/releases/v${initial_version}/scaffold-manifest.json"
initial_commit="$(jq -r '.release_chain[0].source_commit' "$FIXTURE")"
git clone --quiet --no-local --no-checkout "$ROOT" "$SOURCE"
git -C "$SOURCE" checkout --quiet --detach "$initial_commit"
run_logged create-old-application "$PHP_BIN" "$SOURCE/scripts/create-app" \
  --name="$(jq -r '.application.name' "$FIXTURE")" \
  --slug="$(jq -r '.application.slug' "$FIXTURE")" \
  --package="$(jq -r '.application.package_identity' "$FIXTURE")" \
  --target="$APP"
assert_application_identity "$APP" "$initial_manifest"
pristine_app_owned="$(app_owned_digest "$APP")"
apply_customizations "$APP"
customized_app_owned="$(app_owned_digest "$APP")"
[[ "$pristine_app_owned" != "$customized_app_owned" ]] || die 'downstream customizations did not change app-owned bytes'
assert_customizations "$APP"
record_phase materialize-old-application "formal v1.0.0 create-app plus deterministic app-owned Host/business customization"

CURRENT_PHASE=old-application-probes
run_logged old-composer-install env COMPOSER_CACHE_DIR="$COMPOSER_CACHE" "$COMPOSER_BIN" install \
  --working-dir "$APP/server" --no-interaction --no-progress --prefer-dist
assert_php_identity
run_php_probes old
[[ "$(app_owned_digest "$APP")" == "$customized_app_owned" ]] || die 'old dependency install/probes changed app-owned source'
record_phase old-application-probes "clean Composer install and identical Host/representative-domain probes passed before scaffold upgrade"

CURRENT_PHASE=scaffold-release-chain
chain_length="$(jq '.release_chain | length' "$FIXTURE")"
index=0
while [[ "$index" -lt "$((chain_length - 1))" ]]; do
  from="$(jq -r ".release_chain[$index].version" "$FIXTURE")"
  to="$(jq -r ".release_chain[$((index + 1))].version" "$FIXTURE")"
  from_manifest="$ROOT/scaffold/releases/v${from}/scaffold-manifest.json"
  to_manifest="$ROOT/scaffold/releases/v${to}/scaffold-manifest.json"
  before="$OUTPUT/transition-${from}-to-${to}-before.json"
  after="$OUTPUT/transition-${from}-to-${to}-after.json"
  preflight="$OUTPUT/transition-${from}-to-${to}-preflight.json"
  tracked_state "$APP" "$before"
  run_logged "transition-${from}-to-${to}-preflight" "$PHP_BIN" "$ROOT/scripts/scaffold-upgrade" preflight \
    --project-root="$APP" --from-manifest="$from_manifest" --to-manifest="$to_manifest"
  cp "$OUTPUT/logs/transition-${from}-to-${to}-preflight.log" "$preflight"
  jq -e --arg from "$from" --arg to "$to" \
    '.status=="ready" and .summary.conflicts==0 and .identity.from.version==$from and .identity.to.version==$to' "$preflight" >/dev/null \
    || die "scaffold preflight identity/conflict failure: $from to $to"
  plan_path="$APP/$(jq -r '.plan_path' "$preflight")"
  run_logged "transition-${from}-to-${to}-apply" "$PHP_BIN" "$ROOT/scripts/scaffold-upgrade" apply --project-root="$APP" --plan="$plan_path"
  run_logged "transition-${from}-to-${to}-verify" "$PHP_BIN" "$ROOT/scripts/scaffold-upgrade" verify --project-root="$APP" --plan="$plan_path"
  jq -e '.status=="verified"' "$OUTPUT/logs/transition-${from}-to-${to}-verify.log" >/dev/null || die "scaffold verify failed: $from to $to"
  assert_application_identity "$APP" "$to_manifest"
  tracked_state "$APP" "$after"
  assert_transition_diff "$before" "$after" "$preflight" "$from_manifest" "$to_manifest"
  [[ "$(app_owned_digest "$APP")" == "$customized_app_owned" ]] || die "scaffold transition changed app-owned bytes: $from to $to"
  assert_customizations "$APP"
  index=$((index + 1))
done
record_phase scaffold-release-chain "all declared immutable scaffold transitions applied and verified; exact managed action set only"

CURRENT_PHASE=target-dependency-install
target_version="$(jq -r '.application.target_version' "$FIXTURE")"
assert_application_identity "$APP" "$ROOT/scaffold/releases/v${target_version}/scaffold-manifest.json"
assert_dependency_files "$APP"
remove_tree "$APP/server/vendor"
run_logged target-composer-install env COMPOSER_CACHE_DIR="$COMPOSER_CACHE" "$COMPOSER_BIN" install \
  --working-dir "$APP/server" --no-interaction --no-progress --prefer-dist
assert_php_identity
run_php_probes target

run_logged web-frozen-install env HUSKY=0 "$PNPM_BIN" --dir "$APP/web" install --frozen-lockfile --store-dir "$PNPM_STORE"
run_logged web-typecheck "$PNPM_BIN" --dir "$APP/web" run type:check
run_logged web-build "$PNPM_BIN" --dir "$APP/web" run build
run_logged pc-frozen-install env HUSKY=0 npm_config_cache="$NPM_CACHE" "$NPM_BIN" --prefix "$APP/pc" ci
run_logged pc-typecheck "$NPM_BIN" --prefix "$APP/pc" run typecheck
run_logged pc-build "$NPM_BIN" --prefix "$APP/pc" run build
run_logged uniapp-frozen-install env HUSKY=0 npm_config_cache="$NPM_CACHE" "$NPM_BIN" --prefix "$APP/uniapp" ci
run_logged uniapp-typecheck "$NPM_BIN" --prefix "$APP/uniapp" run type-check
run_logged uniapp-build "$NPM_BIN" --prefix "$APP/uniapp" run build:h5

target_npm_version="$(jq -r '.target_dependencies.npm.version' "$FIXTURE")"
target_npm_integrity="$(jq -r '.target_dependencies.npm.integrity' "$FIXTURE")"
for client in web pc uniapp; do
  [[ "$(jq -r '.version' "$APP/$client/node_modules/@peanut-admin/admin/package.json")" == "$target_npm_version" ]] \
    || die "$client installed npm target version mismatch"
done
grep -F -- "resolution: {integrity: $target_npm_integrity}" "$APP/web/pnpm-lock.yaml" >/dev/null \
  || die 'Web target lock integrity mismatch'
for client in pc uniapp; do
  jq -e --arg version "$target_npm_version" --arg integrity "$target_npm_integrity" \
    '.packages["node_modules/@peanut-admin/admin"].version==$version and .packages["node_modules/@peanut-admin/admin"].integrity==$integrity' \
    "$APP/$client/package-lock.json" >/dev/null || die "$client target lock identity mismatch"
done
node "$ROOT/server/tests/fixtures/core-upgrade-compatibility/web-public-entry-gate.mjs" \
  "$APP" "$APP/web/node_modules/@peanut-admin/admin/package.json"
"$PHP_BIN" /dev/stdin "$APP" <<'PHP'
<?php
$root=$argv[1];$manifest=json_decode((string)file_get_contents($root.'/server/vendor/peanut-admin/core/composer.json'),true,512,JSON_THROW_ON_ERROR);$prefixes=array_keys($manifest['autoload']['psr-4']??[]);
$iterator=new RecursiveIteratorIterator(new RecursiveDirectoryIterator($root.'/server',FilesystemIterator::SKIP_DOTS));
foreach($iterator as$file){if(!$file->isFile()||$file->getExtension()!=='php'||str_contains($file->getPathname(),'/vendor/'))continue;$content=(string)file_get_contents($file->getPathname());if(preg_match('#(?:vendor/peanut-admin|packages/php|peanut-admin/core/.*/src/)#i',$content))exit(1);preg_match_all('/\b(?:use|new|extends|implements|instanceof)\s+\\\\?(PeanutAdmin\\\\[A-Za-z0-9_\\\\]+)/',$content,$matches);foreach($matches[1] as$class){$ok=false;foreach($prefixes as$prefix)if(str_starts_with($class.'\\',$prefix)){$ok=true;break;}if(!$ok)exit(1);}}
PHP
[[ $? -eq 0 ]] || die 'PHP source used a non-public core entry point'
assert_dependency_files "$APP"
[[ "$(app_owned_digest "$APP")" == "$customized_app_owned" ]] || die 'target installs/builds changed app-owned source'
assert_customizations "$APP"
record_phase target-dependency-install "clean target Composer/npm installs; same PHP probes; Web/PC/UniApp frozen typecheck/build and public-entry scan passed"

CURRENT_PHASE=final-proof
jq -n \
  --arg candidate "$CANDIDATE" --arg tree "$CANDIDATE_TREE" \
  --arg initial "$initial_version" --arg target "$target_version" \
  --arg app_owned "$customized_app_owned" \
  --arg composer_version "$(jq -r '.target_dependencies.composer.version' "$FIXTURE")" \
  --arg composer_reference "$(jq -r '.target_dependencies.composer.reference' "$FIXTURE")" \
  --arg npm_version "$target_npm_version" --arg npm_integrity "$target_npm_integrity" \
  --arg promise "$(jq -r '.promise' "$FIXTURE")" \
  --argjson releases "$(jq '.release_chain' "$FIXTURE")" \
  --argjson transitions "$(jq '.transitions' "$FIXTURE")" \
  --argjson customizations "$(jq '[.customizations[]|{role,path,after_sha256}]' "$FIXTURE")" \
  --argjson dependency_files "$(jq '.target_dependencies.files' "$FIXTURE")" \
  --argjson not_covered "$(jq '.not_covered' "$FIXTURE")" \
  '{schema_version:1,status:"passed",execution_mode:"new_candidate_full_combined_path",candidate:{commit:$candidate,tree:$tree},promise:{scope:$promise,statement:"Within stable public APIs, the qualified path requires no app-owned refactor."},application:{initial_scaffold:$initial,target_scaffold:$target,app_owned_tree_sha256:$app_owned,customizations:$customizations},release_chain:$releases,transition_policy:$transitions,target_dependencies:{composer:{version:$composer_version,reference:$composer_reference},npm:{version:$npm_version,integrity:$npm_integrity},files:$dependency_files},gates:{scaffold_chain:"passed",managed_write_set:"passed",app_owned_byte_preservation:"passed",same_php_host_and_domain_probes:"passed",clean_target_install:"passed",web_frozen_typecheck_build:"passed",pc_frozen_typecheck_build:"passed",uniapp_frozen_typecheck_build:"passed",public_entries:"passed",breaking_release_machine_action_policy:"passed"},not_covered:$not_covered}' \
  >"$OUTPUT/summary.json"
record_phase final-proof "stable-public-API no-app-owned-refactor boundary and breaking-release action policy proved"
jq '.status="passed"' "$CHECKPOINT" >"${CHECKPOINT}.tmp"
mv "${CHECKPOINT}.tmp" "$CHECKPOINT"

printf 'COMBINED-UPGRADE-QUALIFICATION-001 passed; summary=%s\n' "$OUTPUT/summary.json"
