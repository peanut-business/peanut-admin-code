#!/usr/bin/env bash
set -euo pipefail

die() { printf 'ops-upgrade-worker: %s\n' "$1" >&2; exit 1; }

[[ $# -eq 1 && "$1" == '--once' ]] || die 'usage: scripts/ops-upgrade-worker --once'
for command_name in git jq ssh; do
  command -v "$command_name" >/dev/null || die "$command_name is required"
done

project_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
registry="$project_root/resources/project-resources.json"
[[ -f "$registry" ]] || die 'project resource registry is required'

resource_id='peanut-admin-production-upgrade-control-worker'
worker_json="$(jq -ce --arg id "$resource_id" '.. | objects | select(.stable_resource_id? == $id)' "$registry")" \
  || die 'registered upgrade control worker is missing'
control_checkout="$(jq -r '.control_checkout' <<<"$worker_json")"
ssh_alias="$(jq -r '.ssh_alias' <<<"$worker_json")"
deployment_root="$(jq -r '.deployment_root' <<<"$worker_json")"
target="$(jq -r '.deployment_target' <<<"$worker_json")"
upgrade_artifact_directory="$(jq -r '.upgrade_artifact_directory // empty' <<<"$worker_json")"
upgrade_trust_env="$(jq -r '.upgrade_trust_env // empty' <<<"$worker_json")"
[[ "$project_root" == "$control_checkout" ]] || die 'run from the registered deployment-control checkout'
[[ "$ssh_alias" == oracle3 && "$deployment_root" == /www/docker/peanut-admin && "$target" == production ]] \
  || die 'registered upgrade worker boundary is invalid'
[[ "$upgrade_artifact_directory" == /* && -d "$upgrade_artifact_directory" && ! -L "$upgrade_artifact_directory" ]] \
  || die 'registered upgrade artifact directory is unavailable'
[[ "$upgrade_trust_env" == /* && -f "$upgrade_trust_env" && ! -L "$upgrade_trust_env" ]] \
  || die 'registered upgrade trust environment is unavailable'
[[ "$(stat -c '%a %h' "$upgrade_trust_env")" == '600 1' ]] \
  || die 'registered upgrade trust environment must have mode 0600 and one hard link'
[[ -x "$project_root/scripts/deploy-release" ]] || die 'deploy-release owner is unavailable'
git -C "$project_root" diff --quiet || die 'deployment-control checkout has unstaged changes'
git -C "$project_root" diff --cached --quiet || die 'deployment-control checkout has staged changes'
[[ -z "$(git -C "$project_root" ls-files --others --exclude-standard)" ]] \
  || die 'deployment-control checkout has untracked files'

remote_upgrade() {
  local action="$1" task_key="${2:-}" revision="${3:-}" error_code="${4:-}"
  [[ "$action" =~ ^(claim|advance|heartbeat|succeed|fail)$ ]] || return 64
  [[ -z "$task_key" || "$task_key" =~ ^job_[a-f0-9]{32}$ ]] || return 64
  [[ -z "$revision" || "$revision" =~ ^[1-9][0-9]*$ ]] || return 64
  [[ -z "$error_code" || "$error_code" =~ ^OPS_UPGRADE_[A-Z0-9_]+$ ]] || return 64
  ssh -o BatchMode=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=120 \
    "$ssh_alias" sudo -n bash -s -- \
    "$deployment_root" "$action" "$task_key" "$revision" "$error_code" <<'REMOTE'
set -euo pipefail
root="$1"; action="$2"; task_key="$3"; revision="$4"; error_code="$5"
[[ "$root" == /www/docker/peanut-admin ]] || exit 64
cd "$root"
command=(docker compose -f compose.yaml --profile bundled-db run -T --rm --no-deps --entrypoint php php server/think ops-upgrade:task "$action")
[[ -z "$task_key" ]] || command+=(--task-key "$task_key")
[[ -z "$revision" ]] || command+=(--revision "$revision")
[[ -z "$error_code" ]] || command+=(--error-code "$error_code")
exec "${command[@]}"
REMOTE
}

remote_child_worker() {
  local kind="$1"
  [[ "$kind" == backup || "$kind" == restore ]] || return 64
  ssh -o BatchMode=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=120 \
    "$ssh_alias" sudo -n bash -s -- "$deployment_root" "$kind" <<'REMOTE'
set -euo pipefail
root="$1"; kind="$2"
[[ "$root" == /www/docker/peanut-admin ]] || exit 64
cd "$root"
case "$kind" in
  backup) exec scripts/ops-backup-worker --once ;;
  restore) exec scripts/ops-restore-worker --once ;;
  *) exit 64 ;;
esac
REMOTE
}

claim_json="$(remote_upgrade claim)" || die 'upgrade task claim failed'
jq -e '.ok == true' <<<"$claim_json" >/dev/null || die 'upgrade task claim was rejected'
if [[ "$(jq -r '.result == null' <<<"$claim_json")" == true ]]; then
  printf 'ops-upgrade-worker: no queued upgrade task\n'
  exit 0
fi

task_key="$(jq -r '.result.task_key' <<<"$claim_json")"
revision="$(jq -r '.result.execution_revision' <<<"$claim_json")"
target_release_key="$(jq -r '.result.target_release_key' <<<"$claim_json")"
target_commit="$(jq -r '.result.target_commit' <<<"$claim_json")"
target_tree="$(jq -r '.result.target_tree' <<<"$claim_json")"
[[ "$task_key" =~ ^job_[a-f0-9]{32}$ ]] || die 'claimed task key is invalid'
[[ "$revision" =~ ^[1-9][0-9]*$ ]] || die 'claimed revision is invalid'
[[ "$target_release_key" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || die 'claimed target release is invalid'
[[ "$target_commit" =~ ^[a-f0-9]{40}$ ]] || die 'claimed target commit is invalid'
[[ "$target_tree" =~ ^[a-f0-9]{40}$ ]] || die 'claimed target tree is invalid'
target_version="${target_release_key#v}"
upgrade_basename="peanut-admin-${target_version}-standalone-upgrade.tar.gz"
upgrade_package="$upgrade_artifact_directory/$upgrade_basename"
upgrade_manifest="$upgrade_package.manifest.json"
[[ -f "$upgrade_package" && ! -L "$upgrade_package" \
  && -f "$upgrade_manifest" && ! -L "$upgrade_manifest" ]] \
  || die 'task-bound signed upgrade artifact is unavailable'
jq -e --arg version "$target_version" --arg commit "$target_commit" --arg tree "$target_tree" \
  '.protocol == "peanut.edition-upgrade-artifact.v1"
   and .product.version == $version and .edition.name == "standalone"
   and .source.commit == $commit and .source.tree == $tree' \
  "$upgrade_manifest" >/dev/null || die 'task-bound signed upgrade artifact identity is invalid'

failure_code='OPS_UPGRADE_PREFLIGHT_FAILED'
heartbeat_pid=''
worker_pid=$$
stop_heartbeat() {
  if [[ -n "$heartbeat_pid" ]]; then
    kill "$heartbeat_pid" >/dev/null 2>&1 || true
    wait "$heartbeat_pid" >/dev/null 2>&1 || true
    heartbeat_pid=''
  fi
}
mark_failed() {
  local exit_status="${1:-1}"
  trap - ERR INT TERM
  stop_heartbeat
  remote_upgrade fail "$task_key" "$revision" "$failure_code" >/dev/null 2>&1 || true
  printf 'ops-upgrade-worker: failed task=%s code=%s; maintenance and recovery pointer are retained\n' \
    "$task_key" "$failure_code" >&2
  [[ "$exit_status" -ne 0 ]] || exit_status=1
  exit "$exit_status"
}
heartbeat_loop() {
  while sleep 60; do
    remote_upgrade heartbeat "$task_key" "$revision" >/dev/null \
      || { kill -TERM "$worker_pid"; return 1; }
  done
}
trap 'mark_failed $?' ERR
trap 'mark_failed 130' INT TERM
remote_upgrade heartbeat "$task_key" "$revision" >/dev/null
heartbeat_loop &
heartbeat_pid=$!

advance_json="$(remote_upgrade advance "$task_key" "$revision")"
jq -e '.ok == true and .result.action == "run_backup"' <<<"$advance_json" >/dev/null \
  || { failure_code='OPS_UPGRADE_PREFLIGHT_FAILED'; false; }
failure_code='OPS_UPGRADE_BACKUP_FAILED'
remote_child_worker backup

advance_json="$(remote_upgrade advance "$task_key" "$revision")"
jq -e '.ok == true and .result.action == "run_restore"' <<<"$advance_json" >/dev/null \
  || false
backup_reference_key="$(jq -r '.result.backup_reference_key // empty' <<<"$advance_json")"
backup_manifest_sha256="$(jq -r '.result.backup_manifest_sha256 // empty' <<<"$advance_json")"
[[ "$backup_reference_key" =~ ^backup_[a-f0-9]{32}$ \
  && "$backup_manifest_sha256" =~ ^[a-f0-9]{64}$ ]] \
  || { failure_code='OPS_UPGRADE_BACKUP_FAILED'; false; }
failure_code='OPS_UPGRADE_RESTORE_FAILED'
remote_child_worker restore

failure_code='OPS_UPGRADE_MAINTENANCE_FAILED'
advance_json="$(remote_upgrade advance "$task_key" "$revision")"
jq -e --arg release "$target_release_key" --arg commit "$target_commit" --arg tree "$target_tree" \
  --arg backup "$backup_reference_key" --arg backup_sha "$backup_manifest_sha256" \
  '.ok == true and .result.action == "deploy"
   and .result.target_release_key == $release
   and .result.target_commit == $commit
   and .result.target_tree == $tree
   and .result.backup_reference_key == $backup
   and .result.backup_manifest_sha256 == $backup_sha' \
  <<<"$advance_json" >/dev/null || false

stop_heartbeat
failure_code='OPS_UPGRADE_DEPLOYMENT_FAILED'
"$project_root/scripts/deploy-release" "$target_release_key" --target production --update --apply \
  --expected-commit "$target_commit" --expected-tree "$target_tree" \
  --upgrade-package "$upgrade_package" --upgrade-manifest "$upgrade_manifest" \
  --upgrade-trust-env "$upgrade_trust_env"

failure_code='OPS_UPGRADE_SMOKE_FAILED'
succeed_json="$(remote_upgrade succeed "$task_key" "$revision")"
jq -e --arg release "$target_release_key" \
  '.ok == true and .result.status == "succeeded" and .result.target_release_key == $release
   and (.result.recovery_pointer_sha256 | test("^[a-f0-9]{64}$"))' \
  <<<"$succeed_json" >/dev/null || { failure_code='OPS_UPGRADE_RECOVERY_POINTER_FAILED'; false; }

trap - ERR INT TERM
printf 'ops-upgrade-worker: succeeded task=%s release=%s recovery_pointer=%s\n' \
  "$task_key" "$target_release_key" "$(jq -r '.result.recovery_pointer_sha256' <<<"$succeed_json")"
