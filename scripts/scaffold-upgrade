#!/usr/bin/env php
<?php

declare(strict_types=1);

use app\common\infrastructure\scaffold\ScaffoldUpgradeRunner;
use app\common\infrastructure\scaffold\EditionUpgradePackage;

$root = dirname(__DIR__);
require $root . '/scripts/scaffold-runtime/ScaffoldPathGuard.php';
require $root . '/scripts/scaffold-runtime/ScaffoldManifest.php';
require $root . '/scripts/scaffold-runtime/ScaffoldUpgradeLedger.php';
require $root . '/scripts/scaffold-runtime/Semver.php';
foreach ([
    ['/server/app/platform/exception/plugin/PluginLifecycleException.php', '/scripts/upgrade-runtime/PluginLifecycleException.php'],
    ['/server/app/platform/value/plugin/PluginDescriptor.php', '/scripts/upgrade-runtime/PluginDescriptor.php'],
    ['/server/app/platform/infrastructure/plugin/PluginLockResolver.php', '/scripts/upgrade-runtime/PluginLockResolver.php'],
] as $candidates) {
    foreach ($candidates as $candidate) {
        if (is_file($root . $candidate)) {
            require_once $root . $candidate;
            continue 2;
        }
    }
    throw new RuntimeException('SCAFFOLD_UPGRADE_RUNTIME_MISSING');
}
require $root . '/scripts/scaffold-runtime/ScaffoldUpgradeRunner.php';
require $root . '/scripts/scaffold-runtime/EditionUpgradePackage.php';

function usage(): never
{
    fwrite(STDERR, "Usage:\n"
        . "  php scripts/scaffold-upgrade preflight --project-root=<path> --from-manifest=<path> --to-manifest=<path>\n"
        . "  php scripts/scaffold-upgrade preflight --project-root=<path> --package=<extracted-package> --signature-key-id=<id> --env-file=<0600-file>\n"
        . "  php scripts/scaffold-upgrade adoption-plan --project-root=<path> --package=<extracted-package> --signature-key-id=<id> --env-file=<0600-file>\n"
        . "  php scripts/scaffold-upgrade adoption-apply --project-root=<path> --plan=<path> --confirm-plan-sha256=<sha256:...> --confirm-paths=<comma-separated-exact-paths> --env-file=<0600-file>\n"
        . "  php scripts/scaffold-upgrade adoption-recover --project-root=<path> --plan=<path>\n"
        . "  php scripts/scaffold-upgrade apply|verify|recover|rollback --project-root=<path> --plan=<path>\n");
    exit(64);
}

/** @return array<string,string> */
function upgradeTrustedKeys(string $path): array
{
    if (getenv('PEANUT_UPGRADE_TRUSTED_KEYS_JSON') !== false) {
        throw new RuntimeException('EDITION_UPGRADE_AMBIENT_TRUST_FORBIDDEN');
    }
    if (!str_starts_with($path, '/') || !is_file($path) || is_link($path)) {
        throw new RuntimeException('EDITION_UPGRADE_ENV_FILE_INVALID');
    }
    $stat = lstat($path);
    if (!is_array($stat) || ($stat['nlink'] ?? 0) !== 1 || (($stat['mode'] ?? 0) & 0777) !== 0600) {
        throw new RuntimeException('EDITION_UPGRADE_ENV_FILE_PERMISSIONS_INVALID');
    }
    $values = parse_ini_file($path, false, INI_SCANNER_RAW);
    if (!is_array($values) || array_keys($values) !== ['PEANUT_UPGRADE_TRUSTED_KEYS_JSON']) {
        throw new RuntimeException('EDITION_UPGRADE_ENV_FILE_SCHEMA_INVALID');
    }
    try {
        $keys = json_decode((string) $values['PEANUT_UPGRADE_TRUSTED_KEYS_JSON'], true, 32, JSON_THROW_ON_ERROR);
    } catch (JsonException $exception) {
        throw new RuntimeException('EDITION_UPGRADE_ENV_FILE_SCHEMA_INVALID', 0, $exception);
    }
    if (!is_array($keys) || array_is_list($keys) || $keys === []
        || array_filter(array_keys($keys), static fn(mixed $key): bool => !is_string($key) || preg_match('/^[A-Za-z0-9._-]{1,96}$/D', $key) !== 1) !== []
        || array_filter($keys, static function (mixed $key): bool {
            if (!is_string($key)) {
                return true;
            }
            $decoded = base64_decode($key, true);
            return !is_string($decoded) || strlen($decoded) !== SODIUM_CRYPTO_SIGN_PUBLICKEYBYTES;
        }) !== []) {
        throw new RuntimeException('EDITION_UPGRADE_ENV_FILE_SCHEMA_INVALID');
    }
    return $keys;
}

$command = $argv[1] ?? null;
if (!in_array($command, ['preflight', 'adoption-plan', 'adoption-apply', 'adoption-recover', 'apply', 'verify', 'recover', 'rollback'], true)) {
    usage();
}
$options = [];
foreach (array_slice($argv, 2) as $argument) {
    if (preg_match('/^--(project-root|from-manifest|to-manifest|package|signature-key-id|plan|confirm-plan-sha256|confirm-paths|env-file)=(.+)$/D', $argument, $matches) !== 1 || isset($options[$matches[1]])) {
        usage();
    }
    $options[$matches[1]] = $matches[2];
}
$packagePreflight = $command === 'preflight' && isset($options['package']);
$requiredOptions = match ($command) {
    'preflight' => $packagePreflight ? ['project-root', 'package', 'signature-key-id', 'env-file'] : ['project-root', 'from-manifest', 'to-manifest'],
    'adoption-plan' => ['project-root', 'package', 'signature-key-id', 'env-file'],
    'adoption-apply' => ['project-root', 'plan', 'confirm-plan-sha256', 'confirm-paths', 'env-file'],
    default => ['project-root', 'plan'],
};
foreach ($requiredOptions as $required) {
    if (!isset($options[$required]) || !is_string($options[$required]) || $options[$required] === '') {
        usage();
    }
}
$allowedOptions = $requiredOptions;
sort($allowedOptions, SORT_STRING);
$actualOptions = array_keys($options);
sort($actualOptions, SORT_STRING);
if ($actualOptions !== $allowedOptions) {
    usage();
}

try {
    $runner = new ScaffoldUpgradeRunner();
    $trustedKeys = isset($options['env-file']) ? upgradeTrustedKeys($options['env-file']) : [];
    $manifests = $packagePreflight
        ? (new EditionUpgradePackage())->prepare($options['project-root'], $options['package'], $options['signature-key-id'], $trustedKeys)
        : null;
    $result = match ($command) {
        'preflight' => $runner->preflight(
            $options['project-root'],
            $manifests['from_manifest'] ?? $options['from-manifest'],
            $manifests['to_manifest'] ?? $options['to-manifest'],
        ),
        'adoption-plan' => $runner->adoptionPlan($options['project-root'], $options['package'], $options['signature-key-id'], $trustedKeys),
        'adoption-apply' => $runner->adoptionApply(
            $options['project-root'],
            $options['plan'],
            $options['confirm-plan-sha256'],
            explode(',', $options['confirm-paths']),
            $trustedKeys,
        ),
        'adoption-recover' => $runner->adoptionRecover($options['project-root'], $options['plan']),
        'apply' => $runner->apply($options['project-root'], $options['plan']),
        'verify' => $runner->verify($options['project-root'], $options['plan']),
        'recover', 'rollback' => $runner->recover($options['project-root'], $options['plan']),
    };
    fwrite(STDOUT, json_encode($result, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
    exit(($result['status'] ?? null) === 'blocked' ? 2 : 0);
} catch (Throwable $exception) {
    fwrite(STDERR, json_encode([
        'status' => 'error',
        'error' => $exception->getMessage(),
    ], JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR) . "\n");
    exit(1);
}
