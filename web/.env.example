# 复制为本项目 .env；Vite 原生加载 .env、.env.local 和当前 mode 文件。
# 只含可公开配置；VITE_ 字段会进入浏览器产物，不能存秘密。
# 开发监听地址、端口；维护者按资源登记填写，端口被占用时明确失败。
VITE_HOST=127.0.0.1
VITE_PORT=5173
# 额外允许的开发域名，逗号分隔；不要填写 URL 或端口。
VITE_ALLOWED_HOSTS=
# 是否由开发服务器打开浏览器。
VITE_OPEN_BROWSER=false
# 仅开发代理的 PHP 上游；保留浏览器请求 Host，不改变租户入口。
VITE_API_PROXY_TARGET=http://127.0.0.1:20180
# 浏览器 API 前缀；开发经代理、生产经同域路径访问，均留空。
VITE_API_BASE_URL=
# 与实例 Edition 一致：standalone 或 multi-tenant；非法值会拒绝构建。
VITE_DEPLOYMENT_MODE=standalone
# 是否生成打包分析报告；也可使用 npm run report。
REPORT=false
