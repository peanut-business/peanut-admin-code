{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "vitest": ["../tools/quality/node_modules/vitest"],
      "@vue/test-utils": ["../tools/quality/node_modules/@vue/test-utils"]
    },
    "types": []
