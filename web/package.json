{
  "name": "peanut-admin-web",
  "description": "Peanut Admin management client",
  "version": "4.0.0-dev",
  "private": true,
  "author": "花生科技",
  "license": "Apache-2.0",
  "homepage": "https://github.com/peanut-business/peanut-admin-code",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peanut-business/peanut-admin-code.git",
    "directory": "web"
  },
  "scripts": {
    "dev": "../scripts/local-client-dev web",
    "build": "vue-tsc --noEmit && vite build --config ./config/vite.config.prod.ts",
    "report": "PEANUT_CLIENT_ENV_FILE=$PWD/.env.report npm run build",
    "preview": "npm run build && vite preview --host",
    "type:check": "vue-tsc --noEmit --skipLibCheck",
    "lint-staged": "npx lint-staged",
    "prepare": "husky install"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.vue": [
      "stylelint --fix",
      "prettier --write",
      "eslint --fix"
    ],
    "*.{less,css}": [
      "stylelint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@hocuspocus/provider": "4.6.0",
    "@peanut-admin/ui-vue": "file:../packages/core-web/peanut-admin-ui-vue-4.0.0-dev.0.tgz",
    "@peanut-admin/vue": "file:../packages/core-web/peanut-admin-vue-4.0.0-dev.0.tgz",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-collaboration": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "@vueuse/core": "^9.3.0",
    "axios": "0.33.0",
    "dayjs": "^1.11.5",
    "dompurify": "^3.4.14",
    "echarts": "6.1.0",
    "element-plus": "2.14.3",
    "lodash": "^4.17.21",
    "mitt": "^3.0.0",
    "nprogress": "^0.2.0",
    "openapi-fetch": "0.17.0",
    "pinia": "^2.0.23",
    "query-string": "^8.0.3",
    "sortablejs": "^1.15.0",
    "vue": "^3.2.40",
    "vue-echarts": "8.3.0",
    "vue-i18n": "^9.2.2",
    "vue-router": "^4.0.14",
    "yjs": "13.6.32"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.1.2",
    "@commitlint/config-conventional": "^17.1.0",
    "@types/lodash": "^4.14.186",
    "@types/nprogress": "^0.2.0",
    "@types/sortablejs": "^1.15.0",
    "@typescript-eslint/eslint-plugin": "^5.40.0",
    "@typescript-eslint/parser": "^5.40.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vitejs/plugin-vue-jsx": "4.2.0",
    "@vue/babel-plugin-jsx": "^1.1.1",
    "consola": "^2.15.3",
    "cross-env": "^7.0.3",
    "eslint": "^8.25.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-import-resolver-typescript": "^3.5.1",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.6.0",
    "husky": "^8.0.1",
    "less": "^4.1.3",
    "lint-staged": "^13.0.3",
    "openapi-typescript": "7.13.0",
    "postcss-html": "^1.5.0",
    "postcss-less": "6.0.0",
    "prettier": "^2.7.1",
    "rollup": "^4.44.0",
    "rollup-plugin-visualizer": "^5.8.2",
    "stylelint": "^14.13.0",
    "stylelint-config-prettier": "^9.0.3",
    "stylelint-config-recommended": "9.0.0",
    "stylelint-config-recommended-vue": "^1.4.0",
    "stylelint-config-standard": "^29.0.0",
    "stylelint-order": "^5.0.0",
    "typescript": "^4.8.4",
    "vite": "6.4.3",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-eslint": "^1.8.1",
    "vite-svg-loader": "^3.6.0",
    "vue-tsc": "^1.0.14"
  },
  "engines": {
    "node": "^18.0.0 || ^20.0.0 || >=22.0.0"
  },
  "resolutions": {
    "bin-wrapper": "npm:bin-wrapper-china",
    "gifsicle": "5.2.0"
  },
  "pnpm": {
    "overrides": {
      "decode-uri-component": "0.5.0",
      "js-yaml@4.3.1": "4.3.2",
      "postcss": "8.5.23"
    }
  }
}
