#!/usr/bin/env php
<?php

declare(strict_types=1);

use think\App;
use think\Console;
use think\console\Output;

// Private application bridge for `peanut module`; native Console owns parsing and execution.
if (PHP_SAPI !== 'cli') {
    http_response_code(404);
    exit(1);
}

try {
    $request = json_decode(stream_get_contents(STDIN), true, 512, JSON_THROW_ON_ERROR);
    $commands = [
        'create' => ['module:create', \app\command\ModuleCreate::class],
        'check' => ['module:check', \app\command\ModuleCheck::class],
        'compile' => ['module:compile', \app\command\ModuleCompile::class],
        'pack' => ['module:pack', \app\command\ModulePack::class],
        'adopt' => ['module:adopt-package', \app\command\ModuleAdoptPackage::class],
        'install' => ['module:install-package', \app\command\ModuleInstallPackage::class],
        'upgrade' => ['module:update-package', \app\command\ModuleUpdatePackage::class],
        'disable' => ['module:disable-package', \app\command\ModuleDisablePackage::class],
        'uninstall' => ['module:uninstall-package', \app\command\ModuleUninstallPackage::class],
        'sync' => ['module:sync', \app\command\ModuleSync::class],
        'reconcile' => ['module:reconcile', \app\command\ModuleReconcile::class],
        'make' => ['module:make', \app\command\ModuleMake::class],
        'lock' => ['module:lock', \app\command\ModuleLock::class],
        'release-composition' => ['module:release-composition', \app\command\ModuleReleaseComposition::class],
        'work' => ['ops-module:task', \app\command\OpsModuleTask::class],
    ];
    if (!is_array($request) || !is_string($request['operation'] ?? null)
        || !isset($commands[$request['operation']]) || !is_array($request['arguments'] ?? null)
        || !array_is_list($request['arguments'])) {
        throw new InvalidArgumentException('MODULE_BRIDGE_REQUEST_INVALID');
    }
    foreach ($request['arguments'] as $argument) {
        if (!is_string($argument) || str_contains($argument, "\0")) {
            throw new InvalidArgumentException('MODULE_BRIDGE_ARGUMENT_INVALID');
        }
    }
    [$name, $class] = $commands[$request['operation']];
    if ($request['operation'] === 'work') {
        array_unshift($request['arguments'], 'work');
    }
    $_SERVER['argv'] = [__FILE__, $name, ...$request['arguments']];
    $_SERVER['argc'] = count($_SERVER['argv']);
} catch (JsonException|InvalidArgumentException $exception) {
    fwrite(STDERR, $exception->getMessage() . PHP_EOL);
    exit(1);
}

require __DIR__ . '/vendor/autoload.php';

try {
    $app = new App(__DIR__);
    // Source creation/adoption precedes runtime composition. The verified,
    // development-only source transaction must also work before its first
    // required Module exists; installed operations retain normal admission.
    $minimalSourceBoot = $request['operation'] === 'create'
        || $request['operation'] === 'adopt';
    if ($request['operation'] === 'adopt' && $minimalSourceBoot) {
        // Load the same server-local environment as the native application, without
        // booting a broken Module graph. Recovery requires an explicit development file.
        $name = $app->env->get('env_name', '');
        if (!is_string($name) || $name === '0' || ($name !== '' && preg_match('/^[a-zA-Z0-9_-][a-zA-Z0-9_.-]*$/D', $name) !== 1)) {
            throw new RuntimeException('MODULE_RECOVERY_BACKEND_ENVIRONMENT_INVALID');
        }
        $environmentFile = __DIR__ . '/.env' . ($name === '' ? '' : '.' . $name);
        if (!is_file($environmentFile) || is_link($environmentFile) || (fileperms($environmentFile) & 0077) !== 0) {
            throw new RuntimeException('MODULE_RECOVERY_BACKEND_ENVIRONMENT_INVALID');
        }
        $app->env->set('APP_ENV', 'production');
        $app->loadEnv($name);
        require_once __DIR__ . '/vendor/topthink/framework/src/helper.php';
        $app->config->set(require __DIR__ . '/config/peanut.php', 'peanut');
        $app->config->set(require __DIR__ . '/config/module_packages.php', 'module_packages');
        $app->config->set(require __DIR__ . '/config/deployment.php', 'deployment');
    }
    $console = new class ($app, $class, $minimalSourceBoot) extends Console {
        public function __construct(App $app, private string $commandClass, private bool $sourceOnly)
        {
            parent::__construct($app);
        }

        protected function initialize(): void
        {
            // Preserve source generation before installation, as in the original native entry.
            if (!$this->sourceOnly) {
                parent::initialize();
            }
        }

        protected function loadCommands(): void
        {
            if ($this->sourceOnly && $this->commandClass === \app\command\ModuleAdoptPackage::class) {
                // Source transactions keep the ordinary CLI execution context
                // without constructing runtime Module or database services.
                $store = new \app\common\execution\ExecutionContextStore();
                $this->app->instance(\app\common\execution\ExecutionContextStore::class, $store);
                $this->app->instance(
                    \app\common\execution\CurrentExecutionContext::class,
                    new \app\common\execution\CurrentExecutionContext($store),
                );
            }
            $this->addCommand($this->commandClass);
            $this->addCommand(\think\console\command\Help::class);
        }
    };
    $console->setAutoExit(false);
    exit($console->run());
} catch (Throwable $exception) {
    $output = new Output();
    $output->renderException($exception);
    exit(1);
}
