{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APP collaboration lifecycle result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_version",
    "action",
    "instance_id",
    "edition",
    "config_revision",
    "config_sha256",
    "desired_enabled",
    "applied_revision",
    "runtime_state",
    "checks",
    "drain",
    "redacted_secret_refs",
    "gaps",
    "error_code",
    "restart_required"
  ],
  "allOf": [{
    "if": {"properties": {"desired_enabled": {"type": "null"}}},
    "then": {"properties": {
      "runtime_state": {"const": "unknown"},
      "error_code": {"type": "string", "minLength": 1},
      "instance_id": {"type": "null"},
      "edition": {"type": "null"},
      "config_revision": {"const": 0},
      "config_sha256": {"type": "null"},
      "applied_revision": {"type": "null"},
      "checks": {"contains": {"properties": {"key": {"const": "desired_configuration"}, "state": {"const": "unknown"}}, "required": ["key", "state"]}},
      "gaps": {"contains": {"const": "configuration_unobserved"}}
    }}
  }],
  "properties": {
    "protocol": {
      "const": "peanut.collaboration.lifecycle.v1"
    },
    "schema_version": {
      "const": 1
    },
    "action": {
      "enum": [
        "plan",
        "enable",
        "status",
        "disable"
      ]
    },
    "instance_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "edition": {
      "enum": [
        "engine",
        "standalone",
        "multi-tenant",
        null
      ]
    },
    "config_revision": {
      "type": "integer",
      "minimum": 0
    },
    "config_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "desired_enabled": {
      "type": ["boolean", "null"]
    },
    "applied_revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "runtime_state": {
      "enum": [
        "disabled",
        "prepared",
        "starting",
        "ready",
        "draining",
        "stopped",
        "unknown"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "state"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "state": {
            "enum": [
              "ok",
              "failed",
              "not_probed",
              "unknown"
            ]
          }
        }
      }
    },
    "drain": {
      "type": [
        "object",
        "null"
      ]
    },
    "redacted_secret_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "COLLABORATION_SERVICE_SECRET_FILE",
        "COLLABORATION_TICKET_SECRET_FILE"
      ],
      "properties": {
        "COLLABORATION_SERVICE_SECRET_FILE": {
          "type": "boolean"
        },
        "COLLABORATION_TICKET_SECRET_FILE": {
          "type": "boolean"
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "restart_required": {
      "type": "boolean"
    }
  }
}
