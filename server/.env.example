# Peanut Admin backend configuration. Copy to server/.env.
# ThinkPHP loads this file natively; config/*.php reads env values with defaults.
# A named sibling server/.env.<name> can be selected with PHP_ENV_NAME=<name>.
APP_ENV=production
APP_DEBUG=false
# Required by the current cache/session/lock namespace. Use the actual instance ID.
PEANUT_DATABASE_RESOURCE_ID=

# Choose the actual database. Containers normally use their MySQL service name.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CONNECT_TIMEOUT_SECONDS=5
DB_PREFIX=pa_

# Required. Generate independent stable values; never reuse sample secrets.
JWT_SECRET=
JWT_EXPIRE=7200
ADMIN_TOKEN_EXPIRE=7200
ADMIN_TOKEN_RENEW_BEFORE=1200
ADMIN_PASSWORD_ERROR_TIMES=5
ADMIN_LOGIN_LOCK_MINUTES=5
NOTIFICATION_VERIFICATION_MAX_FAILURES=5
NOTIFICATION_VERIFICATION_ENTRY_MAX_FAILURES=10
NOTIFICATION_VERIFICATION_ENTRY_WINDOW_SECONDS=300
PEANUT_STORAGE_CREDENTIAL_MASTER_KEY=
PEANUT_SETTINGS_SECRET_KEYS=
PEANUT_SETTINGS_ACTIVE_SECRET_KEY_ID=
TENANT_IDENTIFIER_HMAC_KEY=
PLATFORM_IDENTIFIER_HMAC_KEY=

# Required deployment mode. Use exactly standalone or multi-tenant.
DEPLOYMENT_MODE=standalone
OWNER_INVITATION_DELIVERY_MODE=auto

# Fresh installation transport. For automatic mode, write initial identities
# to a separate permission-0600 file and select it with
# PEANUT_INSTALLATION_ENV_FILE for the installer command only. Guided mode
# receives identities in the authenticated setup request.
PEANUT_INSTALLATION_MODE=automatic
PEANUT_INSTALLATION_SOURCE_MODE=
PEANUT_INSTALLATION_SETUP_TOKEN=
PEANUT_INSTALLATION_OFFICIAL_MODULES=

# Required for multi-tenant deployments. Tenant-specific hosts are dynamic.
PLATFORM_HOSTS=
TENANT_ADMIN_HOSTS=

# Optional backend/module runtime settings. These are native ThinkPHP env keys.
DB_DRIVER=mysql
DB_TYPE=mysql
DB_CHARSET=utf8mb4
ASYNC_SIGNING_KEY=
ASYNC_WORKER_LIMIT=4
DEFAULT_LANG=zh-cn
PROJECT_VERSION=
PEANUT_MODULE_ROOTS=
# Leave unset to use the layout-aware default in config/modules.php:
# application source: ../plugins.lock; backend runtime projection: plugins.lock.
# PEANUT_PLUGIN_LOCK=../plugins.lock
PEANUT_MODULE_KERNEL_VERSION=1.0.0
PEANUT_MODULE_TRUSTED_KEYS_JSON={}
COLLABORATION_ENABLED=disabled
# Optional profile: publish with configure-collaboration.py enable.
COLLABORATION_INSTANCE_ID=
COLLABORATION_SERVICE_INSTANCE_ID=
COLLABORATION_SERVICE_KEY_ID=
# Service-to-service HMAC key string, at least 32 bytes; never a user token.
# Keep the real backend .env at 0600 and do not commit or log the key.
COLLABORATION_SECRET=
COLLABORATION_CONTROL_ORIGIN=
# Derived by the same managed configuration owner; never a private control URL.
COLLABORATION_PUBLIC_WSS_URL=
COLLABORATION_CONFIG_REVISION=0
COLLABORATION_CONFIG_SHA256=
COLLABORATION_CA_FILE=
COLLABORATION_CA_SHA256=

# Optional synthetic demo settings. Production deployments normally keep the
# mode disabled and leave the remaining fields empty.
PEANUT_DEMO_MODE=disabled
PEANUT_DEMO_ADMIN_EMAIL=
PEANUT_DEMO_PLATFORM_EMAIL=
PEANUT_DEMO_TENANT_A_EMAIL=
PEANUT_DEMO_TENANT_B_EMAIL=
PEANUT_DEMO_SHARED_PASSWORD=
PEANUT_DEMO_TENANT_A_HOST=
PEANUT_DEMO_TENANT_B_HOST=
PEANUT_DEMO_DOCS_URL=
INTEGRATION_MACHINE_SCOPES=
INTEGRATION_WEBHOOK_SECRET_KEY_ID=
INTEGRATION_WEBHOOK_SECRET_KEY=
