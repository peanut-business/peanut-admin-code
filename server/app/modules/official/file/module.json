{
  "schema_version": 1,
  "key": "official.file",
  "name": "File and Media",
  "description": "Tenant-owned media library, uploads and private file metadata.",
  "version": "1.0.0",
  "kernel_constraint": "^1.0",
  "license": "Apache-2.0",
  "php_package": "peanut-business/official-file",
  "web_package": "@peanut-admin/official-file",
  "dependencies": [],
  "lifecycle": {
    "protected": true
  },
  "backend": {
    "provider": "app\\modules\\official\\file\\ModuleProvider",
    "migrations": "database/migrations",
    "menus": "resources/menus.json",
    "permissions": "resources/permissions.json",
    "setting_definitions": "resources/setting-definitions.json"
  },
  "frontend": {
    "entry": "web/src/modules/official-file/contribution.ts"
  },
  "database": {
    "owned_tables": [
      "pa_file",
      "pa_file_cate",
      "pa_storage_account",
      "pa_storage_space",
      "pa_storage_route",
      "pa_file_object",
      "pa_file_image_asset",
      "pa_file_derivative",
      "pa_file_delivery_nonce"
    ]
  },
  "contracts": {
    "exports": [
      "app\\modules\\official\\file\\contracts\\FileAdministration",
      "app\\modules\\official\\file\\contracts\\FileUploads",
      "app\\modules\\official\\file\\contracts\\FileReferences",
      "app\\modules\\official\\file\\contracts\\FileDerivatives",
      "app\\modules\\official\\file\\contracts\\FileStorage",
      "app\\modules\\official\\file\\contracts\\dto\\UploadFile",
      "app\\modules\\official\\file\\contracts\\StorageConfiguration"
    ],
    "events": []
  },
  "tenant": {
    "enableable": true,
    "disable_behavior": "reject_new_operations",
    "requires": []
  }
}
