{
  "schema_version": 1,
  "key": "official.article",
  "name": "Article Content",
  "description": "Tenant-owned article and category content with member collections.",
  "version": "1.0.0",
  "kernel_constraint": "^1.0",
  "license": "Apache-2.0",
  "php_package": "peanut-business/official-article",
  "web_package": "@peanut-admin/official-article",
  "dependencies": [
    {"module_key": "official.file", "version": "^1.0"}
  ],
  "backend": {
    "provider": "PeanutAdmin\\Modules\\Article\\ModuleProvider",
    "migrations": "database/migrations",
    "menus": "resources/menus.json",
    "permissions": "resources/permissions.json",
    "setting_definitions": "resources/setting-definitions.json"
  },
  "frontend": {
    "entry": "web/src/modules/official-article/contribution.ts"
  },
  "database": {
    "owned_tables": ["pa_article_cate", "pa_article", "pa_article_collect"]
  },
  "contracts": {
    "exports": [
      "PeanutAdmin\\Modules\\Article\\Contract\\ArticleAdministration",
      "PeanutAdmin\\Modules\\Article\\Contract\\ArticleQueries",
      "PeanutAdmin\\Modules\\Article\\Contract\\PublicArticleQueries"
    ],
    "events": []
  },
  "tenant": {
    "enableable": true,
    "disable_behavior": "reject_new_operations",
    "requires": ["official.file"]
  }
}
