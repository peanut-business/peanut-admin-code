{
  "schema_version": 1,
  "key": "official.notification",
  "name": "Notification",
  "description": "Tenant-owned notification channels, scenes, templates and delivery logs.",
  "version": "1.0.0",
  "kernel_constraint": "^1.0",
  "license": "Apache-2.0",
  "php_package": "peanut-business/official-notification",
  "web_package": "@peanut-admin/official-notification",
  "dependencies": [
    {
      "module_key": "official.integration",
      "version": "^1.0"
    },
    {
      "module_key": "official.task",
      "version": "^1.0"
    },
    {
      "module_key": "official.identity",
      "version": "4.0.0-dev"
    }
  ],
  "backend": {
    "provider": "app\\modules\\official\\notification\\ModuleProvider",
    "migrations": "database/migrations",
    "menus": "resources/menus.json",
    "permissions": "resources/permissions.json",
    "setting_definitions": "resources/setting-definitions.json"
  },
  "frontend": {
    "entry": "web/src/modules/official-notification/contribution.ts"
  },
  "database": {
    "owned_tables": [
      "pa_notice_log",
      "pa_notice_scene",
      "pa_notice_template",
      "pa_notification_template",
      "pa_notification_message",
      "pa_notification_attachment",
      "pa_notification_outbox",
      "pa_sms_rate_bucket",
      "pa_notification_event"
    ]
  },
  "contracts": {
    "exports": [
      "app\\modules\\official\\notification\\contracts\\NotificationBootstrapCommands",
      "app\\modules\\official\\notification\\contracts\\NotificationCommands",
      "app\\modules\\official\\notification\\contracts\\NotificationQueries",
      "app\\modules\\official\\notification\\contracts\\VerificationCodeCommands",
      "app\\modules\\official\\notification\\contracts\\NoticeSmsSender"
    ],
    "events": []
  },
  "tenant": {
    "enableable": true,
    "disable_behavior": "reject_new_operations",
    "requires": [
      "official.integration"
    ]
  }
}
