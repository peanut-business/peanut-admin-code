{
    "schema_version": 1,
    "key": "peanut.entitlement-quota",
    "name": "EntitlementQuota",
    "description": "可选商业额度记录；使用方显式提供计量与额度策略，不作为普通业务的必需依赖。",
    "version": "4.0.0-dev",
    "kernel_constraint": "^1.0",
    "license": "Apache-2.0",
    "php_package": "peanut-business/entitlement-quota",
    "web_package": null,
    "dependencies": [
        {
            "module_key": "official.identity",
            "version": "4.0.0-dev"
        }
    ],
    "backend": {
        "provider": "app\\modules\\peanut\\entitlement_quota\\ModuleProvider",
        "migrations": "database/migrations"
    },
    "frontend": {},
    "database": {
        "owned_tables": [
            "pa_entitlement_grant",
            "pa_entitlement_policy_revision",
            "pa_entitlement_usage_window",
            "pa_entitlement_reservation",
            "pa_entitlement_usage_ledger"
        ]
    },
    "contracts": {
        "exports": [
            "PeanutAdmin\\EntitlementQuota\\Application\\EntitlementQuotaService",
            "PeanutAdmin\\EntitlementQuota\\Contract\\EntitlementMeterRegistry",
            "PeanutAdmin\\EntitlementQuota\\Contract\\EntitlementPolicyProvider"
        ],
        "events": []
    },
    "tenant": {
        "enableable": true,
        "disable_behavior": "reject_new_operations",
        "requires": [
            "official.identity"
        ]
    }
}
