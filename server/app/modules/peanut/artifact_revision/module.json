{
    "schema_version": 1,
    "key": "peanut.artifact-revision",
    "name": "ArtifactRevision",
    "description": "版本化业务制品与不可变修订；保留原模块编号与审计、幂等语义。",
    "version": "4.0.0-dev",
    "kernel_constraint": "^1.0",
    "license": "Apache-2.0",
    "php_package": "peanut-business/artifact-revision",
    "web_package": null,
    "dependencies": [
        {
            "module_key": "official.identity",
            "version": "4.0.0-dev"
        },
        {
            "module_key": "peanut.workflow",
            "version": "4.0.0-dev"
        }
    ],
    "backend": {
        "provider": "PeanutAdmin\\Modules\\ArtifactRevision\\ModuleProvider",
        "migrations": "database/migrations"
    },
    "frontend": {},
    "database": {
        "owned_tables": [
            "pa_artifact",
            "pa_artifact_revision"
        ]
    },
    "contracts": {
        "exports": [
            "PeanutAdmin\\Modules\\ArtifactRevision\\Application\\ArtifactRevisionService",
            "PeanutAdmin\\Modules\\ArtifactRevision\\Workflow\\ArtifactSubjectRevisionReader"
        ],
        "events": []
    },
    "tenant": {
        "enableable": true,
        "disable_behavior": "reject_new_operations",
        "requires": [
            "official.identity",
            "peanut.workflow"
        ]
    }
}
