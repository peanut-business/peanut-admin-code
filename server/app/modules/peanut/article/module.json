{
  "schema_version": 1,
  "key": "peanut.article",
  "name": "Article Content",
  "description": "Tenant-owned article and category content with member collections.",
  "version": "1.0.9",
  "kernel_constraint": "^1.0",
  "license": "Apache-2.0",
  "php_package": "peanut-business/peanut-article",
  "web_package": "@peanut-admin/peanut-article",
  "dependencies": [
    {
      "module_key": "peanut.file",
      "version": "^1.0"
    },
    {
      "module_key": "peanut.document",
      "version": "^1.0"
    },
    {
      "module_key": "peanut.rich-text",
      "version": "^1.0"
    }
  ],
  "optional_dependencies": [
    {
      "module_key": "peanut.collaboration",
      "version": "^1.0"
    }
  ],
  "backend": {
    "provider": "PeanutAdmin\\Modules\\Article\\ModuleProvider",
    "menus": "resources/menus.json",
    "permissions": "resources/permissions.json",
    "setting_definitions": "resources/setting-definitions.json"
  },
  "frontend": {
    "entry": "web/src/modules/peanut-article/contribution.ts"
  },
  "database": {
    "owned_tables": [
      "pa_article_cate",
      "pa_article",
      "pa_article_collect",
      "pa_article_body_save"
    ]
  },
  "contracts": {
    "exports": [
      "PeanutAdmin\\Modules\\Article\\Contract\\ArticleAdministration",
      "PeanutAdmin\\Modules\\Article\\Contract\\ArticleBodySaveInput",
      "PeanutAdmin\\Modules\\Article\\Contract\\ArticleQueries",
      "PeanutAdmin\\Modules\\Article\\Contract\\PublicArticleQueries"
    ],
    "events": []
  },
  "tenant": {
    "enableable": true,
    "disable_behavior": "reject_new_operations",
    "requires": [
      "peanut.file",
      "peanut.document"
    ]
  }
}
