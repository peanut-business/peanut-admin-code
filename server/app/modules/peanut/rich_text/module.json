{
  "schema_version": 1,
  "key": "peanut.rich-text",
  "name": "Structured Rich Text",
  "description": "Versioned Tiptap/ProseMirror documents, media references, annotation anchors and realtime collaboration adapters.",
  "version": "1.0.8",
  "kernel_constraint": "^1.0",
  "license": "Apache-2.0",
  "php_package": "peanut-business/peanut-rich-text",
  "web_package": "@peanut-admin/peanut-rich-text",
  "dependencies": [
    {
      "module_key": "peanut.content-tools",
      "version": "1.0.1"
    },
    {
      "module_key": "peanut.file",
      "version": "^1.0"
    },
    {
      "module_key": "peanut.identity",
      "version": "4.0.0-rc.32"
    }
  ],
  "lifecycle": {
    "protected": false
  },
  "backend": {
    "provider": "PeanutAdmin\\Modules\\RichText\\ModuleProvider",
    "menus": "resources/menus.json",
    "permissions": "resources/permissions.json",
    "migrations": "database/migrations"
  },
  "frontend": {
    "entry": "web/src/modules/peanut-rich-text/contribution.ts"
  },
  "database": {
    "owned_tables": [
      "pa_rich_text_document"
    ]
  },
  "contracts": {
    "exports": [
      "PeanutAdmin\\Modules\\RichText\\Contract\\RichTextProjection"
    ],
    "events": []
  },
  "tenant": {
    "enableable": true,
    "disable_behavior": "reject_new_operations",
    "requires": [
      "peanut.identity"
    ]
  }
}
