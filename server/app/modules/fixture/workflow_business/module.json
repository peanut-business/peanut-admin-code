{
  "schema_version": 1,
  "key": "fixture.workflow-business",
  "name": "Workflow business samples (development only)",
  "description": "Optional synthetic application, purchase and receipt scenarios for Workflow integration acceptance; excluded from runtime product.",
  "version": "1.0.9",
  "kernel_constraint": "^1.0",
  "license": "Apache-2.0",
  "php_package": "peanut-business/fixture-workflow-business",
  "web_package": "@peanut-admin/fixture-workflow-business",
  "dependencies": [
    {
      "module_key": "peanut.identity",
      "version": "4.0.0-rc.31"
    },
    {
      "module_key": "peanut.artifact-revision",
      "version": "4.0.0-rc.31"
    },
    {
      "module_key": "peanut.workflow",
      "version": "4.0.0-rc.34"
    },
    {
      "module_key": "peanut.task",
      "version": "^1.0"
    }
  ],
  "backend": {
    "provider": "PeanutAdmin\\Fixtures\\WorkflowBusiness\\ModuleProvider",
    "menus": "resources/menus.json",
    "permissions": "resources/permissions.json",
    "protected_resources": "resources/protected-resources.json"
  },
  "frontend": {
    "entry": "web/src/modules/fixture-workflow-business/contribution.ts"
  },
  "database": {
    "owned_tables": [
      "pa_fixture_workflow_object",
      "pa_fixture_workflow_payload",
      "pa_fixture_workflow_effect",
      "pa_fixture_workflow_stock_ledger",
      "pa_fixture_workflow_stock_balance",
      "pa_fixture_workflow_task_actor",
      "pa_fixture_workflow_collaboration"
    ]
  },
  "contracts": {
    "exports": [
      "PeanutAdmin\\Fixtures\\WorkflowBusiness\\Service\\WorkflowBusinessService",
      "PeanutAdmin\\Fixtures\\WorkflowBusiness\\Integration\\WorkflowBusinessComposition",
      "PeanutAdmin\\Fixtures\\WorkflowBusiness\\Integration\\WorkflowBusinessScenarioProvider",
      "PeanutAdmin\\Fixtures\\WorkflowBusiness\\Integration\\WorkflowBusinessPolicyProvider"
    ],
    "events": []
  },
  "tenant": {
    "enableable": true,
    "disable_behavior": "reject_new_operations",
    "requires": [
      "peanut.identity",
      "peanut.artifact-revision",
      "peanut.workflow",
      "peanut.task"
    ]
  },
  "optional_dependencies": [
    {
      "module_key": "peanut.notification",
      "version": "^1.0"
    }
  ]
}
